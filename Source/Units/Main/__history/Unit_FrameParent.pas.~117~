procedure TFrame_Parent.DBGrid1DrawColumnCell(Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn; State: TGridDrawState);
begin
     if QueryList.FieldByName('InpatientId').AsInteger > 0  then
     Begin
          DBGrid1.Canvas.Font.Color:=clRed;
          DBGrid1.DefaultDrawColumnCell(Rect, DataCol, Column, State);
     End
     Else IF QueryList.FieldByName('FollowUpCount').AsInteger > 1 then
     Begin
          DBGrid1.Canvas.Font.Color:=$004080FF;
          DBGrid1.DefaultDrawColumnCell(Rect, DataCol, Column, State);
     End
     Else IF QueryList.FieldByName('NoOfAdmittedTime').AsInteger > 0 then
     Begin
          DBGrid1.Canvas.Font.Color:=$00C212AC;
          DBGrid1.DefaultDrawColumnCell(Rect, DataCol, Column, State);
     End;

     (*if QueryList.FieldByName('ErPatientCategory').AsString='I' then
          DBGrid1.Canvas.Brush.Color := clRed
     else if QueryList.FieldByName('ErPatientCategory').AsString='II' then
          DBGrid1.Canvas.Brush.Color := clYellow
     else if QueryList.FieldByName('ErPatientCategory').AsString='III' then
          DBGrid1.Canvas.Brush.Color := clGreen
     else if QueryList.FieldByName('ErPatientCategory').AsString='IV' then
          DBGrid1.Canvas.Brush.Color := clBlack;

     if DataCol=1 then
          DBGrid1.DefaultDrawColumnCell(Rect, DataCol, Column, State);*)
end;

