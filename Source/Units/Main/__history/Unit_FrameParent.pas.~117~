procedure TFrame_Parent.Edit_SearchKeyPress(Sender: TObject; var Key: Char);
begin
     if Key = #13 then
     begin
          gs_From := DEX_From.ADDateAsText;
          gs_to := DEX_To.ADDateAsText;
          if trim(Edit_Search.Text) <> '' then
          begin
               with QueryList do
               begin
                    Close;
                    Session :=DM_Hospital.DB;
                    SQL.Clear;
                    SQL.Add(' SELECT PM.*,Trim(PM.VdcName||'' ''||PM.wardNo||'' ''||PM.Address) as FullAddress');
                    SQL.Add(' ,(Select Count(INRE_InpatientId) From HS_INRE_InpatientReg where INRE_InpatientId=PM.PatientId) as NoOfAdmittedTime');
                    sql.add(',Nvl((Select Max(PAVI_VISITCOUNT) from HS_PAVI_PATIENTVISIT Where Pavi_PatientId=Pm.PatientId ANd PAVI_VISITDATE=to_Char(Sysdate,''YYYY/MM/DD'')),1)FollowUpCount');
                    SQL.Add(' FROM VW_HS_PATIENTMAIN PM');
                    if CB_GlobalSearch.Checked=False then
                    Begin
                         if IsStrANumber(Edit_Search.Text) then
                         Begin
                              IF CB_ByCRNo.Checked=False Then
                              SQL.Add('  Where PatientId=' + trim(Edit_Search.Text))
                              Else
                              SQL.Add('  Where FileNo=' + trim(Edit_Search.Text));
                         End
                         else
                         Begin
                              SQL.Add('  Where Upper(PatientName) Like' + #39 + trim(Edit_Search.Text) + '%' + #39);
                              SQL.Add('  or  Upper(FName) Like' + #39 + trim(Edit_Search.Text) + '%' + #39);
                              SQL.Add('  or  Upper(LName) Like' + #39 + trim(Edit_Search.Text) + '%' + #39);
                         End;
                    End
                    else
                    begin
                         if IsStrANumber(Edit_Search.Text) then
                         Begin
                              SQL.Add('  Where (PatientId=' + trim(Edit_Search.Text));
                              //SQL.Add('  or SubStr(CurrentAge,1,Length(CurrentAge)-2)=' + trim(Edit_Search.Text));
                              SQL.Add('  or  PhoneNo=' + #39 + trim(Edit_Search.Text)+#39);
                              SQL.Add('  or  MobileNo=' + #39 + trim(Edit_Search.Text)+#39);
                              //SQL.Add('  or  MobileNo=' + #39 + trim(Edit_Search.Text)+#39);
                              SQL.Add('  )');
                         End
                         else
                         Begin
                              SQL.Add('  Where (Upper(PatientName) Like' + #39 + trim(Edit_Search.Text) + '%' + #39);
                              SQL.Add('  or  Upper(FName) Like' + #39 + trim(Edit_Search.Text) + '%' + #39);
                              SQL.Add('  or  Upper(LName) Like' + #39 + trim(Edit_Search.Text) + '%' + #39);
                              SQL.Add('  or  Upper(Gender) Like' + #39 + trim(Edit_Search.Text) + '%' + #39);
                              SQL.Add('  or  Upper(Address) Like' + #39 + trim(Edit_Search.Text) + '%' + #39);
                              SQL.Add('  or  Upper(DistrictName) Like' + #39 + trim(Edit_Search.Text) + '%' + #39);
                              SQL.Add('  or  Upper(VdcName) Like' + #39 + trim(Edit_Search.Text) + '%' + #39);
                              SQL.Add('  or  Upper(NextToKIN) Like' + #39 + trim(Edit_Search.Text) + '%' + #39);
                              SQL.Add('  )');
                         End;
                    end;
                    SQL.Add(' ORDER BY REGDATE DESC,REGTIME DESC');
                    //SQL.SaveToFile('C:\GlobalPatientMain.txt');
                    Open;
               end;
               gs_PrevRegSearchData:=Edit_Search.Text;
          end
          else
          begin
               Edit_PatientID.Clear;
               RefreshList;
               ShowPatientCountStatus;
          end;
     end;
end;

