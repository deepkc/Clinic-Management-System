procedure TFrame_Parent.clearFrame;
Var
     i: integer;
begin
     try
          For i := 0 to Panel_Parent.ControlCount - 1 do
          begin
               if (Panel_Parent.Controls[i] is TFrame) then
               begin
                    if TFrame(Panel_Parent.Controls[i]).Name = 'Frame_NewPatient' then
                    begin
                         Frame_NewPatient.OffCamera;
                         // BB_NewPatient.Enabled := true;
                         RefreshList;
                    end;
                    if TFrame(Panel_Parent.Controls[i]).Name = 'Frame_Billing' then
                    begin
                         // BB_NewPatient.Enabled := true;
                         RefreshList;
                         //Frame_Billing.clearCustomerPreview;
                    end;
                    TFrame(Panel_Parent.Controls[i]).Free;
                    FrameCleared := true;
               end;
          end;
          Panel_list.BringToFront;
     except
          Self.clearFrame;
     end;
end;

constructor TFrame_Parent.Create(Aowner: TComponent);
begin
     inherited;
     FrameCleared := true;
     // Dex_Today.ADDateAsText := TodaysDate;
     // Dex_Today.SystemOfDate := gi_datesystem;
     // SPB_TodayDate.Caption := gs_DateCaption;
     Panel1.Visible:=False;
     //Panel2.Visible:=False;
     DEX_From.SystemOfDate := gi_datesystem;
     DEX_From.Text := TodaysDate;

     SPB_From.Caption := gs_DateCaption;
     DEX_To.SystemOfDate := gi_datesystem;
     DEX_To.Text := TodaysDate;

     SPB_To.Caption := gs_DateCaption;
     DBGrid1.Color := clWebLightBlue;

     if gs_CalledFormName = 'PA' then
     begin
         // SB_HospitalVisit.Visible := true;
          SB_CancelReg.Visible := true;
         // SB_ChangeDepartment.Visible := true;

     end
     else
     begin
          SB_HospitalVisit.Visible := false;
          SB_CancelReg.Visible := false;
          SB_ChangeDepartment.Visible := false;

     end;

     // DBGrid1.Columns[0].Title.Caption := Gs_PatientIdCaption;
     //
     // Form_MainOPDGuided.Label16.Caption := Gs_PatientIdCaption;
     Self.Caption := Self.Caption + ' User: ' + gs_UserName;
     if gi_LoggedInDoctorId > 0 then
     begin
          with QueryBlank do
          begin
               Close;
               Session :=DM_Hospital.DB;
               SQL.Clear;
               SQL.Add('select DOCT_DEPCODE as DEPCODE from HS_DOCT_DOCTOR where DOCT_DOCID=' + IntTOstr(gi_LoggedInDoctorId));
               Open;
          end;
          with Query_Dep do
          begin
               Close;
               Session :=DM_Hospital.DB;
               SQL[1] := 'where DEPT_DEPCODE=' + #39+QueryBlank.FieldByName('DEPCODE').AsString+#39;
               Open;
          end;
          DBLC_Dep.KeyValue := QueryBlank.FieldByName('depid').AsInteger;
     end;
     Edit_Search.Clear;

     if gs_CalledFrom<>'PatientAdmission' then
     RefreshList;

     gb_FrameParent := false;
     DBLC_Dep.Enabled := false;


     if (gs_CalledFormName='OPD') or (gs_CalledFormName='EMR') then
     Begin
          SPB_PatientAdmn.Visible:=False;
          SPB_ServiceAcknowledge.Left:=SPB_PatientAdmn.Left;
          SPB_ServiceAcknowledge.Top:=SPB_PatientAdmn.Top;
     End;


     DBGrid1.Columns[0].Title.Caption:=Gs_HosNoCaptionName;

     //ShowHideButtons;
end;

