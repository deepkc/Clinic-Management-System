procedure TFrame_Parent.ShowPatientCountStatus;
Begin
     With QueryBlank do
     begin
          Close;
          Session :=DM_Hospital.DB;
          SQL.Clear;
          SQL.Add(' Select Sum(NewTotal) as NewTotal,Sum(FollowUpTotal) as FollowUpTotal,Sum(Total) as Total');
          SQL.Add(' From VW_HS_STAT_RegVisitCount');
          if gi_datesystem=1 then
          SQL.Add(' where VisitDateEN>='+#39+gs_From+#39+' and VisitDateEn<='+#39+gs_To+#39)
          Else
          SQL.Add(' where VisitDateNP>='+#39+gs_From+#39+' and VisitDateNP<='+#39+gs_To+#39);
          Open;
     end;

     StatusBar1.Panels[0].Text:='New Total : '+IntToStr(QueryBlank.FieldByName('NewTotal').AsInteger);
     StatusBar1.Panels[1].Text:='Follow Total : '+IntToStr(QueryBlank.FieldByName('FollowUpTotal').AsInteger);
     if gs_From=gs_To then
     StatusBar1.Panels[2].Text:='Total : '+IntToStr(QueryBlank.FieldByName('Total').AsInteger)+' of Date : '+gs_From
     else
     StatusBar1.Panels[2].Text:='Total : '+IntToStr(QueryBlank.FieldByName('Total').AsInteger)+' of Date Between '+gs_From+' to '+gs_To;
End;

