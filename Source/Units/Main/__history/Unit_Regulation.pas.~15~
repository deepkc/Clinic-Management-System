end;

procedure TForm_Regulation.btn_SaveClick(Sender: TObject);
var
  QRy_save :TOraQuery;
  ls_regulation:string;
  li_regID:integer;
  ls_autoCal:string;
begin

    //Report Footer Value Set//
    if rb_Setup.Checked then
      ls_regulation:='S'
    else if rb_checkbox.Checked then
      ls_regulation:='C'
    else if rb_user.Checked then
      ls_regulation:='U';
   //***********************//

   //Autocalulation Value Set//
   if chk_AutoCal.Checked then
      ls_autoCal:='Y'
   else
      ls_autoCal:='N';
   //************************//

   //Data Store Report Footer//
    if pb_new then
    begin
      try
      QRy_save:=TOraQuery.Create(nil);

      li_regID:=GetMaxId('LARE_LabRegulation','LARE_RegulationID');
      with QRy_save do      //For Report Footer Regulation
      begin
         close;
         Session:=DM_Hospital.DB;
         sql.Clear;
         sql.Add('insert into LARE_LabRegulation (LARE_RegulationID,LARE_RegulationType,LARE_Regulation)');
         SQL.Add(' values ('+inttostr(li_regID));
         sql.Add(',''Report Footer''');
         sql.Add(','+quotedstr(ls_regulation));
         sql.Add(')');
         ExecSQL;
      end;
      finally
         QRy_save.free;
      end;
    end
    else
    begin
      try
      QRy_save:=TOraQuery.Create(nil);
      with QRy_save do      //For Report Footer Regulation
      begin
         close;
         Session:=DM_Hospital.DB;
         sql.Clear;
         sql.Add('Update LARE_LabRegulation set LARE_Regulation='+quotedstr(ls_regulation));
         SQL.Add(' where LARE_Regulationtype=''Report Footer''');
         ExecSQL;
      end;
      finally
         QRy_save.free;
      end;
    end;
    //*****************************************************//

   //Data Store Auto Calculation//
    if pb_new1 then
    begin
      try
      QRy_save:=TOraQuery.Create(nil);

      li_regID:=GetMaxId('LARE_LabRegulation','LARE_RegulationID');
      with QRy_save do      //For Auto Calculation
      begin
         close;
         Session:=DM_Hospital.DB;
         sql.Clear;
         sql.Add('insert into LARE_LabRegulation (LARE_RegulationID,LARE_RegulationType,LARE_Regulation)');
         SQL.Add(' values ('+inttostr(li_regID));
         sql.Add(',''Auto Calculation''');
         sql.Add(','+quotedstr(ls_autoCal));
         sql.Add(')');
         ExecSQL;
         ShowDoneMessage;
      end;
      finally
         QRy_save.free;
      end;
    end
    else
    begin
      try
      QRy_save:=TOraQuery.Create(nil);
      with QRy_save do      //For Auto Calculation
      begin
         close;
         Session:=DM_Hospital.DB;
         sql.Clear;
         sql.Add('Update LARE_LabRegulation set LARE_Regulation='+quotedstr(ls_autoCal));
         SQL.Add(' where LARE_Regulationtype=''Auto Calculation''');
         ExecSQL;
         ShowDoneMessage;
      end;
      finally
         QRy_save.free;
      end;
    end;

    //Report Footer Globally Set//
    if rb_Setup.Checked then
      gs_ReportFooterRegulation:='S'
    else if rb_checkbox.Checked then
      gs_ReportFooterRegulation:='C'
    else if rb_user.Checked then
      gs_ReportFooterRegulation:='U';
   //***************************//

   //Autocalulation Globally Set//
   if chk_AutoCal.Checked then
      gb_AutoCalculate:=true
   else
      gb_AutoCalculate:=false;
   //**************************//

end;

procedure TForm_Regulation.chk_AutoCalClick(Sender: TObject);
begin
    if chk_AutoCal.Checked=true then
    begin
       chk_AutoCal.Caption:='Active';
       lbl_AutoCal.Font.Style:=[fsBold];
    end
    else
    begin
       chk_AutoCal.Caption:='Inactive';
       lbl_AutoCal.Font.Style:=[];
    end;
end;

procedure TForm_Regulation.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
if Key=VK_ESCAPE then
close;
end;

procedure TForm_Regulation.FormShow(Sender: TObject);
begin
    with OraQuery_RepFooter do
    begin
       Close;
       Session:=DM_Hospital.DB;
       SQL.clear;
       sql.Add('select * from LARE_LabRegulation where LARE_RegulationType=''Report Footer''');
       Open;
    end;

    if OraQuery_RepFooter.RecordCount>0 then
    begin
       pb_new:=False;
       if OraQuery_RepFooter.FieldByName('LARE_Regulation').AsString='S' then
          rb_Setup.Checked:=True
       else if OraQuery_RepFooter.FieldByName('LARE_Regulation').AsString='C' then
          rb_checkbox.Checked:=True
       else if OraQuery_RepFooter.FieldByName('LARE_Regulation').AsString='U' then
          rb_user.Checked:=True;
    end    //'S' -> Setup Wise,  C -> Checkbox wise,  'U' -> UserWise
    else
    begin
       pb_new:=True;
       rb_Setup.Checked:=True;
       rb_Setup.SetFocus;
    end;

    with OraQuery_Cal do
    begin
       Close;
       Session:=DM_Hospital.DB;
       SQL.clear;
       sql.Add('select * from LARE_LabRegulation where LARE_RegulationType=''Auto Calculation''');
       Open;
    end;

    if OraQuery_Cal.RecordCount>0 then
    begin
       pb_new:=False;
       if OraQuery_Cal.FieldByName('LARE_Regulation').AsString='Y' then
          chk_AutoCal.Checked:=True
       else
          chk_AutoCal.Checked:=False;
    end    //'S' -> Setup Wise,  C -> Checkbox wise,  'U' -> UserWise
    else
    begin
       pb_new1:=True;
    end;
    if gi_UserID=1 then
          Btn_MasterReportPrevilage.Visible:=True
    else
          Btn_MasterReportPrevilage.Visible:=False;

    if gi_UserID=1 then
    BitBtn_Activate.Visible:=True;
end;

