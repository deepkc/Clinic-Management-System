procedure TForm_Regulation.BitBtn_ActivateClick(Sender: TObject);
begin
     try
          Form_MasterKeyLicense:=TForm_MasterKeyLicense.Create(nil);
          Form_MasterKeyLicense.Label1.caption:='Please Provide Master Key To Continue.';
          Form_MasterKeyLicense.showmodal;
     finally
          Form_MasterKeyLicense.free;
     end;

     if gs_MasterkeyAuthe=True then
     begin
          gb_LicenseExpiredMidas:=False;
          try
               Form_SystemLicense:=TForm_SystemLicense.Create(nil);
               Form_SystemLicense.ShowModal;
          finally
               Form_SystemLicense.Free;
          end;
     end
     else
     begin
          ShowMessage('Sorry !! Try Again ');
     end;
end;

procedure TForm_Regulation.btnBB_CloseClick(Sender: TObject);
