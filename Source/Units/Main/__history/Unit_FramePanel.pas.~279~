procedure TFrame_Panel.SB_SetupClick(Sender: TObject);
VAR QRY:TORAQUERY;
begin
     //CategoryPanel3.Enabled:=false;
    // CategoryPanel6.Enabled:=false;
     QRY:=TOraQuery.Create(NIL);
     WITH QRY DO
     BEGIN
          close;
          session:=DM_Hospital.DB;
          sql.Clear;
          sql.Add('select * from HS_MEPR_MENUPREVILAGE');
          Sql.Add('where mepr_userid='+inttostr(gi_UserID)+' and MEPR_ACCESSTYPE=''MAINMENU''');
          SQL.Add('and MEPR_moduleid='+inttostr(sb_setup.Tag));
          open;
          first;
          while NOT Eof  do
          BEGIN
               if QRY.FieldByName('mepr_captionname').AsString='Admin Setup' then
               begin
                    CategoryPanel3.Enabled:=True;
                    CategoryPanel3.Tag:= QRY.FieldByName('mepr_menuid').asinteger;
               end
               else if QRY.FieldByName('mepr_captionname').AsString='User Access Setup' then
               begin
                    CategoryPanel6.Enabled:=True;
                    CategoryPanel6.Tag:= QRY.FieldByName('mepr_menuid').asinteger;
               end;
               Next;
          END;
     END;

     QRY.Free;
     {if not CheckAccess('SETUP') then
     begin
          ShowMessage('Access Denied');
          exit;
     end;}
     CategoryPanelGroup1.CollapseAll;
     Timer3.Enabled := true;
     Form_Main.RB1.Checked := false;
     Form_Main.RB2.Checked := true;
end;

