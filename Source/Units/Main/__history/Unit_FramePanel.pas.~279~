procedure TFrame_Panel.CheckModuleAccess;
var
     I: Integer;
     Query_Blank: TOraQuery;
begin
     {
     ArrayOfButton[0] := SPB_PatientAdministration;
     ArrayOfButton[1] := Sb_SampleCollection;
     ArrayOfButton[2] := SB_Pathology;
     ArrayOfButton[3] := BB_Verification;
     ArrayOfButton[4] := SB_Reports;
     ArrayOfButton[5] := SB_Setup;
     ArrayOfButton[6] := BB_Broadcast;
     }
     ArrayOfButton[0] := SPB_PatientAdministration;
     ArrayOfButton[1] := Sb_SampleCollection;
     ArrayOfButton[2] := SB_Pathology;
     ArrayOfButton[3] := BB_Verification;
     ArrayOfButton[4] := SB_Analysis;
     ArrayOfButton[5] := SB_Setup;
     ArrayOfButton[6] := BB_Broadcast;
     ArrayOfButton[7] := SB_Report;
     for I := 0 to 7 do
     begin
          ArrayOfButton[I].Enabled := false;
     end;
     Query_Blank := TOraQuery.Create(nil);
     with Query_Blank do
     begin
          close;
          Session := DM_Hospital.DB;
          SQL.Clear;
          SQL.Add(' Select * from HS_MEPR_MENUPREVILAGE');
          SQL.Add(' where Upper(MEPR_AccessType)=''MODULE'' and MEPR_USERID=' + inttostr(gi_userId));
          Open;
          if Query_Blank.FieldByName('MEPR_PREVILAGEID').AsInteger > 0 then
          begin
               {
               while not eof do
               begin
                    if FieldByName('MEPR_CAPTIONNAME').AsString = 'Patient Administration' then
                         SPB_PatientAdministration.Enabled := true
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Sample Collection' then
                         Sb_SampleCollection.Enabled := true
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Test Result' then
                         SB_Pathology.Enabled := true
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Verification' then
                         BB_Verification.Enabled := true
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Utilities' then
                    begin
                         SB_Setup.Enabled := true;
                         SB_Setup.Tag:=FieldByName('MEPR_moduleid').AsInteger;

                    end
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Reports' then
                         SB_Reports.Enabled := true
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Report Dispatch' then
                         BB_Broadcast.Enabled := true;
                    Next;
               end;
               }
               while not eof do
               begin
                    if FieldByName('MEPR_CAPTIONNAME').AsString = 'Patient Administration' then
                         SPB_PatientAdministration.Enabled := true
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Sample Collection' then
                         Sb_SampleCollection.Enabled := true
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Test Result' then
                         SB_Pathology.Enabled := true
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Verification' then
                         BB_Verification.Enabled := true
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Utilities' then
                    begin
                         SB_Setup.Enabled := true;
                         SB_Setup.Tag:=FieldByName('MEPR_moduleid').AsInteger;

                    end
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Analysis' then
                         SB_Analysis.Enabled := true
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Report Dispatch' then
                         BB_Broadcast.Enabled := true
                    else if FieldByName('MEPR_CAPTIONNAME').AsString = 'Reports' then
                         SB_Report.Enabled := true;
                    Next;
               end;
          end;
     end;
     //SB_Setup.Enabled := True;
     Query_Blank.Free;
end;

