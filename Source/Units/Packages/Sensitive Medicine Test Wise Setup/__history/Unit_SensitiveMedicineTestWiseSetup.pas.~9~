unit Unit_SensitiveMedicineTestWiseSetup;

interface

uses
     Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
     DbGridExportToExcel, fxn, dm, ServerDate,
     Dialogs, DB, DBTables, DBAccess, Ora, OraSmart, MemDS, OraError, StdCtrls, ComCtrls, ExtCtrls, DBCtrls, Grids, DBGrids, Buttons, CheckLst;

type
     TForm_SensitiveMedicineTestWise = class(TForm)
          Panel2: TPanel;
          BB_Save: TBitBtn;
          BB_Close: TBitBtn;
          PageControl1: TPageControl;
          TabSheet1: TTabSheet;
          SpeedButton1: TSpeedButton;
          SpeedButton2: TSpeedButton;
          Label6: TLabel;
          Dblcb_TestName: TDBLookupComboBox;
          Query_list: TOraQuery;
          Ds_List: TDataSource;
          Query_TestName: TOraQuery;
          DS_TestName: TDataSource;
          Ds_Medicine: TDataSource;
          Query_Medicine: TOraQuery;
          Clb_Medicine: TCheckListBox;
    chk_All: TCheckBox;
    OraQuery_CheckMed: TOraQuery;
          procedure FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
          procedure FormShow(Sender: TObject);
          procedure BB_CloseClick(Sender: TObject);
          procedure BB_SaveClick(Sender: TObject);
          procedure FormCreate(Sender: TObject);
          procedure Dblcb_TestNameClick(Sender: TObject);
    procedure Dblcb_TestNameKeyDown(Sender: TObject; var Key: Word;
      Shift: TShiftState);
    Procedure DeleteSensitiveMedicineSetup(SENSITIVEMEDICINEID, TestNameID: Integer); Stdcall;
    procedure chk_AllClick(Sender: TObject);
     private
          pb_isnew: Boolean;
          pi_SmtsID: integer;
          { Private declarations }
     public
          { Public declarations }
     end;

var
     Form_SensitiveMedicineTestWise: TForm_SensitiveMedicineTestWise;

implementation

Procedure SaveSensitiveMedicineTestWise(SENSITIVEMEDICINEID, TESTNAMEID: integer); Stdcall;
external 'MidasFunction.bpl';
Procedure UpdateSensitiveMedicineTestWise(SMTWID, SENSITIVEMEDICINEID, TESTNAMEID: integer); Stdcall;
external 'MidasFunction.bpl';
Procedure DeleteSensitiveMedicicneTestWise(TESTNAMEID: integer); Stdcall; external 'MidasFunction.bpl';
{$R *.dfm}

procedure TForm_SensitiveMedicineTestWise.BB_CloseClick(Sender: TObject);
begin
     Close;
end;

procedure TForm_SensitiveMedicineTestWise.BB_SaveClick(Sender: TObject);
Var
     SMTWID, SENSITIVEMEDICINEID, TESTNAMEID: integer;
     i: integer;
begin
     TESTNAMEID := Dblcb_TestName.KeyValue;
     //DeleteSensitiveMedicicneTestWise(TESTNAMEID);
     for i := 0 to Clb_Medicine.Items.Count - 1 do
     begin
          //SENSITIVEMEDICINEID := i + 1;
          {if Clb_Medicine.State[i] = cbChecked then
          begin
               SaveSensitiveMedicineTestWise(SENSITIVEMEDICINEID, TESTNAMEID)
          end; }
          if Clb_Medicine.State[i] = cbChecked then
          begin
               SENSITIVEMEDICINEID:=arr_sensitivemedicineid[i];
               with OraQuery_CheckMed do
               begin
                    Close;
                    Session:=DM_Hospital.DB;
                    SQL.Clear;
                    sql.Add('select * from SENSITIVEMEDICINETESTWISE where testnameid='+inttostr(TESTNAMEID));
                    sql.Add('and sensitivemedicineid='+inttostr(SENSITIVEMEDICINEID));
                    Open;
               end;

               if OraQuery_CheckMed.FieldByName('SENSITIVEMEDICINEID').AsInteger=0 then
               SaveSensitiveMedicineTestWise(SENSITIVEMEDICINEID, TESTNAMEID);

          end
          Else
          Begin
               DeleteSensitiveMedicineSetup(SENSITIVEMEDICINEID, TESTNAMEID);
          End;

     end;
     ShowDoneMessage;
     OraQuery_CheckMed.Close;
     OraQuery_CheckMed.Free;
     Query_list.Close;
     Query_list.Open;
     ActiveControl := Dblcb_TestName;
end;

procedure TForm_SensitiveMedicineTestWise.chk_AllClick(Sender: TObject);
var
i:Integer;
begin
     if chk_All.Checked = true then
     begin
          for i := 0 to Clb_Medicine.Items.Count - 1 do
               Clb_Medicine.State[i] := cbChecked;
     end
     else
     begin
          for i := 0 to Clb_Medicine.Items.Count - 1 do
               Clb_Medicine.State[i] := cbUnchecked;
     end;
end;

procedure TForm_SensitiveMedicineTestWise.Dblcb_TestNameClick(Sender: TObject);
begin
     LoadSensitiveMedicineInCheckListBox(Clb_Medicine);
     CheckSensitiveMedicineTestWiseInCheckListBox(Dblcb_TestName.KeyValue, Clb_Medicine);
end;

procedure TForm_SensitiveMedicineTestWise.Dblcb_TestNameKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
      if Key=VK_DELETE then
      begin
         Dblcb_TestName.KeyValue:=null;
         LoadSensitiveMedicineInCheckListBox(Clb_Medicine);
      end;

end;

procedure TForm_SensitiveMedicineTestWise.FormCreate(Sender: TObject);
begin
     LoadSensitiveMedicineInCheckListBox(Clb_Medicine);
end;

procedure TForm_SensitiveMedicineTestWise.FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
     if Key = 27 then
          BB_CloseClick(Sender);

end;

procedure TForm_SensitiveMedicineTestWise.FormShow(Sender: TObject);
begin
     with Query_TestName do
     begin
     Close;
     Session:=Dm_Hospital.Db;
     sql.Clear;
     sql.Add('select Tena_TestNameID TestNameID,Tena_TestNameCode Testnamecode,Tena_TestName Testname from ' +gs_Hos_DB_UserName+'.Hs_Tena_TestName');
     sql.Add('where Instr(Tena_TestName,''C/S'')>1');
     sql.Add('order by TestName');
     Open;
     end;
     Dblcb_TestName.SetFocus;
end;

Procedure DeleteSensitiveMedicineSetup(SENSITIVEMEDICINEID, TestNameID: Integer); Stdcall;
Var
     Qry: TOraQuery;
     li_MedID: Integer;
begin
     Qry := TOraQuery.Create(nil);
     with Qry do
     begin
          Close;
          Session:=Dm_Hospital.Db;
          sql.Clear;
          sql.Add('delete from SENSITIVEMEDICINETESTWISE');
          SQL.Add(' testnameid='+inttostr(TESTNAMEID));
          ExecSQL;
     end;
     Qry.Free;
end;

end.
