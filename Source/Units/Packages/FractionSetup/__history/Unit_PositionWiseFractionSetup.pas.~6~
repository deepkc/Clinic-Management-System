procedure TForm_PositionWiseFractionSetup.Edit_FractionAmountExit(Sender: TObject);
begin
     IF Trim(Edit_FractionAmount.Text) = '' Then
          Edit_FractionAmount.Text := '0';

     IF (DBLCB_TestName.KeyValue <> NULL) and (pf_TestPrice > 0) and (Trim(Edit_FractionAmount.Text) <> '') Then
     Begin
          if RB_Amt.Checked = True then
          Begin
               if CB_FBInTestPriceInsteadofFrctTotal.Checked = True then
               Edit_FractionRate.Text := FormatFloat('0.00000', ((StrToFloat(Edit_FractionAmount.Text) / pf_TestPrice) * 100))
               Else
               Begin
                    Edit_FractionRate.Text := FormatFloat('0.00000', ((StrToFloat(Edit_FractionAmount.Text) / pf_TotFrctAmt) * 100));
                    pf_FractionRateStd := StrToFloat(Edit_FractionRate.Text);
                    pf_FractionRateActual := ((StrToFloat(Edit_FractionAmount.Text) / pf_TestPrice) * 100);
               End;
          End;
     End
     Else
     Begin
          if (pf_TestPrice=0) and (RB_Amt.Checked=True) then
          Begin
               MessageDlg('Sorry ! Test Price is Zero(0). So Fraction Couldn''t Break Down In Amount. Only Posible In Percent(%).',mtWarning,[mbok],0);
               Edit_FractionAmount.Text:='0';
               RB_Rate.Checked:=True;
               Edit_FractionRate.SetFocus;
               Exit;
          End;
     End;
end;

