procedure TForm_PositionWiseFractionSetup.DBGridCommTypeDblClick(Sender: TObject);
begin
     b_IsNew := False;
     Label_Mode.Caption := 'Edit Mode';
     DBLCB_Position.SetFocus;
     POSITIONWISEFractionID := Query_PositionWiseFraction.FieldByName('POSITIONWISEFractionID').AsInteger;
     DBLCB_TestName.KeyValue := Query_PositionWiseFraction.FieldByName('FractionId').AsInteger;
     DBLCB_Position.KeyValue := Query_PositionWiseFraction.FieldByName('PositionId').AsInteger;

     IF Query_PositionWiseFraction.FieldByName('IsDefaultDoc').AsString = 'Y' Then
          CB_DefaultDocPerson.Checked := True
     Else
          CB_DefaultDocPerson.Checked := False;

     IF Query_PositionWiseFraction.FieldByName('ISFIXEDPERSONFORFRACTION').AsString = 'Y' Then
          DBLCB_DefaultDocPos.KeyValue := Query_PositionWiseFraction.FieldByName('DocId').AsInteger
     Else
          DBLCB_DefaultDocPos.KeyValue := NULL;

     pf_FractionRateActual := Query_PositionWiseFraction.FieldByName('FractionRate').AsFloat;
     Edit_FractionAmount.Text := Query_PositionWiseFraction.FieldByName('FractionAmount').AsString;
     pf_FractionAmtActual := Query_PositionWiseFraction.FieldByName('FractionAmount').AsFloat;

     pf_FractionRateStd := Query_PositionWiseFraction.FieldByName('FractionRateStd').AsFloat;
     pf_FractionAmtStd := Query_PositionWiseFraction.FieldByName('FractionAmountStd').AsFloat;

     IF Query_PositionWiseFraction.FieldByName('ISFRACTIONBREAKINTESTPRICE').AsString = 'Y' Then
     Begin
          CB_FBInTestPriceInsteadofFrctTotal.Checked := True;
          Edit_FractionRate.Text := Query_PositionWiseFraction.FieldByName('FractionRate').AsString;
     End
     Else
     Begin
          CB_FBInTestPriceInsteadofFrctTotal.Checked := False;
          Edit_FractionRate.Text := Query_PositionWiseFraction.FieldByName('FractionRateStd').AsString;
     End;

     IF Query_PositionWiseFraction.FieldByName('ISFIXEDPERSONFORFRACTION').AsString = 'Y' Then
          CB_FixedCommession.Checked := True
     Else
          CB_FixedCommession.Checked := False;

     IF Query_PositionWiseFraction.FieldByName('ISFRACTIONPROPWITHDISPER').AsString = 'Y' Then
          CB_FractionProportional.Checked := True
     Else
          CB_FractionProportional.Checked := False;

     IF Query_PositionWiseFraction.FieldByName('ISCOMPFORFRACTION').AsString = 'Y' Then
          CB_CompForFration.Checked := True
     Else
          CB_CompForFration.Checked := False;

     IF Query_PositionWiseFraction.FieldByName('IsActive').AsString = 'Y' Then
     CB_IsActiveParticipant.Checked:=True
     Else
     CB_IsActiveParticipant.Checked:=False;
end;

