end;

procedure TForm_PositionWiseFractionSetup.BtnSaveClick(Sender: TObject);
var
     lf_StdAmt, lf_TotAmt: Double;
     ls_Name: String;
     li_DocId: Integer;
begin
     IF (DBLCB_TestName.KeyValue = NULL) or (DBLCB_TestName.KeyValue = 0) Then
     Begin
          MessageDlg('Plz. First Select Test Name.', mtInformation, [mbok], 0);
          DBLCB_TestName.SetFocus;
          Exit;
     End;

     IF (CB_FixedCommession.Checked = True) and (DBLCB_DefaultDocPos.KeyValue = NULL) Then
     Begin
          MessageDlg('Plz. Choose Doctor/Tech. for Fixed Person(Position) Getting Commession.', mtInformation, [mbok], 0);
          DBLCB_DefaultDocPos.SetFocus;
          Exit;
     End;

     IF DBLCB_Position.KeyValue = NULL Then
     Begin
          MessageDlg('Plz. First Select Position.', mtInformation, [mbok], 0);
          DBLCB_Position.SetFocus;
          Exit;
     End;

     IF (Trim(Edit_FractionRate.Text) = '') and (Trim(Edit_FractionAmount.Text) = '') Then
     Begin
          MessageDlg('Plz. Put Commession.', mtInformation, [mbok], 0);
          Edit_FractionRate.SetFocus;
          Exit;
     End;

     IF Trim(Edit_FractionAmount.Text) = '' Then
          Edit_FractionAmount.Text := '0';
     IF (Trim(Edit_FractionRate.Text) = '') and (StrToFloat(Edit_FractionAmount.Text) > 0) Then
          Edit_FractionAmountExit(Sender);

     IF DBLCB_DefaultDocPos.KeyValue <> NULL Then
     Begin
          li_DocId := DBLCB_DefaultDocPos.KeyValue;
          ls_Name := DBLCB_DefaultDocPos.Text;
     End
     Else
     Begin
          li_DocId := 0;
          ls_Name := '';
     End;

     IF (StrToFloat(Label_TestPrice.Caption) > 0) and
       (((StrToFloat(Edit_FractionRate.Text) <= 0) and (StrToFloat(Edit_FractionAmount.Text) > 0)) or
            ((StrToFloat(Edit_FractionRate.Text) > 0) and (StrToFloat(Edit_FractionAmount.Text) <= 0))) Then
     Begin
          IF ((StrToFloat(Edit_FractionRate.Text) <= 0) and (StrToFloat(Edit_FractionAmount.Text) > 0)) Then
               Edit_FractionAmountExit(Sender)
          Else
               Edit_FractionRateExit(Sender);
     End;

     { IF (CB_FixedCommession.Checked=True) and (Trim(Edit_Name.Text)='') Then
       Begin
       MessageDlg('Plz. Put The Name of Fixed Person Getting Fraction.',mtInformation,[mbok],0);
       Edit_Name.SetFocus;
       Exit;
       End; }

     With Query_Void do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select Sum(POWF_FractionRate) as FractionRate,Sum(POWF_FractionAmount) as FractionAmount From ');
          sql.add(' HS_POWF_POSITIONWISEFRACTION where POWF_FractionId=' + IntToStr(DBLCB_TestName.KeyValue));
          Open;
     End;

     IF Query_TestName.FieldByName('ISRATEAMT').AsString = 'R' Then
     Begin
          lf_StdAmt := Query_TestName.FieldByName('FractionRate').AsFloat;
          IF b_IsNew Then
               lf_TotAmt := Query_Void.FieldByName('FractionRate').AsFloat + StrToFloat(Edit_FractionRate.Text)
          Else
               lf_TotAmt := Query_Void.FieldByName('FractionRate').AsFloat + StrToFloat(Edit_FractionRate.Text)
                 - Query_PositionWiseFraction.FieldByName('FractionRate').AsFloat;

          { IF lf_StdAmt < lf_TotAmt Then
            Begin
            MessageDlg('Total Commession Rate  ('+FloatToStr(lf_TotAmt)+')  Excede The Statndard Total  ('+FloatToStr(lf_StdAmt)+')  Commession Rate.',mtWarning,[mbok],0);
            Edit_FractionRate.SetFocus;
            Exit;
            End; }
     End
     Else
     Begin
          lf_StdAmt := Query_TestName.FieldByName('FractionAmount').AsFloat;
          IF b_IsNew Then
               lf_TotAmt := Query_Void.FieldByName('FractionAmount').AsFloat + StrToFloat(Edit_FractionRate.Text)
          Else
               lf_TotAmt := Query_Void.FieldByName('FractionAmount').AsFloat + StrToFloat(Edit_FractionRate.Text)
                 - Query_PositionWiseFraction.FieldByName('FractionAmount').AsFloat;
     End;

     IF DBLCB_Position.Text = 'SERVICE' Then { Sp. Case For Om Hospital (Service as Part of Operation) }
     Begin
          ls_Name := 'SERVICE';
          CB_FixedCommession.Checked := True;
          li_DocId := 0;
     End;

     IF b_IsNew Then
     Begin
          POSITIONWISEFractionID := GetMaxId('hs_powf_PositionWiseFraction', 'powf_POSITIONWISEFractionID');
          With Query_Void do
          Begin
               Close;
               sql.Clear;
               sql.add(' Insert Into hs_powf_PositionWiseFraction(powf_POSITIONWISEFractionID,powf_FractionId,powf_PositionId,powf_PositionName,powf_Name,powf_DocId,');
               sql.add(
                    ' powf_IsDefaultDoc,powf_FractionRate,powf_FractionAmount,powf_FRACTIONRATESTD,powf_FRACTIONAMOUNTSTD,POWF_ISFRCTBREAKINTESTPRICE,powf_ISFIXEDPERSONFORFRACTION,');
               sql.add(' powf_IsFractionPropWithDisPer,powf_IsCompForFraction,powf_FractionFor,powf_IsActive) Values (' + IntToStr(POSITIONWISEFractionID));
               sql.add(' ,' + IntToStr(DBLCB_TestName.KeyValue) + ',' + IntToStr(DBLCB_Position.KeyValue));
               sql.add(' ,' + #39 + DBLCB_Position.Text + #39);
               sql.add(' ,' + #39 + ls_Name + #39 + ',' + IntToStr(li_DocId));
               IF CB_DefaultDocPerson.Checked Then
                    sql.add(' ,''Y''')
               Else
                    sql.add(' ,''N''');

               sql.add(' ,' + FloatToStr(pf_FractionRateActual) + ',' + FloatToStr(pf_FractionAmtActual));
               sql.add(' ,' + FloatToStr(pf_FractionRateStd) + ',' + FloatToStr(pf_FractionAmtStd));

               IF CB_FBInTestPriceInsteadofFrctTotal.Checked = True Then
                    sql.add(' ,''Y''')
               Else
                    sql.add(' ,''N''');

               IF CB_FixedCommession.Checked = True Then
                    sql.add(' ,''Y''')
               Else
                    sql.add(' ,''N''');
               IF CB_FractionProportional.Checked = True Then
                    sql.add(' ,''Y''')
               Else
                    sql.add(' ,''N''');

               IF CB_CompForFration.Checked = True Then
                    sql.add(' ,''Y''')
               Else
                    sql.add(' ,''N''');

               sql.add(' ,' + #39 + ps_FractionFor + #39);
               IF CB_IsActiveParticipant.Checked = True Then
                    sql.add(' ,''Y''')
               Else
                    sql.add(' ,''N''');
               sql.add(' )');
               // sql.SaveToFile('C:\PositonWise.Txt');
               ExecSQL;
          End;
     End
     Else
     Begin
          With Query_Void do
          Begin
               Close;
               sql.Clear;
               sql.add(' Update hs_powf_PositionWiseFraction Set ');
               sql.add(' powf_PositionId=' + IntToStr(DBLCB_Position.KeyValue) + ',');
               sql.add(' powf_PositionName=' + #39 + DBLCB_Position.Text + #39 + ',');
               sql.add(' powf_Name=' + #39 + ls_Name + #39 + ',');
               sql.add(' powf_DocId=' + IntToStr(li_DocId) + ',');

               IF CB_DefaultDocPerson.Checked Then
                    sql.add(' powf_IsDefaultDoc=''Y''')
               Else
                    sql.add(' powf_IsDefaultDoc=''N''');

               // sql.add(' FractionAmount=' + Edit_FractionAmount.Text + ',FractionRate =' + Edit_FractionRate.Text);
               sql.add(' ,powf_FractionAmount=' + FloatToStr(pf_FractionAmtActual) + ',powf_FractionRate =' + FloatToStr(pf_FractionRateActual));
               sql.add(' ,powf_FractionAmountStd=' + FloatToStr(pf_FractionAmtStd) + ', powf_FractionRateStd=' + FloatToStr(pf_FractionRateStd));

               IF CB_FBInTestPriceInsteadofFrctTotal.Checked = True Then
                    sql.add(' ,POWF_ISFRCTBREAKINTESTPRICE=''Y''')
               Else
                    sql.add(' ,POWF_ISFRCTBREAKINTESTPRICE=''N''');

               IF CB_FixedCommession.Checked = True Then
                    sql.add(' ,POWF_ISFIXEDPERSONFORFRACTION=''Y''')
               Else
                    sql.add(' ,POWF_ISFIXEDPERSONFORFRACTION=''N''');
               IF CB_FractionProportional.Checked = True Then
                    sql.add(' ,POWF_IsFractionPropWithDisPer=''Y''')
               Else
                    sql.add(' ,POWF_IsFractionPropWithDisPer=''N''');

               IF CB_CompForFration.Checked = True Then
                    sql.add(' ,POWF_IsCompForFraction=''Y''')
               Else
                    sql.add(' ,POWF_IsCompForFraction=''N''');

               IF CB_IsActiveParticipant.Checked = True Then
                    sql.add(' ,POWF_IsActive=''Y''')
               Else
                    sql.add(' ,POWF_IsActive=''N''');

               sql.add(' where POWF_POSITIONWISEFractionID=' + IntToStr(POSITIONWISEFractionID));
               ExecSQL;
          End;
     End;

     ShowDoneMessage;

     Query_PositionWiseFraction.Close;
     Query_PositionWiseFraction.Open;
     Query_PositionWiseFraction.Locate('POSITIONWISEFractionID', POSITIONWISEFractionID, []);

     ReadyForNewData;
end;

