procedure TForm_PositionWiseFractionSetup.SBDeleteClick(Sender: TObject);
begin
     IF MessageDlg('Are You Sure To Delete Position Wise Commession SetUp ?', mtConfirmation, [mbYes, MBNo], 0) = mrYes Then
     Begin
          With Query_Void do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select * From hs_frde_FractionDetail where frde_POSITIONWISEFractionID=' + IntToStr(Query_PositionWiseFraction.FieldByName
                           ('POSITIONWISEFractionID').AsInteger));
               Open;
               IF RecordCount > 0 Then
               Begin
                    MessageDlg('Sorry ! You Cannot Delete This Setup Because It Is Already Used In Doctor Fraction.', mtWarning, [mbok], 0);
                    Exit;
               End;
          End;

          With Query_Void do
          Begin
               Close;
               sql.Clear;
               sql.add(' Delete From hs_powf_PositionWiseFraction where');
               sql.add(' powf_POSITIONWISEFractionID=' + IntToStr(Query_PositionWiseFraction.FieldByName('POSITIONWISEFractionID').AsInteger));
               ExecSQL;
          End;

          With Query_PositionWiseFraction do
          Begin
               Close;
               ParamByName('FractionId').AsInteger := DBLCB_TestName.KeyValue;
               Open;
          End;
     End;
end;

