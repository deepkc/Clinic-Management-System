     End;
end;

procedure TForm_PositionWiseFractionSetup.Edit_FractionRateExit(Sender: TObject);
begin
     IF Trim(Edit_FractionRate.Text) = '' Then
          Edit_FractionRate.Text := '0';

     IF (DBLCB_TestName.KeyValue <> NULL) and (pf_TestPrice > 0) and (Trim(Edit_FractionRate.Text) <> '') Then
     Begin
          IF Trim(Edit_FractionAmount.Text) = '' Then
               Edit_FractionAmount.Text := '0';
          // Edit_FractionRate.Text:=FormatFloat('0.00000',((StrToFloat(Edit_FractionAmount.Text)/pf_TestPrice)*100));

          if CB_FBInTestPriceInsteadofFrctTotal.Checked = True then
          Begin
               IF Abs((pf_TestPrice * (StrToFloat(Edit_FractionRate.Text)) / 100) - StrToFloat(Edit_FractionAmount.Text)) > 0.5 Then
                    Edit_FractionAmount.Text := FormatFloat('0.00000', (pf_TestPrice * (StrToFloat(Edit_FractionRate.Text)) / 100));
               pf_FractionAmtActual := StrToFloat(Edit_FractionAmount.Text);
               pf_FractionAmtStd := pf_FractionAmtActual;

               // --
               if RB_Rate.Checked=True then
               Begin
                    pf_FractionRateActual := StrToFloat(Edit_FractionRate.Text);
                    pf_FractionRateStd := pf_FractionRateActual;
               End;
          End
          Else
          Begin
               IF Abs((pf_TotFrctAmt * (StrToFloat(Edit_FractionRate.Text)) / 100) - StrToFloat(Edit_FractionAmount.Text)) > 0.5 Then
                    Edit_FractionAmount.Text := FormatFloat('0.00000', (pf_TotFrctAmt * (StrToFloat(Edit_FractionRate.Text)) / 100));
               pf_FractionAmtActual := StrToFloat(Edit_FractionAmount.Text);
               pf_FractionAmtStd := ((pf_TotFrctAmt * (StrToFloat(Edit_FractionRate.Text)) / 100));

               pf_FractionRateStd := GetNoOfDecimalPartOfFloatNum((((StrToFloat(Edit_FractionAmount.Text) / pf_TotFrctAmt) * 100)), 2);
               pf_FractionRateActual := ((StrToFloat(Edit_FractionAmount.Text) / pf_TestPrice) * 100);

          End;
     End
     Else
     Begin
          IF (pf_TestPrice=0) and (RB_Rate.Checked=True) Then
          Begin
               if CB_FBInTestPriceInsteadofFrctTotal.Checked=False then
               Begin
                    pf_FractionRateStd := StrToFloat(Edit_FractionRate.Text);
                    pf_FractionRateActual := GetNoOfDecimalPartOfFloatNum((pf_TotFrctRate * StrToFloat(Edit_FractionRate.Text))/100,3);
               End
               Else
               Begin
                    pf_FractionRateStd := StrToFloat(Edit_FractionRate.Text);
                    pf_FractionRateActual := StrToFloat(Edit_FractionRate.Text);
               End;
          End;
     End;
end;

procedure TForm_PositionWiseFractionSetup.SPB_DoctorWiseFrctSetupClick(Sender: TObject);
begin
     With Form_DoctorWiseFrctSetup Do
     Begin
          DBLCB_TestName.KeyValue := Self.DBLCB_TestName.KeyValue;
          DBLCB_TestName.Enabled := False;

          Label_TestPrice.Caption := Self.Label_TestPrice.Caption;
          Label_FractionFor.Caption := Self.Label_FractionFor.Caption;

          DBLCB_Position.KeyValue := Self.Query_PositionWiseFraction.FieldByName('PositionId').AsInteger;
          DBLCB_Position.Color := clMenu;
          DBLCB_Position.Enabled := False;

          pi_POSITIONWISEFractionID := Self.Query_PositionWiseFraction.FieldByName('POSITIONWISEFractionID').AsInteger;
          Label_Percent.Caption := Self.Query_PositionWiseFraction.FieldByName('FractionRate').AsString;
          Label_Amt.Caption := Self.Query_PositionWiseFraction.FieldByName('FractionAmount').AsString;

          pf_TestPrice := Self.pf_TestPrice;
          ps_FractionFor := Self.ps_FractionFor;
          ShowModal;
     End;
end;

