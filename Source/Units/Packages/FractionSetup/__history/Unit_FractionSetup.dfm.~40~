  object Query_TestName: TOraQuery
    SQL.Strings = (
      
        'Select tp.tenp_testprice testprice,tn.tena_depid depid,tn.tena_t' +
        'estnameid testnameid,tn.* From hs_tena_TestName TN,hs_tenp_testn' +
        'ameprice tp  where tn.tena_testnameid=tp.tenp_testnameid and ten' +
        'a_IsActive='#39'Y'#39
      
        'and tena_TestNameId Not In (Select Distinct frac_TestNameId From' +
        ' hs_frac_Fraction where frac_TestNameId > 0)'
      'Order By Trim(tena_TestName)')
    Left = 728
    Top = 80
  end
