  object Query_TestWiseFraction: TOraQuery
    SQL.Strings = (
      
        'Select FR.FRAC_FractionId fractionid,FR.FRAC_DepId depid,Trim(FR' +
        '.FRAC_Description) Description,FR.FRAC_FractionAmount fractionam' +
        'ount,FR.FRAC_FractionRate fractionrate,FR.FRAC_HosPartFractionAm' +
        'ount hospartfractionamount,FR.FRAC_HosPartFractionRate hospartfr' +
        'actionrate,FR.FRAC_FractionFor fractionfor,'
      
        'FR.FRAC_TestNameId testnameid,FR.FRAC_IsRateAmt israteamt,FR.FRA' +
        'C_IsTestDept istestdept,FR.FRAC_IsFractionPropWithDisPer tenp_is' +
        'fractionpropwithdisper,FR.FRAC_ISCHRGDIFFFROMTESTPRICE ISCHRGDIF' +
        'FFROMTESTPRICE,FR.FRAC_FIXEDAMTDEDUCTONTESTPRICE tenp_FIXEDAMTDE' +
        'DUCTONTESTPRICE,FRAC_ISSEPRTCHARGEFROMTESTPRI,'
      
        '(Select Count(POWF_PositionWiseFractionID) From HS_POWF_POSITION' +
        'WISEFRACTION where POWF_FractionId=FR.FRAC_FractionId and POWF_I' +
        'sActive='#39'Y'#39') as NoOfInvolvement'
      'From HS_FRAC_FRACTION FR where FR.FRAC_FractionType=3'
      'Order By Trim(FR.FRAC_Description)')
    Left = 44
    Top = 359
  end
