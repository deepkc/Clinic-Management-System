procedure TForm_FractionSetup.SPB_DeleteClick(Sender: TObject);
begin
     With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select * From hs_frde_FractionDetail where frde_FractionId=' + IntToStr(Query_TestWiseFraction.FieldByName('FractionID').AsInteger));
          Open;
          IF RecordCount > 0 Then
          Begin
               MessageDlg('Sorry ! You Cannot Delete This Setup Because It Is Already Used In Doctor Fraction.', mtWarning, [mbok], 0);
               Exit;
          End;
     End;

     IF MessageDlg('Are You Sure To Delete This Commession SetUp ?', mtConfirmation, [MbYes, MbNo], 0) = MrYes Then
     Begin
          Try
               DM_Hospital.Db.StartTransaction;
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Delete From hs_powf_PositionWiseFraction where  powf_FractionId=' + IntToStr
                           (Query_TestWiseFraction.FieldByName('FractionId').AsInteger));
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Delete From hs_frac_Fraction where  frac_TestNameId=' + IntToStr(Query_TestWiseFraction.FieldByName('TestNameId')
                                .AsInteger));
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Update hs_tena_TestName Set tena_IsFractionableItem=''N'' where tena_TestNameId=' + IntToStr
                           (Query_TestWiseFraction.FieldByName('TestNameId').AsInteger));
                    ExecSQL;
               End;

               DM_Hospital.Db.Commit;
               ShowDoneMessage;
               Query_TestWiseFraction.Close;
               Query_TestWiseFraction.Open;
          Except
               DM_Hospital.Db.Rollback;
               MessageDlg('Failure To Delete !', mtWarning, [mbok], 0);
               Exit;
          End;
     End;
end;

