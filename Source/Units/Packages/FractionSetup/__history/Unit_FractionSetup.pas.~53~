               Edit_Rate.Text := '0';
          IF Trim(Edit_Amount.Text) = '' Then
               Edit_Amount.Text := '0';

          IF RB_Both.Checked = True Then
               ls_FractionFor := 'Both'
          Else IF RB_OutDoor.Checked = True Then
               ls_FractionFor := 'OutDoor'
          Else
               ls_FractionFor := 'Indoor';

          if Trim(Edit_FixedAmtDeduct.Text) = '' then
               Edit_FixedAmtDeduct.Text := '0';

          lf_DeductAmtInTestPrice := StrToFloat(Edit_FixedAmtDeduct.Text);

          IF b_IsNew Then
          Begin
               IF DBLCB_TestName.KeyValue <> NULL Then
               Begin
                    With Query_Process do
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Select * From hs_frac_Fraction where frac_TestNameId=' + IntToStr(DBLCB_TestName.KeyValue));
                         sql.add(' and frac_FractionFor=' + #39 + ls_FractionFor + #39);
                         Open;
                    End;

                    IF Query_Process.RecordCount > 0 Then
                    Begin
                         MessageDlg('Fraction has already setup for this test.', mtInformation, [mbok], 0);
                         DBLCB_TestName.SetFocus;
                         Exit;
                    End;
               End
               Else
               Begin
                    With Query_Process do
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Select * From hs_frac_Fraction where frac_TestNameId <=0 and frac_DepId=' + IntToStr(DBLCB_Department.KeyValue));
                         sql.add(' and frac_FractionType=3 and frac_FractionFor=' + #39 + ls_FractionFor + #39);
                         Open;
                    End;

                    IF Query_Process.RecordCount > 0 Then
                    Begin
                         MessageDlg('Fraction setup of this department is already exist.', mtInformation, [mbok], 0);
                         DBLCB_Department.SetFocus;
                         Exit;
                    End;
               End;

               IF MessageDlg('Are you Sure to Save ?', mtConfirmation, [MbYes, MbNo], 0) <> MrYes Then
                    Exit;
               pi_FractionId := GetMaxId('hs_frac_Fraction', 'frac_FractionId');
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Insert Into hs_frac_Fraction(frac_FractionId, frac_DOCID, frac_DOCTYPE, frac_DEPID,frac_TESTNAMEID, frac_FractionRate,');
                    sql.add(' frac_FractionAmount,frac_HosPartFractionRate,frac_HosPartFractionAmount,frac_IsRateAmt,frac_FractionType,frac_DESCRIPTION,');
                    sql.add(
                         ' frac_IsTestDept,frac_IsFractionPropWithDisPer,frac_FractionFor,FRAC_ISSEPRTCHARGEFROMTESTPRI,FRAC_FIXEDAMTDEDUCTONTESTPRICE) Values(');
                    sql.add(IntToStr(pi_FractionId));
                    sql.add(',0,'''',' + IntToStr(li_DepId));
                    sql.add(',' + IntToStr(li_TestNameId));
                    sql.add(',' + Edit_Rate.Text);
                    sql.add(',' + Edit_Amount.Text);
                    sql.add(',' + Edit_HosPartRate.Text);
                    sql.add(',' + Edit_HosPartAmount.Text);
                    IF RB_Amt.Checked = True Then
                         sql.add(',''A''')
                    Else
                         sql.add(',''R''');
                    sql.add(',3,' + #39 + ls_Description + #39);
                    sql.add(',' + #39 + ls_IsTestDept + #39);
                    IF CB_FractionProportional.Checked = True Then
                         sql.add(' ,''Y''')
                    Else
                         sql.add(' ,''N''');
                    sql.add(' ,' + #39 + ls_FractionFor + #39);

                    IF CB_SeparateHospitalPart.Checked = True Then
                         sql.add(' ,''Y''')
                    Else
                         sql.add(' ,''N''');
                    sql.add(',' + FloatToStr(lf_DeductAmtInTestPrice));
                    sql.add(')');
                    ExecSQL;
               End;
              { if b_IsNew = True Then
               SPB_PositionWiseFrctSetupClick(Sender);
               b_IsNew := True; }
              // ShowDoneMessage;
          End
          Else
          Begin
               IF DBLCB_TestName.KeyValue <> NULL Then
               Begin
                    With Query_Process do
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Select frac_fractionid fractionid From hs_frac_Fraction where frac_TestNameId=' + IntToStr(DBLCB_TestName.KeyValue));
                         sql.add(' and frac_FractionFor=' + #39 + ls_FractionFor + #39);
                         Open;
                    End;

                    IF (Query_Process.RecordCount > 0) and (pi_FractionId <> Query_Process.FieldByName('FractionId').AsInteger) Then
                    Begin
                         IF ls_FractionFor = 'Both' Then
                              MessageDlg('Sorry You Cannot Set Twice Fraction For " ' + ls_FractionFor +
                                     ' ". Keep either Outdoor or Indoor.', mtInformation, [mbok], 0)
                         Else IF ls_FractionFor = 'OutDoor' Then
                              MessageDlg('Sorry You Cannot Set Twice Fraction For " ' + ls_FractionFor + ' ". Keep either Both or Indoor.',
                                   mtInformation, [mbok], 0)
                         Else
                              MessageDlg('Sorry You Cannot Set Twice Fraction For " ' + ls_FractionFor +
                                     ' ". Keep either Both or Outdoor.', mtInformation, [mbok], 0);
                         DBLCB_TestName.SetFocus;
                         Exit;
                    End;
               End
               Else
               Begin
                    With Query_Process do
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Select frac_fractionid fractionid From frac_Fraction where frac_TestNameId <=0 and DepId=' + IntToStr(DBLCB_Department.KeyValue));
                         sql.add(' and frac_FractionType=3 and frac_FractionFor=' + #39 + ls_FractionFor + #39);
                         Open;
                    End;

                    IF (Query_Process.RecordCount > 0) and (pi_FractionId <> Query_Process.FieldByName('FractionId').AsInteger) Then
                    Begin
                         IF ls_FractionFor = 'Both' Then
                              MessageDlg('Sorry You Cannot Set Twice Fraction For " ' + ls_FractionFor +
                                     ' ". Keep either Outdoor or Indoor.', mtInformation, [mbok], 0)
                         Else IF ls_FractionFor = 'OutDoor' Then
                              MessageDlg('Sorry You Cannot Set Twice Fraction For " ' + ls_FractionFor + ' ". Keep either Both or Indoor.',
                                   mtInformation, [mbok], 0)
                         Else
                              MessageDlg('Sorry You Cannot Set Twice Fraction For " ' + ls_FractionFor +
                                     ' ". Keep either Both or Outdoor.', mtInformation, [mbok], 0);
                         DBLCB_Department.SetFocus;
                         Exit;
                    End;
               End;

               IF MessageDlg('Are you Sure to Save ?', mtConfirmation, [MbYes, MbNo], 0) <> MrYes Then
                    Exit;
               Try
                    DM_Hospital.Db.StartTransaction;
                    With Query_Process do
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Update hs_frac_Fraction Set frac_DEPID=' + IntToStr(li_DepId));
                         sql.add(' ,frac_TESTNAMEID=' + IntToStr(li_TestNameId));
                         sql.add(' ,frac_FractionRate=' + Edit_Rate.Text);
                         sql.add(' ,frac_FractionAmount=' + Edit_Amount.Text);
                         sql.add(' ,frac_HosPartFractionRate=' + Edit_HosPartRate.Text);
                         sql.add(' ,frac_HosPartFractionAmount=' + Edit_HosPartAmount.Text);
                         IF RB_Amt.Checked = True Then
                              sql.add(' ,frac_IsRateAmt=''A''')
                         Else
                              sql.add(' ,frac_IsRateAmt=''R''');
                         IF CB_FractionProportional.Checked = True Then
                              sql.add(' ,frac_IsFractionPropWithDisPer=''Y''')
                         Else
                              sql.add(' ,frac_IsFractionPropWithDisPer=''N''');
                         IF CB_SeparateHospitalPart.Checked = True Then
                              sql.add(' ,FRAC_ISSEPRTCHARGEFROMTESTPRI=''Y''')
                         Else
                              sql.add(' ,FRAC_ISSEPRTCHARGEFROMTESTPRI=''N''');
                         sql.add(' ,frac_IsTestDept=' + #39 + ls_IsTestDept + #39);
                         sql.add(' ,frac_DESCRIPTION=' + #39 + ls_Description + #39);
                         sql.add(' ,frac_FractionFor=' + #39 + ls_FractionFor + #39);
                         sql.add(' ,FRAC_FIXEDAMTDEDUCTONTESTPRICE=' + FloatToStr(lf_DeductAmtInTestPrice));
                         sql.add(' where frac_FractionId=' + IntToStr(pi_FractionId));
                         ExecSQL;

                         Close;
                         sql.Clear;
                         sql.add(' Update hs_powf_PositionWiseFraction set powf_FractionFor=' + #39 + ls_FractionFor + #39 + ' where powf_FractionId=' +
                                IntToStr(pi_FractionId));
                         ExecSQL;
                    End;
                    DM_Hospital.Db.Commit;
                    ShowDoneMessage;
               Except
                    DM_Hospital.Db.Rollback;
                    MessageDlg('Failure To Update !', mtWarning, [mbok], 0);
               End;
          End;

          IF DBLCB_Department.KeyValue <> NULL Then
          Begin
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update hs_tena_TestName Set tena_IsFractionableItem=''Y'' where tena_DepId=' + IntToStr(DBLCB_Department.KeyValue));
                    ExecSQL;
               End;
          End
          Else
          Begin
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update hs_tena_TestName Set tena_IsFractionableItem=''Y'' where tena_TestNameId=' + IntToStr(li_TestNameId));
                    ExecSQL;
               End;
          End;

          SPB_PosWiseSetup2nd.Visible:=True;
          Query_TestWiseFraction.Close;
          Query_TestWiseFraction.Open;
          Query_TestWiseFraction.Locate('FractionId', pi_FractionId, []);
          DBLCB_Department.KeyValue := NULL;
          DBLCB_TestName.KeyValue := NULL;
          DBLCB_TestName.SetFocus;
          RB_Both.Checked := True;
          Edit_Rate.Text := '';
          Edit_Amount.Text := '';
          Edit_HosPartRate.Text := '';
          Edit_HosPartAmount.Text := '';
          CB_FractionProportional.Checked := False;
          RB_Rate.Checked := True;

          if b_IsNew=True Then
          SPB_PositionWiseFrctSetupClick(Sender);

          b_IsNew := True;

     End;
End;

procedure TForm_FractionSetup.RB_FractionClick(Sender: TObject);
begin
     BtnSave.Enabled := True;

     IF RB_Fraction.ItemIndex = 0 Then // Fixed Commession Setup
     Begin
          GroupBox_FixedComm.BringToFront;
          With Query_Process Do
          Begin
               Close;
               Session:=DM_Hospital.DB;
               sql.Clear;
               sql.add(' Select FRAC_FractionId FractionId,FRAC_Description Description,FRAC_FractionRate FractionRate,FRAC_IsRateAmt IsRateAmt,FRAC_FractionAmount FractionAmount From HS_FRAC_FRACTION ');
               sql.add(' Where FRAC_FractionType=1 Order By FRAC_Description ');
               Open;

               If Query_Process.FieldByName('FractionId').AsInteger = 0 Then
               Begin
                    Edit_OpdReg.Text := '0';
                    Edit_EmerOPD.Text := '0';
                    Edit_EmerNightOPD.Text := '0';
                    Edit_OpdProc.Text := '0';
                    Edit_Pathology.Text := '0';
                    Edit_TDS.Text := '0';
                    Is_Fixed_Empty := True;
                    Exit;
               End;

               Query_Process.First;
               While not Query_Process.EOF Do
               Begin
                    Is_Fixed_Empty := False;
                    IF Query_Process.FieldByName('Description').AsString = 'ENDOCRIONOLOGY NEW PATIENT' Then
                    Begin
                         IF Query_Process.FieldByName('IsRateAmt').AsString = 'A' Then
                         Begin
                              CB_OPDReg.Checked := True;
                              Edit_OpdReg.Text := FieldByName('FractionAmount').AsString;
                         End
                         Else
                         Begin
                              CB_OPDReg.Checked := False;
                              Edit_OpdReg.Text := FieldByName('FractionRate').AsString;
                         End;

                    End
                    Else IF Query_Process.FieldByName('Description').AsString = 'ENDOCRIONOLOGY FOLLOW UP PATIENT' Then
                    Begin
                         IF Query_Process.FieldByName('IsRateAmt').AsString = 'A' Then
                         Begin
                              CB_EmrOPD.Checked := True;
                              Edit_EmerOPD.Text := FieldByName('FractionAmount').AsString;
                         End
                         Else
                         Begin
                              CB_EmrOPD.Checked := False;
                              Edit_EmerOPD.Text := FieldByName('FractionRate').AsString;
                         End;
                    End
                    Else IF (Query_Process.FieldByName('Description').AsString = 'ON CALL DOCTOR') or
                      (Query_Process.FieldByName('Description').AsString = 'EMERGENCY CONSULTATION') Then
                    Begin
                         IF Query_Process.FieldByName('IsRateAmt').AsString = 'A' Then
                         Begin
                              CB_EmerNightOPD.Checked := True;
                              Edit_EmerNightOPD.Text := FieldByName('FractionAmount').AsString;
                         End
                         Else
                         Begin
                              CB_EmerNightOPD.Checked := False;
                              Edit_EmerNightOPD.Text := FieldByName('FractionRate').AsString;
                         End;
                    End
                    Else IF (Query_Process.FieldByName('Description').AsString = 'DIETICIAN CHARGE') or
                      (Query_Process.FieldByName('Description').AsString = 'EMERGENCY DUTY DOCTOR') Then
                    Begin
                         IF Query_Process.FieldByName('IsRateAmt').AsString = 'A' Then
                         Begin
                              CB_OPDProcedure.Checked := True;
                              Edit_OpdProc.Text := FieldByName('FractionAmount').AsString;
                         End
                         Else
                         Begin
                              CB_OPDProcedure.Checked := False;
                              Edit_OpdProc.Text := FieldByName('FractionRate').AsString;
                         End;
                    End
                    Else IF Query_Process.FieldByName('Description').AsString = 'PATHOLOGY' Then
                    Begin
                         IF Query_Process.FieldByName('IsRateAmt').AsString = 'A' Then
                         Begin
                              CB_Path.Checked := True;
                              Edit_Pathology.Text := FieldByName('FractionAmount').AsString;
                         End
                         Else
                         Begin
                              CB_Path.Checked := False;
                              Edit_Pathology.Text := FieldByName('FractionRate').AsString;
                         End;
                    End
                    Else IF Query_Process.FieldByName('Description').AsString = 'TDS' Then
                    Begin
                         IF Query_Process.FieldByName('IsRateAmt').AsString = 'A' Then
                         Begin
                              CB_TDS.Checked := True;
                              Edit_TDS.Text := FieldByName('FractionAmount').AsString;
                         End
                         Else
                         Begin
                              CB_TDS.Checked := False;
                              Edit_TDS.Text := FieldByName('FractionRate').AsString;
                         End;
                    End;
                    Query_Process.Next;
               End;
          End;
     End
     Else IF RB_Fraction.ItemIndex = 1 Then // Test Wise Commession Setup
     Begin
          GroupBoxTestWise.BringToFront;
          Query_Department.Close;
          Query_Department.Open;
          Query_TestName.Close;
          Query_TestName.Open;
          DBLCB_TestName.KeyValue := NULL;
          Edit_Rate.Text := '';
          Edit_Amount.Text := '';
          RB_Rate.Checked := True;
          b_IsNew := True;
          PC_FractionSetup.ActivePageIndex := 0;
          Edit_TestName.SetFocus;
          Query_TestWiseFraction.Close;
          Query_TestWiseFraction.Open;
     End;
End;

