               Label_FractionFor.Caption := Query_TestWiseFraction.FieldByName('FractionFor').AsString;
               ps_FractionFor := Query_TestWiseFraction.FieldByName('FractionFor').AsString;
               ShowModal;
          Finally
               Free;
          End;
     End;
end;

Function TForm_FractionSetup.CheckIsFixedFractionExist(Description: String): Boolean;
Var
     Qry: TOraQuery;
Begin
     Try
          Qry := TOraQuery.Create(nil);
          With Qry do
          Begin
               Close;
               Session:=DM_Hospital.DB;
               sql.Clear;
               sql.add(' Select * From HS_FRAC_FRACTION where FRAC_FRACTIONTYPE=1 and FRAC_DESCRIPTION=' + #39 + Description + #39);
               Open;
          End;

          IF Qry.FieldByName('FRAC_FRACTIONID').AsInteger > 0 Then
               Result := True
          Else
               Result := False;
     Finally
          Qry.Free;
     End;
End;

procedure TForm_FractionSetup.CB_EHSDocRoutineClick(Sender: TObject);
begin
     IF RB_Fraction.ItemIndex = 0 Then
          RB_FractionClick(Sender)
     Else
     Begin
          Query_TestWiseFraction.Close;
          Query_TestWiseFraction.Open;
     End;

end;

END.
