procedure TForm_FractionSetup.FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
     IF Key = VK_F1 Then
     Begin
          RB_Fraction.ItemIndex := 0;
          RB_FractionClick(Sender);
     End;

     IF Key = VK_F2 Then
     Begin
          RB_Fraction.ItemIndex := 1;
          RB_FractionClick(Sender);
     End;

     IF RB_Fraction.ItemIndex = 0 Then
     Begin
          IF Key = VK_F4 Then
               CB_OPDReg.Checked := Not(CB_OPDReg.Checked);
          IF Key = VK_F5 Then
               CB_EmrOPD.Checked := Not(CB_EmrOPD.Checked);
          IF Key = VK_F6 Then
               CB_EmerNightOPD.Checked := Not(CB_EmerNightOPD.Checked);
          IF Key = VK_F7 Then
               CB_OPDProcedure.Checked := Not(CB_OPDProcedure.Checked);
          IF Key = VK_F8 Then
               CB_Path.Checked := Not(CB_Path.Checked);
          IF Key = VK_F9 Then
               CB_TDS.Checked := Not(CB_TDS.Checked);
     End
     Else IF RB_Fraction.ItemIndex = 1 Then
     Begin
          IF PC_FractionSetup.ActivePageIndex = 1 Then
          Begin
               IF Key = VK_F4 Then
                    CB_FractionProportional.Checked := Not(CB_FractionProportional.Checked);
               IF Key = VK_F6 Then
                    RB_Rate.Checked := True;
               IF Key = VK_F7 Then
                    RB_Amt.Checked := True;
          End
          Else
          Begin
          End;

          IF Key = 27 Then
               BtnCancelClick(Sender);
     End;

     IF Key = VK_F12 Then
          BtnSaveClick(Sender);
end;

