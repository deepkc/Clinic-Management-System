  Db, DBTables, DBAccess, Ora, OraSmart, MemDS, OraError, ExtCtrls, StdCtrls, Grids, DBGrids, ComCtrls, Buttons,
  OleCtrls, DateEditXControl_TLB,ServerDate;

type
  TForm_Nurse = class(TForm)
    Panel1: TPanel;
    BtnNew: TBitBtn;
    BitBtnSave: TBitBtn;
    BitBtnCancel: TBitBtn;
    PageControl_Nurse: TPageControl;
    TabSheetList: TTabSheet;
    Label9: TLabel;
    DBGrid1: TDBGrid;
    EditSearch: TEdit;
    GroupBox2: TGroupBox;
    GroupBox1: TGroupBox;
    Button1: TButton;
    TabSheetEntry: TTabSheet;
    LabelMedicine: TLabel;
    Bevel1: TBevel;
    Bevel2: TBevel;
    Edit_Name: TEdit;
    Query_Nurse: TOraQuery;
    DS_Nurse: TDataSource;
    QueryProcess: TOraQuery;
    Label1: TLabel;
    Edit_Address: TEdit;
    Label2: TLabel;
    Edit_PhoneNo: TEdit;
    Label3: TLabel;
    Edit_MobileNo: TEdit;
    Label4: TLabel;
    DateEditX_HosJoinDate: TDateEditX;
    CB_InactiveNurse: TCheckBox;
    CB_Active: TCheckBox;
