procedure TForm_DoctorRoutine.DBGrid1DblClick(Sender: TObject);
begin
     if Query_DoctorRoutine.FieldByname('DOCTORROUTINEID').AsInteger <=0 then
     Begin
          MessageDlg('No Record to Modify !',mtWarning,[mbok],0);
          Exit;
     End;
     b_IsNew:=False;
     PageControlDocRoutine.ActivePageIndex:=1;
     pi_DoctorRountineId:=Query_DoctorRoutine.FieldByname('DOCTORROUTINEID').AsInteger;

     if Query_DoctorRoutine.FieldByname('DOCID').AsInteger > 0 then
     CB_ShowDeptWiseDoctor.Checked:=False;

     DBLCB_Dep.KeyValue:=Query_DoctorRoutine.FieldByname('DEPID').AsInteger;
     DBLCB_DepClick(Sender);
     DBLCB_Doctor.KeyValue:=Query_DoctorRoutine.FieldByname('DOCID').AsInteger;
     ComboBoxUnit.ItemIndex:=ComboBoxUnit.Items.IndexOf(Query_DoctorRoutine.FieldByname('UNIT').AsString);

     If Query_DoctorRoutine.FieldByName('ISROUTINEACTIVE').AsString='Y' then
          CB_IsRoutineActive.Checked:=True
     Else
          CB_IsRoutineActive.Checked:=False;

     If Query_DoctorRoutine.FieldByName('ISSHIFTSYSTEM').AsString='Y' then
          CB_ShiftSystem.Checked:=True
     Else
          CB_ShiftSystem.Checked:=False;

     If Query_DoctorRoutine.FieldByName('ISSUNDAYCHECKUP').AsString='Y' then
          CheckSun.Checked:=True
     Else
          CheckSun.Checked:=False;

     If Query_DoctorRoutine.FieldByName('ISMONDAYCHECKUP').AsString='Y' then
          CheckMon.Checked:=True
     Else
          CheckMon.Checked:=False;

     If Query_DoctorRoutine.FieldByName('ISTUESDAYCHECKUP').AsString='Y' then
          CheckTues.Checked:=True
     Else
          CheckTues.Checked:=False;

     If Query_DoctorRoutine.FieldByName('ISWEDNESDAYCHECKUP').AsString='Y' then
          CheckWed.Checked:=True
     Else
          CheckWed.Checked:=False;

     If Query_DoctorRoutine.FieldByName('ISTHURSDAYCHECKUP').AsString='Y' then
          CheckThus.Checked:=True
     Else
          CheckThus.Checked:=False;

     If Query_DoctorRoutine.FieldByName('ISFRIDAYCHECKUP').AsString='Y' then
          CheckFri.Checked:=True
     Else
          CheckFri.Checked:=False;

     If Query_DoctorRoutine.FieldByName('ISSATURDAYCHECKUP').AsString='Y' then
          CheckSat.Checked:=True
     Else
          CheckSat.Checked:=False;

     ShiftDisplay(CmbBoxSunday,Query_DoctorRoutine.FieldByName('SUNSHIFT').AsString);
     ShiftDisplay(CmbBoxMonday,Query_DoctorRoutine.FieldByName('MonShift').AsString);
     ShiftDisplay(CmbBoxTuesday,Query_DoctorRoutine.FieldByName('TueShift').AsString);
     ShiftDisplay(CmbBoxWednesday,Query_DoctorRoutine.FieldByName('WedShift').AsString);
     ShiftDisplay(CmbBoxThursday,Query_DoctorRoutine.FieldByName('ThuShift').AsString);
     ShiftDisplay(CmbBoxFriday,Query_DoctorRoutine.FieldByName('FriShift').AsString);
     ShiftDisplay(CmbBoxSaturday,Query_DoctorRoutine.FieldByName('SatShift').AsString);

     medt_Sunday.Text:=Query_DoctorRoutine.FieldByName('SUNDAYCHECKUPTIME').AsString;
     medt_Monday.Text:=Query_DoctorRoutine.FieldByName('Mondaycheckuptime').AsString;
     medt_Tuesday.Text:=Query_DoctorRoutine.FieldByName('Tuesdaycheckuptime').AsString;
     medt_Wednesday.Text:=Query_DoctorRoutine.FieldByName('Wednesdaycheckuptime').AsString;
     medt_thursday.Text:=Query_DoctorRoutine.FieldByName('thursdaycheckuptime').AsString;
     medt_Friday.Text:=Query_DoctorRoutine.FieldByName('Fridaycheckuptime').AsString;
     medt_saturday.Text:=Query_DoctorRoutine.FieldByName('saturdaycheckuptime').AsString;
     BB_NEW.Enabled:=False;
     BB_SAVE.Enabled:=True;
end;

