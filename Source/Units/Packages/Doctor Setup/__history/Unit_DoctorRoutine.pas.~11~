procedure TForm_DoctorRoutine.SpeedButton1Click(Sender: TObject);
begin
     IF Not Query_DoctorRoutine.Active Then Query_DoctorRoutine.Active:=True;
     IF Query_DoctorRoutine.RecordCount <=0 Then
     Begin
          MessageDlg('No Record To Delete.',mtInformation,[mbok],0);
          Exit;
     End;

     IF MessageDlg('Are You Sure To Delete This Doctor Routine ?',mtConfirmation,[mbYes,mbNo],0)=mrYes Then
     Begin
          With Query_Blank do
          Begin
               Close;
               sql.Clear;
               sql.Add(' Delete From DocRoutine where RID='+IntToStr(Query_DoctorRoutine.FieldByName('RID').AsInteger));
               ExecSQL;
          End;
          Query_DoctorRoutine.Close;
          Query_DoctorRoutine.Open;
     End;     
end;

