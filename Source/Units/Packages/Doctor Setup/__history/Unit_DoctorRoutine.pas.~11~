Procedure TForm_DoctorRoutine.ShiftDisplay(ComboBox:TCombobox; Shift :String);
Begin
     IF Trim(Shift)='' Then
     ComboBox.ItemIndex:=-1
     Else IF Shift='MORNING' Then
     ComboBox.ItemIndex:=0
     Else IF Shift='AFTERNOON' Then
     ComboBox.ItemIndex:=1
     Else IF Shift='EVENING' Then
     ComboBox.ItemIndex:=2
     Else IF Shift='NIGHT' Then
     ComboBox.ItemIndex:=3
     Else IF Shift='FULL DAY' Then
     ComboBox.ItemIndex:=4
     Else IF Shift='FULL NIGHT' Then
     ComboBox.ItemIndex:=5;
     //
End;



