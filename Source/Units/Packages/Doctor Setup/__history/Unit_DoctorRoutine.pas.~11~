Procedure TForm_DoctorRoutine.Search;
Var ls_sqlStr:String;
Begin
   ls_sqlStr:='';
   With Query_DoctorRoutine do
   begin
      close;
      sql.Clear;
      sql.add (' Select * From VW_HS_SETUP_DOCTORROUTINE');
      IF Trim(DBLCB_DepName.Text)<>'' then ls_sqlStr:=ls_sqlStr+'(DepID ='+IntToStr(DBLCB_DepName.KeyValue)+') AND  ';
      If Trim(DBLCB_DocName.Text)<>'' then ls_sqlStr:=ls_sqlStr+'(DocID ='+IntToStr(DBLCB_DocName.KeyValue)+') AND  ';
      If Trim(DBLookupComboBoxUnit.Text)<>'' then ls_sqlStr:=ls_sqlStr+'(Unit ='+chr(39)+DBLookupComboBoxUnit.KeyValue+chr(39)+') AND  ';
      IF Trim(ls_sqlStr)<>'' Then
      Begin
         ls_sqlStr:=' Where '+ls_sqlStr+' (0=0)';
         sql.add(ls_sqlStr);
      End;
      Open;
   End;
End;

