procedure TForm_DoctorRoutine.BB_SaveClick(Sender: TObject);
Var ls_RoomNo,ls_IsRoutineActive,ls_IsShiftSystem:String;
    li_DocID,li_DepID : Integer;
begin
     if Trim(DBLCB_Dep.Text)='' then
     Begin
          ShowMessage('Please Select Department');
          DBLCB_Dep.SetFocus;
          Exit;
     End;

     if Trim(DBLCB_Doctor.Text)='' then
     Begin
          ShowMessage('Please Select Doctor');
          DBLCB_Doctor.SetFocus;
          Exit;
     End;

     IF CB_ShiftSystem.Checked=True Then
     Begin
          IF CheckDaysShift=False Then Exit;
     End;

     li_DocID:=DBLCB_Doctor.KeyValue;
     li_DepID:=DBLCB_Dep.KeyValue;

     ls_RoomNo:='';
     if CB_IsRoutineActive.Checked=True then
     ls_IsRoutineActive:='Y'
     else
     ls_IsRoutineActive:='N';


     if CB_ShiftSystem.Checked=True then
     ls_IsShiftSystem:='Y'
     else
     ls_IsShiftSystem:='N';


     IF b_IsNew Then
     Begin
          With Query_Blank do
          Begin
               Close;
               Session := DM_Hospital.DB;
               sql.Clear;
               sql.add(' Select DORO_DOCTORROUTINEID DOCTORROUTINEID From HS_DORO_DOCTORROUTINE where DORO_DOCID='+IntToStr(li_DocId));
               sql.add(' and DORO_DEPID='+IntToStr(DBLCB_Dep.KeyValue));
               Open;
          End;

          IF Query_Blank.FieldByName('DOCTORROUTINEID').AsInteger  > 0 Then
          Begin
               MessageDlg('Doctor Routine of the Doctor " '+DBLCB_Doctor.Text+
                              ' " is already set in department " '+DBLCB_Dep.Text+' ".',mtWarning,[mbok],0);
               BB_CloseClick(Sender);
               DBLCB_DocName.keyValue:=Null;
               DBLCB_DepName.KeyValue:=Null;
               DBLookupComboBoxUnit.KeyValue:=Null;
               Search;
               Query_DoctorRoutine.Locate('DocID',li_DocID,[]);
               Exit;
          End;

          pi_DoctorRountineId:=GetMaxId('HS_DORO_DOCTORROUTINE','DORO_DOCTORROUTINEID');
          with Query_Blank do
          Begin
               Close;
               Session := DM_Hospital.DB;
               sql.Clear;
               sql.add(' Insert Into HS_DORO_DOCTORROUTINE(DORO_DOCTORROUTINEID,DORO_DEPID,DORO_DOCID,DORO_UNIT,DORO_ROOMNO,');
               sql.add(' DORO_ISROUTINEACTIVE,DORO_ISSHIFTSYSTEM,DORO_IsSundayCheckup,DORO_SUNSHIFT,DORO_IsMondayCheckup,DORO_MONSHIFT,');
               sql.add(' DORO_IsTuesdayCheckup,DORO_TUESHIFT,DORO_IsWednesdayCheckup,DORO_WEDSHIFT,DORO_IsThursdayCheckup,DORO_THUSHIFT,');
               sql.add(' DORO_IsFridayCheckup,DORO_FRISHIFT,DORO_IsSaturdayCheckup,DORO_SATSHIFT,DORO_DataPostBy,DORO_DataPostDate,');
               SQL.Add(' doro_Sundaycheckuptime,doro_Mondaycheckuptime,doro_Tuesdaycheckuptime,');
               SQL.Add(' doro_Wednesdaycheckuptime,doro_Thursdaycheckuptime,doro_Fridaycheckuptime,doro_Saturdaycheckuptime,');
               sql.add(' DORO_DataPostTime,DORO_MacId,DORO_ORGID) Values ('+IntToStr(pi_DoctorRountineId)+','+IntToStr(li_DepID)+','+IntToStr(li_DocID));
               sql.add(' ,'+#39+ComboBoxUnit.Text+#39+','+#39+ls_RoomNo+#39+','+#39+ls_IsRoutineActive+#39+','+#39+ls_IsShiftSystem+#39);
               If CheckSun.Checked then
               Begin
                   sql.add(',''Y'' ');
                   sql.add(','+#39+CmbBoxSunday.Text+#39);
               End
               Else
               Begin
                   sql.add(',''N'' ');
                   sql.add(' ,'''' ');
               End;

               If CheckMon.Checked then
               Begin
                   sql.add(',''Y'' ');
                   sql.add(','+#39+CmbBoxMonday.Text+#39);
               End
               Else
               Begin
                   sql.add(',''N'' ');
                   sql.add(' ,'''' ');
               End;

               If CheckTues.Checked then
               Begin
                   sql.add(',''Y'' ');
                   sql.add(','+#39+CmbBoxTuesday.Text+#39)
               End
               Else
               Begin
                   sql.add(',''N'' ');
                   sql.add(' ,'''' ');
               End;

               If CheckWed.Checked then
               Begin
                   sql.add(',''Y'' ');
                   sql.add(','+#39+CmbBoxWednesday.Text+#39)
               End
               Else
               begin
                   sql.add(',''N'' ');
                   sql.add(' ,'''' ');
               end;

               If CheckThus.Checked then
               Begin
                   sql.add(',''Y'' ');
                   sql.add(','+#39+CmbBoxThursday.Text+#39);
               End
               Else
               Begin
                   sql.add(',''N'' ');
                   sql.add(' ,'''' ');
               End;

               If CheckFri.Checked then
               Begin
                   sql.add(',''Y'' ');
                   sql.add(','+#39+CmbBoxFriday.Text+#39)
               End
               Else
               Begin
                   sql.add(',''N'' ');
                   sql.add(' ,'''' ');
               End;

               If CheckSat.Checked then
               Begin
                   sql.add(',''Y'' ');
                   sql.add(','+#39+CmbBoxSaturday.Text+#39)
               End
               Else
               Begin
                   sql.add(',''N'' ');
                   sql.add(' ,'''' ');
               End;
               SQL.Add(' ,'+IntToStr(gi_UserID)+ ',' + #39 +TodaysDate + #39);
               SQL.Add(',' +Quotedstr(medt_Sunday.Text));
               SQL.Add(','+ #39 + medt_Monday.Text + #39);
               SQL.Add(','+ #39 + medt_Tuesday.Text + #39);
               SQL.Add(','+ #39 + medt_Wednesday.Text + #39);
               SQL.Add(','+ #39 + medt_thursday .Text+ #39);
               SQL.Add(','+ #39 + medt_Friday.Text + #39);
               SQL.Add(','+ #39 + medt_saturday.Text + #39);
               SQL.Add (',' + #39 + TodaysTime + #39);
               SQL.Add(' ,'+#39 + gs_MACID +#39 + ',' + IntToStr(gi_compileValue));
               sql.add(')');
               ExecSQL;
          End;
     End
     Else
     Begin
          with Query_Blank do
          Begin
               Close;
               Session := DM_Hospital.DB;
               sql.Clear;
               sql.add(' Update HS_DORO_DOCTORROUTINE Set DORO_DEPID='+IntToStr(li_DepID)+',DORO_DOCID='+IntToStr(li_DocID));
               sql.add(' ,DORO_UNIT='+#39+ComboBoxUnit.Text+#39+',DORO_ROOMNO='+#39+ls_RoomNo+#39);
               sql.add(' ,DORO_ISROUTINEACTIVE='+#39+ls_IsRoutineActive+#39+',DORO_ISSHIFTSYSTEM='+#39+ls_IsShiftSystem+#39);
               If CheckSun.Checked then
               Begin
                   sql.add(',DORO_IsSundayCheckup=''Y'' ');
                   sql.add(',DORO_SUNSHIFT='+#39+CmbBoxSunday.Text+#39);
               End
               Else
               Begin
                   sql.add(',DORO_IsSundayCheckup=''N'' ');
                   sql.add(' ,DORO_SUNSHIFT='''' ');
               End;

               If CheckMon.Checked then
               Begin
                   sql.add(',DORO_IsMondayCheckup=''Y'' ');
                   sql.add(',DORO_MONSHIFT='+#39+CmbBoxMonday.Text+#39);
               End
               Else
               Begin
                   sql.add(',DORO_IsMondayCheckup=''N'' ');
                   sql.add(' ,DORO_MONSHIFT='''' ');
               End;

               If CheckTues.Checked then
               Begin
                   sql.add(',DORO_IsTuesdayCheckup=''Y'' ');
                   sql.add(',DORO_TUESHIFT='+#39+CmbBoxTuesday.Text+#39)
               End
               Else
               Begin
                   sql.add(',DORO_IsTuesdayCheckup=''N'' ');
                   sql.add(' ,DORO_TUESHIFT='''' ');
               End;

               If CheckWed.Checked then
               Begin
                   sql.add(',DORO_IsWednesdayCheckup=''Y'' ');
                   sql.add(',DORO_WEDSHIFT='+#39+CmbBoxWednesday.Text+#39)
               End
               Else
               begin
                   sql.add(',DORO_IsWednesdayCheckup=''N'' ');
                   sql.add(' ,DORO_WEDSHIFT='''' ');
               end;

               If CheckThus.Checked then
               Begin
                   sql.add(',DORO_IsThursdayCheckup=''Y'' ');
                   sql.add(',DORO_THUSHIFT='+#39+CmbBoxThursday.Text+#39);

               End
               Else
               Begin
                   sql.add(',DORO_IsThursdayCheckup=''N'' ');
                   sql.add(' ,DORO_THUSHIFT='''' ');
               End;

               If CheckFri.Checked then
               Begin
                   sql.add(',DORO_IsFridayCheckup=''Y'' ');
                   sql.add(',DORO_FRISHIFT='+#39+CmbBoxFriday.Text+#39)
               End
               Else
               Begin
                   sql.add(',DORO_IsFridayCheckup=''N'' ');
                   sql.add(',DORO_FRISHIFT='''' ');
               End;

               If CheckSat.Checked then
               Begin
                   sql.add(',DORO_IsSaturdayCheckup=''Y'' ');
                   sql.add(',DORO_SATSHIFT='+#39+CmbBoxSaturday.Text+#39)
               End
               Else
               Begin
                   sql.add(',DORO_IsSaturdayCheckup=''N'' ');
                   sql.add(' ,DORO_SATSHIFT='''' ');
               End;
               SQL.Add(' ,DORO_DataPostBy='+IntToStr(gi_UserID)+ ',DORO_DataPostDate=' + #39 + TodaysDate + #39);
               SQL.Add(',doro_Sundaycheckuptime=' + #39 +medt_Sunday.Text + #39);
               SQL.Add(',doro_Mondaycheckuptime=' + #39 +medt_Monday.Text + #39);
               SQL.Add(',doro_Tuesdaycheckuptime=' + #39 +medt_Tuesday.Text + #39);
               SQL.Add(',doro_Wednesdaycheckuptime=' + #39 +medt_Wednesday.Text + #39);
               SQL.Add(',doro_thursdaycheckuptime=' + #39 +medt_thursday.Text + #39);
               SQL.Add(',doro_Fridaycheckuptime=' + #39 +medt_Friday.Text + #39);
               SQL.Add(',doro_saturdaycheckuptime=' + #39 +medt_saturday.Text + #39);
               SQL.Add(' ,DORO_DataPostTime=' + #39 +TodaysTime + #39+' ,DORO_MacId='+#39 + gs_MACID +#39);
               sql.add(' where DORO_DOCTORROUTINEID='+IntToStr(pi_DoctorRountineId));
               //sql.saveToFile('C:\DoctorRoutine.Txt');
               ExecSQL;
          End;
     End;

     with Query_DoctorRoutine do
     Begin
          Close;
          Session := DM_Hospital.DB;
          Open;
     End;

     Query_DepName.Close;
     Session := DM_Hospital.DB;
     Query_DepName.Open;

     QueryUnit.Close;
     Session := DM_Hospital.DB;
     QueryUnit.Open;

     Query_DocName.Close;
     Session := DM_Hospital.DB;
     Query_DocName.Open;

     ShowDoneMessage;

     PageControlDocRoutine.ActivePageIndex:=0;
     BB_NEW.Enabled:=True;
     BB_SAVE.Enabled:=False;
end;

