package Reports;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  vclimg,
  dbrtl,
  vcldb,
  bdertl,
  QR5RunD2010,
  Global,
  dex;

contains
  UnitUserWiseCollection in 'UnitUserWiseCollection.pas' {FormUserWiseCollection},
  UnitRepUserWiseDetail in 'UnitRepUserWiseDetail.pas' {FormRepUserWiseDetail},
  UnitRepUserWiseCollection in 'UnitRepUserWiseCollection.pas' {FormRepUserWiseCollection};

end.
