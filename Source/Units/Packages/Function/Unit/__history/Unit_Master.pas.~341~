     Query: TOraQuery;

implementation

Function GetMaxId(TableName, FieldName: String): Integer;
Var
     OrQry_GetMaxId: TOraQuery;
Begin
     OrQry_GetMaxId := TOraQuery.Create(nil);
     With OrQry_GetMaxId do
     Begin
          Close;
          Session:=DM_Hospital.DB;
          sql.Clear;
          sql.Add(' Select NVL(Max(' + FieldName + '),0) as MaxVal From ' + TableName);
          Open;
          RESULT := FieldByName('MaxVal').AsInteger + 1;
     End;
     OrQry_GetMaxId.Close;
     OrQry_GetMaxId.Free;
End;

Procedure SaveCreditPaymentRefund(Masterid,PatientID,ReceivedBy,Schemeid:Integer; ReceivedAmount: Double;
          BillNo,CRBillNo,Previousbillno,ReceiptDate,ReceiptTime,IsPartialPayment:String;Receiptdiscount:Double);
var Query:TOraQuery;
begin
     Query := TOraQuery.Create(nil);
     With Query Do
     Begin
          Close;
          Session:=DM_hospital.DB;
          Sql.Clear;
          Sql.Add(' Insert Into HS_CRPD_CreditPaymentDetail(CRPD_CREDITPAYMENTDETAILID,CRPD_CREDITPAYMENTMASTERID,CRPD_PatientID,CRPD_RECEIPTNO,CRPD_CRBillNo,CRPD_Amount,');
          sql.add(' CRPD_DATAPOSTDATE,CRPD_DATAPOSTTIME,CRPD_DATAPOSTBY,CRPD_IsPartialPayment,CRPD_RECEIPTDISCOUNT,CRPD_paytype,CRPD_Isrefund,CRPD_prevReceiptno,CRPD_SCHEMEID) Values (');
          sql.Add(IntToStr(GetMaxId('HS_CRPD_CREDITPAYMENTDETAIL', 'CRPD_CreditPaymentDetailID')));
          sql.Add(','+IntToStr(Masterid));
          sql.Add(','+IntToStr(PatientID));
          sql.Add(','+Chr(39)+BillNo+Chr(39));
          sql.Add(','+Chr(39)+CRBillNo+Chr(39));
          sql.Add(','+FloatToStr(ReceivedAmount));
          sql.Add(','+#39+ReceiptDate+#39);
          sql.Add(','+#39+ReceiptTime+#39);
          sql.Add(','+IntToStr(ReceivedBy));
          Sql.Add(', '+#39+IsPartialPayment+#39);
          sql.add(','+floattostr(Receiptdiscount));
          sql.add(',''REFUND''');
          sql.add(',''Y''');
