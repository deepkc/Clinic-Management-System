Function GetNextBillNo(BILLTYPE, TableName: String): String; Stdcall;
Var
     Cur_F_Year, Tem_Str: String;
     S_FDate, E_FDate: Integer;
     DateEditx_Hidden: TDateEditX;
     Query_GetNextNo: TOraQuery;
begin
     DateEditx_Hidden := TDateEditX.Create(Nil);
     Query_GetNextNo := TOraQuery.Create(nil);
     DateEditx_Hidden.ADDateAsText := TodaysDate;
     DateEditx_Hidden.SystemOfDate := gi_DateSystem;
     Tem_Str := DateEditx_Hidden.VSDateAsText;
     IF StrToInt(Copy(Tem_Str, 6, 2)) >= 4 Then
     Begin
          S_FDate := StrToInt(Copy(Tem_Str, 3, 2));
          E_FDate := S_FDate + 1;
     End
     Else
     Begin
          E_FDate := StrToInt(Copy(Tem_Str, 3, 2));
          S_FDate := E_FDate - 1;
     End;

     // Try
     With Query_GetNextNo do
     Begin
          Close;
          Session:=Dm_Hospital.Db;
          sql.Clear;
          IF GB_isDepositBill = False Then
          Begin
               IF gi_compileValue in [1, 2] Then
               Begin
                    IF (BILLTYPE = 'CS') or (BILLTYPE = 'CR') Then
                    Begin
                         sql.Add(' Select Max(Num) nMax From (select nvl(substr(max(billno),9,15),0) as Num from ' + TableName + ' where ');
                         sql.Add(' BillNo Like ' + #39 + 'CS' + FormatFloat('00', S_FDate) + '%' + #39);
                         sql.Add(' Union ');
                         sql.Add(' select nvl(substr(max(billno),9,15),0) as Num from ' + TableName + ' where ');
                         sql.Add(' (BillNo Like ' + #39 + 'CR' + FormatFloat('00', S_FDate) + '%' + #39 + '))');
                    End
                    Else if (BILLTYPE = 'DP') or (BILLTYPE = 'DR') then
                    begin
                         sql.Add(' Select nvl(SubStr(Max(DepositNo),9,15),0) as nMax From ' + TableName);
                         sql.Add(' where  DepositNo Like ' + #39 + BILLTYPE + FormatFloat('00', S_FDate) + '%' + #39);
                    end
                    else
                    Begin
                         sql.Add(' Select nvl(SubStr(Max(Billno),9,15),0) as nMax From ' + TableName);
                         sql.Add(' where  BillNo Like ' + #39 + BILLTYPE + FormatFloat('00', S_FDate) + '%' + #39);
                    End;
               End
               Else
               Begin
                    sql.Add(' Select nvl(SubStr(Max(BillNo),9,15),0) as nMax From ' + TableName);
                    sql.Add(' where  BillNo Like ' + #39 + BILLTYPE + FormatFloat('00', S_FDate) + '%' + #39);
               End;
          End
          Else
          Begin
               sql.Add(' Select nvl(SubStr(Max(DepositNo),9,15),0) as nMax From ' + TableName);
               sql.Add(' where  DepositNo Like ' + #39 + BILLTYPE + FormatFloat('00', S_FDate) + '%' + #39);
          End;
          // sql.SaveToFile('MySql.txt');
          Open;
          RESULT := BILLTYPE + FormatFloat('00', S_FDate) + '/' + FormatFloat('00', E_FDate) + '-' + FormatFloat
            ('0000000', FieldByName('nMax').AsInteger + 1);
          Close;
     End;
