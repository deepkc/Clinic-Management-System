Function GetMaxPatientId_NepaliFiscalYearWise(): Integer;
Var
     Cur_F_Year, Tem_Str, Max: String;
     S_FDate, E_FDate: Integer;
     DateEditx_Hidden: TDateEditX;
     Query_GetNextNo: TOraQuery;
begin
     DateEditx_Hidden := TDateEditX.Create(Nil);
     Query_GetNextNo := TOraQuery.Create(nil);
     DateEditx_Hidden.SystemOfDate := gi_DateSystem;
     DateEditx_Hidden.Text := TodaysDate;

     Tem_Str := DateEditx_Hidden.VSDateAsText;
     IF StrToInt(Copy(Tem_Str, 6, 2)) >= 4 Then
     S_FDate := StrToInt(Copy(Tem_Str, 3, 2))
     Else
     Begin
          E_FDate := StrToInt(Copy(Tem_Str, 3, 2));
          S_FDate := E_FDate - 1;
     End;


     Query_GetNextNo := TOraQuery.Create(nil);
     With Query_GetNextNo do
     Begin
          Close;
          Session := DM_Hospital.DB;
          SQL.Clear;
          SQL.Add(' Select Nvl(MaxVal,0)MaxVal from (');
          SQL.Add(' Select to_number(Substr(Nvl(Max(PAMA_PatientID),0),3))MaxVal From  HS_PAMA_PatientMain');
          SQL.Add(' Where SubStr(PAMA_PatientID,1,2)='+IntToStr(S_FDate));
          Sql.Add(' And PAMA_PatientID<99999900 and PAMA_PatientID >70000000');
          SQL.Add(' )');
          Open;
          Max:= FormatFloat('00', S_FDate)+FormatFloat('000000',Query_GetNextNo.FieldByName('MaxVal').AsInteger+1);

          RESULT := StrToInt(MAX);
     End;
     Query_GetNextNo.Free;
end;


