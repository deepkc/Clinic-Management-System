Procedure SaveQueryCollection(PATIENTID, PATIENTTESTID: Integer); Stdcall;
Var
     Qry1, Qry2: TOraQuery;
     Str1, Str2: String;
begin
     LoadPatientData(gi_PatientID);
     Str1 := 'OrgId=' + gs_OrganizationID + '&SubOrgId=' + gs_SubOrganizationID;
     Qry1 := TOraQuery.Create(nil);
     Qry2 := TOraQuery.Create(nil);
     with Qry1 do
     begin
          Close;
          Session:=Dm_Hospital.Db;
          sql.Clear;
          sql.Add('Select * from PatientMain Where PatientID=' + IntToStr(PATIENTID));
          Open;
          Str1 := Str1 + 'CLIENTQUERYID' + '&Query=' + MakeBlankStringNull(gs_OrganizationID) + '@~*~@' + MakeBlankStringNull(gs_SubOrganizationID)
            + '@~*~@' + MakeBlankStringNull(FieldByName('PatientID').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('RegDate').AsString)
            + '@~*~@' + MakeBlankStringNull(FieldByName('Age').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('PatientName').AsString)
            + '@~*~@' + MakeBlankStringNull(FieldByName('AgeType').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('Gender').AsString)
            + '@~*~@' + MakeBlankStringNull(FieldByName('PatientName').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('MobileNo').AsString)
            + '@~!~@';
          sql.Clear;
          sql.Add('SELECT ROWNUM AS DISPLAYORDER,PTD.*,TN.TESTNAME,T.TEST,T.ISHEADING,SS.SAMPLESOURCE,SC.SAMPLETAKENDATE');
          sql.Add(',CAST(F.FOOTERTEXT AS VARCHAR2(500))FOOTER,SC.SAMPLENO,SC.SAMPLETAKENBY,SUBSTR(REFRANGE,1,INSTR(REFRANGE,''-'')-1)FROMRANGE');
          sql.Add(',REPLACE(SUBSTR(REFRANGE,INSTR(REFRANGE,''-'')+1),''@'','''')TORANGE');
          sql.Add(',REPLACE(REFRANGE,''@'','''')REFRANGEMAIN');
          sql.Add('FROM PATIENTTEST PT,PATIENTTESTDETAIL PTD,TESTNAME TN,TEST T,SAMPLESOURCE SS,SAMPLECOLLECTION SC,FOOTER F,DEPARTMENT D');
          sql.Add('WHERE PTD.TESTNAMEID=TN.TESTNAMEID');
          sql.Add('AND D.DEPID=TN.DEPID');
          sql.Add('AND PTD.TESTID=T.TESTID');
          sql.Add('AND PT.PATIENTTESTID=PTD.PATIENTTESTID');
          sql.Add('AND TN.TESTNAMEID=F.TESTNAMEID(+)');
          sql.Add('AND PTD.PATIENTTESTID=SC.PATIENTTESTID');
          sql.Add('AND TN.SAMPLESOURCEID=SS.SAMPLESOURCEID(+)');
          sql.Add('AND PTD.PATIENTTESTID=' + IntToStr(PATIENTTESTID));
          sql.Add('ORDER BY D.DEPORDER,TN.DISPLAYORDER,T.DISPLAYORDER');
          Open;
          while Not eof do
          begin
               Str2 := '';
               Str2 := Str1 + '@~*~@' + MakeBlankStringNull(gs_OrganizationID) + '@~*~@' + MakeBlankStringNull(gs_SubOrganizationID)
                 + '@~*~@' + MakeBlankStringNull(FieldByName('PatientID').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('PtDetailID').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('TestID').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('Test').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('TestNameID').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('TestName').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('ISHEADING').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('FINDING').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('UNIT').AsString);

               Str2 := Str2 + '@~*~@NULL' + '@~*~@' + MakeBlankStringNull(FieldByName('FROMRANGE').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('TORANGE').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('REFRANGEMAIN').AsString)
                 + '@~*~@' + MakeBlankStringNull(FieldByName('SAMPLENO').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('SAMPLESOURCE').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('SAMPLETAKENDATE').AsString)
                 + '@~*~@' + MakeBlankStringNull(FieldByName('SAMPLETAKENBY').AsString) + '@~*~@NULL@~*~@NULL@~*~@NULL';

               Str2 := Str2 + '&PostedDateTime=' + FormatDateTime('YYYY-MM-DD', Date) + ' ' + TodaysTime + '&DataType=PATH';
               with Qry2 do
               begin
                    Close;
                    Session:=Dm_Hospital.Db;
                    sql.Clear;
                    sql.Add('Insert into QueryCollection (ID,Org_ID,Sub_Org_Id,Query_Data,Status,DateTime,DataType');
                    sql.Add(',PatientID,PatientName,SampleNo)');
                    sql.Add(' Values (');
                    sql.Add('(Select NVL(Max(Id),0)+1 From QueryCollection)');
                    sql.Add(',' + gs_OrganizationID + ',' + gs_SubOrganizationID);
                    sql.Add(',' + #39 + Str2 + #39 + ',' + #39 + '0' + #39 + ',' + #39 + TodaysDate + ' ' + TodaysTime + #39);
                    sql.Add(',''PATH'' ');
                    sql.Add(',' + IntToStr(gi_PatientID) + ',' + #39 + Gs_PatientName + #39 + ',' + #39 + gs_SampleNo + #39);
                    sql.Add(')');
                    ExecSQL;
               end;
               Next;
          end;
     end;
     Qry1.Free;
     Qry2.Free;
end;

