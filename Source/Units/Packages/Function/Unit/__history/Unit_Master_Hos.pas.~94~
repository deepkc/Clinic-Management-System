Function GetNextCreditPaymentRecieptNo(Const RealTableName,KeyFieldName,BillType:String):String;
Var
   Cur_F_Year,Tem_Str:String;
   S_FDate,E_FDate:Integer;
   DateEditx_Hidden:TDateEditX;
   Qry_Save : TOraQuery;
begin
   DateEditx_Hidden:=TDateEditX.Create(Nil);
   DateEditx_Hidden.SystemOfDate:=gi_DateSystem;
   DateEditx_Hidden.text:=TodaysDate;

   Tem_Str:=DateEditx_Hidden.VSDateAsText;
   IF StrToInt(Copy(Tem_Str,6,2))>=4 Then
   Begin
        S_FDate:=StrToInt(Copy(Tem_Str,3,2));
        E_FDate:=S_FDate+1;
   End
   Else
   Begin
        E_FDate:=StrToInt(Copy(Tem_Str,3,2));
        S_FDate:=E_FDate-1;
   End;

   Try
   Qry_Save := TOraQuery.Create(Nil);
     With Qry_Save do
     Begin
         close;
         Session:=DM_Hospital.DB;
         sql.Clear;
         sql.add(' Select NVL(SubStr(Max('+KeyFieldName+'),9,15),0) as nMax From '+RealTableName);
         sql.add(' where  RECEIPTNO Like '+#39+BillType+FormatFloat('00',S_FDate)+'%'+#39);
         Open;
         Result:=BillType+FormatFloat('00',S_FDate)+'/'+FormatFloat('00',E_FDate)+'-'+FormatFloat('0000000',Qry_Save.FieldByName('nMax').AsInteger+1);
      End;

   Except
      Result:=BillType+FormatFloat('00',S_FDate)+'/'+FormatFloat('00',E_FDate)+'-'+FormatFloat('0000000',1);
      Qry_Save.Free;
   End;
   Qry_Save.Free;
   DateEditx_Hidden.Free;
End;

