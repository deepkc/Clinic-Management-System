Function GetNextBillNo(BILLTYPE, TableName,FieldName : String): String; Stdcall;
Var
     Cur_F_Year, Tem_Str: String;
     S_FDate, E_FDate: Integer;
     DateEditx_Hidden: TDateEditX;
     Query_GetNextNo: TOraQuery;
begin
     DateEditx_Hidden := TDateEditX.Create(Nil);
     Query_GetNextNo := TOraQuery.Create(nil);

     DateEditx_Hidden.SystemOfDate := gi_DateSystem;
     DateEditx_Hidden.Text := TodaysDate;
     Tem_Str := DateEditx_Hidden.VSDateAsText;

     IF StrToInt(Copy(Tem_Str, 6, 2)) >= 4 Then
     Begin
          S_FDate := StrToInt(Copy(Tem_Str, 3, 2));
          E_FDate := S_FDate + 1;
     End
     Else
     Begin
          E_FDate := StrToInt(Copy(Tem_Str, 3, 2));
          S_FDate := E_FDate - 1;
     End;

     // Try
     With Query_GetNextNo do
     Begin
          Close;
          Session := DM_Hospital.DB;
          SQL.Clear;
          IF GB_isDepositBill = False Then
          Begin
               IF gi_compileValue in [1, 2] Then
               Begin
                    IF (BILLTYPE = 'CS') or (BILLTYPE = 'CR')  or (BILLTYPE = 'ME') Then
                    Begin
                         SQL.Add(' Select Max(Num) nMax From (select nvl(substr(max('+FieldName+'),9,15),0) as Num from ' + TableName +
                                ' where ');
                         SQL.Add(FieldName+' Like ' + #39 + 'CS' + FormatFloat('00', S_FDate) + '%' + #39);
                         SQL.Add(' Union ');
                         SQL.Add(' select nvl(substr(max('+FieldName+'),9,15),0) as Num from ' + TableName + ' where ');
                         SQL.Add(' ('+FieldName+' Like ' + #39 + 'CR' + FormatFloat('00', S_FDate) + '%' + #39 + ')');
                         SQL.Add(' Union ');
                         SQL.Add(' select nvl(substr(max('+FieldName+'),9,15),0) as Num from ' + TableName + ' where ');
                         SQL.Add(' ('+FieldName+' Like ' + #39 + 'ME' + FormatFloat('00', S_FDate) + '%' + #39 + '))');
                    End
                    else if (BILLTYPE = 'LCS') or (BILLTYPE = 'LCR') then
                    begin
                         SQL.Add(' Select Max(Num) nMax From (select nvl(substr(max('+FieldName+'),10,15),0) as Num from ' + TableName + ' where ');
                         SQL.Add(FieldName+' Like ' + #39 + 'LCS' + FormatFloat('00', S_FDate) + '%' + #39);
                         SQL.Add(' Union ');
                         SQL.Add(' select nvl(substr(max('+FieldName+'),10,15),0) as Num from ' + TableName + ' where ');
                         SQL.Add(' ('+FieldName+' Like ' + #39 + 'LCR' + FormatFloat('00', S_FDate) + '%' + #39 + '))');
                    end
                    else if (BILLTYPE = 'XCS') or (BILLTYPE = 'XCR') then
                    begin
                         SQL.Add(' Select Max(Num) nMax From (select nvl(substr(max('+FieldName+'),10,15),0) as Num from ' + TableName + ' where ');
                         SQL.Add(FieldName+' Like ' + #39 + 'XCS' + FormatFloat('00', S_FDate) + '%' + #39);
                         SQL.Add(' Union ');
                         SQL.Add(' select nvl(substr(max('+FieldName+'),10,15),0) as Num from ' + TableName + ' where ');
                         SQL.Add(' ('+FieldName+' Like ' + #39 + 'XCR' + FormatFloat('00', S_FDate) + '%' + #39 + '))');
                    end
                    else if (BILLTYPE = 'CCS') or (BILLTYPE = 'CCR') then
                    begin
                         SQL.Add(' Select Max(Num) nMax From (select nvl(substr(max('+FieldName+'),10,15),0) as Num from ' + TableName + ' where ');
                         SQL.Add(FieldName+' Like ' + #39 + 'CCS' + FormatFloat('00', S_FDate) + '%' + #39);
                         SQL.Add(' Union ');
                         SQL.Add(' select nvl(substr(max('+FieldName+'),10,15),0) as Num from ' + TableName + ' where ');
                         SQL.Add(' ('+FieldName+' Like ' + #39 + 'CCR' + FormatFloat('00', S_FDate) + '%' + #39 + '))');
                    end
                    Else if (BILLTYPE = 'DP') or (BILLTYPE = 'DR') then
                    begin
                         SQL.Add(' Select nvl(SubStr(Max('+FieldName+'),9,15),0) as nMax From ' + TableName);
                         SQL.Add(' where '+FieldName+'  Like ' + #39 + BILLTYPE + FormatFloat('00', S_FDate) + '%' + #39);
