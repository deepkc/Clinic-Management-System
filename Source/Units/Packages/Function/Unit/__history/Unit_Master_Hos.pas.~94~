procedure CancelServiceTest(SERVICEBILLDETAILID, Qty: Integer;RefundDiscount:Double; CancelReason : String); stdcall;
Var
     Qry: TOraQuery;
     Qry2: TOraQuery;
     Li_TestCancelID: Integer;
     li_PatientTestID, li_BillDetailID, li_PatientId, li_refpatienttestid, li_InpatientId, li_printcount, li_depid,
       Li_TestNameID, li_testprogressstatus, li_syncstatus, li_controlstatus: Integer;
     ls_Billno, ls_Doccode, ls_paystatus, ls_testdate, ls_testtime, ls_remarks,ls_ISVATABLETEST, ls_service,ls_servicetype: string;
     lf_testamount,lf_qty,lf_disper,lf_VATAMT,lf_discount,TOTALAMOUNT: Double;
Begin
     Qry2 := TOraQuery.Create(nil);
     Qry := TOraQuery.Create(nil);
     Li_TestCancelID := GetMaxId('HS_TECA_TestCancel', 'TECA_TestCancelID');
     with Qry2 do
     begin
          Close;
          Session :=DM_Hospital.DB;
          SQL.Clear;
          SQL.Add(' Select SEBD_BillDetailId BillDetailId,SEBD_PatientId PatientId,SEBD_InpatientId InpatientId,');
          SQL.Add(' SEBD_DepId as DepId,(Select TENA_TestNameId From HS_TENA_TestName where TENA_TestNameCode=SEBD_Service) as TestNameId,');
          SQL.Add(' SEBD_BillNo BillNo,sebd_discount discount,sebd_servicetype servicetype,sebd_service service,sebd_qty qty,sebd_disper disper,sebd_vatamt vatamt,sebd_ISVATABLETEST as ISVATABLETEST,SEBD_DocCode as DocCode,SEBD_BillDate as BillDate,');
          SQL.Add(' SEBD_BillTime as BillTime,SEBD_Amount as Amount,NVL((Select Max(PatientTestID) From PatientTest where ServiceBillDetailId=SEBD_ServiceBillDetailId),0) as PatientTestId,');
          SQL.Add(' NVL((Select Max(RefPatientTestID) From PatientTest where ServiceBillDetailId=SEBD_ServiceBillDetailId),0) as RefPatientTestId,');
          SQL.Add(' NVL((Select TestProgressStatus From PatientTest where ServiceBillDetailId=SEBD_ServiceBillDetailId and RowNum=1),0) as TestProgressStatus');
          SQL.Add(' From HS_SEBD_ServiceBillDetail SEBD');
          SQL.Add(' where SEBD_ServiceBillDetailID=' + inttostr(SERVICEBILLDETAILID));
          Open;

          li_BillDetailID := FieldByName('BillDetailId').AsInteger;
          li_PatientId := FieldByName('PatientId').asinteger;


          lf_qty:=FieldByName('Qty').AsFloat;
          lf_disper:=FieldByName('disper').AsFloat;
          lf_VATAMT:=FieldByName('vatamt').AsFloat;
          ls_ISVATABLETEST:= FieldByName('ISVATABLETEST').asString;
          ls_service:=  FieldByName('service').asString;
          ls_servicetype:=FieldByName('servicetype').asString;
          lf_discount:=FieldByName('discount').asFLoat;



          li_refpatienttestid := FieldByName('RefPatientTestId').AsInteger;
          li_InpatientId := FieldByName('InpatientId').AsInteger;
          li_printcount := 0;//FieldByName('PrintCount').AsInteger;
          li_depid := FieldByName('DepId').AsInteger;
          Li_TestNameID := FieldByName('TestNameId').AsInteger;
          li_PatientTestID := FieldByName('PatientTestID').AsInteger;
          ls_Billno := FieldByName('BillNo').AsString;
          ls_Doccode := FieldByName('DocCode').AsString;
          ls_paystatus := '';//FieldByName('PayStatus').AsString;
          //ls_testdate := FieldByName('TestDate').AsString;
          //ls_testtime := FieldByName('TestTime').AsString;

          ls_testdate := FieldByName('BillDate').AsString;
          ls_testtime := FieldByName('BillTime').AsString;

          //ls_remarks := FieldByName('Remarks').AsString;
          li_testprogressstatus := FieldByName('TestProgressStatus').AsInteger;
          li_syncstatus := 0;//FieldByName('SyncStatus').AsInteger;
          li_controlstatus := 0;//FieldByName('ControlStatus').AsInteger;
          lf_testamount := FieldByName('Amount').AsFloat;

          TOTALAMOUNT := (lf_testamount*lf_Qty)+lf_VATAMT-RefundDiscount;
     end;

     With Qry do
     Begin
          Close;
          Session :=DM_Hospital.DB;
          SQL.Clear;
          SQL.Add(' Insert Into HS_TECA_TestCancel(TECA_TestCancelId,TECA_PATIENTTESTID,TECA_BillDetailId,TECA_ServiceBillDetailid,');
          SQL.Add(' TECA_PATIENTID,TECA_INPATIENTID,TECA_DEPID,TECA_TESTNAMEID');
          SQL.Add(' ,TECA_BILLNO,TECA_DOCCODE,TECA_PAYSTATUS,TECA_TESTDATE,TECA_TESTTIME,TECA_TESTAMOUNT,TECA_REFPATIENTTESTID,TECA_PRINTCOUNT,TECA_REMARKS');
          SQL.Add(' ,TECA_DATAPOSTDate,TECA_DataPostTime,TECA_DataPostBy,TECA_TestProgressStatus,TECA_SyncStatus,TECA_ControlStatus,teca_QTY,TECA_DISPER,TECA_VATAMT,TECA_ISVATABLETEST,teca_SERVICE,teca_servicetype,teca_discount,teca_Totalamount ) Values (');
          SQL.Add(inttostr(Li_TestCancelID) + ',' + inttostr(li_PatientTestID) + ' ,' + inttostr(li_BillDetailID)
                 + ' ,' + inttostr(SERVICEBILLDETAILID) + ' ,' + inttostr(li_PatientId) + ',');
          SQL.Add(inttostr(li_InpatientId) + ',' + inttostr(li_depid) + ',');
          SQL.Add(inttostr(Li_TestNameID) + ',' + #39 + ls_Billno + #39 + ',' + #39 + ls_Doccode + #39 + ',');
          SQL.Add(#39 + ls_paystatus + #39 + ',' + #39 + ls_testdate + #39 + ',' + #39 + ls_testtime + #39 + ',');
          SQL.Add(FloatToStr(lf_testamount) + ',' + inttostr(li_refpatienttestid) + ',');
          SQL.Add(inttostr(li_printcount) + ',' + #39 +CancelReason + #39 + ',');
          SQL.Add(#39 + TodaysDate + #39 + ',' + #39 + TodaysTime + #39 + ',' + inttostr(gi_UserID) + ',' + inttostr
                 (li_testprogressstatus));
          SQL.Add(',' + inttostr(li_syncstatus) + ',' + inttostr(li_controlstatus)+','+FloatToStr(lf_qty)+','+FloatToStr(lf_disper)+','+FloatToStr(lf_vatamt)+','+QuotedStr(ls_ISVATABLETEST));
          SQL.Add(','+QuotedStr(ls_service)+','+QuotedStr(ls_servicetype)+','+FloatToStr(lf_discount)+','+FLOATTOSTR(TOTALAMOUNT)+')');
          ExecSQL;
     End;

     if gs_ISFractionSharingActive='Y' then
     begin
          With Qry do
          Begin
               Close;
               Session :=DM_Hospital.DB;
               SQL.Clear;
               SQL.Add(' Delete From HS_FRDE_FractionDetail where FRDE_ServiceBillDetailId='+IntToStr(SERVICEBILLDETAILID));
               SQL.Add(' and FRDE_BillDetailID=0 and FRDE_PatientID='+IntToStr(li_PatientId)+' and FRDE_InpatientId='+IntToStr(li_InpatientId));
               SQL.Add(' and FRDE_TestNameCode<>''IPCON''');
               ExecSQL;
          end;
     end;
     Qry.Free;
     Qry2.Free;
end;

