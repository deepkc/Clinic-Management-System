procedure AutoLoadNursingCharge(PatientId,InpatientId : Integer);
Var Qry,Query_Process :TOraQuery;
Begin
     Qry := TOraQuery.Create(Nil);
     Query_Process := TOraQuery.Create(Nil);
     With Qry do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select PatientId,InpatientId,PatientType,RoomTypeCode,InptDate,BedCharge,VatAmt,DisPer,Case when TotalDays=0 Then 1 Else TotalDays End TotalDays,');
          sql.add(' NursingCareCharge,NursingCareSvrTax,NursingCareChargePVT,NursingCareSvrTaxPVT,');
          sql.add(' NursingCareChargeFRG,NursingCareSvrTaxFRG,NursingCareChargeFRP,NursingCareSvrTaxFRP,');
          sql.add(' (Select ServiceBillDetailId From ServiceBillDetail where PatientId=R.PatientId and EmrDutyDoc=R.RoomTypeCode');
          sql.add(' and InpatientId=R.InpatientId and BillDate=R.InptDate) as ServiceBillDetialId');
          sql.add(' From (');
          sql.add(' Select IPR.PatientType,IPD.PatientId,IPD.InpatientId,IPD.WardCode,IPD.RoomTypeCode,IPD.BedNo,IPD.InptDate,IPD.OutDate,IPD.BedCharge,IPD.VatAmt,IPD.DisPer,');
          sql.add(' IPR.DISINDEPOSIT,IPR.DISINDEPOSITDATE,RT.NursingCareCharge,RT.NursingCareSvrTax,RT.NursingCareChargePVT,RT.NursingCareSvrTaxPVT,');
          sql.add(' RT.NursingCareChargeFRG,RT.NursingCareSvrTaxFRG,RT.NursingCareChargeFRP,RT.NursingCareSvrTaxFRP,');
          sql.add(' Case when IPR.DISINDEPOSIT=''Y'' and IPD.OutDate=''C'' Then');
          sql.add(' TO_Date(IPR.DisInDepositDate, ''YYYY/MM/DD'') - TO_DATE (IPD.InptDate, ''YYYY/MM/DD'')');
          sql.add(' when IPR.DISINDEPOSIT=''N'' and IPD.OutDate=''C'' Then');
          sql.add(' TO_Date(TO_CHAR (SYSDATE, ''YYYY/MM/DD''), ''YYYY/MM/DD'') - TO_DATE (IPD.InptDate, ''YYYY/MM/DD'') Else');
          sql.add(' TO_Date(IPD.OutDate,''YYYY/MM/DD'') - TO_DATE (IPD.InptDate, ''YYYY/MM/DD'') End as TotalDays');
          sql.add(' From InpatientDetail IPD,InpatientReg IPR,RoomType RT');
          sql.add(' where IPR.InpatientId=IPD.InpatientId and IPD.RoomTypeCode=RT.RoomTypeCode and IPR.Discharged=''N''');
          sql.add(' and IPR.PatientId='+IntToStr(PatientId));
          sql.add(' ) R Order by InpatientId,InptDate');
          Open;
     End;
     Qry.Free;
     Query_Process.Free;
End;

