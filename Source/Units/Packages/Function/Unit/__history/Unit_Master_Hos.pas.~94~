Procedure SaveQueryCollection(PATIENTID, PATIENTTESTID: Integer); Stdcall;
Var
     Qry1, Qry2: TOraQuery;
     Str1, Str2: String;
begin
     LoadPatientData(gi_PatientID);
     Str1 := 'OrgId=' + gs_OrganizationID + '&SubOrgId=' + gs_SubOrganizationID;
     Qry1 := TOraQuery.Create(nil);
     Qry2 := TOraQuery.Create(nil);
     with Qry1 do
     begin
          Close;
          Session := DM_Hospital.DB;
          SQL.Clear;
          SQL.Add('Select * from PatientMain Where PatientID=' + inttostr(PATIENTID));
          Open;
          Str1 := Str1 + 'CLIENTQUERYID' + '&Query=' + MakeBlankStringNull(gs_OrganizationID) + '@~*~@' + MakeBlankStringNull
            (gs_SubOrganizationID) + '@~*~@' + MakeBlankStringNull(FieldByName('PatientID').AsString)
            + '@~*~@' + MakeBlankStringNull(FieldByName('RegDate').AsString) + '@~*~@' + MakeBlankStringNull
            (FieldByName('Age').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('PatientName').AsString)
            + '@~*~@' + MakeBlankStringNull(FieldByName('AgeType').AsString) + '@~*~@' + MakeBlankStringNull
            (FieldByName('Gender').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('PatientName').AsString)
            + '@~*~@' + MakeBlankStringNull(FieldByName('MobileNo').AsString) + '@~!~@';
          SQL.Clear;
          SQL.Add('SELECT ROWNUM AS DISPLAYORDER,PTD.*,TN.TESTNAME,T.TEST,T.ISHEADING,SS.SAMPLESOURCE,SC.SAMPLETAKENDATE');
          SQL.Add(
               ',CAST(F.FOOTERTEXT AS VARCHAR2(500))FOOTER,SC.SAMPLENO,SC.SAMPLETAKENBY,SUBSTR(REFRANGE,1,INSTR(REFRANGE,''-'')-1)FROMRANGE');
          SQL.Add(',REPLACE(SUBSTR(REFRANGE,INSTR(REFRANGE,''-'')+1),''@'','''')TORANGE');
          SQL.Add(',REPLACE(REFRANGE,''@'','''')REFRANGEMAIN');
          SQL.Add(
               'FROM PATIENTTEST PT,PATIENTTESTDETAIL PTD,TESTNAME TN,TEST T,SAMPLESOURCE SS,SAMPLECOLLECTION SC,FOOTER F,DEPARTMENT D');
          SQL.Add('WHERE PTD.TESTNAMEID=TN.TESTNAMEID');
          SQL.Add('AND D.DEPID=TN.DEPID');
          SQL.Add('AND PTD.TESTID=T.TESTID');
          SQL.Add('AND PT.PATIENTTESTID=PTD.PATIENTTESTID');
          SQL.Add('AND TN.TESTNAMEID=F.TESTNAMEID(+)');
          SQL.Add('AND PTD.PATIENTTESTID=SC.PATIENTTESTID');
          SQL.Add('AND TN.SAMPLESOURCEID=SS.SAMPLESOURCEID(+)');
          SQL.Add('AND PTD.PATIENTTESTID=' + inttostr(PATIENTTESTID));
          SQL.Add('ORDER BY D.DEPORDER,TN.DISPLAYORDER,T.DISPLAYORDER');
          Open;
          while Not eof do
          begin
               Str2 := '';
               Str2 := Str1 + '@~*~@' + MakeBlankStringNull(gs_OrganizationID) + '@~*~@' + MakeBlankStringNull
                 (gs_SubOrganizationID) + '@~*~@' + MakeBlankStringNull(FieldByName('PatientID').AsString)
                 + '@~*~@' + MakeBlankStringNull(FieldByName('PtDetailID').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('TestID').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('Test').AsString)
                 + '@~*~@' + MakeBlankStringNull(FieldByName('TestNameID').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('TestName').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('ISHEADING').AsString)
                 + '@~*~@' + MakeBlankStringNull(FieldByName('FINDING').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('UNIT').AsString);

               Str2 := Str2 + '@~*~@NULL' + '@~*~@' + MakeBlankStringNull(FieldByName('FROMRANGE').AsString)
                 + '@~*~@' + MakeBlankStringNull(FieldByName('TORANGE').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('REFRANGEMAIN').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('SAMPLENO').AsString)
                 + '@~*~@' + MakeBlankStringNull(FieldByName('SAMPLESOURCE').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('SAMPLETAKENDATE').AsString) + '@~*~@' + MakeBlankStringNull(FieldByName('SAMPLETAKENBY').AsString)
                 + '@~*~@NULL@~*~@NULL@~*~@NULL';

               Str2 := Str2 + '&PostedDateTime=' + FormatDateTime('YYYY-MM-DD', Date) + ' ' + TodaysTime + '&DataType=PATH';
               with Qry2 do
               begin
                    Close;
                    Session := DM_Hospital.DB;
                    SQL.Clear;
                    SQL.Add('Insert into QueryCollection (ID,Org_ID,Sub_Org_Id,Query_Data,Status,DateTime,DataType');
                    SQL.Add(',PatientID,PatientName,SampleNo)');
                    SQL.Add(' Values (');
                    SQL.Add('(Select NVL(Max(Id),0)+1 From QueryCollection)');
                    SQL.Add(',' + gs_OrganizationID + ',' + gs_SubOrganizationID);
                    SQL.Add(',' + #39 + Str2 + #39 + ',' + #39 + '0' + #39 + ',' + #39 + TodaysDate + ' ' + TodaysTime + #39);
                    SQL.Add(',''PATH'' ');
                    SQL.Add(',' + inttostr(gi_PatientID) + ',' + #39 + Gs_PatientName + #39 + ',' + #39 + gs_SampleNo + #39);
                    SQL.Add(')');
                    ExecSQL;
               end;
               Next;
          end;
     end;
     Qry1.Free;
     Qry2.Free;
end;

Function SendSmsQueryCollection(MSG, SAMPLENO: String; PATIENTID: Integer): Boolean; Stdcall;
Var
     Qry: TOraQuery;
     Str, MOBILENO: String;
     S1, S2: Integer;
begin
     RESULT := False;
     LoadPatientData(PATIENTID);
     Qry := TOraQuery.Create(Nil);
     with Qry do
     begin
          Close;
          Session := DM_Hospital.DB;
          // sql.Clear;
          // sql.Add('SELECT MESSAGE FROM SMSMESSAGE');
          // Open;
          // Msg := FieldByName('Message').AsString;
          SQL.Clear;
          SQL.Add('Select Status From QueryCollection ');
          SQL.Add('Where PatientId=' + inttostr(gi_PatientID));
          SQL.Add('And SampleNo=' + #39 + SAMPLENO + #39);
          SQL.Add('Order by Status Desc');
          Open;
          S1 := FieldByName('Status').AsInteger;

          SQL.Clear;
          SQL.Add('Select Status From Image_Status ');
          SQL.Add('Where PatientId=' + inttostr(gi_PatientID));
          SQL.Add('And SampleNo=' + #39 + SAMPLENO + #39);
          SQL.Add('Order by Status Desc');
          Open;
          S2 := FieldByName('Status').AsInteger;

          if (S1 = 2) or (S2 = 2) then
          begin
               SQL.Clear;
               SQL.Add('Select * from PatientMain Where PatientId=' + inttostr(PATIENTID));
               Open;
               MOBILENO := FieldByName('MobileNo').AsString;
               Str := 'OrgId=' + gs_OrganizationID + '&SubOrgId=' + gs_SubOrganizationID;
               Str := Str + 'CLIENTQUERYID' + '&Query=' + MakeBlankStringNull(gs_OrganizationID) + '@~*~@' + MakeBlankStringNull
                 (gs_SubOrganizationID) + '@~*~@' + MakeBlankStringNull(FieldByName('PatientID').AsString)
                 + '@~*~@' + MakeBlankStringNull(FieldByName('PatientName').AsString) + '@~*~@' + MakeBlankStringNull
                 (FieldByName('MobileNO').AsString) + '@~*~@' + MakeBlankStringNull(MSG);
               Str := Str + '&PostedDateTime=' + FormatDateTime('YYYY-MM-DD', Date) + ' ' + TodaysTime + '&DataType=SMSNOTIF';

               SQL.Clear;
               SQL.Add('Insert into QueryCollection (ID,Org_ID,Sub_Org_Id,Query_Data,Status,DateTime,DataType');
               SQL.Add(',PatientID,PatientName,SampleNo');
               SQL.Add(') Values (');
               SQL.Add('(Select NVL(Max(Id),0)+1 From QueryCollection)');
               SQL.Add(',' + gs_OrganizationID + ',' + gs_SubOrganizationID);
               SQL.Add(',' + #39 + Str + #39 + ',' + #39 + '0' + #39 + ',' + #39 + TodaysDate + ' ' + TodaysTime + #39);
               SQL.Add(',''SMSNOTIF'' ');
               SQL.Add(',' + inttostr(PATIENTID) + ',' + #39 + Gs_PatientName + #39 + ',' + #39 + gs_SampleNo + #39);
               SQL.Add(')');
               ExecSQL;
               RESULT := True;
          end
          Else
          begin
               ShowMessage('Please Upload data before sending Sms');
               exit;
          end;

     end;
     Qry.Free;
end;

Function MakeBlankStringNull(Str: String): String;
begin
     if Trim(Str) = '' then
          RESULT := 'NULL'
     else
          RESULT := Str;
