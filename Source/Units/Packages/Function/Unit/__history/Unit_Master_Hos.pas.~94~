procedure AutoLoadDoctorRoundVisit(PatientId,InpatientId,DocId : Integer; DocCode,AdmnDate,DisDate,PatientType,IsDisInDepoist,DisInDepositDate :String);
Var
     i, j, k, NoOfDays, li_DocSvrId, li_NoOfDocSvr: Integer;
     lf_VatAmt, lf_Discount, lf_ChargeAmt, lf_DisPer, lf_HospitalPart, lf_DoctorPart: Double;
     ls_TodaysTime,ls_TodaysDate,  RoomTypeCode, ls_DisInDepositDate, ls_IsUserDefineRate: String;
     ls_RateType, ls_BedStartDate,ls_BedLastDate: String;
     DEX_AdmnDate,DEX_DisDate,DEX_ExchangeDate : TDateEditX;
     Qry,Query_Process,Query_SubProcess : TOraQuery;
Begin
     Qry := TOraQuery.Create(Nil);
     Query_Process := TOraQuery.Create(Nil);
     Query_SubProcess := TOraQuery.Create(Nil);

     DEX_AdmnDate:= TDateEditX.Create(Nil);
     DEX_AdmnDate.SystemOfDate:=gi_datesystem;

     DEX_DisDate:= TDateEditX.Create(Nil);
     DEX_DisDate.SystemOfDate:=gi_datesystem;

     DEX_ExchangeDate := TDateEditX.Create(Nil);
     DEX_ExchangeDate.SystemOfDate:=gi_datesystem;

     ChangeToDefaultDate(DEX_AdmnDate, DEX_DisDate);
     NoOfDays := DEX_AdmnDate.VSDateAsDays;
     j := DEX_DisDate.VSDateAsDays;
     ls_TodaysTime := ServerDate.TodaysTime;
     ls_TodaysDate := ServerDate.TodaysDate;

     Table_DailyBed:=TTable.Create(Nil);
     //if Not (FileExists(gs_temppath+'\DailyBed.db')) then
     CreateTableDailyBed;

     With Table_DailyBed Do
     Begin
          Close;
          databasename := gs_temppath;
          EmptyTable;
          Open;
     End;

     { Fill Daily Bed }
     With Qry do
     Begin
          Close;
          Session:=DM_Hospital.DB;
          sql.Clear;
          sql.Add(' Select InPatientDID,IPD.WardId,IPD.WardCode,IPD.RoomTypeId,IPD.RoomTypeCode,BedNo,InPTDate,OutDate ');
          sql.Add(' ,RT.NURSINGCARECHARGE,RT.NURSINGCARESVRTAX,RT.ROUNDVISITCHARGE,RT.ROUNDVISITSVRTAX,RT.HOSPARTPERCENT  ');
          sql.Add(' From InPatientDetail IPD,RoomType RT ');
          sql.Add(' where IPD.RoomTypeId=RT.RoomTypeId(+) and Inpatientid=' + IntToStr(InpatientId));
          sql.Add(' Order By InPatientDID ');
          Open;
          First;
          While Not eof Do
          Begin
               ls_BedStartDate := FieldByName('InPTDate').AsString;
               If Trim(FieldByName('OutDate').AsString) = 'C' Then
               Begin
                    IF IsDisInDepoist = 'Y' Then
                         ls_BedLastDate := DisInDepositDate
                    Else
                         ls_BedLastDate := DisDate;
               End
               Else
                    ls_BedLastDate := FieldByName('OutDate').AsString;

               While ls_BedStartDate <= ls_BedLastDate Do
               Begin
                    DEX_ExchangeDate.Text := ls_BedStartDate;
                    ls_BedStartDate := GetFromDateBySubNoOfDays(DEX_ExchangeDate, -1);
                    IF Not Table_DailyBed.Locate('BedDate', DEX_ExchangeDate.Text, []) Then
                         Table_DailyBed.Append
                    Else
                         Table_DailyBed.Edit;
                    Table_DailyBed.FieldByName('InPatientID').AsInteger := InpatientId;
                    Table_DailyBed.FieldByName('PatientID').AsInteger := PatientId;
                    Table_DailyBed.FieldByName('WardCode').AsString := Qry.FieldByName('WardCode').AsString;
                    Table_DailyBed.FieldByName('RoomTypeCode').AsString := Qry.FieldByName('RoomTypeCode').AsString;
                    Table_DailyBed.FieldByName('BedNo').AsString := Qry.FieldByName('BedNo').AsString;
                    Table_DailyBed.FieldByName('BedDate').AsString := DEX_ExchangeDate.Text;
                    Table_DailyBed.FieldByName('NURSINGCARECHARGE').AsFloat := Qry.FieldByName('NURSINGCARECHARGE').AsFloat;
                    Table_DailyBed.FieldByName('NURSINGCARESVRTAX').AsFloat := Qry.FieldByName('NURSINGCARESVRTAX').AsFloat;
                    Table_DailyBed.FieldByName('ROUNDVISITCHARGE').AsFloat := Qry.FieldByName('ROUNDVISITCHARGE').AsFloat;
                    Table_DailyBed.FieldByName('ROUNDVISITSVRTAX').AsFloat := Qry.FieldByName('ROUNDVISITSVRTAX').AsFloat;
                    Table_DailyBed.FieldByName('HOSPARTPERCENT').AsFloat := Qry.FieldByName('HOSPARTPERCENT').AsFloat;
                    Table_DailyBed.FieldByName('WardId').AsInteger := Qry.FieldByName('Wardid').AsInteger;
                    Table_DailyBed.Post;
               End;
               Next;
          End;
     End;

     if PatientType = 'GEN' then
          ls_RateType := 'GEN'
     Else
          ls_RateType := 'FRG';

     IF IsDisInDepoist = 'Y' Then
          ls_DisInDepositDate := DisInDepositDate
     Else
          ls_DisInDepositDate := DisDate;

     With Table_DailyBed Do
     Begin
          Close;
          Open;
          First;
          While Not eof Do
          Begin
               lf_ChargeAmt := Table_DailyBed.FieldByName('ROUNDVISITCHARGE').AsFloat;
               lf_HospitalPart := RoundingAfterSecondPlace(lf_ChargeAmt * Table_DailyBed.FieldByName('HOSPARTPERCENT').AsFloat / 100);
               lf_DoctorPart := lf_ChargeAmt - lf_HospitalPart;
               ls_IsUserDefineRate := 'N';

               IF PatientType = 'FRG' Then
               Begin
                    lf_ChargeAmt := lf_ChargeAmt * 2;
                    lf_HospitalPart := lf_HospitalPart * 2;
                    lf_DoctorPart := lf_DoctorPart * 2;

                    ls_IsUserDefineRate := 'Y';
               End;

               IF gs_TaxRule = 'TAD' Then
                    lf_VatAmt := lf_ChargeAmt * gf_TaxPercent / 100
               Else
                    lf_VatAmt := lf_ChargeAmt * gf_TaxPercent / 100;

               lf_DisPer := 0;

               If Table_DailyBed.FieldByName('BedDate').AsString > ls_DisInDepositDate Then
               Begin
                    Qry.Free;
                    Query_Process.Free;
                    Query_SubProcess.Free;
                    Exit;
               End;

               with Query_Process do
               Begin
                    Close;
                    Session := DM_Hospital.DB;
                    sql.Clear;
                    sql.Add(
                         ' Select DOCTORROUNDVISITID,VisitCharge,ISUSERDEFINERATE,ISDAILYCHARGE,ISCHARGESUBDIVIDED,ISEXTRADOCINVOLVED,DOCCODE From DOCTORROUNDVISIT');
                    sql.Add(' where InpatientId=' + IntToStr(InpatientId));
                    sql.Add(' and VisitDate=' + #39 + Table_DailyBed.FieldByName('BedDate').AsString + #39);
                    sql.Add(' and ISDAILYCHARGE=''Y'' and ISEXTRADOCINVOLVED=''N'' Order by DOCTORROUNDVISITID');
                    Open;

                    { SaveDoctorroundvisit(Isfractionlocked,Isuserdefinerate,Ischargesubdivided,ISDAILYCHARGE,ISEXTRADOCINVOLVED:String;
                      Visitcharge,Tdsper,Svrchrg,Hospitalpart,Doctorpart,Disper,Vatamt,Noofvisit:Double;
