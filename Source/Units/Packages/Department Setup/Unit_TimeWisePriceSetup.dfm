    object Query_Doctor: TOraQuery
    SQL.Strings = (
            'Select * From Doctor Where IsConsultant='#39'Y'#39' and DActive='#39'Y'#39
            'and DepId=71'
            'Order by DocName')
    Left = 280
    Top = 320
  end
