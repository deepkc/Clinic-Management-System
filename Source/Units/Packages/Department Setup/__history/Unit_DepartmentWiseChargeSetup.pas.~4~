procedure TForm_DepartmentWiseChargeSetup.Bb_SaveClick(Sender: TObject);
begin
     if (Dblcb_Department.Text = '') then
     begin
          MsgBox(1006, 0, '', '', '');
          exit;
     end;

     IF Trim(DBLCB_PatientType.Text)='' Then
     begin
          messagedlg('You Must Have to Choose Patient Type.',mtWarning,[mbok],0);
          DBLCB_PatientType.SetFocus;
          Exit;
     end;

     IF Trim(ComboBox_Currency.Text)='' Then
     begin
          messagedlg('You Must Have to Choose Currency Type.',mtWarning,[mbok],0);
          ComboBox_Currency.SetFocus;
          Exit;
     end;

     if Trim(le_FreeFollowupDays.Text)='' then le_FreeFollowupDays.Text:='0';

     IF StrToInt(le_FreeFollowupDays.Text) > 400 Then
     begin
          messagedlg('Free Followup Days Cross 400 Days.',mtWarning,[mbok],0);
          le_FreeFollowupDays.SetFocus;
          Exit;
     end;

     IF Trim(LE_IntermediateFollowupDays.Text)='' Then LE_IntermediateFollowupDays.Text:='0';
     IF StrToInt(LE_IntermediateFollowupDays.Text) > 400 Then
     begin
          messagedlg('Intermediate Followup Days Cross 400 Days.',mtWarning,[mbok],0);
          LE_IntermediateFollowupDays.SetFocus;
          Exit;
     end;

     if Trim(le_FreeFollowupDays.Text)='' then le_FreeFollowupDays.Text:='0';
     if Trim(LE_IntermediateFollowupDays.Text)='' then LE_IntermediateFollowupDays.Text:='0';

     if pb_IsNew=True then
     Begin
          IF IsCheckDuplicateDepWiseCharge(Dblcb_Department.KeyValue,DBLCB_PatientType.KeyValue)=True Then
          begin
               messagedlg('Already Exist Department Wise Charge of this patient type.',mtWarning,[mbok],0);
               DBLCB_PatientType.SetFocus;
               Exit;
          end;
     End;

     Set_Zero_InBlank;
     Calculate_Tax_And_Amount;
     savedata;
     ClearAll(pnl_DepWiseCharge);
     NewEntryMode;
end;

