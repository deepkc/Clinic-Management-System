procedure TForm_DepartmentWiseChargeSetup.SaveData;
var
     ls_PATIENTTYPECODE,ls_ISCHARGEWITHSVRTAX,ls_CURRENCYTYPE: string;
     li_DepId, li_FREEFOLLOWUPDAYS, li_INTERFOLLOWUPDAYS: INTEGER;
begin
     li_DepId := Dblcb_Department.KeyValue;
     ls_PATIENTTYPECODE:=DBLCB_PatientType.KeyValue;

     if CB_IncludingServiceTaxCharges.Checked=True then
     ls_ISCHARGEWITHSVRTAX:='Y'
     Else
     ls_ISCHARGEWITHSVRTAX:='N';

     ls_CURRENCYTYPE:=ComboBox_Currency.Text;

     li_FREEFOLLOWUPDAYS:=StrToInt(le_FreeFollowupDays.Text);
     li_INTERFOLLOWUPDAYS:=StrToInt(LE_IntermediateFollowupDays.Text);


     pf_NEWREGTAX:=StrToFloat(Edit_NewVatAmt.Text);
     pf_FOLLOWUPTAX:=StrToFloat(Edit_FollowupVatAmt.Text);
     pf_REFERFOLLOWUPTAX:=StrToFloat(Edit_InterFollowupVatAmt.Text);
     pf_RegOPDCardTAX:=StrToFloat(Edit_RegOPDCardVatAmt.Text);
     pf_ADMISSONTAX:=StrToFloat(Edit_InpatientRegVatAmt.Text);


     if pb_IsNew then
     SaveDepartmentWiseCharge(ls_PATIENTTYPECODE,ls_CURRENCYTYPE,ls_ISCHARGEWITHSVRTAX,pf_NEWREGCHARGE, pf_NEWREGTAX,
          pf_FOLLOWUPCHARGE,pf_FOLLOWUPTAX, pf_REFERFOLLOWUPCHARGE,pf_REFERFOLLOWUPTAX,pf_RegOPDCardCharge,pf_RegOPDCardTAX,pf_ADMISSONCHARGE,pf_ADMISSONTAX,
          li_DepId, li_FREEFOLLOWUPDAYS, li_INTERFOLLOWUPDAYS)
     else
     UpdateDepartmentWiseCharge(ls_PATIENTTYPECODE,ls_CURRENCYTYPE,ls_ISCHARGEWITHSVRTAX,pf_NEWREGCHARGE, pf_NEWREGTAX,
                    pf_FOLLOWUPCHARGE,pf_FOLLOWUPTAX,pf_REFERFOLLOWUPCHARGE,pf_REFERFOLLOWUPTAX,pf_RegOPDCardCharge,pf_RegOPDCardTAX,pf_ADMISSONCHARGE,pf_ADMISSONTAX,
                    li_FREEFOLLOWUPDAYS,li_INTERFOLLOWUPDAYS, pi_DEPWISECHARGEID);
     ShowDoneMessage;
end;

