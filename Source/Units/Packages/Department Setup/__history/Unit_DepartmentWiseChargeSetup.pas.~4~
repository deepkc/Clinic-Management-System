Procedure TForm_DepartmentWiseChargeSetup.NewEntryMode;
Begin
     pb_IsNew:=True;
     Query_Department.Close;
     Query_Department.Open;
     Dblcb_Department.KeyValue:=pi_DepID;
     Dblcb_Department.Enabled:=True;
     Dblcb_Department.Color:=clWhite;

     GetDepartmentWiseCharge;

     Query_PatientType.Close;
     Query_PatientType.Open;

     DBLCB_PatientType.KeyValue:=Query_PatientType.FieldByName('PATY_PatientTypeCode').AsString;
     DBLCB_PatientType.Enabled:=True;
     DBLCB_PatientType.Color:=clWhite;

     ComboBox_Currency.ItemIndex:=0;

     Set_SvrTax_Percent;

     if gi_HospitalId=561 then // 561 -Fewa City Hospital
     begin
          LE_IntermediateFollowupDays.ReadOnly:=False;
          LE_IntermediateFollowupDays.Enabled:=True;
          LE_IntermediateFollowupDays.Color:=clWhite;

          Label3.Enabled:=True;
          Edit_InterFollowUpCharge.Enabled:=True;
          Edit_InterFollowUpCharge.Color:=clWhite;

          Edit_InterFollowupTaxPer.Enabled:=True;
          Edit_InterFollowupTaxPer.Color:=clWhite;

          Edit_InterFollowupVatAmt.Enabled:=True;
          Edit_InterFollowupVatAmt.Color:=clWhite;

          Edit_InterFollowupTotalAmount.Enabled:=True;
          Edit_InterFollowupTotalAmount.Color:=clWhite;

     end
     else
     begin
          LE_IntermediateFollowupDays.ReadOnly:=True;
          LE_IntermediateFollowupDays.Enabled:=True;
          LE_IntermediateFollowupDays.Color:=clWhite;

          Label3.Enabled:=True;
          Edit_InterFollowUpCharge.Enabled:=True;
          Edit_InterFollowUpCharge.Color:=clWindow;

          Edit_InterFollowupTaxPer.Enabled:=True;
          Edit_InterFollowupTaxPer.Color:=clWindow;

          Edit_InterFollowupVatAmt.Enabled:=True;
          Edit_InterFollowupVatAmt.Color:=clWindow;

          Edit_InterFollowupTotalAmount.Enabled:=True;
          Edit_InterFollowupTotalAmount.Color:=clWindow;
     end;

     Dblcb_Department.SetFocus;


End;




