procedure TForm_DepartmentWiseChargeSetup.DBGridDeptDblClick(Sender: TObject);
begin
     IF qry_DepWiseCharge.FieldByName('DEPWISECHARGEID').AsInteger<=0 Then
     begin
          MessageDlg('No Record to Modify.',mtWarning,[mbOK],0);
          Exit;
     end;

     pi_DEPWISECHARGEID:=qry_DepWiseCharge.FieldByName('DEPWISECHARGEID').AsInteger;

     pb_IsNew:=False;
     Dblcb_Department.Enabled:=True;
     Dblcb_Department.KeyValue:=qry_DepWiseCharge.FieldByName('DepID').AsInteger;
     Dblcb_Department.Color:=clMenu;
     Dblcb_Department.Enabled:=False;



     DBLCB_PatientType.Enabled:=True;
     DBLCB_PatientType.KeyValue:=qry_DepWiseCharge.FieldByName('PatientTypeCode').AsString;
     DBLCB_PatientType.Color:=clMenu;
     //DBLCB_PatientType.Enabled:=False;


     if qry_DepWiseCharge.FieldByName('CURRENCYTYPE').AsString='NRS' then
     ComboBox_Currency.ItemIndex:=0
     else
     ComboBox_Currency.ItemIndex:=1;
     //ComboBox_Currency.Text:=qry_DepWiseCharge.FieldByName('CURRENCYTYPE').AsString;
     ComboBox_Currency.SetFocus;

     le_FreeFollowupDays.Text:=IntToStr(qry_DepWiseCharge.FieldByName('FREEFOLLOWUPDAYS').AsInteger);
     LE_IntermediateFollowupDays.Text:=IntToStr(qry_DepWiseCharge.FieldByName('INTERFOLLOWUPDAYS').AsInteger);

     if qry_DepWiseCharge.FieldByName('ISCHARGEWITHTAX').AsString='Y' then
     CB_IncludingServiceTaxCharges.Checked:=True
     Else
     CB_IncludingServiceTaxCharges.Checked:=False;

     IF qry_DepWiseCharge.FieldByName('ISCHARGEWITHTAX').ASString='Y' Then
     Begin
          CB_IncludingServiceTaxCharges.Checked:=True;

          Edit_NewRegCharge.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('NewVisitCharge').ASFloat + qry_DepWiseCharge.FieldByName('NewVisitTax').AsFloat);
          Edit_FollowUpCharge.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('FOLLOWUPCHARGE').ASFloat + qry_DepWiseCharge.FieldByName('FOLLOWUPTAX').AsFloat );
          Edit_INTERFollowUpCharge.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('REFERFOLLOWUPCHARGE').ASFloat + qry_DepWiseCharge.FieldByName('REFERFOLLOWUPTAX').AsFloat );
          Edit_RegOPDCardCharge.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('REGOPDCARDCHARGE').ASFloat + qry_DepWiseCharge.FieldByName('REGOPDCARDTAX').AsFloat);
          Edit_InpatientRegCharge.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('ADMISSIONCHARGE').ASFloat + qry_DepWiseCharge.FieldByName('ADMISSIONTAX').AsFloat);

     End
     Else
     Begin
          CB_IncludingServiceTaxCharges.Checked:=False;

          Edit_NewRegCharge.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('NewVisitCharge').ASFloat);
          Edit_FollowUpCharge.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('FOLLOWUPCHARGE').ASFloat);
          Edit_INTERFollowUpCharge.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('REFERFOLLOWUPCHARGE').ASFloat);
          Edit_RegOPDCardCharge.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('REGOPDCARDCHARGE').ASFloat);
          Edit_InpatientRegCharge.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('ADMISSIONCHARGE').ASFloat);
     End;

     pf_NEWREGCHARGE:=qry_DepWiseCharge.FieldByName('NewVisitCharge').ASFloat;
     Edit_NewTotalAmount.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('NewVisitCharge').AsFloat+qry_DepWiseCharge.FieldByName('NewVisitTax').AsFloat);
     Edit_NewVatAmt.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('NewVisitTax').AsFloat);

     pf_FOLLOWUPCHARGE:=qry_DepWiseCharge.FieldByName('FOLLOWUPCHARGE').ASFloat;
     Edit_FollowupTotalAmount.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('FOLLOWUPCHARGE').AsFloat+qry_DepWiseCharge.FieldByName('FOLLOWUPTAX').AsFloat);
     Edit_FollowupVatAmt.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('FOLLOWUPTAX').AsFloat);


     pf_REFERFOLLOWUPCHARGE:=qry_DepWiseCharge.FieldByName('REFERFOLLOWUPCHARGE').ASFloat;
     Edit_INTERFollowupTotalAmount.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('REFERFOLLOWUPCHARGE').AsFloat+qry_DepWiseCharge.FieldByName('REFERFOLLOWUPTAX').AsFloat);
     Edit_INTERFollowupVatAmt.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('REFERFOLLOWUPTAX').AsFloat);

     pf_RegOPDCardCharge:=qry_DepWiseCharge.FieldByName('REGOPDCARDCHARGE').ASFloat;
     Edit_RegOPDCardTotalAmount.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('REGOPDCARDCHARGE').AsFloat+qry_DepWiseCharge.FieldByName('REGOPDCARDTAX').AsFloat);
     Edit_RegOPDCardVatAmt.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('REGOPDCARDTAX').AsFloat);

     pf_ADMISSONCHARGE:=qry_DepWiseCharge.FieldByName('ADMISSIONCHARGE').ASFloat;
     Edit_InpatientRegChargeTotalAmount.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('ADMISSIONCHARGE').AsFloat+qry_DepWiseCharge.FieldByName('ADMISSIONTAX').AsFloat);
     Edit_InpatientRegVatAmt.Text:=FloatToStr(qry_DepWiseCharge.FieldByName('ADMISSIONTAX').AsFloat);
end;

