          FieldDefs.Add('RepNo', ftInteger);
          FieldDefs.Add('DepId', ftInteger);
          FieldDefs.Add('IsDefaultFinding',ftString,1);
          CreateTable;
     end;

     if FileExists(gs_temppath + '\SensitiveMedicine.db') then
     begin
          with Table_SensitiveMedicine do
