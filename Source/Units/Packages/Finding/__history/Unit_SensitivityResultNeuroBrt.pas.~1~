{$R *.dfm}

procedure TForm_SensitivityResultNeuroBrt.BB_CloseClick(Sender: TObject);
begin
     Close;
end;

procedure TForm_SensitivityResultNeuroBrt.cb_ResultKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
     if (Key=13) and (cb_Result.Text<>'') then
          begin
              QueryList.Locate('Medicine',QueryList.FieldByName('Medicine').AsString,[]);
              QueryList.edit;
              QueryList.FieldByName('Result').AsString:=cb_Result.Text;
              QueryList.Post;
              RefreshData;
              Edit_MedicineSearch.SetFocus;
          end;
end;

