procedure TForm_SensitivityResultNeuroBrt.Edit_MedicineSearchChange(Sender: TObject);
begin
     if CheckBox_SearchCode.Checked=true then
     begin
          with QueryList do
          Begin
              IF trim(Edit_MedicineSearch.Text) <> '' Then
              Begin
                  Filter := 'Medcode =' + #39 + Edit_MedicineSearch.Text + '*' + #39;
                  Filtered := true;
              End
              Else
              Filtered := false;
          End;
     end
     else
     begin
          with QueryList do
         Begin
              IF trim(Edit_MedicineSearch.Text) <> '' Then
              Begin
                   Filter := 'Medicine =' + #39 + Edit_MedicineSearch.Text + '*' + #39;
                   Filtered := true;
              End
              Else
                   Filtered := false;
         End;
     end;

     //BB_RefreshClick(Sender);
end;

