begin
     if key=#13 then
     cb_Result.SetFocus;
end;

procedure TForm_SensitivityResultNeuroBrt.FormCreate(Sender: TObject);
begin
     lbl_Name.Caption:=GetTestName(gi_PatientTestID);
end;

procedure TForm_SensitivityResultNeuroBrt.FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
     if Key = 27 then
          BB_CloseClick(Sender);
end;

procedure TForm_SensitivityResultNeuroBrt.FormShow(Sender: TObject);
begin
     with QueryList do
     begin
          Close;
          DatabaseName := gs_temppath;
          SQL[1]:='Where TestNameID='+IntToStr(gi_TestNameId);
          SQL[2]:='And RepNo='+IntToStr(Gi_RepNo);
          Open;
          //SQL.SaveToFile('c:\error.txt');
     end;
     RefreshData;
end;

procedure TForm_SensitivityResultNeuroBrt.RefreshData;
begin
     with qry_s do
     begin
          Close;
          DatabaseName:=gs_temppath;
          Open;
     end;
     with qry_ps do
     begin
          Close;
          DatabaseName:=gs_temppath;
          Open;
     end;
     with qry_r do
     begin
          Close;
          DatabaseName:=gs_temppath;
          Open;
     end;
end;

end.
