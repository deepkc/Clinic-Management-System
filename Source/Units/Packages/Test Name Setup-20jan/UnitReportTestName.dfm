  object QueryTestName: TQuery
    DatabaseName = 'Hospital'
    DataSource = DataSourceQueryDepartment
    SQL.Strings = (
      
        'SELECT TestNameCode as TestCode,TestName,TestPrice+Vat as Genera' +
        'l,'
      'TestPriceSBed as Private,TestPriceDBed as Special,'
      
        'TestPriceForeigner+VatTPFrg as Foreigner$,TestPriceHBF as Expres' +
        's,'
      'TNCategoryCode as CategoryCode from TestName '
      'Where (DepID=:DepID) AND'
      '(ISActive='#39'T'#39')'
      'Order By TestName,TESTNAMECODE')
    Left = 208
    Top = 288
    ParamData = <
      item
        DataType = ftFloat
        Name = 'DEPID'
        ParamType = ptUnknown
      end>
  end
  object QueryDepartment: TQuery
    DatabaseName = 'Hospital'
    SQL.Strings = (
      'Select DepId,DepName,DepCode from Department'
      'Where(DepID=:DepID) '
      'Order By DepCode')
    Left = 144
    Top = 288
    ParamData = <
      item
        DataType = ftInteger
        Name = 'DepID'
        ParamType = ptUnknown
      end>
    object QueryDepartmentDEPID: TFloatField
      FieldName = 'DEPID'
      Origin = 'HOSPITAL.DEPARTMENT.DEPID'
      Visible = False
    end
    object QueryDepartmentDEPCODE: TStringField
      FieldName = 'DEPCODE'
      Origin = 'HOSPITAL.DEPARTMENT.DEPCODE'
      Size = 5
    end
    object QueryDepartmentDEPNAME: TStringField
      FieldName = 'DEPNAME'
      Origin = 'HOSPITAL.DEPARTMENT.DEPNAME'
      Size = 100
    end
  end
  object DataSourceQueryDepartment: TDataSource
    DataSet = QueryDepartment
    Left = 176
    Top = 288
  end
