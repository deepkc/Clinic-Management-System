Function GetExcludedDocId(UserId:Integer):String;
Var
     Qry_GetDocID: TOraQuery;
     ls_DociD:String;
begin
     ls_DociD:='';
     Qry_GetDocID := TOraQuery.Create(nil);
     with Qry_GetDocID do
     begin
          close;
          Session := dm_Hospital.DB;
          sql.Clear;
          sql.Add(
               ' Select EDFR_DOCID From HS_EDFR_ExcludeDocInFrctReport');
          sql.Add(' where EDFR_UserId=' + IntToStr(Userid));
          open;
          First;
          //Result := fieldbyname('EDST_DOCID').AsInteger;
     end;
     while not Qry_GetDocID.Eof do
     begin
          if ls_DociD='' then
          ls_DociD:= IntToStr(Qry_GetDocID.fieldbyname('EDFR_DOCID').AsInteger)
          else
          ls_DociD:=ls_DociD+','+IntToStr(Qry_GetDocID.fieldbyname('EDFR_DOCID').AsInteger);
          Qry_GetDocID.Next;
     end;

     Result := ls_DociD;
     Qry_GetDocID.free;
end;


Function GetMaxId(TableName, FieldName: String): Integer;
Var
     Query: TOraQuery;
Begin
     Query := TOraQuery.Create(nil);
     With Query do
     Begin
          Close;
          Session := dm_Hospital.DB;
          sql.Clear;
          sql.Add(' Select NVL(Max(' + FieldName + '),0) as MaxVal From ' + TableName);
          Open;
          RESULT := FieldByName('MaxVal').AsInteger + 1;
     End;
     Query.Free;
End;



