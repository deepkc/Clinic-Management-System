  object Query_Doctor: TOraQuery
    SQL.Strings = (
      
        'SELECT DOCT_DOCID,DOCT_DOCCODE,DOCT_DESIG,Upper(DOCT_DOCNAME)Doc' +
        'Name,DOCT_QUALIFICATION,DOCT_SPECIALIZATION,DOCT_MOBILENO,DOCT_P' +
        'HONENO,DOCT_NMCNO,DOct_Depid,'
      
        '(Select DEPT_DEPNAME From Hs_Dept_Department where DEPT_DEPCODE=' +
        'D.DOCT_DEPCODE and DEPT_ORGID=D.DOCT_ORGID) as DepName,Doct_DOct' +
        'ype as DoctorType'
      'From Hs_Doct_Doctor D'
      'WHERE DOCT_ISACTIVE='#39'Y'#39)
    Left = 296
    Top = 112
  end
end
