package Registration;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  Global,
  vcldbx,
  MidasFunction,
  BarcodeD10,
  Billing,
  MidasFxnFraction,
  dac140,
  odac140,
  DelphiTwainPackage;

contains
  Unit_OPDVisit in 'Unit_OPDVisit.pas' {Frame_OPDVisit: TFrame},
  UnitVDC in 'VDCMCPT\UnitVDC.pas' {FormVDC},
  Unit_NewPatient in 'Unit_NewPatient.pas' {Frame_NewPatient: TFrame},
  Unit_QrOpSticker in 'Unit_QrOpSticker.pas' {Form_OPSticker},
  Unit_image in 'Unit_image.pas' {Form_Image},
  Unit_QrCard in 'Unit_QrCard.pas' {Form_QRCard},
  Unit_QrCard_PPL in 'Unit_QrCard_PPL.pas' {Form_QRCard_PPL},
  Unit_QrCard_NRL in 'Unit_QrCard_NRL.pas' {Form_QRCard_NRL},
  Unit_QrCard_GMC in 'Unit_QrCard_GMC.pas' {Form_QRCard_GMC},
  Unit_QrCard_BNB in 'Unit_QrCard_BNB.pas' {FormCard_BNB};

end.
