                    pi_DocWiseQueueNo:=GetRegQueueNoDocWise(ps_TodaysDate,gs_SystemType,pi_DocId,pi_DepId);
                    pi_DepWiseQueueNo:=0;
               End
               else
               begin
                    pi_DepWiseQueueNo:=GetRegQueueNoDepWise(ps_TodaysDate,gs_SystemType,pi_DepId);
                    pi_DocWiseQueueNo:=0;
               end;
          end;

          pi_RefById:= pi_RefById;
          pi_RefDepId := pi_RefDepId;

          if (ps_PayType = 'CASH') then
               ps_Initial := 'CS'
          else if ps_PayType = 'CREDIT' then
          Begin
               ps_Initial := 'CR';
          End;

          ps_VISITSTATUS:='V';

          pb_IsWithRegCardCharge:=pb_IsWithRegCardCharge;


          pi_SchemeID := pi_SCHEMEID;
          pi_communityid := pi_COMMUNITYID;


          if gs_RegistrationType='NEW' then
          pi_VISITCOUNT := 1
          Else
          pi_VISITCOUNT := GetNoOfVisit(gi_PatientId);

          ps_Remarks:='';
          //end;

          pf_CreditLimitEx:=0;
          pf_CreditLimit:=0;

          pi_SBDIDREGOPDCARD:=0;
          pi_SBDIDDOCVISIT:=0;

          ps_VISITTYPE :='WNP';//'WOP,ANP,AOP

          if Trim(DBLCB_REFBYTYPE.Text) <> '' then
          Begin
               Pi_RefByTypeId := DBLCB_REFBYTYPE.KeyValue;
          End
          Else
          Begin
               Pi_RefByTypeId := 0;
          End;

     end;

     if gs_IsDocCompForRegFollowup='Y' then
     begin
          ps_Service:='DOCCH';
          ps_ServiceType:='DOCTOR CONSULTATION CHARGE';
     end
     else
     begin
          if gs_RegistrationType='NEW' then
          ps_ServiceType:='REG'
          else
          ps_ServiceType:='Re-Visit';
          ps_Service:=ps_DEPCODE;
     end;



     ls_SQLstring :='';
     if gs_RegistrationType='MODIFYDATA' then
     begin
           CheckModifyInfo(gi_PatientId, gi_NonPatientID, LI_AGE, LI_COUNTRYID, LI_ZONEID, LI_DISTRICTID, LI_VDCID, LI_WARDNO,
                           LI_OCCUPATIONID, LI_RELATIONID, LI_DATAPOSTBY, LI_EDUCATIONID, LI_RELIGIONID, LS_TITLE, LS_FNAME, LS_MNAME, LS_LNAME,
                           LS_PATIENTNAME, LS_GENDER, LS_AGETYPE, LS_DOBVS, LS_DOBAD, ls_IsActualDOB, LS_MARITALSTATUS, LS_ADDRESS, LS_PHONENO, LS_MOBILENO,
                           LS_EMAIL, LS_COMPANY, LS_PATIENTTYPECODE, LS_NEXTTOKIN, PS_CARDNO, ps_ECHSNO, ps_Remarks, ps_TodaysDate, ps_TodaysTime, gs_MacID,
                           PINNO, LS_PATIENTCATEGORYNAME,ls_SQLstring);

           if ls_SQLstring='' then
           Begin
                MessageDlg('No Record Modified',mtWarning,[mbok],0);
                Exit;
           End;
     end;

     if gs_IsFileMgmtActive='Y' then
     Begin
          if gs_RegistrationType='FOLLOWUP' then
          begin
               With QueryCheckFileStatus do
               Begin
                    Close;
                    SQL[2]:=' Where FIST_Patientid='+IntToStr(pi_PatientId);
                    Open;
               End;
          end;
     End;

     li_FileNo:=0;
     Gs_BillNo :='';
     ps_BillNo:='';
     { ------------------------------------------------ }
     try

          DM_Hospital.DB.StartTransaction;

          if gs_RegistrationType='NEW' then
          begin
               Try
                    SavePatient(LI_NONPATIENTID, LI_AGE, LI_COUNTRYID, LI_ZONEID, LI_DISTRICTID, LI_VDCID, LI_WARDNO, LI_RELIGIONID,
                         LI_OCCUPATIONID, LI_RELATIONID, LI_DATAPOSTBY,LI_EDUCATIONID, pi_SchemeID,pi_communityid,'', LS_TITLE, LS_FNAME, LS_MNAME, LS_LNAME,
                         LS_PATIENTNAME, LS_GENDER, LS_AGETYPE, LS_DOBVS, LS_DOBAD,ls_IsActualDOB, LS_MARITALSTATUS, LS_ADDRESS, LS_PHONENO, LS_MOBILENO,
                         LS_EMAIL, LS_COMPANY, LS_PATIENTTYPECODE, LS_NEXTTOKIN, PS_CARDNO,ps_ECHSNO, ps_Remarks, ps_TodaysDate, ps_TodaysTime,
                         ps_TodaysDate, ps_TodaysTime, gs_MacID, PINNO,LS_PATIENTCATEGORYNAME,'');
               Except
                    Try
                         SavePatient(LI_NONPATIENTID, LI_AGE, LI_COUNTRYID, LI_ZONEID, LI_DISTRICTID, LI_VDCID, LI_WARDNO, LI_RELIGIONID,
                              LI_OCCUPATIONID, LI_RELATIONID, LI_DATAPOSTBY,LI_EDUCATIONID, pi_SchemeID,pi_communityid,'', LS_TITLE, LS_FNAME, LS_MNAME, LS_LNAME,
                              LS_PATIENTNAME, LS_GENDER, LS_AGETYPE, LS_DOBVS, LS_DOBAD,ls_IsActualDOB, LS_MARITALSTATUS, LS_ADDRESS, LS_PHONENO, LS_MOBILENO,
                              LS_EMAIL, LS_COMPANY, LS_PATIENTTYPECODE, LS_NEXTTOKIN, PS_CARDNO,ps_ECHSNO, ps_Remarks, ps_TodaysDate, ps_TodaysTime,
                              ps_TodaysDate, ps_TodaysTime, gs_MacID, PINNO,LS_PATIENTCATEGORYNAME,'');
                    Except
                         SavePatient(LI_NONPATIENTID, LI_AGE, LI_COUNTRYID, LI_ZONEID, LI_DISTRICTID, LI_VDCID, LI_WARDNO, LI_RELIGIONID,
                              LI_OCCUPATIONID, LI_RELATIONID, LI_DATAPOSTBY,LI_EDUCATIONID, pi_SchemeID,pi_communityid,'', LS_TITLE, LS_FNAME, LS_MNAME, LS_LNAME,
                              LS_PATIENTNAME, LS_GENDER, LS_AGETYPE, LS_DOBVS, LS_DOBAD,ls_IsActualDOB, LS_MARITALSTATUS, LS_ADDRESS, LS_PHONENO, LS_MOBILENO,
                              LS_EMAIL, LS_COMPANY, LS_PATIENTTYPECODE, LS_NEXTTOKIN, PS_CARDNO,ps_ECHSNO, ps_Remarks, ps_TodaysDate, ps_TodaysTime,
                              ps_TodaysDate, ps_TodaysTime, gs_MacID, PINNO,LS_PATIENTCATEGORYNAME,'');
                    End;
               End;

               if gi_NonPatientID > 0 then
               UpdateNonPatientId(gi_NonPatientID, gi_PatientId);
          end
          else
          Begin


          (*     UpdatePatient(gi_PatientId, gi_NonPatientID, LI_AGE, LI_COUNTRYID, LI_ZONEID, LI_DISTRICTID, LI_VDCID, LI_WARDNO,
                    LI_OCCUPATIONID, LI_RELATIONID, LI_DATAPOSTBY, LI_EDUCATIONID, LI_RELIGIONID, LS_TITLE, LS_FNAME, LS_MNAME, LS_LNAME,
                    LS_PATIENTNAME, LS_GENDER, LS_AGETYPE, LS_DOBVS, LS_DOBAD, ls_IsActualDOB, LS_MARITALSTATUS, LS_ADDRESS, LS_PHONENO, LS_MOBILENO,
                    LS_EMAIL, LS_COMPANY, LS_PATIENTTYPECODE, LS_NEXTTOKIN, PS_CARDNO, ps_Remarks, ps_TodaysDate, ps_TodaysTime, gs_MacID,
                    PINNO, LS_PATIENTCATEGORYNAME);
             *)
              if gs_RegistrationType='MODIFYDATA' then
              UpdatePatient(gi_PatientId,ls_SQLstring);
          End;

          // SaveImage;

          if (gs_RegistrationType='NEW') or (gs_RegistrationType='FOLLOWUP') then
          begin
               SavePatientVisitAndCharge;
               if gs_IsFileMgmtActive='Y' then
               Filestatus;
