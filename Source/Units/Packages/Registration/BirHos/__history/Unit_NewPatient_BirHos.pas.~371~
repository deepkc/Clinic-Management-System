Procedure TForm_NewPatient_BIRHOS.Check_MSCValidity;
Var
     DEX_TodayDate,DEX_JoinDate,DEX_ExpireDate : TDateEditX;
     b_IsMSCExpired : Boolean;
Begin
     IF Check_ISMSCPatient(pi_PatientId)=False Then
     Begin
          LblMscNoCap.Visible :=false;
          LblMscNo.Visible :=false;
          Timer3.Enabled :=false;
          EditRegDis.ReadOnly :=false;
          EditRegDis.Enabled:=True;
          EditRegDis.Color:=clWhite;
          EditRegDis.Text :='0';
          gb_IsValidMSCPatient :=false;
     End
     Else
     Begin
               //MSC Case
          DEX_TodayDate:=TDateEditX.Create(nil);
          DEX_TodayDate.SystemOfDate:=gi_DateSystem;
          DEX_TodayDate.Text :=ServerDate.todaysDate;

          DEX_JoinDate:=TDateEditX.Create(nil);
          DEX_JoinDate.SystemOfDate:=gi_DateSystem;
          DEX_JoinDate.Text :=DEX_TodayDate.Text;

          DEX_ExpireDate:=TDateEditX.Create(nil);
          DEX_ExpireDate.SystemOfDate:=gi_DateSystem;
          DEX_ExpireDate.Text :=DEX_TodayDate.Text;

          { IF It is MSC patient Then }

          DEX_JoinDate.Text := gs_MSCJoinDate;
          DEX_ExpireDate.Text:=gs_MSCExpDate;

          gb_IsValidMSCPatient:=True;
          b_IsMSCExpired:=False;
          IF (DEX_TodayDate.ADDateAsDate > DEX_ExpireDate.ADDateAsDate) then
          Begin
               MessageDlg('MSC Member Card has expired, Expiry Date : '+ DEX_ExpireDate.Text,mtInformation ,[MbOk],0);
               gb_IsValidMSCPatient := false;
               b_IsMSCExpired:=True;
               with Query_Blank do
               begin
                    close;
                    sql.clear;
                    sql.Add(' Select MSCMemberId,mscMemberNo,OldMscMemberNo,ExpiryDate,ReferenceMemberNo,JoinedDate,ExpiryDate from msc_member where PatientId = '+ IntToStr(pi_PatientId)+ ' and active =''Y'' order by MscMemberid Desc');
                    open;
               End;

               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    IF Length(Trim(Query_Blank.FieldByName('ReferenceMemberNo').AsString)) < 2 Then
                    Begin
                         sql.add(' Update MSC_Member set Active=''N'' where MSCMemberNo='+#39+gs_MSCMemberNumber+#39);
                         sql.add(' or ReferenceMemberNo='+#39+gs_MSCMemberNumber+#39);
                    End
                    Else
                    sql.add(' Update MSC_Member set Active=''N'' where PatientId='+IntToStr(pi_PatientId));
                    ExecSQL;
               End;
          End;

          //Checking Msc Card validity
          If (DEX_TodayDate.ADDateAsDate < DEX_JoinDate.ADDateAsDate+21) then
          Begin
               MessageDlg('MSC Member Card will be worked after 21 Days of issued date '+ DEX_JoinDate.text,mtInformation ,[MbOk],0);
               gb_IsValidMSCPatient := false;
               Exit;
          end;

          pf_MscPtSpendedAmt:=Round(Get_MSCSpendedTotal(gs_MSCMemberNumber,gs_MSCJoinDate,gs_MSCExpDate));

          if  pf_MscPtSpendedAmt >= gf_MSCServiceLimitAmt then
          begin
               IF b_IsMSCExpired=False Then
               MessageDlg('MSC Member Card has crossed service limit amount.',mtWarning ,[MbOk],0);
               gb_IsValidMSCPatient := false;
          end;

          ps_MscMemberNo := gs_MSCMemberNumber;
          if gb_IsValidMSCPatient = true then
          begin
               Timer3.Enabled :=true;
               LblMscNoCap.Visible :=true;
               LblMscNo.Visible :=true;
               lblmscNo.Caption :=gs_MSCMemberNumber + '      > '+gs_OldMSCMemberNumber;
               pi_COMMUNITYID:= 70;
               with Query_Scheme do
               begin
                    Close;
                    Open;
               end;
               DBLCB_Scheme.keyValue:= 76;
               EditRegDis.ReadOnly :=false;
               EditRegDis.Enabled:=True;
               EditRegDis.Color:=clWhite;
               editRegDis.Text :='100';
          end
          else
          begin
               timer3.Enabled :=true;
               LblMscNoCap.Visible :=true;
               LblMscNo.Visible :=true;
               IF b_IsMSCExpired=True Then
               lblmscNo.Caption :=gs_MSCMemberNumber  + '(MSC Expired)'
               Else
               lblmscNo.Caption :=gs_MSCMemberNumber  + '(MSC Limit Exceed)';
               editRegDis.Text :='0';
          end;

          DEX_TodayDate.Free;
          DEX_JoinDate.Free;
          DEX_ExpireDate.Free;
     end;
End;


