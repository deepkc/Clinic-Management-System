procedure TForm_NewPatient_BIRHOS.GetDoctorRoutineWise;
Var
    DayOfWeek:Byte;
    Dex_Today :TDateEditX;
Begin
     Dex_Today:=TDateEditX.Create(Nil);
     Dex_Today.SystemOfDate:=gi_DateSystem;
     Dex_Today.Text:=TodaysDate;
     DayOfWeek:=Dex_Today.DayOfWeek;
     with Query_Doctor do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select DOCT_DOCID DOCID, DOCT_DOCID as DocID,DOCT_DOCNAME DOCName,DOCT_DEPID DEPID,DOCT_ISQUEUENOGENINREG ISQUEUENOGENINREG');
          sql.add(' ,Case When (Select DSBD_DOCSHAREBREAKDOWNID From HS_DSBD_DOCSHAREBREAKDOWN where DSBD_SERVICETYPE=''OPD''');
          sql.add(' and DSBD_DOCID=DORO_DOCID) > 0 Then ''Y'' Else ''N'' End as MutualDocForShare,DOCT_DOCSHAREGROUP DOCSHAREGROUP');
          sql.add(' From HS_DOCT_DOCTOR DOCT,HS_DORO_DoctorRoutine DORO');
          sql.add(' Where DOCT_ISACTIVE=''Y'' and DOCT.DOCT_DOCID=DORO.DORO_DOCID And ');

          IF Trim(DBLCB_Department.Text)<>'' Then
          sql.add(' DORO_DepID='+IntToStr(DBLCB_Department.KeyValue)+' and ');

          IF Trim(DBLookupComboBox_Unit.Text)<>'' Then
          sql.add(' DORO_Unit='+#39+DBLookupComboBox_Unit.Text+#39+' and ');

          If DayOfWeek=1 then
            Sql.Add(' DORO_ISSUNDAYCHECKUP=''Y'' And ')
          Else If DayOfWeek=2 then
            Sql.Add(' DORO_ISMONDAYCHECKUP=''Y'' And ')
          Else If DayOfWeek=3 then
            Sql.Add(' DORO_ISTUESDAYCHECKUP=''Y'' And ')
          Else If DayOfWeek=4 then
            Sql.Add(' DORO_ISWEDNESDAYCHECKUP=''Y'' And ')
          Else If DayOfWeek=5 then
            Sql.Add(' DORO_ISTHURSDAYCHECKUP=''Y'' And ')
          Else If DayOfWeek=6 then
            Sql.Add(' DORO_ISFRIDAYCHECKUP=''Y'' And ')
          Else
            Sql.Add(' DORO_ISSATURDAYCHECKUP=''Y'' And ');
          sql.add(' (0=0) Order By DOCT_DOCORDER,DOCT_DOCNAME');
          Open;
          //DBLCB_Doctor.KeyValue:=FieldbyName('DocCode') .AsString;
          //ps_DOCCODE:=FieldbyName('DocCode') .AsString;
     End;
End;

procedure TForm_NewPatient_BIRHOS.GetOPDVisitCharge;
Var lf_NewGTotal : Double;
begin
     ps_TodaysDate:=TodaysDate;
     if (Trim(DBLCB_PatientType.Text)<>'') and (Trim(DBLCB_Department.Text)<>'') then
     begin
          if gs_PatientTypeCode='' then
          gs_PatientTypeCode:=DBLCB_PatientType.KeyValue;
          pi_DEPID:=DBLCB_Department.KeyValue;

          if gs_IsDocCompForRegFollowup='Y' then // Reg. Billing In Doctor Name (Private Hospital)
          Begin
               pb_IsDoctorWiseOPDCharge:=False;
               if Trim(DBLCB_Doctor.Text)<>'' then
               begin
                    pi_DOCID:=DBLCB_Doctor.KeyValue;
                    pb_IsDoctorWiseOPDCharge:=IsDoctorWiseOPDCharge(pi_DOCID, gs_PatientTypeCode);
                    if gs_IsDocCompForRegFollowup='Y' then
                    Begin
                         if Query_Doctor.FieldByName('ISQUEUENOGENINREG').AsString='Y' then
                         Begin
                              gb_IsDoctorWiseQueue:=True;
                              lbl_QuueNoCap.Caption:='Doctor Wise Queue No :';
                              Label_QueueNo.Caption:=IntToStr(GetRegQueueNoDocWise(ps_TodaysDate,'',pi_DOCID,pi_DEPID));
                         End
                         else
                         Begin
                              gb_IsDoctorWiseQueue:=False;
                              lbl_QuueNoCap.Caption:='Department Wise Queue No :';
                              Label_QueueNo.Caption:=IntToStr(GetRegQueueNoDepWise(ps_TodaysDate,'',pi_DEPID));
                         end;
                    End
                    else
                    begin
                         gb_IsDoctorWiseQueue:=False;
                         lbl_QuueNoCap.Caption:='Department Wise Queue No :';
                         Label_QueueNo.Caption:=IntToStr(GetRegQueueNoDepWise(ps_TodaysDate,'',pi_DEPID));
                    end;
               end;

               GetDoctorRoutineWise;
          End
          else // Reg. Billing On the Department Basis (Medical College & Government Hospital )
          begin
               Query_Doctor.Close;
               pi_DOCID:=0;//'HOS01';
               pb_IsDoctorWiseOPDCharge:=False;

               if gs_ISQUEUENOINREG='Y' then
               Begin
                    gb_IsDoctorWiseQueue:=False;
                    lbl_QuueNoCap.Caption:='Department Wise Queue No :';
                    Label_QueueNo.Caption:=IntToStr(GetRegQueueNoDepWise(ps_TodaysDate,'',pi_DEPID));
               End;
          end;


          if pb_IsDoctorWiseOPDCharge=False then  (* It Takes Reg + Visit Charge Which is Setup Department Wise *)
          Begin
               with Query_OPDVisitCharge do
               begin
                    Close;
                    SQL.Clear;
                    SQL.Add(' Select * From VW_HS_SETUP_DEPTWISECHARGE Where PATIENTTYPECODE='+#39+gs_PatientTypeCode+#39);
                    SQL.Add(' and DEPID='+IntToStr(pi_DEPID));
                    Open;
               end;
          End
          else  (* Some Times Doctor Have Sepcific Charge which is not match as general Department Doctor, If it is Setup then It Takes from here*)
          begin
               with Query_OPDVisitCharge do
               begin
                    Close;
                    SQL.Clear;
                    SQL.Add(' Select * From VW_HS_SETUP_DOCWISECHARGE Where PATIENTTYPECODE='+#39+gs_PatientTypeCode+#39);
                    SQL.Add(' and DOCID='+IntToStr(pi_DOCID));
                    Open;
               end;
          end;

          if UpperCase(gs_RegistrationType) = 'NEW' then
          Begin
               if CB_IsReferal.Checked then
               Begin
                    pf_DocVisitCharge:=Query_OPDVisitCharge.FieldByName('REFERFOLLOWUPCHARGE').AsFloat;
                    pf_DocVisitTax:=Query_OPDVisitCharge.FieldByName('REFERFOLLOWUPTAX').AsFloat;
               End
               Else
               Begin
                    pf_DocVisitCharge:=Query_OPDVisitCharge.FieldByName('NewVisitCharge').AsFloat;
                    pf_DocVisitTax:=Query_OPDVisitCharge.FieldByName('NewVisitTax').AsFloat;
               End;
          End
          else
          begin
               if CB_IsReferal.Checked then
               Begin
                    pf_DocVisitCharge:=Query_OPDVisitCharge.FieldByName('REFERFOLLOWUPCHARGE').AsFloat;
                    pf_DocVisitTax:=Query_OPDVisitCharge.FieldByName('REFERFOLLOWUPTAX').AsFloat;
               End
               Else
               Begin
                    pf_DocVisitCharge:=Query_OPDVisitCharge.FieldByName('FollowUpCharge').AsFloat;
                    pf_DocVisitTax:=Query_OPDVisitCharge.FieldByName('FollowUpTax').AsFloat;
               End;

              { pf_InterDocVisitCharge:=Query_OPDVisitCharge.FieldByName('InterFollowUpCharge').AsFloat;
               pf_InterDocVisitTax:=Query_OPDVisitCharge.FieldByName('InterFollowUpTax').AsFloat;  }
          end;

          pf_DiscountTotal:=0;
          pf_RegOPDCardcharge:=0;
          Pf_RegOPDCardTax:=0;
          Pf_RegOPDCardDiscount:=0;

          pb_IsWithRegCardCharge:=False;

          pi_FreeFollowupDays:=Query_OPDVisitCharge.FieldByName('FREEFOLLOWUPDAYS').AsInteger;
          pi_InterFollowupDays:=Query_OPDVisitCharge.FieldByName('INTERFOLLOWUPDAYS').AsInteger;

          if gi_PatientID >0 then
          Begin
               if gs_IsDocCompForRegFollowup='Y' then
               pi_NoOfGapDays:=GetNumberOfVisitDaysDocWise(gi_PatientID,pi_DOCID)
               Else
               //pi_NoOfGapDays:=GetNumberOfVisitDays(gi_PatientID,DBLCB_Department.KeyValue);
               Begin
                    //if DBLCB_Department.KeyValue='EME01' then
                    //pi_NoOfGapDays:=100
                    //Else
                    pi_NoOfGapDays:=GetNumberOfVisitDaysAnyDepatment(gi_PatientID,pi_DEPID);
               End;
          End
          Else
          pi_NoOfGapDays:=100;

          //Label4.Caption:=FloatToStr(pi_NoOfGapDays);

          if CB_ForceFollowup.Checked=True then
          pi_NoOfGapDays:=100;

          ps_BillingStatus:='B';

          gb_IsBlinkingContinue:=False;
          if (pi_NoOfGapDays<=pi_FreeFollowupDays) then
          begin
               if (pi_InterFollowupDays > 0) and (pi_InterFollowupDays > pi_NoOfGapDays)  then
               Begin
                    //lbl_followupfree.Caption:='ITERMEDIATE FOLLOW UP';
                    pf_DocVisitCharge:=pf_InterDocVisitCharge;
                    pf_DocVisitTax:=pf_InterDocVisitTax;
               end
               else
               Begin
                    //free
                    //lbl_followupfree.Caption:='FOLLOW UP - FREE';
                    gs_FollowUpStatus:='';
                    IF (gs_BlinkingCaption<>'Today’s new patient') and (gs_BlinkingCaption<>'Today’s follow up') Then
                    Begin
                         if (gi_NoOfVisit=1) and (gs_LastVisitDate = ps_TodaysDate) then
                         Begin
                              gs_BlinkingCaption:='Today’s new patient';
                              gs_FollowUpStatus:='NEWPATIENT';
                         End
                         Else if (gi_NoOfVisit > 1) and (gs_LastVisitDate = ps_TodaysDate) Then
                         Begin
                              gs_BlinkingCaption:='Today’s follow up';
                              gs_FollowUpStatus:='FOLLOWUPPATIENT';
                         End
                         else
                         Begin
                              gs_BlinkingCaption:='FOLLOW UP - FREE';
                              gs_FollowUpStatus:='FREEFOLLOWUP';
                         End;
                    End;

                    IF ((gs_BlinkingCaption='Today’s follow up') or (gs_BlinkingCaption='Today’s new patient')) and (gs_FollowUpStatus='') Then
                    Begin
                         if gs_BlinkingCaption='Today’s follow up' then
                         gs_FollowUpStatus:='FOLLOWUPPATIENT'
                         Else
                         gs_FollowUpStatus:='NEWPATIENT';
                    End;

                    gb_IsBlinkingContinue:=True;
                    pf_DocVisitCharge:=0;
                    pf_DocVisitTax:=0;
               End;

               pf_RegOPDCardcharge:=0;
               Pf_RegOPDCardTax:=0;
               ps_BillingStatus:='N';
               //lbl_followupfree.Visible:=True;
          end
          Else
          Begin
               if gs_RegistrationType = 'FOLLOWUP' then
               gs_FollowUpStatus := 'TAKECHARGE';
          End;

          pf_ExchangeRate:=0;
          pf_GrandTotal := pf_DocVisitCharge + pf_DocVisitTax;

          if CB_CardCharge.Checked=True then
          Begin
               (*Label_RegCharge.Caption:=FormatFloat('0.00',(lf_NewGTotal+Query_OPDCardCharge.FieldByName('TestPrice').AsFloat+Query_OPDCardCharge.FieldByName('VatAmt').AsFloat));
               pf_RegOPDCardcharge:=Query_OPDCardCharge.FieldByName('TestPrice').AsFloat;
               Pf_RegOPDCardTax:=Query_OPDCardCharge.FieldByName('VatAmt').AsFloat;
               Pf_RegOPDCardDiscount:=0;*)

               Label_RegCharge.Caption:=FormatFloat('0.00',(lf_NewGTotal+Query_OPDVisitCharge.FieldByName('RegOPDCardCharge').AsFloat+Query_OPDVisitCharge.FieldByName('RegOPDCardTax').AsFloat));
               pf_RegOPDCardcharge:=Query_OPDVisitCharge.FieldByName('RegOPDCardCharge').AsFloat;
               Pf_RegOPDCardTax:=Query_OPDVisitCharge.FieldByName('RegOPDCardTax').AsFloat;
               Pf_RegOPDCardDiscount:=0;
          End
          else
          begin
               pf_RegOPDCardcharge:=0;
               Pf_RegOPDCardTax:=0;
               Pf_RegOPDCardDiscount:=0;
          end;

          if CB_BlueBookChrg.Checked=True then
          Begin
               Label_RegCharge.Caption:=FormatFloat('0.00',(pf_GrandTotal+Query_BlueBookCharge.FieldByName('TestPrice').AsFloat+Query_BlueBookCharge.FieldByName('VatAmt').AsFloat));
               pf_BlueBookCharge:=Query_BlueBookCharge.FieldByName('TestPrice').AsFloat;
               pf_BlueBookTax:=Query_BlueBookCharge.FieldByName('VatAmt').AsFloat;
               pf_BlueBookDiscount :=0;
          End
          else
          begin
               pf_BlueBookCharge:=0;
               pf_BlueBookTax:=0;
               pf_BlueBookDiscount :=0;
          end;

          //lf_NewGTotal:=pf_GrandTotal+pf_BlueBookCharge+pf_BlueBookTax;

          pf_GTotalAfterDiscount := pf_DocVisitCharge + pf_BlueBookCharge + pf_RegOPDCardcharge + pf_DocVisitTax +  pf_BlueBookTax +  Pf_RegOPDCardTax
                                         - (pf_DiscountTotal+ Pf_RegOPDCardDiscount);

          Label_RegCharge.Caption := FormatFloat('0.00',pf_GTotalAfterDiscount);

          pi_COMMUNITYID:=0;
          pi_SCHEMEID:=0;
          pf_DisPer:=0;

          IF Trim(EditRegDis.Text)='' Then EditRegDis.Text:='0';
          if Trim(DBLCB_Scheme.Text)<>'' then
          begin
               if StrToFloat(Trim(EditRegDis.Text)) <=0 then
               EditRegDis.Text:=Query_Scheme.FieldByName('RegDisPer').AsString;
               pf_DisPer := StrToFloat(EditRegDis.Text);

               pf_DocVisitTax:= pf_DocVisitTax - pf_DocVisitTax * pf_DisPer / 100;
               pf_DiscountTotal:=pf_DocVisitCharge * pf_DisPer / 100;

               pf_GTotalAfterDiscount := pf_BlueBookCharge + pf_RegOPDCardcharge + Pf_BlueBookTax+  Pf_RegOPDCardTax
                                         - (pf_DiscountTotal+ Pf_RegOPDCardDiscount+pf_BlueBookDiscount);

               Label_RegCharge.Caption := FormatFloat('0.00',pf_GTotalAfterDiscount);
               EditRegPayment.Clear;
               //EditRegPayment.SetFocus;

               pi_SCHEMEID:=DBLCB_Scheme.KeyValue;
               pi_COMMUNITYID:=Query_Scheme.FieldByName('CommunityId').AsInteger;
          end
          Else
          Begin
               (*if StrToFloat(Trim(EditRegDis.Text)) <=0 then
               EditRegDis.Text:=Query_Scheme.FieldByName('RegDisPer').AsString;
               pf_DisPer := StrToFloat(EditRegDis.Text);

               pf_DocVisitTax:= pf_DocVisitTax - pf_DocVisitTax * pf_DisPer / 100;
               pf_DiscountTotal:=pf_DocVisitCharge * pf_DisPer / 100;*)

               pf_GTotalAfterDiscount := pf_GTotalAfterDiscount;
               Label_RegCharge.Caption :=FormatFloat('0.00',pf_GTotalAfterDiscount);
               EditRegPayment.Clear;
          End;

          //if CB_ChargeFree.Checked=True then
          //Label_RegCharge.Caption:='0.00';


          if (pf_GTotalAfterDiscount > 0) and (gb_IsBlinkingContinue=False) then
          begin
               gb_IsBlinkingContinue:=True;
               gs_BlinkingCaption:='Rs. '+FormatFloat('0.00',pf_GTotalAfterDiscount);
          end
          Else
          Label_RegCharge.Caption:='0.00';

          ps_PayType:=CB_PayType.Text;
          pf_DepositBalance:=StrToFloat(lbl_depositbalance.Caption);
          if Trim(CmbRefferedBy.Text)<>'' then
          pi_RefDocID:=CmbRefferedBy.KeyValue
          else
          pi_RefDocID:=0;
     end;
end;

function TForm_NewPatient_BIRHOS.GetQueueTime(DocCode: String): String;
Var
     QryTime: TQuery;
     NoofO: Integer;
     PaidDuration: Integer;
     CurrentTime, ls_TodaysDate: String;
     QueueTime: String;
     TotalMinutes: Integer;
     MyDateTime: TDateTime;
     MyTime: TTime;
begin
     QryTime := TQuery.Create(Nil);
     ls_TodaysDate := TodaysDate;
     With QryTime do
     begin
          Close;
          DatabaseName := gs_DatabaseName;
          SQL.Clear;
          SQL.Add('Select Count(QueueListID)C from Queuelist Where RegDate=' + #39 + ls_TodaysDate + #39);
          SQL.Add('And Status=''0'' ');
          SQL.Add('And DocCode=' + #39 + DocCode + #39);
          // SQL.Add('And Updated=''N''');
          // SQL.Add('And QueueListID<'+IntToStr(QueueListID));
          Open;
          NoofO := FieldByName('C').AsInteger;
          SQL.Clear;
          DatabaseName := gs_DatabaseName;
          SQL.Add('Select PaidDuration from Department Where DepID in (Select DepID from Doctor Where Doccode=' + #39 + DocCode + #39 +
                 ')');
          Open;
          PaidDuration := FieldByName('PaidDuration').AsInteger;
          CurrentTime := TodaysTime;

          TotalMinutes := NoofO * PaidDuration;

          MyDateTime := StrToTime(CurrentTime);

          MyDateTime := StrToTime(CurrentTime) + ((1 / 24 / 60) * TotalMinutes);

          QueueTime := TimeToStr(MyDateTime);
          Result := QueueTime;
     end;
     QryTime.Free;
end;

