procedure TForm_NewPatient_BIRHOS.BB_ReprintCardClick(Sender: TObject);
Var CheckBox : TCheckBox;
begin
     gb_isDotMatrix := false;
     //if gs_ISRegCardPrint='Y' then
     //PrintCard;
     if gs_RegistrationType='MODIFYDATA' then
     Begin
          CheckBox:=TCheckBox.Create(nil);
          CheckBox.Checked:=True;
          if gs_IsOPDStickerGenerate='Y' then
          printOPSticker(CheckBox,gs_FirstTimeVisitDate);
          CheckBox.Free;
     End
     Else
     Begin
          if gs_IsOPDStickerGenerate='Y' then
          printOPSticker(CB_Preview,gs_FirstTimeVisitDate);
     End;
end;

procedure TForm_NewPatient_BIRHOS.BB_SaveClick(Sender: TObject);
Var
     mymemo: TMemo;
     Li_PatientID: Integer;
begin
     // OffCamera;
     Gb_isServiceBill := true;
     Gb_SuccessfullySaved := false;

     if gs_RegistrationType<>'FOLLOWUP' then
     Begin
          if not FormValidated then
          Exit;
     End;

     if gs_RegistrationType<>'MODIFYDATA' then
     Begin
          //if Frame_OpdVisit <> Nil then
          begin
               if CB_PayType.Text = 'CREDIT' then
               begin
                    if (DBLCB_Scheme.Text = '') then
                    begin
                         MessageDlg('Please choose Scheme', mtConfirmation, [mbok], 0);
                         exit;
                    end;
               end;
          end;
     End;

     if gs_RegistrationType='FOLLOWUP' then
     Begin
          if Trim(Edit_HospitalNo.Text)='' then
          Begin
               MessageDlg('Hospital No is Compulsory.', mtConfirmation, [mbok], 0);
               exit;
          End;

          if StrToInt(Edit_HospitalNo.Text)<>pi_PatientId then
          begin
