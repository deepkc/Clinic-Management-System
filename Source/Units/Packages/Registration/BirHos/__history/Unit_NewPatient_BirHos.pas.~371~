{ For The Case Of Doctor Fraction }
     Function GetOPDFraction: Double;
     Begin
          With QueryBlank do
          Begin
               { First Identify Department Specific Fraction Setup }
               Close;
               DatabaseName := gs_DatabaseName;
               SQL.Clear;
               SQL.Add(' Select FRAC_FractionAmount,FRAC_FractionRate,FRAC_FractionId,FRAC_IsRateAmt From HS_FRAC_Fraction ');
               SQL.Add(' where FRAC_FractionType=1 and FRAC_DepId='+intToStr(pi_DepId));
               Open;

               if QueryBlank.FieldByName('FRAC_FractionId').AsInteger <=0 then
               Begin
                    Close;
                    DatabaseName := gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Select FRAC_FractionAmount,FRAC_FractionRate,FRAC_FractionId,FRAC_IsRateAmt From HS_FRAC_Fraction ');

                    if ps_IsErPatient='N' then // Emergency
                    Begin
                         if ps_DocShareGroup='A' then
                         SQL.Add(' where FRAC_Description=''OPD REGISTRATION''')
                         Else
                         SQL.Add(' where FRAC_Description=''OPD REGISTRATION GROUP B''');
                    End
                    Else
                    Begin
                         if pb_IsEmrDutyDoctor=True then
                         SQL.Add(' where FRAC_Description=''EMR DUTY DOCTOR''')
                         Else
                         SQL.Add(' where FRAC_Description=''EMR CONSULTANT''');
                    End;
                    SQL.Add(' and FRAC_FractionType=1');
                    Open;
               End;

               pi_FractionId := FieldByName('FRAC_FractionId').AsInteger;
               IF FieldByName('FRAC_IsRateAmt').AsString = 'A' Then
               Begin
                    Try
                         pf_FractionRate := RoundingAfterSecondPlace((FieldByName('FRAC_FractionAmount').AsFloat / pf_DocVisitCharge) * 100);
                    Except
                         pf_FractionRate := 0;
                    End;
                    Result := FieldByName('FRAC_FractionAmount').AsFloat;
               End
               Else
               Begin
                    pf_FractionRate := FieldByName('FRAC_FractionRate').AsFloat;
                    Result := RoundingAfterSecondPlace((pf_DocVisitCharge * FieldByName('FRAC_FractionRate').AsFloat) / 100);
               End;
          End;
     End;

Begin
     { SaveFractiondetail(PATIENTID,INPATIENTID,BILLDETAILID,SERVICEBILLDETAILID,FRACTIONID,POSITIONWISEFRACTIONID,DEPID,DATAPOSTBY : Integer;
          UNITTESTCOST,QTY,FRACTIONAMOUNT,FRACTIONRATE,DISPER:Double;
          DOCCODE,TESTNAMECODE,BILLNO,BILLDATE,BILLTYPE,PAYTYPE,ISFRACTIONPROPWITHDISPER,DESCRIPTION,ISADDLUMPSUM,
          ISCHARGEDIVIDE,REMARKS,DATAPOSTDATE,DATAPOSTTIME :String); }


     if ps_IsErPatient = 'N' then // 2 -Emergency
     begin
          pb_MutualDocForShare := False;
          Mutually_Share_Fraction(pi_DocId, 'OPD');

          if pb_MutualDocForShare = False then
          Begin
               (* SaveFractiondetail(PATIENTID,INPATIENTID,BILLDETAILID,SERVICEBILLDETAILID,DEPID,DOCID,TESTNAMEID,FRACTIONID,POSITIONWISEFRACTIONID,DATAPOSTBY : Integer;
                    UNITTESTCOST,QTY,FRACTIONAMOUNT,FRACTIONRATE,DISPER:Double;
                    TESTNAMECODE,BILLNO,BILLDATE,BILLTYPE,PAYTYPE,ISFRACTIONPROPWITHDISPER,DESCRIPTION,ISADDLUMPSUM,
                    ISCHARGEDIVIDE,REMARKS,DATAPOSTDATE,DATAPOSTTIME :String); *)
               Try
                    SaveFractiondetail(gi_patientid, 0, pi_RefBillDetailID, 0, pi_DepId,pi_DocId, 0, pi_FractionId, 0, gi_UserID,0, pf_DocVisitCharge,
                         pf_DocVisitCharge, 1, GetOPDFraction, pf_FractionRate, pf_DisPer,'REG', Gs_BillNo, ps_TodaysDate, 'R', ps_PayType, 'Y', '',
                         'N', 'N','', ps_TodaysDate, ps_TodaysTime,'N');


               Except
                    SaveFractiondetail(gi_patientid, 0, pi_RefBillDetailID, 0, pi_DepId,pi_DocId, 0, pi_FractionId, 0, gi_UserID,0, pf_DocVisitCharge,
                         pf_DocVisitCharge, 1, GetOPDFraction, pf_FractionRate, pf_DisPer,'REG', Gs_BillNo, ps_TodaysDate, 'R', ps_PayType, 'Y', '',
                         'N', 'N','', ps_TodaysDate, ps_TodaysTime,'N');
               End;
          end
          else
          begin
               Query_MutualDocForShare.First;
               While not Query_MutualDocForShare.Eof do
               begin
                    IF Query_MutualDocForShare.FieldByName('DocRate').AsFloat > 0 Then
                    Begin
                         Try
                              SaveFractiondetail(gi_patientid, 0, pi_RefBillDetailID, 0, pi_DepId,pi_DocId, 0, pi_FractionId, 0, gi_UserID,0, pf_DocVisitCharge,
                                   pf_DocVisitCharge, 1,GetOPDFraction * Query_MutualDocForShare.FieldByName('DocRate').AsFloat / 100,
                                   pf_FractionRate * Query_MutualDocForShare.FieldByName('DocRate').AsFloat / 100, pf_DisPer, 'REG', Gs_BillNo, ps_TodaysDate,
                                   'R', ps_PayType, 'Y', '', 'N', 'N', '', ps_TodaysDate,ps_TodaysTime,'N');

                         Except
                              SaveFractiondetail(gi_patientid, 0, pi_RefBillDetailID, 0, pi_DepId,pi_DocId, 0, pi_FractionId, 0, gi_UserID,0, pf_DocVisitCharge,
                                   pf_DocVisitCharge, 1,GetOPDFraction * Query_MutualDocForShare.FieldByName('DocRate').AsFloat / 100,
                                   pf_FractionRate * Query_MutualDocForShare.FieldByName('DocRate').AsFloat / 100, pf_DisPer, 'REG', Gs_BillNo, ps_TodaysDate,
                                   'R', ps_PayType, 'Y', '', 'N', 'N', '', ps_TodaysDate,ps_TodaysTime,'N');
                         End;
                    End;
                    Query_MutualDocForShare.Next;
               end;
          end;
     End
     Else
     Begin
          pb_IsEmrDutyDoctor := True;
          Try
               SaveFractiondetail(gi_patientid, 0, pi_RefBillDetailID, 0, pi_DepId,pi_DocId, 0, pi_FractionId, 0, gi_UserID,0, pf_DocVisitCharge,
                    pf_DocVisitCharge, 1, GetOPDFraction, pf_FractionRate, pf_DisPer,'REG', Gs_BillNo, ps_TodaysDate, 'R', ps_PayType, 'Y', '',
                    'N', 'N','', ps_TodaysDate, ps_TodaysTime,'N');
          Except
               SaveFractiondetail(gi_patientid, 0, pi_RefBillDetailID, 0, pi_DepId,pi_DocId, 0, pi_FractionId, 0, gi_UserID,0, pf_DocVisitCharge,
                    pf_DocVisitCharge, 1, GetOPDFraction, pf_FractionRate, pf_DisPer,'REG', Gs_BillNo, ps_TodaysDate, 'R', ps_PayType, 'Y', '',
                    'N', 'N','', ps_TodaysDate, ps_TodaysTime,'N');
          End;

          pb_IsEmrDutyDoctor := False; // 117 - HOS01 - Hospital
          (* SaveFractiondetail(gi_PatientId,0,gi_BillDetailId,0,pi_FractionId,0,pi_DepId,gi_UserId,
               pf_DoctorCharge,1,GetOPDFraction,pf_FractionRate, pf_disper,
               ps_DocCode,'REG',Gs_BillNo,ps_TodaysDate,'R',ps_PayType,'Y','','N','N','',ps_TodaysDate,ps_TodaysTime); *)
     End;
End;

Procedure TForm_NewPatient_BIRHOS.Mutually_Share_Fraction(DOCID: Integer; ServiceType: string);
begin
  With Query_MutualDocForShare do
  begin
    Close;
    SQL.Clear;
    SQL.Add(' select DSBD_DOCSHAREBREAKDOWNID,DSBD_DOCID DOCID,DSBD_DOCRATE DOCRATE,DSBD_ISREFCHRGDIVIDE ISREFCHRGDIVIDE');
    SQL.Add(' From HS_DSBD_DOCSHAREBREAKDOWN where DSBD_DOCSHAREBREAKDOWNID=(select DSBD_DOCSHAREBREAKDOWNID From HS_DSBD_DOCSHAREBREAKDOWN ');
    SQL.Add(' Where DSBD_DOCID=' + IntToStr(DOCID)
        + ' and DSBD_SERVICETYPE=' + #39 + ServiceType + #39 + ')');
    SQL.Add(' and DSBD_SERVICETYPE=' + #39 + ServiceType + #39 +
        ' Order by DSBD_DOCRATE Desc');
    Open;
  end;

  IF Query_MutualDocForShare.FieldByName('DSBD_DOCSHAREBREAKDOWNID')
    .AsInteger >= 1 Then
    pb_MutualDocForShare := True
  else
    pb_MutualDocForShare := False;
end;

