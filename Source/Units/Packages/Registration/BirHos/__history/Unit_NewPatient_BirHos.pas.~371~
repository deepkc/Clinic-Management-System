procedure TForm_NewPatient_BIRHOS.PatientLastVisitInfo;
var
     Qry_LastVisitInfo: TQuery;
     DEX_TodayDate,DEX_LastDate : TDateEditX;
begin
     DEX_TodayDate:=TDateEditX.Create(nil);
     DEX_TodayDate.SystemOfDate:=gi_DateSystem;
     DEX_TodayDate.Text :=ServerDate.todaysDate;

     DEX_LastDate:=TDateEditX.Create(nil);
     DEX_LastDate.SystemOfDate:=gi_DateSystem;
     DEX_LastDate.Text :=DEX_TodayDate.Text;

     Qry_LastVisitInfo := TQuery.Create(nil);
     With Qry_LastVisitInfo do
     Begin
          Close;
          DatabaseName := gs_DatabaseName;
          SQL.Clear;
          SQL.Add(' Select R.*,BillDateNew as BillDate From(');
          SQL.Add(' Select PAVI_PatientID,PAVI_VisitDate,PAVI_DEPID,PAVI_DOCID,PAVI_PATIENTTYPECODE,PAVI_SchemeId,PAVI_CommunityId,PAVI_DIAGNOSIS,PAVI_EMERTYPE,PAVI_EMERCASE,');
          SQL.Add(' NVL((Select Max(BIDE_BILLDATE) From HS_BIDE_BILLDETAIL Where BIDE_PATIENTID=PV.PAVI_PatientID and BIDE_BILLTYPE=''R''),''2014/01/01'') As BillDATENEW,');
          //SQL.Add(' (Select max(BillDate) From BillDetail where PatientId=PV.PAVI_PatientId and BillType=''O'') as BillDateOLD,');
          SQL.Add(' (Select Count(PAVI_PATIENTVISITID) From HS_PAVI_PATIENTVISIT Where PAVI_PatientID=PV.PAVI_PatientID and PAVI_ISVISITCANCEL=''N'') As NoOfVisit');
          SQL.Add(' From HS_PAVI_PATIENTVISIT PV Where PAVI_PATIENTVISITID In (Select Max(PAVI_PATIENTVISITID) From HS_PAVI_PATIENTVISIT');
          SQL.Add(' Where PAVI_PATIENTID='+IntToStr(gi_PatientId)+' and PAVI_ISVISITCANCEL=''N'')) R');
          Open;
     End;

     if Trim(Qry_LastVisitInfo.FieldByName('PAVI_VisitDate').AsString)<>'' then
     Begin
          DEX_LastDate.Text:=Qry_LastVisitInfo.FieldByName('PAVI_VisitDate').AsString;
          LabelLastVisitDate.Caption:=Qry_LastVisitInfo.FieldByName('PAVI_VisitDate').AsString;
          LabelVisitGapDays.Caption:=IntToStr((DEX_TodayDate.VSDateAsDays- DEX_LastDate.VSDateAsDays)+1);
     End
     else
     begin
          LabelLastVisitDate.Caption:='-';
          LabelVisitGapDays.Caption:='-';
     end;

     LabelPaymentGapDays.Caption:=FloatToStr(GetNumberOfVisitDaysAnyDepatment(gi_PatientId,Qry_LastVisitInfo.FieldByName('PAVI_DEPID').AsInteger));
     LabelLastBillDate.Caption:=gs_LastBillDate;

     LabelVisitno.Caption:=IntToStr(Qry_LastVisitInfo.FieldByName('NoOfVisit').AsInteger);
     gi_NoOfVisit:=Qry_LastVisitInfo.FieldByName('NoOfVisit').AsInteger;

     if (Qry_LastVisitInfo.FieldByName('NoOfVisit').AsInteger=1) and (Qry_LastVisitInfo.FieldByName('PAVI_VisitDate').AsString=TodaysDate) then
     Begin
          gs_FollowUpStatus:='NEWPATIENT';
          gb_IsBlinkingContinue:=True;
          Timer_DisplayChargeInfo.Enabled:=True;
          Label_Charge.Caption:='Today’s new patient';
          gs_BlinkingCaption:='Today’s new patient';
          gs_LastVisitDate:=Qry_LastVisitInfo.FieldByName('PAVI_VisitDate').AsString;
     End
     Else if (Qry_LastVisitInfo.FieldByName('NoOfVisit').AsInteger > 1) and (Qry_LastVisitInfo.FieldByName('PAVI_VisitDate').AsString=TodaysDate) then
     Begin
          gs_FollowUpStatus:='FOLLOWUPPATIENT';
          gb_IsBlinkingContinue:=True;
          Timer_DisplayChargeInfo.Enabled:=True;
          Label_Charge.Caption:='Today’s follow up';
          gs_BlinkingCaption:='Today’s follow up';
          gs_LastVisitDate:=Qry_LastVisitInfo.FieldByName('PAVI_VisitDate').AsString;
     End
     Else
     Begin
          Label_Charge.Caption:='';
          gb_IsBlinkingContinue:=True;
          Timer_DisplayChargeInfo.Enabled:=True;
          gs_FollowUpStatus:='';
          gs_BlinkingCaption:='';
          gs_LastVisitDate:='';
     End;

     DBLCB_Department.KeyValue:=Qry_LastVisitInfo.FieldByName('PAVI_DEPID').Asinteger;
     le_Diagnosis.Text := Qry_LastVisitInfo.FieldByName('PAVI_DIAGNOSIS').AsString;
     CB_EMERTYPE.ItemIndex := CB_EMERTYPE.Items.IndexOf(Qry_LastVisitInfo.FieldByName('PAVI_EMERTYPE').AsString);
     Query_EmerCase.Close;
     Query_EmerCase.Open;
     DBLCB_EMERCASE.KeyValue :=  Qry_LastVisitInfo.FieldByName('PAVI_EMERCASE').AsString;
     //gi_DepartmentId:=GetIdFromTable('HS_DEPT_Department','DEPT_DepCode','DEPT_DepId',Qry_LastVisitInfo.FieldByName('PAVI_DEPCODE').AsString);

     if (Qry_LastVisitInfo.FieldByName('PAVI_DEPID').AsInteger=2) and (Trim(Gs_MemberNo)<>'') then
     Begin
          Query_DutyDoctor.Close;
          Query_DutyDoctor.Open;
          gb_IsBlinkingContinue:=False;
     End
     Else
     Begin
          Query_DutyDoctor.Close;
          Query_DutyDoctor.Open;
          gb_IsBlinkingContinue:=True;
     End;


     DBLCB_Doctor.KeyValue:=Qry_LastVisitInfo.FieldByName('PAVI_DOCID').AsInteger;
     Query_Scheme.Close;
     Query_Scheme.Open;
     pi_CommunityId:=Qry_LastVisitInfo.FieldByName('PAVI_CommunityId').AsInteger;
