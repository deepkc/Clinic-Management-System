          End;

          ps_DUTYDOCCODE:= 'HOS01';

          ps_PATIENTFROM:=CB_PatientFrom.Text;
          IF CB_PatientFrom.Text='OPD' then
          Begin
               IF Trim(CmbRefferedBy.Text)<>'' Then
               ps_RefDepCode:=Query_RefByDocHos.FieldByName('DepCode').AsString
               else
               ps_RefDepCode:='';
               pi_REFHOSID:=0;
          end
          else
          Begin
               IF Trim(CmbRefferedBy.Text)<>'' Then
               pi_REFHOSID := CmbRefferedBy.KeyValue
               else
               pi_REFHOSID := 0;
               ps_RefDepCode:='';
          end;

          ps_RefDocCode:= '';
          ps_patientcategory:=CB_Patientcategory.Text;
          IF (ps_DEPCODE='EME01') Then
          Begin
               ps_IsErPatient:='Y';
               IF pi_SchemeID=22 Then // 22 - Medicare
               ps_EmergencyNo:=GetNextEmergencyNo
               else
               ps_EmergencyNo:='';
          End
          else
          Begin
               ps_IsErPatient:='N';
               ps_EmergencyNo:='';
          End;

          (*if Query_Department.FieldByName('DepType').AsString='E' then // E - Emerergency
          Begin
          //gi_EmergencyNo:=GetMaxEmergencyNo;
          gi_EmergencyNo:=0;
          ps_IsErPatient:='Y';
          End
          Else
          Begin
          gi_EmergencyNo:=0;
          ps_IsErPatient:='N';
          End;*)

