unit Unit_QrOpSticker_DeptDoc;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  fxn,dbtables,Dialogs, QuickRpt, ExtCtrls, QRCtrls, qrBarcode,ServerDate;

type
  TForm_OPSticker = class(TForm)
    QrOPSticker: TQuickRep;
    PageHeaderBand1: TQRBand;
    lbl_PatientName: TQRLabel;
    DetailBand1: TQRBand;
    QRLabel1: TQRLabel;
    QRLabel2: TQRLabel;
    lbl_hosno: TQRLabel;
    QRLabel4: TQRLabel;
    QRLabel5: TQRLabel;
    lbl_AgeGender: TQRLabel;
    QRLabel7: TQRLabel;
    QRLabel8: TQRLabel;
    QRLabel9: TQRLabel;
    QRLabel10: TQRLabel;
    lbl_Address: TQRLabel;
    lbl_PhoneNo: TQRLabel;
    QRLabel19: TQRLabel;
    QRLabel20: TQRLabel;
    QRLabel3: TQRLabel;
    QRLabel6: TQRLabel;
    lbl_datetime: TQRLabel;
    lbl_username: TQRLabel;
    lbl_dept: TQRLabel;
    QRLabel_QueueNo: TQRLabel;
    QRLBL_QueueCap: TQRLabel;
    QRLabel_ChargeAmt: TQRLabel;
    QRLabel_Time: TQRLabel;
    QRLabel11: TQRLabel;
    QRLabel12: TQRLabel;
    QrBarcode: TQRAsBarcode;
    QRLabel_CRNOCap: TQRLabel;
    QRLabel_CRNoColon: TQRLabel;
    QRLabel_CRNo: TQRLabel;
    QRLabel_2ndDocName: TQRLabel;
    procedure FormCreate(Sender: TObject);
    function GetRegVisitAmount(VisitDate,VisitTime : string):Double;
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  Form_OPSticker: TForm_OPSticker;

implementation

{$R *.dfm}

procedure TForm_OPSticker.FormCreate(Sender: TObject);
Var
     Qry:Tquery;
     lf_RegCharge : Double;
     ls_Address,ls_FirstDepartment, ls_DocName:String;
begin
     SetPrinter('STICKERPRINTER');
     Qry:=TQuery.Create(Nil);
     with Qry do
     begin
          Close;
          DatabaseName:=gs_DatabaseName;
          SQL.Clear;
          if gi_VisitID > 0 then
          begin
               SQL.Add(' Select PAVI_DepId,(Select DEPT_DepName From HS_DEPT_Department where DEPT_DepId=PAVI_DepId) as DepName,');
               SQL.Add(' PAVI_DocId,(Select DOCT_DocName From HS_DOCT_Doctor where DOCT_DocId=PAVI_DocId) as DocName');
               SQL.Add(' From HS_PAVI_PatientVisit where PAVI_PatientId='+IntToStr(gi_PatientID)+' and PAVI_PatientVisitId='+IntToStr(gi_VisitID)+' and PAVI_IsVisitCancel=''N''');
          end
          Else
          Begin
               SQL.Add(' Select DEPT_DepName From HS_Dept_Department where DEPT_DepID,'''' as DocName In (');
               SQL.Add(' Select PAVI_DepID From HS_PAVI_PatientVisit where PAVI_PatientVisitID In (Select Min(PAVI_PatientVisitID) From');
               SQL.Add(' HS_PAVI_PatientVisit where PAVI_PatientId='+IntToStr(gi_PatientID)+' and NVL(PAVI_DepID,0) > 0 and PAVI_IsVisitCancel=''N''))');
          End;
          Open;

          ls_FirstDepartment:=Qry.FieldByName('DepName').AsString;
          ls_DocName:=Qry.FieldByName('DocName').AsString;

          Close;
          DatabaseName:=gs_DatabaseName;
          SQL.Clear;
          SQL.Add(' Select * from VW_HS_PATIENTMAIN');
          SQL.Add(' Where PatientID='+IntToStr(gi_PatientID));
          Open;
          lbl_hosno.Caption:=IntToStr(gi_PatientID);
          QRLabel4.Caption:=Gs_HosNoCaptionName;
          QrBarcode.Text:=IntToStr(gi_PatientID);

          if FieldByName('FileNo').AsInteger > 0 then
          Begin
               QRLabel_CRNOCap.Caption:='CR No.';
               QRLabel_CRNoColon.Caption:=':';
               QRLabel_CRNo.Caption:=IntToStr(FieldByName('FileNo').AsInteger);
          End
          Else
          Begin
               QRLabel_CRNOCap.Caption:='';
               QRLabel_CRNoColon.Caption:='';
               QRLabel_CRNo.Caption:='';
          End;


          QRLabel_2ndDocName.Caption:='';
          if gs_IsDocCompForRegFollowup='Y' then
          Begin
               if gi_HospitalID=563 then // 563- Nepal Cancer Hospital
               Begin
                    if FieldByName('DocId').AsInteger=2 then //2 - Sudeep Shrestha
                    Begin
                         lbl_dept.Caption:=FieldByName('DENAME').AsString+' / '+FieldByName('Docname').AsString+' / ';
                         QRLabel_2ndDocName.Caption:=GetDocName(39);//39 - Sachin Shakya
                         QRLabel4.Top:=53;
                         QRLabel5.Top:=52;
                         lbl_hosno.Top:=51;
                         QRLabel_CRNOCap.Top:=53;
                         QRLabel_CRNoColon.Top:=53;
                         QRLabel_CRNo.Top:=51;
                    End
                    Else
                    Begin
                         lbl_dept.Caption:=FieldByName('DENAME').AsString+' / '+FieldByName('Docname').AsString;
                         QRLabel4.Top:=48;
                         QRLabel5.Top:=47;
                         lbl_hosno.Top:=46;
                         QRLabel_CRNOCap.Top:=48;
                         QRLabel_CRNoColon.Top:=48;
                         QRLabel_CRNo.Top:=46;
                    End;
               End
               Else
               //lbl_dept.Caption:=Qry.FieldByName('DENAME').AsString+' / '+Qry.FieldByName('Docname').AsString;
               lbl_dept.Caption:=ls_FirstDepartment+' / '+ls_DocName;
          End
          else
          Begin
               lbl_dept.Caption:=ls_FirstDepartment;//FieldByName('DENAME').AsString;
          End;

          lbl_datetime.Caption:=FieldByName('VisitDate').AsString;
          QRLabel_Time.Caption:=copy(FieldByName('VisitTime').AsString,0,5);

          lbl_PatientName.Caption:=FieldByName('Title').AsString+' '+FieldByName('PATIENTNAME').AsString;
          lbl_AgeGender.Caption:=FieldByName('CURRENTAGE').AsString+'/'+Copy(FieldByName('Gender').AsString,1,1);

          if Trim(FieldByName('DistrictName').AsString)<>'' then
          ls_Address:=FieldByName('DistrictName').AsString;

          if Trim(FieldByName('VdcName').AsString)<>'' then
          Begin
               if Trim(ls_Address)<>'' then
               ls_Address:=ls_Address+','+FieldByName('VdcName').AsString
               Else
               ls_Address:=FieldByName('DistrictName').AsString;
          End;

          if Trim(FieldByName('WardNo').AsString)<>'' then
          Begin
               if Trim(ls_Address)<>'' then
               ls_Address:=ls_Address+'-'+FieldByName('WardNo').AsString
               Else
               ls_Address:=FieldByName('WardNo').AsString;
          End;

          if Trim(FieldByName('Address').AsString)<>'' then
          Begin
               if Trim(ls_Address)<>'' then
               ls_Address:=ls_Address+','+FieldByName('Address').AsString
               Else
               ls_Address:=FieldByName('Address').AsString;
          End;



          lbl_Address.Caption:=ls_Address;
          if (FieldByName('MOBILENO').AsString<>'') and (FieldByName('phoneNO').AsString<>'') then
          lbl_PhoneNo.Caption:=FieldByName('MOBILENO').AsString+','+FieldByName('phoneNO').AsString
          else if  FieldByName('MOBILENO').AsString<>'' then
          lbl_PhoneNo.Caption:=FieldByName('MOBILENO').AsString
          else if  FieldByName('phoneNO').AsString<>'' then
          lbl_PhoneNo.Caption:=FieldByName('phoneNO').AsString
          Else
          lbl_PhoneNo.Caption:='NA';

          QRLabel_QueueNo.Enabled:=False;
          QRLBL_QueueCap.Enabled:=False;
          if gs_ISQUEUENOINREG='Y' then
          Begin
               QRLabel_QueueNo.Enabled:=True;
               QRLBL_QueueCap.Enabled:=True;
               if (FieldByName('DEPWISEQUEUENO').AsInteger=0) and (FieldByName('DOCWISEQUEUENO').AsInteger=0)  then
               QRLabel_QueueNo.Caption:='NA'
               else if FieldByName('DEPWISEQUEUENO').AsInteger>0 then
               QRLabel_QueueNo.Caption:=IntToStr(FieldByName('DEPWISEQUEUENO').AsInteger)
               else if FieldByName('DOCWISEQUEUENO').AsInteger>0 then
               QRLabel_QueueNo.Caption:=IntToStr(FieldByName('DOCWISEQUEUENO').AsInteger);
          End;

          IF gs_IsAmtShowInRegSticker='Y' Then
          Begin
               QRLabel_ChargeAmt.Enabled:=True;
               lf_RegCharge:=GetRegVisitAmount(FieldByName('VisitDate').AsString,FieldByName('VisitTime').AsString);
               if lf_RegCharge > 0 then
               QRLabel_ChargeAmt.Caption:='Reg Charge (Rs) : '+FormatFloat('0.00',lf_RegCharge)
               else
               QRLabel_ChargeAmt.Enabled:=False;
          End
          else
          Begin
               QRLabel_ChargeAmt.Enabled:=False;
          End;


          lbl_username.Caption:=FieldByName('username').AsString;
     end;
     Qry.Free;
end;

function TForm_OPSticker.GetRegVisitAmount(VisitDate,VisitTime : string):Double;
Var
     Qry:Tquery;
begin
     Qry:=TQuery.Create(Nil);
     with Qry do
     begin
          Close;
          DatabaseName:=gs_DatabaseName;
          SQL.Clear;
          SQL.Add(' Select Sum((BIDE_Amount+BIDE_VatAmt)-(BIDE_Amount*BIDE_DisPer/100)) NetRegCharge From HS_BIDE_BILLDETAIL');
          SQL.Add(' Where BIDE_PatientID='+IntToStr(gi_PatientID));
          SQL.Add(' and BIDE_BillDate='+#39+VisitDate+#39+' and BIDE_BillTime='+#39+VisitTime+#39);
          Open;
     end;
     Result:=Qry.FieldByName('NetRegCharge').AsFloat;
     Qry.Free;
end;


end.
