procedure TFrame_OPDVisit.CB_BlueBookChrgClick(Sender: TObject);
Var DEX_DOB, DEX_CurrDate : TDateEditX;
begin
     IF CB_BlueBookChrg.Checked=True Then
     Begin
          if (gs_RegistrationType='FOLLOWUP') and (gi_PatientID <= 0) then
          begin
               MessageDlg('Please Choose the Patient Below 2 Yrs for Blue Book Card.',mtWarning,[mbok],0);
               Exit;
          end;

          if (gs_RegistrationType='NEW') then
          begin
               Exit;
          end;

          DEX_DOB :=TDateEditX.Create(Nil);
          DEX_DOB.SystemOfDate:=gi_datesystem;

          DEX_CurrDate :=TDateEditX.Create(Nil);
          DEX_CurrDate.SystemOfDate:=gi_datesystem;

          With Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select PAMA_DOBAD DOBAD,PAMA_DOBVS DOBBS From HS_PAMA_PatientMain where PAMA_PatientId='+IntToStr(gi_PatientID));
               Open;
          End;

          if gi_datesystem=1 then
          DEX_DOB.Text:=Query_Process.FieldByName('DOBAD').AsString
          else
          DEX_DOB.Text:=Query_Process.FieldByName('DOBBS').AsString;


          IF (DEX_CurrDate.VSDateAsDays - DEX_DOB.VSDateAsDays) > 732 Then // For Blue Book Should be less than 2 yrs
          Begin
               MessageDlg('This patient is greater than age 2 Yrs. So no provision of blue book card.',mtWarning,[mbok],0);
               CB_BlueBookChrg.Checked:=False;
               DEX_CurrDate.Free;
               DEX_DOB.Free;
               Exit;
          End;
          DEX_CurrDate.Free;
          DEX_DOB.Free;
     End;
     DBLCB_DepartmentClick(Sender);
end;

