function TFrame_OPDVisit.OPDVisitAccountValidation: Boolean;
begin
     if DBLCB_Department.KeyValue = NULL then
     Begin
          MessageDlg('You Must Have To Choose Visit Department.', mtWarning, [mbok], 0);
          DBLCB_Department.SetFocus;
          Result := false;
          exit;
     End;

     if DBLCB_Doctor.KeyValue = NULL then
     Begin
          MessageDlg('You Must Have To Choose Visit Doctor.', mtWarning, [mbok], 0);
          DBLCB_Doctor.SetFocus;
          Result := false;
          exit;
     End;

     pi_DEPID := DBLCB_Department.KeyValue;
     pi_SUBDEPID := 0;

     if DBLCB_Doctor.KeyValue <> NULL then
     pi_DOCID := DBLCB_Doctor.KeyValue
     Else
     pi_DOCID := 0;

     if DBLCB_DutyDoctor.KeyValue <> NULL then
     pi_DUTYDOCID := DBLCB_DutyDoctor.KeyValue
     Else
     pi_DUTYDOCID := 0;

     ps_PATIENTFROM:=CB_PatientFrom.Text;
     IF CB_PatientFrom.Text='OPD' then
     Begin
          IF Trim(CmbRefferedBy.Text)<>'' Then
          pi_RefDepId:=Query_RefByDocHos.FieldByName('DepID').AsInteger
          else
          pi_RefDepId:=0;
          pi_REFHOSID:=0;
     end
     else
     Begin
          IF Trim(CmbRefferedBy.Text)<>'' Then
          pi_REFHOSID := CmbRefferedBy.KeyValue
          else
          pi_REFHOSID := 0;
          pi_RefDepId:=0;
     end;

     if Trim(DBLCB_Scheme.Text)<>'' then
     Begin
          pi_SCHEMEID := DBLCB_Scheme.KeyValue;
          pi_COMMUNITYID := Query_Scheme.FieldByName('CommunityId').AsInteger;
     End
     Else
     Begin
          pi_SCHEMEID := 0;
          pi_COMMUNITYID := 0;
     End;

     ps_APPOINTMENTTIME := '';

     if gs_RegistrationType = 'NEW' Then
     Begin
          ps_VISITTYPE := 'REG';
          ps_VISITSTATUS := 'N';
     End
     Else
     Begin
          ps_VISITTYPE := 'RE-VISIT';
          ps_VISITSTATUS := 'V';
     End;

     ps_PATIENTTYPE := '';
     ps_BILLINGSTATUS := '';
     ps_VISITTYPE := '';
     ps_CHECKUPSTATUS := '';
     ps_REMARKS := '';

     if CB_PayType.ItemIndex in [0] then
     Begin
          ps_INITIAL := 'CS';
          ps_PayType := 'CASH';
     End
     else
     Begin
          ps_INITIAL := 'CR';
          ps_PayType := 'CREDIT';
     End;
     Result := true;
end;

procedure TFrame_OPDVisit.RefreshOPDVisit;
var Sender :Tobject;
begin
     if gi_DepartmentId > 0 then
     begin
          Query_Department.Close;
          Query_Department.Open;
          DBLCB_Department.KeyValue := gi_DepartmentId;
          DBLCB_DepartmentClick(self);
     end
     else
     begin
          Query_Department.close;
          //Query_Department.sql[2] := 'and 1=1';
          Query_Department.Open;
     end;

     if gi_DoctorId > 0 then
     begin
//          Query_Doctor.close;
//          Query_Doctor.sql[1] := 'where Docid=' + IntToStr(gi_DoctorId);
//          Query_Doctor.Open;
          DBLCB_Doctor.KeyValue := gi_DoctorId;
     end
     else
     begin
          Query_Doctor.close;
          //Query_Doctor.sql[1] := 'where 1=1';
          Query_Doctor.Open;
     end;

     Query_RefByDocHos.close;
     Query_RefByDocHos.Open;

     Query_Community.close;
     Query_Community.Open;

     Query_Scheme.close;
     Query_Scheme.Open;

     Query_PatientType.Close;
     Query_PatientType.Open;

     Query_BlueBookCharge.Close;
     Query_BlueBookCharge.Open;

     Query_OPDCardCharge.Close;
     Query_OPDCardCharge.Open;

     QryRefByType.Close;
     QryRefByType.Open;

     Query_RefDep.Close;
     Query_RefDep.Open;

     Query_RefDoc.Close;
     Query_RefDoc.Open;

     Query_HosName.Close;
     Query_HosName.Open;


     (*if gs_ISOPDBOOKCHARGE='Y' then
     CB_CardCharge.Checked:=True
     else
     CB_CardCharge.Checked:=False;*)

     if gs_RegistrationType='FOLLOWUP' then
     Begin
          if gs_HospitalNameForCode='BNB' then
          CB_CardCharge.Checked:=True
          Else
          CB_CardCharge.Checked:=False;
          //CB_ForceFollowup.Visible:=True;
          CB_ForceFollowup.Checked:=False;
          if gs_CalledFrom='SpecialOPDRegistration' then
          Begin
               gs_PatientTypeCode:='SPC';
               //DBLCB_PatientType.Enabled:=False;
          End
          Else if gs_CalledFrom='EmergencyRegistration' then
          begin
               gs_PatientTypeCode:='GEN';
          end
          else if gs_PatientTypeCode='' then
          gs_PatientTypeCode:='GEN';

          DBLCB_PatientType.KeyValue:=gs_PatientTypeCode;
          DBLCB_PatientTypeClick(Self);
          CB_IsReferal.Visible:=True;

     End
     Else
     Begin
          CB_ForceFollowup.Visible:=False;
          CB_ForceFollowup.Checked:=False;

          if gs_RegistrationType='NEW' then
          CB_CardCharge.Checked:=True;

          if gs_CalledFrom='SpecialOPDRegistration' then
          Begin
               DBLCB_PatientType.KeyValue:=Query_PatientType.FieldByName('PATY_PATIENTTYPECODE').AsString;
               gs_PatientTypeCode:=Query_PatientType.FieldByName('PATY_PATIENTTYPECODE').AsString;
          End
          Else
          Begin
               DBLCB_PatientType.KeyValue:='GEN';
               gs_PatientTypeCode:='GEN';
          End;
          DBLCB_PatientTypeClick(Self);
          CB_IsReferal.Visible:=False;
     End;

     if gs_CalledFrom='RegisteredFromFrontDesk' then
     Begin
          GroupBox14.Enabled:=False;
          GroupBox14.Visible:=False;

          GroupBox16.Enabled:=False;
          GroupBox16.Visible:=False;

          ps_IsRegisteredFromFrontDesk:='Y';
     End
     Else if gs_CalledFrom='SpecialOPDRegistration' then
     Begin
          DBLCB_PatientType.KeyValue:='SPC';
          //DBLCB_PatientType.Enabled:=False;
     End
     Else
     Begin
          GroupBox14.Enabled:=True;
          GroupBox14.Visible:=True;

          GroupBox16.Enabled:=True;
          GroupBox16.Visible:=True;
          ps_IsRegisteredFromFrontDesk:='N';
     End;

     if gs_CalledFrom='EmergencyRegistration' then
     begin
          DBLCB_Department.KeyValue:=85;//emergency dep
          DBLCB_Department.Enabled := False;
          CB_ChargeFree.Checked := True;
          CB_ChargeFree.Enabled := False;
          DBLCB_Doctor.KeyValue :=108;
          DBLCB_Doctor.Enabled := False;
          DBLCB_DepartmentClick(Sender);
     end;

end;

