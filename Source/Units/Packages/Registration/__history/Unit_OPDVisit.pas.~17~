procedure TFrame_OPDVisit.RegReVisitPriceDetermination;
Var li_DocId,li_DepId : Integer;
Begin
     if Trim(DBLCB_Doctor.Text)<>'' then
     li_DocId:=DBLCB_Doctor.KeyValue
     Else
     li_DocId:=0;

     if Trim(DBLCB_Department.Text)<>'' then
     li_DepId:=DBLCB_Department.KeyValue
     Else
     li_DepId:=0;


     if (IsDoctorWiseRegPrice(li_DocId,li_DepId,Edit_Time.Text)=False)
     or (li_DocId = 0) or (gs_IsTimeWiseDoctorCharge='N') then
     Begin
          if UpperCase(gs_RegistrationType) = 'NEW' then
          Begin
               if gs_PatientTypeCode='PRM' then //
               Begin
                    pf_DocVisitCharge := Query_Department.FieldByName('NewRegCharge').AsFloat;
                    pf_DocVisitTax := Query_Department.FieldByName('NewRegSvrTax').AsFloat;
               End
               Else if gs_PatientTypeCode='GEN' then
               Begin
                    pf_DocVisitCharge := Query_Department.FieldByName('NewRegChargeGEN').AsFloat;
                    pf_DocVisitTax := Query_Department.FieldByName('NewRegSvrTaxGEN').AsFloat;
               End
               Else if gs_PatientTypeCode='PVT' then
               Begin
                    pf_DocVisitCharge := Query_Department.FieldByName('NewRegChargePVT').AsFloat;
                    pf_DocVisitTax := Query_Department.FieldByName('NewRegSvrTaxPVT').AsFloat;
               End
               Else if gs_PatientTypeCode='FRG' then
               Begin
                    pf_DocVisitCharge := Query_Department.FieldByName('NewRegChargeFRG').AsFloat;
                    pf_DocVisitTax := Query_Department.FieldByName('NewRegSvrTaxFRG').AsFloat;
               End
               Else
               Begin
                    pf_DocVisitCharge := Query_Department.FieldByName('NewRegCharge').AsFloat;
                    pf_DocVisitTax := Query_Department.FieldByName('NewRegSvrTax').AsFloat;
               End;

               pf_RegOPDCardcharge := Query_Department.FieldByName('RegistrationCharge').AsFloat;
               Pf_RegOPDCardTax := Query_Department.FieldByName('RegistrationChargeSvrTax').AsFloat;
          End
          Else
          Begin
               if gs_PatientTypeCode='PRM' then
               Begin
                    pf_DocVisitCharge := Query_Department.FieldByName('FollowupCharge').AsFloat;
                    pf_DocVisitTax := Query_Department.FieldByName('FollowupSvrTax').AsFloat;
               End
               Else if gs_PatientTypeCode='GEN' then
               Begin
                    pf_DocVisitCharge := Query_Department.FieldByName('FollowupChargeGEN').AsFloat;
                    pf_DocVisitTax := Query_Department.FieldByName('FollowupSvrTaxGEN').AsFloat;
               End
               Else if gs_PatientTypeCode='PVT' then
               Begin
                    pf_DocVisitCharge := Query_Department.FieldByName('FollowupChargePVT').AsFloat;
                    pf_DocVisitTax := Query_Department.FieldByName('FollowupSvrTaxPVT').AsFloat;
               End
               Else if gs_PatientTypeCode='FRG' then
               Begin
                    pf_DocVisitCharge := Query_Department.FieldByName('FollowupChargeFRG').AsFloat;
                    pf_DocVisitTax := Query_Department.FieldByName('FollowupSvrTaxFRG').AsFloat;
               End
               Else
               Begin
                    pf_DocVisitCharge := Query_Department.FieldByName('FollowupCharge').AsFloat;
                    pf_DocVisitTax := Query_Department.FieldByName('FollowupSvrTax').AsFloat;
               End;

               if (CB_CardCharge.Checked=True) then
               begin
                    pf_RegOPDCardcharge := Query_Department.FieldByName('RegistrationCharge').AsFloat;
                    Pf_RegOPDCardTax := Query_Department.FieldByName('RegistrationChargeSvrTax').AsFloat;
               end;
          End;
     End
     Else
     Begin
          if UpperCase(gs_RegistrationType) = 'NEW' then
          Begin
               pf_RegOPDCardcharge := Query_Department.FieldByName('RegistrationCharge').AsFloat;
               Pf_RegOPDCardTax := Query_Department.FieldByName('RegistrationChargeSvrTax').AsFloat;
          End
          Else
          Begin
               if (CB_CardCharge.Checked=True) then
               begin
                    pf_RegOPDCardcharge := Query_Department.FieldByName('RegistrationCharge').AsFloat;
                    Pf_RegOPDCardTax := Query_Department.FieldByName('RegistrationChargeSvrTax').AsFloat;
               end;
          End;
          pf_DocVisitCharge := Query_TimewiseDepPrice.FieldByName('VisitCharge').AsFloat;
          pf_DocVisitTax := Query_TimewiseDepPrice.FieldByName('VisitSvrTax').AsFloat;

     End;
End;


Function TFrame_OPDVisit.IsDoctorWiseRegPrice(DocId,DepId : Integer; VisitTime : String):Boolean;
Var ls_PatientType : String;
Begin
     if DocId=0 then
     Begin
          Result:=False;
          Exit;
     End;

     if gs_PatientTypeCode='PRM' then
     ls_PatientType:='PRIME'
     Else if gs_PatientTypeCode='GEN' then
     ls_PatientType:='GENERAL'
     Else if gs_PatientTypeCode='PVT' then
     ls_PatientType:='PRIVATE'
     Else if gs_PatientTypeCode='FRG' then
     ls_PatientType:='FOREIGNER'
     Else
     ls_PatientType:='GENERAL';

     With Query_TimewiseDepPrice do
     Begin
          Close;
          Session := DM_Hospital.DB;
          sql.Clear;
          if gs_RegistrationType='NEW' then
          sql.Add(' Select TimewiseDepPriceID,NewRegCharge as VisitCharge,NewRegSvrTax as VisitSvrTax')
          Else
          sql.Add(' Select TimewiseDepPriceID,FollowUpCharge as VisitCharge,FollowUpSvrTax as VisitSvrTax');
          sql.Add(' From TimewiseDepPrice where DocId='+IntToStr(DocId)+' and DepId='+IntToStr(DepId));
          sql.Add(' and PatientType='+#39+ls_PatientType+#39+' and FromTime<='+#39+VisitTime+#39+' and ToTime>='+#39+VisitTime+#39);
          Open;
     End;

     if Query_TimewiseDepPrice.FieldByName('TimewiseDepPriceID').AsInteger > 0 then
     Result:=True
     Else
     Result:=False;
End;


