procedure TFrame_OPDVisit.CB_PatientFromChange(Sender: TObject);
begin
     if CB_PatientFrom.Text = 'OPD' then
     begin
          With Query_RefByDocHos do
          begin
               close;
               Session := DM_Hospital.DB;
               sql.Clear;
               (*sql.Add(' Select DOCT_DocId DocId,DOCT_DocCode DocCode,DOCT_DocName DocName,DOCT_DepCode DepCode');
               sql.Add(' From DOCT_Doctor');
               sql.Add(' Where DOCT_IsActive=''Y''');
               sql.Add(' Order by DOCT_DocName');*)
               sql.Add(' Select DEPT_DEPID DepId,DEPT_DEPCODE DEPCODE,DEPT_DEPNAME DEPNAME');
               sql.Add(' FROM HS_DEPT_DEPARTMENT');
               sql.Add(' WHERE DEPT_DEPTYPE=''C''');
               sql.Add(' Order by DEPT_DEPNAME');
               Open;
          end;
     end
     else if CB_PatientFrom.Text = 'REFERRAL' then
     begin
          With Query_RefByDocHos do
          begin
               close;
               Session := DM_Hospital.DB;
               sql.Clear;
               sql.Add(' Select REHO_REFHOSID as DEPID,'''' DEPCODE,REHO_HOSPITALNAME as DEPNAME From HS_REHO_ReferringHospital Order by REHO_HOSPITALNAME');
               Open;
          end;
     end;
end;

