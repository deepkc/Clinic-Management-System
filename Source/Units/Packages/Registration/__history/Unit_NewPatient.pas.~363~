procedure TFrame_NewPatient.BB_SaveClick(Sender: TObject);
Var
  mymemo: TMemo;
  Li_PatientID,Li_pamaPatientid: Integer;
  Ls_RegDate:String;
begin
     with OraQuery_ToCheckExistingPatient do
     begin
          close;
          Session:=DM_Hospital.DB;
          sql.Clear;
          SQL.Add('select PAMA_PATIENTID,PAMA_REGDATE from hs_pama_patientmain where PAMA_FNAME='+QuotedStr(Le_Fname.Text)+' and PAMA_LNAME='+QuotedStr(Le_LName.Text));
          SQL.Add(' and PAMA_MOBILENO='+quotedStr(Le_MobileNo.Text)+' and PAMA_ADDRESS='+QuotedStr(le_Address.Text));
         // SQL.SaveToFile('C:\acb.txt');
          open;
          Li_pamaPatientid:=OraQuery_ToCheckExistingPatient.FieldByName('PAMA_PATIENTID').AsInteger;
          Ls_RegDate:=OraQuery_ToCheckExistingPatient.FieldByName('PAMA_REGDATE').AsString;
     end;

     if OraQuery_ToCheckExistingPatient.RecordCount>0 then
     begin
          if MessageDlg('Patient is already Registered with this Info as The Patient Id is '+IntToStr(Li_pamaPatientid)+' and the Registered Date is '+Ls_RegDate+#13+'Do You Want To Continue ?',mtConfirmation,[mbYes,mbNo],0)=mrNo then
          begin
               Exit;
          end;
     end;


     // OffCamera;
     Gb_isServiceBill := True;
     Gb_SuccessfullySaved := False;

     if not FormValidated then
     begin
          MsgBox(1004, 0, '', '', '');
          exit;
     end;

     if gs_RegistrationType <> 'MODIFYDATA' then
     Begin
         { if Frame_OpdVisit <> Nil then
          begin
               if Frame_OpdVisit.CB_PayType.Text = 'CREDIT' then
               begin
                    if (Frame_OpdVisit.DBLCB_Scheme.Text = '') then
                    begin
                         MessageDlg('Please choose Scheme', mtConfirmation, [mbok], 0);
                         exit;
                    end;
               end;
          end;}
     End;

     if gs_RegistrationType = 'FOLLOWUP' then
     Begin
          if Trim(Edit_HospitalNo.Text) = '' then
          Begin
               MessageDlg('Hospital No is Compulsory.', mtConfirmation, [mbok], 0);
               exit;
          End;

          if StrToInt(Edit_HospitalNo.Text) <> pi_PatientId then
          begin
               MessageDlg('Hospital No Mismatch ! The displaying no is " ' + Edit_HospitalNo.Text +
                         ' " but you are doing billing for this no " ' + IntToStr(pi_PatientId) + ' ".', mtWarning, [mbok], 0);
               exit;
          end;

          IF (gs_FollowUpStatus = 'FOLLOWUPPATIENT') or (gs_FollowUpStatus = 'NEWPATIENT') or (gs_FollowUpStatus='FREEFOLLOWUP') Then
          Begin
               {if gs_FollowUpStatus = 'FOLLOWUPPATIENT' then
