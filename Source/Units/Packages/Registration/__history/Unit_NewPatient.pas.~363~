procedure TFrame_NewPatient.LoadPatientMainInfo;
begin
     LoadPatientData(gi_patientid);
     IF gs_RegistrationType = 'FOLLOWUP' Then
     Begin
          BB_EditMode.Visible := False;
          BB_EditMode.Enabled := False;
          GB_BasicInformation.Enabled := False;
          //GB_Address.Enabled := False;
          GB_Others.Enabled := False;
          Label_PatientName.Caption := gs_PatientName;
     end;

     IF gs_RegistrationType = 'FOLLOWUP' Then
     begin
          Edit_HospitalNo.Text := IntToStr(gi_patientid);
          Label_PatientName.Caption := gs_PatientName;

          GB_BasicInformation.Top := 110;//85;
          if gi_compileValue in [1,14,20,21,22,23,24,25,26,27,28] then
          begin
              DBLCB_title.Visible:=True;
              Label9.Visible:=True;
          end
          else
          begin
              DBLCB_title.Visible:=True;
              Label9.Visible:=True;
          end;

          GB_Address.Top := 274;
          GB_Others.Top := 84;
          Panel_Visit.Top := 240;
          Panel_Image.Top := 89;
          Label_HosNoCap.Visible := True;
          Edit_HospitalNo.Visible := True;
          Label29.Visible := True;
          Label_PatientName.Visible := True;
          GroupBox_VisitHistory.Visible := True;
          GroupBox_VisitHistory.Top := 555;
          TS_Registration.Caption := 'Old Registration';
     end;

     with Query_Process do
     Begin
          Close;
          Session := DM_Hospital.DB;
          SQL.Clear;
          SQL.Add('select * from HS_TITL_title where Upper(TITL_TitleName)=' + #39 +UpperCase(Gs_Title) + #39);
          Open;
     End;
     DBLCB_title.KeyValue := Query_Process.FieldByName('TITL_TITLEID').AsInteger;

     IF (Query_Process.FieldByName('TITL_TITLEID').AsInteger = 0) then
     Begin
          if Gs_Gender = 'MALE' Then
               DBLCB_title.KeyValue := 1
          Else
               DBLCB_title.KeyValue := 2;
     End;

     Edit_HospitalNo.Text := IntToStr(gi_patientid);
     pi_PatientId := gi_patientid;
     CB_Patientcategory.ItemIndex:=CB_Patientcategory.Items.IndexOf(gs_PatientCategory);
     CB_Gender.ItemIndex := CB_Gender.Items.IndexOf(Gs_Gender);
     Le_Fname.Text := Gs_Fname;
     Le_LName.Text := Gs_Lname;
     le_Age.Text := Gs_Age;
     CB_AgeType.ItemIndex := CB_AgeType.Items.IndexOf(Gs_agetype);
     Dex_Dob.VSDateAsText := Gs_DobVS;

     if Gs_IsActualDOB = 'Y' then
          CB_IsRealDOB.Checked := True
     Else
          CB_IsRealDOB.Checked := False;

     CB_MaritalStatus.ItemIndex := CB_MaritalStatus.Items.IndexOf(Gs_MaritalStatus);
     DBLCB_Religion.KeyValue := Gi_ReligionID;
     DBLCB_Country.KeyValue := Gi_CountryID;
     DBLCB_District.KeyValue := Gi_DistrictID;

     With QueryVDC do
     Begin
          Close;
          SQL[1] := ' where DistrictId=' + IntToStr(Gi_DistrictID);
          Open;
     End;

     DBLCB_VDC.KeyValue := Gi_VdcID;
     Le_WardNo.Text := Gs_WardNo;
     le_Address.Text := Gs_Address;
    // Le_PhoneNo.Text := Gs_PhoneNo;
     Le_MobileNo.Text := Gs_MobileNo;
     Memo_Remarks.Text := Gs_Remarks;
     le_Email.Text := Gs_Email;
     DBLCB_Occupation.KeyValue := Gi_OccupationID;
     DBLCB_Education.KeyValue := Gi_EducationID;
     Le_Relative.Text := Gs_NexttoKin;
     DBLCB_Relation.KeyValue := Gi_RelationID;
     Le_Company.Text := Gs_Company;
     Le_PinNo.Text := Gs_Pinno;

     IF Pb_LoadVisit = True Then
          Edit_HospitalNo.SetFocus;

     if gs_RegistrationType <> 'MODIFYDATA' then
     Begin
          LoadPatientVisit;
          MeidcareNo;
         // Frame_OpdVisit.DBLCB_PatientType.KeyValue := gs_PatientTypeCode;
          if (gs_PatientTypeCode = 'ECG') or (gs_PatientTypeCode = 'ECP') or
               (gs_PatientTypeCode = 'ECS') then
          Begin
              // Frame_OpdVisit.DBLCB_PatientType.Enabled := False;
              // Frame_OpdVisit.DBLCB_PatientType.Font.Color := clRed;
              // Frame_OpdVisit.DBLCB_PatientType.Font.Style := [fsBold];
             //  Frame_OpdVisit.DBLCB_Scheme.KeyValue := 91;
               gi_SchemeId := 91;
               gi_CommunityId := 85;
              // Frame_OpdVisit.CB_PayType.ItemIndex := 1;
          End
          else if gs_CalledFrom='SpecialOPDRegistration' then
          Begin
               gs_PatientTypeCode:='SPC';
              // Frame_OpdVisit.DBLCB_PatientType.Enabled:=False;
          End
          Else
          Begin
              // Frame_OpdVisit.DBLCB_PatientType.Enabled := True;
              // Frame_OpdVisit.DBLCB_PatientType.Font.Color := clBlack;
              // Frame_OpdVisit.DBLCB_PatientType.Font.Style := [];
          End;
         // Frame_OpdVisit.GetOPDVisitCharge;
     End
     Else
     Begin
          LoadPatientVisit;
          Panel_Visit.Visible := False;
          // Panel_Visit.Top:=265;
          Panel_Visit.Top := 196;
     End;

     if Gs_IsParty then
          Cb_IsParty.Checked := True
     else
          Cb_IsParty.Checked := False;

     TS_Registration.Visible := True;
     Label_Charge.Caption:=gs_BlinkingCaption;
     {try
          if LoadImageFromDB(gi_patientid) then
           Image_Main.Picture.LoadFromFile(gs_picpath + '\' + IntToStr(gi_patientid)+ 'IMAGEMAIN.JPG');
     except
     end; }

     EditModeColorOnOff;

     //BB_Save.Visible := False;
     // BB_EditMode.Visible := false;
end;

