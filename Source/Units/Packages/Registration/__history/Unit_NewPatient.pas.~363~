procedure TFrame_NewPatient.PatientLastVisitInfo;
var
  Qry: TOraQuery;
  DEX_TodayDate, DEX_LastDate: TDateEditX;
begin
     DEX_TodayDate := TDateEditX.Create(nil);
     DEX_TodayDate.SystemOfDate := gi_datesystem;
     DEX_TodayDate.Text := Serverdate.TodaysDate;

     DEX_LastDate := TDateEditX.Create(nil);
     DEX_LastDate.SystemOfDate := gi_datesystem;
     DEX_LastDate.Text := DEX_TodayDate.Text;

     Qry := TOraQuery.Create(nil);
     With Qry do
     Begin
          Close;
          Session := DM_Hospital.DB;
          SQL.Clear;
          SQL.Add(' Select R.*,BillDateNew     as BillDate From(');
          SQL.Add(' Select PAVI_PatientID,PAVI_VisitDate,PAVI_DEPID,PAVI_DOCID,PAVI_PATIENTTYPECODE,PAVI_SchemeId,PAVI_CommunityId,');
          SQL.Add(' NVL((Select Max(BIDE_BILLDATE) From HS_BIDE_BILLDETAIL Where BIDE_PATIENTID=PV.PAVI_PatientID and BIDE_BILLTYPE=''R''),''2073/04/01'') As BillDATENEW,');
          // SQL.Add(' (Select max(BillDate) From BillDetail where PatientId=PV.PAVI_PatientId and BillType=''O'') as BillDateOLD,');
          SQL.Add(' (Select Count(PAVI_PATIENTVISITID) From HS_PAVI_PATIENTVISIT Where PAVI_PatientID=PV.PAVI_PatientID and PAVI_ISVISITCANCEL=''N'') As NoOfVisit');
          SQL.Add(' From HS_PAVI_PATIENTVISIT PV Where PAVI_PATIENTVISITID In (Select Max(PAVI_PATIENTVISITID) From HS_PAVI_PATIENTVISIT');
          SQL.Add(' Where PAVI_PATIENTID=' + IntToStr(gi_patientid) + ' and PAVI_ISVISITCANCEL=''N'')) R');
          Open;
     End;

     if Trim(Qry.FieldByName('PAVI_VisitDate').AsString) <> '' then
     Begin
          DEX_LastDate.Text := Qry.FieldByName('PAVI_VisitDate').AsString;
          LabelLastVisitDate.Caption := Qry.FieldByName('PAVI_VisitDate').AsString;
          LabelVisitGapDays.Caption := IntToStr((DEX_TodayDate.VSDateAsDays - DEX_LastDate.VSDateAsDays) + 1);
     End
     else
     begin
          LabelLastVisitDate.Caption := '-';
          LabelVisitGapDays.Caption := '-';
     end;

     // if Trim(Qry.FieldByName('BillDATE').AsString)<>'' then
     // Begin
     // DEX_LastDate.Text:=Qry.FieldByName('BillDATE').AsString;
     // LabelPaymentGapDays.Caption:=IntToStr((DEX_TodayDate.VSDateAsDays- DEX_LastDate.VSDateAsDays)+1);
     LabelPaymentGapDays.Caption := FloatToStr(GetNumberOfVisitDaysAnyDepatment(gi_patientid, Qry.FieldByName('PAVI_DEPID').AsInteger));
     LabelLastBillDate.Caption := gs_LastBillDate;
     // End
     // else
     // begin
     // LabelLastBillDate.Caption:='-';
     // LabelPaymentGapDays.Caption:='-';
     // end;

     LabelVisitno.Caption := IntToStr(Qry.FieldByName('NoOfVisit').AsInteger);
     gi_NoOfVisit := Qry.FieldByName('NoOfVisit').AsInteger;

     if (Qry.FieldByName('NoOfVisit').AsInteger = 1) and (Qry.FieldByName('PAVI_VisitDate').AsString = TodaysDate) then
     Begin
          gs_FollowUpStatus := 'NEWPATIENT';
          gb_IsBlinkingContinue := True;
          Timer_DisplayChargeInfo.Enabled := True;
          Label_Charge.Caption := 'Today’s new patient';
          gs_BlinkingCaption := 'Today’s new patient';
          gs_LastVisitDate := Qry.FieldByName('PAVI_VisitDate').AsString;
     End
     Else if (Qry.FieldByName('NoOfVisit').AsInteger > 1) and (Qry.FieldByName('PAVI_VisitDate').AsString = TodaysDate) then
     Begin
          gs_FollowUpStatus := 'FOLLOWUPPATIENT';
          gb_IsBlinkingContinue := True;
          Timer_DisplayChargeInfo.Enabled := True;
          Label_Charge.Caption := 'Today’s follow up';
          gs_BlinkingCaption := 'Today’s follow up';
          gs_LastVisitDate := Qry.FieldByName('PAVI_VisitDate').AsString;
     End
     Else if (Qry.FieldByName('NoOfVisit').AsInteger >= 1) and (Qry.FieldByName('PAVI_VisitDate').AsString<>TodaysDate) then
     Begin
          gs_FollowUpStatus := 'FOLLOWUP';
          gb_IsBlinkingContinue := True;
          Timer_DisplayChargeInfo.Enabled := True;
          //gs_BlinkingCaption:=
          Label_Charge.Caption := gs_BlinkingCaption;
          //gs_BlinkingCaption := 'Today’s follow up';
          gs_LastVisitDate := Qry.FieldByName('PAVI_VisitDate').AsString;
     End
     Else
     Begin
          Label_Charge.Caption := '';
          gb_IsBlinkingContinue := True;
          Timer_DisplayChargeInfo.Enabled := True;
          gs_FollowUpStatus := '';
          gs_BlinkingCaption := '';
          gs_LastVisitDate := '';
     End;

    { With Frame_OpdVisit do
     Begin
          DBLCB_Department.KeyValue := Qry.FieldByName('PAVI_DEPID').AsInteger;
          if (Qry.FieldByName('PAVI_DEPID').AsInteger = 1) and (Trim(gs_MemberNo) <> '') then
