  Unit_QRDischargeBill in 'Unit_QRDischargeBill.pas' {Form_QRDischargeBill},
  Unit_QRDischargeBill_Manipal in 'Unit_QRDischargeBill_Manipal.pas' {Form_QRDischargeBill_Manipal},
  Unit_SelectDoctor in 'Unit_SelectDoctor.pas' {Form_SelectDoctor},
  Unit_BillListFrame in 'Unit_BillListFrame.pas' {Frame_BillList: TFrame},
  Unit_QrDeptwiseBillPrint in 'Unit_QrDeptwiseBillPrint.pas' {Form_QrDepWiseBill},
  Unit_QrBill_PPL in 'Unit_QrBill_PPL.pas' {Form_QRBill_PPL},
  Unit_QrBill_GMC in 'Unit_QrBill_GMC.pas' {Form_QRBill_GMC},
  Unit_QrBill_nozomi in 'Unit_QrBill_nozomi.pas' {Form_QRBill_nozomi};

