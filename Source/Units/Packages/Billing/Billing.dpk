  Unit_Preview in 'Print\Unit_Preview.pas' {FormRoboPreview},
  Unit_Deposits in 'Unit_Deposits.pas' {Form_Deposits},
  Unit_BillDetail_2nd in 'Unit_BillDetail_2nd.pas' {Form_BillDetail_2ND},
  Unit_CreditMessage in 'Unit_CreditMessage.pas' {FormCreditMessage},
  Unit_DisAdjDeposit in 'Unit_DisAdjDeposit.pas' {Form_DischargeAdjDeposit},
  Unit_DischargeInDeposit in 'Unit_DischargeInDeposit.pas' {Form_DischargeInDeposit},
  Unit_DoctorRoundVisit in 'Unit_DoctorRoundVisit.pas' {Form_DoctorRoundVisit},
  Unit_IndoorPatientCategoryChange in 'Unit_IndoorPatientCategoryChange.pas' {Form_IndoorPatientCategoryChange},
  Unit_QRDischargeClearence in 'Unit_QRDischargeClearence.pas' {Form_QrDischargeClearence},
  Unit_DrInvolveInOperation in 'Unit_DrInvolveInOperation.pas' {Form_DrInvolveInOperation},
  Unit_ViewLabReport in 'Unit_ViewLabReport.pas' {Form_ViewLabReport},
