    object QueryCharges: TOraQuery
    MasterSource = DataSourceChargeMaster
    SQL.Strings = (
            'Select *  From FinalDischargeBillDetail.db '
            'where PaymentCategory =:PaymentCategory '
            'Order by BillDate')
    Left = 74
    Top = 8
    ParamData = <
            item
              DataType = ftString
              Name = 'PaymentCategory'
              ParamType = ptUnknown
            end>
  end
  object QueryChargeMaster: TOraQuery
    SQL.Strings = (
            
              'Select Distinct PaymentCategory  From FinalDischargeBillDetail.d' +
              'b '
            'Order by PaymentCategory')
    Left = 9
    Top = 7
    object QueryChargeMasterPaymentCategory: TStringField
      FieldName = 'PaymentCategory'
      Size = 50
    end
  end
object DataSourceChargeMaster: TDataSource
    DataSet = QueryChargeMaster
    Left = 41
    Top = 7
  end
    object Query_GetFinalCharge: TOraQuery
    Left = 113
    Top = 7
  end
  object Query_Deposit: TOraQuery
    SQL.Strings = (
            
              'Select Sum(Cr) as Deposit,Sum(Dr) as Refund,Sum(DollarAmount) as' +
              ' DollarDeposit'
            
              ',NVL(Sum(RefDollarAmt),0) as DollarRefund From IPDeposit where I' +
              'nPatientId=:IPID'
            ' ')
    Left = 147
    Top = 7
    ParamData = <
            item
              DataType = ftInteger
              Name = 'IPID'
              ParamType = ptUnknown
            end>
  end
  object Query_Refund: TOraQuery
    SQL.Strings = (
            
              'SELECT Sum(Amount) AS RefundAmount,Sum(DollarAmount) as DollarRe' +
              'fundAmount'
            'FROM BillDetail'
            'WHERE IsDeducate='#39'Y'#39' AND CancelStatus='#39'Y'#39' AND'
            '      InPatientID=:IPID'
            ' '
            ' ')
    Left = 219
    Top = 7
    ParamData = <
            item
              DataType = ftInteger
              Name = 'IPID'
              ParamType = ptUnknown
            end>
  end
  object Query_GetNetMedicine: TOraQuery
    Left = 265
    Top = 6
  end
  object Query_GetMedRefund: TOraQuery
    Left = 297
    Top = 6
  end
end
