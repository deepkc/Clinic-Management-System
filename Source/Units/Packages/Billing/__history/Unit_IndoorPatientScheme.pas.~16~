procedure TForm_IndoorPatientScheme.BtnSaveClick(Sender: TObject);
var
     li_HospitalNo, li_IPNo: Integer;
     ls_InpatientDate, ls_Hospital:string;
     li_Department:Integer;
     li_CurrentConsultant:Integer;
     li_NewConsultant:Integer;
begin
     If trim(Edit_HospitalNo.text) = '' then
     begin
          MessageDlg('Enter HospitalNo.', mtConfirmation, [mbok], 0);
          Edit_HospitalNo.SetFocus;
          exit;
     End;

     If trim(Edit_IPNo.text) = '' then
     begin
          MessageDlg('Enter Inpatient No .', mtConfirmation, [mbok], 0);
          Edit_HospitalNo.SetFocus;
          exit;
     End;

     If Trim(DBLCB_Community.Text) = '' then
     begin
          MessageDlg('Please Select Community.', mtWarning, [mbok], 0);
          DBLCB_Community.SetFocus;
          exit;
     End;

     If Trim(DBLCB_Scheme.Text) = '' then
     begin
          MessageDlg('Please Select Scheme.', mtWarning, [mbok], 0);
          DBLCB_Scheme.SetFocus;
          exit;
     End;

     if pi_PatientId<>StrToInt(Edit_HospitalNo.Text) then
     Begin
          MessageDlg('Please Check Hospital No Properly and Try Again.',mtWarning,[mbok],0);
          Edit_HospitalNo.SetFocus;
          Exit;
     End;

     if pi_InPatientId<>StrToInt(Edit_IPNo.Text) then
     Begin
          MessageDlg('Please Check Inpatient No Properly and Try Again.',mtWarning,[mbok],0);
          Edit_IPNo.SetFocus;
          Exit;
     End;

     if ps_IsDischarged='Y' then
     Begin
          MessageDlg('Sorry Patient is Already Discharged.',mtWarning,[mbok],0);
          Edit_HospitalNo.SetFocus;
          Exit;
     End;

     if ps_IsDischargeInDeposit='Y' then
     Begin
          IF MessageDlg('Patient is in " Dischared In Deposit " mode. Eventhough Do You Want to Change Consultant ?',mtConfirmation,[mbYes,mbNo],0)=mrNo Then
          Exit;
     End;
     if DBLCB_Scheme.KeyValue<>Null then
     begin
          if (IsRemarksCompulsory(DBLCB_Scheme.KeyValue)=True) and (Trim(Edit_Remarks.Text)='') then
          begin
               MessageDlg(' Please provide remarks', mtWarning, [MbOk], 0);
               Edit_Remarks.SetFocus;
               Exit;
          end;
     end;

     //IF ClientSpecificValidation=False Then Exit;
     if gb_IsEmrDisBilling=False then
     begin
          try
               DM_Hospital.DB.StartTransaction;
               with Query_Save do
               begin
                    Close;
                    DatabaseName := gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_INRE_Inpatientreg set INRE_CommunityId='+IntToStr(DBLCB_Community.KeyValue));
                    SQL.Add(' ,INRE_SchemeId='+IntToStr(DBLCB_Scheme.KeyValue));
                    if Trim(Edit_MemberNo.Text)<>'' then
                    SQL.Add(' ,INRE_MemberNo='+#39+Edit_MemberNo.Text+#39);
                    SQL.Add(' Where INRE_Patientid='+ IntToStr(pi_PatientId)+' and INRE_INPATIENTID='+IntToStr(pi_InPatientId));
                    ExecSQL;
               end;


               gi_CommunityId:=DBLCB_Community.KeyValue;
               gi_SchemeId:=DBLCB_Scheme.KeyValue;

               {    SaveConsultantCorrection(BILLDETAILID,PATIENTID,INPATIENTID,DATAPOSTBY:Integer;
               PATIENTTYPE,PREVDOCCODE,CURRDOCCODE,BILLNO,DATAPOSTDATE,DATAPOSTTIME,REMARKS:String);     }

               DM_Hospital.DB.Commit;
               ShowDoneMessage;
          Except
               DM_Hospital.DB.Rollback;
               ShowMessage('Error has Been Occured');
               exit;
          end;
     end
     else
     begin
          try
               DM_Hospital.DB.StartTransaction;
               with Query_Save do
               begin
                    Close;
                    DatabaseName := gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_PAVI_PatientVisit set PAVI_CommunityId='+IntToStr(DBLCB_Community.KeyValue));
                    SQL.Add(' ,PAVI_SchemeId='+IntToStr(DBLCB_Scheme.KeyValue));
                    if Trim(Edit_MemberNo.Text)<>'' then
                    SQL.Add(' ,PAVI_EMERGENCYNO='+#39+gs_EMRNoForMedPT+#39);
                    SQL.Add(' Where PAVI_Patientid='+ IntToStr(pi_PatientId)+' and Pavi_patientVisitId='+IntToStr(gi_VisitId));
                    ExecSQL;
               end;


               gi_CommunityId:=DBLCB_Community.KeyValue;
               gi_SchemeId:=DBLCB_Scheme.KeyValue;

               {    SaveConsultantCorrection(BILLDETAILID,PATIENTID,INPATIENTID,DATAPOSTBY:Integer;
               PATIENTTYPE,PREVDOCCODE,CURRDOCCODE,BILLNO,DATAPOSTDATE,DATAPOSTTIME,REMARKS:String);     }

               DM_Hospital.DB.Commit;
               ShowDoneMessage;
          Except
               DM_Hospital.DB.Rollback;
               ShowMessage('Error has Been Occured');
               exit;
          end;
     end;
end;

Function TForm_IndoorPatientScheme.ClientSpecificValidation: Boolean;
begin
     if gs_HospitalNameForCode='MAN' then // Manipal
     Begin
          if (DBLCB_Scheme.KeyValue=22) Then
          Begin
               IF Trim(Edit_MemberNo.Text)='' then
               begin
                    MessageDlg('For Medicare Patient MCP NO. Is Compulsory.',mtWarning,[mbOK],0);
                    Edit_MemberNo.ReadOnly:=False;
                    Edit_MemberNo.Color:=clWhite;
                    Edit_MemberNo.SetFocus;
                    Result:=False;
                    Exit;
               end;

               with Query_Save do
               begin
                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Select * From Member where PatientId='+IntToStr(pi_Patientid));
                    SQL.Add(' and MemberNo='+#39+Edit_MemberNo.Text+#39);
                    Open;
               end;

               if Query_Save.FieldByName('MemberId').AsInteger=0  then
               begin
                    MessageDlg('This Member No. "'+Edit_MemberNo.Text+'" Doesn''t Belongs With This Hospital No. "'+IntToStr(pi_Patientid)+'".' ,mtWarning,[mbOK],0);
                    Edit_MemberNo.ReadOnly:=False;
                    Edit_MemberNo.Color:=clWhite;
                    Edit_MemberNo.SetFocus;
                    Result:=False;
                    Exit;
               end;
          End;
     End
     else if gs_HospitalNameForCode='BNB' then
     begin
          if (DBLCB_Scheme.KeyValue=22) Then // 22 - BNB Specail
          Begin
               with Query_Save do
               begin
                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Select Sum(SPDE_DrAmount-SPDE_CrAmount) as NetDeposit From HS_SPDE_SPECIALDEPOSIT');
                    SQL.Add(' where SPDE_InPatientId='+IntToStr(pi_InPatientid));
                    Open;
               end;

               if Query_Save.FieldByName('NetDeposit').AsFloat > 0 then
               begin
                    MessageDlg('Please Refund The OutStanding Deposit ( Rs. '+FloatToStr(Query_Save.FieldByName('NetDeposit').AsFloat)+' ) of The Patient Before Keeping In Special.' ,mtWarning,[mbOK],0);
                    DBLCB_Scheme.SetFocus;
                    Result:=False;
                    Exit;
               end;
          End;
     end;
     Result:=True;
end;

