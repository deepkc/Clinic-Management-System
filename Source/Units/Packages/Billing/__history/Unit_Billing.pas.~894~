Function TForm_Billing.SaveServiceBill: Boolean;
var Qry1:TOraQuery;
begin

     Qry1:=Toraquery.create(nil);

     with Qry1 do
     begin
          close;
          Session:=DM_Hospital.DB;
          sql.Clear;
          sql.Add('select HORU_ISADVANCESYSTEMFORIPBILL from HS_HORU_HOSPITALRULES');
          open;
     end;
     if Trim(Qry1.FieldByName('HORU_ISADVANCESYSTEMFORIPBILL').AsString)='Y' then
     begin

     Result := False;
     { Save Bill Master }
     try
          DM_Hospital.DB.StartTransaction;
          try
               SaveServiceBill_Detail;
          except
               SaveServiceBill_Detail;
          end;

          ps_FinalBillNo := Gs_BillNo;

          ps_DepositBillNo := '';
          {if Trim(Le_GrandTotal.Text) = '' then
          Le_GrandTotal.Text := '0';}

          if Trim(Le_Payment.text)='' then
          Le_Payment.text:='0';

          if (StrToFloat(Le_Payment.Text) > 0) then  //and (Pi_SchemeID <> 22)
          Begin
               SaveInvAdvanceDeposit(StrToFloat(Le_Payment.Text), 0, Le_Remarks.Text,'N');
               Label_DepositNo.Caption := Gs_BillNo;
               Label_DepositNo.Visible := True;
               Label11.Visible := True;
               ps_DepositBillNo := Gs_BillNo;
          End;

          ps_DepositBillNo := '';
          gs_BillNo:=ps_FinalBillNo;
          DM_Hospital.DB.Commit;
          Result := True;
          ShowDoneMessage;
     except
          DM_Hospital.DB.Rollback;
     end;
   end;
   Qry1.free;
end;

