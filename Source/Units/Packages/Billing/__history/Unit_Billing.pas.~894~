     if (gs_BillType = 'REFUNDBILL') or (gs_BillType='SERVICE REFUNDBILL') then
     Begin
          if (Table_Billing.FieldByName('TestNameCode').AsString = 'ONE001') and
               (gi_compileValue = 562) then // Specail Case for Manipal Blood Refund
