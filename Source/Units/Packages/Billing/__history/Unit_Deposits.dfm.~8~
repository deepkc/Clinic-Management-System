  object Query_List: TOraQuery
    SQL.Strings = (
      
        'Select DP.*,(Select USMA_UserName From HS_USMA_UserMain where US' +
        'MA_UserId=DEPO_DepositBy) as DepositBy from HS_DEPO_Deposit DP'
      'Where 1=1'
      'and NVL(Trim(DEPO_DEPOSITTYPE),'#39'NA'#39')<>'#39'DIS ADJ DEP REFUND'#39
      'Order by DEPO_DEPOSITDATE DESC')
    Left = 352
    Top = 296
