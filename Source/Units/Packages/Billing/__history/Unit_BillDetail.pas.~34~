procedure TForm_BillDetail.BtnSaveClick(Sender: TObject);
Var
     lf_VatAmt, lf_DisPer, lf_Discount, lf_TotAmt, lf_testprice, lf_net, lf_qty, lf_grandtotal,lf_DiscountTotal: Double;
     Key: Char;
     Qry:Tquery;
     li_CommunityID,Li_SchemeID:Integer;
begin
     lf_VatAmt:=0;
     lf_DisPer:=0;
     lf_Discount:=0;
     lf_TotAmt:=0;
     lf_testprice:=0;
     lf_net:=0;
     lf_qty:=0;
     lf_grandtotal:=0;
     lf_DiscountTotal:=0;
     Gs_BillNo:='';

     if gi_SchemeId > 0 then
     pi_SchemeId:=gi_SchemeId;
     if pi_SchemeId <= 0 then
     begin
          MessageDlg(' You must have to set Scheme first.',mtWarning,[mbOK],0);
          Exit;
     end;

     if ISTRANSLOCKED(gi_InPatientID)=True then
     begin
          MessageDlg('Sorry ! Transaction is already locked.',mtWarning,[mbOK],0);
          Exit;
     end;

     {if (pi_SchemeId = 22) or (pi_SchemeId=91) then // 22 - Medicare, 91 - ECHS
     begin
          MessageDlg(' Sorry You Cannot Set Discount For Medicare Scheme & ECHS Patient.',mtWarning,[mbOK],0);
          Exit;
     end; }

     IF MessageDlg(' Are you sure to save the changes made in this bill ?', mtConfirmation, [mbyes, mbno], 0) = mrYes Then
     Begin
          with Table_TempDetailPTest do
          begin
               Close;
               databasename := gs_TempPath;
               Open;
               While Not EOF do
               begin
                    if Table_TempDetailPTest.FieldByName('IsDiscountable').AsString = 'Y' then
                    begin
                         if (Table_TempDetailPTest.FieldByName('Discount').AsFloat>0) and (Table_TempDetailPTest.FieldByName('DisPer').AsFloat=0) then
                         DBGrid_ServiceCharge.SelectedIndex := i_Discount
                         else
                         DBGrid_ServiceCharge.SelectedIndex := i_Disper;
                         Key := #13;
                         DBGrid_ServiceChargeKeyPress(Sender, Key);
                    end
                    else
                    begin
                         DBGrid_ServiceCharge.SelectedIndex := i_Disper;
                         Edit;
                         DBGrid_ServiceCharge.Fields[i_Disper].Value := 0;
                         Post;
                    end;
                    Next;
               end;
          end;


          Table_TempDetailPTest.First;
          Try
               DM_Hospital.Db.StartTransaction;
               while not Table_TempDetailPTest.EOF do
               Begin
                    lf_TotAmt := Table_TempDetailPTest.FieldByName('Total').AsFloat;
                    lf_testprice := Table_TempDetailPTest.FieldByName('CostPrice').AsFloat;
                    lf_net := Table_TempDetailPTest.FieldByName('NetTotal').AsFloat;
                    lf_grandtotal:=lf_grandtotal+lf_net;
                    lf_DiscountTotal:=lf_DiscountTotal+lf_Discount;
                    if Table_TempDetailPTest.FieldByName('DisPer').AsFloat<> Table_TempDetailPTest.FieldByName('ORGDisPer').AsFloat Then
                    Begin
                         lf_qty := Table_TempDetailPTest.FieldByName('Qty').AsFloat;
                         lf_DisPer := Table_TempDetailPTest.FieldByName('DisPer').AsFloat;
                         lf_Discount := Table_TempDetailPTest.FieldByName('Discount').AsFloat;
                         lf_VatAmt:=Table_TempDetailPTest.FieldByName('VatAmt').AsFloat;

                         if Gs_TaxRule='TBD' then
                         begin
                              if Table_TempDetailPTest.FieldByName('IsDiscountable').AsString = 'Y' then
                              lf_Discount := GetNoOfDecimalPartOfFloatNum(((lf_DisPer / 100) * lf_testprice) * lf_qty, 4)
                              else
                              begin
                                   lf_DisPer:=0;
                                   lf_Discount:=0;
                              end;
                         end
                         else if Gs_TaxRule='TAD' then
                         begin
                              if Table_TempDetailPTest.FieldByName('IsDiscountable').AsString = 'Y' then
                              begin
                                   lf_Discount := GetNoOfDecimalPartOfFloatNum(((lf_DisPer / 100) * lf_testprice) * lf_qty, 4);
                                   lf_testprice:=lf_testprice-lf_testprice*lf_DisPer/100;
                                   if Table_TempDetailPTest.FieldByName('IsVatable').AsString = 'Y' then
                                   lf_VatAmt := GetNoOfDecimalPartOfFloatNum((lf_testprice * lf_qty) * (gf_TaxPercent / 100), 4)
                                   Else
                                   lf_VatAmt := 0;
                              end
                              Else
                              Begin
                                   lf_DisPer:=0;
                                   lf_Discount:=0;
                              End;
                         end;

                         with Query_Process do
                         Begin
                              Close;
                              databasename := gs_DatabaseName;
                              sql.Clear;
                              sql.add(' Update HS_SEBD_SERVICEBILLDETAIL set SEBD_Disper=' + FloatToStr(lf_DisPer));
                              // Table_TempDetailPTest.FieldByName('DisPer').AsFloat));
                              sql.Add(' ,SEBD_DISCommunityId='+IntToStr(li_CommunityID));
                              sql.Add(' ,SEBD_DISSchemeId='+IntToStr(Li_SchemeID));
                              sql.add(' ,SEBD_DISCOUNT=' + FloatToStr(lf_Discount));
                              sql.add(',SEBD_TotalAmount=' + FloatToStr(lf_net));
                              // IF Gs_TaxRule='TAD' Then //
                              sql.add(' ,SEBD_VatAmt='+ FloatToStr(lf_VatAmt));
                              // IF Table_TempDetailPTest.FieldByName('OrgDisPer').AsInteger<>Table_TempDetailPTest.FieldByName('DisPer').AsFloat Then
                              sql.Add(' ,SEBD_FINALDISCOUNTBY='+IntToStr(gi_UserId));
                              //sql.add(' ,UnitCost=' + FloatToStr(lf_testprice));
                              //sql.add(' ,SEBD_Qty=' + FloatToStr(lf_qty));
                              sql.add(' where SEBD_ServiceBillDetailID=' + #39 + Table_TempDetailPTest.FieldByName('ServiceBillDetailID').AsString + #39);
                              ExecSQL;


                              (*Updating Bed Charge*)
                              if Table_TempDetailPTest.FieldByName('ChargeType').AsString='BED' then
                              begin
                                   SQL.Clear;
                                   SQL.Add(' Update HS_INDE_InPatientDetail Set');
                                   SQL.Add(' INDE_VatAmt=(INDE_BedCharge-INDE_BedCharge*'+FloatToStr(Table_TempDetailPTest.FieldByName('Disper').AsFloat/100)+') * '+FloatToStr(gf_TaxPercent/100));
                                   SQL.Add(' ,INDE_Disper='+Table_TempDetailPTest.FieldByName('Disper').AsString);
                                   SQL.Add(' Where INDE_InPatientID='+IntToStr(gi_InPatientID));
                                   SQL.Add(' and INDE_InPatientDID='+IntToStr(Table_TempDetailPTest.FieldByName('InPatientDID').AsInteger));
                                   ExecSQL;
                              end;

                              if Table_TempDetailPTest.FieldByName('ChargeType').AsString<>'BED' then
                              begin
                                   if (gs_ISFractionSharingActive='Y') and (IsDataExist('HS_FRDE_FractionDetail','FRDE_ServiceBillDetailID',
                                   Table_TempDetailPTest.FieldByName('ServiceBillDetailID').AsString)=True) then
                                   begin
                                        Close;
                                        databasename := gs_DatabaseName;
                                        sql.Clear;
                                        sql.add(' Update HS_FRDE_FractionDetail set FRDE_DISPER=' + FloatToStr(lf_DisPer));
                                        sql.add(' where FRDE_ServiceBillDetailID=' +IntToStr(Table_TempDetailPTest.FieldByName('ServiceBillDetailID').AsInteger));
                                        sql.add(' and FRDE_InpatientID='+IntToStr(pi_InPatientId));
                                        ExecSQL;
                                   end;
                              end;

                              (*Updating Doctor Charge*)
                              (*if Table_TempDetailPTest.FieldByName('ChargeType').AsString='DOCTOR' then
                              begin
                                   SQL.Clear;
                                   SQL.Add(' Update DoctorRoundVisit Set');
                                   SQL.Add(' VatAmt=(VisitCharge-VisitCharge*'+FloatToStr(Table_TempDetailPTest.FieldByName('Disper').AsFloat/100)+') * '+FloatToStr(gf_TaxPercent/100));
                                   SQL.Add(' ,Disper='+Table_TempDetailPTest.FieldByName('Disper').AsString);
                                   SQL.Add('Where InPatientID='+IntToStr(gi_InPatientID));
                                   ExecSQL;
                              end;*)
                         end;
                    End
                    else if Table_TempDetailPTest.FieldByName('DisCount').AsFloat<> Table_TempDetailPTest.FieldByName('ORGDiscount').AsFloat Then
                    begin
                         lf_qty := Table_TempDetailPTest.FieldByName('Qty').AsFloat;
                         lf_Discount := Table_TempDetailPTest.FieldByName('Discount').AsFloat;
                         lf_VatAmt:=Table_TempDetailPTest.FieldByName('VatAmt').AsFloat;
                         lf_DisPer:=GetNoOfDecimalPartOfFloatNum(lf_Discount*100/(lf_testprice*lf_qty),2);

                         if Gs_TaxRule='TBD' then
                         begin
                              if Table_TempDetailPTest.FieldByName('IsDiscountable').AsString = 'Y' then
                              lf_Discount := GetNoOfDecimalPartOfFloatNum(((lf_DisPer / 100) * lf_testprice) * lf_qty, 4)
                              else
                              begin
                                   lf_DisPer:=0;
                                   lf_Discount:=0;
                              end;
                         end
                         else if Gs_TaxRule='TAD' then
                         begin
                              if Table_TempDetailPTest.FieldByName('IsDiscountable').AsString = 'Y' then
                              begin
                                   lf_Discount := GetNoOfDecimalPartOfFloatNum(((lf_DisPer / 100) * lf_testprice) * lf_qty, 4);
                                   lf_testprice:=lf_testprice-lf_testprice*lf_DisPer/100;
                                   if Table_TempDetailPTest.FieldByName('IsVatable').AsString = 'Y' then
                                   lf_VatAmt := GetNoOfDecimalPartOfFloatNum((lf_testprice * lf_qty) * (gf_TaxPercent / 100), 4)
                                   Else
                                   lf_VatAmt := 0;
                              end
                              Else
                              Begin
                                   lf_DisPer:=0;
                                   lf_Discount:=0;
                              End;
                         end;
                         with Query_Process do
                         Begin
                              Close;
                              databasename := gs_DatabaseName;
                              sql.Clear;
                              sql.add(' Update HS_SEBD_SERVICEBILLDETAIL set SEBD_Disper=' + FloatToStr(lf_DisPer));
                              // Table_TempDetailPTest.FieldByName('DisPer').AsFloat));
                              sql.Add(' ,SEBD_DISCommunityId='+IntToStr(li_CommunityID));
                              sql.Add(' ,SEBD_DISSchemeId='+IntToStr(Li_SchemeID));
                              sql.add(' ,SEBD_DISCOUNT=' + FloatToStr(lf_Discount));
                              sql.add(',SEBD_TotalAmount=' + FloatToStr(lf_net));
                              // IF Gs_TaxRule='TAD' Then //
                              sql.add(' ,SEBD_VatAmt='+ FloatToStr(lf_VatAmt));

                              // IF Table_TempDetailPTest.FieldByName('OrgDisPer').AsInteger<>Table_TempDetailPTest.FieldByName('DisPer').AsFloat Then
                              // sql.Add(' ,FinalDiscountBy='+IntToStr(gi_UserId));
                              //sql.add(' ,UnitCost=' + FloatToStr(lf_testprice));
                              //sql.add(' ,SEBD_Qty=' + FloatToStr(lf_qty));
                              sql.add(' where SEBD_ServiceBillDetailID=' + #39 + Table_TempDetailPTest.FieldByName('ServiceBillDetailID').AsString + #39);
                              ExecSQL;


                              (*Updating Bed Charge*)
                              if Table_TempDetailPTest.FieldByName('ChargeType').AsString='BED' then
                              begin
                                   SQL.Clear;
                                   SQL.Add(' Update InPatientDetail Set');
                                   SQL.Add(' VatAmt=(BedCharge-BedCharge*'+FloatToStr(Table_TempDetailPTest.FieldByName('Disper').AsFloat/100)+') * '+FloatToStr(gf_TaxPercent/100));
                                   SQL.Add(' ,Disper='+Table_TempDetailPTest.FieldByName('Disper').AsString);
                                   SQL.Add(' Where InPatientID='+IntToStr(gi_InPatientID));
                                   SQL.Add(' and InPatientDID='+IntToStr(Table_TempDetailPTest.FieldByName('InPatientDID').AsInteger));
                                   ExecSQL;
                              end;


                              if Table_TempDetailPTest.FieldByName('ChargeType').AsString<>'BED' then
                              begin
                                   if (gs_ISFractionSharingActive='Y') and (IsDataExist('HS_FRDE_FractionDetail','FRDE_ServiceBillDetailID',
                                        Table_TempDetailPTest.FieldByName('ServiceBillDetailID').AsString)=True) then
                                   begin
                                        Close;
                                        databasename := gs_DatabaseName;
                                        sql.Clear;
                                        sql.add(' Update HS_FRDE_FractionDetail set FRDE_DISPER=' + FloatToStr(lf_DisPer));
                                        sql.add(' where FRDE_ServiceBillDetailID=' +IntToStr(Table_TempDetailPTest.FieldByName('ServiceBillDetailID').AsInteger));
                                        sql.add(' and FRDE_InpatientID='+IntToStr(pi_InPatientId));
                                        ExecSQL;
                                   end;
                              end;

                              (*Updating Doctor Charge*)
                              (*if Table_TempDetailPTest.FieldByName('ChargeType').AsString='DOCTOR' then
                              begin
                                   SQL.Clear;
                                   SQL.Add(' Update DoctorRoundVisit Set');
                                   SQL.Add(' VatAmt=(VisitCharge-VisitCharge*'+FloatToStr(Table_TempDetailPTest.FieldByName('Disper').AsFloat/100)+') * '+FloatToStr(gf_TaxPercent/100));
                                   SQL.Add(' ,Disper='+Table_TempDetailPTest.FieldByName('Disper').AsString);
                                   SQL.Add('Where InPatientID='+IntToStr(gi_InPatientID));
                                   ExecSQL;
                              end;*)
                         end;
                    end;
                    Table_TempDetailPTest.Next;
               End;
               Qry:=TQuery.Create(Nil);
               with Qry do
               begin
                    Close;
                    DatabaseName:=gs_temppath;
                    SQL.Clear;
                    SQL.Add('Select Billno,Sum(Total)Total,Sum(Discount)Discount From DetailPatientTest Group By BillNo');
                    Open;
                    while not Eof do
                    begin
                         with Query_Process do
                         begin
                              Gs_BillNo:=Qry.FieldByName('BillNo').AsString;
                              lf_grandtotal:=Qry.FieldByName('Total').AsFloat;
                              lf_DiscountTotal:=Qry.FieldByName('Discount').AsFloat;
                              (* Update In ServiceBillMaster *)
                              Close;
                              databasename := gs_DatabaseName;
                              sql.Clear;
                              sql.add(' Update HS_SEBM_ServiceBillMaster set SEBM_GrossTotal=' + FloatToStr(lf_grandtotal));
                              sql.add(',SEBM_DiscountTotal =' + FloatToStr(lf_DiscountTotal));
                              sql.add(',SEBM_BillBy =' + FloatToStr(gi_UserID));
                              sql.add(',SEBM_BillDate =' +#39+TodaysDate+#39);
                              sql.add(',SEBM_BillTime =' +#39+TodaysTime+#39);
                              sql.add(' where SEBM_BillNo=' +#39+Qry.FieldByName('BillNo').AsString+#39);
                              ExecSQL;
                         end;
                         Next;
                    end;
               end;
               DM_Hospital.Db.Commit;
          except
               ShowMessage(' Filure to Update !');
               DM_Hospital.Db.Rollback;
               Exit;
          End;
          ShowDoneMessage;
          Close;
     End;
End;

