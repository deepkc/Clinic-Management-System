procedure TForm_BillDetail.AdjustLabItemsWithDeposit;
Var
     lf_DepositBalance,lf_NetTotal: Double;
     QryBal:Tquery;
     QryUpdate:TQuery;
begin
     lf_NetTotal:=0;
     lf_DepositBalance:=0;
     QryBal := Tquery.Create(nil);
     QryUpdate := Tquery.Create(nil);
     with QryBal do
     begin
//          close;
//          DatabaseName := gs_DatabaseName;
//          sql.Clear;
//          sql.Add(' Select Sum(DrAmount-CrAmount)DepositBalance From Deposit');
//          sql.Add(' Where PatientID=' + IntToStr(gi_PatientID));
//          open;
//          lf_DepositBalance:=FieldByName('DepositBalance').AsFloat;

          lf_DepositBalance:=GetDepositBalance(gi_PatientID);

          Close;
          DatabaseName:=gs_temppath;
          SQL.Clear;
          SQL.Add('Select * from DetailPatientTest Where TestProgressStatus=1');
          Open;

          while not eof do
