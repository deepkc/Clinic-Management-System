procedure TForm_BillDetail.Edit_TestNameChange(Sender: TObject);
begin
     Edit_TestName.Text := StringReplace(Edit_TestName.Text, '''', '''''', [rfReplaceAll]);
     with Table_TempDetailPTest do
     Begin
          IF Trim(Edit_TestName.Text) <> '' Then
          Begin
               if RB_Verified.Checked=True then
               Filter := 'TestName =' + #39 + Edit_TestName.Text + '*' + #39+' and VerifiedBy > 0'
               Else if RB_NonVerified.Checked=True then
               Filter := 'TestName =' + #39 + Edit_TestName.Text + '*' + #39+' and VerifiedBy = 0'
               Else
               Filter := 'TestName =' + #39 + Edit_TestName.Text + '*' + #39;
               Filtered := True;
          End
          Else
          Begin
               if RB_All.Checked then
               Filtered := False
               Else
               Begin
                    if RB_Verified.Checked=True then
                    Filter := 'VerifiedBy > 0'
                    Else if RB_NonVerified.Checked=True then
                    Filter := 'VerifiedBy = 0';
                    Filtered := True;
               End;
          End;
     End;

     (*IF Trim(Edit_TestName.Text)<>'' Then
     StatusBar1.Panels[0].Text:='Total No -'+FloatToStr(GetTotalQtyOfItems(Table_TempDetailPTest.FieldByName('TestNameCode').AsString))
     Else
     StatusBar1.Panels[0].Text:='';*)
end;

