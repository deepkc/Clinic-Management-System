procedure TForm_BillDetail.SPB_SetCreditSchemeClick(Sender: TObject);
begin
     Try
          Form_IndoorPatientScheme:=TForm_IndoorPatientScheme.Create(Nil);
          With Form_IndoorPatientScheme do
          Begin
               pi_InPatientId:=Self.pi_InPatientId;
               pi_PatientId:=Self.pi_PatientId;
               Edit_HospitalNo.Enabled:=False;
               Edit_IPNo.Enabled:=False;
               pi_CommunityId:=Self.pi_CommunityID;
               pi_SchemeID:=Self.pi_SchemeId;
               ShowModal;
          End;
     Finally
          Form_IndoorPatientScheme.Free;
     End;
     Label_SchemeName.Caption:=GetSchemeName(gi_SchemeId);
     pi_CommunityID:=gi_CommunityId;
     pi_SchemeID:=gi_SchemeId;
end;

procedure TForm_BillDetail.Edi_DisPerChange(Sender: TObject);
begin
     if cb_amt.Checked=False then
     begin
          if Edi_DisPer.Text <> '' then
          begin
               if StrToFloat(Edi_DisPer.Text) > 100 then
                    SPB_SetDiscount.Enabled := False
               else
                    SPB_SetDiscount.Enabled := True;
          end;
     end;
end;

procedure TForm_BillDetail.Edi_DisPerKeyPress(Sender: TObject; var Key: Char);
begin
     if Key in [#8] then
     Exit;

     if Key = #13 then
          SPB_SetDiscountClick(Sender);

     AvoidMultipleDecimal(Edi_DisPer, Key);
     Key := Key;
end;

procedure TForm_BillDetail.cb_amtClick(Sender: TObject);
begin
     if cb_amt.Checked = True then
          cb_amt.Caption := 'Set Discount Amt'
     else
          cb_amt.Caption := 'Set Discount (%)';
end;

procedure TForm_BillDetail.DBGrid_ServiceChargeExit(Sender: TObject);
Var
     Key: Char;
begin
     Key := #13;
     DBGrid_ServiceChargeKeyPress(Sender, Key);
end;

Function TForm_BillDetail.GetTotalQtyOfItems(TestNameCode : String):Double;
Var Qry : TQuery;
Begin
     Qry:=TQuery.Create(Nil);
     With Qry Do
     Begin
          Close;
          DatabaseName:=gs_temppath;
          sql.Clear;
          sql.Add(' Select Sum(Qty) as Total From DetailPatientTest.db');
          sql.Add(' where TestNameCode='+#39+TestNameCode+#39);
          Open;
     End;
     Result:=Qry.FieldByName('Total').AsFloat;
     Qry.Free;
End;

end.
