     Labelname.Caption := Gs_PatientName;

     DateEditXSCDate.SystemOfDate := gi_DateSystem;
     DateEditXSCDate.Text := ServerDate.TodaysDate;

     IF pi_CommunityID > 0 Then
     Begin
          With Query_Community Do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select SCHE_SCHEME as Community From HS_SCHE_Scheme where SCHE_SchemeId=' + IntToStr(pi_SchemeId));
               Open;
          End;
          IF ps_MemberNo = '' Then
               LabelCommunity.Caption := Query_Community.FieldByName('Community').AsString
          Else
               LabelCommunity.Caption := Query_Community.FieldByName('Community').AsString + '- MED.No. ' + ps_MemberNo;
     End;

     CreateTempDetailPTest;
     FillPatientTest;
     // ServiceChargeCalculation;
     ActiveControl := DBGrid_ServiceCharge;
     DBGrid_ServiceCharge.SelectedIndex := i_Disper;


     Get_PatientTakenServiceCategory;

     { for Fraction Modification }
     IF UpperCase(ps_FormAccessFrom) = 'FRACTIONMODIFY' Then
     Begin
          // GroupBox_Account.Visible:=False;
          BtnSave.Enabled := False;
          DBGrid_ServiceCharge.Height := 384;
     End;

     IF ps_FormAccessFrom<>'DischargeBill' Then
     Begin
          SPB_PharmacyDiscount.Enabled:=False;
          SPB_SetCreditScheme.Enabled:=False;
     End;

     RefreshQuery(QueryCommunity,gs_DatabaseName);

     if gs_ISINTEGRATEDPHARMACY='Y' then
     SPB_PharmacyDiscount.Visible:=True
     else
     SPB_PharmacyDiscount.Visible:=False;
End;


procedure TForm_BillDetail.Get_PatientTakenServiceCategory;
Begin
     With Query_TempProcess do
     Begin
          Close;
          DatabaseName:=gs_temppath;
          sql.Clear;
          sql.Add(' Select Distinct TNCategoryCode From FinalBillDetail.db where TNCategoryCode is not null');
          Open;
          First;
          ps_TNCategoryCode:='';
          while not EOF do
          Begin
               if Trim(ps_TNCategoryCode)<>'' then
               ps_TNCategoryCode:=ps_TNCategoryCode+','+''''+Query_TempProcess.FieldByName('TNCategoryCode').AsString+''''
               Else
               ps_TNCategoryCode:=''''+Query_TempProcess.FieldByName('TNCategoryCode').AsString+'''';
               Query_TempProcess.Next;
          End;
     End;

     if Trim(ps_TNCategoryCode)<>'' then
     Begin
          With Query_TNCategory do
          Begin
               Close;
               DatabaseName:=gs_DatabaseName;
               sql.Clear;
               sql.Add(' Select * From HS_TENC_TestNameCategory where TENC_TNCategoryCode In ('+ps_TNCategoryCode+')');
               sql.Add(' Order by TENC_TestNameCategory');
               //sql.SaveToFile('C:\Cat.Txt');
               Open;
          End;
     End;
End;

