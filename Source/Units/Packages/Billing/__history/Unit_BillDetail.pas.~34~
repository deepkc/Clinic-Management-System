procedure TForm_BillDetail.LoadFinalBill;
Var
     Qry: TQuery;
     ls_RefDoc,ls_DisBillDate: string;
     li_Communityid, li_SchemdID: Integer;
     TestPriceWithDis, SvrTaxWithDis, TotalPriceWithDis: Double;
     Sender: TObject;

     pf_TestPrice,pf_SvrTax,pf_Qty,pf_TotalPrice,pf_Total,pf_subtotal,pf_grandtotal,pf_SvrTaxTotal
     ,pi_TotItems,pf_discount,pf_DiscountTotal:Double;

begin
     Qry := TQuery.Create(nil);
     CreateTableFinalBill;
     with Table_FinalBill do
     begin
          Close;
          DatabaseName := gs_temppath;
          TableName := 'FinalBillDetail.db';
          EmptyTable;
          Open;
     end;
     IF b_IsDischargePt=True Then
     ls_DisBillDate:=GetDisBillDate(gs_BillNo);
     if ps_ServiceType='INVESTIGATION' then
     Begin
          DBGrid_ServiceCharge.Columns[0].Title.Caption:='Service Date';
          DBGrid_ServiceCharge.Columns[1].Title.Caption:='Time';
          with Qry do
          begin
               Close;
               DatabaseName := gs_DatabaseName;
               SQL.Clear;
               if Not b_IsDischargePt then
               begin
                    SQL.Add(' SELECT SEBD_ServiceBillDetailID ServiceBillDetailID,SEBD_BillDetailID BillDetailID,SEBD_PATIENTTESTID PATIENTTESTID,SEBD_PATIENTID PATIENTID,');
                    SQL.Add(' SEBD_INPATIENTID INPATIENTID,SEBD_DOCCODE DOCCODE,SEBD_BillType BillType,SEBD_SERVICE SERVICE,SEBD_SERVICETYPE SERVICETYPE,SEBD_DEPID DEPID,SEBD_BILLDATE BILLDATE,SEBD_BILLTIME BILLTIME,SEBD_BILLNO BILLNO,');
                    SQL.Add(' SEBD_DISCOMMUNITYID DISCOMMUNITYID, SEBD_DISSCHEMEID DISSCHEMEID,SEBD_REFDOCCODE REFDOCCODE,SEBD_RATETYPE RATETYPE,');
                    SQL.Add(' SEBD_VERIFIEDBY VERIFIEDBY,SBD.SEBD_AMOUNT AMOUNT,SEBD_QTY QTY, SEBD_VATAMT VATAMT, SEBD_DISPER DISPER,SEBD_DISCOUNT DISCOUNT,');
                    SQL.Add(' (SELECT SCHE_Scheme From HS_SCHE_Scheme Where SCHE_SchemeId=SBD.SEBD_DisSchemeId) DisSchemeName,');
                    SQL.Add(' (SELECT TESTNAMEID FROM PATIENTTEST WHERE PATIENTTESTID=SBD.SEBD_PATIENTTESTID)TESTNAMEID,');
                    SQL.Add(' (SELECT SEBM_TOBESENTTOWEB FROM HS_SEBM_SERVICEBILLMASTER WHERE SEBM_BILLNO=SBD.SEBD_BILLNO)TOBE_SENTTOWEB,');
                    SQL.Add(' (SELECT SEBM_TOBESENTTOSMS FROM HS_SEBM_SERVICEBILLMASTER WHERE SEBM_BILLNO=SBD.SEBD_BILLNO)TOBE_SENTTOSMS,');
                    SQL.Add(' (SELECT SEBM_TOBESENTTOEMAIL FROM HS_SEBM_SERVICEBILLMASTER WHERE SEBM_BILLNO=SBD.SEBD_BILLNO)TOBE_SENTTOEMAIL,');
                    //SQL.Add(' SEBD_ISVATABLETEST ISVATABLE,SEBD_ISDISCOUNTABLETEST ISDISCOUNTABLE,');
                    SQL.Add(' (Select IsVatable From VW_HS_SETUP_TESTNAMEPRICE where PatientTypeCode=''GEN'' and TestNameCode=SEBD_Service and RowNum=1) IsVatable,');
                    SQL.Add(' (Select IsDiscountable From VW_HS_SETUP_TESTNAMEPRICE where PatientTypeCode=''GEN'' and TestNameCode=SEBD_Service and RowNum=1) IsDiscountable,');
                    SQL.Add(' (SELECT TENA_TNCategoryCode From HS_TENA_TestName Where TENA_TestNameCode=SBD.SEBD_Service and RowNum=1)TNCategoryCode,');
                    SQL.Add(' (SELECT Max(TestProgressStatus)TestProgressStatus From PatientTest Where ServiceBillDetailID=SBD.SEBD_ServiceBillDetailID)TestProgressStatus,');
                    SQL.Add(' (SELECT USMA_UserName From HS_USMA_UserMain Where USMA_UserID=SBD.SEBD_BillBy)UserName, '''' RefDocCodeFinal');
                    SQL.Add(', Case when SEBD_Remarks is Null then ''IP'' else ''ER'' end as Remarks');
                    sql.Add(' FROM HS_SEBD_SERVICEBILLDETAIL SBD WHERE SBD.SEBD_PatientId=' + IntToStr(gi_PatientID) + ' AND SEBD_BillDetailId=0');
                    if ps_DisInDeposit='Y' then
                    sql.Add(' and NVL(SEBD_DisInDepositTransId,0)='+IntToStr(pi_DisInDepositTransId))
                    Else
                    Begin
                         if ps_PreveDisInDepositTransExist='Y' then
                         sql.Add(' and NVL(SEBD_DisInDepositTransId,0) Not In ('+ps_DisInDepositTransId+')');
                    End;
                    SQL.Add(
                         'AND SBD.SEBD_ServiceBillDetailID NOT IN (SELECT TECA_SERVICEBILLDETAILID FROM HS_TECA_TESTCANCEL WHERE TECA_SERVICEBILLDETAILID=SBD.SEBD_ServiceBillDetailID)');
               end
               else
               begin
                    if ls_DisBillDate >='2014/07/17' then //Before This this OLD System
                    Begin
                         SQL.Add(' SELECT SEBD_ServiceBillDetailID ServiceBillDetailID,BIDE_BillDetailID BillDetailID,BIDE_PatientId PatientID,');
                         SQL.Add(' BIDE_InPatientId InpatientID,BIDE_DepId DEPID, SEBD_PatientTestId PatientTestId,SEBD_DocCode DocCode,BIDE_BillType BillType,BIDE_Service Service,');
                         SQL.Add(' BIDE_ServiceType ServiceType, SEBD_AMOUNT AMOUNT,SEBD_QTY QTY, SEBD_VATAMT VatAmt, SEBD_DISPER DISPER,SEBD_DISCOUNT DISCOUNT,');
                         SQL.Add(' BIDE_DISCOMMUNITYID DISCOMMUNITYID, BIDE_DISSCHEMEID DISSCHEMEID,BIDE_REFDOCCODE REFDOCCODE,BIDE_RATETYPE RATETYPE,');
                         SQL.Add(' (SELECT SCHE_Scheme From HS_SCHE_SCHEME Where SCHE_SchemeId=BD.BIDE_DISSchemeId and rownum=1) DisSchemeName,');
                         SQL.Add(' SEBD_IsDiscountableTest IsDiscountable ,TN.TENA_TNCategoryCode TNCategoryCode  ,TN.TENA_TestNameId TESTNAMEID,');
                         SQL.Add(' SBD.SEBD_BillNo SvrBillNo ,SBD.SEBD_BillDate as SvrBillDate,SBD.SEBD_BillTime SvrBillTime,BIDE_ISVATABLETEST ISVATABLE,');
                         SQL.Add(' Case when BD.BIDE_SERVICEBILLDETAILID > 0 Then (Select USMA_UserName From HS_USMA_UserMain where USMA_UserId=SBD.SEBD_BillBy)');
                         SQL.Add(' Else (Select USMA_UserName From HS_USMA_UserMain where USMA_UserId=BD.BIDE_BillBy) End UserName,4 as TestProgressStatus,');
                         SQL.Add(' BIDE_RefDocCode RefDocCodeFinal,SEBD_VerifiedBy VerifiedBy,'''' as Remarks');
                         SQL.Add(' FROM HS_BIDE_BILLDETAIL BD,HS_SEBD_SERVICEBILLDETAIL SBD,HS_TENA_TestName TN');
                         SQL.Add(' WHERE BD.BIDE_Service=TN.TENA_TestNameCode(+) and BD.BIDE_BillDetailId=SBD.SEBD_BillDetailId(+)');
                         SQL.Add(' and BD.BIDE_Service Not In (''DOCRC'',''PHACH'') and BD.BIDE_ServiceType Not In (''BED CHARGES'')');
                         SQL.Add(' and BD.BIDE_BILLNO=' + #39 + Gs_BillNo + #39);
                         SQL.Add(' AND BD.BIDE_BILLDETAILID NOT IN (SELECT TECA_BILLDETAILID FROM HS_TECA_TESTCANCEL WHERE TECA_BILLDETAILID=BD.BIDE_BILLDETAILID)');
                    end;
               end;
               //sql.saveToFile('C:\BillDetail.Txt');
               Open;
               pf_TestPrice := 0;
               pf_SvrTax := 0;
               pf_Qty := 0;
               pf_TotalPrice := 0;
               pf_Total := 0;
               pf_subtotal := 0;
               pf_grandtotal := 0;
               pf_SvrTaxTotal := 0;
               pi_TotItems := 0;
               pf_discount := 0;
               pf_DiscountTotal := 0;
               while not eof do
               begin
                    pf_TestPrice := Qry.FieldByName('Amount').AsFloat;
                    pf_SvrTax := Qry.FieldByName('VatAmt').AsFloat;
                    pf_Qty := Qry.FieldByName('Qty').AsFloat;
                    pf_disper := Qry.FieldByName('DisPer').AsFloat;
                    pf_TotalPrice := pf_TestPrice * pf_qty + pf_SvrTax ;

                    if Gs_TaxRule='TAD' then
                    begin
                         TestPriceWithDis := pf_TestPrice - ((pf_disper / 100) * pf_TestPrice);
                         if Qry.FieldByName('IsVatable').AsString='Y' then
                         SvrTaxWithDis := (gf_TaxPercent / 100) * TestPriceWithDis
                         Else
                         SvrTaxWithDis := 0;
                         TotalPriceWithDis := (TestPriceWithDis + SvrTaxWithDis) * pf_Qty;
                    end
                    else if Gs_TaxRule='TBD' then
                    begin
                         TotalPriceWithDis := pf_TestPrice * pf_Qty + pf_SvrTax-((pf_disper / 100) * pf_TestPrice * pf_Qty);
                    end;
                    with Table_FinalBill do
                    begin
                         Append;
                         FieldByName('ServiceBillDetailID').AsInteger := Qry.FieldByName('ServiceBillDetailID').AsInteger;
                         if Qry.FieldByName('BillDetailID').AsString <> '' then
                              FieldByName('BillDetailID').AsInteger := Qry.FieldByName('BillDetailID').AsInteger;
                         if Not b_IsDischargePt then
                         Begin
                              FieldByName('BillDate').AsString := Qry.FieldByName('BillDate').AsString;
                              FieldByName('BillTime').AsString := Qry.FieldByName('BillTime').AsString;
                              FieldByName('BillNo').AsString := Qry.FieldByName('BillNo').AsString;
                         End
                         Else
                         Begin
                              FieldByName('BillDate').AsString := Qry.FieldByName('SvrBillDate').AsString;
                              FieldByName('BillTime').AsString := Qry.FieldByName('SvrBillTime').AsString;
                              FieldByName('BillNo').AsString := Qry.FieldByName('SvrBillNo').AsString;
                         End;

                         FieldByName('PatientId').AsInteger := Qry.FieldByName('PatientId').AsInteger;
                         FieldByName('InPatientId').AsInteger := Qry.FieldByName('InPatientId').AsInteger;
                         FieldByName('DepId').AsInteger := Qry.FieldByName('DepId').AsInteger;
                         FieldByName('PatientTestID').AsInteger := Qry.FieldByName('PatientTestId').AsInteger;
                         FieldByName('Doccode').AsString := Qry.FieldByName('Doccode').AsString;
                         FieldByName('TestNameCode').AsString := Qry.FieldByName('Service').AsString;
                         FieldByName('TNCategoryCode').AsString := Qry.FieldByName('TNCategoryCode').AsString;
                         FieldByName('TestNameId').AsInteger := Qry.FieldByName('TestNameId').AsInteger;
                         FieldByName('TestName').AsString := Qry.FieldByName('ServiceType').AsString;
                         FieldByName('TestPrice').AsFloat := StrToFloat(FormatFloat('#0.00', pf_TestPrice));
                         FieldByName('TestPriceAfterDiscount').AsFloat := StrToFloat(FormatFloat('#0.00', TestPriceWithDis));
                         FieldByName('Qty').AsFloat := pf_Qty;
                         FieldByName('TotalPrice').AsFloat := StrToFloat(FormatFloat('#0.00', pf_TotalPrice));
                         FieldByName('DisPer').AsFloat := Qry.FieldByName('DisPer').AsFloat;
                         FieldByName('OrgDisPer').AsFloat := Qry.FieldByName('DisPer').AsFloat;
                         pf_disper := Qry.FieldByName('DisPer').AsFloat;
                         FieldByName('SvrTax').AsFloat := StrToFloat(FormatFloat('#0.00', pf_SvrTax));
                         FieldByName('Discount').AsFloat := Qry.FieldByName('Discount').AsFloat;
