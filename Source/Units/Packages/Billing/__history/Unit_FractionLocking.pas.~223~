procedure TForm_FractionLocking.ShowLockReport;
Begin
     With Query_LockUnLockStatus do
     Begin
          Close;
          DatabaseName:=gs_DatabaseName;
          sql.Clear;
          SQL.add(' Select LOG_DateFrom FromDate,Log_DateTo ToDate,LOG_Remarks Remarks,(Select Doct_DocName From HS_DOCT_Doctor where DOCT_DocId=LOG_DOCID) as DocName,');
          SQL.add(' Log_LockDate LockDate,LOG_LockTime LockTime,Log_UnlockDate UnLockDate,LOG_UnLockTime UnLockTime,');
          SQL.add(' LOG_LOGTYPE LockType,(Select USMA_UserName From HS_USMA_UserMain where USMA_UserId=Log_UserId) as UserName,');
          SQL.add(' LOG_BILLNO BillNo,LOG_PATIENTID PatientId,LOG_INPATIENTID InpatientId');
          SQL.add(' From HS_LOG_FRACTIONLOCKUNLOCK');
          if RB_External.Checked=True then
          SQL.add(' where LOG_TRANSTYPE=''EXTERNAL''')
          Else
          SQL.add(' where LOG_TRANSTYPE=''INTERNAL''');
          SQL.add(' Order by LOG_LockDate Desc,LOG_LockTime Desc');
          Open;
     End;
end;

