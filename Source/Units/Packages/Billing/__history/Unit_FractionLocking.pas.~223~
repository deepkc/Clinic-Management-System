procedure TForm_FractionLocking.SPB_ShowFractionLockStatusClick(Sender: TObject);
Var li_PatientNo : Integer;
    ls_BillNo : string;
begin
     if Trim(Edit_Billno.Text)='' then
     begin
          MessageDlg(' You Must Have To Put Hospital No./IP NO Or Bill No.',mtWarning,[mbOK],0);
          Edit_Billno.SetFocus;
          Exit;
     end;

     Try
          li_PatientNo:=StrToInt(Edit_Billno.Text);
          ls_BillNo:='';
     except
          li_PatientNo:=0;
          ls_BillNo:=Edit_Billno.Text;
     End;

     if RB_External.Checked=True then
     Begin
          With Query_ShowBillList do
          begin
               Close;
               SQL.Clear;
               DatabaseName:=gs_DatabaseName;
               SQL.add(' Select Distinct BIDE_BillDate,BIDE_BillNo,BIDE_PatientId,BIDE_InpatientID,');
               SQL.add(' (Select PAMA_PatientName From HS_PAMA_PatientMain where PAMA_PatientId=BIDE_PatientId) as PatientName,');
               SQL.add(' Case when BIDE_InpatientID > 0 Then (Select INRE_ISTRANSLOCKED From HS_INRE_InpatientReg where INRE_InpatientId=BIDE_InpatientID)');
               SQL.add(' Else (Select Distinct FRDE_ISFRACTIONLOCKED From HS_FRDE_FractionDetail where FRDE_BillNo=BIDE_BillNo and RowNum=1) End IsLocked');
               SQL.add(' From HS_BIDE_BillDetail');
               if li_PatientNo > 0 then
               SQL.add(' where (BIDE_PatientId='+IntToStr(li_PatientNo)+' or BIDE_InpatientID='+IntToStr(li_PatientNo)+')')
               else
               SQL.add(' where BIDE_BillNo='+#39+ls_BillNo+#39);
               SQL.add(' and BIDE_BillDate>='+#39+DEX_From.Text+#39+' and BIDE_BillDate<='+#39+DEX_To.Text+#39);
               SQL.add(' Order by BIDE_BillDate Desc');
               Open;
          end;
     End
     else
     begin
          With Query_ShowBillList do
          begin
               Close;
               SQL.Clear;
               DatabaseName:=gs_DatabaseName;
               SQL.add(' Select Distinct INRE_DISINDEPOSITDATE as BIDE_BillDate,''Specail Discharge'' BIDE_BillNo,INRE_PatientId BIDE_PatientId,INRE_InpatientID BIDE_InpatientID,');
               SQL.add(' (Select PAMA_PatientName From HS_PAMA_PatientMain where PAMA_PatientId=INRE_PatientId) as PatientName,');
               SQL.add(' INRE_ISTRANSLOCKED as IsLocked');
               SQL.add(' From HS_INRE_InpatientReg');
               SQL.add(' where (INRE_PatientId='+IntToStr(li_PatientNo)+' or INRE_InpatientID='+IntToStr(li_PatientNo)+')');
               SQL.add(' and INRE_SPLDISINDEPOCASHDATE>='+#39+DEX_From.Text+#39+' and INRE_SPLDISINDEPOCASHDATE<='+#39+DEX_To.Text+#39);
               SQL.add(' Order by INRE_DISINDEPOSITDATE Desc');
               Open;
          end;
     end;

     Label_Name.Caption:=Query_ShowBillList.FieldByName('PatientName').AsString;
end;

