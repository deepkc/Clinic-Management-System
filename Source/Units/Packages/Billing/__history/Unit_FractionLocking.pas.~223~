{$R *.dfm}

procedure TForm_FractionLocking.BitBtnLockClick(Sender: TObject);
var
     lb_IsFractionLocked:Boolean;
     ls_TodaysDate, ls_TodaysTime : String;
     li_NoOfRecord, i : Integer;
     j: Double;
     ls_ToDate : String;
begin
     ChangeToDefaultDate(DEX_From,DEX_To);
     if Copy(DEX_From.Text,6,2)<>Copy(DEX_To.Text,6,2) then
     Begin
          MessageDlg(' Sorry ! You Can Lock Transaction of Single Month Only.',mtWarning,[mbok],0);
          DEX_To.SetFocus;
          Exit;
     End;


     if DEX_From.Text<>Copy(DEX_From.Text,1,8)+'01' then
     Begin
          MessageDlg(' Sorry ! From Date Must Be Start With 01',mtWarning,[mbok],0);
          DEX_From.SetFocus;
          Exit;
     End;

     ls_ToDate:=DEX_To.Text;
     DEX_To.Text:=Copy(DEX_From.Text,1,8)+'32';

     if ls_ToDate<>DEX_To.Text then
     Begin
          MessageDlg(' Sorry ! To Date Must Be of Month End Days',mtWarning,[mbok],0);
          DEX_To.SetFocus;
          Exit;
     End;


     With Query_Process do
     Begin
          Close;
          DatabaseName := gs_DatabaseName;
          sql.Clear;
          sql.add(' Select LOG_FLLID,(Select DOCT_Desig||'' ''||DOCT_DOCNAME From Hs_Doct_Doctor where Doct_DocCode=FLL.LOG_DocCode) as Doctor ');
          sql.add(' ,LOG_LockDate,LOG_LockTime,LOG_DateFrom,LOG_DateTo,(Select USMA_UserName From Hs_Usma_UserMain where Usma_UserId=FLL.LOG_UserId) as UserName');
          sql.add(' From HS_LOG_FRACTIONLOCKUNLOCK FLL ');
          sql.add(' WHERE LOG_DateFrom>='+#39+DEX_From.Text+#39+' and LOG_DateTo<='+#39+DEX_To.Text+#39);
          sql.add(' and LOG_IsLocked=''Y''');
          if DBLCB_Doctor.KeyValue<>null then
          SQL.Add(' and LOG_DocId='+IntToStr(DBLCB_Doctor.KeyValue));
          if RB_External.Checked=True then
          SQL.Add(' and LOG_TRANSTYPE=''EXTERNAL''')
          else
          SQL.Add(' and LOG_TRANSTYPE=''INTERNAL''');
          Open;
     End;

     if DBLCB_Doctor.KeyValue<>null then
     begin
          IF Query_Process.FieldByName('LOG_FLLID').AsInteger>0 Then
          Begin
               MessageDlg('Fraction between '+Query_Process.FieldByName('LOG_DateFrom').AsString+'-'+Query_Process.FieldByName('LOG_DateTo').AsString+
               ' of   " '+Query_Process.FieldByName('Doctor').AsString+' "   is already locked '+Char(10)+
               ' by   " '+Query_Process.FieldByName('UserName').AsString+'  "   on Date  " '+Query_Process.FieldByName('LOG_LockDate').AsString+' "'
               ,mtInformation,[mbok],0);
               Exit;
          End;
     end
     else
     begin
          IF  Query_Process.FieldByName('LOG_FLLID').AsInteger>0 Then
          Begin
               MessageDlg('Fraction between '+Query_Process.FieldByName('LOG_DateFrom').AsString+'-'+Query_Process.FieldByName('LOG_DateTo').AsString+
               'is already locked by   " '+Query_Process.FieldByName('UserName').AsString+'  "   on Date  " '+Query_Process.FieldByName('LOG_LockDate').AsString+' "'
               ,mtInformation,[mbok],0);
               Exit;
          End;
     end;

     ls_TodaysDate:=ServerDate.TodaysDate;
     ls_TodaysTime:=ServerDate.TodaysTime;

     ProgressBar1.Position:=0;
     With Query_Process do
     begin
          if RB_External.Checked then
          Begin
               Close;
               SQL.Clear;
               SQL.Add(' Select FRDE_FractionDetailId,FRDE_BillDetailID,FRDE_ServiceBillDetailId,FRDE_PatientId,FRDE_InpatientID,');
               SQL.Add(' FRDE_DOCID,FRDE_TestNameId,FRDE_Description,FRDE_UnitTestCost,FRDE_Qty,FRDE_FractionAmount,FRDE_Disper,FRDE_FractionRate,');
               SQL.Add(' FRDE_FractionID,FRDE_PositionWiseFractionID,FRDE_ISFRACTIONPROPWITHDISPER,FRDE_REFFRACTIONDETAILID,'''' IsRefund,FRDE_Remarks,');
               SQL.Add(' FRDE_Datapostby,FRDE_Datapostdate,FRDE_dataposttime');
               SQL.Add(' From HS_BIDE_BillDetail BD,HS_FRDE_FractionDetail FD');
               SQL.Add(' where BIDE_BillDetailID=FRDE_BillDetailId and BD.BIDE_BillType In (''B'',''R'') and FRDE_TestNameCode<>''IPCON''');
               SQL.Add(' and BIDE_BillDate>='+#39+DEX_From.Text+#39+' and BIDE_BillDate<='+#39+DEX_To.Text+#39);
               SQL.Add(' Union ');
               SQL.Add(' Select FRDE_FractionDetailId,FRDE_BillDetailID,FRDE_ServiceBillDetailId,FRDE_PatientId,FRDE_InpatientID,');
               SQL.Add(' FRDE_DOCID,FRDE_TestNameId,FRDE_Description,FRDE_UnitTestCost,FRDE_Qty,FRDE_FractionAmount,FRDE_Disper,FRDE_FractionRate,');
               SQL.Add(' FRDE_FractionID,FRDE_PositionWiseFractionID,FRDE_ISFRACTIONPROPWITHDISPER,FRDE_REFFRACTIONDETAILID,'''' IsRefund,FRDE_Remarks,');
               SQL.Add(' FRDE_Datapostby,FRDE_Datapostdate,FRDE_dataposttime');
               SQL.Add(' From HS_FRDE_FractionDetail FD');
               SQL.Add(' where FRDE_InpatientId In (Select INRE_InpatientId From HS_INRE_InpatientReg where INRE_IsDischarged=''Y''');
               SQL.Add(' and INRE_DisDate>='+#39+DEX_From.Text+#39+' and INRE_DisDate<='+#39+DEX_To.Text+#39+')');
               SQL.Add(' Order by FRDE_FractionDetailId');
               Open;
          End
          else
          Begin
               Close;
               SQL.Clear;
               SQL.Add(' Select FRDE_FractionDetailId,FRDE_BillDetailID,FRDE_ServiceBillDetailId,FRDE_PatientId,FRDE_InpatientID,');
               SQL.Add(' FRDE_DOCID,FRDE_TestNameId,FRDE_Description,FRDE_UnitTestCost,FRDE_Qty,FRDE_FractionAmount,FRDE_Disper,FRDE_FractionRate,');
               SQL.Add(' FRDE_FractionID,FRDE_PositionWiseFractionID,FRDE_ISFRACTIONPROPWITHDISPER,FRDE_REFFRACTIONDETAILID,'''' IsRefund,FRDE_Remarks,');
               SQL.Add(' FRDE_Datapostby,FRDE_Datapostdate,FRDE_dataposttime');
               SQL.Add(' From HS_FRDE_FractionDetail FD');
               SQL.Add(' where FRDE_InpatientId In (Select INRE_InpatientId From HS_INRE_InpatientReg where INRE_IsDisInDeposit=''Y'' and INRE_DISINDEPOSITESCHEME=22');
               SQL.Add(' and INRE_SPLDISINDEPOCASHDATE>='+#39+DEX_From.Text+#39+' and INRE_SPLDISINDEPOCASHDATE<='+#39+DEX_To.Text+#39+')');
               SQL.Add(' Order by FRDE_FractionDetailId');
               Open;
          End;
          Query_Process.SQL.SaveToFile('C:\FractionLock.txt');

          i:=0;
          li_NoOfRecord:=Query_Process.RecordCount;
          First;
          try
          DM_Hospital.DB.StartTransaction;
          while not Query_Process.Eof do
          begin
               //if Table_FractionLock.FieldByName('CHecked').AsBoolean=True then
               //begin
                    lb_IsFractionLocked := True;

                    with Query_SubProcess do
                    begin
                         Close;
                         DatabaseName:=gs_DatabaseName;
                         SQL.Clear;
                         SQL.Add(' Update hs_frde_fractiondetail set frde_isfractionlocked=''Y'',FRDE_FrctLockDate='+#39+ls_TodaysDate+#39);
                         SQL.Add(' where frde_fractiondetailid='+inttostr(Query_Process.FieldByName('FRDE_FRACTIONDETAILID').AsInteger));
                         ExecSQL;

                         if Query_Process.FieldByName('isrefund').AsString='Y' then
                         begin
                              Close;
                              DatabaseName := gs_DatabaseName;
                              SQL.Clear;
                              SQL.Add(' Update Hs_FRRD_FractionRefundDetail set FRRD_ISFRACTIONLOCKED=''Y'',FRRD_FRCTLOCKDATE='+#39+ls_TodaysDate+#39);
                              SQL.Add(' WHERE FRRD_FRACTIONDETAILID='+IntToStr(Query_Process.FieldByName('FRDE_FRACTIONDETAILID').AsInteger));
                              ExecSQL;
                         end;
                         Close;
                         DatabaseName := gs_DatabaseName;
                         SQL.Clear;
                         SQL.Add(' Insert into BNB_IMAGE.HS_LOG_FRACTIONDETAIL(LOG_FRACTIONDETAILID,LOG_PATIENTID,LOG_INPATIENTID,LOG_BILLDETAILID,LOG_SERVICEBILLDETAILID,');
                         SQL.Add(' LOG_DOCID,LOG_TESTNAMEID,LOG_DESCRIPTION,LOG_UNITTESTCOST,LOG_QTY,LOG_FRACTIONAMOUNT,LOG_FRACTIONRATE,LOG_DISPER,');
                         SQL.Add(' LOG_FRACTIONID,LOG_POSITIONWISEFRACTIONID,LOG_ISFRACTIONPROPWITHDISPER,LOG_REMARKS,LOG_DATAPOSTBY,LOG_DATAPOSTDATE,');
                         SQL.Add(' LOG_DATAPOSTTIME) Values(');
                         SQL.Add( IntToStr(Query_Process.FieldByName('FRDE_FRACTIONDETAILID').AsInteger)+','+IntToStr(Query_Process.FieldByName('FRDE_Patientid').AsInteger));
                         SQL.Add(' ,'+IntToStr(Query_Process.FieldByName('FRDE_Inpatientid').AsInteger)+','+IntToStr(Query_Process.FieldByName('FRDE_billdetailid').AsInteger));
                         SQL.Add(' ,'+IntToStr(Query_Process.FieldByName('FRDE_Servicebilldetailid').AsInteger)+','+IntToStr(Query_Process.FieldByName('FRDE_docid').AsInteger));
                         SQL.Add(' ,'+IntToStr(Query_Process.FieldByName('FRDE_testnameid').AsInteger)+','+#39+Query_Process.FieldByName('FRDE_Description').AsString+#39);
                         SQL.Add(' ,'+FloatToStr(Query_Process.FieldByName('FRDE_UnitTestcost').AsFloat)+','+FloatToStr(Query_Process.FieldByName('FRDE_Qty').AsFloat));
                         SQL.Add(' ,'+FloatToStr(Query_Process.FieldByName('FRDE_FRACTIONAMOUNT').AsFloat)+','+FloatToStr(Query_Process.FieldByName('FRDE_FractionRate').AsFloat));
                         SQL.Add(' ,'+FloatToStr(Query_Process.FieldByName('FRDE_Disper').AsFloat)+','+IntToStr(Query_Process.FieldByName('FRDE_Fractionid').AsInteger));
                         SQL.Add(' ,'+IntToStr(Query_Process.FieldByName('FRDE_POSITIONWISEFRACTIONID').AsInteger)+','+#39+Query_Process.FieldByName('FRDE_ISFRACTIONPROPWITHDISPER').AsString+#39);
                         SQL.Add(' ,'+#39+Query_Process.FieldByName('FRDE_Remarks').AsString+#39+','+IntToStr(Query_Process.FieldByName('FRDE_Datapostby').AsInteger));
                         SQL.Add(' ,'+#39+Query_Process.FieldByName('FRDE_Datapostdate').AsString+#39+','+#39+Query_Process.FieldByName('FRDE_dataposttime').AsString+#39+')');
                         //SQL.SaveToFile('C:\FractionDetail.txt');
                         ExecSQL;
                    end;

               ProgressBar1.Position:=Round((i/li_NoOfRecord)*100);
               Inc(i);
               Query_Process.Next;
          end;


          IF RB_External.Checked=True Then
          begin
               With Query_Process do
               begin
                    Close;
                    SQL.Clear;
                    SQL.Add(' Update HS_INRE_InpatientReg Set INRE_ISTRANSLOCKED=''Y'' where INRE_DisDate>='+#39+DEX_From.Text+#39+' and INRE_DisDate<='+#39+DEX_To.Text+#39);
                    ExecSQL;
               end;
          End
          Else
          Begin
               With Query_Process do
               begin
                    Close;
                    SQL.Clear;
                    SQL.Add(' Update HS_INRE_InpatientReg Set INRE_ISTRANSLOCKED=''Y''');
                    SQL.Add(' where INRE_SPLDISINDEPOCASHDATE>='+#39+DEX_From.Text+#39+' and INRE_SPLDISINDEPOCASHDATE<='+#39+DEX_To.Text+#39);
                    SQL.Add(' and INRE_DISINDEPOSITESCHEME=22 and INRE_IsDisInDeposit=''Y''');
                    ExecSQL;

                    Close;
                    SQL.Clear;
                    SQL.Add(' Update HS_SPDE_SpecialDeposit Set SPDE_ISTRANSLOCKED=''N'' where SPDE_InpatientId In (');
                    SQL.Add(' Select INRE_InpatientId From HS_INRE_InpatientReg');
                    SQL.Add(' where INRE_SPLDISINDEPOCASHDATE>='+#39+DEX_From.Text+#39+' and INRE_SPLDISINDEPOCASHDATE<='+#39+DEX_To.Text+#39);
                    SQL.Add(' and INRE_DISINDEPOSITESCHEME=22 and INRE_IsDisInDeposit=''Y'')');
                    ExecSQL;
               end;
          end;

          if lb_IsFractionLocked=True then
          begin
               with Query_Process do
               begin
                    Close;
                    SQL.Clear;
                    SQL.add(' Insert Into HS_LOG_FRACTIONLOCKUNLOCK(LOG_FLLID,LOG_UserId,LOG_LockDate,LOG_LockTime,LOG_DOCID,LOG_DocCode,');
                    SQL.add(' LOG_DateFrom,LOG_DateTo,LOG_IsLocked,LOG_LOGTYPE,LOG_TRANSTYPE) Values('+IntToStr(GetMaxId('HS_LOG_FRACTIONLOCKUNLOCK','LOG_FLLID'))+','+IntToStr(gi_UserId));
                    SQL.add(' ,'+#39+ls_TodaysDate+#39+','+#39+ls_TodaysTime+#39);
                    if DBLCB_Doctor.KeyValue<>Null then
                    begin
                         SQL.Add(','+IntToStr(DBLCB_Doctor.KeyValue));
                         SQL.Add(','+#39+Query_Doctor.FieldByName('Doccode').AsString+#39);
                    end
                    else
                    begin
                         SQL.Add(','+IntToStr(0));
                         SQL.Add(','+'''''');
                    end;
                    SQL.add(' ,'+#39+DEX_From.Text+#39);
                    SQL.add(' ,'+#39+DEX_To.Text+#39);
                    SQL.add(' ,''Y'',''MASS''');
                    if RB_External.Checked then
                    SQL.add(' ,''EXTERNAL''')
                    Else
                    SQL.add(' ,''INTERNAL''');
                    SQL.add(' )');
                    ExecSQL;
               end;
          end;
          ProgressBar1.Position:=100;
          DM_Hospital.DB.Commit;
          ShowDoneMessage;
          lb_IsFractionLocked :=False;
     Except
          DM_Hospital.DB.RollBack;
          lb_IsFractionLocked := False;
          MessageDlg('Failure to Lock Fraction. Plz Contact With System Administrator.',mtWarning,[mbok],0);
     end;
     end;
     ProgressBar1.Position:=0;
     ShowDoneMessage;
     ShowLockReport;
     //LoadData;
end;

procedure TForm_FractionLocking.BitBtnUnlockClick(Sender: TObject);
Var ls_ToDate : string;
begin
     ChangeToDefaultDate(DEX_From,DEX_To);
     if CB_All.Checked=False then
     Begin
          if Query_ShowBillList.FieldByName('IsLocked').AsString='' then
          begin
               MessageDlg(' Not Fraction Record Exist of This Bill to Lock/Unlock.',mtWarning,[mbOK],0);
               Exit;
          end;

          if Query_ShowBillList.FieldByName('IsLocked').AsString='Y' then
          Begin
               if not(MessageDlg('Are You Sure to Unlock Transaction ?',mtConfirmation,[mbYes,mbNo],0)=mrYes) then Exit;
          End
          else
          begin
               if not(MessageDlg('Are You Sure to Lock Transaction ?',mtConfirmation,[mbYes,mbNo],0)=mrYes) then Exit;
          end;

          (*if Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger > 0 then
          begin
               With Query_Process do
               begin
                    Close;
                    SQL.Clear;
                    SQL.Add(' Select INRE_ISTRANSLOCKED From HS_INRE_InpatientReg where INRE_InpatientId='+IntToStr(Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger));
                    Open;
               end;

               if Query_Process.FieldByName('INRE_ISTRANSLOCKED').AsString='N' then
               begin
                    MessageDlg(' Sorry This Is In Already Unlock State. No Need To Unlock Again.',mtInformation,[mbOK],0);
                    Exit;
               end;
          end
          else
          Begin
               With Query_Process do
               begin
                    Close;
                    SQL.Clear;
                    SQL.Add(' Select Distinct FRDE_ISFRACTIONLOCKED From HS_FRDE_FractionDetail where FRDE_BillNo='+#39+Query_ShowBillList.FieldByName('BIDE_BillNo').AsString+#39);
                    Open;
               end;

               if Query_Process.FieldByName('FRDE_ISFRACTIONLOCKED').AsString='N' then
               begin
                    MessageDlg(' Sorry This Is In Already Unlock State. No Need To Unlock Again.',mtInformation,[mbOK],0);
                    Exit;
               end;
          End; *)

          if RB_External.Checked=True then
          Begin
               pi_InpatientID:=Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger;
               ps_BillNo:='';
          End
          Else
          Begin
               pi_InpatientID:=0;
               ps_BillNo:=Query_ShowBillList.FieldByName('BIDE_BILLNO').AsString;
          End;

          if Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger > 0 then
          Begin
               With Query_Process do
               begin
                    Close;
                    SQL.Clear;
                    if Query_ShowBillList.FieldByName('IsLocked').AsString='Y' then
                    SQL.Add(' Update HS_FRDE_FractionDetail Set FRDE_ISFRACTIONLOCKED=''N'' where FRDE_InpatientId='+IntToStr(Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger))
                    else
                    SQL.Add(' Update HS_FRDE_FractionDetail Set FRDE_ISFRACTIONLOCKED=''Y'' where FRDE_InpatientId='+IntToStr(Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger));
                    ExecSQL;

                    Close;
                    SQL.Clear;
                    if Query_ShowBillList.FieldByName('IsLocked').AsString='Y' then
                    SQL.Add(' Update HS_FRRD_FractionRefundDetail Set FRRD_ISFRACTIONLOCKED=''N'' where FRRD_InpatientId='+IntToStr(Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger))
                    else
                    SQL.Add(' Update HS_FRRD_FractionRefundDetail Set FRRD_ISFRACTIONLOCKED=''Y'' where FRRD_InpatientId='+IntToStr(Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger));
                    ExecSQL;

                    Close;
                    SQL.Clear;
                    if Query_ShowBillList.FieldByName('IsLocked').AsString='Y' then
                    SQL.Add(' Update HS_INRE_InpatientReg Set INRE_ISTRANSLOCKED=''N'' where INRE_InpatientId='+IntToStr(Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger))
                    else
                    SQL.Add(' Update HS_INRE_InpatientReg Set INRE_ISTRANSLOCKED=''Y'' where INRE_InpatientId='+IntToStr(Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger));
                    ExecSQL;
               end;

               IF RB_Internal.Checked=True Then
               begin
                    With Query_Process do
                    begin
                         Close;
                         SQL.Clear;
                         if Query_ShowBillList.FieldByName('IsLocked').AsString='Y' then
                         SQL.Add(' Update HS_SPDE_SpecialDeposit Set SPDE_ISTRANSLOCKED=''N'' where SPDE_InpatientId='+IntToStr(Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger))
                         else
                         SQL.Add(' Update HS_SPDE_SpecialDeposit Set SPDE_ISTRANSLOCKED=''Y'' where SPDE_InpatientId='+IntToStr(Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger));
                         ExecSQL;
                    end;
               end;
          End
          else
          begin
               With Query_Process do
               begin
                    Close;
                    SQL.Clear;
                    if Query_ShowBillList.FieldByName('IsLocked').AsString='Y' then
                    SQL.Add(' Update HS_FRDE_FractionDetail Set FRDE_ISFRACTIONLOCKED=''N'' where FRDE_BillNo='+#39+Query_ShowBillList.FieldByName('BIDE_BillNo').AsString+#39)
                    else
                    SQL.Add(' Update HS_FRDE_FractionDetail Set FRDE_ISFRACTIONLOCKED=''Y'' where FRDE_BillNo='+#39+Query_ShowBillList.FieldByName('BIDE_BillNo').AsString+#39);
                    ExecSQL;

                    Close;
                    SQL.Clear;
                    if Query_ShowBillList.FieldByName('IsLocked').AsString='Y' then
                    SQL.Add(' Update HS_FRRD_FractionRefundDetail Set FRRD_ISFRACTIONLOCKED=''N'' where FRRD_FractionDetailId In (')
                    else
                    SQL.Add(' Update HS_FRRD_FractionRefundDetail Set FRRD_ISFRACTIONLOCKED=''Y'' where FRRD_FractionDetailId In (');
                    SQL.Add(' Select FRDE_FractionDetailId From HS_FRDE_FractionDetail where FRDE_BillNo='+#39+Query_ShowBillList.FieldByName('BIDE_BillNo').AsString+#39+')');
                    ExecSQL;
               end;
          End;


          with Query_Process do
          begin
               Close;
               SQL.Clear;
               SQL.add(' Insert Into HS_LOG_FRACTIONLOCKUNLOCK(LOG_FLLID,LOG_UserId,LOG_LockDate,LOG_LockTime,LOG_UnLockDate,LOG_UnLockTime,LOG_DOCID,LOG_DocCode,');
               SQL.add(' LOG_DateFrom,LOG_DateTo,LOG_BillNo,LOG_PatientID,LOG_InpatientId,LOG_LogType,LOG_TRANSTYPE) Values ');
               SQL.add(' ( '+IntToStr(GetMaxId('HS_LOG_FRACTIONLOCKUNLOCK','LOG_FLLID'))+','+IntToStr(gi_UserId));
               if Query_ShowBillList.FieldByName('IsLocked').AsString='Y' then
               SQL.add(' ,'''','''','+#39+ServerDate.TodaysDate+#39+','+#39+ServerDate.TodaysTime+#39)
               else
               SQL.add(' ,'+#39+ServerDate.TodaysDate+#39+','+#39+ServerDate.TodaysTime+#39+','''',''''');
               if DBLCB_Doctor.KeyValue<>Null then
               begin
                    SQL.Add(','+IntToStr(DBLCB_Doctor.KeyValue));
                    SQL.Add(','+#39+Query_Doctor.FieldByName('Doccode').AsString+#39);
               end
               else
               begin
                    SQL.Add(','+IntToStr(0));
                    SQL.Add(','+'''''');
               end;

               SQL.add(' ,'+#39+Query_ShowBillList.FieldByName('BIDE_BillDate').AsString+#39);
               SQL.add(' ,'+#39+Query_ShowBillList.FieldByName('BIDE_BillDate').AsString+#39);

               SQL.add(' ,'+#39+Query_ShowBillList.FieldByName('BIDE_BillNo').AsString+#39);
               SQL.add(' ,'+IntToStr(Query_ShowBillList.FieldByName('BIDE_PatientId').AsInteger));
               SQL.add(' ,'+IntToStr(Query_ShowBillList.FieldByName('BIDE_InpatientID').AsInteger));
               SQL.add(' ,''INDIVIDUAL''');
               if RB_External.Checked=True then
               SQL.add(' ,''EXTERNAL'')')
               Else
               SQL.add(' ,''INTERNAL'')');
               ExecSQL;
          end;
     End
     else
     begin
          if Copy(DEX_From.Text,6,2)<>Copy(DEX_To.Text,6,2) then
          Begin
               MessageDlg(' Sorry ! You Can Lock Transaction of Single Month Only.',mtWarning,[mbok],0);
               DEX_To.SetFocus;
               Exit;
          End;


          if DEX_From.Text<>Copy(DEX_From.Text,1,8)+'01' then
          Begin
               MessageDlg(' Sorry ! From Date Must Be Start With 01',mtWarning,[mbok],0);
               DEX_From.SetFocus;
               Exit;
          End;

          ls_ToDate:=DEX_To.Text;
          DEX_To.Text:=Copy(DEX_From.Text,1,8)+'32';

          if ls_ToDate<>DEX_To.Text then
          Begin
               MessageDlg(' Sorry ! To Date Must Be of Month End Days',mtWarning,[mbok],0);
               DEX_From.SetFocus;
               Exit;
          End;

          if RB_External.Checked then
          Begin
               with Query_Process do
               begin
                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_FRDE_FractionDetail Set FRDE_ISFRACTIONLOCKED=''N'' where FRDE_FRACTIONDETAILID In (');
                    SQL.Add(' Select FRDE_FractionDetailId From HS_BIDE_BillDetail BD,HS_FRDE_FractionDetail FD');
                    SQL.Add(' where BIDE_BillDetailID=FRDE_BillDetailId and BD.BIDE_BillType In (''B'',''R'') and FRDE_TestNameCode<>''IPCON''');
                    SQL.Add(' and BIDE_BillDate>='+#39+DEX_From.Text+#39+' and BIDE_BillDate<='+#39+DEX_To.Text+#39+')');
                    ExecSQL;

                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_FRDE_FractionDetail Set FRDE_ISFRACTIONLOCKED=''N'' where FRDE_FRACTIONDETAILID In (');
                    SQL.Add(' Select FRDE_FractionDetailId From HS_FRDE_FractionDetail FD');
                    SQL.Add(' where FRDE_InpatientId In (Select INRE_InpatientId From HS_INRE_InpatientReg where INRE_IsDischarged=''Y''');
                    SQL.Add(' and INRE_DisDate>='+#39+DEX_From.Text+#39+' and INRE_DisDate<='+#39+DEX_To.Text+#39+'))');
                    ExecSQL;

                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_INRE_InpatientReg Set INRE_ISTRANSLOCKED=''N'' where INRE_IsDischarged=''Y''');
                    SQL.Add(' and INRE_DisDate>='+#39+DEX_From.Text+#39+' and INRE_DisDate<='+#39+DEX_To.Text+#39);
                    ExecSQL;


                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_LOG_FRACTIONLOCKUNLOCK Set LOG_ISLOCKED=''N''');
                    SQL.Add(' where LOG_DATEFROM>='+#39+DEX_From.Text+#39+' and LOG_DATETO<='+#39+DEX_To.Text+#39);
                    SQL.Add(' and LOG_TRANSTYPE=''EXTERNAL'' and LOG_LOGTYPE=''MASS''');
                    ExecSQL;
               end;
          End
          else
          Begin
               with Query_Process do
               begin
                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_FRDE_FractionDetail Set FRDE_ISFRACTIONLOCKED=''N'' where FRDE_InpatientId In (');
                    SQL.Add(' Select INRE_InpatientId From HS_INRE_InpatientReg where INRE_IsDisInDeposit=''Y'' and INRE_DISINDEPOSITESCHEME=22');
                    SQL.Add(' and INRE_SPLDISINDEPOCASHDATE>='+#39+DEX_From.Text+#39+' and INRE_SPLDISINDEPOCASHDATE<='+#39+DEX_To.Text+#39+')');
                    ExecSQL;

                    Close;
                    SQL.Clear;
                    SQL.Add(' Update HS_SPDE_SpecialDeposit Set SPDE_ISTRANSLOCKED=''N'' where SPDE_InpatientId In (');
                    SQL.Add(' Select INRE_InpatientId From HS_INRE_InpatientReg where INRE_IsDisInDeposit=''Y'' and INRE_DISINDEPOSITESCHEME=22');
                    SQL.Add(' and INRE_SPLDISINDEPOCASHDATE>='+#39+DEX_From.Text+#39+' and INRE_SPLDISINDEPOCASHDATE<='+#39+DEX_To.Text+#39+')');
                    ExecSQL;


                    Close;
                    SQL.Clear;
                    SQL.Add(' Update HS_INRE_InpatientReg Set INRE_ISTRANSLOCKED=''N'' where INRE_InpatientId In (');
                    SQL.Add(' Select INRE_InpatientId From HS_INRE_InpatientReg where INRE_IsDisInDeposit=''Y'' and INRE_DISINDEPOSITESCHEME=22');
                    SQL.Add(' and INRE_SPLDISINDEPOCASHDATE>='+#39+DEX_From.Text+#39+' and INRE_SPLDISINDEPOCASHDATE<='+#39+DEX_To.Text+#39+')');
                    ExecSQL;


                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_LOG_FRACTIONLOCKUNLOCK Set LOG_ISLOCKED=''N''');
                    SQL.Add(' where LOG_DATEFROM>='+#39+DEX_From.Text+#39+' and LOG_DATETO<='+#39+DEX_To.Text+#39);
                    SQL.Add(' and LOG_TRANSTYPE=''INTERNAL'' and LOG_LOGTYPE=''MASS''');
                    ExecSQL;
               End;
          End;

          with Query_Process do
          begin
               Close;
               SQL.Clear;
               SQL.add(' Insert Into HS_LOG_FRACTIONLOCKUNLOCK(LOG_FLLID,LOG_UserId,LOG_UnLockDate,LOG_UnLockTime,LOG_DOCID,LOG_DocCode,');
               SQL.add(' LOG_DateFrom,LOG_DateTo,LOG_LogType,LOG_TransType) Values ');
               SQL.add(' ( '+IntToStr(GetMaxId('HS_LOG_FRACTIONLOCKUNLOCK','LOG_FLLID'))+','+IntToStr(gi_UserId));
               SQL.add(' ,'+#39+ServerDate.TodaysDate+#39+','+#39+ServerDate.TodaysTime+#39);
               if DBLCB_Doctor.KeyValue<>Null then
               begin
                    SQL.Add(','+IntToStr(DBLCB_Doctor.KeyValue));
                    SQL.Add(','+#39+Query_Doctor.FieldByName('Doccode').AsString+#39);
               end
               else
               begin
                    SQL.Add(','+IntToStr(0));
                    SQL.Add(','+'''''');
               end;
               SQL.add(' ,'+#39+DEX_From.Text+#39);
               SQL.add(' ,'+#39+DEX_To.Text+#39);
               SQL.add(' ,''MASS''');
               if RB_External.Checked then
               SQL.add(' ,''EXTERNAL'')')
               else
               SQL.add(' ,''INTERNAL'')');
               ExecSQL;
          end;
     end;

     ShowDoneMessage;
     ShowLockReport;

     if CB_All.Checked=False then
     Begin
          SPB_ShowFractionLockStatusClick(Sender);
          if RB_External.Checked=True then
          Query_ShowBillList.Locate('BIDE_BillNo',ps_BillNo,[])
          Else
          Query_ShowBillList.Locate('BIDE_InpatientId',pi_InpatientId,[]);
     End;

end;

