Procedure TForm_SelectDoctor.Postdata;
Var li_Sno:Integer;
Begin
     with Query_VariableComm do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select POWF_ISFIXEDPERSONFORFRACTION,POWF_FRACTIONRATE,POWF_FRACTIONAMOUNT From HS_POWF_PositionWiseFraction where');
          sql.add(' POWF_ISFIXEDPERSONFORFRACTION=''N'' and POWF_POSITIONWISEFRACTIONID='+IntToStr(pi_PositionWiseCommId));
          Open;
     End;

     IF Query_VariableComm.FieldByName('POWF_ISFIXEDPERSONFORFRACTION').AsString='Y' Then
     Begin
          MessageDlg('Sorry ! You Cannot Change This Fixed Person. Who Get Share.'+Char(10)+Char(10)+
          'Suggestion ->  If you have to change person you must remove fixed '+Char(10)+'    person status in setup for this Investigation.'
          ,mtwarning,[mbok],0);
          Exit;
     End;

     IF ps_AccessFrom='Billing_DocSelection' then
     Begin
          With Query_TempProcess do
          Begin
               Close;
               DatabaseName:=gs_TempPath;
               sql.Clear;
               sql.add(' Update ServiceWiseFraction.db Set Doccode='+#39+Query_Doctor.FieldbyName('Doccode') .AsString+#39);
               sql.add(' ,DocID='+IntToStr(Query_Doctor.FieldbyName('DocID') .AsInteger));
               sql.add(' ,DocName='+#39+Query_Doctor.FieldbyName('DocName') .AsString+#39);
               sql.add(' where POSITIONWISEFRACTIONID='+IntToStr(pi_PositionWiseCommId));
               //sql.add(' ,IsFixedPersonForFraction='+#39+Query_VariableComm.FieldbyName('POWF_ISFIXEDPERSONFORFRACTION') .AsString+#39);
               //sql.add(' ,DocRatePer='+Query_VariableComm.FieldByName('CommRateA').AsString);
               // Check it is not posting amount  By Amrit
               {IF pf_StdTestPrice > 0 Then
               sql.add(' ,DocAmount='+Query_VariableComm.FieldByName('CommAmtA').AsString);
               }
               //sql.add(' ,UnitTestCost='+FloatToStr(pf_UnitTestCost));
               //sql.add(' ,Salarybaserate='+Floattostr(Query_Doctor.FieldbyName('Salarybaserate').AsFloat));
               //sql.add(' where Sno='+IntToStr(pi_Sno));
               ExecSQL;
          End;
     End
     Else IF ps_AccessFrom='Discharge_OperationChrg' Then
     Begin
          With Query_TempProcess do
          Begin
               Close;
               DatabaseName:=gs_TempPath;
               sql.Clear;
               sql.add(' Update FractionBreakUp.db Set DrCode='+#39+Query_Doctor.FieldbyName('DocCode').AsString+#39);
               sql.add(' ,DrName='+#39+Query_Doctor.FieldbyName('DocName').AsString+#39);
               sql.add(' ,IsFixedPersonForComm='+#39+Query_VariableComm.FieldbyName('IsFixedPersonForComm').AsString+#39);
               sql.add(' ,DocRatePer='+Query_VariableComm.FieldByName('CommRateA').AsString);
               IF pf_StdTestPrice > 0 Then
               sql.add(' ,DocAmount='+Query_VariableComm.FieldByName('CommAmtA').AsString);
               sql.add(' ,UnitTestCost='+FloatToStr(pf_UnitTestCost));
               sql.add(' ,Salarybaserate='+Floattostr(Query_Doctor.FieldbyName('Salarybaserate').AsFloat));
               sql.add(' where Sno='+IntToStr(pi_Sno));
               ExecSQL;
          End;
     End;
     Close;
End;

END.
