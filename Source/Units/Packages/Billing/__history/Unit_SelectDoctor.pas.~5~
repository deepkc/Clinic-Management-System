var
  Form_SelectDoctor: TForm_SelectDoctor;

implementation


{$R *.DFM}

procedure TForm_SelectDoctor.Edit_SearchChange(Sender: TObject);
begin
     With Query_Doctor Do
     Begin
          Filtered:=False;
          If Trim(Edit_Search.Text)<>'' Then
          Begin
               Filter:=' DocCode='+#39+Edit_Search.Text+'*'+#39+' OR '+
                       ' DocName='+#39+Edit_Search.Text+'*'+#39;
               Filtered:=True;
          End;
     End;
end;

procedure TForm_SelectDoctor.FormClose(Sender: TObject;
  var Action: TCloseAction);
begin
     Action:=caFree;
end;

procedure TForm_SelectDoctor.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
     If (key=27) THEN  close;
     If (key=40) AND  (ActiveControl<>DBGrid1) then  Query_Doctor.Next;
     If (key=38) AND  (ActiveControl<>DBGrid1) then  Query_Doctor.Prior;

     IF pb_New=False Then
     Begin
          //Key:=0;
          pb_New:=True;
     End;
     If (key=13) AND  (Query_Doctor.RecordCount > 0) then
     Postdata;

end;

