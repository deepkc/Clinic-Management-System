          Begin
               Close;
               ParamByName('DepCode') .AsString:=DepCode;
               Open;
          End;
     End
     Else If (ps_AccessFrom ='Billing_DocSelection') or (ps_AccessFrom ='Discharge_OperationChrg') then
     Begin
          With Query_Doctor Do
          Begin
               Close;
               Session:=DM_Hospital.DB;
               (*Sql.Clear;
               Sql.Add(' Select D.DocID,D.DOCCODE,D.DepCode,D.F_NAME||'' ''||D.L_NAME AS DocNAME,D.Salarybaserate From Doctor D ');
               Sql.Add(' Where D.DActive=''Y''');
               IF pi_PositionId=1 Then // 1 -ANAESTHESIA
               Sql.Add(' and DepCode In (Select DepCode From Department where DepId=78)')
               Else
               Sql.Add(' and DepCode Not In (Select DepCode From Department where DepId=78)');
               Sql.Add(' Order By D.F_Name ');*)
               Open;
          End;
          //DBGrid1.Columns[2].Visible:=True;
          //DBGrid1.Columns[1].Width:=240;
     End;
     pb_New:=False;
     Edit_Search.SetFocus;
end;

