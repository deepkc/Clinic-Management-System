    object Query_GetPatientTest: TOraQuery
    SQL.Strings = (
            
              'SELECT distinct PT.PatientTestID, PT.DepCode,PD.TestID,tena_DepI' +
              'D,PT.TestNameID, PT.TestNameCode, PT.PatientID,SubStr( PT.FINDIN' +
              'GPOSTDATETIME,0,10)TestDate,SubStr( PT.FINDINGPOSTDATETIME,11,10' +
              ')TestTime,'
            
              ' PT.WorkingStatus, PT.Special, TENA_REPORTINGTYPE, TENA_DISPLAYO' +
              'RDER,PR.SAMPLETAKENDATE, PR.SAMPLETAKENTIME,'
            
              ' tena_TestName NTestName, PT.BillNo,PT.InpatientId,PR.sampleno,P' +
              'D.Finding,PD.Unit,PD.RefRange,'
            
              ' (Select Test From Test Where TestID=PD.TestID) Test,tena_TestNa' +
              'me as TestName'
            
              ' FROM PatientTest PT,hs_tena_Testname TN,hs_pama_Patientmain PM,' +
              'samplecollection PR,PatientTestDetail PD,Test T'
            
              ' WHERE  (PT.TestNameID = tena_TestNameID(+)) AND (PT.PatientID =' +
              ' pama_PatientID(+)) AND'
            
              '                PT.PatientTestID=PD.PatientTestID(+) And PT.Test' +
              'NameID=PD.TestNameID(+)  And (PT.PatientTestID=PR.PatientTestID)' +
              ' And'
            'PT.InPatientID=141 And'
            
              '                (PT.TestDate >='#39'2072/04/01'#39' and PT.TestDate <='#39'2' +
              '072/04/01'#39')'
            '                AND(39=39 )'
            '                AND  (39=39)'
            '                And (39=39)'
            
              'Order By PR.SAMPLETAKENDATE Desc, PR.SAMPLETAKENTIME,tena_TestNa' +
              'me')
    Left = 227
    Top = 226
  end
