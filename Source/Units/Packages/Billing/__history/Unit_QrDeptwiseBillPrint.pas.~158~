procedure TForm_QrDepWiseBill.CreateTemp;
begin
     if FileExists(gs_temppath + '\QrBillDept.db') then
     begin
          with Table_QrBill do
          begin
               close;
               databasename := gs_temppath;
               TableName := 'QrBillDept.db';
               DeleteTable;
          end;
     end;
     with Table_QrBill do
     begin
          close;
          databasename := gs_temppath;
          TableType:= ttDefault;
          TableName:= 'QrBillDept.db';
          FieldDefs.Clear;
          FieldDefs.Add('DepartmentName', ftString, 100);
          FieldDefs.Add('DepName', ftString, 100);
          FieldDefs.Add('TestName', ftString, 100);
          FieldDefs.Add('IsPackageTest', ftString, 3);
          FieldDefs.Add('PackageData', ftString, 200);

          CreateTable;
          Open;
     end;
end;

