procedure TForm_Deposits.Le_HosNoKeyPress(Sender: TObject; var Key: Char);
begin
     if key=#13 then
     begin
          if Le_HosNo.Text<>'' then
          begin
               Pi_PatientId:=StrToInt(Le_HosNo.Text);
               Label_HospitalNo.Caption:=Le_HosNo.Text;

               if IsRegisteredPatient(StrToInt(Le_HosNo.Text)) then
               begin
                    gi_PatientID:=StrToInt(Le_HosNo.Text);
                    LoadPatientData(gi_PatientID);
                    lbl_PatientName.Caption:=Gs_PatientName;
                    Lbl_CurrentAgeGender.caption:=Gs_CurrentAgeGender;
                    Lbl_address.Caption:=Gs_Address;
                    Lbl_Phoneno.Caption:=Gs_MobileNo;

               end
               else
               begin
                    ShowMessage('Please Select Registered Patient ');
                    Le_HosNo.SetFocus;
                    exit;
               end;
          end;

          With query_process do
          begin
               Close;
               SQL.Clear;
               SQL.Add(' Select INRE_InpatientId Inpatientid,INRE_DISINDEPOSITTRANSID DISINDEPOSITTRANSID,INRE_SchemeId SchemeId,(Select SCHE_Scheme From HS_SCHE_Scheme where ');
               SQL.Add(' SCHE_SchemeId=IPR.INRE_SchemeId) Scheme From HS_INRE_INPATIENTREG IPR where INRE_PatientId='+IntToStr(gi_PatientID));
               SQL.Add(' and INRE_IsDischarged=''N''and Inre_IsDisinDeposit=''N''');
               SQL.Add('Order By Inre_Inpatientid Desc');
               Open;
          end;

          if query_process.FieldByName('InpatientId').AsInteger <=0 then
          begin
               With query_process do
               begin
                    Close;
                    SQL.Clear;
                    SQL.Add(' Select INRE_PatientId PatientId,INRE_InpatientId InpatientId,INRE_DISINDEPOSITTRANSID DISINDEPOSITTRANSID,INRE_SchemeId SchemeId,(Select SCHE_Scheme From HS_SCHE_Scheme where ');
                    SQL.Add(' SCHE_SchemeId=IPR.INRE_SchemeId) Scheme From HS_INRE_InpatientReg IPR');
                    SQL.Add(' where INRE_InpatientId In (Select Max(INRE_InpatientId) From HS_INRE_Inpatientreg where  INRE_PatientId='+IntToStr(gi_PatientID));
                    SQL.Add(' )');
                    Open;
               end;

               if query_process.FieldByName('InpatientId').AsInteger > 0 then
               Begin
                    IF MessageDlg('Patient is already discharged. Do you want to continue ?',mtConfirmation,[mbyes,mbNo],0)=mrno Then
                    Exit;
               End;
               {
               Else
               Begin
                    MessageDlg('Sorry No Patient Admitted With This Hospital No Till Date.',mtWarning,[mbOK],0);
                    Exit;
               End;}
          end;


          DisplayBasicInfo;
          lbl_Scheme.Caption:=query_process.FieldByName('Scheme').AsString;

          gi_InPatientID:=query_process.FieldByName('InpatientId').AsInteger;
          pi_InPatientID:=query_process.FieldByName('InpatientId').AsInteger;
          LBL_InpatientId.Text:=IntToStr(query_process.FieldByName('InpatientId').AsInteger);
          pi_DISINDEPOSITTRANSID:=query_process.FieldByName('DISINDEPOSITTRANSID').AsInteger;

          loaddata;
          //lbl_RemainingBalance.Caption:=FormatFloat('#0,0.00',(GetDepositBalance(gi_PatientID)));
          Dblcb_DepositType.SetFocus;

     end;
end;

