procedure TForm_Deposits.BB_SaveClick(Sender: TObject);
Var
     DrAmount,CrAmount,DepositBalance: Double;
     DepositType,Remarks,ls_ReferenceDepositNo, ls_IsOldDeposit:String;
begin
     if CB_IsDepositRefund.checked=True then
     begin
          with OraQueryCheck do
          begin
               close;
               Session:=DM_Hospital.DB;
               sql.Clear;
               sql.Add('select * from HS_DEPO_Deposit where DEPO_PATIENTID='+(Le_HosNo.text)+' and DEPO_DEPOSITNO='+QuotedStr(Edit_PreveBillNo.Text));
               //sql.SaveToFile('C:\abc23.txt');
               open;
          end;
          if OraQueryCheck.RecordCount=0 then
          begin
               ShowMessage('Illegal Operation');
               exit;
          end;

     end;

     if IsRegisteredPatient(StrToInt(Le_HosNo.Text)) then
     begin

     end
     else
     begin
          ShowMessage('Please Select Registered Patient ');
          Le_HosNo.SetFocus;
          exit;
     end;

     if StrToInt(Le_HosNo.Text)<>StrToInt(Label_HospitalNo.Caption) then
     begin
          MessageDlg('Hospital No Mismatch ! The displaying no is " '+Le_HosNo.Text+' " but you are doing bed exchange for this no " '+Label_HospitalNo.Caption+' ".',
          mtWarning,[mbOK],0);
          Le_HosNo.SetFocus;
          Exit;
     end;

     if gi_PatientId<>StrToInt(Le_HosNo.Text) then
     Begin
          MessageDlg('Please Check Patient Name Properly.',mtWarning,[mbok],0);
          Exit;
     End;

     if gi_InPatientId<>StrToInt(LBL_InpatientId.Text) then
     Begin
          MessageDlg('Please Check Patient Name Properly.',mtWarning,[mbok],0);
          Exit;
     End;

     if Trim(Le_Payment.Text) = '' then
     begin
          ShowMessage('Amount is blank, Please fill the Amount');
          Exit;
     end;

     if Trim(Dblcb_DepositType.Text)='' then
     begin
          MessageDlg('Please Select Deposit Type.',mtInformation,[mbok],0);
          Dblcb_DepositType.SetFocus;
          Exit;
     end;

     if StrToFloat(Le_Payment.Text) = 0 then
     begin
          MessageDlg('Amount is zero, Please fill the Amount',mtInformation,[mbok],0);
          Le_Payment.SetFocus;
          Exit;
     end;

     With query_process do
     begin
          Close;
          SQL.Clear;
          SQL.Add(' Select Inre_InpatientId Inpatientid,Inre_DISINDEPOSITTRANSID DISINDEPOSITTRANSID From HS_INRE_InpatientReg where Inre_PatientId='+IntToStr(gi_PatientID));
          SQL.Add(' and Inre_IsDischarged=''N''');
          Open;
     end;

    { if gi_compileValue<>21 then
     begin
          if (query_process.FieldByName('InpatientId').AsInteger <=0) and (Dblcb_DepositType.KeyValue=1) then
          begin
               MessageDlg('Sorry No Patient Admitted with this hospital no.',mtWarning,[mbOK],0);
               Exit;
          end;
     end; }

     gi_InPatientID:=query_process.FieldByName('InpatientId').AsInteger;
     pi_DISINDEPOSITTRANSID:=query_process.FieldByName('DISINDEPOSITTRANSID').AsInteger;

      if gi_compileValue<>21 then
     begin
          if ISTRANSLOCKED(gi_InPatientID) = True then
          begin
               MessageDlg('Sorry ! Transaction is already locked.',mtWarning,[mbOK],0);
               Exit;
          end;
     end;

     if Cb_Mode.ItemIndex=0 then
     begin
          DrAmount:=StrToFloat(Le_Payment.Text);
          CrAmount:=0;
          DepositType:='DEPOSIT';
          //Remarks:='DEPOSIT FOR '+Dblcb_DepositType.KeyValue;
          ls_ReferenceDepositNo:='';

          (*if (pf_DueAmount > 0) and (DrAmount < (pf_DueAmount-pf_DepTotAfterSampleNotReceived)) then
          Begin
               IF Not (MessageDlg('Deposit Amount Couldn''t Covered the Due Amount for Sample Collection. Still Sample Couldn''t Collect.'+Char(10)+
               'Despite of this do you want to take deposit ?', mtConfirmation,[mbYes,mbNo],0)=mrYes) Then
               Exit;
          End;*)
     end
     else
     if Cb_Mode.ItemIndex=1 then
     begin
          if (Edit_PreveBillNo.Text)='' then
          begin
               MessageDlg('Please Select Previous Deposit No.',mtWarning,[mbOK],0);
               Edit_PreveBillNo.SetFocus;
               Exit;
          end;

          if Copy(Edit_PreveBillNo.Text,1,2)='DR' then
          begin
               MessageDlg('This is Deposit Refund No. So You Cannot Refund Again With This No.',mtWarning,[mbOK],0);
               Edit_PreveBillNo.SetFocus;
               Exit;
          end;

          With Query_Process do
          begin
               Close;
               SQL.Clear;
               SQL.Add(' Select DEPO_DepositId,DEPO_REFERENCENO From HS_DEPO_Deposit where DEPO_DepositNo='+#39+Edit_PreveBillNo.Text+#39);
               sql.add(' and DEPO_REFERENCENO not like ''TP%'' or DEPO_REFERENCENO is null');
               //SQL.Add(' and DEPO_InPatientId='+IntToStr(pi_InPatientID));
              // sql.savetofile('C:\abc1r.txt');
               Open;
          end;

          if Query_Process.FieldByName('DEPO_DepositId').AsInteger=0 then
          begin
               MessageDlg('No Deposit Exist With This Deposit No., Please Put Proper Previous Deposit No.',mtWarning,[mbOK],0);
               Edit_PreveBillNo.SetFocus;
               Exit;
          end;

          if Trim(Query_Process.FieldByName('DEPO_REFERENCENO').AsString)<>''  then
          begin
               MessageDlg('Sorry This is Advance Deposit. You Can Refund Only Admission Deposit or Top Up Deposit.',mtWarning,[mbOK],0);
               Edit_PreveBillNo.SetFocus;
               Exit;
          end;
          With Query_Process do
          begin
               Close;
               SQL.Clear;
               SQL.Add(' Select DEPO_DepositId,DEPO_REFERENCENO From HS_DEPO_Deposit where DEPO_REFERENCENO='+#39+Edit_PreveBillNo.Text+#39);
               //SQL.Add(' and DEPO_InPatientId='+IntToStr(pi_InPatientID));
               Open;
          end;
          if Query_Process.FieldByName('DEPO_DepositId').AsInteger > 0 then
          begin
               MessageDlg('Deposit Is Already Refunded With This No. Please Check Properly.',mtWarning,[mbOK],0);
               Edit_PreveBillNo.SetFocus;
               Exit;
          end;
          ls_ReferenceDepositNo:=Edit_PreveBillNo.Text;
          DrAmount:=0;
          CrAmount:=StrToFloat(Le_Payment.Text);
          DepositType:='DEPOSIT REFUND';
          //Remarks:='DEPOSIT REFUND FOR '+Dblcb_DepositType.KeyValue;

          DepositBalance:=GetInpatientDepositBalance(gi_InPatientID);

          if CrAmount > DepositBalance then
          begin
               MessageDlg('Illegal Operation!!! Depost Balance Is Less Than Refund Amount',mtError,[mbOK],0);
               Exit;
          end;

     end;
     gi_PatientID:=StrToInt(Le_HosNo.Text);
     gi_InPatientID:=StrToInt(LBL_InpatientId.Text);

     if Dblcb_DepositType.keyvalue=2 then
     begin
          LBL_InpatientId.text:='0';
          gi_inpatientid:=0;
     end;

     pi_PatientID:=gi_PatientID;
     pi_InPatientID:=gi_InPatientID;

     if gi_compileValue<>21 then
     begin
         { if (gi_InPatientID=0) and (Dblcb_DepositType.KeyValue=1) then
          begin
               MessageDlg('IP No Shouldn''t be Zero(0), Please Check IP No Properly.',mtWarning,[mbOK],0);
               LBL_InpatientId.SetFocus;
               Exit;
          end;}
     end;

     if CB_OLDDeposit.Checked=True then
     ls_IsOldDeposit:='Y'
     else
     ls_IsOldDeposit:='N';


     ps_TodaysDate:=TodaysDate;
     ps_TodaysTime:=TodaysTime;

     Try
          DM_Hospital.DB.StartTransaction;
          (*Try
               SaveDeposit(0, 0, gi_PatientId, gi_UserID, DrAmount, CrAmount,DepositType ,Dblcb_DepositType.KeyValue,'', TodaysDate, TodaysTime,
                    Remarks);
          Except
              SaveDeposit(0, 0, gi_PatientId, gi_UserID, DrAmount, CrAmount,DepositType ,Dblcb_DepositType.KeyValue,'', TodaysDate, TodaysTime,
                    Remarks);
          End;*)

          (*
               SaveDeposit(DEPOSITHEADID,INPATIENTID,PATIENTID,BANKID,DEPOSITBY : Integer ;DRAMOUNT,CRAMOUNT :Double;
                      DEPOSITTYPE,REFERENCETYPE,REFERENCENO,CHEQUENO,REMARKS,DEPOSITDATE,DEPOSITTIME :string); Stdcall;
          *)
          Try
               SaveDeposit(0, pi_InPatientID, pi_PatientId, 0, gi_UserID,0, DrAmount,CrAmount,
                         DepositType , '', ls_ReferenceDepositNo, '', '', Ps_TodaysDate, Ps_TodaysTime,'N',GetPatientCagetory(pi_PatientId),ls_IsOldDeposit,'','N');
          except
               SaveDeposit(0, pi_InPatientID, pi_PatientId, 0, gi_UserID,0, DrAmount,CrAmount,
                         DepositType , '', ls_ReferenceDepositNo, '', '', Ps_TodaysDate, Ps_TodaysTime,'N',GetPatientCagetory(pi_PatientId),ls_IsOldDeposit,'','N');
          End;

          (*if DrAmount > 0 then // Deposit Coln.
          Begin
               if pf_DueAmount <= (pf_DepTotAfterSampleNotReceived + DrAmount) then
               PermissionToSampleCollect;
          End;*)

          pb_IsReprint:=False;
          DM_Hospital.DB.Commit;
          ShowDoneMessage;
     Except
          DM_Hospital.DB.Rollback;
          MsgBox(1005, 0, '', '', '');
     End;

     if MessageDlg('Do You Want To Print ?',mtConfirmation,[mbYes,mbNo],0)=mrYes then
     PrintBill;

     loaddata;
     Le_Payment.Text:='';
     Dblcb_DepositType.KeyValue:=NULL;
     Cb_Mode.ItemIndex:=0;
     gi_PatientID:=0;
     lbl_PatientName.Caption:='';
     Edit_PreveBillNo.Text:='';
     CB_IsDepositRefund.Checked:=False;
//     free;
end;

