procedure TForm_Deposits.Edit_PreveBillNoKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
     if CB_IsDepositRefund.Checked=True then
     Begin
         IF (key=VK_ESCAPE) Then Edit_PreveBillNo.Text:='';

         IF (key=VK_Down) and (Query_List.Active)  Then
         Begin
              DBGrid_PrevBillNoInfo.Visible:=True;
              Query_List.Next;
              Edit_PreveBillNo.Text:=Query_List.FieldByName('DEPO_DEPOSITNO').AsString;
              Le_Payment.Text:=FloatToStr(Query_List.FieldByName('DEPO_DRAMOUNT').AsFloat);
         End;

         IF (key=VK_Up) and (Query_List.Active)  Then
         Begin
              DBGrid_PrevBillNoInfo.Visible:=True;
              Query_List.Prior;
              Edit_PreveBillNo.Text:=Query_List.FieldByName('DEPO_DEPOSITNO').AsString;
              Le_Payment.Text:=FloatToStr(Query_List.FieldByName('DEPO_DRAMOUNT').AsFloat);
         End;
     End;
end;

procedure TForm_Deposits.Edit_PreveBillNoKeyPress(Sender: TObject; var Key: Char);
begin
     if Key=#13 then
     Begin
          if (Trim(Edit_PreveBillNo.Text)='') and (CB_IsDepositRefund.Checked=True) then
          Begin
               MessageDlg('Please Put Previous Deposit No.',mtWarning,[mbOK],0);
