procedure TForm_SpecialDeposits.PermissionToSampleCollect;
Begin
     With Query_PendingSampleColnBill do
     Begin
          First;
          while Not EOF do
          Begin
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.Add(' Update PatientTest Set TestProgressStatus=2 where BillNo='+#39+Query_PendingSampleColnBill.FieldByName('BillNo').AsString+#39);
                    sql.Add(' and TestProgressStatus=1');
                    ExecSQL;
               End;
               Query_PendingSampleColnBill.Next;
          End;
     End;
End;

