procedure TForm_SpecialDeposits.loaddata;
Var
Ld_Total,Lc_Total:Double;
begin
     Query_DepositType.Close;
     Query_DepositType.Open;
     {
     if gi_InPatientID=0 then
     CB_AllDepositIPWise.Checked:=True;  }
     with Query_List do
     begin
          close;
          databasename:=gs_DatabaseName;
          if CB_AllDepositIPWise.Checked=True then
          sql[1]:='Where SPDE_PATIENTID='+Inttostr(gi_PatientID)
          else
          begin
               if gi_InPatientID>0 then
               sql[1]:='Where SPDE_InPATIENTID='+Inttostr(gi_InPatientID)
               else
               sql[1]:='Where SPDE_PATIENTID='+Inttostr(gi_PatientID);
          end;

          if CB_ShowOldDeposit.Checked=True then
          sql[2]:=' Or (SPDE_PatientId='+IntToStr(gi_PatientID)+' and SPDE_InPATIENTID=0)'
          else
          sql[2]:=' ';

          open;
     end;
     Ld_Total:=00.00;
     Lc_Total:=0;
     Query_List.First;
     while not Query_List.Eof do
     begin
          Ld_Total:=Ld_Total+Query_List.FieldByName('SPDE_DrAmount').AsFloat;
          LC_Total:=Lc_Total+Query_List.FieldByName('SPDE_CrAmount').AsFloat;
          Query_List.Next;
     end;
     Label_RefundDeposit.Caption:=FormatFloat('#0,0.00',(Lc_Total));
     lbl_total.Caption:=FormatFloat('#0,0.00',(Ld_Total));
     lbl_RemainingBalance.Caption:=FormatFloat('#0,0.00',(Ld_Total-Lc_Total));
end;

