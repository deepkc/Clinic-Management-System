Procedure TForm_SpecialDeposits.IsSampleCollnBlockedDueLackofDeposit(PatientID: Integer);
Begin
     pf_DueAmount:=0;
     With Query_PendingSampleColnBill do
     Begin
          Close;
          DatabaseName:=gs_DatabaseName;
          sql.Clear;
          sql.add(' Select SEBD_BillNo,SEBD_BillDate,SEBD_BillTime,Sum((SEBD_Amount*SEBD_Qty)+SEBD_VatAmt-(SEBD_Amount*SEBD_Qty*SEBD_DisPer/100)) as Total');
          sql.add(' From HS_SEBD_ServiceBillDetail where SEBD_BillNo In (Select BillNo From PatientTest PT where PatientId='+IntToStr(PatientID));
          sql.add(' and PatientTestId Not In (Select TECA_PatientTestId From HS_TECA_TestCancel Where TECA_PatientTestId=PT.PatientTestId) and TestProgressStatus=1)');
          sql.add(' Group by SEBD_BillNo,SEBD_BillDate,SEBD_BillTime Order by SEBD_BillNo');
          Open;
          First;
          while not EOF do
          Begin
               pf_DueAmount:=pf_DueAmount+Query_PendingSampleColnBill.FieldByName('Total').AsFloat;
               Query_PendingSampleColnBill.Next;
          End;
     End;
     Query_PendingSampleColnBill.First;
     With Query_Process do
     Begin
          Close;
          DatabaseName:=gs_DatabaseName;
          sql.Clear;
          sql.Add(' Select Sum(SPDE_DrAmount-SPDE_CrAmount) as DepTotAfterSampleNotReceived From HS_SPDE_SPECIALDeposit where SPDE_PatientId='+IntToStr(PatientID));
          sql.Add(' and SPDE_DepositDate >='+#39+Query_PendingSampleColnBill.FieldByName('SEBD_BillDate').AsString+#39);
          sql.Add(' and SPDE_DepositTime >='+#39+Query_PendingSampleColnBill.FieldByName('SEBD_BillTime').AsString+#39);
          Open;
     End;
     pf_DepTotAfterSampleNotReceived:=Query_Process.FieldByName('DepTotAfterSampleNotReceived').AsFloat;
End;

