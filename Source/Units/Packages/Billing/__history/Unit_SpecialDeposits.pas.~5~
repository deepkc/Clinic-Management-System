procedure TForm_SpecialDeposits.SPB_DeleteClick(Sender: TObject);
Var ls_LogRemarks : string;
begin
     if (Query_List.FieldByName('SPDE_IsTransLocked').AsString='Y') Then
     (*and ((Query_List.FieldByName('SPDE_REFERENCETYPE').AsString='DISCHARGE ADJUSTED DEPOSIT')
     or (Query_List.FieldByName('SPDE_REFERENCETYPE').AsString='FINAL DISCHARGE COLN')) then*)
     begin
          MessageDlg('Sorry ! Transaction Is Already Locked.',mtWarning,[mbOK],0);
          Exit;
     end;

     if MessageDlg(' Are You Sure To Delete Deposit ?',mtConfirmation,[mbYes,mbNo],0)=mrYes then
     Begin
          ls_LogRemarks:=' DepositID='+Query_List.FieldByName('SPDE_DepositId').AsString+', PatientId='+Query_List.FieldByName('SPDE_PatientId').AsString+
                         ',InpatientId='+Query_List.FieldByName('SPDE_InpatientId').AsString;
          if Query_List.FieldByName('SPDE_CRAmount').AsFloat<>0 then
          ls_LogRemarks:=ls_LogRemarks+' , CrAmount='+Query_List.FieldByName('SPDE_CRAmount').AsString
          Else
          ls_LogRemarks:=ls_LogRemarks+' , DrAmount='+Query_List.FieldByName('SPDE_DrAmount').AsString;
          ls_LogRemarks:=ls_LogRemarks+' ,DepositType='+Query_List.FieldByName('SPDE_DepositType').AsString+', ReferenceType='+Query_List.FieldByName('SPDE_ReferenceType').AsString
                    +', DepositDate='+Query_List.FieldByName('SPDE_DEPOSITDATE').AsString+', DepositTime='+Query_List.FieldByName('SPDE_DEPOSITTIME').AsString+',DepositBy='+Query_List.FieldByName('SPDE_DEPOSITBY').AsString;


          With Query_Process do
          begin
               Close;
               DatabaseName:=gs_DatabaseName;
               SQL.Clear;
               SQL.add(' Insert Into HS_LOG_GLOBAL(LOG_LOGID,LOG_MODULENAME,LOG_USERID,LOG_DATAPOSTDATE,LOG_DATAPOSTTIME,LOG_REMARKS)');
               SQL.add(' Values ('+IntToStr(GetMaxId('HS_LOG_GLOBAL','LOG_LOGID'))+',''SPLDEPOISTDELETE'','+IntToStr(gi_UserID)+','+#39+TodaysDate+#39);
               SQL.add(' ,'+#39+TodaysTime+#39+','+#39+ls_LogRemarks+#39+')');
               ExecSQL;


               Close;
               SQL.Clear;
               SQL.Add(' Delete From HS_SPDE_SPECIALDEPOSIT ');
               SQL.Add(' where SPDE_DEPOSITID='+IntToStr(Query_List.FieldByName('SPDE_DEPOSITID').AsInteger));
               ExecSQL;
          end;
          ShowDoneMessage;
          loaddata;
     End;
end;

