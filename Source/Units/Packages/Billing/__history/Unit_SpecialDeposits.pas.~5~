procedure TForm_SpecialDeposits.Edit_PreveBillNoKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
     if CB_IsDepositRefund.Checked=True then
     Begin
         IF (key=VK_ESCAPE) Then Edit_PreveBillNo.Text:='';

         IF (key=VK_Down) and (Query_List.Active)  Then
         Begin
              DBGrid_PrevBillNoInfo.Visible:=True;
              Query_List.Next;
              Edit_PreveBillNo.Text:=Query_List.FieldByName('SPDE_DEPOSITNO').AsString;
              Le_Payment.Text:=FloatToStr(Query_List.FieldByName('SPDE_DRAMOUNT').AsFloat);
         End;

         IF (key=VK_Up) and (Query_List.Active)  Then
         Begin
              DBGrid_PrevBillNoInfo.Visible:=True;
              Query_List.Prior;
              Edit_PreveBillNo.Text:=Query_List.FieldByName('SPDE_DEPOSITNO').AsString;
              Le_Payment.Text:=FloatToStr(Query_List.FieldByName('SPDE_DRAMOUNT').AsFloat);
         End;
     End;
end;

procedure TForm_SpecialDeposits.Edit_PreveBillNoKeyPress(Sender: TObject; var Key: Char);
begin
     if Key=#13 then
     Begin
          if (Trim(Edit_PreveBillNo.Text)='') and (CB_IsDepositRefund.Checked=True) then
          Begin
               MessageDlg('Please Put Previous Deposit No.',mtWarning,[mbOK],0);
               Edit_PreveBillNo.SetFocus;
               Exit;
          End;
          DBGrid_PrevBillNoInfo.Visible:=False;
          With Query_Process do
          begin
               Close;
               SQL.Clear;
               SQL.Add(' Select SPDE_InpatientId,SPDE_DepositId,SPDE_REFERENCENO,SPDE_DRAMOUNT,SPDE_DepositType,');
               SQL.Add('(Select DEHE_DEPOSITHEADID From HS_DEHE_DEPOSITHEAD where DEHE_DEPOSITHEAD=SPDE_DepositType) as DepositTypeId');
               SQL.Add(' From HS_SPDE_SPECIALDeposit where SPDE_DepositNo='+#39+Edit_PreveBillNo.Text+#39);
               Open;
          end;

          Le_Payment.Text:=FloatToStr(Query_Process.FieldByName('SPDE_DRAMOUNT').AsFloat);

          if Query_Process.FieldByName('DepositTypeId').AsInteger > 0 then
          Dblcb_DepositType.KeyValue:=Query_Process.FieldByName('DepositTypeId').AsInteger;

          if Query_Process.FieldByName('SPDE_InpatientId').asInteger=0 then
          begin
               With Query_Process do
               begin
                    Close;
                    SQL.Clear;
                    SQL.Add(' Select SUM(SPDE_DRAMOUNT-SPDE_CRAMOUNT)TOTAL');
                    SQL.Add(' From HS_SPDE_SPECIALDeposit where SPDE_PATIENTID='+IntToSTr(gi_PatientID));
                    sql.add('and SPDE_DepositNo='+#39+Edit_PreveBillNo.Text+#39);
                    Open;
               end;
               if Query_Process.FieldByName('TOTAL').AsFloat>0 then
               Le_Payment.Text:=FloatToStr(Query_Process.FieldByName('TOTAL').AsFloat);
          end;
          Edit_Remarks.SetFocus;
     End;
end;

