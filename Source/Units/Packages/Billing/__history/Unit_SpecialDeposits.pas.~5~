procedure TForm_SpecialDeposits.LBL_InpatientIdKeyPress(Sender: TObject; var Key: Char);
begin
     if key=#13 then
     begin
          gi_InPatientID:=StrToInt(LBL_InpatientId.Text);
          With query_process do
          begin
               Close;
               SQL.Clear;
               SQL.Add(' Select Inre_InpatientId InpatientId,Inre_PatientId Patientid,Inre_DISINDEPOSITTRANSID DISINDEPOSITTRANSID,Inre_SchemeId Schemeid,');
               Sql.Add('(Select SCHE_Scheme From HS_SCHE_Scheme where SCHE_SchemeId=Inre_SchemeId) Scheme,');
               SQL.Add(' Inre_IsDischarged IsDischarged  From Hs_inre_InpatientReg IPR where Inre_InPatientId='+IntToStr(gi_InPatientID));
               //SQL.Add(' and IsDischarged=''N''');
               Open;
          end;

          if query_process.FieldByName('InpatientId').AsInteger <=0 then
          begin
               MessageDlg('Sorry No Patient Admitted with this Inpatient No.',mtWarning,[mbOK],0);
               Exit;
          end;

          if query_process.FieldByName('IsDischarged').AsString ='Y' then
          begin
               IF MessageDlg('Patient is already discharged with this IP No . Do you want to continuee ?',mtWarning,[mbyes,mbNo],0)=mrNo Then
               Exit;
          end;

          pi_DISINDEPOSITTRANSID:=query_process.FieldByName('DISINDEPOSITTRANSID').AsInteger;
          gi_InPatientID:=query_process.FieldByName('InpatientId').AsInteger;
          gi_PatientID:=query_process.FieldByName('patientId').AsInteger;
          pi_PatientID:=query_process.FieldByName('patientId').AsInteger;
          Le_HosNo.Text:=IntToStr(query_process.FieldByName('patientId').AsInteger);
          Label_HospitalNo.Caption:=Le_HosNo.Text;

          LoadPatientData(gi_PatientID);
          DisplayBasicInfo;
          lbl_Scheme.Caption:=query_process.FieldByName('Scheme').AsString;

          loaddata;
     end;
end;

