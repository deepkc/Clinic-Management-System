     DEX_To.SystemOfDate := gi_DateSystem;
     DEX_To.Text := ServerDate.TodaysDate;
     ChangeCaption(BitBtn_To);
     Query_Doctor.Close;
     Query_Doctor.DatabaseName:=gs_DatabaseName;
     Query_Doctor.Open;
     //CreateTemp;
end;

