procedure TForm_BillingParent.FormShow(Sender: TObject);
begin
     FrameCleared := true;
     { ***************************************** }
     Frame_BillList := TFrame_BillList.Create(nil);
     with Frame_BillList do
     begin
          Parent := PageControl1.Pages[1];
          Align := alClient;
          Show;
          Edit_Search.SetFocus;
     end;
     { ***************************************** }
end;

procedure TForm_BillingParent.PageControl1Change(Sender: TObject);
begin
     if PageControl1.ActivePageIndex = 1 then
     begin
          Label8.Visible := false;
          CB_PatientType.Visible := false;
     end
     else
     begin
          Label8.Visible := true;
          CB_PatientType.Visible := true;
     end;
end;

procedure TForm_BillingParent.SpeedButton1Click(Sender: TObject);
begin
     ChangeDateSystem(Dex_From, SpeedButton1);
end;

procedure TForm_BillingParent.SpeedButton2Click(Sender: TObject);
begin
     ChangeDateSystem(Dex_To, SpeedButton2);
end;

procedure TForm_BillingParent.SpeedButton3Click(Sender: TObject);
begin
     ChangeDateSystem(Dex_Today, SpeedButton3);
end;

procedure TForm_BillingParent.Se_DayChange(Sender: TObject);
begin
     if Se_Day.text <> '' then
     begin
          if StrToInt(Se_Day.text) < 0 then
               Se_Day.text := '0';
     end;
end;

procedure TForm_BillingParent.Se_DayKeyPress(Sender: TObject; var Key: Char);
begin
     if not(Key in ['0' .. '9', #8]) then
          Key := #8;
end;

procedure TForm_BillingParent.CB_PatientTypeClick(Sender: TObject);
begin
     if CB_PatientType.ItemIndex = 0 then
     begin
          { ***************************************** }
          clearFrame;
          FrameCleared := true;
          { ***************************************** }
     end
     else if CB_PatientType.ItemIndex = 1 then
     begin
          { ***************************************** }
          clearFrame;
          Frame_IndoorPatientList := TFrame_IndoorPatientList.Create(nil);
          with Frame_IndoorPatientList do
          begin
               Parent := PageControl1.Pages[0];
               Align := alClient;
               Show;
               FrameCleared := false;
          end;
          { ***************************************** }
     end
     else if CB_PatientType.ItemIndex = 2 then
     begin
          { ***************************************** }
          clearFrame;
          Frame_OutdoorPatientList := TFrame_OutdoorPatientList.Create(nil);
          with Frame_OutdoorPatientList do
          begin
               Parent := PageControl1.Pages[0]; ;
               Align := alClient;
               Show;
               FrameCleared := false;
          end;
          { ***************************************** }
     end;

end;

