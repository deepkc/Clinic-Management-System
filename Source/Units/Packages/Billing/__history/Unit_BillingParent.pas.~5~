procedure TForm_BillingParent.BB_CloseClick(Sender: TObject);
begin
     if FrameCleared or (gs_CalledFrom = 'BILLING') then
          Close
     else
          clearFrame;
     // Close;
end;

procedure TForm_BillingParent.BB_FinalBillingClick(Sender: TObject);
begin
     Frame_BillList:=TFrame_BillList.create(nil);
     Gs_BillNo := Frame_BillList.QueryList.FieldByName('BillNo').AsString;
     Label8.Visible := false;
     CB_PatientType.Visible := false;
     { SERVICE
       FINAL BILL
       DEPOSIT
       ADVANCE
       REFUND }
     if (Frame_BillList.CB_BillType.ItemIndex = 0) and Gb_isServiceBill then
          gi_BillCase := 1;
     if (Frame_BillList.CB_BillType.ItemIndex = 0) and (Gb_isServiceBill = false) then
          gi_BillCase := 2;
     if Frame_BillList.CB_BillType.ItemIndex = 1 then
          gi_BillCase := 4
     else if Frame_BillList.CB_BillType.ItemIndex = 2 then
          gi_BillCase := 5
     else if Frame_BillList.CB_BillType.ItemIndex = 4 then
          gi_BillCase := 7;
     { ***************************************** }
     clearFrame;
     Panel_Parent.BringToFront;
     //
    { Frame_Billing := TFrame_Billing.Create(nil);
     with Frame_Billing do
     begin
          Parent := Panel_Parent;
          Align := alClient;
          Show;
          if gi_BillCase = 2 then
               CB_PayType.SetFocus;
          FrameCleared := false;
     end; }


     Try
          Form_Billing:=TForm_Billing.Create(Nil);
          With Form_Billing do
          Begin
               //gi_PatientId:=Query_InpatientList.FieldByName('PatientId').AsInteger;
               gs_calledfrom:='Final Billing';
             //  gs_BillType:='OPBILL';
               Form_Billing.ShowModal;
          End;
     Finally
          Frame_Parent.BB_RefreshClick(Sender);
          Form_Billing.Free;
     End;
     { ***************************************** }
end;

procedure TForm_BillingParent.BB_RefundBillClick(Sender: TObject);
begin
     if not CheckAccess('REFUND BILL') then
     begin
          ShowMessage('Access Denied');
          exit;
     end;
     if Frame_BillList.QueryList.RecordCount = 0 then
     begin
          MsgBox(1026, 0, '', '', '');
          exit;
     end;
     if Frame_BillList.CB_BillType.ItemIndex <> 1 then
     begin
          MsgBox(1013, 0, '', '', '');
          exit;
     end;

     Gs_BillNo := Frame_BillList.QueryList.FieldByName('BillNo').AsString;
     Label8.Visible := false;
     CB_PatientType.Visible := false;
     gi_BillCase := 6;
     { ***************************************** }
     clearFrame;
     Panel_Parent.BringToFront;
     (*Frame_Billing := TFrame_Billing.Create(nil);
     with Frame_Billing do
     begin
          Parent := Panel_Parent;
          Align := alClient;
          Show;
          FrameCleared := false;
     end;*)
     { ***************************************** }
end;

