  var Key: Word; Shift: TShiftState);
begin
     IF key=VK_F1 Then CB_DFixedComm.Checked:=Not(CB_DFixedComm.Checked);
     IF key=VK_F2 Then CB_DCommessionAmt.Checked:=Not(CB_DCommessionAmt.Checked);
end;

