               sql.Add(' where PAVI_EmergencyNo=' + #39 + ps_EmergencyNo + #39 +' and PAVI_PatientId=' + IntToStr(pi_PatientId));
               ExecSQL;
          End;

          DM_Hospital.DB.Commit;
          pb_IsDischargedPt := True;
          SBP_Print.Enabled := True;
          BB_Save.Enabled := False;
          BitBtn_DepositAddReturn.Enabled := False;
     Except
          DM_Hospital.DB.RollBack;
          pb_IsDischargedPt := False;
          MessageDlg('Failure To Complete Emergency Final Billing !', mtWarning,
               [mbOK], 0);
          Exit;
     End;

     ls_FinalBillNo := Gs_BillNo;
     Gs_BillNo := ls_FinalBillNo;
end;

