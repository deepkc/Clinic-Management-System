Function TForm_DischargeBilling.GetTotalDays(InptDate, OutDate, OutTime,
  IsDischargePoint: String): Integer;
Var
  li_NoOfDays: Integer;
  ls_CurrentTime: String;
  DateEditX_In, DateEditX_Out: TDateEditX;
Begin
     DateEditX_In := TDateEditX.Create(nil);
     DateEditX_Out := TDateEditX.Create(nil);

     DateEditX_In.SystemOfDate := gi_DateSystem;
     DateEditX_In.Text := InptDate;
     DateEditX_Out.SystemOfDate := gi_DateSystem;
     DateEditX_Out.Text := OutDate;
     li_NoOfDays := DateEditX_Out.VSDateAsDays - DateEditX_In.VSDateAsDays;

     IF gi_HospitalId = 2 Then // 2 - Manamohan
     Begin
          IF OutTime = 'C' Then
               ls_CurrentTime := ServerDate.TodaysTime
          Else
               ls_CurrentTime := OutTime;
          IF (ls_CurrentTime > '16:00:00') and (li_NoOfDays > 0) and (OutTime = 'C')
               Then
               li_NoOfDays := li_NoOfDays + 1
          Else IF (ls_CurrentTime > '16:00:00') and (li_NoOfDays > 0) and
               (OutTime <> 'C') and (IsDischargePoint = 'Y') Then
               li_NoOfDays := li_NoOfDays + 1;
          Result := li_NoOfDays;
     End
     Else
          Result := li_NoOfDays;
End;

