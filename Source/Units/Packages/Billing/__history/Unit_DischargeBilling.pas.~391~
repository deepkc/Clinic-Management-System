                    pf_TotalDiscount := pf_TotalDiscount + Query_TempProcess.FieldByName('Discount').AsFloat;
                    lf_TaxSurgImplants := Query_TempProcess.FieldByName('TaxAmt').AsFloat;
               End
               Else
               Begin
                    IF (Trim(EditExRate.Text) <> '') and (EditExRate.Text <> '0') Then
                    Begin
                         pf_SurgImplantsCharge := Query_TempProcess.FieldByName('Total').AsFloat / StrToFloat(EditExRate.Text);
                         Edit_TotMedicineCharge.Text := FormatFloat('#,##0.00', pf_SurgImplantsCharge);
                         pf_TotalDiscount := pf_TotalDiscount +((Query_TempProcess.FieldByName('Discount').AsFloat) / StrToFloat(EditExRate.Text));
                         lf_TaxSurgImplants := Query_TempProcess.FieldByName('TaxAmt').AsFloat / StrToFloat(EditExRate.Text);
                    End
                    Else
                    Begin
                         pf_SurgImplantsCharge := Query_TempProcess.FieldByName('Total').AsFloat;
