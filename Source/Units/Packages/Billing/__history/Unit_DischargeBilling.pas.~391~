    lf_FinalPayRefund: Double;
Begin
     { except admission,bed and medicine charge }
     IF (ps_RateType = 'FRG') and (gs_IsDollarBillForFrgInDischarge = 'Y') and
          ((Trim(EditExRate.Text) = '') or (EditExRate.Text = '0')) Then
     Begin
          MessageDlg('Plz. Put Dollar ($) Exchange Rate.', mtWarning, [mbOK], 0);
          EditExRate.SetFocus;
          Exit;
     End;

     CreateTableFinalDischargBillDetail;
     Table_FinalDischBillDetail.Close;
