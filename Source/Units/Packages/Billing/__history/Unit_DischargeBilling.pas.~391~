          FieldDefs.Add('Total', ftFloat);
          FieldDefs.Add('VatAmt', ftFloat);
          FieldDefs.Add('Discount', ftFloat);
          FieldDefs.Add('SubTotal', ftFloat);
          FieldDefs.Add('NetTotal', ftFloat);
          FieldDefs.Add('ReturnStatus', ftString, 1);
          CreateTable;
     End;
End;

