     SaveBillMaster(pi_PatientId, pi_InpatientId, gi_UserId, li_RefDocID,
          gi_VisitId, StrToFloat(LabelGrandTotal.Caption), StrToFloat
               (Edit_TotalTax.Text), StrToFloat(Edit_TotDiscount.Text), StrToFloat
               (LabelNetTotal.Caption), 0, 0, 0, 0, 0, 0, 0, INITIAL, ps_TodaysDate,
          ps_TodaysTime, 'IP', CMBPayType.Text, ps_PatientTypeCode,
          ps_PatientTypeCode, '', ls_sendtoweb, ls_sendtosms, ls_sendtoemail,ps_Patientcategory);

     ps_BillNo := Gs_BillNo;

     with Table_InvestigationCharge do
     begin
          Close;
          Open;
          while not eof do
          begin
               lf_DiscountAmt := (FieldByName('Disper').AsFloat / 100) * FieldByName('Total').AsFloat * FieldByName('Qty').AsFloat;
               li_DisCommunityId := Table_InvestigationCharge.FieldByName('DisCommunityId').AsInteger;
               li_DisSchemeID := Table_InvestigationCharge.FieldByName('DisSchemeID').AsInteger;

               (* SaveBillDetail(SERVICEBILLDETAILID, PATIENTID, INPATIENTID, PATIENTTESTID, BILLBY, DISCOMMUNITYID, DISSCHEMEID, CRCOMMUNITYID, CRSCHEMEID,
                    DEPID,CLINICALDEPID, REFDEPID,DOCID, REFDOCID, EMRDUTYDOCID, ACCHEADID: Integer;
                    AMOUNT, QTY, VATAMT, TOTALAMOUNT, DISPER, DISCOUNT, SERVICECHARGE, DOLLAREXRATE,DOLLARAMOUNT,DOLLARVATAMT,DOLLARTOTALAMOUNT,DOLLARDISCOUNT,DOLLARSERVICECHARGE: Double;
                    BILLNO, BILLDATE, BILLTIME,SERVICE, SERVICETYPE, BILLTYPE, PAYTYPE, RATETYPE, PATIENTTYPE, MEMBERNO,
                    ISVATABLETEST, ISDISCOUNTABLETEST, ISFRACTIONABLETEST, ISPACKAGETEST,TESTNAMETYPE,OrgBillCategory,HOSPARTPER: String); stdcall; *)

               if Table_InvestigationCharge.FieldByName('Amount').AsFloat > 0 then
               Begin
                    Try
                         SaveBillDetail(Table_InvestigationCharge.FieldByName('ServiceBillDetailId').AsInteger, pi_PatientId, pi_InpatientId,
                                    Table_InvestigationCharge.FieldByName('PatientTestId').AsInteger,gi_UserId, li_DisCommunityId, li_DisSchemeID, li_CrCommunityId,
                                    li_CrSchemeID, Table_InvestigationCharge.FieldByName('DepID').AsInteger, Pi_ClinicalDepID, Pi_ClinicalDepID,
                                    Table_InvestigationCharge.FieldByName('DocID').AsInteger,li_RefDocID, Table_InvestigationCharge.FieldByName('MKTGREFID').AsInteger,
                                        0, Table_InvestigationCharge.FieldByName('Accounthead').AsInteger,Table_InvestigationCharge.FieldByName('WardId').AsInteger,Table_InvestigationCharge.FieldByName('Amount').AsFloat, Table_InvestigationCharge.FieldByName('Qty').AsFloat,
                                    Table_InvestigationCharge.FieldByName('TaxAmt').AsFloat,Table_InvestigationCharge.FieldByName('NetTotal').AsFloat,
                                    Table_InvestigationCharge.FieldByName('DisPer').AsFloat,lf_DiscountAmt, 0, 0, 0, 0, 0, 0, 0, Gs_BillNo, ps_TodaysDate,
                                    ps_TodaysTime, Table_InvestigationCharge.FieldByName('Service').AsString,
                                    StringReplace(Table_InvestigationCharge.FieldByName('ServiceType').AsString, '''', '''''', [rfReplaceAll]),
                                    Table_InvestigationCharge.FieldByName('BillType').AsString,CMBPayType.Text, ps_PatientTypeCode, ps_PatientTypeCode,
                                    Gs_MemberNo, Table_InvestigationCharge.FieldByName('IsVatable').AsString, Table_InvestigationCharge.FieldByName('IsDiscountable').AsString,
                                    Table_InvestigationCharge.FieldByName('IsFractionable').AsString, Table_InvestigationCharge.FieldByName('ISPACKAGETEST').AsString,
                                    Table_InvestigationCharge.FieldByName('TestNameType').AsString, Table_InvestigationCharge.FieldByName('OrgBillCategory').AsString,
                                    Table_InvestigationCharge.FieldByName('HOSPARTPER').AsString,Table_InvestigationCharge.FieldByName('ISOT').AsString,
                                    ps_Patientcategory);
                    Except
                         SaveBillDetail(Table_InvestigationCharge.FieldByName('ServiceBillDetailId').AsInteger, pi_PatientId, pi_InpatientId,
                              Table_InvestigationCharge.FieldByName('PatientTestId').AsInteger,gi_UserId, li_DisCommunityId, li_DisSchemeID, li_CrCommunityId,
                              li_CrSchemeID, Table_InvestigationCharge.FieldByName('DepID').AsInteger, Pi_ClinicalDepID, Pi_ClinicalDepID,
                              Table_InvestigationCharge.FieldByName('DocID').AsInteger,li_RefDocID, Table_InvestigationCharge.FieldByName('MKTGREFID').AsInteger,
                              0, Table_InvestigationCharge.FieldByName('Accounthead').AsInteger,Table_InvestigationCharge.FieldByName('WardId').AsInteger, Table_InvestigationCharge.FieldByName('Amount').AsFloat, Table_InvestigationCharge.FieldByName('Qty').AsFloat,
                              Table_InvestigationCharge.FieldByName('TaxAmt').AsFloat,Table_InvestigationCharge.FieldByName('NetTotal').AsFloat,
                              Table_InvestigationCharge.FieldByName('DisPer').AsFloat,lf_DiscountAmt, 0, 0, 0, 0, 0, 0, 0, Gs_BillNo, ps_TodaysDate,
                              ps_TodaysTime, Table_InvestigationCharge.FieldByName('Service').AsString,
                              StringReplace(Table_InvestigationCharge.FieldByName('ServiceType').AsString, '''', '''''', [rfReplaceAll]),
                              Table_InvestigationCharge.FieldByName('BillType').AsString,CMBPayType.Text, ps_PatientTypeCode, ps_PatientTypeCode,
                              Gs_MemberNo, Table_InvestigationCharge.FieldByName('IsVatable').AsString, Table_InvestigationCharge.FieldByName('IsDiscountable').AsString,
                              Table_InvestigationCharge.FieldByName('IsFractionable').AsString, Table_InvestigationCharge.FieldByName('ISPACKAGETEST').AsString,
                              Table_InvestigationCharge.FieldByName('TestNameType').AsString, Table_InvestigationCharge.FieldByName('OrgBillCategory').AsString,
                              Table_InvestigationCharge.FieldByName('HOSPARTPER').AsString,
                              Table_InvestigationCharge.FieldByName('ISOT').AsString,ps_Patientcategory
                              );
                    End;
               End;
               // if pf_Deposit <= 0 then
               UpdatePatientTestDischarge(Table_InvestigationCharge.FieldByName('ServiceBillDetailId').AsInteger, gi_BillDetailId, gi_billed,gi_BillingInvCtrl, Gs_BillNo);
               UpdateServiceBillDetail(Table_InvestigationCharge.FieldByName('ServiceBillDetailId').AsInteger, gi_BillDetailId);

               if pi_DisInDepositSchemeID=22 then // 22 - B & B Special
               begin
                     if ps_TodaysDate<>ps_DisInDepositDate then
                     UpdateBNBSpecialFraction(Table_InvestigationCharge.FieldByName('ServiceBillDetailId').AsInteger, gi_BillDetailId,pi_InpatientId,
                              Table_InvestigationCharge.FieldByName('DisPer').AsFloat,CMBPayType.Text,ps_TodaysDate,ps_TodaysTime);
               end
               else
               UpdatefRACTIONBillDetail(Table_InvestigationCharge.FieldByName('ServiceBillDetailId').AsInteger, gi_BillDetailId,
                    Table_InvestigationCharge.FieldByName('DisPer').AsFloat,CMBPayType.Text,ps_TodaysDate);

               Next;
          end;
     end;

     if gs_HospitalNameForCode='BNB' then
     Begin
          if (pi_DisInDepositSchemeID=22) and (ps_TodaysDate=ps_DisInDepositDate) then // 22 - B & B Special
          begin
               With Query_Process do
               begin
                    Close;
                    Session:=DM_Hospital.DB;
                    SQL.Clear;
                    SQL.Add(' Update HS_INRE_InpatientReg Set INRE_DISINDEPOSITESCHEME=0 where INRE_InpatientID='+IntToStr(pi_InpatientId));
                    ExecSQL;

                    Close;
                    Session:=DM_Hospital.DB;
                    SQL.Clear;
                    SQL.Add(' Delete From HS_SPDE_SpecialDeposit where SPDE_InpatientID='+IntToStr(pi_InpatientId));
                    SQL.Add(' and SPDE_REFERENCETYPE In (''FINAL DISCHARGE COLN'',''DISCHARGE ADJUSTED DEPOSIT'')');
                    SQL.Add(' and SPDE_DEPOSITTYPE In (''DIS ADJ DEP REFUND'',''DEPOSIT'')');
                    ExecSQL;
               end;
          end;
     end;


     li_DocId := 0;
     { if gi_HospitalId=561 then // 561- Fewa City
          li_DepId := 55     // 55 - Department Bed Charges
          Else if gi_HospitalId=562 then // 562 - Manipal Hosptial
          li_DepId:=16
          Else if gi_HospitalId=563 then // 563 - Nepal Cancer Hosptail
          Begin
          li_DepId:=40; // Department Bed Charges;
          li_DocId:=pi_DocId;
          li_RefDocID:=pi_DocId;
          End
          Else if gi_HospitalId=564 then }
     li_DepId := 1;

     With Query_TempProcess do
     Begin
          Close;
          DatabaseName := gs_temppath;
          sql.Clear;
          sql.Add(' Select Wardid,RoomTypeCode,DisPer,Sum(TaxAmt) as TaxAmt,Sum(Total) as Total, Sum(Discount) as Discount');
          sql.Add(' ,Sum(Total+TaxAmt-Discount) as NetTotal From BedCharge.db Group by RoomTypeCode,DisPer,Wardid');
          Open;
          First;
          while NOT eof do
          Begin
               li_BedRoundClinicalDepId := Pi_ClinicalDepID;

               (* SaveBillDetail(SERVICEBILLDETAILID, PATIENTID, INPATIENTID, PATIENTTESTID, BILLBY, DISCOMMUNITYID, DISSCHEMEID, CRCOMMUNITYID, CRSCHEMEID,
                    DEPID,CLINICALDEPID, REFDEPID,DOCID, REFDOCID, EMRDUTYDOCID, ACCHEADID: Integer;
                    AMOUNT, QTY, VATAMT, TOTALAMOUNT, DISPER, DISCOUNT, SERVICECHARGE, DOLLAREXRATE,DOLLARAMOUNT,DOLLARVATAMT,DOLLARTOTALAMOUNT,DOLLARDISCOUNT,DOLLARSERVICECHARGE: Double;
                    BILLNO, BILLDATE, BILLTIME,SERVICE, SERVICETYPE, BILLTYPE, PAYTYPE, RATETYPE, PATIENTTYPE, MEMBERNO,
                    ISVATABLETEST, ISDISCOUNTABLETEST, ISFRACTIONABLETEST, ISPACKAGETEST,TESTNAMETYPE,OrgBillCategory,HOSPARTPER: String); stdcall; *)

               Try
                    SaveBillDetail(0, pi_PatientId, pi_InpatientId, 0, gi_UserId,
                         li_DisCommunityId, li_DisSchemeID, li_CrCommunityId, li_CrSchemeID,
                         li_DepId, Pi_ClinicalDepID, Pi_ClinicalDepID, li_DocId, li_RefDocID,
                         0, 0, 9,Query_TempProcess.FieldByName('Wardid').AsInteger,Query_TempProcess.FieldByName('Total').AsFloat, 1,
                         Query_TempProcess.FieldByName('TaxAmt').AsFloat,
                         Query_TempProcess.FieldByName('NetTotal').AsFloat,
                         Query_TempProcess.FieldByName('DisPer').AsFloat,
                         Query_TempProcess.FieldByName('Discount').AsFloat, 0, 0, 0, 0, 0, 0,
                         0, Gs_BillNo, ps_TodaysDate, ps_TodaysTime,
                         Query_TempProcess.FieldByName('RoomTypeCode').AsString,
                         'BED CHARGES', 'IP', CMBPayType.Text, ps_PatientTypeCode,
                         ps_PatientTypeCode, Gs_MemberNo, 'Y', 'Y', 'N', 'N', 'N', 'HOS',
                         '100', 'N',ps_Patientcategory);
               Except
                    SaveBillDetail(0, pi_PatientId, pi_InpatientId, 0, gi_UserId,
                         li_DisCommunityId, li_DisSchemeID, li_CrCommunityId, li_CrSchemeID,
                         li_DepId, Pi_ClinicalDepID, Pi_ClinicalDepID, li_DocId, li_RefDocID,
                         0, 0, 9,Query_TempProcess.FieldByName('Wardid').AsInteger, Query_TempProcess.FieldByName('Total').AsFloat, 1,
                         Query_TempProcess.FieldByName('TaxAmt').AsFloat,
                         Query_TempProcess.FieldByName('NetTotal').AsFloat,
                         Query_TempProcess.FieldByName('DisPer').AsFloat,
                         Query_TempProcess.FieldByName('Discount').AsFloat, 0, 0, 0, 0, 0, 0,
                         0, Gs_BillNo, ps_TodaysDate, ps_TodaysTime,
                         Query_TempProcess.FieldByName('RoomTypeCode').AsString,
                         'BED CHARGES', 'IP', CMBPayType.Text, ps_PatientTypeCode,
                         ps_PatientTypeCode, Gs_MemberNo, 'Y', 'Y', 'N', 'N', 'N', 'HOS',
                         '100', 'N',ps_Patientcategory);
               End;
               Next;
          End;
     End;

     // Doctor Round Visit - DepId (49)
     if gs_IsIPVisitChargeConcept = 'Y' then
     Begin
          // if gi_HospitalId=561 then // 561- Fewa City
          li_DepId := 65; // 60 - IPD Consulation
          with Query_TempProcess do
          Begin
               Close;
               DatabaseName := gs_temppath;
               sql.Clear;
               sql.Add(' Select DocId,DocCode,wardid,DoctorCategory,Sum(TaxAmt) as TaxAmt,Sum(Total) as Total, Sum(Discount) as Discount,');
               sql.Add(' Sum(Total+TaxAmt-Discount) as NetTotal From DoctorService.db ');
               sql.Add(' Group By DocId,DocCode,Wardid,DoctorCategory');
               Open;
               First;
               while Not eof do
               Begin
                    if Query_TempProcess.FieldByName('Total').AsFloat > 0 then
                         lf_DisPer := GetNoOfDecimalPartOfFloatNum((Query_TempProcess.FieldByName('Discount').AsFloat / Query_TempProcess.FieldByName('Total').AsFloat)
                                   * 100, 3);

                    // ls_RoomTypeCode:=Query_TempProcess.FieldByName('RoomTypeCode').AsString;
                    li_DocId := Query_TempProcess.FieldByName('DocId').AsInteger;
                    li_RefDocID := Query_TempProcess.FieldByName('DocId').AsInteger;
                    li_BedRoundClinicalDepId := Pi_ClinicalDepID;

                    if gs_HospitalNameForCode='BNB' then
                    ls_Patientcategory:=Query_TempProcess.FieldByName('DoctorCategory').AsString
                    else
                    ls_Patientcategory:=ps_Patientcategory;


                    if Query_TempProcess.FieldByName('Total').AsFloat > 0 then
                    Begin
                         Try
                              SaveBillDetail(0, pi_PatientId, pi_InpatientId, 0, gi_UserId,
                                   li_DisCommunityId, li_DisSchemeID, li_CrCommunityId,
                                   li_CrSchemeID, li_DepId, Pi_ClinicalDepID, Pi_ClinicalDepID,
                                   li_DocId, li_RefDocID, 0, 0, 19,Query_TempProcess.FieldByName('Wardid').AsInteger,
                                   Query_TempProcess.FieldByName('Total').AsFloat, 1, Query_TempProcess.FieldByName('TaxAmt').AsFloat,
                                   Query_TempProcess.FieldByName('NetTotal').AsFloat,
                                   lf_DisPer, Query_TempProcess.FieldByName('Discount').AsFloat, 0,
                                   0, 0, 0, 0, 0, 0, Gs_BillNo, ps_TodaysDate, ps_TodaysTime,
                                   'DOCRC', 'ROUND VISIT CHARGES', 'IP', CMBPayType.Text,
                                   ps_PatientTypeCode, ps_PatientTypeCode, Gs_MemberNo, 'Y', 'Y',
                                   'N', 'N', 'N', 'HOS', '0', 'N',ls_Patientcategory);
                         Except
                              SaveBillDetail(0, pi_PatientId, pi_InpatientId, 0, gi_UserId,
                                   li_DisCommunityId, li_DisSchemeID, li_CrCommunityId,
                                   li_CrSchemeID, li_DepId, Pi_ClinicalDepID, Pi_ClinicalDepID,
                                   li_DocId, li_RefDocID, 0, 0, 19,Query_TempProcess.FieldByName('Wardid').AsInteger,
                                   Query_TempProcess.FieldByName('Total').AsFloat, 1, Query_TempProcess.FieldByName('TaxAmt').AsFloat,
