               FieldByName('Discount').AsFloat := Table_InvestigationCharge.FieldByName('Discount').AsFloat;
               FieldByName('SubTotal').AsFloat := Table_InvestigationCharge.FieldByName('Total').AsFloat - Table_InvestigationCharge.FieldByName('Discount').AsFloat;
