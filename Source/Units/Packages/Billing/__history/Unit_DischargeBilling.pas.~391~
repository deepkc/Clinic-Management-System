          if pb_IsDischargedPt = False then
          Begin
               sql.Add(
                    ' Select memb_MemberId MemberId,memb_PatientId PatientId,Memb_MemberNo MemberNo From hs_memb_member where memb_PatientId=' + IntToStr(pi_PatientId));
               sql.Add(' and memb_IsActive=''Y''');
          End
