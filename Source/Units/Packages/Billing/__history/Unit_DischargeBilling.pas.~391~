     AdmittedPatientInfo;
     LoadInvestigationCharge;
     LoadBedCharge;
     LoadDoctorService;
     LoadTotalChargeInfo;

     With Query_Process Do
     Begin
          Close;
          Session:=DM_Hospital.DB;
          sql.Clear;
          sql.add(' Select * From HS_INRE_InpatientReg where INRE_InpatientID='+IntToStr(pi_InpatientId));
          Open;
          if (Query_Process.FieldByName('INRE_IsDisInDeposit').AsString='Y') and (Query_Process.FieldByName('INRE_IsDischarged').AsString='N')
          and (Query_Process.FieldByName('INRE_DISINDEPOSITESCHEME').AsInteger=22) and (Query_Process.FieldByName('INRE_ISTRANSLOCKED').AsString='N') Then
          Begin
               Close;
               Session:=DM_Hospital.DB;
               sql.Clear;
               sql.add(' Select Sum(SPDE_CRAMOUNT) as AdjTotal From HS_SPDE_SpecialDeposit where SPDE_DEPOSITTYPE=''DIS ADJ DEP REFUND''');
               sql.add(' and SPDE_InpatientID='+IntToStr(pi_InpatientId));
               Open;

               lf_total:=strtofloat(LabelGrandTotal.Caption)-StrToFloat(Edit_TotDiscount.Text);

               //if Query_Process.FieldByName('AdjTotal').AsFloat > 0  then
               Begin
                    if Abs(Query_Process.FieldByName('AdjTotal').AsFloat-lf_total) > 0.5 then
                    Begin
                         Close;
                         Session:=DM_Hospital.DB;
                         sql.Clear;
                         sql.add(' Update HS_SPDE_SpecialDeposit Set SPDE_CRAMOUNT='+FloatToStr(Round(lf_total)));
                         sql.add(' where SPDE_DEPOSITTYPE=''DIS ADJ DEP REFUND'' and SPDE_InpatientID='+IntToStr(pi_InpatientId));
                         sql.add(' and SPDE_CRAMOUNT > 0');
                         ExecSQL;


                         Close;
                         Session:=DM_Hospital.DB;
                         sql.Clear;
                         sql.add(' Update HS_SPDE_SpecialDeposit Set SPDE_DRAMOUNT='+FloatToStr(Round(lf_total)));
                         sql.add(' where SPDE_REFERENCETYPE=''FINAL DISCHARGE COLN'' and SPDE_InpatientID='+IntToStr(pi_InpatientId));
                         sql.add(' and SPDE_DRAMOUNT > 0');
                         ExecSQL;
