               SaveBillMaster(pi_PatientId, pi_InpatientId, gi_UserId, 0, gi_VisitId,
                    StrToFloat(LabelGrandTotal.Caption), StrToFloat(Edit_TotalTax.Text),
                    StrToFloat(Edit_TotDiscount.Text), StrToFloat(LabelNetTotal.Caption),
