          End
          Else
          Begin
               IF (Trim(EditExRate.Text) <> '') and (EditExRate.Text <> '0') Then
               Begin
                    pf_MedCharge := pf_MedCharge - Query_TempProcess.FieldByName('Total').AsFloat / StrToFloat(EditExRate.Text);
                    Edit_TotMedicineCharge.Text := FormatFloat('#,##0.00', pf_MedCharge);
                    pf_TotalDiscount := pf_TotalDiscount - ((Query_TempProcess.FieldByName('Discount').AsFloat) / StrToFloat(EditExRate.Text));
                    lf_TaxMedicine := lf_TaxMedicine - (Query_TempProcess.FieldByName('TaxAmt').AsFloat / StrToFloat(EditExRate.Text));
               End
               Else
               Begin
                    pf_MedCharge := pf_MedCharge - Query_TempProcess.FieldByName('Total').AsFloat;
                    Edit_TotMedicineCharge.Text := FormatFloat('#,##0.00', pf_MedCharge);
                    pf_TotalDiscount := pf_TotalDiscount - Query_TempProcess.FieldByName('Discount').AsFloat;
                    lf_TaxMedicine := lf_TaxMedicine - Query_TempProcess.FieldByName('TaxAmt').AsFloat;
               End;
          End;

          pf_TotalTax := lf_TaxService + lf_TaxMedicine;
          Edit_TotalTax.Text := format('%.2f', [pf_TotalTax]);

          Edit_TotDiscount.Text := FormatFloat('0.00', pf_TotalDiscount);
          LabelGrandTotal.Caption := format('%.2f', [(pf_InvestigationCharge + pf_MedCharge)]);
          pf_NetTotal := ((pf_InvestigationCharge + pf_MedCharge + pf_TotalTax) - pf_TotalDiscount);
          LabelNetTotal.Caption := format('%.2f', [pf_NetTotal]);
     End;

     pf_Deposit := 0;

     (* In Case of Medicare Patient Co-Pay Amount *)
     pf_CoPayAmount:=0;
     with Query_Process do
     Begin
          Close;
          Session:=DM_Hospital.DB;
          sql.Clear;
          Close;
          SQL.Clear;
          SQL.Add(' Select Sum(Total) as Total From (');
          SQL.Add(' Select Sum(ReceivedAmount) as Total From CreditPayment where PatientId='+IntToStr(pi_PatientId)+' and PayType=''CASH''');
          SQL.Add(' and EMERGENCYNO='+#39+ps_EmergencyNo+#39);
          SQL.Add(' Union');
          SQL.Add(' Select -Sum(ReceivedAmount) as Total From CreditPayment where PatientId='+IntToStr(pi_PatientId)+' and PayType=''REFUND''');
          SQL.Add(' and EMERGENCYNO='+#39+ps_EmergencyNo+#39);
          SQL.Add(' )');
          Open;

          Label_CopayAmtCap.Visible:=True;
          Label_CopayAmt.Visible:=True;
          Label_CopayAmt.Caption:=FormatFloat('0.00',Query_Process.FieldByName('Total').AsFloat);
          pf_CoPayAmount:=Query_Process.FieldByName('Total').AsFloat;
     End;
     
     pf_FinalPayRefund:=0;

     if CB_NoDepositAdjustment.Checked=True then
     pf_Deposit:=0;

     Edit_HosDeposit.Text := FormatFloat('0.00', pf_Deposit);

     LabelBalanceTotal.Caption := format('%.2f', [pf_Deposit]);
     pb_IsRefund := False;

     IF (pf_InvestigationCharge + pf_MedCharge + pf_TotalTax) >= (pf_TotalDiscount + pf_Deposit+pf_CoPayAmount) Then
     Begin
          pb_IsRefund := False;
          LabelPaymentStatus.Caption := 'To Be Paid :';
          LabelPaidTotal.Caption := format('%.2f', [((pf_InvestigationCharge + pf_MedCharge + pf_TotalTax) -(pf_TotalDiscount + pf_Deposit+pf_CoPayAmount+pf_FinalPayRefund))]);
     End
     Else
     Begin
          pb_IsRefund := True;
          LabelPaymentStatus.Caption := 'To Be Refund :';
          lf_RefAmt := (pf_TotalDiscount + pf_Deposit+pf_CoPayAmount+pf_FinalPayRefund)-(pf_InvestigationCharge + pf_MedCharge + pf_TotalTax);
          LabelPaidTotal.Caption := format('%.2f', [(lf_RefAmt)]);
     End;
end;

