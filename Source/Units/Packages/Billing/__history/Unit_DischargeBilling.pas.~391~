          with Query_Process do
          Begin
               Close;
               Session := DM_Hospital.DB;
               sql.Clear;
               sql.Add(' Select Sum(DEPO_DRAmount-DEPO_CRAmount) as Deposit,0 as DollarDeposit From HS_DEPO_Deposit');
               sql.Add(' where DEPO_InPatientId=' + IntToStr(pi_InpatientId));
               sql.Add(' and DEPO_DepositType=''FINALDISADJ''');
