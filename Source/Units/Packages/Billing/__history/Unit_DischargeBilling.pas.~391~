          lf_TotalVat := lf_TotalVat + Query_GetBedCharge.FieldByName('VatAmt')
               .AsFloat;
          lf_TotalDis := lf_TotalDis + Query_GetBedCharge.FieldByName('DISCOUNT')
               .AsFloat;

          with QueryBedCharge Do
          Begin
               Session := gs_temppath;
               Close;
               Open;
          End;

          with Query_AdmitedDate do
          Begin
               Close;
               ParamByName('IPID').AsInteger := pi_InpatientId;
               Open;
          End;

          with Query_DischargeDate do
          Begin
               Close;
               ParamByName('IPID').AsInteger := pi_InpatientId;
               Open;
          End;
     End;

     with FormReportDischargeBillDetail2nd do
     Begin
          with QueryChargeMaster do
          Begin
               Close;
               Session := gs_temppath;
               Open;
          End;

          With QueryCharges do
          Begin
               Close;
               Session := gs_temppath;
               Open;
          End;

          With Query_GetFinalCharge do
          Begin
               Session := gs_temppath;
               Close;
               sql.Clear;
               sql.Add(' Select sum(Total) as Total,Sum(Discount) as Discount,');
               sql.Add(
                    ' Sum(VatAmt) as VatAmt,Sum(NetTotal) as NetTotal From     FinalDischargeBillDetail.db where ReturnStatus Is NUll');
               Open;
          End;

          lf_TotalAmt := lf_TotalAmt + Query_GetFinalCharge.FieldByName('Total')
               .AsFloat;
          lf_TotalVat := lf_TotalVat + Query_GetFinalCharge.FieldByName('VatAmt')
               .AsFloat;
          lf_TotalDis := lf_TotalDis + Query_GetFinalCharge.FieldByName('DISCOUNT')
               .AsFloat;

          With Query_GetFinalCharge do
          Begin
               Session := gs_temppath;
               Close;
               sql.Clear;
               sql.Add(' Select sum(Total) as Total,Sum(Discount) as Discount,');
               sql.Add(
                    ' Sum(VatAmt) as VatAmt,Sum(NetTotal) as NetTotal From     FinalDischargeBillDetail.db where ReturnStatus Is Not NUll');
               Open;
          End;

          lf_TotalAmt := lf_TotalAmt + Query_GetFinalCharge.FieldByName('Total')
               .AsFloat;
          lf_TotalVat := lf_TotalVat + Query_GetFinalCharge.FieldByName('VatAmt')
               .AsFloat;
          lf_TotalDis := lf_TotalDis + Query_GetFinalCharge.FieldByName('DISCOUNT')
               .AsFloat;

          lf_DepositAmt := pf_Deposit;
          lf_CopayAmt := pf_CoPayAmount;
          lf_FinalPayRefund := pf_FinalPayRefund;

          QRLabelUsd.Font.Color := clWhite;
          QRLabelInUSD.Font.Color := clWhite;

          if gs_TaxSystem = 'VAT' then
               QRLabel_TaxSystemCap.Caption := FloatToStr(gf_TaxPercent) + '% VAT'
          Else
               QRLabel_TaxSystemCap.Caption := FloatToStr(gf_TaxPercent) + '% HS TAX';

          QRLabelTotalAmt.Caption := FormatFloat('0.00', lf_TotalAmt);
          QRLabelTaxAmt.Caption := FormatFloat('0.00', lf_TotalVat);
          QRLabelDiscount.Caption := FormatFloat('0.00', lf_TotalDis);
          QRLabelSubTotal.Caption := FormatFloat('0.00', lf_TotalAmt - lf_TotalDis);

          if Copy(ps_BillNo, 1, 2) = 'ME' then
               QRLabel11.Caption := 'DEPOSIT/CO-PAY:'
          else
               QRLabel11.Caption := 'DEPOSIT:';

          QRLabelDeposit.Caption := FormatFloat('0.00', lf_DepositAmt + lf_CopayAmt);

          QRLabeltTotal.Caption := FormatFloat
               ('0.00', lf_TotalAmt + lf_TotalVat - lf_TotalDis);
          if (Copy(ps_BillNo, 1, 2) = 'CS') or (Copy(ps_BillNo, 1, 2) = 'CR') or
               (Copy(ps_BillNo, 1, 2) = 'ME') then
          Begin
               IF (lf_TotalAmt + lf_TotalVat - lf_TotalDis) >=
                    (lf_DepositAmt + lf_CopayAmt) Then
               Begin
                    if (Copy(ps_BillNo, 1, 2) = 'CS') then
                         QRLabelGTotal.Caption := 'COLLECTED AMOUNT :'
                    Else
                         // QRLabelGTotal.Caption := 'TO BE COLLECT AMOUNT(CREDIT) :';
                         QRLabelGTotal.Caption := 'TOTAL PAYMENT';
                    QRLabelGrandTotAmt.Caption := FormatFloat
                         ('0.00', lf_TotalAmt + lf_TotalVat -
                              (lf_TotalDis + lf_DepositAmt + lf_CopayAmt))
               End
               Else
               Begin
                    QRLabelGTotal.Caption := 'REFUNDED AMOUNT :';
                    QRLabelGrandTotAmt.Caption := '( ' + FormatFloat
                         ('0.00', (lf_DepositAmt + lf_CopayAmt) -
                              (lf_TotalAmt + lf_TotalVat - lf_TotalDis)) + ' )';
               End;
          End
          Else
          Begin
               IF (lf_TotalAmt + lf_TotalVat - lf_TotalDis) >=
                    (lf_DepositAmt + lf_CopayAmt) Then
               Begin
                    // QRLabelGTotal.Caption := 'TO BE COLLECT :';
                    // QRLabelGTotal.Caption := 'TOTAL PAYMENT';
                    QRLabelGTotal.Caption := 'TO BE COLLECTED :';
                    QRLabelGrandTotAmt.Caption := FormatFloat
                         ('0.00', lf_TotalAmt + lf_TotalVat -
                              (lf_TotalDis + lf_DepositAmt + lf_CopayAmt))
               End
               Else
               Begin
                    QRLabelGTotal.Caption := 'TO BE REFUND :';
                    QRLabelGrandTotAmt.Caption := FormatFloat
                         ('0.00', (lf_DepositAmt + lf_CopayAmt) -
                              (lf_TotalAmt + lf_TotalVat - lf_TotalDis))
               End;
          End;
     End;

     // IF CheckBoxPreview.Checked = True Then
     QRCompositeReport1.Preview;  *)
     // Else
     // QRCompositeReport1.Print;
End;

