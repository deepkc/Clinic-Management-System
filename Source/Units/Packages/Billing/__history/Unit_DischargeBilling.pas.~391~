          IF Query_Process.FieldByName('Deposit').AsFloat > 0 Then
               Label_Status.Caption := 'Pay'
          else
               Label_Status.Caption := 'Refund';

          Label_FinalPayRefund.Caption := FloatToStr
               (Abs(Query_Process.FieldByName('Deposit').AsFloat));
          pf_FinalPayRefund := Query_Process.FieldByName('Deposit').AsFloat;
     End;
     // End
     // Else
     // pf_Deposit := Query_GetAdmittedPatientInfo.FieldByName('DepositBalance').AsFloat;

     if CB_NoDepositAdjustment.Checked = True then
          pf_Deposit := 0;

     Edit_HosDeposit.Text := FormatFloat('0.00', pf_Deposit);

     LabelBalanceTotal.Caption := format('%.2f', [pf_Deposit]);
     // pf_AdjustedDeposit := pf_Deposit;

     pb_IsRefund := False;
     IF ((pf_InvestigationCharge + pf_BedCharge + pf_DocServiceChrg + pf_SurgImplantsCharge+
                    pf_MedCharge + pf_TotalTax) >=
               (pf_TotalDiscount + pf_Deposit + pf_CoPayAmount)) and
          (((pf_InvestigationCharge + pf_DocServiceChrg + pf_BedCharge + pf_SurgImplantsCharge+
                         pf_MedCharge + pf_TotalTax) - (pf_TotalDiscount + pf_Deposit +
                         pf_CoPayAmount + pf_FinalPayRefund)) >= 0) Then
     Begin
          pb_IsRefund := False;
          LabelPaymentStatus.Caption := 'To Be Paid :';
          lf_PayAmt:=((pf_InvestigationCharge + pf_DocServiceChrg + pf_BedCharge + pf_SurgImplantsCharge+
