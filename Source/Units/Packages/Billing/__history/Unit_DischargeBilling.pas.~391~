     Table_FinalDischBillDetail.EmptyTable;
     Table_FinalDischBillDetail.Exclusive := True;
     Table_FinalDischBillDetail.Open;

     Table_InvestigationCharge.First;
     While Not Table_InvestigationCharge.eof Do
     Begin
          With Table_FinalDischBillDetail do
          Begin
               Append;
               FieldByName('PaymentCategory').AsString :=Table_InvestigationCharge.FieldByName('TestNameCategory').AsString;
               if Table_InvestigationCharge.FieldByName('TestNameCategory').AsString='Investigation Charges' then
               FieldByName('Department').AsString := Table_InvestigationCharge.FieldByName('Department').AsString
               Else
               FieldByName('Department').AsString :=Table_InvestigationCharge.FieldByName('TestNameCategory').AsString;
               FieldByName('BillDate').AsString := Table_InvestigationCharge.FieldByName('CrBillDate').AsString;
