          Begin
               sql.Add(
                    ' Select Inre_SchemeId as MemberId,Inre_MemberNo Memberno From Hs_Inre_Inpatientreg where INRE_InPatientId=' + IntToStr(pi_InpatientId));
          End;
          Open;
          if Query_Process.FieldByName('MemberId').AsInteger > 0 then
          Begin
               gi_SchemeId := 22;
               gi_CommunityId := 18;
               Gs_MemberNo := Query_Process.FieldByName('MemberNo').AsString;
