Procedure TForm_DischargeBilling.LoadInpatientTransaction;
Begin
     pi_InpatientId := gi_InpatientId;
     pi_PatientId := gi_PatientId;

     // LAYOUTCONTROLOFDISCHARGEBILL;
     IF gb_IsEmrDisBilling=False Then
     Begin
          With Query_Specialdeposit Do
          Begin
               Close;
               Session:=DM_Hospital.DB;
               sql.Clear;
               sql.Add(' Select Sum(SPDE_DRAmount-SPDE_CRAmount) as Deposit,0 as DollarDeposit From hs_spde_specialdeposit');
               sql.Add(' where SPDE_InPatientId=' + IntToStr(pi_InpatientId));
               sql.Add(' and SPDE_AtDisTimeAdj=''N'' and NVL(SPDE_DEPOSITTYPE,''NA'')<>''DIS ADJ DEP REFUND''');
               Open;
          End;

          AdmittedPatientInfo;

          FillDailyBed;
          LoadBedCharge;

          (*IF gs_HospitalNameForCode='BNB' Then
          DisplayBNBNoOfDays;*)

          IF (pb_IsDischargedPt = False) and (gs_HospitalNameForCode='BNB') Then
          Begin
               //if (ps_PatientTypeCode='ECG') or (ps_PatientTypeCode='ECP') or (ps_PatientTypeCode='ECS') then
               if (gs_IsAuotNursingServiceChargeConcept='Y') and
               (Query_GetAdmittedPatientInfo.FieldByName('IsDisInDeposit').AsString = 'N') then
               AUTOCHARGINGSERVICES;

          End;

          LoadInvestigationCharge;
     End
     Else
     Begin
          Label_SpecialDeposit.Enabled:=False;
          Label_SpecialDeposit.Visible:=False;
          BitBtn_DepositAddReturn.Enabled:=False;
          BitBtn_DepositAddReturn.Visible:=False;
          Btn_DischargeInDeposit.Enabled:=False;
          Btn_DischargeInDeposit.Visible:=False;
          BitBtn_DischargeSlipPrint.Enabled:=False;
          BitBtn_DischargeSlipPrint.Visible:=False;
          Lbl_Ward.Visible:=False;
          Lbl_RoomType.Visible:=False;
          Lbl_BedNo.Visible:=False;
          Label3.Visible:=False;
          Lbl_Consultant.Visible:=False;
          CMBPayType.ItemIndex :=0;
          ps_Patientcategory:=GetPatientCagetory(pi_PatientId);

          ERMedicarePatientInfo;
          LoadInvestigationChargeEMRMEDICAREPT;
     End;

     IF gb_IsEmrDisBilling=False Then
     Begin
          if gs_ISINTEGRATEDPHARMACY='Y' then
          LoadMedicineCharge;

          if gs_IsSurImplantsIssuePatientWise='Y' then
          Begin
               LoadSurgicalItemsCharges;
               SurgicalItemsDisplayMgmt;
          End;

          if gs_IsIPVisitChargeConcept = 'Y' then
          LoadDoctorService;

          BitBtn_EmrPtClearance.Visible:=False;
          BitBtn_EmrPtClearance.Enabled:=False;
          LoadTotalChargeInfo;
     End
     else
     begin
          if gs_ISINTEGRATEDPHARMACY='Y' then
          LoadMedicineChargeEMRMEDICAREPT;

          LoadEMRMedicarePTTotalChargeInfo;
          if IsEmrTransactionExist=False then
          Begin
               BitBtn_EmrPtClearance.Visible:=True;
               BitBtn_EmrPtClearance.Enabled:=True;
          End
          else
          begin
               BitBtn_EmrPtClearance.Visible:=False;
               BitBtn_EmrPtClearance.Enabled:=False;
          end;
     end;
End;


