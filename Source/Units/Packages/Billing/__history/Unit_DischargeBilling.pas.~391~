Procedure TForm_DischargeBilling.IsPrevDisInDepositBillNotFinal;
Var
  Qry: TOraQuery;
Begin
     Qry := TOraQuery.Create(Nil);
     With Qry Do
     Begin
          Close;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.Add(' Select Inre_InpatientId InpatientId,inre_DisInDepositTransId DisInDepositTransId ');
          sql.Add(' From Hs_Inre_Inpatientreg where Inre_IsDisInDeposit=''Y'' and Inre_IsDischarged=''N''');
          sql.Add(' and Inre_PatientId=' + IntToStr(pi_PatientId)+ ' and Inre_InpatientId < ' + IntToStr(pi_InpatientId));
          Open;
     End;

     ps_PreveDisInDepositTransExist := 'N';
     ps_DisInDepositTransId := '';
     if Qry.FieldByName('InpatientId').AsInteger > 0 then
     Begin
          Qry.First;
          while not Qry.eof do
          Begin
               if Trim(ps_DisInDepositTransId) = '' then
               ps_DisInDepositTransId := IntToStr(Qry.FieldByName('DisInDepositTransId').AsInteger)
               Else
                    ps_DisInDepositTransId := ps_DisInDepositTransId + ',' + IntToStr(Qry.FieldByName('DisInDepositTransId').AsInteger);
               Qry.Next;
          End;
          ps_PreveDisInDepositTransExist := 'Y';
     End;
     Qry.Free;
End;

