                              pf_CoPayAmount + pf_FinalPayRefund));

          if Abs(lf_PayAmt) < 0.5  then
          LabelPaidTotal.Caption := '0.00'
          Else
          LabelPaidTotal.Caption := format('%.2f', [lf_PayAmt]);

     End
     Else
     Begin
          pb_IsRefund := True;
          LabelPaymentStatus.Caption := 'To Be Refund :';
          lf_RefAmt := (pf_TotalDiscount + pf_Deposit + pf_CoPayAmount +
                    pf_FinalPayRefund) - (pf_InvestigationCharge + pf_DocServiceChrg + pf_SurgImplantsCharge +
                    pf_BedCharge + pf_MedCharge + pf_TotalTax);

          if Abs(lf_RefAmt) < 0.5 then
          LabelPaidTotal.Caption :='0.00'
          Else
          LabelPaidTotal.Caption := format('%.2f', [(lf_RefAmt)]);
          // pf_AdjustedDeposit := (pf_InvestigationCharge + pf_DocServiceChrg + pf_BedCharge + pf_MedCharge + pf_TotalTax) - pf_TotalDiscount;
     End;
end;

procedure TForm_DischargeBilling.LoadDoctorService;
Var
  Tot_NetAmt: Double;
  i: Integer;
Begin
     { Auto Load Doctor Round Charge(Consultant) Only }
     If (pb_IsDischargedPt = False) Then
     Begin
          if ps_DisInDeposit = 'Y' then
          Begin
               With Query_Process do
               Begin
                    Close;
                    Session := DM_Hospital.DB;
                    sql.Clear;
                    sql.Add(' Select DoctorRoundVisitId From DOCTORROUNDVISIT Where InpatientId='+ IntToStr(pi_InpatientId));
                    sql.Add(' and VisitDate > ' + #39 + ps_DisInDepositDate + #39);
                    Open;

                    if Query_Process.FieldByName('DoctorRoundVisitId').AsInteger > 0 then
                    Begin
                         Close;
                         sql.Clear;
                         sql.Add(' Delete From DOCTORROUNDVISIT Where InpatientId=' + IntToStr(pi_InpatientId));
                         sql.Add(' and VisitDate > ' + #39 + ps_DisInDepositDate + #39);
                         ExecSQL;
                    End;
               End;
          End;

          // AutoLoadDoctorRoundVisit_Grande;
          AutoLoadDoctorRoundVisit;

          if gs_IsAutoIPVisitCharge2ndDoc = 'Y' then
          Begin
               if Trim(ps_DocCon2ndCode) <> '' then
                    AutoLoadDoctorRoundVisit_DoubleDoctor;
          End;
          AutoLoadAdditionalDoctorRoundVisit;
     End;

     Tot_NetAmt := 0;
     With Query_Process Do
     Begin
          Close;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.Add(' Select RoomTypeId,wardid,DocId,(select DOCT_DocName From HS_DOCT_Doctor where DOCT_Docid=DOCTORROUNDVISIT.Docid) as DocName,');
          sql.Add(' Case When (select DOCT_IsBlkDoctor From HS_DOCT_Doctor where DOCT_Docid=DOCTORROUNDVISIT.Docid)=''Y'' Then ''BLK'' Else ''BNB'' End as DoctorCategory,');
          sql.Add(' Sum(NOOFVISIT) as TotalVisit,Sum(VisitCharge) as VisitCharge,(Sum(VisitCharge*DisPer/100)/Sum(VisitCharge))*100 as DisPer,');
          sql.Add(' Sum(VisitCharge*DisPer/100) as Discount,Sum(VatAmt) as VatAmt,Count(PatientId) as Num From ');
          sql.Add(' DOCTORROUNDVISIT where InpatientId=' + IntToStr(pi_InpatientId)+ ' and VisitCharge > 0');
          sql.Add(' Group By RoomTypeId,DocId,Wardid Order by DocId');
          Open;
          Table_DoctorService.Close;
          Table_DoctorService.EmptyTable;
          Table_DoctorService.Open;
          While Not eof Do
          Begin
               With Table_DoctorService Do
               Begin
                    Append;
                    FieldByName('DocName').AsString := Query_Process.FieldByName('DocName').AsString;
                    FieldByName('DoctorCategory').AsString := Query_Process.FieldByName('DoctorCategory').AsString;
                    FieldByName('RoomTypeId').AsInteger := Query_Process.FieldByName('RoomTypeId').AsInteger;
                    FieldByName('Wardid').AsInteger := Query_Process.FieldByName('Wardid').AsInteger;
                    FieldByName('DocId').AsInteger := Query_Process.FieldByName('DocId').AsInteger;
                    FieldByName('Rate').AsFloat := (Query_Process.FieldByName('VisitCharge').AsFloat / Query_Process.FieldByName('TotalVisit').AsFloat);
                    FieldByName('Qty').AsFloat := Query_Process.FieldByName('TotalVisit').AsFloat;
                    FieldByName('Total').AsFloat := Query_Process.FieldByName('VisitCharge').AsFloat;
                    FieldByName('DisPer').AsFloat := Query_Process.FieldByName('DisPer').AsFloat;
                    FieldByName('Discount').AsFloat := Query_Process.FieldByName('Discount').AsFloat;
                    FieldByName('TaxAmt').AsFloat := Query_Process.FieldByName('VatAmt').AsFloat;
                    FieldByName('NetTotal').AsFloat := FieldByName('Total').AsFloat + FieldByName('TaxAmt').AsFloat - FieldByName('Discount').AsFloat;
                    Post;
               End;
               Next;
          End;
     End;
End;

procedure TForm_DischargeBilling.LoadEMRMedicarePTTotalChargeInfo;
Var
     lf_RefAmt: Double;
