                    sql.Clear;
                    Close;
                    sql.Clear;
                    sql.Add(' Select Sum(Total) as Total From (');
                    sql.Add(' Select Sum(ReceivedAmount) as Total From CreditPayment where InpatientId='+ IntToStr(pi_InpatientId) + ' and PayType=''CASH''');
                    sql.Add(' Union');
                    sql.Add(' Select -Sum(ReceivedAmount) as Total From CreditPayment where InpatientId='+ IntToStr(pi_InpatientId) + ' and PayType=''REFUND''');
