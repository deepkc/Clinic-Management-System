function TForm_DischargeBilling.SetTextWidth(sName: String; iLength: Integer)
  : String;
var
  whitespace: String;
  iLoop: Integer;
begin
  whitespace := '';
  For iLoop := 1 To iLength do
    whitespace := whitespace + ' ';
  Result := whitespace + sName;
end;

procedure TForm_DischargeBilling.SPB_SetDiscountClick(Sender: TObject);
begin
     IF ISDischargedPatient(pi_InpatientId) = True Then
     Begin
          MessageDlg('Sorry ! Patient is already discharged.', mtWarning, [mbOK], 0);
          Edi_DisPer.SetFocus;
          Exit;
     End;

     IF pi_SchemeId <= 0 Then
     Begin
          MessageDlg('You Must Have To Mention Scheme Before Giving Discount.',
               mtWarning, [mbOK], 0);
          Exit;
     End;

     IF Trim(Edi_DisPer.Text) = '' Then
          Edi_DisPer.Text := '0';



     If CBDiscount.Checked = True Then
     Edi_DisPer.Text :=FloatToStr(RoundingUserDefineDecaimalPart((StrToFloat(Edi_DisPer.Text) /
                    ((StrToFloat(LabelGrandTotal.Caption))-(StrToFloat(Edit_TotMedicineCharge.Text)))) * 100,5));

     IF StrToFloat(Edi_DisPer.Text) > 100 Then
     Begin
          MessageDlg('Discount Percent Exceeds 100 (%).', mtWarning, [mbOK], 0);
          Edi_DisPer.SetFocus;
          Exit;
     End;

     if gb_IsEmrDisBilling=False then
     begin
     if Query_GetAdmittedPatientInfo.FieldByName('ISTRANSLOCKED').AsString = 'Y' then
     Begin
          MessageDlg('Sorry ! Transaction Has Already Locked.', mtWarning, [mbOK], 0);
          Edi_DisPer.SetFocus;
          Exit;
     End;

     Try
          DM_Hospital.DB.StartTransaction;
          With Query_Process do
          Begin
               { Update Discount for IsDiscountable and Vatable Item }
               Close;
               sql.Clear;
               sql.Add(' Update HS_SEBD_ServiceBillDetail SBD set SBD.SEBD_DisPer=' +Edi_DisPer.Text);
               IF gs_TaxRule = 'TAD' Then
               Begin
                    sql.Add(' ,SEBD_VatAmt=Round(((SEBD_Qty*SEBD_Amount)-((SEBD_Qty*SEBD_Amount)*'+ Edi_DisPer.Text + '/100))*' + FloatToStr(gf_TaxPercent)+ '/100,4)');
                    sql.Add(' ,SEBD_DISCOUNT=Round((SEBD_Qty*SEBD_Amount*' +Edi_DisPer.Text + '/100),4)');
               End;
               sql.Add(' where SBD.SEBD_PatientId=' + IntToStr(pi_PatientId)+ ' and SEBD_InpatientID='+IntToStr(pi_InpatientId)+' and SBD.SEBD_BillDetailID=0');
               sql.Add(' and SBD.SEBD_SERVICEBILLDETAILID NOT IN (SELECT TECA_SERVICEBILLDETAILID FROM HS_TECA_TESTCANCEL WHERE TECA_SERVICEBILLDETAILID=SBD.SEBD_SERVICEBILLDETAILID)');

               // sql.add(' and IsDiscountable=''Y'' and IsVatable=''Y''');
               //SQL.SaveToFile('C:\DisPer.txt');
               ExecSQL;
               // ---------------------------------------------

               { Update Discount for IsDiscountable and Non Vatable Item }
               { Close;
                    sql.Clear;
                    sql.add(' Update ServiceBillDetail SBD Set SBD.Dis='+Edi_DisPer.Text);
                    IF gs_GovtTaxRule='TAD' Then
                    sql.add(' ,VatAmt=0');
                    sql.add(' where SBD.PatientId='+IntToStr(pi_PatientId)+' and SBD.BillDetailID=0');
                    sql.add(' and SBD.BSERVICEBILLDETAILID NOT IN (SELECT SERVICEBILLDETAILID FROM TESTCANCEL WHERE SERVICEBILLDETAILID=SBD.SERVICEBILLDETAILID)');
                    //sql.add(' IsDiscountable=''Y'' and IsVatable=''N''');
                    ExecSQL; }
               // ---------------------------------------------

               Close;
               sql.Clear;
               IF gs_TaxRule = 'TAD' Then
               Begin
                    sql.Add(' Update Hs_Inde_InpatientDetail set Inde_DisPer=' +Edi_DisPer.Text + ',');
                    sql.Add(' Inde_VatAmt=(Inde_BedCharge-(Inde_BedCharge*' +Edi_DisPer.Text + '/100))*' + FloatToStr(gf_TaxPercent) + '/100');
               End
               Else
                    sql.Add(' Update Hs_Inde_InpatientDetail set Inde_DisPer=' +Edi_DisPer.Text);
               sql.Add(' where Inde_InpatientId=' + IntToStr(pi_InpatientId));
               ExecSQL;

               Close;
               SQL.Clear;
               SQL.Add('Update HS_Inre_InpatientReg Set Inre_Disper='+Edi_DisPer.Text);
               SQL.Add(' where Inre_InpatientId=' + IntToStr(pi_InpatientId));
               ExecSQL;

               Close;
               sql.Clear;
               sql.Add(' Update DoctorRoundVisit set DisPer=' + Edi_DisPer.Text);
               IF gs_TaxRule = 'TAD' Then
                    sql.Add(' ,VatAmt=(VisitCharge-(VisitCharge*' + Edi_DisPer.Text +
                              '/100))*' + FloatToStr(gf_TaxPercent) + '/100');
               sql.Add(' where InpatientId=' + IntToStr(pi_InpatientId));
               ExecSQL;


               Close;
               sql.Clear;
               sql.Add(' Update HS_FRDE_FractionDetail set FRDE_DisPer=' +Edi_DisPer.Text);
               sql.Add(' where FRDE_PatientId=' + IntToStr(pi_PatientId)+' and FRDE_InPatientId=' + IntToStr(pi_InPatientId));
               sql.Add(' AND FRDE_SERVICEBILLDETAILID In (Select SEBD_SERVICEBILLDETAILID From HS_SEBD_ServiceBillDetail SBD Where ');
               sql.Add(' SBD.SEBD_PatientId=' + IntToStr(pi_PatientId) +' and SBD.SEBD_InPatientId=' + IntToStr(pi_InPatientId) +' and SBD.SEBD_BillDetailId=0 and ');
               sql.Add(' SBD.SEBD_SERVICEBILLDETAILID NOT IN (SELECT TECA_SERVICEBILLDETAILID FROM HS_TECA_TESTCANCEL WHERE TECA_SERVICEBILLDETAILID=SBD.SEBD_SERVICEBILLDETAILID))');
               ExecSQL;

               (*Close;
               sql.Clear;
               sql.Add(' Update HS_FRDE_FractionDetail set FRDE_DisPer=' +Edi_DisPer.Text);
               sql.Add(' where FRDE_PatientId=' + IntToStr(pi_PatientId));
               sql.Add(' and FRDE_TestNameCode In (Select Distinct FD.FRDE_TestNameCode From HS_FRDE_FractionDetail FD,VW_HS_SETUP_TESTNAMEPRICE TN');
               sql.Add(' where FRDE_TestNameCode=TN.TestNameCode and PatientTypeCode=' + #39 + ps_PatientTypeCode + #39);
               sql.Add(' and TN.ISDISCOUNTABLE=''Y'' and FD.FRDE_PatientId=' + IntToStr(pi_PatientId) + ')');
               sql.Add(' AND FRDE_SERVICEBILLDETAILID In (Select SEBD_SERVICEBILLDETAILID From HS_SEBD_ServiceBillDetail SBD Where ');
               sql.Add(' SBD.SEBD_PatientId=' + IntToStr(pi_PatientId) +' and SBD.SEBD_BillDetailId=0 and ');
               sql.Add(' SBD.SEBD_SERVICEBILLDETAILID NOT IN (SELECT TECA_SERVICEBILLDETAILID FROM HS_TECA_TESTCANCEL WHERE TECA_SERVICEBILLDETAILID=SBD.SEBD_SERVICEBILLDETAILID))');
               // sql.saveToFile('C:\ServicBillDetail.Txt');
               ExecSQL;*)
          End;
          DM_Hospital.DB.Commit;
          ShowDoneMessage;
     Except
          DM_Hospital.DB.RollBack;
     End;
     end
     else
     begin
          try
          DM_Hospital.DB.StartTransaction;
          With Query_Process do
          Begin
               { Update Discount for IsDiscountable and Vatable Item }
               Close;
               sql.Clear;
               sql.Add(' Update HS_SEBD_ServiceBillDetail SBD set SBD.SEBD_DisPer=' +Edi_DisPer.Text);
               IF gs_TaxRule = 'TAD' Then
               Begin
                    sql.Add(' ,SEBD_VatAmt=Round(((SEBD_Qty*SEBD_Amount)-((SEBD_Qty*SEBD_Amount)*'+ Edi_DisPer.Text + '/100))*' + FloatToStr(gf_TaxPercent)+ '/100,4)');
