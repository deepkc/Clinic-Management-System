procedure TForm_DischargeBilling.BB_SaveClick(Sender: TObject);
Var
  li_InpatientDID: Integer;
begin
     if StrToInt(Edit_HospitalNo.Text) <> StrToInt(Label_HospitalNo.Caption) then
     begin
          MessageDlg('Hospital No Mismatch ! The displaying no is " ' + Edit_HospitalNo.Text +' " but you are doing discharge for this no " ' +
               Label_HospitalNo.Caption + ' ".', mtWarning, [mbOK], 0);
          Edit_HospitalNo.SetFocus;
          Exit;
     end;

     if (CMBPayType.ItemIndex = 1) and (pi_SchemeId = 0) then
     Begin
          MessageDlg('Sorry Without Any Scheme, You Cannot Do Credit Billing.', mtWarning, [mbOK], 0);
          CMBPayType.SetFocus;
          Exit;
     End;

     if gb_IsEmrDisBilling = False then
     Begin
          if Query_Specialdeposit.FieldByName('Depositamount').AsFloat>0 then
          Begin
               if MessageDlg('This Patient is Special Case Patient. Do you really want to do Final Billing?', mtConfirmation, [mbYes, mbNo], 0) = mrNo then
               Exit;
          End;
     End;

     IF CMBPayType.ItemIndex In [0] Then
          ps_PayType := 'CASH'
     Else
     Begin
          FormCreditMessage.ShowModal;
          If gb_IsCreditBill = False Then
          Begin
               CMBPayType.ItemIndex := 0;
               Exit;
          End;
          ps_PayType := 'CREDIT';
     End;

     if gb_IsEmrDisBilling = True then
     begin
          if IsEmrTransactionExist = False then
          Begin
               MessageDlg( 'No Any Transaction Occur To Generate Bill. So Please Just Click On Emergency Patient Clearance.', mtWarning, [mbOK], 0);
               Exit;
          End;

          EMRMedicarePTFinalBill;
          if MessageDlg('Do You Want To Print Emergency Final Bill ?', mtConfirmation, [mbYes, mbNo], 0) = mrYes then
          Begin
               if gb_IsEmrDisBilling = True then
               begin
                    gi_BillCase := 2;
                    Gb_IsReprint := False;
                    //PrintDischargeBill;
                    PrintEmergencyBill;
               end;
          End;
          Exit;
     end;

     IF ISDischargedPatient(pi_InpatientId) = True Then
     Begin
          MessageDlg('Sorry ! Patient is already discharged.', mtWarning, [mbOK], 0);
          CMBPayType.SetFocus;
          Exit;
     End;

     IF IsPrevUnsettledInptTransExist(pi_InpatientId,pi_PatientId)=True Then
     Begin
          MessageDlg('Sorry ! There is one unsettled transaction exist(IP No : '+IntToStr(gi_InPatientID)+' ) before of this admission.', mtWarning, [mbOK], 0);
          gi_InPatientID:=pi_InpatientId;
          Exit;
     End;

     if (gs_ISINTEGRATEDPHARMACY = 'Y') Or (gs_IsPHClearanceB4DisBill = 'Y') then
     begin
          IF (CB_IsPaharmacyApproved.Checked = False) and (IsCreditAmountExistInPharmacy(pi_PatientId,pi_InpatientId)=True) Then
          Begin
               MessageDlg('Pharmacy Clearance Yet Not Done. Please Contact at Pharmacy.' , mtWarning, [mbOK], 0);
               Edit_HospitalNo.SetFocus;
               Exit;
          End;
     end;


     if (StrToFloat(LabelPaidTotal.Caption) > 0) and (CMBPayType.Text = 'CASH') then
     begin
          MessageDlg('The Payment or Return Amount Should be Zero(0)', mtWarning, [mbOK], 0);
          Exit;
     end;

     IF (ps_RateType <> 'FRG') and (pi_CommunityId <= 0) and (CMBPayType.ItemIndex = 1) Then
     Begin
          MessageDlg('Sorry ! Without any community you cannot do credit billing.', mtWarning, [mbOK], 0);
          CMBPayType.SetFocus;
          Exit;
     End;

     IF (gs_DischargeSystem = 'MDF') and (DischargeModeChecking(pi_InpatientId, 'FD') = False) Then
     // FD - Financial Discharge
     Begin
          MessageDlg('This Patient is not Medically Discharged From Ward.', mtWarning, [mbOK], 0);
          Exit;
     End;

     IF MessageDlg('Do you really want to do final billing     ?', mtConfirmation,
          [mbYes, mbNo], 0) <> mrYes Then
     Begin
          CMBPayType.SetFocus;
          Exit;
     End;

     (*with Query_Process Do
     Begin
          Close;
          sql.Clear;
          sql.Add(' Select DepCode,DepId From Department where DepCode In (Select DepCode From InPatientDetail ');
          sql.Add(' where InPatientDID In (Select Max(InPatientDID) as InPatientDID From InPatientDetail');
          sql.Add(' where InpatientId=' + IntToStr(pi_InpatientId) + '))');
          Open;
     End;*)

     { Get Max InpatientDetail Id Of the Inpatient }
     with Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.Add(' Select Max(Inde_InpatientDID) as InpatientDId From Hs_Inde_InpatientDetail where Inde_InpatientId=' + IntToStr(pi_InpatientId));
          Open;
     End;
     li_InpatientDID := Query_Process.FieldByName('InpatientDID').AsInteger;

     with QueryCheckFileStatus do
     begin
          Close;
          sql[2] := ' Where FIST_PatientId=' + IntToStr(pi_PatientId);
          Open;
     end;

     ps_TodaysDate := TodaysDate;
     ps_TodaysTime := TodaysTime;

     if gs_ISINTEGRATEDPHARMACY = 'Y' then
     Begin
          GetMaxPharmacy_Sale_Return_ID;
          with Query_TempProcess
           do
          Begin
               DatabaseName := gs_temppath;
               Close;
               sql.Clear;
               sql.Add(' Select Sum(TaxAmt) as TaxAmt,Sum(Total) as Total, Sum(Discount) as Discount,');
               sql.Add(' Sum(Total+TaxAmt-Discount) as NetTotal,Sum(PharmacyCost) as PharmacyCost From MedicineCharge.db where ReturnStatus Is Null');
               Open;

               pf_MedTotal := Query_TempProcess.FieldByName('Total').AsFloat;
               pf_MedTaxAmt := Query_TempProcess.FieldByName('TaxAmt').AsFloat;
               pf_MedDiscount := Query_TempProcess.FieldByName('Discount').AsFloat;
               pf_MedNetTotal := Query_TempProcess.FieldByName('NetTotal').AsFloat;
               pf_PharmacyCost := Query_TempProcess.FieldByName('PharmacyCost').AsFloat;

               Close;
               sql.Clear;
               sql.Add(' Select Sum(TaxAmt) as TaxAmt,Sum(Total) as Total,Sum(Discount) as Discount,');
               sql.Add(' Sum(Total+TaxAmt-Discount) as NetTotal,Sum(PharmacyCost) as PharmacyCost From MedicineCharge.db where ReturnStatus=''R''');
               Open;

               pf_MedTotal := pf_MedTotal - Query_TempProcess.FieldByName('Total').AsFloat;
               pf_MedTaxAmt := pf_MedTaxAmt - Query_TempProcess.FieldByName('TaxAmt').AsFloat;
               pf_MedDiscount := pf_MedDiscount - Query_TempProcess.FieldByName('Discount').AsFloat;
               pf_MedNetTotal := pf_MedNetTotal - Query_TempProcess.FieldByName('NetTotal').AsFloat;
               pf_PharmacyCost := pf_PharmacyCost - Query_TempProcess.FieldByName('PharmacyCost').AsFloat;
          End;
     End;

     if gs_IsSurImplantsIssuePatientWise = 'Y' then
     Begin
          GetMaxSurOT_Sale_Return_ID;
          with Query_TempProcess do
          Begin
               DatabaseName := gs_temppath;
               Close;
               sql.Clear;
               sql.Add(' Select Sum(TaxAmt) as TaxAmt,Sum(Total) as Total, Sum(Discount) as Discount,');
               sql.Add(' Sum(Total+TaxAmt-Discount) as NetTotal,Sum(PharmacyCost) as PharmacyCost From SurgicalItemsCharge.db where ReturnStatus Is Null');
               Open;

               pf_SurgTotal := Query_TempProcess.FieldByName('Total').AsFloat;
               pf_SurgTaxAmt := Query_TempProcess.FieldByName('TaxAmt').AsFloat;
               pf_SurgDiscount := Query_TempProcess.FieldByName('Discount').AsFloat;
               pf_SurgNetTotal := Query_TempProcess.FieldByName('NetTotal').AsFloat;
               pf_SurgicalCost := Query_TempProcess.FieldByName('PharmacyCost').AsFloat;

               Close;
               sql.Clear;
               sql.Add(' Select Sum(TaxAmt) as TaxAmt,Sum(Total) as Total,Sum(Discount) as Discount,');
               sql.Add(' Sum(Total+TaxAmt-Discount) as NetTotal,Sum(PharmacyCost) as PharmacyCost From SurgicalItemsCharge.db where ReturnStatus=''R''');
               Open;

               pf_SurgTotal := pf_SurgTotal - Query_TempProcess.FieldByName('Total').AsFloat;
               pf_SurgTaxAmt := pf_SurgTaxAmt - Query_TempProcess.FieldByName('TaxAmt').AsFloat;
               pf_SurgDiscount := pf_SurgDiscount - Query_TempProcess.FieldByName('Discount').AsFloat;
               pf_SurgNetTotal := pf_SurgNetTotal - Query_TempProcess.FieldByName('NetTotal').AsFloat;
               pf_SurgicalCost := pf_SurgicalCost - Query_TempProcess.FieldByName('PharmacyCost').AsFloat;
          End;
     End;

     ps_Patientcategory:=GetPatientCagetory(pi_PatientId);

     With Query_DepoToBeAdjust do
     Begin
          Close;
          Session:=DM_Hospital.db;
          sql.Clear;
          sql.add(' Select * From HS_DEPO_Deposit where DEPO_INPATIENTID='+IntToStr(pi_InpatientId));
          sql.add(' and DEPO_REFERENCENO Is Null and NVL(DEPO_REFERENCETYPE,''NA'') Not In (''ADJ. IN DISCHARGE'',''DISCHARGE ADJUSTED DEPOSIT'')');
          sql.add(' and DEPO_DepositNo Not In (Select DEPO_REFERENCENO From HS_DEPO_Deposit where DEPO_InpatientID='+IntToStr(pi_InpatientId)+' and DEPO_REFERENCENO Is Not NULL');
          sql.add(' and NVL(DEPO_REFERENCETYPE,''NA'') Not In (''ADJ. IN DISCHARGE'',''DISCHARGE ADJUSTED DEPOSIT''))');
          Open;
     End;


     Try
          DM_Hospital.DB.StartTransaction;
          SaveFinalDiachargeBill;


          if gs_IsSurImplantsIssuePatientWise = 'Y' then
          Begin
               { Update Surgical OT Final Bill Done }
               With Query_Process do
               Begin
                    Close;
                    Session := DM_Hospital.DB;
                    sql.Clear;
                    sql.Add(' Update '+gs_DB_UserName_OTIMPLANT+'.SaleMaster Set Cashed=''Y'',BillNo=' + #39 +Gs_BillNo + #39);
                    sql.Add(' where NVL(PatientTypeID,0)=0 and ST=''N'' and STATUS1=1 and Cashed=''N''');
                    sql.Add(' and CustomerId=' + IntToStr(pi_PatientId));
                    sql.Add(' and InpatientId=' + IntToStr(pi_InpatientId));
                    if ps_DisInDeposit = 'Y' then
                         sql.Add(' and NVL(DisInDepositTransId,0)=' + IntToStr(pi_DisInDepositTransId))
                    Else
                    Begin
                         if ps_PreveDisInDepositTransExist = 'Y' then
                              sql.Add(' and NVL(DisInDepositTransId,0) Not In (' +ps_DisInDepositTransId + ')');
                    End;
                    sql.Add(' and SaleMasterId <=' + IntToStr(pi_SurOTMaxSaleMasterId));
                    ExecSQL;

                    { Retrun master }
                    Close;
                    sql.Clear;
                    sql.Add(' Update '+gs_DB_UserName_OTIMPLANT+'.ReturnMaster Set Cashed=''Y'',BillNo=' + #39 +Gs_BillNo + #39);
                    sql.Add(' where NVL(PatientTypeID,0)=0 and ST=''N'' and Credit1=1 and Cashed=''N''');
                    sql.Add(' and CustomerId=' + IntToStr(pi_PatientId));
                    sql.Add(' and ReturnMasterId <=' + IntToStr(pi_SurOTMaxReturnMasterId));
                    sql.Add(' and ReturnDate >=' + #39 + DEX_AdmnDate.Text + #39 +' and ReturnDate <=' + #39 + DEX_DisDate.Text + #39);
                    if ps_DisInDeposit = 'Y' then
                         sql.Add(' and NVL(DisInDepositTransId,0)=' + IntToStr(pi_DisInDepositTransId))
                    Else
                    Begin
                         if ps_PreveDisInDepositTransExist = 'Y' then
                              sql.Add(' and NVL(DisInDepositTransId,0) Not In (' +ps_DisInDepositTransId + ')');
                    End;
                    ExecSQL;
               End;
          End;

          if gs_ISINTEGRATEDPHARMACY = 'Y' then
          Begin
               { Update Pharmacy Final Bill Done }
               With Query_Process do
               Begin
                    Close;
                    Session := DM_Hospital.DB;
                    sql.Clear;
                    sql.Add(' Update SaleMaster Set Cashed=''Y'',BillNo=' + #39 +Gs_BillNo + #39);
                    sql.Add(' where NVL(PatientTypeID,0)=0 and ST=''N'' and STATUS1=1 and Cashed=''N''');
                    sql.Add(' and CustomerId=' + IntToStr(pi_PatientId));
                    sql.Add(' and InpatientId=' + IntToStr(pi_InpatientId));
                    if ps_DisInDeposit = 'Y' then
                         sql.Add(' and NVL(DisInDepositTransId,0)=' + IntToStr(pi_DisInDepositTransId))
                    Else
                    Begin
                         if ps_PreveDisInDepositTransExist = 'Y' then
                              sql.Add(' and NVL(DisInDepositTransId,0) Not In (' +ps_DisInDepositTransId + ')');
                    End;
                    sql.Add(' and SaleMasterId <=' + IntToStr(pi_MaxSaleMasterId));
                    ExecSQL;

                    { Retrun master }
                    Close;
                    sql.Clear;
                    sql.Add(' Update ReturnMaster Set Cashed=''Y'',BillNo=' + #39 +Gs_BillNo + #39);
                    sql.Add(' where NVL(PatientTypeID,0)=0 and ST=''N'' and Credit1=1 and Cashed=''N''');
                    sql.Add(' and CustomerId=' + IntToStr(pi_PatientId));
                    sql.Add(' and ReturnMasterId <=' + IntToStr(pi_MaxReturnMasterId));
                    sql.Add(' and ReturnDate >=' + #39 + DEX_AdmnDate.Text + #39 +' and ReturnDate <=' + #39 + DEX_DisDate.Text + #39);
                    if ps_DisInDeposit = 'Y' then
                         sql.Add(' and NVL(DisInDepositTransId,0)=' + IntToStr(pi_DisInDepositTransId))
                    Else
                    Begin
                         if ps_PreveDisInDepositTransExist = 'Y' then
                              sql.Add(' and NVL(DisInDepositTransId,0) Not In (' +ps_DisInDepositTransId + ')');
                    End;
                    ExecSQL;
               End;
          End;

          { Update Credit Scheme of Dischare Bill }
          if CMBPayType.ItemIndex = 1 then // 1 - For Credit
          begin
               with Query_Process do
               Begin
                    Close;
                    Session := DM_Hospital.DB;
                    sql.Clear;
                    sql.Add(' Update HS_BIDE_BillDetail Set BIDE_CrCommunityId=' + IntToStr(pi_CommunityId) + ', BIDE_CrSchemeId=' + IntToStr(pi_SchemeId));
                    sql.Add(' Where BIDE_BillNo=' + #39 + Gs_BillNo + #39);
                    ExecSQL;
               End;
          end;

          { Update InpatientDetail Info }
          with Query_Process do
          Begin
               Close;
               Session := DM_Hospital.DB;
               sql.Clear;
               sql.Add(' Update HS_INDE_InpatientDetail set');

               IF ps_DisInDeposit = 'N' Then
                    sql.Add(' INDE_OutDate=' + #39 + ps_TodaysDate + #39 + ',')
               Else
                    sql.Add(' INDE_OutDate=' + #39 + DEX_DisDate.Text + #39 + ',');
               sql.Add(' INDE_OutTime=' + #39 + ps_TodaysTime + #39);
               sql.Add(' where INDE_InpatientDID=' + IntToStr(li_InpatientDID));
               ExecSQL;
          End;

          { Update InpatientReg Info }
          with Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.Add(' Update HS_INRE_InpatientReg set INRE_ISDischarged=''Y'' ,INRE_DisDate='+ #39 + ps_TodaysDate + #39);
               sql.Add(' ,INRE_DisBillDate=' + #39 + ps_TodaysDate + #39 +' ,INRE_DisBillTime=' + #39 + ps_TodaysTime + #39 +
                                    ', INRE_DisBillNo=' + #39 + Gs_BillNo + #39);
               if CB_NoDepositAdjustment.Checked = False then
                    sql.Add(' ,INRE_DepositBalance=' + FloatToStr(pf_Deposit))
               Else
                    sql.Add(' ,INRE_DepositBalance=0');
               sql.Add(' where INRE_InpatientId=' + IntToStr(pi_InpatientId));
               ExecSQL;

               Close;
               sql.Clear;
               sql.Add(' Update Bed set Vacant=''T'' where WardId=' + IntToStr(Pi_WardId));
               sql.Add(' and RoomTypeId=' + IntToStr(Pi_RoomTypeId)+ ' and BedNo=' + #39 + ps_BedNo + #39);
               ExecSQL;

               if gs_IsFileMgmtActive='Y' then
               Begin
                    Close;
                    sql.Clear; { IPD - Inpatient Discharge , at the admission time it is IP }
                    sql.Add(' Update HS_FIST_FILESTATUS set FIST_IPStatus=''IPD'' where FIST_FileId='+ IntToStr(QueryCheckFileStatus.FieldByName('FileId').AsInteger));
                    ExecSQL;
               End;
          End;
          DM_Hospital.DB.Commit;
          pb_IsDischargedPt := True;
          SBP_Print.Enabled := True;
          BB_Save.Enabled := False;
          BitBtn_DepositAddReturn.Enabled := False;
     Except
          DM_Hospital.DB.RollBack;
          pb_IsDischargedPt := False;
          MessageDlg('Failure To Complete Discharge Billing !', mtWarning, [mbOK], 0);
          Exit;
     End;

     ShowDoneMessage;
     Label5.Visible := True;
     Lbl_BillNo.Visible := True;
     Lbl_BillNo.Caption := Gs_BillNo;

     if MessageDlg('Do You Want To Print Discharge Bill', mtConfirmation,
          [mbYes, mbNo], 0) = mrYes then
     Begin
          Try
               LoadCategoryWiseForDischargeBill;
               pb_IsReprintBill := False;
               gi_noOfPrint := 0;

               //PrintDischargeBill;
               PrintDischargeBill;
          Except
               MessageDlg('Discharge Bill is Sucessfully Saved. Only Printing Problem.',
                    mtWarning, [mbOK], 0);
               Exit;
          End;
     End;

     //BitBtn_DischargeSlipPrint.Enabled := True;
     //BitBtn_DischargeSlipPrintClick(Sender);
     (* if MessageDlg('Do You Want To Print Discharge Slip',mtConfirmation,[mbYes,mbNo],0)=mrYes then
     Begin
          Try
          BitBtn_DischargeSlipPrintClick(Sender);
          Except
          MessageDlg('Failure To Print Discharge Slip. Please Try Again From Discharge Slip.', mtWarning, [mbok], 0);
          Exit;
          End;
     End; *)
End;

procedure TForm_DischargeBilling.SaveFinalDiachargeBill;
