     Table_FinalDischBillDetail.Close;
     IF FileExists(gs_temppath + '\FinalDischargeBillDetail.db') Then
          DeleteFile(gs_temppath + '\FinalDischargeBillDetail.db');
     with Table_FinalDischBillDetail do
     Begin
          DatabaseName := gs_temppath;
          Close;
          Exclusive := False;
          TableName := 'FinalDischargeBillDetail.db';
          TableType := ttDefault;
          FieldDefs.Clear;
          FieldDefs.Add('PaymentCategory', ftString, 80);
