procedure TForm_DischargeBilling.FillDailyBed;
Var
  ls_TodayDate, ls_BedStartDate, ls_BedLastDate, ls_CurrTime: String;
  pb_IsDischarged: Boolean;
  DEX_ExchangeDate: TDateEditX;
begin
     DEX_ExchangeDate := TDateEditX.Create(Nil);
     DEX_ExchangeDate.SystemOfDate := gi_DateSystem;
     With Table_DailyBed Do
     Begin
          Close;
          DatabaseName := gs_temppath;
          EmptyTable;
          Open;
     End;

     With Query_BedDetail do
     Begin
          Close;
          sql.Clear;
          sql.Add(' Select INDE_InPatientDID InPatientDID,IPD.INDE_WardID WardID,IPD.INDE_ROOMTYPEID ROOMTYPEID,INDE_BedNo BedNo,INDE_InPTDate InPTDate,INDE_OutDate OutDate,IPD.INDE_PatientTypeCode PatientTypeCode, ');
          sql.Add(' RT.NURSINGCARECHARGE,RT.NURSINGCARESVRTAX,RT.ROUNDVISITCHARGE,RT.ROUNDVISITSVRTAX,RT.HOSPARTPERCENT');
          sql.Add(' From HS_INDE_InPatientDetail IPD,VW_HS_SETUP_ROOMTYPEPRICE RT');
          sql.Add(' where IPD.INDE_RoomTypeID=RT.RoomTypeID(+) and IPD.INDE_PatientTypeCode=RT.PatientTypeCode(+)');
          sql.Add(' and INDE_Inpatientid=' + IntToStr(pi_InpatientId));
          sql.Add(' Order By INDE_InPatientDID');
          Open;
          First;
          While Not eof Do
          Begin
               ls_BedStartDate := FieldByName('InPTDate').AsString;
               If Trim(FieldByName('OutDate').AsString) = 'C' Then
               Begin
                    IF ps_DisInDeposit = 'Y' Then
                    BEGIN
                         ls_BedLastDate := ps_DisInDepositDate;
                         ls_CurrTime := TodaysTime;
                    END
                    Else
                    BEGIN
                         ls_BedLastDate := ps_DisDate;
                         ls_CurrTime := TodaysTime;
                    END;
                    if ls_CurrTime < '13:00:00' then
                    begin
                         DEX_ExchangeDate.SystemOfDate := gi_DateSystem;
                         DEX_ExchangeDate.Text := ls_BedLastDate;
                         DEX_ExchangeDate.VSDateAsDays := DEX_ExchangeDate.VSDateAsDays - 1;
                         ls_BedLastDate := DEX_ExchangeDate.Text;
                    end;
               End
               Else
                    ls_BedLastDate := FieldByName('OutDate').AsString;

               While ls_BedStartDate <= ls_BedLastDate Do
               Begin
                    DEX_ExchangeDate.Text := ls_BedStartDate;
                    ls_BedStartDate := GetFromDateBySubNoOfDays(DEX_ExchangeDate, -1);
                    IF Not Table_DailyBed.Locate('BedDate', DEX_ExchangeDate.Text, []) Then
                         Table_DailyBed.Append
                    Else
                         Table_DailyBed.Edit;
                    Table_DailyBed.FieldByName('InPatientID').AsInteger := pi_InpatientId;
                    Table_DailyBed.FieldByName('PatientID').AsInteger := gi_PatientId;
                    Table_DailyBed.FieldByName('WardId').AsString :=Query_BedDetail.FieldByName('WardId').AsString;
                    Table_DailyBed.FieldByName('RoomTypeId').AsString :=Query_BedDetail.FieldByName('RoomTypeID').AsString;
                    Table_DailyBed.FieldByName('BedNo').AsString :=Query_BedDetail.FieldByName('BedNo').AsString;
                    Table_DailyBed.FieldByName('BedDate').AsString := DEX_ExchangeDate.Text;
                    Table_DailyBed.FieldByName('NURSINGCARECHARGE').AsFloat :=Query_BedDetail.FieldByName('NURSINGCARECHARGE').AsFloat;
                    Table_DailyBed.FieldByName('NURSINGCARESVRTAX').AsFloat :=Query_BedDetail.FieldByName('NURSINGCARESVRTAX').AsFloat;
                    Table_DailyBed.FieldByName('ROUNDVISITCHARGE').AsFloat :=Query_BedDetail.FieldByName('ROUNDVISITCHARGE').AsFloat;
                    Table_DailyBed.FieldByName('ROUNDVISITSVRTAX').AsFloat :=Query_BedDetail.FieldByName('ROUNDVISITSVRTAX').AsFloat;
                    Table_DailyBed.FieldByName('HOSPARTPERCENT').AsFloat :=Query_BedDetail.FieldByName('HOSPARTPERCENT').AsFloat;
                    Table_DailyBed.Post;
               End;
               Next;
          End;
     End;

     With Table_DailyBed Do
     Begin
          Close;
          Open;
     End;

     DEX_ExchangeDate.Free;
end;

procedure TForm_DischargeBilling.LoadBedCharge;
var
  lf_DisAmt, lf_TotAmt, lf_VatAmt: Double;
  ls_CurrentDate, ls_CurrentTime, ls_CurTime, ls_IsDischargePoint: String;
  i: Integer;
Begin
     with Query_GetBedCharge do
     Begin
          Close;
          // ParamByName('InpatientId').AsInteger := pi_InpatientId;
          { if ps_DisInDeposit='Y' then
          Begin
               if ps_PreveDisInDepositTransExist='Y' then
               sql[4]:=' and NVL(DisInDepositTransId,0) Not In ('+ps_DisInDepositTransId)+')'
               Else
               sql[4]:=' and NVL(DisInDepositTransId,0)='+IntToStr(pi_DisInDepositTransId);
          End
          Else }
          sql[4] := ' and IPD.InDe_InPatientId=' + IntToStr(pi_InpatientId);
          //sql[12] := ' and IPD.InDe_InPatientId=' + IntToStr(pi_InpatientId);
          //sql[13] := ' AND RT.PATIENTTYPECODE=' + QuotedStr(ps_PatientTypeCode);
          //SQL.SaveToFile('C:\getbedcharge.txt');
          Open;
     End;

     Table_BedCharge.DatabaseName := gs_temppath;
     Table_BedCharge.Close;
     Table_BedCharge.Exclusive := True;
     Table_BedCharge.EmptyTable;
     Table_BedCharge.Open;

     pb_IsLastDayBedChrgZero := False;

     Query_GetBedCharge.First;
     i := 0;
     while not Query_GetBedCharge.eof do
     Begin
          i := i + 1;
          ls_CurrentDate := Query_GetBedCharge.FieldByName('OutDate').AsString;
          ls_IsDischargePoint := 'N';
          IF ls_CurrentDate = 'C' Then { *** C- means at Current.... }
          Begin
               IF ps_DisInDeposit = 'Y' Then
               Begin
                    DEX_DisDate.SystemOfDate := gi_DateSystem;
                    ls_CurrentDate := DEX_DisDate.Text;
               End
               Else
                    ls_CurrentDate := ServerDate.TodaysDate;

               ls_CurTime := ServerDate.TodaysTime;

               Pi_WardId := Query_GetBedCharge.FieldByName('WardId').AsInteger;
               Pi_RoomTypeId := Query_GetBedCharge.FieldByName('RoomTypeId').AsInteger;
               ps_BedNo := Query_GetBedCharge.FieldByName('BedNo').AsString;
               ls_CurrentTime := 'C';
          End
          Else
          Begin
               ls_CurrentTime := Query_GetBedCharge.FieldByName('OutTime').AsString;

               IF Trim(Query_GetBedCharge.FieldByName('DisBillDate').AsString) <> '' Then
               Begin
                    ls_IsDischargePoint := 'Y';
                    (*IF ps_DisInDeposit = 'Y' Then
                    Begin
                         DEX_DisDate.SystemOfDate := gi_DateSystem;
                         ls_CurrentDate := DEX_DisDate.Text;
                    End;*)
               End;

          End;
          pi_NoOfDays := GetTotalDays(Query_GetBedCharge.FieldByName('InptDate').AsString, ls_CurrentDate, ls_CurrentTime, ls_IsDischargePoint);


          Table_BedCharge.Append;
          Table_BedCharge.FieldByName('AdmnDate').AsString :=Query_GetBedCharge.FieldByName('InptDate').AsString;
          Table_BedCharge.FieldByName('AdmnTime').AsString :=Query_GetBedCharge.FieldByName('InTime').AsString;
          Table_BedCharge.FieldByName('RoomType').AsString :=Query_GetBedCharge.FieldByName('RoomType').AsString;
          Table_BedCharge.FieldByName('RoomTypeID').AsInteger :=Query_GetBedCharge.FieldByName('RoomTypeId').AsInteger;
          Table_BedCharge.FieldByName('RoomTypeCode').AsString :=Query_GetBedCharge.FieldByName('RoomTypeCode').AsString;
          Table_BedCharge.FieldByName('Rate').AsFloat :=Query_GetBedCharge.FieldByName('BedCharge').AsFloat;
          Table_BedCharge.FieldByName('WardId').AsInteger := Query_GetBedCharge.FieldByName('WardId').AsInteger;
          pf_DisPer := Query_GetBedCharge.FieldByName('DisPer').AsFloat;

          If (pi_NoOfDays = 0) and (i = 1) Then
          { *** except GENERAL patient that bed charge will be charged from inpatient date but in case of general it is charged after complete 1 days }
          Begin
               lf_TotAmt := Query_GetBedCharge.FieldByName('BedCharge').AsFloat * 1;
               lf_VatAmt := Query_GetBedCharge.FieldByName('VatAmt').AsFloat * 1;
               Table_BedCharge.FieldByName('TotalDays').AsInteger := 1;

               // For Medicare Apply From Date 2068/11/19
               IF (gi_HospitalId = 19) and (ls_CurrentTime = 'C') and (pi_NoOfDays = 0)
                    Then
               Begin
                    lf_TotAmt := 0;
                    Table_BedCharge.FieldByName('Rate').AsFloat := 0;
                    pb_IsLastDayBedChrgZero := True;
               End;
          End
          Else
          Begin
               lf_TotAmt := Query_GetBedCharge.FieldByName('BedCharge').AsFloat * pi_NoOfDays;
               lf_VatAmt := Query_GetBedCharge.FieldByName('VatAmt').AsFloat * pi_NoOfDays;
               Table_BedCharge.FieldByName('TotalDays').AsInteger := pi_NoOfDays;
          End;
          Table_BedCharge.FieldByName('Total').AsFloat := StrToFloat(format('%.5f', [lf_TotAmt]));
          if pf_DisPer > 0 then
          Begin
               lf_DisAmt := lf_TotAmt * (pf_DisPer / 100);
               IF gs_TaxRule = 'TAD' Then
                    Table_BedCharge.FieldByName('TaxAmt').AsFloat :=((lf_TotAmt - lf_DisAmt) * gf_TaxPercent / 100)
               Else
                    Table_BedCharge.FieldByName('TaxAmt').AsFloat :=(lf_TotAmt * gf_TaxPercent / 100);
          End
          Else
          Begin
               lf_DisAmt := 0;
               Table_BedCharge.FieldByName('TaxAmt').AsFloat := lf_VatAmt;
          End;

          Table_BedCharge.FieldByName('Discount').AsFloat := StrToFloat(format('%.5f', [lf_DisAmt]));
          Table_BedCharge.FieldByName('DisPer').AsFloat :=Query_GetBedCharge.FieldByName('DisPer').AsFloat;
          Table_BedCharge.FieldByName('NetTotal').AsFloat := StrToFloat(format('%.5f', [(lf_TotAmt + Table_BedCharge.FieldByName('TaxAmt').AsFloat) - lf_DisAmt]));
          Table_BedCharge.FieldByName('InpatientDID').AsInteger :=Query_GetBedCharge.FieldByName('InpatientDID').AsInteger;
          Table_BedCharge.Post;

          Query_GetBedCharge.Next;
     End;

     { IF (gi_HospitalId=19) And     (ppb_IsDischargePt=False) Then
          Room_Type_Wise_SvrChrg_Posting(Gi_PatientId,Gi_InPatientId,pi_CommunityId,pi_SchemeId,
          ps_MemberNo,Query_GetBedCharge.FieldByName('RoomTypeCode').AsString,ps_PatientType,0);     // Sp. Case of Medicare Hospital }

End;

