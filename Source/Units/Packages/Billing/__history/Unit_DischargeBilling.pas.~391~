          pf_FinalPayRefund := Query_Process.FieldByName('Deposit').AsFloat;
     End
     Else
     Begin
          with Query_Process do
          Begin
               Close;
               Session := DM_Hospital.DB;
               sql.Clear;
               sql.Add(
                    ' Select Sum(DEPO_DRAmount-DEPO_CRAmount) as Deposit,0 as DollarDeposit From HS_DEPO_Deposit');
               sql.Add(' where DEPO_PatientId=' + IntToStr(pi_PatientId));
               sql.Add(' and DEPO_EmergencyNo=' + #39 + ps_EmergencyNo + #39);
               sql.Add(
                    ' and Depo_AtDisTimeAdj=''N'' and NVL(DEPO_DEPOSITTYPE,''NA'')<>''DIS ADJ DEP REFUND''');
               Open;
          End;

          IF (ps_PatientType <> 'FRG1') or (gs_IsDollarBillForFrgInDischarge = 'N')
               Then
               pf_Deposit := Query_Process.FieldByName('Deposit').AsFloat
          Else
               pf_Deposit := Query_Process.FieldByName('DollarDeposit').AsFloat;

          (* In Case of Medicare Patient Co-Pay Amount *)
          pf_CoPayAmount := 0;
          with Query_Process do
          Begin
               Close;
               Session := DM_Hospital.DB;
               sql.Clear;
               Close;
               sql.Clear;
               sql.Add(' Select Sum(Total) as Total From (');
               sql.Add(
                    ' Select Sum(ReceivedAmount) as Total From CreditPayment where PatientId='
                         + IntToStr(pi_PatientId) + ' and PayType=''CASH'' and EmergencyNo=' +
                         #39 + ps_EmergencyNo + #39);
               sql.Add(' Union');
               sql.Add(
                    ' Select -Sum(ReceivedAmount) as Total From CreditPayment where PatientId='
                         + IntToStr(pi_InpatientId) +
                         ' and PayType=''REFUND'' and EmergencyNo=' + #39 + ps_EmergencyNo +
                         #39);
               sql.Add(' )');
               Open;

               Label_CopayAmtCap.Visible := True;
               Label_CopayAmt.Visible := True;
               Label_CopayAmt.Caption := FormatFloat
                    ('0.00', Query_Process.FieldByName('Total').AsFloat);
               pf_CoPayAmount := Query_Process.FieldByName('Total').AsFloat;
          End;
          (* End of Co-Pay Amount Calculation *)

          with Query_Process do
          Begin
               Close;
               Session := DM_Hospital.DB;
               sql.Clear;
               sql.Add(
                    ' Select Sum(DEPO_DRAmount-DEPO_CRAmount) as Deposit,0 as DollarDeposit From HS_DEPO_Deposit');
               sql.Add(' where DEPO_PatientId=' + IntToStr(pi_PatientId));
               sql.Add(' and DEPO_EmergencyNo=' + #39 + ps_EmergencyNo + #39);
