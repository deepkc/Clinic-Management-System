                    IF (Trim(EditExRate.Text) <> '') and (EditExRate.Text <> '0') Then
                    Begin
                         pf_MedCharge := Query_TempProcess.FieldByName('Total').AsFloat / StrToFloat(EditExRate.Text);
                         Edit_TotMedicineCharge.Text := FormatFloat('#,##0.00', pf_MedCharge);
                         pf_TotalDiscount := pf_TotalDiscount +((Query_TempProcess.FieldByName('Discount').AsFloat) / StrToFloat(EditExRate.Text));
                         lf_TaxMedicine := Query_TempProcess.FieldByName('TaxAmt').AsFloat / StrToFloat(EditExRate.Text);
                    End
                    Else
                    Begin
                         pf_MedCharge := Query_TempProcess.FieldByName('Total').AsFloat;
                         Edit_TotMedicineCharge.Text := FormatFloat('#,##0.00', pf_MedCharge);
                         pf_TotalDiscount := pf_TotalDiscount + Query_TempProcess.FieldByName('Discount').AsFloat;
                         lf_TaxMedicine := Query_TempProcess.FieldByName('TaxAmt').AsFloat;
                    End;
               End;

               { geting total medicine Charge Refund }
               Close;
               sql.Clear;
               sql.Add(' Select Sum(Total) as Total,Sum(Discount) as Discount,Sum(TaxAmt) as TaxAmt From MedicineCharge.db where ReturnStatus=''R''');
               Open;

               IF (ps_PatientType <> 'FRG1') Or (gs_IsDollarBillForFrgInDischarge = 'N') Then
               Begin
                    pf_MedCharge := pf_MedCharge - Query_TempProcess.FieldByName('Total').AsFloat;
                    Edit_TotMedicineCharge.Text := FormatFloat('#,##0.00', pf_MedCharge);
                    pf_TotalDiscount := pf_TotalDiscount - Query_TempProcess.FieldByName('Discount').AsFloat;
                    lf_TaxMedicine := lf_TaxMedicine - Query_TempProcess.FieldByName('TaxAmt').AsFloat;
               End
               Else
               Begin
                    IF (Trim(EditExRate.Text) <> '') and (EditExRate.Text <> '0') Then
                    Begin
                         pf_MedCharge := pf_MedCharge - Query_TempProcess.FieldByName('Total').AsFloat / StrToFloat(EditExRate.Text);
                         Edit_TotMedicineCharge.Text := FormatFloat('#,##0.00', pf_MedCharge);
                         pf_TotalDiscount := pf_TotalDiscount -((Query_TempProcess.FieldByName('Discount').AsFloat) / StrToFloat(EditExRate.Text));
                         lf_TaxMedicine := lf_TaxMedicine -(Query_TempProcess.FieldByName('TaxAmt').AsFloat / StrToFloat(EditExRate.Text));
                    End
                    Else
                    Begin
                         pf_MedCharge := pf_MedCharge - Query_TempProcess.FieldByName('Total').AsFloat;
                         Edit_TotMedicineCharge.Text := FormatFloat('#,##0.00', pf_MedCharge);
                         pf_TotalDiscount := pf_TotalDiscount - Query_TempProcess.FieldByName('Discount').AsFloat;
                         lf_TaxMedicine := lf_TaxMedicine - Query_TempProcess.FieldByName('TaxAmt').AsFloat;
