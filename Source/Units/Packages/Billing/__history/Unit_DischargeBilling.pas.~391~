     li_CrCommunityId := pi_CommunityId;
     li_CrSchemeID := pi_SchemeId;

     if CMBPayType.ItemIndex = 0 then
     INITIAL := 'CS'
     else
     INITIAL := 'CR';

     // CheckServiceBillMaster;

     gi_BillingInvCtrl := 1;

     (* SaveBillMaster(PATIENTID, INPATIENTID, BILLBY, VISITID: Integer;
          GROSSTOTAL, TAXAMT, DISCOUNTTOTAL, NETTOTAL,SERVICECHARGETOTAL,DOLLAREXRATE,
          DOLLARGROSSTOTAL, DOLLARTAXAMT, DOLLARDISCOUNTTOTAL, DOLLARNETTOTAL,DOLLORSERVICECHARGETOTAL : Double;
          INITIAL, BILLDATE, BILLTIME, REFDOCCODE, BILLTYPE, PAYTYPE, RATETYPE, PATIENTTYPE, REMARKS, SEND2WEB, SEND2SMS,
          SEND2EMAIL: String); stdcall; *)

