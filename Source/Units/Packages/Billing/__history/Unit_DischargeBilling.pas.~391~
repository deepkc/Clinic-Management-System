procedure TForm_DischargeBilling.AutoLoadAdditionalDoctorRoundVisit;
Var
  i, j, k, NoOfDays, li_DocSvrId, li_NoOfDocSvr, li_DocId: Integer;
  lf_VatAmt, lf_Discount, lf_ChargeAmt, lf_DisPer, lf_HospitalPart,
    lf_DoctorPart, lf_AdditionalVisitCharge: Double;
  ls_TodaysTime, RoomTypeCode, ls_DisInDepositDate, ls_IsUserDefineRate: String;
  ls_RateType, ls_StartDate, ls_EndDate, ls_DocCode: String;
  //Qry: TOraQuery;
  Qry:TQuery;
Begin
     //Qry := TOraQuery.Create(Nil);
     Qry := TQuery.Create(Nil);
     ChangeToDefaultDate(DEX_AdmnDate, DEX_DisDate);
     NoOfDays := DEX_AdmnDate.VSDateAsDays;
     j := DEX_DisDate.VSDateAsDays;
     ls_TodaysTime := ServerDate.TodaysTime;

     ls_RateType := ps_PatientType;

     IF ps_DisInDeposit = 'Y' Then
          ls_DisInDepositDate := ps_DisInDepositDate
     Else
          ls_DisInDepositDate := ps_DisDate;

     lf_AdditionalVisitCharge := 0;

     With Query_IsAdditionalDoctorAdded do
     Begin
          Close;
          ParamByName('InpatientId').AsInteger := pi_InpatientId;
          ParamByName('StartDate').AsString := ps_AdmnDate;
          Open;
          First;
          while Not eof do
          Begin
               if Trim(Query_IsAdditionalDoctorAdded.FieldByName('EndDate').AsString)= '' then
                    ls_EndDate := ls_DisInDepositDate
               Else
                    ls_EndDate := Query_IsAdditionalDoctorAdded.FieldByName('EndDate').AsString;
               ls_StartDate := Query_IsAdditionalDoctorAdded.FieldByName('StartDate').AsString;
               lf_AdditionalVisitCharge := Query_IsAdditionalDoctorAdded.FieldByName('VisitCharge').AsFloat;
               // ls_DocCode := Query_IsAdditionalDoctorAdded.FieldByName('StartDate').AsString;
               li_DocId := Query_IsAdditionalDoctorAdded.FieldByName('DocId').AsInteger;

               With Qry Do
               Begin
                    Close;
                    DatabaseName := gs_temppath;
                    sql.Clear;
                    sql.Add(' Select * from DailyBed.db where BedDate >=' + #39 +ls_StartDate + #39);
                    sql.Add(' And BedDate<= ' + #39 + ls_EndDate + #39 +' Order by BedDate');
                    Open;
                    First;
                    While Not eof Do
                    Begin
                         if lf_AdditionalVisitCharge = 0 then
                              lf_ChargeAmt := Table_DailyBed.FieldByName('ROUNDVISITCHARGE').AsFloat
                         Else
                              lf_ChargeAmt := lf_AdditionalVisitCharge;

                         lf_HospitalPart := RoundingAfterSecondPlace
                              (lf_ChargeAmt * Table_DailyBed.FieldByName('HOSPARTPERCENT')
                                   .AsFloat / 100);
                         lf_DoctorPart := lf_ChargeAmt - lf_HospitalPart;
                         ls_IsUserDefineRate := 'N';

                         IF ps_PatientType = 'FRG1' Then
                         Begin
                              lf_ChargeAmt := lf_ChargeAmt * 2;
                              lf_HospitalPart := lf_HospitalPart * 2;
                              lf_DoctorPart := lf_DoctorPart * 2;

                              ls_IsUserDefineRate := 'Y';
                         End;

                         IF gs_TaxRule = 'TAD' Then
                              lf_VatAmt := lf_ChargeAmt * gf_TaxPercent / 100
                         Else
                              lf_VatAmt := lf_ChargeAmt * gf_TaxPercent / 100;

                         lf_DisPer := 0;

                         If Table_DailyBed.FieldByName('BedDate')
                              .AsString > ls_DisInDepositDate Then
                         Begin
                              Qry.Free;
                              Exit;
                         End;

                         with Query_Process do
                         Begin
                              Close;
                              Session := DM_Hospital.DB;
                              sql.Clear;
                              sql.Add(' Select DOCTORROUNDVISITID,VisitCharge,ISDAILYCHARGE,ISCHARGESUBDIVIDED,ISEXTRADOCINVOLVED');
                              sql.Add(' From DOCTORROUNDVISIT where InpatientId=' + IntToStr(pi_InpatientId));
                              sql.Add(' and VisitDate=' + #39 + Table_DailyBed.FieldByName('BedDate').AsString + #39);
                              sql.Add(' and ISDAILYCHARGE=''Y'' and ISEXTRADOCINVOLVED=''Y''');
                              Open;

                              { SaveDoctorroundvisit(Isfractionlocked,Isuserdefinerate,Ischargesubdivided,ISDAILYCHARGE,ISEXTRADOCINVOLVED:String;
                                   Visitcharge,Tdsper,Svrchrg,Hospitalpart,Doctorpart,Disper,Vatamt,Noofvisit:Double;
                                   Roomtypeid,Docid,Datapostby,Subdivideby,Patientid,Refdoctorroundvisitid,Inpatientid:Integer;
                                   Dataposttime,Datapostdate,Frctlockdate,Subdividedate,Macid,Paytype,Billdate,Visitdate,Roomtypecode,
                                   Doccode,Ratetype:String); }

                              If FieldByName('DOCTORROUNDVISITID').AsInteger = 0 Then
                              Begin
                                   SaveDoctorroundvisit('N', 'N', 'N', 'Y', 'Y', lf_ChargeAmt,
                                        gf_TDSPercent, 0, lf_HospitalPart, lf_DoctorPart, 0, lf_VatAmt,
                                        1, Table_DailyBed.FieldByName('RoomTypeId').AsInteger,
                                        li_DocId, gi_UserId{gi_AutoDataPostUserID}, 0, pi_PatientId,Table_DailyBed.FieldByName('WardId').AsInteger, 0,
                                        pi_InpatientId, ps_TodaysTime, ps_TodaysDate, '', '', gs_MacID,
                                        '', '', Table_DailyBed.FieldByName('BedDate').AsString,
                                        Table_DailyBed.FieldByName('RoomTypeCode').AsString,
                                        ls_DocCode, ls_RateType);
                              End
                              Else IF (Table_DailyBed.FieldByName('VisitCharge')
                                        .AsFloat <> lf_ChargeAmt) and
                                   (Table_DailyBed.FieldByName('ISDAILYCHARGE').AsString = 'Y') and
                                   (Table_DailyBed.FieldByName('ISCHARGESUBDIVIDED').AsString = 'N')
                                   and (Table_DailyBed.FieldByName('ISEXTRADOCINVOLVED')
                                        .AsString = 'Y') Then
                              Begin
                                   Close;
                                   sql.Clear;
                                   sql.Add(' Update DOCTORROUNDVISIT set VisitCharge=' + FloatToStr(lf_ChargeAmt));
                                   sql.Add(' ,DoctorPart=' + FloatToStr(lf_DoctorPart)+ ' ,HospitalPart=' + FloatToStr(lf_HospitalPart));
                                   sql.Add(' ,VatAmt=' + FloatToStr(lf_VatAmt));
                                   sql.Add(' ,RoomTypeCode=' + #39 + Table_DailyBed.FieldByName('RoomTypeCode').AsString + #39);
                                   sql.Add(' where VisitDate=' + #39 + Table_DailyBed.FieldByName('BedDate').AsString + #39);
                                   sql.Add(' and InpatientId=' + IntToStr(pi_InpatientId));
                                   sql.Add(' and ISDAILYCHARGE=''Y'' and ISCHARGESUBDIVIDED=''N'' and ISEXTRADOCINVOLVED=''Y''');
                                   ExecSQL;
                              End;
                         End;
                         Next;
                    End;
               End;
          End;
     End;
     Qry.Free;
End;

