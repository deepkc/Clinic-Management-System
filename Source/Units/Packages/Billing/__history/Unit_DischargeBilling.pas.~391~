          sql.Add(' From ReturnMaster RM,ReturnDetail RD,ItemsList IL where (RM.ReturnMasterId=RD.ReturnMasterId(+))');
          sql.Add(' and (RD.itemsid=IL.itemsid) and (RM.Credit1=1) and (RM.ST=''N'') and (RM.CustomerID < 99999900)');
          sql.Add(' and NVL(RM.PatientTypeID,0)=0 and RM.CustomerId=' + IntToStr(pi_PatientId));
          sql.Add(' and RM.ReturnDate >=' + #39 + DEX_AdmnDate.Text + #39 + ' and RM.ReturnDate <=' + #39 + DEX_DisDate.Text + #39);
          sql.Add(' and RM.EMERNo='+#39+ps_EmergencyNo+#39);
          sql.Add(' Group by RM.ReturnMasterId,RM.SNO,RD.ItemsId,RM.ReturnDate,RM.RetTime,RD.ExpDate,RD.ControlNo,RM.UserName,IL.ItemsCode,IL.ItemsName');
          sql.Add(' Order By IL.ItemsName');
          Open;
     End;

     Table_MedicineCharge.DatabaseName := gs_temppath;
     Query_GetMedicineCharge.First;
     while not Query_GetMedicineCharge.eof do
     Begin
          With Table_MedicineCharge do
          Begin
               Append;
               FieldByName('SaleMasterId').AsInteger := 0;
               FieldByName('ReturnMasterId').AsInteger := Query_GetMedicineCharge.FieldByName('ReturnMasterId').AsInteger;
               FieldByName('ItemsId').AsInteger := Query_GetMedicineCharge.FieldByName('ItemsId').AsInteger;
               FieldByName('ItemsCode').AsString := Query_GetMedicineCharge.FieldByName('ItemsCode').AsString;
               FieldByName('BillDate').AsString := Query_GetMedicineCharge.FieldByName('ReturnDate').AsString;
               FieldByName('BillTime').AsString := Query_GetMedicineCharge.FieldByName('RetTime').AsString;
               FieldByName('BillNo').AsString := Query_GetMedicineCharge.FieldByName('SNO').AsString;
               FieldByName('UserName').AsString := Query_GetMedicineCharge.FieldByName('UserName').AsString;
               FieldByName('Medicine').AsString := Query_GetMedicineCharge.FieldByName('ItemsName').AsString;
               FieldByName('BatchNo').AsString := Query_GetMedicineCharge.FieldByName('ControlNo').AsString;
               FieldByName('ExpDate').AsString := Query_GetMedicineCharge.FieldByName('ExpDate').AsString;
               FieldByName('Qty').AsFloat := Query_GetMedicineCharge.FieldByName('Qty').AsFloat;
               FieldByName('TaxAmt').AsFloat := 0;
               FieldByName('UnitRate').AsFloat := Query_GetMedicineCharge.FieldByName('UnitRate').AsFloat;
               FieldByName('Total').AsFloat := Query_GetMedicineCharge.FieldByName('Total').AsFloat;
               FieldByName('Discount').AsFloat := Query_GetMedicineCharge.FieldByName('Discount').AsFloat;
               FieldByName('NetTotal').AsFloat := Query_GetMedicineCharge.FieldByName('NetTotal').AsFloat;
               FieldByName('ReturnStatus').AsString := 'R';
               FieldByName('PharmacyCost').AsFloat := Query_GetMedicineCharge.FieldByName('PharmacyCost').AsFloat;
               Post;
          End;
          Query_GetMedicineCharge.Next;
     End;
     Query_DisplayMedicineCharge.DatabaseName := gs_temppath;
     Query_DisplayMedicineCharge.Open;
end;

