     (* SaveBillMaster(PATIENTID, INPATIENTID, BILLBY, REFDOCID, VISITID: Integer;
          GROSSTOTAL, TAXAMT, DISCOUNTTOTAL, NETTOTAL,SERVICECHARGETOTAL,DOLLAREXRATE,
