begin
     With Form_DischargeInDeposit Do
     Begin
          Try
               Form_DischargeInDeposit := TForm_DischargeInDeposit.Create(Application);
               gs_IsDisInDepositStatusRemove := 'N';
               Form_DischargeInDeposit.Edit_InpatientId.Text := IntToStr(Self.pi_InpatientId);
