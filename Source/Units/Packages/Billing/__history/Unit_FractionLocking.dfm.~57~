  object QueryList: TQuery
    SQL.Strings = (
      
        'Select Frde_FractionDetailId FractionDetailId,Frde_PatientId Pat' +
        'ientId,Frde_InpatientId InpatientId, Frde_BillDate BillDate,Frde' +
        '_BillNo BillNo,'
      'Case When Frde_TestNameCode='#39'REG'#39' '
      
        'Then '#39'Opd Regstration'#39'  when Frde_TestNameCode='#39'IPCON'#39' then   '#39'D' +
        'octor Round Charge'#39' '
      
        'Else (Select Tena_TestName From Hs_Tena_Testname where Tena_Test' +
        'NameCode=Fd.Frde_TestNameCode) End TestName,'
      
        '(Select Pama_PatientName From Hs_Pama_PatientMain Where Pama_Pat' +
        'ientID=FD.FRDE_PATIENTID)PatientName,Frde_BillType BillType,'
      
        'Frde_IsFractionLocked IsFractionLocked,((Frde_FractionAmount*Frd' +
        'e_Qty)-(Frde_FractionAmount*Frde_Qty*Frde_DisPer/100)) as DocFrc' +
        'tNet,'
      
        'Frde_DocId DocId,(Select Doct_DocName From Hs_Doct_Doctor Where ' +
        'Doct_DocId=FD.FRDE_DOCID)DocName ,'#39'N'#39' as isRefund'
      'From Hs_Frde_FractionDetail FD'
      
        'WHERE FRDE_TESTNAMECODE not In('#39'REG'#39','#39'IPCON'#39') and Frde_Fractiond' +
        'etailId Not In(Select FRRD_FRACTIONDETAILID From Hs_Frrd_Fractio' +
        'nRefundDetail)'
      'and 1=1'
      'and 1=1'
      'and 1=1'
      'and 1=1'
      'Union'
      
        'Select Frde_FractionDetailId FractionDetailId,Frde_PatientId Pat' +
        'ientId,Frde_InpatientId InpatientId, Frde_BillDate BillDate,Frde' +
        '_BillNo BillNo,'
      'Case When Frde_TestNameCode='#39'REG'#39' '
      
        'Then '#39'Opd Regstration'#39'  when Frde_TestNameCode='#39'IPCON'#39' then   '#39'D' +
        'octor Round Charge'#39' '
      
        'Else (Select Tena_TestName From Hs_Tena_Testname where Tena_Test' +
        'NameCode=Fd.Frde_TestNameCode) End TestName,'
      
        '(Select Pama_PatientName From Hs_Pama_PatientMain Where Pama_Pat' +
        'ientID=FD.FRDE_PATIENTID)PatientName,Frde_BillType BillType,'
      
        'Frde_IsFractionLocked IsFractionLocked,((Frde_FractionAmount*Frd' +
        'e_Qty)-(Frde_FractionAmount*Frde_Qty*Frde_DisPer/100)) as DocFrc' +
        'tNet,'
      
        'Frde_DocId DocId,(Select Doct_DocName From Hs_Doct_Doctor Where ' +
        'Doct_DocId=FD.FRDE_DOCID)DocName,'#39'Y'#39' as ISREFUND'
      'From Hs_Frde_FractionDetail FD'
      
        'WHERE FRDE_TESTNAMECODE not In('#39'REG'#39','#39'IPCON'#39') and Frde_Fractiond' +
        'etailId  In(Select FRRD_FRACTIONDETAILID From Hs_Frrd_FractionRe' +
        'fundDetail)'
      'and 1=1'
      'and 1=1'
      'and 1=1'
      'and 1=1')
    Left = 424
    Top = 280
  end
