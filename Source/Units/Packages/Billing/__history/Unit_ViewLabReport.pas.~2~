end;

procedure TForm_ViewLabReport.CreateTempTable;
begin
     IF TempTable_LabReport.Active Then TempTable_LabReport.Active:=False;
     IF FileExists(gs_TempPath+'\ViewLabReport.db') Then DeleteFile(gs_TempPath+'\ViewLabReport.db');
     With TempTable_LabReport do
     begin
          Close;
          databasename:=gs_TempPath;
          tablename:='ViewLabReport.db';
          tableType:=ttdefault;
          FieldDefs.Clear;
          Fielddefs.add('TestName',ftString,100);
          Fielddefs.add('TestNameCode',ftString,10);
          Fielddefs.add('TestNameID',ftInteger);
          Fielddefs.add('PatientTestID',ftInteger);
          Fielddefs.add('TestDate',ftString,10);
          Fielddefs.add('TestTime',ftString,10);
          Fielddefs.add('BillNo',ftString,20);
          Fielddefs.add('LabNo',ftString,20);
          Fielddefs.add('Finding',ftString,100);
          Fielddefs.add('RefRange',ftString,30);
          Fielddefs.add('Unit',ftString,25);
          createtable;
     End;
end;

procedure TForm_ViewLabReport.FormCreate(Sender: TObject);
begin
     CreateTempTable;
     CreateTableSensitivityResult;
     DEX_From.systemofdate:=gi_datesystem;
     DEX_To.systemofdate:=gi_datesystem;
     DEX_From.text:=TodaysDate;
     DEX_To.text:=TodaysDate;


end;

procedure TForm_ViewLabReport.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
     If Key=vk_Escape Then Close;
     if Key=VK_F5 then BB_RefreshClick(Sender);
     if Key=VK_F1 then CB_BeforeAdmission.Checked:=not(CB_BeforeAdmission.Checked);
     if Key=VK_F2 then Chk_SensitiveResult.Checked:=not(Chk_SensitiveResult.Checked);

end;

