     If Trim(TempTable_LabReport.FieldByName('RefRange').AsString)=''  Then
     Begin
          DBGrid1.Canvas.Font.Color:=clBlue;
          DBGrid1.Columns[2].Font.Style:=[fsBold];
          DBGrid1.Columns[3].Font.Style:=[fsBold];
          DBGrid1.DefaultDrawDataCell(rect,Column.Field,State);
     End;
end;

procedure TForm_ViewLabReport.DBGrid1CellClick(Column: TColumn);
begin
     If IsSensitive(TempTable_LabReport.FieldByName('TestNameId').AsInteger)=True Then
     Begin
          Chk_SensitiveResult.Visible:=True;
          Table_SensitivityResult.Close;
          Table_SensitivityResult.EmptyTable;
          Table_SensitivityResult.Exclusive:=True;
          Table_SensitivityResult.Open;
          with Query_Process do
          Begin
               close;
               sql.clear;
               sql.add(' Select SMT.SensitiveMedicineID,SM.MEDICINE,SMT.TESTNAMEID,SR.RESULT');
               sql.add(' From SensitivityResult SR,SENSITIVEMEDICINETESTWISE SMT,SensitiveMedicine SM where');
               sql.add(' SR.SMTWID=SMT.SMTWID And SMT.SENSITIVEMEDICINEID=SM.SENSITIVEMEDICINEID and');
               sql.add(' SR.PatientID='+IntToStr(pi_PatientID));
               sql.add(' and SR.PatientTestId='+TempTable_LabReport.FieldByName('PatientTestId').AsString);
               sql.add(' and SMT.TestNameId='+TempTable_LabReport.FieldByName('TestNameId').AsString);
               sql.add(' Order by SM.MEDICINE');
               Open;

               First;
               while not eof do
               Begin
                    Table_SensitivityResult.Append;
                    Table_SensitivityResult.FieldByName('MedicineId').AsInteger:=FieldByName('SensitiveMedicineId').AsInteger;
                    Table_SensitivityResult.FieldByName('Medicine').AsString:=FieldByName('Medicine').AsString;
                    {Table_SensitivityResult.FieldByName('Sensitive').AsString:='';
                    Table_SensitivityResult.FieldByName('Intermediate').AsString:='';
                    Table_SensitivityResult.FieldByName('Resistant').AsString:='';
                    Table_SensitivityResult.Post;}
                    IF Query_Process.FieldByName('Result').AsString='S' Then
                    Table_SensitivityResult.FieldByName('Sensitive').AsString:='Y'
                    Else IF Query_Process.FieldByName('Result').AsString='I' Then
                    Table_SensitivityResult.FieldByName('Intermediate').AsString:='Y'
                    Else IF Query_Process.FieldByName('Result').AsString='R' Then
                    Table_SensitivityResult.FieldByName('Resistant').AsString:='Y';
                    Next;
               End;
          End;
     End
     Else
     Begin
          Table_SensitivityResult.Close;
          Chk_SensitiveResult.Checked:=False;
          Chk_SensitiveResult.Visible:=False;
          DBGrid_SensitivityResult.Visible:=False;
     End;
end;

function TForm_ViewLabReport.IsSensitive(TestNameId: Integer): Boolean;
begin
     Result:=False;
     With Query_Process Do
     Begin
          Close;
          DatabaseName:=gs_DatabaseName;
          sql.Clear;
          sql.Add('Select * From SENSITIVEMEDICINETESTWISE where TestNameId='+IntToStr(TestNameId));
          Open;
          If Query_Process.FieldByName('TestNameId').AsInteger > 0 Then
          Result:=True
          Else
          Result:=False;
     End;
end;

procedure TForm_ViewLabReport.Chk_SensitiveResultClick(Sender: TObject);
begin
     IF Chk_SensitiveResult.Checked=True then
     Begin
          DBGrid_SensitivityResult.Visible:=True;
          ActiveControl:=DBGrid_SensitivityResult;
          Table_SensitivityResult.Edit;
          Table_SensitivityResult.First;
          DBGrid_SensitivityResult.SelectedIndex:=1;
     End
     Else
     DBGrid_SensitivityResult.Visible:=False;
end;

procedure TForm_ViewLabReport.CreateTableSensitivityResult;
begin
     IF Table_SensitivityResult.Active Then Table_SensitivityResult.Active:=False;
   IF FileExists(gs_TempPath+'\ViewSensitivityResult.db') Then DeleteFile(gs_TempPath+'\ViewSensitivityResult.db');
   with Table_SensitivityResult do
   Begin
      DatabaseName:=gs_TempPath;
      TableName:='ViewSensitivityResult.db';
      TableType:=ttDefault;
      FieldDefs.Clear;
      FieldDefs.Add('MedicineId',ftInteger);
      FieldDefs.Add('Medicine',ftString,50);
      FieldDefs.Add('Sensitive',ftString,2);
      FieldDefs.Add('Intermediate',ftString,2);
      FieldDefs.Add('Resistant',ftString,2);
      IndexDefs.Clear;
      CreateTable;
   End;
   Table_SensitivityResult.DatabaseName:=gs_TempPath;
   Table_SensitivityResult.Close;
   Table_SensitivityResult.EmptyTable;
   Table_SensitivityResult.Exclusive:=True;
   Table_SensitivityResult.open;
end;

