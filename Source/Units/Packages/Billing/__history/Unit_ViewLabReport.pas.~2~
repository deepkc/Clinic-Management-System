procedure TForm_ViewLabReport.BB_RefreshClick(Sender: TObject);
var
     ls_OldTestDate,ls_OldBillNo,ls_OldTestCode:String;
begin
     If CB_SearchByDate.Checked then
     Begin
          With Query_GetPatientTest do
          begin
               Close;
               DatabaseName:=gs_DatabaseName;
               //if CB_BeforeAdmission.checked=true then
               sql[7]:='PT.PatientID='+inttostr(Self.pi_PatientID)+' And';
               //else
               //sql[7]:='PT.InPatientID='+inttostr(Self.pi_InPatientId)+' And';
               sql[8]:='(PT.TestDate >='+Quotedstr(DEX_From.Text)+' and PT.TestDate <='+Quotedstr(DEX_To.text)+')';
               //sql.savetofile('C:\WardLabViewReport.txt');
               Open;
          end;
     End
     Else
     Begin
          DEX_From.VSDateAsDays:=(DEX_From.VSDateAsDays)-StrToInt(SPE_NoofDays.Text);
          With Query_GetPatientTest Do
          Begin
               Close;
               DatabaseName:=gs_DatabaseName;
               //if CB_BeforeAdmission.checked=true then
               sql[7]:='PT.PatientID='+inttostr(Self.pi_PatientID)+' And';
               //else
               //sql[7]:='PT.InPatientID='+inttostr(Self.pi_InPatientId)+' And';
               sql[8]:='(PT.TestDate >='+Quotedstr(DEX_From.Text)+' and PT.TestDate <='+Quotedstr(DEX_To.text)+')';
               //sql.savetofile('C:\WardLabViewReport.txt');
               Open;
          End;
          DEX_From.Text:=TodaysDate;
     End;
     TempTable_LabReport.Close;
     TempTable_LabReport.EmptyTable;
     TempTable_LabReport.Open;
     With Query_GetPatientTest Do
     Begin
          While Not Eof Do
          Begin
               TempTable_LabReport.Append;
               TempTable_LabReport.FieldByName('TestNameCode').AsString:=FieldByName('TestNameCode').AsString;
               If FieldByName('Test').AsString='' Then
               TempTable_LabReport.FieldByName('TestName').AsString:=FieldByName('TestName').AsString
               Else
               TempTable_LabReport.FieldByName('TestName').AsString:=FieldByName('Test').AsString;
               //TempTable_LabReport.FieldByName('TestDate').AsString:=FieldByName('TestDate').AsString;
               If ls_OldTestCode<>FieldByName('TestNameCode').AsString Then
               Begin
                    TempTable_LabReport.FieldByName('BillNo').AsString:=FieldByName('BillNo').AsString;
                    TempTable_LabReport.FieldByName('TestDate').AsString:=FieldByName('TestDate').AsString;
                    TempTable_LabReport.FieldByName('TestTime').AsString:=FieldByName('TestTime').AsString;
               End
               Else
               Begin
                    TempTable_LabReport.FieldByName('BillNo').AsString:='';
                    TempTable_LabReport.FieldByName('TestDate').AsString:='';
                    TempTable_LabReport.FieldByName('TestTime').AsString:='';
               End;
               TempTable_LabReport.FieldByName('TestNameID').AsInteger:=FieldByName('TestNameID').AsInteger;
               TempTable_LabReport.FieldByName('PatientTestID').AsInteger:=FieldByName('PatientTestID').AsInteger;
               TempTable_LabReport.FieldByName('Finding').AsString:=FieldByName('Finding').AsString;
               TempTable_LabReport.FieldByName('RefRange').AsString:=FieldByName('RefRange').AsString;
               TempTable_LabReport.FieldByName('Unit').AsString:=FieldByName('Unit').AsString;
               TempTable_LabReport.Post;
               ls_OldTestCode:=FieldByName('TestNameCode').AsString;
               Next;
          End;
          TempTable_LabReport.First;
     End;
end;

