{$R *.DFM}

procedure TForm_DischargeInDeposit.BtnCancelClick(Sender: TObject);
begin
     Close;
end;

procedure TForm_DischargeInDeposit.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
     IF key=27 Then Close;
     IF (key=13) and (ActiveControl=DateEditXDisDate) Then
     Edit_InpatientId.SetFocus;

     IF (key=VK_F12) and (BtnSave.Enabled=True) Then
     BtnSaveClick(Sender);

     IF (key=VK_F1) and (CB_DisInDeposit.Enabled=True) Then
     CB_DisInDeposit.Checked:=Not(CB_DisInDeposit.Checked);

end;

procedure TForm_DischargeInDeposit.BtnSaveClick(Sender: TObject);
Var li_DRIncomeCorrectionLogId,li_PatientId,Li_RoomTypeId,Li_WardId:Integer;
    ls_ServiceType,ls_BedNo,ls_RoomTypeCode,ls_WardCode,ls_LogRemarks,ls_TodaysDate,ls_TodaysTime:String;
    DrAmount,CrAmount: Double;
begin
     if (Query_InpatientInfo.FieldByName('INRE_IsTransLocked').AsString='Y') Then
     Begin
          MessageDlg(' Sorry ! Transaction Is Already Locked.', mtWarning, [mbok], 0);
          Exit;
     End;

     if ps_DepositStatus='DEPOSIT' then
     Begin
          if pf_SpecialDeposit>0 then
               DrAmount:=strtofloat(Label_Amount.Caption)-pf_SpecialDeposit
          Else
               DrAmount:=strtofloat(Label_Amount.Caption);
          CrAmount:=0;
          ps_DepositType:='DEPOSIT';
     End
     Else
     Begin
          DrAmount:=0;
          CrAmount:=strtofloat(Label_Amount.Caption);
          ps_DepositType:='DEPOSIT REFUND';
     End;

     ls_LogRemarks:='Remove Discharge in Deposit for InpatientNo->'+Query_InpatientInfo.FieldByName('InpatientId').AsString;

     IF Trim(Edit_InpatientId.Text)='' Then
     Begin
          MessageDlg(' You Must Have To Put Inpatient No.',mtWarning,[mbok],0);
          Edit_InpatientId.SetFocus;
          Exit;
     End;

     IF (Trim(Edit_CareOf.Text)='') and (CB_DisInDeposit.Checked=False) Then
     Begin
          MessageDlg('You Must Have to Mention "In Care of" for Discharge In Deposit.',mtWarning,[mbok],0);
          Edit_CareOf.SetFocus;
          Exit;
     End;

     With Query_InpatientInfo do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select Inre_InpatientId Inpatientid,Inre_PatientId PatientId,Inre_AdmnDate AdmnDate,Inre_DisDate DisDate,Inre_IsDischarged IsDischarged,Inre_IsDisInDeposit DisInDeposit,');
          SQL.Add(' INRE_DISINDEPOSITESCHEME DISINDEPOSITESCHEME,INRE_DISINDEPOSITDATE DISINDEPOSITDATE,NVl(INRE_DISINDEPOSITESCHEME,0) disindepositscheme,');
          sql.add(' INRE_SPLDISINDEPOCASHDATE,(Select PAMA_PatientName From HS_PAMA_PatientMain where PAMA_PatientId=Hs_Inre_InpatientReg.Inre_InpatientId) as PtName, ');
          sql.add(' Inre_DisInCareOf DisInCareOf,Inre_DISINDEPOSITTRANSID DISINDEPOSITTRANSID,INRE_IsTransLocked From Hs_Inre_InpatientReg where Inre_InpatientId='+Edit_InpatientId.Text);
          //sql.savetofile('D:\abc.txt');
          Open;
     End;

     pi_DisInDepositTransId:=Query_InpatientInfo.FieldByName('DISINDEPOSITTRANSID').AsInteger;
     pi_disindepositscheme:=Query_InpatientInfo.FieldByName('disindepositscheme').AsInteger;

     IF Query_InpatientInfo.FieldByName('ISDischarged').AsString='C' Then
     Begin
          MessageDlg(' Admission Cancel Patient So You Cannot Do Deposit Discharge',mtWarning,[mbok],0);
          DateEditXDisDate.SetFocus;
          Exit;
     End;


     IF Query_InpatientInfo.FieldByName('ISDischarged').AsString='Y' Then
     Begin
          MessageDlg(' Patient Is Already Discharged.',mtWarning,[mbok],0);
          DateEditXDisDate.SetFocus;
          Exit;
     End;

     IF (Query_InpatientInfo.FieldByName('DisInDeposit').AsString='Y') and (CB_DisInDeposit.Checked=False) Then
     Begin
          MessageDlg(' Already Set Discharged In Deposit .',mtWarning,[mbok],0);
          //CB_DisInDeposit.SetFocus;
          Exit;
     End;

     DateEditXDisDate.SystemOfDate:=gi_DateSystem;
     IF DateEditXDisDate.Text < Query_InpatientInfo.FieldByName('AdmnDate').AsString Then
     Begin
          MessageDlg('Discharge In Deposit Date (  '+DateEditXDisDate.Text+'  ) Should Not Be Less Than Inpatient Date (  '+
          Query_InpatientInfo.FieldByName('AdmnDate').AsString+' ).',mtWarning,[mbok],0);
          DateEditXDisDate.SetFocus;
          Exit;
     End;

     DEX_Today.SystemOfDate:=gi_DateSystem;
     DEX_Today.text:=TodaysDate;

     IF DateEditXDisDate.Text > DEX_Today.text Then
     Begin
          MessageDlg('Discharge In Deposit Date (  '+DateEditXDisDate.Text+'  ) Should Not be Greater Than Current Date (  '+
          DEX_Today.text+' ).',mtWarning,[mbok],0);
          DateEditXDisDate.SetFocus;
          Exit;
     End;


     DateEditXDisDate.SystemOfDate:=gi_DateSystem;
     IF (DateEditXDisDate.Text > Query_InpatientInfo.FieldByName('INRE_SPLDISINDEPOCASHDATE').AsString)
     and (Trim(Query_InpatientInfo.FieldByName('INRE_SPLDISINDEPOCASHDATE').AsString)<>'') Then
     Begin
          MessageDlg('Discharge In Deposit Date (  '+DateEditXDisDate.Text+'  ) Should Not Be Greater Than Cash Received Date (  '+
          Query_InpatientInfo.FieldByName('INRE_SPLDISINDEPOCASHDATE').AsString+' ).',mtWarning,[mbok],0);
          DateEditXDisDate.SetFocus;
          Exit;
     End;

     with Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select Inre_InpatientId InpatientId,Inre_AdmnDate Admndate From Hs_Inre_InpatientReg where Inre_InpatientId > '+Edit_InpatientId.Text+' and Inre_PatientId='+LabelPtNo.Caption);
          Open;
     End;

     IF (Query_Process.FieldByName('InpatientId').AsInteger > 0 ) and (CB_DisInDeposit.Checked=True) Then
     Begin
          Query_Process.Last;
          MessageDlg('Sorry ! You Cannot Change The Deposit Discharge Status.'+Char(10)+Char(10)+
                    '    Reason : This Patient Again Admitted with IP No.  " '+Query_Process.FieldByName('InpatientId').AsString+'  "  on Date  "  '+
                    Query_Process.FieldByName('AdmnDate').AsString,mtWarning,[mbok],0);
          Exit;
     End;

     (*if (CB_DisInDeposit.Checked=True) and (serverdate.TodaysDate<>Query_InpatientInfo.fieldbyname('DISINDEPOSITDATE').AsString)
          and (pi_disindepositscheme=22) then
     Begin
          MessageDlg('Sorry ! You Can Remove Discharge In Deposit on The Same Date Only !',mtWarning,[mbok],0);
          Exit;
     End;*)



     (*IF CB_DisInDeposit.Checked=True Then // Remove Discharge In Deposit.
     Begin
          ls_LogRemarks:='Remove Dis. In Deposit of IP NO : '+IntToStr(pi_InpatientId)+', DisInDepNo : '+IntToStr(pi_DisInDepositTransId)
          +' , Prev. In Care of : '+Query_InpatientInfo.FieldByName('DisInCareOf').AsString;
          With Query_Void do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select * From Bed where BedNo In (Select BedNo From InpatientDetail where InpatientDID In ( ');
               sql.add(' Select Max(InpatientDID) From InpatientDetail where InpatientId='+IntToStr(Query_InpatientInfo.FieldByName('InpatientId').AsInteger)+'))');
               Open;
          End;

          IF Query_Void.FieldByName('Vacant').AsString='F' Then
          Begin
               MessageDlg('Sorry ! Previously Bed No " '+Query_Void.FieldByName('BedNo').AsString+' " Occupied by " '+LabelPtName.Caption+' ".'+
               Char(10)+' But Currently it is occupied by some other person. '+Char(10)+' So you cannot remove discharge in deposit status without '+
               'Bed No " '+Query_Void.FieldByName('BedNo').AsString+' is vaccant.',mtWarning,[mbok],0);
               Exit;
          End;
     End;*)

     IF CB_DisInDeposit.Checked=False Then
     begin
          if (gs_ISINTEGRATEDPHARMACY = 'Y') Or (gs_IsPHClearanceB4DisBill = 'Y') then
          begin
               IF (pb_ISPHARAPPROVALGRANTED=False) and (IsCreditAmountExistInPharmacy(pi_PatientId,pi_InpatientId)=True) Then
               Begin
                    MessageDlg('Pharmacy Clearance Yet Not Done. Please Contact at Pharmacy.' , mtWarning, [mbOK], 0);
                    Edit_InpatientId.SetFocus;
                    Exit;
               End;
          end;
     end;


     if (DBLC_AddScheme.KeyValue=22) and (CB_DisInDeposit.Checked=False) then //Specail Case
     Begin

     End;

     Edit_CareOf.Text:=StringReplace(Edit_CareOf.Text,'''','''''',[rfReplaceAll]);
     Try
          DM_Hospital.DB.StartTransaction;
          With Query_Void do
          Begin
               IF CB_DisInDeposit.Checked=False Then
               Begin
                    pi_DisInDepositTransId:=GetMaxId('Hs_InRe_InpatientReg','Inre_DISINDEPOSITTRANSID');
                    Close;
                    sql.Clear;
                    sql.add(' Update Hs_InRe_InpatientReg Set InRe_IsDisInDeposit=''Y'',InRe_DisInDepositDate='+#39+DateEditXDisDate.Text+#39);
                    sql.add(',InRe_DisInCareOf='+#39+Edit_CareOf.Text+#39);
                    if DBLC_AddScheme.KeyValue<>null then
                         sql.add(',INRE_DISINDEPOSITESCHEME='+inttostr(DBLC_AddScheme.KeyValue))
                    else
                         sql.add(',INRE_DISINDEPOSITESCHEME=0');
                    sql.add(' ,InRe_DisInDepositBy='+IntToStr(gi_UserId)+',InRe_DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    sql.add(' where InRe_InpatientId='+Query_InpatientInfo.FieldByName('InpatientId').AsString);
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Select Inde_RoomTypeId RoomTypeId,Inde_BedNo BedNo,Inde_WardId WardId From Hs_Inde_InpatientDetail where Inde_InpatientDID In (');
                    sql.add(' Select Max(Inde_InpatientDID) From Hs_Inde_InpatientDetail Where Inde_InpatientId='+Query_InpatientInfo.FieldByName('InpatientId').AsString);
                    sql.add(' )');
                    Open;

                    ls_BedNo:=FieldByName('BedNo').AsString;
                    li_RoomTypeId:=FieldByName('RoomTypeId').AsInteger;
                    li_WardID:=FieldByName('WardId').AsInteger;

                    Close;
                    sql.Clear;
                    sql.add(' Update Bed Set Vacant=''T'' where BedNo='+#39+ls_BedNo+#39);
                    //sql.add(' and RoomTypeCode='+#39+ls_RoomTypeCode+#39);// and WardCode='+#39+ls_WardCode+#39);
                    ExecSQL;


                    Close;
                    sql.Clear;
                    sql.add(' Update Hs_Inde_InpatientDetail Set Inde_DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    sql.add(' where Inde_InpatientId='+IntToStr(Query_InpatientInfo.FieldByName('InpatientId').AsInteger));
                    ExecSQL;


                    Close;
                    sql.Clear;
                    sql.add(' Update HS_DEPO_Deposit Set DEPO_DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                     if DBLC_AddScheme.KeyValue<>null then
                         sql.Add(',DEPO_DISINDEPOSITESCHEME=' + QuotedStr(DBLC_AddScheme.KeyValue))
                    else
                         sql.add(',depo_DISINDEPOSITESCHEME=''0''');
                    sql.add(' where DEPO_PatientId='+IntToStr(pi_PatientId));
                    sql.add(' and DEPO_InPatientId='+IntToStr(pi_InPatientId));
                    sql.Add(' and NVL(DEPO_DISINDEPOSITTRANSID,0)=0');
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Update HS_SEBD_ServiceBillDetail Set SEBD_DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    sql.add(' where SEBD_PatientId='+IntToStr(pi_PatientId));
                    sql.add(' and SEBD_InPatientId='+IntToStr(pi_InPatientId));
                    sql.Add(' and SEBD_BillDetailId=0 and NVL(SEBD_DISINDEPOSITTRANSID,0)=0');
                    ExecSQL;

                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update DoctorRoundVisit Set DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    SQL.Add(' where InpatientId='+IntToStr(pi_InpatientId));
                    SQL.Add(' and patientId='+IntToStr(pi_PatientId));
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Update SaleMaster Set DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    sql.add(' where CustomerId='+IntToStr(pi_PatientId));
                    sql.add(' and InPatientId='+IntToStr(pi_InPatientId));
                    sql.Add(' and Cashed=''N'' and NVL(DISINDEPOSITTRANSID,0)=0');
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Update ReturnMaster Set DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    sql.add(' where CustomerId='+IntToStr(pi_PatientId));
                    sql.add(' and InPatientId='+IntToStr(pi_InPatientId));
                    sql.Add(' and Cashed=''N'' and NVL(DISINDEPOSITTRANSID,0)=0');
                    ExecSQL;

                    if gs_HospitalNameForCode='BNB' then
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Update BNB_OT.SaleMaster Set DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                         sql.add(' where CustomerId='+IntToStr(pi_PatientId));
                         sql.add(' and InPatientId='+IntToStr(pi_InPatientId));
                         sql.Add(' and Cashed=''N'' and NVL(DISINDEPOSITTRANSID,0)=0');
                         ExecSQL;

                         Close;
                         sql.Clear;
                         sql.add(' Update BNB_OT.ReturnMaster Set DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                         sql.add(' where CustomerId='+IntToStr(pi_PatientId));
                         sql.add(' and InPatientId='+IntToStr(pi_InPatientId));
                         sql.Add(' and Cashed=''N'' and NVL(DISINDEPOSITTRANSID,0)=0');
                         ExecSQL;


                         if DBLC_AddScheme.KeyValue=22 then //Specail Case
                         Begin
                             ls_TodaysDate:=DateEditXDisDate.Text;
                             ls_TodaysTime:=TodaysTime;

                             Try
                                   SaveSpecialDeposit(0, pi_InPatientID, pi_PatientId, 0, gi_UserID,0, DrAmount,CrAmount,
                                        ps_DepositType , 'FINAL DISCHARGE COLN', '', '', '', ls_TodaysDate, ls_TodaysTime,ls_TodaysDate, ls_TodaysTime,'N',GetPatientCagetory(Pi_PatientId),'N');
                             except
                                   SaveSpecialDeposit(0, pi_InPatientID, pi_PatientId, 0, gi_UserID,0, DrAmount,CrAmount,
                                        ps_DepositType , 'FINAL DISCHARGE COLN', '', '', '', ls_TodaysDate, ls_TodaysTime,ls_TodaysDate, ls_TodaysTime,'N',GetPatientCagetory(Pi_PatientId),'N');
                             End;

                             if ps_DepositStatus='DEPOSIT' then
                             Begin
                                   DrAmount := 0;
                                   CrAmount := strtofloat(Label_Amount.Caption);
                                   SaveSpecialDeposit(0, pi_InpatientId, pi_PatientId, 0, gi_UserId, 0,DrAmount, CrAmount, 'DIS ADJ DEP REFUND',
                                                  'DISCHARGE ADJUSTED DEPOSIT', '', '', '', ls_TodaysDate,ls_TodaysTime,ls_TodaysDate, ls_TodaysTime,'N',GetPatientCagetory(pi_PatientId),'N');
                             End;

                             Close;
                             sql.Clear;
                             sql.add(' Delete From HS_DEPO_Deposit where DEPO_InpatientId='+IntToStr(pi_InpatientId));
                             sql.add(' and DEPO_DepositType=''FINALDISADJ'' and DEPO_REFERENCETYPE=''ADJ. IN DISCHARGE''');
                             sql.add(' and SPDE_PatientId='+IntToStr(pi_PatientId));
                             ExecSQL;

                             PostRoundVisitSharingSpecailCase;
                         End;
                    End;
               End
               Else
               begin
                    Close;
                    sql.Clear;
                    sql.add(' Update Hs_Inre_InpatientReg Set Inre_IsDisInDeposit=''N'',Inre_DisInDepositDate='''', Inre_DisInCareOf='''',Inre_DisInDepositBy=NULL');
                    sql.Add(' ,Inre_DISINDEPOSITTRANSID=0,INRE_DISINDEPOSITESCHEME=0');
                    sql.add(' where Inre_InpatientId='+Query_InpatientInfo.FieldByName('InpatientId').AsString);
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Update Bed Set Vacant=''F'' where BedNo='+#39+ls_BedNo+#39);
                    sql.add(' and RoomTypeCode='+#39+ls_RoomTypeCode+#39);// and WardCode='+#39+ls_WardCode+#39);
                    ExecSQL;


                    Close;
                    sql.Clear;
                    sql.add(' Update Hs_Inde_InpatientDetail Set Inde_DISINDEPOSITTRANSID=0');
                    sql.add(' where Inde_DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    sql.add(' and Inde_InpatientId='+IntToStr(pi_InpatientId));
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Update HS_DEPO_Deposit Set DEPO_DISINDEPOSITTRANSID=0');
                    sql.add(' where DEPO_PatientId='+IntToStr(pi_PatientId));
                    sql.add(' and DEPO_InPatientId='+IntToStr(pi_InPatientId));
                    sql.Add(' and DEPO_DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Update HS_SEBD_ServiceBillDetail Set SEBD_DISINDEPOSITTRANSID=0');
                    sql.add(' where SEBD_DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    sql.Add(' and SEBD_BillDetailId=0');
                    sql.add(' and SEBD_InPatientId='+IntToStr(pi_InPatientId));
                    sql.add(' and SEBD_PatientId='+IntToStr(pi_PatientId));
                    ExecSQL;

                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update DoctorRoundVisit Set DISINDEPOSITTRANSID=0');
                    SQL.Add(' where InpatientId='+IntToStr(pi_InpatientId));
                    SQL.Add(' and patientId='+IntToStr(pi_PatientId));
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Delete From HS_FRDE_FractionDetail');
                    sql.add(' where FRDE_PatientId='+IntToStr(pi_PatientId));
                    sql.add(' and FRDE_InPatientId='+IntToStr(pi_InPatientId));
                    sql.Add(' and FRDE_TESTNAMECODE=''IPCON'' and FRDE_BILLNO=''Dis.In Depo.''');
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Update SaleMaster Set DISINDEPOSITTRANSID=0');
                    sql.add(' where Cashed=''N'' and DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    sql.add(' and CustomerId='+IntToStr(pi_PatientId));
                    sql.add(' and InPatientId='+IntToStr(pi_InPatientId));
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Update ReturnMaster Set DISINDEPOSITTRANSID=0');
                    sql.add(' where Cashed=''N'' and DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    sql.add(' and CustomerId='+IntToStr(pi_PatientId));
                    sql.add(' and InPatientId='+IntToStr(pi_InPatientId));
                    ExecSQL;

                    if gs_HospitalNameForCode='BNB' then
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Update BNB_OT.SaleMaster Set DISINDEPOSITTRANSID=0');
                         sql.add(' where Cashed=''N'' and DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                         sql.add(' and CustomerId='+IntToStr(pi_PatientId));
                         sql.add(' and InPatientId='+IntToStr(pi_InPatientId));
                         ExecSQL;

                         Close;
                         sql.Clear;
                         sql.add(' Update BNB_OT.ReturnMaster Set DISINDEPOSITTRANSID=0');
                         sql.add(' where Cashed=''N'' and DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                         sql.add(' and CustomerId='+IntToStr(pi_PatientId));
                         sql.add(' and InPatientId='+IntToStr(pi_InPatientId));
                         ExecSQL;
                    End;

                    Close;
                    sql.Clear;
                    sql.add(' Delete From HS_SPDE_SPECIALDEPOSIT where SPDE_InpatientId='+IntToStr(pi_InpatientId));
                    sql.add(' and SPDE_REFERENCETYPE In (''FINAL DISCHARGE COLN'',''DISCHARGE ADJUSTED DEPOSIT'')');
                    sql.add(' and SPDE_PatientId='+IntToStr(pi_PatientId));
                    ExecSQL;

                    SaveLogGlobal(gi_UserId,'INDOOR',ls_LogRemarks);
               End;
          End;

          DM_Hospital.DB.Commit;
     Except
          DM_Hospital.DB.RollBack;
          MessageDlg('Failure To Save To Data.',mtWarning,[mbok],0);
          Exit;
     End;
     ShowDoneMessage;
End;


procedure TForm_DischargeInDeposit.PostDepositAdjustmentIFNotExist;
Var ls_TodaysDate,ls_TodaysTime : string;
    DrAmount,CrAmount : Double;
begin
     if DBLC_AddScheme.KeyValue=22 then //Specail Case
     Begin
          ls_TodaysDate:=TodaysDate;
          ls_TodaysTime:=TodaysTime;

          DrAmount := strtofloat(Label_Amount.Caption);
          CrAmount :=0;

          Try
               SaveSpecialDeposit(0, pi_InPatientID, pi_PatientId, 0, gi_UserID,0, DrAmount,CrAmount,
