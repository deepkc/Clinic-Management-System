procedure TForm_DischargeInDeposit.SPB_MakeUptodateClick(Sender: TObject);
Var ls_DisInDepositDate : string;
    li_DISINDEPOSITTRANSID,li_SchemeId  : Integer;
    lb_IsFinalDisColnExist : Boolean;
begin
     if (Query_InpatientInfo.FieldByName('INRE_IsTransLocked').AsString='Y') Then
     Begin
          MessageDlg(' Sorry ! Transaction Is Already Locked.', mtWarning, [mbok], 0);
          Exit;
     End;

     IF ISDischargedPatient(pi_InpatientId) = True Then
     Begin
          MessageDlg('Sorry ! Patient is already discharged.', mtWarning, [mbOK], 0);
          Exit;
     End;

     With Query_Process do
     begin
          Close;
          DatabaseName:=gs_DatabaseName;
          SQL.Clear;
          SQL.Add(' Select INRE_DisInDepositDate,INRE_DISINDEPOSITESCHEME,INRE_DISINDEPOSITTRANSID ');
          SQL.Add(' From HS_INRE_InpatientReg where INRE_InpatientId='+IntToStr(pi_InpatientId));
          Open;
     end;

     (*if Query_Process.FieldByName('INRE_DISINDEPOSITESCHEME').AsInteger<>22 then
     begin
          MessageDlg('Sorry ! This Indoor Patient Is Not Related With Special Deposit Case.',mtWarning,[mbOK],0);
          Exit;
     end;*)
     li_SchemeId:=Query_Process.FieldByName('INRE_DISINDEPOSITESCHEME').AsInteger;
     ls_DisInDepositDate:=Query_Process.FieldByName('INRE_DisInDepositDate').AsString;
     li_DISINDEPOSITTRANSID:=Query_Process.FieldByName('INRE_DISINDEPOSITTRANSID').AsInteger;

     With Query_Process do
     begin
          Close;
          SQL.Clear;
          SQL.Add(' Select SPDE_DRAMOUNT From HS_SPDE_SpecialDeposit where SPDE_REFERENCETYPE=''FINAL DISCHARGE COLN''');
          SQL.Add(' and SPDE_DEPOSITTYPE=''DEPOSIT'' and SPDE_InpatientId='+IntToStr(pi_InpatientId));
          Open;
     end;

     if Query_Process.FieldByName('SPDE_DRAMOUNT').AsFloat=0 then
     lb_IsFinalDisColnExist:=False
     else
     lb_IsFinalDisColnExist:=True;

     Try
          DM_Hospital.DB.StartTransaction;
          With Query_Process do
          begin
               Close;
               DatabaseName:=gs_DatabaseName;
               SQL.Clear;
               SQL.Add(' Update HS_SEBD_ServiceBillDetail Set SEBD_BillDate='+#39+ls_DisInDepositDate+#39);
               SQL.Add(' ,SEBD_DISINDEPOSITTRANSID='+IntToStr(li_DISINDEPOSITTRANSID));
               SQL.Add(' where SEBD_BillDetailId=0 and SEBD_InpatientId='+IntToStr(pi_InpatientId));
               SQL.Add(' and SEBD_BillDate >='+#39+ls_DisInDepositDate+#39+' and SEBD_patientId='+IntToStr(pi_PatientId));
               ExecSQL;


               Close;
               DatabaseName:=gs_DatabaseName;
               SQL.Clear;
               SQL.Add(' Update DoctorRoundVisit Set DISINDEPOSITTRANSID='+IntToStr(li_DISINDEPOSITTRANSID));
               SQL.Add(' where InpatientId='+IntToStr(pi_InpatientId));
               SQL.Add(' and patientId='+IntToStr(pi_PatientId));
               ExecSQL;

               if (li_SchemeId=22) then
               Begin
                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_SPDE_SpecialDeposit Set SPDE_DepositDate='+#39+ls_DisInDepositDate+#39+' where SPDE_InpatientId='+IntToStr(pi_InpatientId));
                    SQL.Add(' and SPDE_patientId='+IntToStr(pi_PatientId));
                    SQL.Add(' and SPDE_DepositDate > '+#39+ls_DisInDepositDate+#39);
                    ExecSQL;
               End;
          end;

          ps_DepositType:='DEPOSIT';
          IF lb_IsFinalDisColnExist=False Then
          PostDepositAdjustmentIFNotExist;

          DM_Hospital.DB.Commit;
     Except
          DM_Hospital.DB.Rollback;
          MessageDlg('Failure To Database.',mtWarning,[mbOK],0);
          Exit;
     End;
     ShowDoneMessage;
end;

procedure TForm_DischargeInDeposit.SPB_SetDiscountClick(Sender: TObject);
Var ls_DEPOSITDATE,ls_DEPOSITTIME : String;
    lf_CRAMOUNT:Double;
begin
     if (Query_InpatientInfo.FieldByName('INRE_IsTransLocked').AsString='Y') Then
     Begin
          MessageDlg(' Sorry ! Transaction Is Already Locked.', mtWarning, [mbok], 0);
          Exit;
     End;

     ChangeToDefaultDate(DEX_CashReceivedDate);
     With Query_Process do
     begin
          Close;
          SQL.Clear;
          SQL.Add(' Select INRE_IsDischarged,INRE_DisDate,INRE_IsDisInDeposit,INRE_DisInDepositDate,INRE_DISINDEPOSITESCHEME,INRE_SPLDISINDEPOCASHDATE');
          SQL.Add(' From HS_INRE_InpatientReg where INRE_InpatientId='+IntToStr(pi_InpatientId));
          Open;
     end;

     if Query_Process.FieldByName('INRE_IsDischarged').AsString='Y' then
     Begin
          MessageDlg('Sorry ! This Patient Is Already Financially Cleared Throguh Discharge Billing.',mtWarning,[mbok],0);
          Exit;
     End;

     if (Query_Process.FieldByName('INRE_DISINDEPOSITESCHEME').AsInteger<>22) Then
     begin
          MessageDlg('Sorry ! This Patient Is Not In Specail Deposit Case.',mtWarning,[mbok],0);
          Exit;
     end;


     if (Query_Process.FieldByName('INRE_IsDisInDeposit').AsString='Y') and (Query_Process.FieldByName('INRE_SPLDISINDEPOCASHDATE').AsString<>'') then
     Begin
          IF Not (MessageDlg('Sorry ! This Patient Has Already Set Cash Receipt Date. Do You Want To Change Cash Receipt Date Again ?',mtConfirmation,[mbYes,mbNo],0)=mrYes) Then Exit;
     End;

     if Query_Process.FieldByName('INRE_DisInDepositDate').AsString > DEX_CashReceivedDate.Text then
     Begin
          MessageDlg('Sorry ! Discharged In Deposit Date Should Not Be Greater Than Cash Received Date.',mtWarning,[mbok],0);
          DEX_CashReceivedDate.SetFocus;
          Exit;
     End;

     With Query_Process do
     begin
          Close;
          SQL.Clear;
          SQL.Add(' Select SPDE_DEPOSITDATE,SPDE_DEPOSITTIME,SPDE_CRAMOUNT From HS_SPDE_SpecialDeposit where SPDE_InpatientId='+IntToStr(pi_InpatientId));
          SQL.Add(' and SPDE_DEPOSITTYPE=''DIS ADJ DEP REFUND''');
          Open;
     end;

     ls_DEPOSITDATE:=Query_Process.FieldByName('SPDE_DEPOSITDATE').AsString;
     ls_DEPOSITTIME:=Query_Process.FieldByName('SPDE_DEPOSITTIME').AsString;
     lf_CRAMOUNT:=Query_Process.FieldByName('SPDE_CRAMOUNT').AsFloat;

     if (CB_IsCashedReceived.Checked=False) then
     Begin
          IF Not (MessageDlg('Sorry ! Do You Want To Remove Cash Received Date of This Discharge In Deposit Patient ?',mtConfirmation,[mbYes,mbNo],0)=mrYes) Then Exit;
          With Query_Process do
          begin
               Close;
               SQL.Clear;
               SQL.Add(' Update HS_INRE_InpatientReg Set INRE_SPLDISINDEPOCASHDATE='''',INRE_CashRecDateAddRemoveBy='+IntToStr(gi_UserID));
               SQL.Add(' Where INRE_InpatientID='+IntToStr(gi_InPatientID));
               ExecSQL;
          end;
     End
     else
     begin
          if MessageDlg('Are You Sure To Set Cash Received Date ?',mtConfirmation,[mbYes,mbNo],0)=mrYes then
          begin
               With Query_Process do
               begin
                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_INRE_InpatientReg Set INRE_SPLDISINDEPOCASHDATE='+#39+DEX_CashReceivedDate.text+#39+',INRE_CashRecDateAddRemoveBy='+IntToStr(gi_UserID));
                    SQL.Add(' Where INRE_InpatientID='+IntToStr(gi_InPatientID));
                    ExecSQL;

                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_SPDE_SpecialDeposit Set SPDE_DepositDate='+#39+DEX_CashReceivedDate.text+#39+' where SPDE_InpatientId='+IntToStr(pi_InpatientId));
                    SQL.Add(' and SPDE_patientId='+IntToStr(pi_PatientId));
                    SQL.Add(' and SPDE_DepositDate='+#39+ls_DEPOSITDATE+#39);
                    SQL.Add(' and SPDE_DEPOSITTIME='+#39+ls_DEPOSITTIME+#39);
                    SQL.Add(' and (SPDE_CRAMOUNT='+FloatToStr(lf_CRAMOUNT)+' or SPDE_DRAMOUNT='+FloatToStr(lf_CRAMOUNT)+')');
                    ExecSQL;


                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update HS_FRDE_FractionDetail Set FRDE_BILLDATE='+#39+DEX_CashReceivedDate.text+#39+' where FRDE_InpatientId='+IntToStr(pi_InpatientId));
                    SQL.Add(' and FRDE_patientId='+IntToStr(pi_PatientId));
                    ExecSQL;
               end;
          end;
     end;
     ShowDoneMessage;
end;

