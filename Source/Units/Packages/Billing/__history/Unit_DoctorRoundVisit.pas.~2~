procedure TForm_DoctorRoundVisit.BtnSaveClick(Sender: TObject);
var
     ls_TodaysDate, ls_TodaysTime, ls_DocName, ls_DayStatus, ls_PatientType, ls_IsUserDefine, ls_NoOfDoctor, ls_RateType: String;
     lf_VatAmt, lf_Discount, lf_ChargeAmt, lf_GrossChrg, lf_DoctorPart, lf_HospitalPart, lf_HosPartRate: Double;
     I, li_DocId: Integer;
     ls_RoomTypeCode, ls_DisInDepositDate: String;
begin
     ps_TodaysDate := ServerDate.TodaysDate;
     ps_TodaysTime := ServerDate.TodaysTime;
     DateEditX_VisitDate.SystemOfDate := gi_DateSystem;

     IF PC_DoctorRoundVisit.ActivePageIndex = 1 Then
     Begin
          IF DBLCB_ActualDoc.KeyValue = NULL Then
          Begin
               MessageDlg('You Must Have To Choose Actual Doctor.', mtWarning, [mbok], 0);
               DBLCB_ActualDoc.SetFocus;
               Exit;
          End;

          DateEditX_DocChangeFrom.SystemOfDate := gi_DateSystem;
          ChangeCaption(BitBtnDocChangeFrom);

          IF DateEditX_DocChangeFrom.Text < ps_InptDate Then
          Begin
               MessageDlg('Doctor Change Date (' + DateEditX_DocChangeFrom.Text + ' ) should not be less than Inpt. Date (' + ps_InptDate +
                      ').', mtWarning, [mbok], 0);
               Exit;
          End;

          IF DateEditX_DocChangeFrom.Text > ServerDate.TodaysDate Then
          Begin
               MessageDlg('Doctor Change Date (' + DateEditX_DocChangeFrom.Text + ' ) should not be greater than Current Date (' +
                      ServerDate.TodaysDate + ').', mtWarning, [mbok], 0);
               Exit;
          End;

          ChangeIPMainDoc;
          Exit;
     End
     else  IF PC_DoctorRoundVisit.ActivePageIndex = 6 then
     begin
          IF Query_DocService.FieldByName('IsFractionLocked').AsString='Y' Then
          Begin
               MessageDlg(' Sorry ! You Cannot Sub Divide Round Charge, Fraction Is Already Locked.',mtWarning,[mbok],0);
               Exit;
          End;

          IF Query_SharingList.RecordCount=0 Then
          Begin
               MessageDlg('Sorry ! You must have to select at least one doctor.',mtWarning,[mbok],0);
               DLCB_Doctor.SetFocus;
               Exit;
          End;

          IF round(pf_TotalAmt) <> round(pf_RoundChrg) Then
          Begin
               MessageDlg('Round Charge ( '+lbl_roundcharge.Caption+' ) and Accumulated Amt. ( '+lbl_accamt.Caption+' ) Does Not Match.',mtWarning,[mbok],0);

               IF CB_PercentWise.Checked=True Then
               Edit_Percentage.SetFocus
               Else
               Edit_Amount.SetFocus;

               Exit;
          End;
          IF DivideRoundChrgForMultiDocNew=False Then Exit;

          CB_AllIncomeDivide.Checked:=False;
          CB_PercentWise.Checked:=False;

          Edit_Percentage.Text:='0';
          Edit_Amount.Text:='0';

          Edit_DocAmount.Text:='0';
          Edit_DocPercent.Text:='0';

          Label_AccAmt.Caption:='0.00';
          Label_AccPer.Caption:='0.00';

          BitBtnCancelClick(Sender);

          Query_DocService.Close;
          Query_DocService.Open;

          Exit;
     end
     Else IF PC_DoctorRoundVisit.ActivePageIndex = 2 Then
     Begin

     End;

     IF ISDischargedPatient(pi_InpatientId) = True Then
     Begin
          MessageDlg('Sorry ! Patient is already discharged.', mtWarning,[mbok],0);
          Exit;
     End
     Else
     Begin
          //IsPatientDisInDeposit Case
          ls_DisInDepositDate:=IsDisInDepositMode(pi_InpatientId);
          if Trim(ls_DisInDepositDate)<>'' then
          Begin
               IF DateEditX_VisitDate.Text > ls_DisInDepositDate Then
               Begin
                    MessageDlg('Sorry ! This Patient Is " Discharge In Deposit " Case, So Doctor Visit Date (' + DateEditX_VisitDate.Text + ') Must Be Less Than Discharge In Deposit Date (' + ls_DisInDepositDate + ').',
                    mtWarning, [mbok], 0);
                    DateEditX_VisitDate.SetFocus;
                    Exit;
               End;
          End;
     End;

     if ISTRANSLOCKED(gi_InPatientID)=True then
     begin
          MessageDlg('Sorry ! Transaction is already locked.',mtWarning,[mbOK],0);
          Exit;
     end;

     IF DateEditX_VisitDate.Text < ps_InptDate Then
     Begin
          MessageDlg('Sorry ! Doctor Visit Date (' + DateEditX_VisitDate.Text + ') is Previous Than Inpt. Date (' + ps_InptDate + ').',
               mtWarning, [mbok], 0);
          DateEditX_VisitDate.SetFocus;
          Exit;
     End;

     IF DateEditX_VisitDate.Text > ps_TodaysDate Then
     Begin
          MessageDlg('Sorry ! Doctor Visit Date (' + DateEditX_VisitDate.Text + ') Exceeds The Current Date (' + ps_TodaysDate + ').',
               mtWarning, [mbok], 0);
          DateEditX_VisitDate.SetFocus;
          Exit;
     End;


     IF DBLCB_VisitDoctor.KeyValue = NULL Then
     Begin
          MessageDlg('Sorry ! You must have to select doctor.', mtWarning, [mbok], 0);
          DBLCB_VisitDoctor.SetFocus;
          Exit;
     End;

     li_DocId := Query_VisitDoctor.FieldByName('DocId').AsInteger;
     //ps_DocCode := DBLCB_VisitDoctor.KeyValue;
     pi_DOCID:=DBLCB_VisitDoctor.KeyValue;

     IF Edit_DisPer.Text = '' Then
          Edit_DisPer.Text := '0';

     IF StrToFloat(Edit_DisPer.Text) > 100 Then
     Begin
          MessageDlg('Discount Percent Exceeds 100 %', mtWarning, [mbok], 0);
          Edit_DisPer.SetFocus;
          Exit;
     End;

     IF CB_UserDefineRoundChrg.Checked = true Then
     Begin
          IF Trim(Edit_UserDefineRoundChrg.Text) = '' Then
               Edit_UserDefineRoundChrg.Text := '0';

          IF Edit_UserDefineRoundChrg.Text = '0' Then
          Begin
               MessageDlg('You Must Have To Define User Define Charge.', mtWarning, [mbok], 0);
               Edit_UserDefineRoundChrg.SetFocus;
               Exit;
          End;

          ls_IsUserDefine := 'Y';

          lf_GrossChrg := StrToFloat(Edit_UserDefineRoundChrg.Text);
          lf_VatAmt := lf_GrossChrg * gf_TaxPercent / 100;

     End
     Else
     Begin
          ls_IsUserDefine := 'N';

          if ps_PatientType='GEN' then
          Begin
               lf_GrossChrg := Query_RoomType.FieldByName('RoundVisitCharge').AsFloat;
               lf_VatAmt := Query_RoomType.FieldByName('RoundVisitSvrTax').AsFloat;
          End
          Else if ps_PatientType='PVT' then
          Begin
               lf_GrossChrg := Query_RoomType.FieldByName('ROUNDVISITCHARGEPVT').AsFloat;
               lf_VatAmt := Query_RoomType.FieldByName('ROUNDVISITSVRTAXPVT').AsFloat;
          End
          Else if ps_PatientType='FRG' then
          Begin
               lf_GrossChrg := Query_RoomType.FieldByName('ROUNDVISITCHARGEFRG').AsFloat;
               lf_VatAmt := Query_RoomType.FieldByName('ROUNDVISITSVRTAXFRG').AsFloat;
          End
          Else if ps_PatientType='FRP' then
          Begin
               lf_GrossChrg := Query_RoomType.FieldByName('ROUNDVISITCHARGEFRP').AsFloat;
               lf_VatAmt := Query_RoomType.FieldByName('ROUNDVISITSVRTAXFRP').AsFloat;
          End
          Else
          Begin
               lf_GrossChrg := Query_RoomType.FieldByName('RoundVisitCharge').AsFloat;
               lf_VatAmt := Query_RoomType.FieldByName('RoundVisitSvrTax').AsFloat;
          End;

     End;

     lf_HosPartRate := Query_RoomType.FieldByName('HosPartPercent').AsFloat;

     lf_HospitalPart := RoundingAfterSecondPlace(lf_HosPartRate * lf_GrossChrg / 100);
     lf_DoctorPart := lf_GrossChrg - lf_HospitalPart;

     IF gs_TaxRule = 'TAD' Then
     Begin
          lf_Discount := lf_GrossChrg * StrToFloat(Edit_DisPer.Text) / 100;
          lf_ChargeAmt := lf_GrossChrg - lf_Discount;

          if lf_Discount > 0 then
               lf_VatAmt := lf_ChargeAmt * gf_TaxPercent / 100;

     End
     Else
          lf_VatAmt := lf_GrossChrg * gf_TaxPercent / 100;

     ls_RateType := 'GEN';

     If Trim(EditNoDay.Text) = '' Then
          EditNoDay.Text := 'O';

     Try
          DM_Hospital.DB.StartTransaction;
          If (CBMultipleDay.Checked = true) And (StrToInt(EditNoDay.Text) > 1) Then
          Begin
               For I := 1 To StrToInt(EditNoDay.Text) Do
               Begin
                    If I <> 1 Then
                    Begin
                         If gi_DateSystem = 0 Then
                         DateEditX_VisitDate.VSDateAsDays := DateEditX_VisitDate.VSDateAsDays + 1
                         Else
                         DateEditX_VisitDate.ADDateAsDate := DateEditX_VisitDate.ADDateAsDate + 1;
                    End;

                    //Query_RoomType.Locate('VisitDate', DateEditX_VisitDate.Text, []);
                    ls_RoomTypeCode := Query_RoomType.FieldByName('RoomTypeCode').asString;

                    { SaveDoctorroundvisit(Isfractionlocked,Isuserdefinerate,Ischargesubdivided,ISDAILYCHARGE,ISEXTRADOCINVOLVED:String;
                      Visitcharge,Tdsper,Svrchrg,Hospitalpart,Doctorpart,Disper,Vatamt,Noofvisit:Double;
                      Roomtypeid,Docid,Datapostby,Subdivideby,Patientid,Refdoctorroundvisitid,Inpatientid:Integer;
                      Dataposttime,Datapostdate,Frctlockdate,Subdividedate,Macid,Paytype,Billdate,Visitdate,Roomtypecode,
                      Doccode,Ratetype:String); }

                    SaveDoctorroundvisit('N', ls_IsUserDefine, 'N', 'N', 'Y', lf_GrossChrg, gf_TDSPercent, 0, lf_HospitalPart, lf_DoctorPart,
                         StrToFloat(Edit_DisPer.Text), lf_VatAmt, 1, Query_RoomType.FieldByName('RoomTypeId').AsInteger, li_DocId, gi_UserId, 0,
                         pi_PatientId, 0, pi_InpatientId,GetCurrentWard(pi_inpatientid), ps_TodaysTime, ps_TodaysDate, '', '', gs_MacID, '', '', DateEditX_VisitDate.Text,
                         Query_RoomType.FieldByName('RoomTypeCode').asString, ps_DocCode, ls_RateType);

               End;
          End
          Else
          Begin
               ls_RoomTypeCode := Query_RoomType.FieldByName('RoomTypeCode').asString;

               { SaveDoctorroundvisit(Isfractionlocked,Isuserdefinerate,Ischargesubdivided,ISDAILYCHARGE,ISEXTRADOCINVOLVED:String;
                    Visitcharge,Tdsper,Svrchrg,Hospitalpart,Doctorpart,Disper,Vatamt,Noofvisit:Double;
                    Roomtypeid,Docid,Datapostby,Subdivideby,Patientid,Refdoctorroundvisitid,Inpatientid:Integer;
                    Dataposttime,Datapostdate,Frctlockdate,Subdividedate,Macid,Paytype,Billdate,Visitdate,Roomtypecode,
                    Doccode,Ratetype:String); }

               SaveDoctorroundvisit('N', ls_IsUserDefine, 'N', 'N', 'Y', lf_GrossChrg, gf_TDSPercent, 0, lf_HospitalPart, lf_DoctorPart,
                    StrToFloat(Edit_DisPer.Text), lf_VatAmt, 1, Query_RoomType.FieldByName('RoomTypeId').AsInteger, li_DocId, gi_UserId, 0,
                    pi_PatientId, 0, pi_InpatientId,GetCurrentWard(pi_inpatientid), ps_TodaysTime, ps_TodaysDate, '', '', gs_MacID, '', '', DateEditX_VisitDate.Text,
                    Query_RoomType.FieldByName('RoomTypeCode').asString, ps_DocCode, ls_RateType);
          End;

          if (ls_DisInDepositDate<>'') and (pi_DisInDepositTransId > 0) then
          begin
               With Query_Process do
               begin
                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Update DoctorRoundVisit Set DISINDEPOSITTRANSID='+IntToStr(pi_DisInDepositTransId));
                    SQL.Add(' where InpatientId='+IntToStr(pi_InpatientId)+' and PatientId='+IntToStr(pi_PatientId));
                    SQL.Add(' and DISINDEPOSITTRANSID=0');
                    ExecSQL;
               end;
          end;

          DM_Hospital.DB.Commit;
          ShowDoneMessage;
     except
          DM_Hospital.DB.Rollback;
          MessageDlg('Failure To Save Doctor Round Visit',mtWarning,[mbOK],0);
          Exit;
     End;

     with Query_DocService do
     Begin
          Close;
          sql[5] := ' and InpatientId=' + IntToStr(pi_InpatientId);
          Open;
     End;
     b_New := true;
     DateEditX_VisitDate.Text := ServerDate.TodaysDate;
     DateEditX_VisitDate.SetFocus;
     DBLCB_VisitDoctor.KeyValue := NULL;
     CB_UserDefineRoundChrg.Checked := False;
     Edit_DisPer.Text := '';
     LabelChrg.Caption := '0.00';

end;

