                 ' ) Does Not Match.', mtWarning, [mbok], 0);

          IF CB_PercentBasis.Checked = True Then
               Edit_PerMainDoc.SetFocus
          Else
               Edit_AmtMainDoc.SetFocus;
          Exit;
     End;


     IF (Query_RoundSharingDetail.FieldByName('DocID').AsString=DBLCB_2ndDoc.KeyValue) or
     (Query_RoundSharingDetail.FieldByName('DocID').AsString=DBLCB_3rdDoc.KeyValue) or
     (Query_RoundSharingDetail.FieldByName('DocID').AsString=DBLCB_4thDoc.KeyValue) or
     ((DBLCB_2ndDoc.KeyValue=DBLCB_3rdDoc.KeyValue) and (DBLCB_2ndDoc.KeyValue<>Null) and (DBLCB_3rdDoc.KeyValue<>Null)) or
     ((DBLCB_2ndDoc.KeyValue=DBLCB_4thDoc.KeyValue) and (DBLCB_2ndDoc.KeyValue<>Null) and (DBLCB_4thDoc.KeyValue<>Null)) or
     ((DBLCB_3rdDoc.KeyValue=DBLCB_4thDoc.KeyValue) and (DBLCB_3rdDoc.KeyValue<>Null) and (DBLCB_4thDoc.KeyValue<>Null))
     Then
     Begin
          MessageDlg('Same Doctor More Than One Time For Round Charge Divide.',mtWarning,[mbok],0);
          DBLCB_2ndDoc.SetFocus;
          Exit;
     End;

     IF DivideRoundChrgForMultiDoc=False Then Exit;

     ReFreshFractionDivisionArea;

     Get_Frct_BreakUp_OfRoundVisit;
     SubFractionInterfaceActiveInActive(False);
end;


