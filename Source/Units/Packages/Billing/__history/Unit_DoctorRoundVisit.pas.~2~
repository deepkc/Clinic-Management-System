procedure TForm_DoctorRoundVisit.SPB_TalliedFractionItemsClick(Sender: TObject);
Var
  ls_Description, ls_PayType, ls_DocCode, ls_RoomTypeCode: String;
  lf_FractionRate, lf_FractionAmt, lf_CostPrice, lf_DisPer,lf_fractionId: Double;
  li_Qty, li_DocId, li_Roomtypeid,li_fractionId: Integer;

Begin
     ls_Description := 'IP CONSULTATION';
     ls_PayType := 'CASH';

     gs_ISROOMTYPEWISEIPROUNDSHARE := 'Y';
     li_fractionId :=800;

     ps_TodaysDate:=TodaysDate;
     ps_TodaysTime:=TodaysTime;

     if gs_ISROOMTYPEWISEIPROUNDSHARE = 'N' Then
     Begin
          With Query_SubProcess Do
          Begin
               Close;
               DatabaseName := gs_DatabaseName;
               sql.Clear;
               sql.Add(' Select * From HS_FRAC_Fraction');
               sql.Add(' where FRAC_Description=''IPD ROUND SHARE''');
               Open;
          End;
          lf_FractionRate := Query_SubProcess.FieldByName('FRAC_FractionRate').AsFloat;
     End;

     With Query_Process Do
     Begin
          Close;
          DatabaseName := gs_DatabaseName;
          sql.Clear;
          sql.Add(' Select R.*,Round((DisAmount/VisitCharge)*100,4) as DisPer,(DoctorPart/VisitCharge)*100 as DocRatePer,NVL((Select FRDE_FractionDetailID From HS_FRDE_FractionDetail');
          sql.Add(' where FRDE_InpatientId=' + IntToStr(pi_InpatientId) + ' and FRDE_TestNameCode=''IPCON'' and FRDE_DOCID=R.DocId and RowNum=1),0) FractionDetailId From (');
          (*sql.Add(' Select DocId,Round(Sum(VisitCharge)/Count(DoctorRoundVisitID),4) VisitCharge,Round(Sum(VisitCharge*DisPer/100)/Count(DoctorRoundVisitID),4) as DisAmount,');
          sql.Add(' Round(Sum(VatAmt)/Count(DoctorRoundVisitID),4) as VatAmt,Round(Sum(DoctorPart)/Count(DoctorRoundVisitID),4) as DoctorPart,Count(DoctorRoundVisitID) as TotalDays');
          sql.Add(' From DOCTORROUNDVISIT DRV Where InPatientID=' + IntToStr(pi_InpatientId) + ' and VisitCharge > 0');*)
          sql.Add(' Select DocId,Round(Sum(VisitCharge),4) VisitCharge,Round(Sum(VisitCharge*DisPer/100),4) as DisAmount,');
          sql.Add(' Round(Sum(VatAmt),4) as VatAmt,Round(Sum(DoctorPart),4) as DoctorPart,1 as TotalDays');
          sql.Add(' From DOCTORROUNDVISIT DRV Where InPatientID=' + IntToStr(pi_InpatientId) + ' and VisitCharge > 0');
          sql.Add(' Group By DOCID) R');
          sql.Add(' Order By DOCID');
          //SQL.SaveToFile('C:\RoundVisit.Txt');
          Open;
          First;
          While Not eof Do
          Begin
               li_DocId := Query_Process.FieldByName('DocID').AsInteger;
               if Query_Process.FieldByName('FractionDetailId').AsInteger=0 then
               Begin
                    if (gs_ISROOMTYPEWISEIPROUNDSHARE = 'Y') and (0=1) Then // Now Block To Use This Part
                    Begin
                         With Query_SubProcess Do
                         Begin
                              Close;
                              sql.Clear;
                              sql.Add(' Select 100-ROTP_HosPartPercent as DocRatePer from HS_ROTP_ROOMTYPEPRICE');
                              sql.Add(' where ROTP_RoomTypeId In (Select ROOMTYPEID From RoomType ');
                              sql.Add(' where RoomTypeId=' + IntToStr(Query_Process.FieldByName('RoomTypeId').AsInteger) + ')');
                              sql.Add(' and ROTP_PatientTypeCode=' + #39 + ps_PatientTypeCode +#39);
                              Open;
                         End;
                         lf_FractionRate := Query_SubProcess.FieldByName('DocRatePer').AsFloat;
                    End
                    Else
                    lf_FractionRate := Query_Process.FieldByName('DocRatePer').AsFloat;

                    lf_FractionAmt := Query_Process.FieldByName('VisitCharge').AsFloat * (lf_FractionRate / 100);
                    lf_CostPrice := Query_Process.FieldByName('VisitCharge').AsFloat;
                    lf_DisPer := Query_Process.FieldByName('DisPer').AsFloat;
                    li_Qty := Query_Process.FieldByName('TotalDays').AsInteger;
                    li_DocId := Query_Process.FieldByName('DocID').AsInteger;

                    (* SaveFractiondetail(PATIENTID,INPATIENTID,BILLDETAILID,SERVICEBILLDETAILID,FRACTIONID,POSITIONWISEFRACTIONID,DEPID,DATAPOSTBY : Integer;
                         UNITTESTCOST,QTY,FRACTIONAMOUNT,FRACTIONRATE,DISPER:Double;
                         DOCCODE,TESTNAMECODE,BILLNO,BILLDATE,BILLTYPE,PAYTYPE,ISFRACTIONPROPWITHDISPER,DESCRIPTION,ISADDLUMPSUM,
                         ISCHARGEDIVIDE,REMARKS,DATAPOSTDATE,DATAPOSTTIME :String); *)
                    pb_MutualDocForShare:=Mutually_Share_Fraction(li_DocId,'ROUND');
                    if pb_MutualDocForShare = False then
                    Begin
                         SaveFractiondetail(pi_PatientId, pi_InpatientId, li_DocId,0, 5, li_DocId, 0, li_fractionId, 0,
                              gi_UserId,0, lf_CostPrice, lf_CostPrice, li_Qty, lf_FractionAmt,lf_FractionRate, lf_DisPer, 'IPCON', ps_BillNo,
                              ps_BillDate, 'IP',ls_PayType, 'Y', 'IP CONSULTATION', 'N', 'N', '', ps_TodaysDate, ps_TodaysTime,'N');
                    end
                    else
                    begin
                         Query_MutualDocForShare.First;
                         While not Query_MutualDocForShare.eof do
                         begin
                              IF Query_MutualDocForShare.FieldByName('DocRate').AsFloat > 0 Then
                              Begin
                                   SaveFractiondetail(gi_PatientId, 0, Query_MutualDocForShare.FieldByName('docID').AsInteger, 0, 5, Query_MutualDocForShare.FieldByName('docID').AsInteger,
                                        0, li_fractionId, 0, gi_UserId,0, lf_CostPrice, lf_CostPrice, li_Qty,
                                        lf_FractionAmt * Query_MutualDocForShare.FieldByName('DocRate').AsFloat / 100,
                                        lf_FractionRate * Query_MutualDocForShare.FieldByName('DocRate').AsFloat / 100,
                                        lf_DisPer, 'IPCON', ps_BillNo, ps_BillDate,'IP', ls_PayType, 'Y', 'IP CONSULTATION', 'N', 'N', '',
                                        ps_TodaysDate,ps_TodaysTime,'N');

                              End;
                              Query_MutualDocForShare.Next;
                         end;
                    end;
               End;
               Query_Process.Next;
          End;
     End;
     ShowDoneMessage;
     Get_Frct_BreakUp_OfRoundVisit;
     GetBillTotalAndFractionTotalOfRoundVisit;
End;

