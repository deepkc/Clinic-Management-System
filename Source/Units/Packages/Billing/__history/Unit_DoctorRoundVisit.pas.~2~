procedure TForm_DoctorRoundVisit.BitBtn_AddClick(Sender: TObject);
begin
     if DLCB_Doctor.KeyValue=Null then
     Begin
          MessageDlg('Please Select The Doctor .',mtWarning,[mbok],0);
          Exit;
     End;
     if pf_accamt>strtofloat(lbl_roundcharge.caption) then
     Begin
          MessageDlg('Total VisitCharge Should Not be Greater Than Round Charge .',mtWarning,[mbok],0);
          Exit;
     End;
     if pf_accper>100 then
     Begin
          MessageDlg('Percentage Should Not Exceed 100.',mtWarning,[mbok],0);
          Exit;
     End;
     With QueryProcess Do
     Begin
          Close;
          DatabaseName:=gs_TempPath;
          sql.Clear;
          Sql.Add('Select * from RoundCharge Where Doccode='+#39+DLCB_Doctor.keyvalue+#39);
          Open;
     End;

     If QueryProcess.RecordCount>0 then
     Begin
          MessageDlg('Round Already Divided For This Doctor. Please Select Another Doctor.',mtWarning,[mbok],0);
          pf_accamt:=pf_accamt-strtofloat(Edit_DocAmount.Text);
          pf_accper:=pf_accper-strtofloat(Edit_DocPercent.Text);
          Edit_DocPercent.Text:='0';
          Edit_DocAmount.Text:='0';
          DisplayCaption;
          Exit;
     End;

     With Query_TempProcess do
     Begin
          Close;
          DatabaseName:=gs_TempPath;
          sql.Clear;
          sql.add(' Insert Into RoundCharge(Doccode,DocName,VisitCharge,DocRate)');
          sql.add(' Values ('+#39+(DLCB_Doctor.KeyValue)+#39+','+#39+DLCB_Doctor.Text+#39+','+Edit_DocAmount.Text+','+Edit_DocPercent.text+')');
         // sql.add(' ,'+Edit_SharePer.Text+',''Y'')');
          ExecSQL;
     End;
     DLCB_Doctor.KeyValue:=Null;
     Edit_DocAmount.Text:='0';
     Edit_DocPercent.Text:='0';
     GetSharingList;
     DLCB_Doctor.SetFocus;
end;

