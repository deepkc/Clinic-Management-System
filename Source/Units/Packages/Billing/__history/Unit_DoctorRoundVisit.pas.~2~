procedure TForm_DoctorRoundVisit.SpeedButton2Click(Sender: TObject);
var
     lf_ChargeAmt, lf_GrossChrg, lf_Discount, lf_VatAmt, lf_HospitalPart, lf_DoctorPart: Double;
begin
     IF MessageDlg('Are you sure to Convert Round Charge Into Non-Operation Case.', mtInformation, [mbyes, mbno], 0) = mrNo Then
          Exit;
     DBLCB_RoomType.KeyValue := 1; // Non-Operation

     Query_DocService.First;
     while not Query_DocService.EOF do
     Begin
          lf_GrossChrg := 0;

          IF Query_DocService.FieldByName('DayStatus').asString = 'HD' Then
               lf_GrossChrg := lf_GrossChrg / 2;

          // lf_HospitalPart := RoundingAfterSecondPlace(Query_GetVisitCharge.FieldByName('HosPartPercent').AsFloat * lf_GrossChrg / 100);
          lf_HospitalPart := 0;
          lf_DoctorPart := lf_GrossChrg - lf_HospitalPart;

          IF gs_TaxRule = 'TAD' Then
          Begin
               lf_Discount := lf_GrossChrg * Query_DocService.FieldByName('DisPer').AsFloat / 100;
               lf_ChargeAmt := lf_GrossChrg - lf_Discount;
               lf_VatAmt := lf_ChargeAmt * gf_TaxPercent / 100;
          End
          Else
               lf_VatAmt := lf_GrossChrg * gf_TaxPercent / 100;

          with Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Update DOCTORROUNDVISIT Set VisitCharge=' + FloatToStr(lf_GrossChrg));
               sql.add(' ,VatAmt=' + FloatToStr(lf_VatAmt) + ',HospitalPart=' + FloatToStr(lf_HospitalPart));
               sql.add(' ,DoctorPart=' + FloatToStr(lf_DoctorPart) + ',PatientType=''NOP''');
               sql.add(' where DOCTORROUNDVISITId=' + Query_DocService.FieldByName('DOCTORROUNDVISITId').asString);
               ExecSQL;
          End;
          Query_DocService.Next;
     End;
     ShowDoneMessage;
     Query_DocService.Close;
     Query_DocService.Open;
     Query_DocService.Last;
end;

