procedure TForm_DoctorRoundVisit.SP_ResetChrgDivideClick(Sender: TObject);
begin
     IF Query_RoundSharingDetail.FieldByName('IsChargeDivide').AsString = 'N' Then
     Begin
          MessageDlg('Sorry ! You Cannot Reset Fraction Charge Divide For This Row.', mtWarning, [mbok], 0);
          Exit;
     End;

     IF Query_RoundSharingDetail.FieldByName('IsFractionLocked').AsString = 'Y' Then
     Begin
          MessageDlg(' Sorry ! You Cannot Edit. Fraction Is Already Locked.', mtWarning, [mbok], 0);
          Exit;
     End;

     IF MessageDlg('Are You Sure To Reset Fraction Charge Divide.', mtConfirmation, [mbyes, mbno], 0) = mrYes Then
     Begin
          With Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select Sum(FRDE_FractionRate) FractionRate,Sum(FRDE_FractionAmount) as FractionAmount,Sum(FRDE_SCharge) as SCharge ');
               sql.add(' From HS_FRDE_FractionDetail where FRDE_RefFractionDetailId=' + Query_RoundSharingDetail.FieldByName('RefFractionDetailId').AsString);
               sql.add(' and FRDE_FractionDetailId<>' + Query_RoundSharingDetail.FieldByName('RefFractionDetailId').AsString);
               Open;
          End;

          Try
               DM_Hospital.Db.StartTransaction;
               With Query_SubProcess do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update HS_FRDE_FractionDetail set FRDE_FractionAmount=FRDE_FractionAmount+' + FloatToStr(Query_Process.FieldByName('FractionAmount').AsFloat));
                    sql.add(' ,FRDE_FractionRate=FRDE_FractionRate + ' + FloatToStr(Query_Process.FieldByName('FractionRate').AsFloat));
                    sql.add(' ,FRDE_SCharge=FRDE_SCharge + ' + FloatToStr(Query_Process.FieldByName('SCharge').AsFloat));
                    sql.add(' ,FRDE_FrctModifyDate=' + #39 + ServerDate.TodaysDate + #39 + ',FRDE_IsChargeDivide=''N'',FRDE_FrctModifyBy=' + IntToStr(gi_UserID));
                    sql.add(' ,FRDE_RefFractionDetailId=0 where FRDE_FractionDetailId=' + IntToStr(Query_RoundSharingDetail.FieldByName('RefFractionDetailId').AsInteger));
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Delete From HS_FRDE_FractionDetail where FRDE_RefFractionDetailId=' + IntToStr(Query_RoundSharingDetail.FieldByName('RefFractionDetailId').AsInteger));
                    sql.add(' and FRDE_FractionDetailId<>' + IntToStr(Query_RoundSharingDetail.FieldByName('RefFractionDetailId').AsInteger));
                    ExecSQL;
               End;

               DM_Hospital.Db.Commit;
               ShowDoneMessage;
          Except
               DM_Hospital.Db.RollBack;
          End;

          Get_Frct_BreakUp_OfRoundVisit;
          GetBillTotalAndFractionTotalOfRoundVisit;
     End;
end;

