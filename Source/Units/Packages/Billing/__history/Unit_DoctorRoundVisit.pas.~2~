procedure TForm_DoctorRoundVisit.SB_SetChangesClick(Sender: TObject);
begin
     IF Edit_FrctAmt.Text = '' Then
          Edit_FrctAmt.Text := '0';

     if Trim(Edit_RemarksRoundVisitSharingMgmt.Text)='' then
     Begin
          MessageDlg('Compulsory to Put Reason for Adjustment of Round Visit Sharing.', mtWarning, [mbok], 0);
          Edit_RemarksRoundVisitSharingMgmt.SetFocus;
          Exit;
     End;

     IF CB_Per.Checked = True Then
     Begin
          IF (StrToFloat(Edit_FrctAmt.Text) > 100) Then
          Begin
               MessageDlg('Plz. Check Properly Sharing(Fraction) Adjustment Percent(%).', mtWarning, [mbok], 0);
               Edit_FrctAmt.SetFocus;
               Exit;
          End;
     End
     Else
     Begin
          IF (StrToFloat(Edit_FrctAmt.Text) = 0) Then
          Begin
               MessageDlg('Plz. Check Properly Sharing(Fraction) Adjustment Amount.', mtWarning, [mbok], 0);
               Edit_FrctAmt.SetFocus;
               Exit;
          End;

          IF Query_GetRoundVisitCharge.FieldByName('Amount').AsFloat < StrToFloat(Edit_FrctAmt.Text) Then
          Begin
               MessageDlg('New Adjusted Round Visit Sharing Amount ('+Edit_FrctAmt.Text+' ) Should Not Be More'+
               ' Than Unit Round Visit Charge ('+FloatToStr(Query_GetRoundVisitCharge.FieldByName('Amount').AsFloat)+') .', mtWarning, [mbok], 0);
               Edit_FrctAmt.SetFocus;
               Exit;
          End;

          { IF Query_Frct_BreakUp_OfItem.FieldByName('DocCommNet').AsFloat < StrToFloat(Edit_FrctAmt.Text) Then
            Begin
            MessageDlg('New Adjustment Is Greater ',mtWarning,[mbok],0);
            Edit_FrctAmt.SetFocus;
            Exit;
            End; }
     End;

     pf_UnitTestCost := Query_GetRoundVisitCharge.FieldByName('Amount').AsFloat;
     pf_Qty := Query_GetRoundVisitCharge.FieldByName('Qty').AsFloat;

     ps_TodaysDate:=TodaysDate;

     IF CB_Per.Checked = False Then
     Begin
          pf_NewDocComm := StrToFloat(Edit_FrctAmt.Text);
          pf_NewFrctPer := GetNoOfDecimalPartOfFloatNum((pf_NewDocComm / pf_UnitTestCost) * 100, 4);
     End
     Else
     Begin
          pf_NewDocComm := pf_UnitTestCost * StrToFloat(Edit_FrctAmt.Text) / 100;
          pf_NewFrctPer := StrToFloat(Edit_FrctAmt.Text);
     End;

     With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Update FractionDetail Set FractionAmount=' + FloatToStr(pf_NewDocComm));
          sql.add(' ,FractionRate=' + FloatToStr(pf_NewFrctPer));
          sql.add(' ,Remarks=' + #39+StringReplace(Edit_RemarksRoundVisitSharingMgmt.Text,'''','''''',[rfReplaceAll])+#39);
          sql.add(' ,FrctModifyDate='+#39+ps_TodaysDate+#39+' , FrctModifyBy='+IntToStr(gi_UserID));
          sql.add(' ,PrevFractionRate=FractionRate');
          sql.add(' where FractionDetailId=' + IntToStr(Query_GetRoundVisitCharge.FieldByName('FractionDetailId').AsInteger));
          ExecSQL;
     End;
     ShowDoneMessage;

     RoundVisitSharingMgmt;
end;

Procedure TForm_DoctorRoundVisit.DisplayCaption;
var  AccAmt:Double;
Begin
     IF CB_PercentBasis.Checked = False Then
     Begin
          if (DBLCB_2ndDoc.Text<>'') and (DBLCB_3rdDoc.Text<>'') and (DBLCB_4thDoc.Text<>'') then
          Label_AccAmt.Caption := FormatFloat('0.00', StrToFloat(Edit_AmtMainDoc.Text) + StrToFloat(Edit_Amt2ndDoc.Text) + StrToFloat
                 (Edit_Amt3rdDoc.Text)+ StrToFloat(Edit_Amt4thDoc.Text))
          Else if (DBLCB_2ndDoc.Text<>'') and (DBLCB_3rdDoc.Text<>'') and (DBLCB_4thDoc.Text='') then
          Label_AccAmt.Caption := FormatFloat('0.00', StrToFloat(Edit_AmtMainDoc.Text) + StrToFloat(Edit_Amt2ndDoc.Text) + StrToFloat
                 (Edit_Amt3rdDoc.Text))
          Else if (DBLCB_2ndDoc.Text<>'') and (DBLCB_3rdDoc.Text='') and (DBLCB_4thDoc.Text='') then
          Label_AccAmt.Caption := FormatFloat('0.00', StrToFloat(Edit_AmtMainDoc.Text) + StrToFloat(Edit_Amt2ndDoc.Text));

          pf_TotalAmt := StrToFloat(Label_AccAmt.Caption);

          IF Abs(StrToFloat(Label_RoundChrg.Caption) - StrToFloat(Label_AccAmt.Caption)) <= 0.2 Then
          Begin
               Label_AccAmt.Caption := Label_RoundChrg.Caption;
               pf_TotalAmt := StrToFloat(Label_AccAmt.Caption);
          End;

          Label_AccPer.Caption := FormatFloat('0.00', (pf_TotalAmt / pf_FractionAmount) * 100);

     End
     Else
     Begin
          if (DBLCB_2ndDoc.Text<>'') and (DBLCB_3rdDoc.Text<>'') and (DBLCB_4thDoc.Text<>'') then
          Label_AccPer.Caption := FormatFloat('0.00', StrToFloat(Edit_PerMainDoc.Text) + StrToFloat(Edit_Per2ndDoc.Text) + StrToFloat
                 (Edit_Per3rdDoc.Text)+ StrToFloat(Edit_Per4thDoc.Text))
          Else if (DBLCB_2ndDoc.Text<>'') and (DBLCB_3rdDoc.Text<>'') and (DBLCB_4thDoc.Text='') then
          Label_AccPer.Caption := FormatFloat('0.00', StrToFloat(Edit_PerMainDoc.Text) + StrToFloat(Edit_Per2ndDoc.Text) + StrToFloat
                 (Edit_Per3rdDoc.Text))
          Else if (DBLCB_2ndDoc.Text<>'') and (DBLCB_3rdDoc.Text='') and (DBLCB_4thDoc.Text='') then
          Label_AccPer.Caption := FormatFloat('0.00', StrToFloat(Edit_PerMainDoc.Text) + StrToFloat(Edit_Per2ndDoc.Text));

          pf_TotPer := StrToFloat(Label_AccPer.Caption);
          Label_AccAmt.Caption := FormatFloat('0.00', (pf_TotPer * pf_FractionAmount) / 100);

          IF Abs(StrToFloat(Label_RoundChrg.Caption) - StrToFloat(Label_AccAmt.Caption)) <= 0.2 Then
          Begin
               Label_AccAmt.Caption := Label_RoundChrg.Caption;
               pf_TotalAmt := StrToFloat(Label_AccAmt.Caption);
          End;

          pf_TotalAmt := StrToFloat(Label_AccAmt.Caption);
     End;


End;

