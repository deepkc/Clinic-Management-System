Procedure TForm_DoctorRoundVisit.Remove_Doc_Frct_WhoHaveNoRoundIn_DocSvr_ButExistIn_DrProcedure;
Begin
     With Query_Get_All_IPCons_Doc do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select FRDE_INPATIENTID ,FRDE_UNITTESTCOST UNITTESTCOST,FRDE_TESTNAMECODE TESTNAMECODE,FRDE_DOCCODE DOCCODE');
          sql.add(' From HS_FRDE_FRACTIONDETAIL where FRDE_INPATIENTID=' + IntToStr(pi_InpatientId));
          sql.add(' and FRDE_DESCRIPTION=''IP CONSULTATION''');
          Open;
          First;
          While Not EOF Do
          Begin
               With Query_CheckIn_DocSvrTable do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Select * From (Select BillDate,BillNo,DocCode,PatientType,VisitCharge,DisPer,Count(DocCode) TotalDays ');
                    sql.add(' ,Sum(VisitCharge-(VisitCharge*DisPer/100)) TotalVisitCharge ');
                    sql.add(' From DOCTORROUNDVISIT Where InPatientID=' + IntToStr(pi_InpatientId));
                    sql.add(' Group By BillDate,BillNo,DocCode,PatientType,VisitCharge,DisPer) ');
                    sql.add(' where VisitCharge=' + FloatToStr(Query_Get_All_IPCons_Doc.FieldByName('UnitTestCost').AsFloat));
                    sql.add(' and PatientType=' + #39 + Query_Get_All_IPCons_Doc.FieldByName('TestNameCode').asString + #39);
                    sql.add(' and DocCode=' + #39 + Query_Get_All_IPCons_Doc.FieldByName('DocCode').asString + #39);
                    Open;
               End;

               IF Query_CheckIn_DocSvrTable.FieldByName('TotalDays').AsInteger = 0 Then
               Begin
                    with QueryVoid do
                    Begin
                         Close;
                         DatabaseName := gs_DatabaseName;
                         sql.Clear;
                         sql.add(' Delete From HS_FRDE_FRACTIONDETAIL where FRDE_INPATIENTID=' + IntToStr(pi_InpatientId));
                         sql.add(' and FRDE_DESCRIPTION=''IP CONSULTATION''');
                         sql.add(' and FRDE_TESTNAMECODE=' + #39 + Query_Get_All_IPCons_Doc.FieldByName('TestNameCode').asString + #39);
                         sql.add(' and FRDE_DOCCODE=' + #39 + Query_Get_All_IPCons_Doc.FieldByName('DocCode').asString + #39);
                         sql.add(' and FRDE_UNITTESTCOST=' + FloatToStr(Query_Get_All_IPCons_Doc.FieldByName('UnitTestCost').AsFloat));
                         ExecSQL;
                    End;
               End;
               Query_Get_All_IPCons_Doc.Next;
          End;
     End;
End;

procedure TForm_DoctorRoundVisit.RoundVisitSharingMgmt;
Begin
     with Query_GetRoundVisitCharge do
     begin
          Close;
          sql.Clear;
          sql.Add(' Select FRDE_FRACTIONDETAILID FRACTIONDETAILID,FRDE_PATIENTID PATIENTID,FRDE_INPATIENTID INPATIENTID,');
          sql.Add(' FRDE_TESTNAMECODE TESTNAMECODE,(Select RoomType From RoomType where RoomTypeCode=FD.FRDE_TESTNAMECODE) as RoomType,');
          sql.Add(' FRDE_DESCRIPTION DESCRIPTION,FRDE_DOCCODE DOCCODE,(Select Desig||'' ''||DocName From Doctor where DocCode=FD.DocCode) as DocName,');
          sql.Add(' FRDE_BILLDATE BILLDATE,FRDE_BILLNO BILLNO,FRDE_UNITTESTCOST Amount,FRDE_QTY QTY,FRDE_DISPER DISPER,');
          sql.Add(' (FRDE_UNITTESTCOST*FRDE_QTY-FRDE_UNITTESTCOST*FRDE_QTY*FRDE_DISPER/100) as NetAmount,FRDE_FRACTIONRATE FRACTIONRATE,');
          sql.Add(' FRDE_FRACTIONAMOUNT FRACTIONAMOUNT,(FRDE_FRACTIONAMOUNT*FRDE_QTY-FRDE_FRACTIONAMOUNT*FRDE_QTY*FRDE_DISPER/100) as NetFraction,FRDE_REMARKS REMARKS');
          sql.Add(' From HS_FRDE_FRACTIONDETAIL FD');
          sql.Add(' where FRDE_INPATIENTID='+IntToStr(pi_InpatientId));
          sql.Add(' and FRDE_DESCRIPTION=''IP CONSULTATION''');
          Open;
     end;
End;


Function TForm_DoctorRoundVisit.Mutually_Share_Fraction(DOCID: Integer; ServiceType: string):Boolean;
begin
	With Query_MutualDocForShare do
	Begin
          Close;
          DatabaseName:=gs_DatabaseName;
          SQL.Clear;
          SQL.Add(' select DSBD_DOCSHAREBREAKDOWNID,DSBD_DOCID DOCID,DSBD_DOCRATE DOCRATE,DSBD_ISREFCHRGDIVIDE ISREFCHRGDIVIDE');
          SQL.Add(' From HS_DSBD_DOCSHAREBREAKDOWN where DSBD_DOCSHAREBREAKDOWNID=(select DSBD_DOCSHAREBREAKDOWNID From HS_DSBD_DOCSHAREBREAKDOWN ');
          SQL.Add(' Where DSBD_DOCID=' + IntToStr(DOCID)+ ' and DSBD_SERVICETYPE=' + #39 + ServiceType + #39 + ')');
          SQL.Add(' and DSBD_SERVICETYPE=' + #39 + ServiceType + #39 +' Order by DSBD_DOCRATE Desc');
          Open;
     end;

     IF Query_MutualDocForShare.FieldByName('DSBD_DOCSHAREBREAKDOWNID').AsInteger >= 1 Then
     Result := True
     else
     Result := False;
end;

