          SQL.Add(' ((Frde_FractionAmount*Frde_Qty)-(Frde_FractionAmount*Frde_Qty*Frde_DisPer/100)) as DocFrctNet,');
          SQL.Add(' Frde_DisPer Disper,Round(Frde_FractionRate,3) FractionRate,');
          SQL.Add(' Frde_DepId DepId, Frde_PrevDocID PrevDocId,Frde_ISFRACTIONPROPWITHDISPER ISFRACTIONPROPWITHDISPER,');
          SQL.Add(' Frde_BillType BillType,Frde_PayType PayType,Frde_IsChargeDivide IsChargeDivide,');
          SQL.Add(' Frde_RefFractionDetailId RefFractionDetailId,Frde_IsFractionLocked IsFractionLocked,Frde_FrctLockDate FrctLockDate,');
          SQL.Add(' ''IP CONSULTATION'' as Description,');
          SQL.Add(' Frde_FrctModifyDate FrctModifyDate,Frde_FrctModifyBy FrctModifyBy,Frde_Remarks Remarks,frde_IsRevSeparatehead IsRevSeparatehead');
          SQL.Add(' From Hs_Frde_FractionDetail FD,HS_DOCT_Doctor DOC');
          SQL.Add(' where FRDE_DocId=DOCT_DocId(+) and Frde_InpatientId='+IntToStr(pi_InpatientId)+' and FRDE_TestNameCode=''IPCON''');
          SQL.Add(' and FRDE_BillDetailID='+IntToStr(Query_RoundChrgSummary.FieldByName('DocID').AsInteger));
          SQL.Add(' Order By FD.Frde_TEstNameCode,FD.Frde_PositionWiseFractionId,FD.Frde_FractionDetailId');
          //sql.saveToFile('C:\DoctorServiceFrctDetail.Txt');
          Open;
     end;
end;

Procedure TForm_DoctorRoundVisit.GetBillTotalAndFractionTotalOfRoundVisit;
begin
     With Query_Process do
     begin
          Close;
          DatabaseName:=gs_DatabaseName;
          SQL.Clear;
          SQL.Add(' Select NVL((Select Sum(BIDE_Amount*BIDE_Qty) From HS_BIDE_BillDetail where BIDE_InpatientID=INRE_InpatientId and BIDE_Service=''DOCRC''),0) BDTotal,');
          SQL.Add(' NVL((Select Sum(VisitCharge) From DoctorRoundVisit where InpatientID=INRE_InpatientId ),0) DRVTotal,');
          SQL.Add(' NVL((Select Sum(FRDE_UnitTestCost*FRDE_Qty)  From HS_FRDE_FractionDetail where FRDE_InpatientID=INRE_InpatientId and FRDE_TestNameCode=''IPCON''),0) FDTotal,');
          SQL.Add(' NVL((Select Sum(FRDE_FractionAmount*FRDE_Qty)  From HS_FRDE_FractionDetail where FRDE_InpatientID=INRE_InpatientId and FRDE_TestNameCode=''IPCON''),0) FDFractionAmount');
          SQL.Add(' From HS_INRE_InpatientReg where INRE_InpatientId='+IntToStr(pi_InpatientId));
          Open;
     end;

     if pb_IsDisInDepositPT=False then
     begin
          Label_BillTotalRoundVisit.Caption:=FloatToStr(Query_Process.FieldByName('BDTOTAL').AsFloat);
          Label_FractionTotalRoundVisit.Caption:=FloatToStr(Query_Process.FieldByName('FDFRACTIONAMOUNT').AsFloat);
     end
     Else
     begin
          Label_BillTotalRoundVisit.Caption:=FloatToStr(Query_Process.FieldByName('DRVTOTAL').AsFloat);
          Label_FractionTotalRoundVisit.Caption:=FloatToStr(Query_Process.FieldByName('FDFRACTIONAMOUNT').AsFloat);
     end;
end;


