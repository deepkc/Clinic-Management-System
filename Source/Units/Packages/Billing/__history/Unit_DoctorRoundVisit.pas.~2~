Procedure TForm_DoctorRoundVisit.ChangeIPMainDoc;
Begin
     Try
          DM_Hospital.Db.StartTransaction;
          With Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Update hs_inre_InpatientReg Set inre_DocId=' + inttostr(DBLCB_ActualDoc.KeyValue));
               sql.add(' where inre_InpatientId=' + IntToStr(pi_InpatientId));
               ExecSQL;

               Close;
               sql.Clear;
               sql.add(' Insert Into HS_LOG_CHANGEIPMAINDOC(DocChangeLogId,PrevDocid,CurrDocid,ModifyBy,ModifyDate,ModifyTime,');
               sql.add(' InpatientId,IsDocChangeFromParticularDate,DocChangeFromDate)');
               sql.add(' Values (' + IntToStr(GetMaxId('HS_LOG_CHANGEIPMAINDOC', 'DocChangeLogId')));
               sql.add(' ,' + inttostr(DBLCB_ExistingDoc.KeyValue) + ',' + inttostr(DBLCB_ActualDoc.KeyValue));
               sql.add(' ,' + IntToStr(gi_UserId) + ',' + #39 + ServerDate.TodaysDate + #39 + ',' + #39 + ServerDate.TodaysTime + #39);
               sql.add(' ,' + IntToStr(pi_InpatientId));
               IF CB_ChangeMainDocFromparticualDate.Checked = true Then
                    sql.add(' ,''Y'',' + #39 + DateEditX_DocChangeFrom.Text + #39 + ')')
               Else
                    sql.add(' ,''N'','''')');
               ExecSQL;

               IF (CB_ChangeDoc.Checked = true) and (CB_ChangeMainDocFromparticualDate.Checked = False) Then
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update Doctorroundvisit Set DocCode=' + inttostr(DBLCB_ActualDoc.KeyValue));
                    sql.add(' where InpatientId=' + IntToStr(pi_InpatientId) + ' and DocCode=' + inttostr(DBLCB_ExistingDoc.KeyValue));
                    ExecSQL;
               End;

               IF CB_ChangeMainDocFromparticualDate.Checked = true Then
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update DOCTORROUNDVISIT Set Docid=' +inttostr(DBLCB_ActualDoc.KeyValue));
                    sql.add(' where InpatientId=' + IntToStr(pi_InpatientId) + ' and DocCode=' +inttostr(DBLCB_ExistingDoc.KeyValue));
                    sql.add(' and VisitDate >=' + #39 + DateEditX_DocChangeFrom.Text + #39);
                    ExecSQL;
               End;
          End;
          DM_Hospital.Db.commit;
          ShowDoneMessage;
     Except
          DM_Hospital.Db.Rollback;
          MessageDlg('Failure To Change Main Doctor.', mtWarning, [mbok], 0);
          Exit;
     End;

     Query_DocService.Close;
     Query_DocService.Open;

     With Query_RoundChrgSummary do
     Begin
          Close;
          sql[6] := ' and InpatientId=' + IntToStr(pi_InpatientId);
          Open;
     End;
End;

