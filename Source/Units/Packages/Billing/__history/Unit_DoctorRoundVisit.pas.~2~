function TForm_DoctorRoundVisit.DivideRoundChrgForMultiDocNew: Boolean;
var
     ls_NoofDoctor:String;

begin
     ps_TodaysDate:=ServerDate.TodaysDate;
     ps_TodaysTime:=ServerDate.TodaysTime;

     ls_NoofDoctor:=IntToStr(Query_SharingList.Recordcount);

     With Query_Process do
     Begin
          Close;
