                    Query_RoundSharingDetail.FieldByName('BillType').AsString,Query_RoundSharingDetail.FieldByName('PayType').AsString,
                    'Y','IP CONSULTATION','N','N','',ps_TodaysDate,ps_TodaysTime,Query_RoundSharingDetail.FieldByName('IsRevSeparateHead').AsString);
          End;

          DM_Hospital.Db.Commit;
          Result:=True;
