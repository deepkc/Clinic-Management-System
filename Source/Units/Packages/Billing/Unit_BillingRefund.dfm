    object Query_BillList: TOraQuery
    SQL.Strings = (
            
              'Select BIDE_BillNo BillNo,BIDE_BillDate BillDate,BIDE_BillBy,Sum' +
              '(BIDE_Amount*BIDE_Qty) as Total,Sum(BIDE_VatAmt) as VatAmt,Sum(B' +
              'IDE_Amount*BIDE_Qty*BIDE_DisPer/100) as Discount,'
            
              'Sum((BIDE_Amount*BIDE_Qty)+BIDE_VatAmt-(BIDE_Amount*BIDE_Qty*BID' +
              'E_DisPer/100)) as NetTotal,'
            
              '(Select USMA_UserName From HS_USMA_UserMain Where USMA_UserId=BI' +
              'DE_BillBy) UserName'
            'From HS_BIDE_BillDetail'
            'where BIDE_PatientId=71000123'
            'Group By BIDE_BillNo,BIDE_BillDate,BIDE_BillBy'
            'Order by BIDE_BillNo Desc')
    Left = 616
    Top = 167
  end
object DS_BillList: TDataSource
    DataSet = Query_BillList
    Left = 646
    Top = 174
  end
    object Query_TestList: TOraQuery
    SQL.Strings = (
            
              'Select SEBD_BillNo BillNo,SEBD_BillDate BillDate,SEBD_PatientID ' +
              'PatientId,SEBD_Service,SEBD_ServiceType, '
            
              'SEBD_BillBy BillBy,(SEBD_Amount*SEBD_Qty) as Total,SEBD_VatAmt a' +
              's VatAmt,(SEBD_Amount*SEBD_Qty*SEBD_DisPer/100) as Discount,'
            
              '((SEBD_Amount*SEBD_Qty)+SEBD_VatAmt-(SEBD_Amount*SEBD_Qty*SEBD_D' +
              'isPer/100)) as NetTotal,'
            
              '(Select USMA_UserName From HS_USMA_UserMain Where USMA_UserId=SE' +
              'BD_BillBy) UserName'
            'From HS_SEBD_ServiceBillDetail'
            'where SEBD_PatientId=71001234 and SEBD_BillType='#39'IP'#39
            'Order by SEBD_BillNo Desc')
    Left = 696
    Top = 167
  end
