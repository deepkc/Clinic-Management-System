package Billing;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  dbrtl,
  vcldb,
  bdertl,
  VclSmp,
  Global,
  MidasFunction,
  SMCmpntD2010,
  vcldbx,
  BarcodeD10,
  MidasFxnFraction;

contains
  Unit_BillingParent in 'Unit_BillingParent.pas' {Form_BillingParent},
  Unit_BillListFrame in 'Unit_BillListFrame.pas' {Frame_BillList: TFrame},
  Unit_IndoorPatientList in 'Unit_IndoorPatientList.pas' {Frame_IndoorPatientList: TFrame},
  Unit_OutdoorPatientList in 'Unit_OutdoorPatientList.pas' {Frame_OutdoorPatientList: TFrame},
  Unit_QrBill_Manipal in 'Unit_QrBill_Manipal.pas' {Form_QRBill_Manipal},
  Unit_TestList in 'Unit_TestList.pas' {Form_Departmentlist},
  Unit_CustomerMonitor in 'Unit_CustomerMonitor.pas' {Form_CustomerMonitor},
  Unit_BillingFrame in 'Unit_BillingFrame.pas' {Frame_Billing: TFrame},
  Unit_Deposits in 'Unit_Deposits.pas' {Frame_Deposits: TFrame},
  Unit_BillDetail in 'Unit_BillDetail.pas' {Form_BillDetail},
  Unit_ServiceAcknowledge in 'Unit_ServiceAcknowledge.pas' {Form_ServiceAcknowledge},
  Unit_QrCommrefSlip_Manipal in 'Unit_QrCommrefSlip_Manipal.pas' {Form_QrCommRefSlip_Manipal},
  Unit_ServiceDetail in 'Unit_ServiceDetail.pas' {Form_ServiceDetail},
  Unit_CashTransferToVault in '..\Reports\Revenue Report\Unit_CashTransferToVault.pas' {Form_CashTransferToVault},
  Unit_QRDischargeBill_Manipal in 'Unit_QRDischargeBill_Manipal.pas' {Form_QRDischargeBill_Manipal},
  Unit_DepositDayClose in 'Unit_DepositDayClose.pas' {Form_DepositDayClose},
  Unit_PharmacyDisPer in 'Unit_PharmacyDisPer.pas' {Form_SetPharmacyDisPer},
  Unit_IndoorPatientScheme in 'Unit_IndoorPatientScheme.pas' {Form_IndoorPatientScheme},
  Unit_DrInvolveInOperation in 'Unit_DrInvolveInOperation.pas' {Form_DrInvolveInOperation},
  Unit_SelectDoctor in 'Unit_SelectDoctor.pas' {Form_SelectDoctor},
  Unit_QrBill in 'Unit_QrBill.pas' {Form_QRBill},
  Unit_QRDischargeBill in 'Unit_QRDischargeBill.pas' {Form_QRDischargeBill},
  Unit_otherpatient in 'Unit_otherpatient.pas' {Form_otherPatient},
  Unit_QrSticker in 'Unit_QrSticker.pas' {Form_Sticker},
  Unit_CommunityRefund in 'Unit_CommunityRefund.pas' {Form_CommunityRefund},
  Unit_QrDepositSlip_Manipal in 'Unit_QrDepositSlip_Manipal.pas' {Form_QrDepositSlip_Manipal};

end.


