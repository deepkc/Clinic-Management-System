  object DS_List: TDataSource
    DataSet = Query_List
    Left = 813
    Top = 200
  end
    object Query_List: TOraQuery
    FilterOptions = [foCaseInsensitive]
    SQL.Strings = (
            
              'Select (Select USMA_UserName from HS_USMA_UserMain Where USMA_Us' +
              'erID=Sbd.SEBD_BillBy)UserName ,'
            
              '(Select Max(TestProgressStatus) From PatientTest Where servicebi' +
              'lldetailid=Sbd.SEBD_servicebilldetailid)TestProgressStatus ,'
            
              '(Select BIDE_Billno From HS_BIDE_BillDetail Where BIDE_BillDetai' +
              'lID=SBD.SEBD_BillDetailID)FinalBillNo  ,'
            
              'Sbd.* from HS_SEBD_ServiceBillDetail Sbd Where SEBD_Patientid=14' +
              '000017 And SEBD_Service<>'#39'REG'#39' And '
            
              'SEBD_BillDate Between '#39'2014/07/14'#39' And '#39'2014/07/14'#39' And SEBD_Ser' +
              'viceBillDetailId not in ('
            
              'Select TECA_ServiceBillDetailId From HS_TECA_TestCancel) Order b' +
              'y SEBD_ServiceBillDetailID   ')
    Left = 777
    Top = 200
  end
end
