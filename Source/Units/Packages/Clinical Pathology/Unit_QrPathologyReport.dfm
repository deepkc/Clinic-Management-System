    object Query1: TOraQuery
    SQL.Strings = (
            
              'select pm.patientid,pm.patientname,pm.gender,PM.ADDRESS,PM.AGE||' +
              #39'-'#39'||substr(PM.AGETYPE,0,1) as age,pm.phoneno,'
            'Ipr.inpatientId,Ipr.admndate,Ipr.disdate,0 as TotalDaysOfStay,'
            '(select docname from doctor where docid=IPR.DOCID)doctor,'
            '(select wardname from ward where wardcode=Ipr.wardcode)ward'
            'from patientmain pm,InpatientReg Ipr'
            'where Ipr.patientid=pm.patientid'
            'and 1=1'
            'order by patientId')
    Left = 40
    Top = 72
  end
