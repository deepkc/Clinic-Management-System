    Left = 600
    Top = 376
  end
  object Query_Listing: TOraQuery
    SQL.Strings = (
      
        'select ts.*,td.* from clinical_testSetup ts,clinical_testSetupDe' +
        'tail td'
      'where TS.CLINICAL_TESTSETUPID=TD.CLINICAL_TESTSETUPID(+)'
      'and 1=1'
      'Order by DisplayOrder')
    Left = 647
    Top = 59
  end
