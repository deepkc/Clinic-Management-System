  object Query_TestName: TOraQuery
    SQL.Strings = (
      'Select * From Hs_Tena_TestName'
      'Where Tena_DepId in'
      
        '(Select Dept_DepId From Hs_Dept_Department Where Dept_Extended_R' +
        'eport='#39'Y'#39')'
      'Order by Tena_TestName')
    Left = 645
    Top = 105
  end
