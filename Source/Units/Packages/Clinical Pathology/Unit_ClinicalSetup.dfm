  object Query_Report: TOraQuery
    SQL.Strings = (
      'select * from clinical_reporttype'
      'where testnameid=:id')
    Left = 616
    Top = 328
    ParamData = <
      item
        DataType = ftUnknown
        Name = 'id'
      end>
  end
  object Query_FindingTitle: TOraQuery
    SQL.Strings = (
