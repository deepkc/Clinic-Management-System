  object Query_testname: TOraQuery
    SQL.Strings = (
      'select testname,testnameid from DHULIKHEL.testname'
      
        'Where DepId in (Select DepId from DHULIKHEL.Department Where Ext' +
        'ended_Report='#39'Y'#39')'
      'order by testnameid')
    Left = 136
    Top = 128
  end
  object Query_Listing: TOraQuery
    SQL.Strings = (
      
        'select rt.isactive,ts.testnameid,ts.testname,rt.reporttype,rt.re' +
        'porttypeid from dhulikhel.testname ts,dhulikhelLab.clinical_repo' +
        'rttype rt'
      'where TS.TESTNAMEID=RT.TESTNAMEID')
    Left = 304
    Top = 272
  end
  object DS_TestName: TDataSource
    DataSet = Query_testname
    Left = 288
    Top = 176
  end
  object DS_Listing: TDataSource
    DataSet = Query_Listing
    Left = 200
    Top = 216
  end
  object Query_Blank: TOraQuery
    SQL.Strings = (
      
        'select ts.testname,rt.reporttype,rt.reporttypeid from Manipal.te' +
        'stname ts,ManipalLab.clinical_reporttype rt'
      'where TS.TESTNAMEID=RT.TESTNAMEID')
    Left = 368
    Top = 296
  end
