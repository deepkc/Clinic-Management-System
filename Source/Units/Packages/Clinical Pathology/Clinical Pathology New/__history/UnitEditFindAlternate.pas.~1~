          With Sql Do
          Begin
               Clear;
               Add('Select  TestSpecialID From PatientTestSpecial');
               Add(' Where EditFindingID='+QueryFind.FieldByName('EDITFINDINGID').AsString);
               Add(' Order By TestSpecialID');
          End;
          Open;
          Last;
          If Trim(FieldbyName('TestSpecialID').AsString)<>'' Then
          Begin
               MessageDlg('Sorry You Can''t Delete, It Has Been Used.',mtInformation,[MbOk],0);
