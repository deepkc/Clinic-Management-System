procedure TFormEditFindAlternate.SpeedButton3Click(Sender: TObject);
Var  Qry:TQuery;
     Title,Finding:Integer;
begin
     CreateTempTable;
     Qry:=TQuery.Create(Nil);
     With Qry Do
     Begin
          Close;
          DataBaseName:='Hospital';
          With Sql Do
          Begin
               Clear;
               Add('Select TEF.*,(Select TestName From TestName Where TestNameID=TEF.TestNameID) TestName From TestEditFinding TEF Order By EditFindingID');
          End;
          Open;
          Table1.Open;
          Table2.Open;
          While Not Eof Do
          Begin
               Table1.Append;
               Table1.FieldByName('EditFindingId').AsInteger:=FieldByName('EditFindingId').AsInteger;
               Table1.FieldByName('TestName').AsString:=FieldByName('TestName').AsString;
               Table1.FieldByName('ReportTitle').AsString:=FieldByName('Description').AsString;
               For Title:=4 To 19 Do
               Begin
                    If Trim(Fields[Title].AsString)<>'' Then
                    Begin
                         Table2.Append;
                         Table2.FieldByName('EditFindingId').AsInteger:=FieldByName('EditFindingId').AsInteger;
                         Table2.Fields[1].AsString:=Fields[Title].AsString;
                         Table2.Fields[2].AsString:=Fields[Title+16].AsString;
                         Table2.Post;
                    End
                    Else
                    Begin
                         Break
                    End;
               End;
               Table1.Post;
               Next;
          End;
          Close;
          Free;
     End;
          {
     With FormEditAlternatePreview Do
     Begin
          Try
               FormEditAlternatePreview:=TFormEditAlternatePreview.Create(Nil);
               With QryMain Do
               Begin
                    Close;
                    DataBaseName:=gs_TempPath;
                    Open;
               End;

               With QrySub Do
               Begin
                    Close;
                    DataBaseName:=gs_TempPath;
                    Open;
               End;
               QuickRep1.Preview;

          Finally
               Free;
          End;
     End;}
end;

