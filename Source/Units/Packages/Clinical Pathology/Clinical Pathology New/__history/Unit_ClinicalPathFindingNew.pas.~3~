procedure TFrame_ClinicalPathFindingNew.RetriveSpeCial;
Begin
     With QuerySpecial Do
     Begin
          Close;
          Session:=DM_Hospital.DB;
          sql.Clear;
          IF CheckSpecial=True Then
          Begin
               sql.Add('Select * From PatientTestSpecial_NEW');
               sql.Add('Where(PatientID=:PatientID)And');
               sql.Add('(PatientTestID=:PatientTestID)');
               ParamByName('PatientID').AsInteger:=gi_PatientID;
               ParamByName('PatientTestID').AsInteger:=gi_PatientTestID;
               Open;
          End
          Else
          Begin
               sql.Add('Select * From TestEditFinding_NEW');
               sql.Add('Where(TestNameID=:TestNameID)');
               sql.Add('AND DEFFIND='+Chr(39)+'T'+Chr(39));
               ParamByName('TestNameID').AsInteger:=gi_TestNameId;
               Open;
          End;
     End;
End;


