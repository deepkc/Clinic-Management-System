package ClinicalPathology;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  Global,
  MidasFunction,
  VclSmp;

contains
  Unit_ClinicalPathDep in 'Unit_ClinicalPathDep.pas' {Form_ExtendedReportDep},
  Unit_ClinicalPathFinding in 'Unit_ClinicalPathFinding.pas' {Frame2: TFrame},
  Unit_ClinicalPathSetup in 'Unit_ClinicalPathSetup.pas' {Form2},
  Unit_ClinicalSetup in 'Unit_ClinicalSetup.pas' {Form_ClinicalTest},
  Unit_ClinicalFindingSetUp in 'Unit_ClinicalFindingSetUp.pas' {Form_FindingSetup},
  Unit_ClinicalReportType in 'Unit_ClinicalReportType.pas' {Form_ReportType};

end.
