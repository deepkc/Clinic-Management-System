  object DSSample: TDataSource
    DataSet = QryAniD
    Left = 208
    Top = 160
  end
  object QryAniD: TOraQuery
    SQL.Strings = (
      
        'select rownum as Sno,(select case when undostatus=1 then '#39#39' else' +
        ' sampleNo end as sampleNo from samplecollection where patienttes' +
        'tid=pt.patienttestid)sampleID,'
      
        'pt.patientid,pt.testdate,pt.testprogressstatus,pm.patientname,(s' +
        'elect testname from testname where testnamecode=pt.testnamecode)' +
        'testname from patienttest pt,patientmain pm '
      'where pt.patientid=pm.patientid '
      'and pt.testprogressstatus<4 '
      'and 1=1'
      'and 1=1')
    Left = 424
    Top = 168
  end
