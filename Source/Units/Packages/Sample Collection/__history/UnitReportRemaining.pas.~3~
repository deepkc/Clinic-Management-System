procedure TFormReportRemaining.BitBtnRefreshClick(Sender: TObject);
Var  PatientID,I:Integer;
begin
     If DateEditXFromDate.Text>DateEditXToDate.Text Then
     Begin
          If MessageDlg('Invalid Date Range.',mtConfirmation,[mbYes,mbNo],0)=mrNo Then
          DateEditXToDate.SetFocus;
          Exit;
     End;

     With QryAniD Do
     Begin
          Close;
          Session:=DM_Hospital.DB;
          sql.Clear;
          sql.Add('select rownum as Sno,(select case when undostatus=1 then '''' else sampleNo end as sampleNo from samplecollection where patienttestid=pt.patienttestid)sampleID,');

          if gi_compileValue<>3 then
              sql.Add('pt.patientid,pt.testdate,pt.testprogressstatus,pm.pama_patientname,(select tena_testname from hs_tena_testname where tena_testnamecode=pt.testnamecode)testname from patienttest pt,hs_pama_patientmain pm')
          else
              sql.Add('pt.patientid,pt.testdate,pt.testprogressstatus,pm.patientname,(select tena_testname from hs_tena_testname where tena_testnamecode=pt.testnamecode)testname from patienttest pt,hs_pama_patientmain pm');

          sql.Add('where pt.patientid=pm.pama_patientid');
          sql.Add('and pt.testprogressstatus<4');
          sql.Add('and 1=1');
          sql.Add('and 1=1');
          sql[4]:='and pt.testdate between '+QuotedStr(DateEditXFromDate.text)+' and '+QuotedStr(DateEditXToDate.text);
          sql[5]:=' and pt.depid in ('+gs_UserDepId+')';
          sql.SaveToFile('c:\reportRemaining.txt');
          open;
     End;





end;

