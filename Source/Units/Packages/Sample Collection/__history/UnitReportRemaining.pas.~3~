procedure TFormReportRemaining.btn_previewClick(Sender: TObject);
begin
    try
      Form_QRreportremaining:=TForm_QRreportremaining.Create(nil);
      with Form_QRreportremaining do
      begin
        qrlbl_DaFrom.Caption:=DateEditXFromDate.text;
        qrlbl_DaTo.Caption:=DateEditXToDate.text;
        qrlbl_hosname.Caption:=gs_HospitalName;
        qrlbl_hosaddress.Caption:=gs_HospitalAddress;
        with orqry_data do
        begin
          Close;
          Session:=DM_Hospital.DB;
          if Rg_Status.ItemIndex=0 then
          begin
             SQL[4]:='and testprogressstatus=3';
             sql[5]:='and pt.testdate between '+QuotedStr(DateEditXFromDate.text)+' and '+QuotedStr(DateEditXToDate.text);
             sql[6]:=' and pt.depid in ('+gs_UserDepId+')';
          end
          else if Rg_Status.ItemIndex=1 then
          begin
             SQL[4]:='and testprogressstatus<=2';
             sql[5]:='and pt.testdate between '+QuotedStr(DateEditXFromDate.text)+' and '+QuotedStr(DateEditXToDate.text);
             sql[6]:=' and pt.depid in ('+gs_UserDepId+')';
          end
          else
          begin
             SQL[4]:='and 1=1';
             sql[5]:='and pt.testdate between '+QuotedStr(DateEditXFromDate.text)+' and '+QuotedStr(DateEditXToDate.text);
             sql[6]:=' and pt.depid in ('+gs_UserDepId+')';
          end;
          //sql.SaveToFile('c:\qr.txt');
          Open;
        end;

        Form_QRreportremaining.QR_RptRemg.PreviewModal;
      end;
    finally
      Form_QRreportremaining.Free;
    end;
end;

procedure TFormReportRemaining.GetMeOtherParameters(SampleID:Integer);
Var BillNo,S_DateStr,E_DateStr:String;
    S_Date,E_Date:Integer;
begin
    { S_Date:=StrToInt(Copy(gs_FYear,1,2));
     E_Date:=StrToInt(Copy(gs_FYear,4,2));

     S_DateStr:=Copy(DateEditXFromDate.Text,1,2)+IntToStr(S_Date)+'/04/01';
     E_DateStr:=Copy(DateEditXFromDate.Text,1,2)+IntToStr(E_Date)+'/03/32';

     BillNo:=Chr(39);
     With QryProcess Do
     Begin
          Close;
          With Sql Do
          Begin
               Clear;
               Add('Select Distinct BillNo From PatientTest');
               Add(' Where SampleID='+IntToStr(SampleID));
               Add(' And TestDate Between'+#39+S_DateStr+#39);
               Add(' And '+#39+E_DateStr+#39);
          End;
          Open;
          First;
          ps_BillNo:=FieldByName('BillNo').AsString;
          While Not Eof Do
          Begin
               BillNo:=BillNo+Chr(39)+FieldByName('BillNo').AsString+Chr(39)+',';
               Next;
          End;
          BillNo:=Copy(BillNo,2,Length(BillNo)-2);

          Close;
          With Sql Do
          Begin
               Clear;
               Add('Select Count(PT.TestNameCode) No From PatientTest PT,TestName TN');
               Add(' Where (PT.TestNameID = TN.TestNameID(+)) AND');
               Add(' PT.BillNo In('+BillNo+')');
               //Add(' And TN.LineEdit='+Chr(39)+ls_ReportType+Chr(39));
               Add(' And TN.LineEdit=''T''');
               Add(' And TestDate Between'+#39+S_DateStr+#39);
               Add(' And '+#39+E_DateStr+#39);
               //SaveToFile('Sql.txt');
          End;
          Open;
          pi_No:=FieldByName('No').AsInteger;

          Close;
          With Sql Do
          Begin
               Clear;
               Add('Select Count(PT.TestNameCode) No From PatientTest PT,TestName TN');
               Add(' Where (PT.TestNameID = TN.TestNameID(+)) AND');
               //Add(' PT.BillNo In('+Chr(39)+BillNo+Chr(39)+')');
               Add(' PT.SampleID='+IntToStr(SampleID));
               //Add(' And TN.LineEdit='+Chr(39)+ls_ReportType+Chr(39));
               Add(' And TN.LineEdit=''T''');
               Add(' And PT.WorkingStatus Not In (''REG'',''InPatient'')');
               Add(' And TestDate Between'+#39+S_DateStr+#39);
               Add(' And '+#39+E_DateStr+#39);
          End;
          Open;
          pi_Report:=FieldByName('No').AsInteger;

          Close;
          With Sql Do
          Begin
               Clear;
               Add('SELECT PT.SampleID,PT.TestNameCode,Nls_InitCap(TN.TestName) As TestName');
               Add(' FROM PatientTest PT,Testname TN');
               Add(' WHERE  (PT.TestNameID = TN.TestNameID(+)) AND');
               Add(' PT.BillNo In('+BillNo+')');
               //Add(' And TN.LineEdit='+Chr(39)+ls_ReportType+Chr(39));
               Add(' And TN.LineEdit=''T''');
               Add(' And PT.WorkingStatus In (''REG'',''InPatient'')');
               Add(' And PT.SampleID>0');
               Add(' And TestDate Between'+#39+S_DateStr+#39);
               Add(' And '+#39+E_DateStr+#39);
               //SaveToFile('Sql.txt');
          End;
          Open;
          First;
          ps_Remaining:='';
          While Not Eof Do
          Begin
               ps_Remaining:=ps_Remaining+FieldByName('TestName').AsString+',';
               Next;
          End;
          ps_Remaining:=Copy(ps_Remaining,0,Length(ps_Remaining)-1);
     End; }
end;

