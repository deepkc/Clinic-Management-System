procedure TForm_VirtualMenuPrevilage.createtemptable;
begin
  if FileExists(gs_temppath+'\'+'tbl_previlage.db') then
  begin
       DeleteFile(gs_temppath+'\'+'tbl_previlage.db');
  end;
  with Table_Previlage do
  begin
    Close;
    DatabaseName := gs_temppath;
    TableType := ttdefault;
    TableName := 'tbl_previlage.db';
    FieldDefs.Clear;
    FieldDefs.Add('id', ftinteger);
    FieldDefs.Add('userid', ftinteger);
    FieldDefs.Add('nodetext', ftString, 50);
    FieldDefs.Add('caption', ftString, 50);
    FieldDefs.Add('accesstype', ftString, 50);
    FieldDefs.Add('cstate', ftString, 1);
    IndexDefs.Clear;
    CreateTable;
  end;
end;

