type
 PNodeData2 = ^TNodeData2;
 TNodeData2 = record
    Caption:string;
    id,
    Level: Integer;
    cstate,
    accesstype,
    nodetext:string;
  end;
  Tmenuid=record
  moduleid,menuid,submenuid :integer;
  end;
function getmenuid(id:integer; accesstype:string):Tmenuid;
var qry:TOraQuery;
begin
     qry:=TOraQuery.Create(nil);
    if accesstype='MODULE' then
    begin
         result.moduleid:=id;
         Result.menuid:=0;
         result.submenuid:=0;
    end
    else if accesstype='SUBMENU' then
    begin
           with qry do
           begin
                Close;
                sql.Clear;
                databasename:=gs_databasename;
                SQL.Add('select sume_submenuid,sume_mainmenuid,mame_moduleid from hs_sume_submenu ,hs_mame_mainmenu');
                sql.Add('where sume_mainmenuid=mame_mainmenuid and sume_submenuid='+inttostr(id));
                Open;
           end;
          result.moduleid:=qry.FieldByName('mame_moduleid').AsInteger;
          Result.menuid:=qry.FieldByName('sume_mainmenuid').AsInteger;
          result.submenuid:=id;
    end
    else if accesstype='MAINMENU' then
    begin
           with qry do
           begin
                Close;
                sql.Clear;
                databasename:=gs_databasename;
                SQL.Add('select mame_mainmenuid,mame_moduleid from hs_mame_mainmenu ');
                sql.Add('where mame_mainmenuid='+inttostr(id));
                Open;
           end;
          result.moduleid:=qry.FieldByName('mame_moduleid').AsInteger;
          Result.menuid:=id;
          result.submenuid:=0;
    end;
    qry.Free;

end;


