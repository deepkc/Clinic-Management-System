procedure TForm_SalesBook.BitBtnPreviewClick(Sender: TObject);
var
     New_Query: TOraQuery;
     i: Integer;
     ReportForm: TForm;
     ls_ReportTitle,Ls_particulars: String;
     lf_Tot: Double;
begin
     // IF CheckProperDateRange(DateEditX_FromDate,DateEditX_ToDate)=False Then
     // Begin
     // MessageDlg('Incorrect Date ! '+Char(10)+Char(10)+'       Clue -> Either From Date or To Date.',mtWarning,[mbok],0);
     // Exit;
     // End;
     DateEditX_FromDate.SystemOfDate := gi_datesystem;
     DateEditX_ToDate.SystemOfDate := gi_datesystem;
     BitBtn_FromDate.Caption := gs_DateCaption;
     BitBtn_ToDate.Caption := gs_DateCaption;
     gs_From := DateEditX_FromDate.text;
     gs_to := DateEditX_ToDate.text;
     //DateEditX_FromDate.SystemOfDate := 0;
     //DateEditX_ToDate.SystemOfDate := 0;
     //BitBtn_FromDate.Caption := 'BS';
     //BitBtn_ToDate.Caption := 'BS';
     if CHKB_KPL.Checked then
     Begin
          CreateTempTableKPL;
          with Table_SalesBookKpl do
          Begin
               close;
               DatabaseName:=gs_temppath;
               EmptyTable;
               Open;
          End;

          With Query_Process do
          Begin
               close;
               Session:=DM_Hospital.DB;
               sql.Clear;
               Sql.Add('Select Rownum as sn,a.* from (');
               sql.Add('Select BIDE_BILLNO billno,(Select BSDATE from NEPALIEQUIVALENTENGLISHDATE where ADDATE=BD.BIDE_billdate)nepalibilldate,');
               sql.Add('BIDE_BILLDATE billdate,BIDE_PATIENTID patientid,(select PAMA_fname||'' ''||PAMA_Lname from HS_PAMA_patientmain where PAMA_patientid=BD.BIDE_patientid)patientname');
               sql.Add(',(select COMM_COMMUNITY from HS_COMM_COMMUNITY where COMM_COMMUNITYid=BD.BIDE_communityid)community,');
               sql.Add('(select SCHE_SCHEME from HS_SCHE_scheme where SCHE_schemeid=BD.BIDE_schemeid)scheme,');
               sql.Add('BIDE_paytype PAYTYPE,BIDE_disper DISPER,sum(BIDE_amount*BIDE_qty*BIDE_disper/100)discount,sum(BIDE_amount*BIDE_qty)subtotal,sum(BIDE_vatamt*BIDE_qty)Tax,');
               sql.Add('sum((BIDE_amount*BIDE_qty-BIDE_amount*BIDE_qty*BIDE_disper/100)+BIDE_vatamt*BIDE_qty)grandtotal,(select redo_DOCNAME from HS_redo_referaldoctor where redo_docid in (select refdocid from patienttest where billno=BD.bide_billno and rownum=1))ReferBy,');
               sql.Add('(select username from LAB_USERMAIN where userid=BD.BIDE_BILLBY)entryby,');
               sql.Add('case when BIDE_paytype=''CASH'' then ''Y'' when BIDE_paytype=''CREDIT'' then nvl(BIDE_iscrpaid,''N'') end ISCRPAID,');
               SQL.Add('NVL((Select sum(CRPM_RECEIPTDISCOUNT) from HS_CRPM_CREDITPAYMENTMASTER where CRPM_CRBILLNODETAIL=BD.BIDE_BillNo and BIDE_billno like ''CP%''),0)receiptdiscount');
               sql.Add('from HS_BIDE_billdetail BD');
               sql.Add('where BIDE_billdate between '+Quotedstr(gs_From)+' and '+Quotedstr(gs_to));
               if rg.ItemIndex = 0 then
               sql.Add('and BIDE_paytype=''CASH''')
               else if rg.ItemIndex = 1 then
               sql.Add('and BIDE_paytype=''CREDIT''');
               sql.Add('group by BIDE_billno,BIDE_billdate,BIDE_patientid,BIDE_communityid,BIDE_schemeid,BIDE_paytype,BIDE_billby,BIDE_disper,BIDE_REFDOCCODE,BIDE_iscrpaid');
               sql.Add('order by BIDE_billdate');
               sql.Add(')a');
              // sql.SaveToFile('C:\check.txt');
               Open;
          End;
          Query_Process.First;
          while not Query_Process.Eof do
          Begin
               Ls_particulars:='';
               Table_SalesBookKpl.Append;
               Table_SalesBookKpl.FieldByName('Sno').AsInteger:=Query_Process.FieldByName('Sn').AsInteger;
               Table_SalesBookKpl.FieldByName('LabNo').AsInteger:=Query_Process.FieldByName('patientid').AsInteger;
               Table_SalesBookKpl.FieldByName('BillNo').AsString:=Query_Process.FieldByName('Billno').AsString;
               Table_SalesBookKpl.FieldByName('Nepalibilldate').AsString:=Query_Process.FieldByName('nepalibilldate').AsString;
               Table_SalesBookKpl.FieldByName('BillDate').AsString:=Query_Process.FieldByName('BillDate').AsString;
               Table_SalesBookKpl.FieldByName('PatientName').AsString:=Query_Process.FieldByName('patientname').AsString;
               Table_SalesBookKpl.FieldByName('Paytype').AsString:=Query_Process.FieldByName('Paytype').AsString;
               Table_SalesBookKpl.FieldByName('Scheme').AsString:=Query_Process.FieldByName('Scheme').AsString;
               Table_SalesBookKpl.FieldByName('Community').AsString:=Query_Process.FieldByName('Community').AsString;
               Table_SalesBookKpl.FieldByName('EntryBy').AsString:=Query_Process.FieldByName('EntryBy').AsString;
               Table_SalesBookKpl.FieldByName('ReferedBy').AsString:=Query_Process.FieldByName('ReferBy').AsString;
               Table_SalesBookKpl.FieldByName('SubTotal').AsFloat:=Query_Process.FieldByName('SubTotal').AsFloat;
               Table_SalesBookKpl.FieldByName('Disper').AsFloat:=Query_Process.FieldByName('disper').AsFloat;
               Table_SalesBookKpl.FieldByName('Discount').AsFloat:=Query_Process.FieldByName('Discount').AsFloat;
               Table_SalesBookKpl.FieldByName('Tax').AsFloat:=Query_Process.FieldByName('Tax').AsFloat;
               Table_SalesBookKpl.FieldByName('ReceiptDis').AsFloat:=Query_Process.FieldByName('receiptdiscount').AsFloat;
               Table_SalesBookKpl.FieldByName('NetAmount').AsFloat:=Query_Process.FieldByName('grandtotal').AsFloat;
               Table_SalesBookKpl.FieldByName('Billtype').AsString:='CASH';
               Table_SalesBookKpl.FieldByName('IsCreditPaid').AsString:=Query_Process.FieldByName('iscrpaid').AsString;
               With Query_Subprocess do
               Begin
                    close;
                    Sql.Clear;
                    Session:=DM_Hospital.DB;
                    sql.Add('Select BIDE_service SERVICE,BIDE_servicetype SERVICETYPE,BIDE_disper DISPER from HS_BIDE_billdetail');
                    sql.Add('Where BIDE_billno='+quotedstr(Query_Process.FieldByName('Billno').AsString));
                    sql.Add(' and BIDE_disper='+Query_Process.FieldByName('disper').AsString);
                    Open;
                    First;
                    while not eof  do
                    Begin
                         {if Ls_particulars='' then
                              Ls_particulars:= Query_Subprocess.FieldByName('Servicetype').AsString
                                                  +'('+Query_Subprocess.FieldByName('disper').AsString+'%)'
                         Else
                              Ls_particulars:=Ls_particulars+','+Query_Subprocess.FieldByName('Servicetype').AsString
                                             +'('+Query_Subprocess.FieldByName('disper').AsString+'%)'; }
                         if Ls_particulars='' then
                              Ls_particulars:= Query_Subprocess.FieldByName('Servicetype').AsString
                         Else
                              Ls_particulars:=Ls_particulars+','+Query_Subprocess.FieldByName('Servicetype').AsString;
                         Next;
                    End;
               End;
               Table_SalesBookKpl.FieldByName('Particulars').AsString:=Ls_particulars;
               Table_SalesBookKpl.Post;
               Query_Process.Next;
          End;

          with Query_Process do
          Begin
               close;
               Session:=DM_Hospital.DB;
               sql.Clear;
               Sql.Add('Select Rownum as sn,a.* from (');
               sql.Add('Select REDE_Refundbillno REFUNDBILLNO,(Select BSDATE from NEPALIEQUIVALENTENGLISHDATE where ADDATE=rd.REDE_REFUNDDATE)nepalibilldate,');
               sql.Add('REDE_REFUNDDATE as billdate,REDE_patientid PATIENTID,(select PAMA_fname||'' ''||PAMA_Lname from HS_PAMA_patientmain where PAMA_patientid=RD.REDE_patientid)patientname');
               sql.Add(',(select COMM_COMMUNITY from HS_COMM_COMMUNITY where COMM_COMMUNITYid=RD.REDE_communityid)community,');
               sql.Add('(select SCHE_SCHEME from HS_SCHE_scheme where SCHE_schemeid=RD.REDE_schemeid)scheme,');
               sql.Add('REDE_paytype PAYTYPE,REDE_disper DISPER,sum(REDE_amount*REDE_qty*REDE_disper/100)discount,sum(REDE_amount*REDE_qty)subtotal,sum(REDE_vatamt*REDE_qty)Tax,');
               sql.Add('sum((REDE_amount*REDE_qty-REDE_amount*REDE_qty*REDE_disper/100)+REDE_vatamt*REDE_qty)grandtotal,(select redo_DOCNAME from HS_redo_referaldoctor where redo_docid=RD.REDE_REFDOCID)ReferBy,');
               sql.Add('(select username from LAB_USERMAIN where userid=RD.REDE_REFUNDBY)entryby from HS_REDE_refunddetail RD');
               sql.Add('where REDE_REFUNDDATE between '+Quotedstr(gs_From)+' and '+Quotedstr(gs_to));
               sql.Add('group by REDE_RefundBillno,REDE_REFUNDDATE,REDE_patientid,REDE_communityid,REDE_schemeid,REDE_paytype,REDE_disper,REDE_REFUNDBY,REDE_REFDOCID');
               sql.Add('order by REDE_REFUNDDATE');
               sql.Add(')a');
              // sql.savetofile('C:\33t.txt');
               Open;
          End;
          Query_Process.First;
          while not Query_Process.Eof do
          Begin
               Ls_particulars:='';
               Table_SalesBookKpl.Append;
               Table_SalesBookKpl.FieldByName('Sno').AsInteger:=Query_Process.FieldByName('Sn').AsInteger;
               Table_SalesBookKpl.FieldByName('LabNo').AsInteger:=Query_Process.FieldByName('patientid').AsInteger;
               Table_SalesBookKpl.FieldByName('BillNo').AsString:=Query_Process.FieldByName('REFUNDBILLNO').AsString;
               Table_SalesBookKpl.FieldByName('Nepalibilldate').AsString:=Query_Process.FieldByName('nepalibilldate').AsString;
               Table_SalesBookKpl.FieldByName('BillDate').AsString:=Query_Process.FieldByName('BillDate').AsString;
               Table_SalesBookKpl.FieldByName('PatientName').AsString:=Query_Process.FieldByName('patientname').AsString;
               Table_SalesBookKpl.FieldByName('Paytype').AsString:=Query_Process.FieldByName('Paytype').AsString;
               Table_SalesBookKpl.FieldByName('Scheme').AsString:=Query_Process.FieldByName('Scheme').AsString;
               Table_SalesBookKpl.FieldByName('Community').AsString:=Query_Process.FieldByName('Community').AsString;
               Table_SalesBookKpl.FieldByName('EntryBy').AsString:=Query_Process.FieldByName('EntryBy').AsString;
               Table_SalesBookKpl.FieldByName('ReferedBy').AsString:=Query_Process.FieldByName('ReferBy').AsString;
               Table_SalesBookKpl.FieldByName('SubTotal').AsFloat:=Query_Process.FieldByName('SubTotal').AsFloat;
               Table_SalesBookKpl.FieldByName('Disper').AsFloat:=Query_Process.FieldByName('disper').AsFloat;
               Table_SalesBookKpl.FieldByName('Discount').AsFloat:=Query_Process.FieldByName('Discount').AsFloat;
               Table_SalesBookKpl.FieldByName('Tax').AsFloat:=Query_Process.FieldByName('Tax').AsFloat;
               Table_SalesBookKpl.FieldByName('NetAmount').AsFloat:=Query_Process.FieldByName('grandtotal').AsFloat;
               Table_SalesBookKpl.FieldByName('Billtype').AsString:='REFUND';
               With Query_Subprocess do
               Begin
                    close;
                    Sql.Clear;
                    Session:=DM_Hospital.DB;
                    sql.Add('Select (Select BIDE_billno from HS_BIDE_billdetail where BIDE_billdetailid=RD.rede_BILLDETAILID)refundbill,');
                    sql.Add('rede_servicetype SERVICETYPE,rede_DISPER DISPER from HS_REDE_refunddetail rd ');
                    sql.Add('Where REDE_RefundBillno='+quotedstr(Query_Process.FieldByName('REFUNDBILLNO').AsString));
                    sql.Add(' and REDE_DISPER='+Query_Process.FieldByName('disper').AsString);
                  //  sql.savetofile('c:\abc55.txt');
                    Open;
                    First;
                    while not eof  do
                    Begin
                         if Ls_particulars='' then
                              Ls_particulars:= Query_Subprocess.FieldByName('Servicetype').AsString
                         Else
                              Ls_particulars:=Ls_particulars+','+Query_Subprocess.FieldByName('Servicetype').AsString;
                         Next;
                    End;
               End;
               Table_SalesBookKpl.FieldByName('RefBillno').AsString:=Query_Subprocess.FieldByName('refundbill').AsString;
               Table_SalesBookKpl.FieldByName('Particulars').AsString:=Ls_particulars;
               Table_SalesBookKpl.Post;
               Query_Process.Next;
          End;
          With Query_cashsales do
          Begin
               close;
               sql.Clear;
               DatabaseName:=gs_temppath;
               //sql.Add('select Sno,BillNo,nepalibilldate,billdate,LabNo,patientName,paytype,particulars,subtotal,Disper,subtotal-discount as nettotal,tax,ReceiptDis,');
               sql.Add('select Sno,BillNo,nepalibilldate,billdate,LabNo,patientName,paytype,particulars,subtotal,Disper,subtotal-discount as nettotal,tax,');
               sql.Add('NetAmount-ReceiptDis as grandtotal,scheme,community,ReferedBy,entryby,IsCreditPaid from SalesBookKpl.db ');
               sql.Add('Where Billtype=''CASH''');
               Open;
          End;
          With Query_SalesRefund Do
          Begin
               close;
               sql.Clear;
               DatabaseName:=gs_temppath;
               sql.Add('select Sno,billno,nepalibilldate,billdate,LabNo,patientName,paytype,particulars,subtotal,Discount,tax,');
               sql.Add('NetAmount as grandtotal,scheme,community,ReferedBy,entryby,RefBillno as RefundBillno from SalesBookKpl.db ');
               sql.Add('Where Billtype=''REFUND''');
               Open;
          End;

          SendToExcelsMultiQuerykpl(Query_cashsales,Query_SalesRefund,nil,nil,nil,nil,'SALES BOOK','REFUND','','','','',
               Serverdate.TodaysDate,'',gs_hospitalname,gs_hospitaladdress, 2, 10);
          Exit;
     End;

     Govt_Service_Tax_Report_Medicare;

end;

