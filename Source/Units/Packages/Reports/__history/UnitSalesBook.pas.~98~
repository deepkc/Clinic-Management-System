          FieldDefs.Add('PatientName', ftString, 100);
          FieldDefs.Add('Paytype', ftString, 10);
          FieldDefs.Add('Scheme', ftstring,50);
          FieldDefs.Add('Community', ftstring,50);
          FieldDefs.Add('EntryBy', ftstring,50);
          FieldDefs.Add('ReferedBy', ftstring,50);
          FieldDefs.Add('Particulars', ftstring,4000);
          FieldDefs.Add('SubTotal', ftFloat);
          FieldDefs.Add('Discount', ftFloat);
          FieldDefs.Add('Disper', ftFloat);
          FieldDefs.Add('Tax', ftFloat);
          FieldDefs.Add('ReceiptDis', ftFloat);
          FieldDefs.Add('NetAmount', ftFloat);
          FieldDefs.Add('RefBillno', Ftstring,20);
          FieldDefs.Add('Billtype', Ftstring,20);
          FieldDefs.Add('IsCreditPaid',Ftstring,10);
          IndexDefs.Clear;
          CreateTable;
     End;
end;

