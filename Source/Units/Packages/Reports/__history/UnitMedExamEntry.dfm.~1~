    SQL.Strings = (
            'Select patientmain.*,District.Districtname,'
            
              '(Patientmain.Fname||'#39' '#39'||PatientMain.Mname||'#39' '#39'||Patientmain.Lna' +
              'me) as FullName,'
            
              '(Select DepName From Department  where DepCode=PatientMain.DepCo' +
              'de)'
            'as DepName'
            
              'from PatientMain,District Where Patientmain.districtid=District.' +
