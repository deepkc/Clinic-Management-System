procedure TForm_PatientSearchForPT.BB_CloseClick(Sender: TObject);
begin
       close;
end;

procedure TForm_PatientSearchForPT.BB_RefreshClick(Sender: TObject);
var KeyState: TKeyboardState;
begin
      if Trim(Se_CLDays.Text)<>'' then
      begin
          if CB_SearchBydate.Checked=False then
          Dex_CLFrom.text:=(GetFromDateBySubNoOfDays(DEX_TodayDate,StrToInt(Se_CLDays.Text)));

          with OraQuery_Dbgrid do
          begin
               close;
               session:=DM_Hospital.DB;
               sql.Clear;
               sql.Add(' select * from VW_PATIENTMAIN_SEARCH ');
               if (CB_GlobalSearch.checked=False) AND (CB_SearchBydate.checked=false) then
               begin
               sql.Add(' where regdate >='+QuotedSTr(GetFromDateBySubNoOfDays(DEX_TodayDate,StrToInt(Se_CLDays.Text))));
               sql.Add(' and regdate<='+QuotedStr(Dex_CLTo.text));
               end
               else if CB_SearchBydate.checked=True then
               begin
                    sql.Add(' where regdate >='+QuotedStr(Dex_CLFrom.text));
               sql.Add(' and regdate<='+QuotedStr(Dex_CLTo.text));
               end;
              //sql.savetofile('C:\abc33.txt');
               open;
          end;
      end;

      GetKeyboardState(KeyState);
      if (KeyState[VK_CAPITAL]=0) then
      begin
           Keybd_Event(VK_CAPITAL, 1, KEYEVENTF_EXTENDEDKEY or 0, 0);
         // Simulate a "CAPS LOCK" key press
          Keybd_Event(VK_CAPITAL, 1, KEYEVENTF_EXTENDEDKEY or KEYEVENTF_KEYUP, 0);
      end;

end;


procedure TForm_PatientSearchForPT.CB_GlobalSearchClick(Sender: TObject);
begin
    CB_SearchBydate.checked:=false;
end;

procedure TForm_PatientSearchForPT.Edit_FirstNameKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
    { if key=VK_UP then
          OraQuery_Dbgrid.Prior
     else if Key=VK_DOWN then
          OraQuery_Dbgrid.Next
     else if (Key=13) and (Trim(Edit_FirstName.Text) <> '') then
     begin
          Edit_FirstName.Text:=OraQuery_Dbgrid.FieldByName('Fname').AsString;
          Edit_LastName.Text:=OraQuery_Dbgrid.FieldByName('Lname').AsString;
          Edit_Phoneno.Text:=OraQuery_Dbgrid.FieldByName('RPHONENO').AsString;
          LabelPatientId.Visible:=True;
          LabelPatientId.Caption:='THE PATIENT ID IS : '+OraQuery_Dbgrid.FieldByName('Patientid').AsString;
          DBGrid_Search.Visible:=false;
     end;

     if KEY=VK_ESCAPE then
     close; }

end;

procedure TForm_PatientSearchForPT.FormClose(Sender: TObject;
  var Action: TCloseAction);
var
  KeyState: TKeyboardState;
begin
     Form_Verification.CB_SearchPatient.Checked:=False;
     GetKeyboardState(KeyState);
     if (KeyState[VK_CAPITAL]=1) then
     begin
       Keybd_Event(VK_CAPITAL, 1, KEYEVENTF_EXTENDEDKEY or 0, 0);
       Keybd_Event(VK_CAPITAL, 1, KEYEVENTF_EXTENDEDKEY or KEYEVENTF_KEYUP, 0);
     end;
end;

procedure TForm_PatientSearchForPT.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
     if Key = VK_ESCAPE then
     begin
           Form_Verification.CB_SearchPatient.Checked:=False;
          close;
     end;
end;

