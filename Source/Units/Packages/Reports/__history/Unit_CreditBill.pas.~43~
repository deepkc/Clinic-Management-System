procedure TForm_CreditBill.PharmacyIncomeDetail;
Var
     lf_MDTotal, lf_MDDiscount, lf_MDNetTotal: Double;
Begin
     lf_MDTotal := 0;
     lf_MDDiscount := 0;

     { CREDIT   Getting Net medicine(After Medicine Refund) amount }
     with Query_Process do
     Begin
          Close;
          Sql.Clear;
          Sql.Add(' select SD.PatientID,SD.InpatientID,Sum(Round(SD.Qty*SD.UnitRate,5))  as Total,');
          Sql.Add(' Sum(Round((SD.Qty*SD.UnitRate) * SD.Discount/100,5)) as Discount');
          Sql.Add(' From SaleMaster SM,SaleDetail SD,InPatientReg IR,ItemsList IL where (SM.SaleMasterId=SD.SaleMasterId)');
          Sql.Add(' and (SD.itemsid=IL.itemsid) And SD.InpatientId=IR.InpatientId and (SM.ST=''N'') and (SM.STATUS1=1) And (SD.PatientId < 9999900) ');
          Sql.Add(' And IR.DisDate Between ' + #39 + DateEditX_FromDate.text +#39);
          Sql.Add(' AND ' + #39 + DateEditX_ToDate.text + #39 +' And IR.Discharged=''YES'' ');
          Sql.Add(' and SD.InpatientId In ( Select Distinct InpatientId From BillDetail ');
          Sql.Add(' Where (BillType=''IP'' or BillType=''A'') and PayType=''CREDIT'' and CancelStatus=''N'' ');
          Sql.Add(' and billdate>=' + #39 + DateEditX_FromDate.text + #39 +'and billdate <=' + #39 + DateEditX_ToDate.text + #39 + ')');
          Sql.Add(' Group By SD.PatientID,SD.InpatientID');
          // sql.SaveToFile('Credit.txt');
          Open;
     End;

     While Not Query_Process.Eof Do
     Begin
          lf_MDTotal := Query_Process.FieldByName('Total').AsFloat - Query_Process.FieldByName('Discount').AsFloat;
          With Query_Temp Do
          Begin
               Close;
               DatabaseName := gs_TempPath;
               Sql.Clear;
               Sql.Add(' UPdate CreditBill.db Set PharmacyIncome = PharmacyIncome + '+ FloatToStr(lf_MDTotal));
               Sql.Add(' Where PatientID=' + Query_Process.FieldByName('PatientID').AsString);
               Sql.Add(' And InPatientID=' + Query_Process.FieldByName('InPatientID').AsString);
               ExecSQL;
               Sql.Clear;
               Sql.Add(' UPdate CreditBill.db Set NetTotal = NetTotal + ' +FloatToStr(lf_MDTotal));
               Sql.Add(' Where PatientID=' + Query_Process.FieldByName('PatientID').AsString);
               Sql.Add(' And InPatientID=' + Query_Process.FieldByName('InPatientID').AsString);
               ExecSQL;
               Sql.Clear;
               Sql.Add(' UPdate CreditBill.db Set Dues = Dues + ' + FloatToStr(lf_MDTotal));
               Sql.Add(' Where PatientID=' + Query_Process.FieldByName('PatientID').AsString);
               Sql.Add(' And InPatientID=' + Query_Process.FieldByName('InPatientID').AsString);
               ExecSQL;
          End;
          Query_Process.Next;
     End;
     lf_MDTotal := 0;
     lf_MDDiscount := 0;

     // First Find out the Paitent list
     With Query_Process do
     begin
          Close;
          Sql.Clear;
          Sql.Add(' Select InptDate,DisDate,PatientId, InpatientID From InpatientReg Where Discharged=''YES'' ');
          Sql.Add(' and DisDate>=:FromDate and DisDate<=:ToDate and InpatientId In(');
          Sql.Add(' Select Distinct InPatientId From BillDetail Where (BillType=''IP'' or BillType=''A'')');
          Sql.Add(' and PayType=''CREDIT'' And Service<>''IPREF'' and CancelStatus=''N''');
          Sql.Add(' And SchemeID > 0 and DisBillDate>=:FromDate and DisBillDate <=:ToDate');
          Sql.Add(' )');
          // sql.SaveToFile('CreditR.txt');
          ParamByName('FromDate').AsString := DateEditX_FromDate.text;
          ParamByName('ToDate').AsString := DateEditX_ToDate.text;
          Open;
          First;
          While not Eof do
          begin
               With Query_SubProcess do
               begin
                    Close;
                    Sql.Clear;
                    Sql.Add('Select Sum((RD.Qty * RD.UnitPrice)-(RD.Qty * RD.Discount)) as NetTotal ');
                    Sql.Add(' From ReturnMaster RM,ReturnDetail RD where (RM.ReturnMasterId=RD.ReturnMasterId(+))');
                    Sql.Add(' and (RM.ST=''N'') and (RM.Credit1=1) and (RM.CustomerID < 9999900)');
                    Sql.Add(' and RM.ReturnDate>=' + #39 + Query_Process.FieldByName('InptDate').AsString + #39);
                    Sql.Add(' and RM.ReturnDate<=' + #39 + Query_Process.FieldByName('DisDate').AsString + #39);
                    Sql.Add(' and RM.CustomerId=' + Query_Process.FieldByName('PatientId').AsString);
                    // sql.add(' and RM.InpatientId='+Query_Process.FieldByName('InPatientID').AsString);
                    Sql.Add(' And RM.CustomerID In(Select PatientID From InpatientReg Where PatientID=RM.CustomerId And ');
                    Sql.Add(' ((RM.Returndate>=Inptdate And RM.Returndate<Disdate)) ');
                    Sql.Add(' OR (RM.Returndate=DisDate And RM.Rettime<=(Select OutTime From InpatientDetail Where');
                    Sql.Add(' InPatientId=InpatientReg.InPatientId and DisBillDate=InpatientReg.DisDate))) ');
                    // sql.SaveToFile('CreditRef.txt');
                    Open;

                    lf_MDTotal := FieldByName('NetTotal').AsFloat;
                    With Query_Temp Do
                    Begin
                         Close;
                         DatabaseName := gs_TempPath;
                         Sql.Clear;
                         Sql.Add(' UPdate CreditBill.db Set PharmacyIncome = PharmacyIncome - ' + FloatToStr(lf_MDTotal));
                         Sql.Add(' Where PatientID=' + Query_Process.FieldByName('PatientID').AsString);
                         Sql.Add(' And InPatientID=' + Query_Process.FieldByName('InPatientID').AsString);
                         ExecSQL;
                         Sql.Clear;
                         Sql.Add(' UPdate CreditBill.db Set NetTotal = NetTotal - '+ FloatToStr(lf_MDTotal));
                         Sql.Add(' Where PatientID=' + Query_Process.FieldByName('PatientID').AsString);
                         Sql.Add(' And InPatientID=' + Query_Process.FieldByName('InPatientID').AsString);
                         ExecSQL;
                         Sql.Clear;
                         Sql.Add(' UPdate CreditBill.db Set Dues = Dues - '+ FloatToStr(lf_MDTotal));
                         Sql.Add(' Where PatientID=' + Query_Process.FieldByName('PatientID').AsString);
                         Sql.Add(' And InPatientID=' + Query_Process.FieldByName('InPatientID').AsString);
                         ExecSQL;
                    End;
               end;
               Next;
          end;
     end;
end;

function TForm_CreditBill.IsCreditpaid(BillNo: String): Boolean;
begin
     With Query_Blank Do
     Begin
          With Sql Do
          Begin
               Clear;
               Add('Select Distinct CRPM_CRBILLNODETAIL BILLNO From HS_CRPM_Creditpaymentmaster where CRPM_CRBILLNODETAIL=' + Chr(39) + BillNo + Chr(39));
          End;
          Open;
          If Trim(FieldByName('BillNo').AsString) <> '' Then
          Begin
               Result := True;
               With Sql Do
               Begin
                    Clear;
                    Add('Select Sum(CRPM_RECEIPTAMOUNTD) Deposit From HS_CRPM_Creditpaymentmaster where CRPM_CRBILLNODETAIL=' + Quotedstr(BillNo));
               End;
               Open;
               pf_Deposit := FieldByName('Deposit').AsFloat;
          End
          Else
          Begin
               Result := False;
               pf_Deposit := 0;
          End;
     End;
end;

