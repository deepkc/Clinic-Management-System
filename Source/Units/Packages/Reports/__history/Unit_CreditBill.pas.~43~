procedure TForm_CreditBill.BitBtnPreviewClick(Sender: TObject);
var
     lf_TotMedCharge: Double;
     ls_ReportTitle: String;
begin
     DateEditX_FromDate.SystemOfDate := gi_datesystem;
     DateEditX_ToDate.SystemOfDate := gi_datesystem;
     BtnFrom.Caption := gs_DateCaption;
     BtnTo.Caption := gs_DateCaption;
     gs_From := DateEditX_FromDate.text;
     gs_to := DateEditX_ToDate.text;
     DateEditX_FromDate.SystemOfDate := 0;
     DateEditX_ToDate.SystemOfDate := 0;
     BtnFrom.Caption := 'BS';
     BtnTo.Caption := 'BS';

     { IF RadioButton_OPCollection.Checked=True Then
       Begin }
     IF (CheckBoxReceivableParty.Checked = False) and (CheckBoxMedicare.Checked = False) Then
     Begin
          CreateTempCreditBill;
          PostDataIntoTempTable;
          With FormReportCreditNew Do { Receivable Party + Medicare }
          Begin
               if RGReportOption.ItemIndex = 0 then
               Begin
                    With Qry_summaryMaster do
                    Begin
                         Close;
                         Session:=dm_Hospital.DB;
                         Sql.Clear;
                         sql.Add('Select Distinct BIDE_CommunityID COMMUNITYID, (Select COMM_community from HS_COMM_COMMUNITY where COMM_communityid=BD.BIDE_communityid) Community');
                         sql.Add('from  HS_BIDE_billdetail BD where (BIDE_BillDate>=' + Quotedstr(gs_From)+' AND BIDE_BillDate<=' + Quotedstr(gs_to)+ ')');
                         if DBCommunity.KeyValue<>Null then
                              sql.Add('and BIDE_CommunityID='+inttostr(DBCommunity.KeyValue));
                         sql.Add('and BIDE_communityid>0 Order By Community');
                         Open;
                    End;
                    With Qry_summaryDetail Do
                    Begin
                         Close;
                         Session:=dm_Hospital.DB;
                         Sql.Clear;
                         Sql.Add('Select Schemeid SCHEMEID,scheme SCHEME,sum(Total)total,Sum(Discount)Discount,Sum(Vatamt)vatamt,sum(nettotal)nettotal from (');
                         Sql.Add('Select BIDE_SchemeID SCHEMEID,(Select SCHE_Scheme From HS_SCHE_Scheme Where SCHE_SchemeID=BD.BIDE_SchemeID)Scheme');
                         Sql.Add(',Sum(BIDE_qty*BIDE_Amount) as Total,sum((BIDE_qty*BIDE_Amount)*(BIDE_DISPER/100)) as Discount,Sum(BIDE_VatAmt*BIDE_Qty) as VatAmt');
                         Sql.Add(',Sum(((BIDE_Qty*BIDE_Amount)+BIDE_VatAmt*BIDE_Qty)-(BIDE_Qty*BIDE_Amount*BIDE_DISPER/100)) as NetTotal');
                         Sql.Add('From HS_BIDE_BillDetail BD Where BIDE_PayType In(''CREDIT'',''REFUND'')');
                         If RadioButton_OPCollection.Checked = True Then
                         Sql.Add('And BIDE_BillType In(''O'',''B'')')
                         Else If RadioButton_IPCollection.Checked = True Then
                         Sql.Add('And BIDE_BillType In(''IP'',''A'')')
                         Else
                         Sql.Add('AND BIDE_BillType In (''B'',''O'',''IP'',''A'')');
                         If RGCreditOption.ItemIndex = 0 Then
                         Sql.add(' And NVL(BIDE_IsCrPaid,''N'')<>''Y''')
                         Else If RGCreditOption.ItemIndex = 1 Then
                         Sql.Add( ' And BIDE_IsCrPaid=''Y''')
                         Else
                         Sql.add(' And ''AniD''=''AniD''');
                         Sql.Add('And (BIDE_BillNo Like ''PR%''  or BIDE_BillNo Like ''CR%'' Or BIDE_BillNo Like ''RF%'')');
                         Sql.Add(' And (BIDE_BillDate>=' + Quotedstr(gs_From)+' AND BIDE_BillDate<=' + Quotedstr(gs_to)+ ')');
                         Sql.Add('And BIDE_Communityid=:Communityid');
                         Sql.Add('And BIDE_Amount > 0 And (BIDE_BillNo Like ''CR%'' Or BIDE_BillNo Like ''RF%'')');
                         Sql.Add('Group by BIDE_schemeid');
                         Sql.Add('Union');
                         Sql.Add('Select REDE_SchemeID SCHEMEID,(Select SCHE_Scheme From HS_SCHE_Scheme Where SCHE_SchemeID=RD.REDE_SchemeID)Scheme');
                         Sql.Add(' ,-Sum(REDE_qty*REDE_Amount) as Total,-sum((REDE_qty*REDE_Amount)*(REDE_DISPER/100)) as Discount,-Sum(REDE_VatAmt*REDE_Qty) as VatAmt');
                         Sql.Add(' ,-Sum(((REDE_Qty*REDE_Amount)+REDE_VatAmt*REDE_Qty)-(REDE_Qty*REDE_Amount*REDE_DISPER/100)) as NetTotal');
                         Sql.Add(' From HS_REDE_refunddetail RD Where REDE_PayType In(''CREDIT'',''REFUND'')');
                          If RadioButton_OPCollection.Checked = True Then
                         Sql.Add('And REDE_BillType In(''O'',''B'')')
                         Else If RadioButton_IPCollection.Checked = True Then
                         Sql.Add('And REDE_BillType In(''IP'',''A'')')
                         Else
                         Sql.Add('AND REDE_BillType In (''B'',''O'',''IP'',''A'')');
                         Sql.Add(' And (REDE_REFUNDDATE>=' + Quotedstr(gs_From)+' AND REDE_REFUNDDATE<=' + Quotedstr(gs_to)+ ')');
                         Sql.Add('And REDE_Communityid=:Communityid');
                         Sql.Add(' And REDE_billdetailid in (Select BIDE_billdetailid from HS_BIDE_billdetail where BIDE_billdetailid=RD.REDE_billdetailid and REDE_Refundbillno like ''CR%'')');
                         Sql.Add(' And REDE_Amount > 0 And (REDE_RefundBillNo Like ''CR%'' Or REDE_RefundBillNo Like ''RF%'')');
                         Sql.Add(' Group by REDE_SchemeID)');
                         Sql.Add(' group by Schemeid,Scheme');
                         sql.SaveToFile('C:\detail.txt');
                         Open;
                    End;
                    QRLabel67.Caption:=gs_From;
                    QRLabel77.Caption:=gs_to;
                    QRLabel79.Caption:=serverdate.TodaysDate;
                    QuickRep3.Preview;
                    Exit;
               End;
               With QryMaster Do
               Begin
                    Close;
                    DatabaseName := gs_TempPath;
                    sql.Clear;
                    Sql.Add(' Select Distinct SchemeID, CommunityID, Community, Scheme From CreditBill.db Order By Community, Scheme');
                    Open;
               End;

               With QryDetail Do
               Begin
                    Close;
                    DatabaseName := gs_TempPath;
                    Sql.Clear;
                    Sql.Add('Select BillDate, BillNo, PatientID, PatientName, HospitalIncome, PharmacyIncome, Discount, NetTotal, ');
                    Sql.Add(' Deposit, Dues, UserName, Remarks From CreditBill.db Where CommunityID=:CommunityID And SchemeID=:SchemeID');
                    Sql.Add(' And BillNo Like ''CR%'' Order By BillDate, BillNo, PatientID');
                    // Sql.SaveToFile('2.txt');
                    Open;
               End;

               With QryDetailRefund Do
               Begin
                    Close;
                    DatabaseName := gs_TempPath;
                    Sql.Clear;
                    Sql.Add('Select BillDate, BillNo, PatientID, PatientName, HospitalIncome, PharmacyIncome, Discount, NetTotal, ');
                    Sql.Add(' Deposit, Dues, UserName, Remarks From CreditBill.db Where CommunityID =:CommunityID And SchemeID =:SchemeID');
                    Sql.Add(' And BillNo Like ''RF%'' Order By BillDate, BillNo, PatientID');
                    // Sql.SaveToFile('2.txt');
                    Open;
               End;

               With QryCreditSum Do
               Begin
                    Close;
                    DatabaseName := gs_TempPath;
                    Open;
               End;

               With QryCreditRefundSum Do
               Begin
                    Close;
                    DatabaseName := gs_TempPath;
                    Open;
               End;

               IF RadioButton_OPCollection.Checked = True Then
               Begin
                    ls_ReportTitle := 'Credit Report (OP)';
               End
               Else If RadioButton_IPCollection.Checked = True Then
               Begin
                    ls_ReportTitle := 'Credit Report (IP)';
               End
               Else If RadioButton_IPOP.Checked = True Then
               Begin
                    ls_ReportTitle := 'Credit Report (OP+IP)';
               End;

               IF b_SendToExcel = True Then
               Begin
                    { SendToExcelMultiQuery(QueryCRBill,QueryMEBill,nil,nil,nil,ls_ReportTitle,'ME Bill :','','','',
                      DateEditX_FromDate.Text+'-'+DateEditX_ToDate.Text,'',gs_HosName,gs_HosAddress,2); }
                    // SendToExcelMasterDetail(QryMaster,QryDetail,ls_ReportTitle,DateEditX_FromDate.Text+'-'+DateEditX_ToDate.Text,
                    // '',gs_HosName,gs_HosAddress,'CREDIT');
                    // b_SendToExcel:=False;
               End
               Else
               Begin
                    CrSno := 0;
                    CrRfSno := 0;
                    MeSno := 1;
                    QRLabelFrom.Caption := DateEditX_FromDate.text;
                    QRLabelTo.Caption := DateEditX_ToDate.text;
                    QRLabelToday.Caption := serverdate.TodaysDate;

                    QRLabel50.Caption := DateEditX_FromDate.text;
                    QRLabel48.Caption := DateEditX_ToDate.text;
                    QRLabel47.Caption := serverdate.TodaysDate;

                    IF CMBReceivable.text <> '' Then
                    Begin
                         QRLabel20.Font.Color := clBlack;
                         QRLabel20.Caption := CMBReceivable.text;
                         QRLabelReceive.Font.Color := clBlack;

                         QRLabel42.Font.Color := clBlack;
                         QRLabel42.Caption := CMBReceivable.text;
                         QRLabel22.Font.Color := clBlack;

                         QRLabel10.Font.Color := clWhite;
                         QRSubDetailMEBill.Height := 0;
                         FooterMEBill.Height := 0;
                    End
                    Else
                    Begin
                         QRLabel20.Font.Color := clWhite;
                         QRLabelReceive.Font.Color := clWhite;

                         QRLabel42.Font.Color := clWhite;
                         QRLabel22.Font.Color := clWhite;

                         QRLabel10.Font.Color := clBlack;
                         QRSubDetailMEBill.Height := 20;
                         FooterMEBill.Height := 61;
                    End;
                    QRLabelReportTitle.Caption := ls_ReportTitle;
                    // QuickRep1.Preview;
                    QRLabel52.Caption := ls_ReportTitle;
                    QuickRep2.Preview;
               End;
               QueryCRMETotal.Close;
               QueryCRBill.Close;
               QueryMEBill.Close;
               QueryName.Close;
               QryMaster.Close;
          End;
     End
     Else IF CheckBoxReceivableParty.Checked = True Then { Receivable party }
     Begin
          With FormReportCreditReceivable Do
          Begin
               with QueryName do
               Begin
                    Close;
                    ParamByName('FromDate').AsString := DateEditX_FromDate.text;
                    ParamByName('ToDate').AsString := DateEditX_ToDate.text;
                    Open;
               End;

               With QueryCRMaster Do
               Begin
                    Close;
                    ParamByName('FromDate').AsString := DateEditX_FromDate.text;
                    ParamByName('ToDate').AsString := DateEditX_ToDate.text;
                    Open;
               End;

               With QueryCRBill Do
               Begin
                    Close;
                    Sql[5] :=' And (BillDate>=:FromDate AND BillDate<=:ToDate) ';
                    ParamByName('FromDate').AsString := DateEditX_FromDate.text;
                    ParamByName('ToDate').AsString := DateEditX_ToDate.text;
                    Open;
               End;
               IF RadioButton_OPCollection.Checked = True Then
                    ls_ReportTitle := 'Credit Report (Receivable Party)(OP)'
               Else
                    ls_ReportTitle := 'Credit Report (Receivable Party)(IP)';
               IF b_SendToExcel = True Then
               Begin
                    // SendToExcelMasterDetail(QueryCRMaster,QueryCRBill,ls_ReportTitle,DateEditX_FromDate.Text+'-'+DateEditX_ToDate.Text,
                    // '',gs_HosName,gs_HosAddress,'CREDIT');
                    // b_SendToExcel:=False;
               End
               Else
               Begin
                    CrSno := 1;
                    MeSno := 1;
                    QRLabelFrom.Caption := DateEditX_FromDate.text;
                    QRLabelTo.Caption := DateEditX_ToDate.text;
                    QRLabelToday.Caption := serverdate.TodaysDate;
                    QRLabelReportTitle.Caption := ls_ReportTitle;
                    QuickRep1.Preview;
               End;
               QueryCRMETotal.Close;
               QueryCRBill.Close;
               QueryMEBill.Close;
               QueryName.Close;
          End;
     End;
End;

