       Sql[5]:=' And BillType In(''IP'',''A'')'
       Else
       Sql[5]:=' And BillType In(''O'',''B'',''A'',''IP'')';
       Sql[8]:=' And ''AniD''=''AniD''';
       Sql.SaveToFile('Sql.txt');
       Open; }

     // While Not Eof Do
