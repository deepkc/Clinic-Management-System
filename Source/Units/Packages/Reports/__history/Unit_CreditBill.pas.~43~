procedure TForm_CreditBill.CreateTempCreditBill;
begin
     If FileExists(gs_TempPath + '\CreditBill.db') Then
     Begin
          With TblCRBill Do
          Begin
               DatabaseName := gs_TempPath;
               Close;
               TableName := 'CreditBill.db';
               EmptyTable;
          End;
     End;

     with TblCRBill do
     Begin
          DatabaseName := gs_TempPath;
          Close;
          TableName := 'CreditBill.db';
          TableType := ttDefault;
          FieldDefs.Clear;
          FieldDefs.Add('BillDate', ftString, 10);
          FieldDefs.Add('BillNo', ftString, 16);
          FieldDefs.Add('PatientId', ftInteger);
          FieldDefs.Add('InPatientId', ftInteger);
          FieldDefs.Add('CommunityID', ftInteger);
          FieldDefs.Add('SchemeID', ftInteger);
          FieldDefs.Add('PatientName', ftString, 50);
          FieldDefs.Add('HospitalIncome', ftFloat);
          FieldDefs.Add('PharmacyIncome', ftFloat);
          FieldDefs.Add('Discount', ftFloat);
          FieldDefs.Add('NetTotal', ftFloat);
          FieldDefs.Add('Deposit', ftFloat);
          FieldDefs.Add('Dues', ftFloat);
          FieldDefs.Add('Community', ftString, 100);
          FieldDefs.Add('Scheme', ftString, 100);
          FieldDefs.Add('UserName', ftString, 100);
          FieldDefs.Add('Remarks', ftString, 100);
          IndexDefs.Clear;
          CreateTable;
     End;
end;

