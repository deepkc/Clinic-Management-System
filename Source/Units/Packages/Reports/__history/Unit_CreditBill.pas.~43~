procedure TForm_CreditBill.FormKeyDown(Sender: TObject; var Key: Word;
     Shift: TShiftState);
begin
     IF Key = 27 Then
          Close;
     IF Key = VK_F1 Then
          BitBtnPreviewClick(Sender);
     IF Key = VK_F2 Then
          BitBtnExcelClick(Sender);

     IF Key = VK_F3 Then
          RadioButton_OPCollection.Checked := True;
     IF Key = VK_F4 Then
          RadioButton_IPCollection.Checked := True;
     IF Key = VK_F5 Then
          RadioButton_IPOP.Checked := True;
end;

