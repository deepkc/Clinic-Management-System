  object QueryMain: TOraQuery
    SQL.Strings = (
      
        'SELECT BIDE_BillNo, BIDE_PatientId, (SELECT   (PAMA_FName || '#39' '#39 +
        ' || PAMA_LName) FROM   HS_PAMA_PatientMain WHERE   PAMA_PatientI' +
        'd = BD.BIDE_PatientId) PatientName,'
      
        'BIDE_ServiceType,BIDE_BillDate,Sum(BIDE_Amount * BIDE_Qty) AS Am' +
        'ount,Sum(BIDE_Qty * BIDE_Amount * BIDE_disper / 100) AS Discount' +
        ',Sum(BIDE_VatAmt*BIDE_Qty) AS VatAmt,Sum(BIDE_Qty)Qty,'
      
        '( ( (BIDE_Amount - BIDE_Amount * BIDE_Disper / 100) * BIDE_Qty) ' +
        '+ BIDE_VatAmt*BIDE_qty)AS NetAmount'
      'FROM   HS_BIDE_BillDetail BD'
      
        'where BIDE_BillDetailId Not In(Select REDE_BillDetailId From HS_' +
        'REDE_RefundDetail)'
      'And 1=1'
      'and BIDE_depid=1'
      
        'GROUP BY BIDE_BillDetailid, BIDE_BillNo,BIDE_PatientId, BIDE_SEr' +
        'viceType, BIDE_BillDate,BIDE_BillTime, BIDE_Amount,BIDE_Qty,BIDE' +
        '_VatAmt,BIDE_DisPer,BIDE_PayType,BIDE_RateType'
      
        'Order By BIDE_BillNo,BIDE_BillDate,BIDE_ServiceType,BIDE_Patient' +
        'Id')
    Left = 376
    Top = 344
  end
