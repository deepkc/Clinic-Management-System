procedure TForm_PtTestReport.BitBtnPrintClick(Sender: TObject);
begin
     if MessageDlg('Are You sure you want to send the data to Excel.',mtWarning,[mbYes,mbNo],0)=mrNo then
        exit
     else
     begin
          with Query_Process do
          begin
               close;
               Session:=DM_Hospital.DB;
               Sql.Clear;
               Sql.Add('Select InitCap(pama_FName ||'' ''||pama_LName)as Name from hs_pama_PatientMain where pama_patientid='+Trim(Edit_PatientNo.Text));
               open;
          end;
          sendToExcel(nil, DBGrid1, 'Patient Test Report of :'+Query_Process.FieldByName('Name').ASString, ServerDate.todaysDate,' ',gs_HospitalName,gs_HospitalAddress,0);
     end;
end;

