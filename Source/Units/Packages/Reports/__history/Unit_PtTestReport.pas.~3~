function TForm_PtTestReport.CheckSensitivity(TestNameID:Integer;PatientTestId:Integer):Boolean;
begin
    with Query_void do
    begin
        close;
        Session:=DM_Hospital.DB;
        sql.Clear;
        Sql.Add('select Sm.Sensitivemedicineid from SENSITIVEMEDICINETESTWISE sm, sensitivityresult sr');
        Sql.Add('where SM.SENSITIVEMEDICINEID=(select SENSITIVEMEDICINEID from SENSITIVEMEDICINETESTWISE a where a.SMTWID=sr.SMTWID)');
        Sql.Add('and SM.TESTNAMEID=(select testnameid from patienttest where patienttestid=SR.patienttestid and patientid=sr.patientid)');
        Sql.Add('and sm.testnameid= '+IntToStr(TestNameId));
        Sql.Add('and sr.patienttestid= '+IntToStr(PatientTestId));
       // sql.savetofile('C:\abcct.txt');
        open;
        first;
    end;
    if Query_void.fieldbyname('Sensitivemedicineid').AsString<>'' then
    result:=true
    else
    Result:=false;
end;

procedure TForm_PtTestReport.CreateTableForPrint;
begin
    With TableInvestigationMaster Do
     Begin
          Close;
          DataBaseName:=gs_TempPath;
          TableName:='InvestigationMasterprint.db';
          TableType:=TTParadox;
          FieldDefs.Clear;
          Fielddefs.add('DepID',ftInteger);
          Fielddefs.add('TestDate',ftString,10);
          Fielddefs.add('DepOrder',ftInteger);
          Fielddefs.add('PatientTestID',ftInteger);
          Fielddefs.add('ISEdit',ftString,1);
          CreateTable;
     End;

     With TableInvestigationDetail Do
     Begin
          Close;
          DataBaseName:=gs_TempPath;
          TableName:='InvestigationDetailprint.db';
          TableType:=TTParadox;
          FieldDefs.Clear;
          Fielddefs.add('DepID',ftInteger);
          Fielddefs.add('TestID',ftInteger);
          Fielddefs.add('TestNameID',ftInteger);
          Fielddefs.add('TestName',ftString,1000);
          Fielddefs.add('Finding',ftString,1000);
          Fielddefs.add('Unit',ftString,40);
          Fielddefs.add('RefRange',ftString,1000);
          Fielddefs.add('PatientTestID',ftInteger);
          Fielddefs.add('TestDate',ftString,10);
          Fielddefs.add('TestTime',ftString,12);
          Fielddefs.add('ReportDate',ftString,10);
          Fielddefs.add('ReportTime',ftString,12);
          Fielddefs.add('Dep',ftInteger);
          Fielddefs.add('Sensitive',ftInteger);
          CreateTable;
     End;
end;

