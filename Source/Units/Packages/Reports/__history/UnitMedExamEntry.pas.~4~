                         if QueryMain.FieldByName('RA_DrugSensitive').AsString='T' then
                              img_MDR.picture:=Nil
                         else
                              img_Drugsensitive.picture:=Nil;
                    end;
               if querymain.fieldbyname('TreatmentOutcome').asstring='UT' then
