procedure TFormMedExamEntry.Edit_TAgeExit(Sender: TObject);
 Var li_DOBADCAlc:Integer;
DateEditXDOBAD:TDateEditX;
begin
     DateEditXDOBAD:=TDateEditX.Create(nil);
     DateEditXDOBAD.SystemOfDate:=gi_DateSystem;
     IF ((Trim(Edit_TAge.Text)='') or (Trim(Edit_TAge.Text)='0')) and (pi_SetAgeCount <= 2) Then
     Begin
          pi_SetAgeCount:=pi_SetAgeCount+1;
          MessageDlg('Plz. put patient age.',mtWarning,[mbok],0);
          Edit_TAge.Text:='0';
          Edit_TAge.SetFocus;
     End;
     IF (Trim(Edit_TAge.Text)<>'') Then
     Begin
          IF StrToInt(Edit_TAge.Text) > 0 Then
          Begin
               DateEditXRegAge.SystemOfDate:=gi_DateSystem;
               DateEdit_TDOB.SystemOfDate:=gi_DateSystem;
               DateEditXRegAge.Text:=ServerDate.TodaysDate;
               ChangeCaption(Button2,gi_DateSystem);
               if CMB_TAgeType.Text='Year' then
                    DateEditXRegAge.ADDateAsDate:=DateEditXRegAge.ADDateAsDate-StrToInt(Edit_TAge.Text)*365
               Else if CMB_TAgeType.Text='Month' then
                    DateEditXRegAge.ADDateAsDate:=DateEditXRegAge.ADDateAsDate-StrToInt(Edit_TAge.Text)*30
               Else if Cmb_TAgeType.Text='Day' then
                    DateEditXRegAge.ADDateAsDate:=DateEditXRegAge.ADDateAsDate-StrToInt(Edit_TAge.Text);
               //DateEditXDOB.Text:=ADToVS(DateEditXRegAge.VSDateAsText);
               //DateEditXDOB.VSDateAsText:=DateEditXRegAge.VSDateAsText;
               DateEdit_TDOB.Text:=DateEditXRegAge.Text;
               DateEditXDOBAD.TExt:= DateEditXRegAge.Text; //Subtracting 56 Yrs 08 Months and 16 Days to get ADDOB from DOB
               DateEditXDOBAD.SystemOfDate:=1;
               Ps_DOBAD:= DateEditXDOBAD.TExt;
          End;
     End;
end;

