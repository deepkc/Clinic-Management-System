procedure TFormMedExamEntry.BtnCancelClick(Sender: TObject);
begin
     If PageControlMedicalExam.Visible=True then
     Begin
          BtnSave.Enabled:=False;
          BtnDetail.Enabled:=True;
          BitBtn_TBExamination.Enabled:=True;
          //BtnPrint.Enabled:=true;
          PageControlmain.Visible:=True;
          PageControlMedicalExam.Visible:=False;
          PageControl_TBExam.visible:=False;
     End
     else If PageControl_TbExam.Visible=True then
     Begin
          BtnSave.Enabled:=False;
          BtnDetail.Enabled:=True;
          BitBtn_TBExamination.Enabled:=True;
          //BtnPrint.Enabled:=true;
          PageControlmain.Visible:=True;
          PageControlMedicalExam.Visible:=False;
          PageControl_TBExam.visible:=False;
     End
     Else
     Begin
          Close;
     End;
end;


procedure TFormMedExamEntry.SetQueryToSelection;
var
cSql,ak,MyString:String;
begin
     //MyString:='AND RegDate<=:SDate AND RegDate>=:PDate  Order by patientID';
   
     With querySearch do
     begin
          close;
          with SQL do
          begin
               clear;
               Add('Select Distinct MedicalExamination.MedicalExaminationID,TuberclosisExamination.TBExaminationId,PatientMain.PatientID,patientmain.FName,');
               Add(' patientmain.LName,patientmain.Gender, patientmain.AgeType,patientmain.DistrictID, patientmain.PAddress,District.Districtname,(Select DepName From Department where ');
               Add(' DepCode=PatientMain.DepCode) as DepName,PatientMain.Age,(select testname from testname where testnamecode=billdetail.service and rownum=1) as test ');
               Add('From PatientMain,District,BillDetail,MedicalExamination,TuberClosisExamination');
               Add(' Where PatientMain.PatientID=BillDetail.PatientID And Patientmain.districtid=District.districtid And PatientMain.PatientID=MedicalExamination.PatientID(+)');
               Add(' and patientmain.patientid=TuberClosisExamination.patientid(+)');
               Add(' And BillDetail.BillDate<=:SDate AND BillDetail.BillDate>=:PDate  ');
               //Add(' And BillDetail.Service In (''EPS01'',''EPS02'') ');
               Add(' And BillDetail.DepId = 35 ');
               {If Trim(Editsearch.Text) <> '' Then
               Add(' PatientMain.PatientID='+Trim(Editsearch.Text));}
               Add(' Order by PatientMain.PatientID');
               ParamByName('SDate').ASString:=AdToVS(DateEditXToday.ADDateAsDate);
               ParamByName('PDate').ASString:=AdToVS(DateEditXToday.ADDateAsDate-StrToInt(EditDay.Text));
               //SaveToFile('d:\Sql.txt');
          end;
          Open;

     end;

     {IF editPatient.Text<>'' then
     csql:='(PatientMain.PatientID='+EditPatient.Text+') AND '
     Else
     begin
          If EditFirstName.Text<>'' then csql:=csql+' (PatientMain.FName like '+chr(39)+EditFirstName.Text+'%'+chr(39)+') AND  ';
          If EditLastName.Text<>'' then csql:=csql+' (PatientMain.LName like '+chr(39)+EditLastName.Text+'%'+chr(39)+') AND ';
          If EditGender.Text<>'' then csql:=csql+' (PatientMain.Gender like '+chr(39)+EditGender.Text+'%'+chr(39)+') AND ';
          If EditAgeSearch.Text<>'' then csql:=csql+' (PatientMain.Age like '+chr(39)+EditAgeSearch.Text+'%'+chr(39)+') AND ';
     end;
     delete(cSql,length(cSql)-4,4);
     With querySearch do
     begin
          disablecontrols;
          Try
               close;
               IF csql='' then
               Begin
                    //csql:='And RegDate<=:SDate AND RegDate>=:PDate  Order by patientID';
                    csql:='And BillDetail.BillDate<=:SDate AND BillDetail.BillDate>=:PDate  Order by PatientMain.PatientID';
               End
               Else
                    csql:=' And  '+csql+MyString;
               sql[2]:=csql;
               //SQL.SaveToFile('C:\serch.txt');
               Try
                    ParamByName('SDate').ASString:=AdToVS(DateEditXToday.ADDateAsDate);
                    ParamByName('PDate').ASString:=AdToVS(DateEditXToday.ADDateAsDate-StrToInt(EditDay.Text));
                    //SQL.SaveToFile('Sql.txt');
                    open;
                    //StatusBardetails.Panels[0].Text:='Total Patient  :- '+IntToStr(RecordCount);
               Except
                    sql[2]:=csql;//'And (39=39)';
               End;
          Finally
               enablecontrols;
          End;
     End;}
End;

