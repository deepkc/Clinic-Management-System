                    img_Cured.picture:=Nil;
                    //img_complicated.picture:=Nil;
                    img_Failed.picture:=Nil;
                    img_Defaulted.picture:=Nil;
               end
               else if querymain.fieldbyname('TreatmentOutcome').asstring='F' then
