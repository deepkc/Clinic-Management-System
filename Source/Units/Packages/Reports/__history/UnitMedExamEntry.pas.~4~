procedure TFormMedExamEntry.BitBtn_TBExaminationClick(Sender: TObject);
var ls_Address:string;
begin
        
     if QuerySearch.FieldByName('Test').AsString<>'EPS T.B SCREENING ' then
     begin
          Showmessage('Please select ''EPS T.B SCREENING'' Test!!');
          Exit;
     end;

     ps_common:='TB';

     If QuerySearch.RecordCount=0 then Exit;

     With QuerySearch Do
     Begin
          IF Not Active Then
          Begin
               Showmessage('Would you mind ! there are no data');
               Exit;
          End;
          IF FieldByName('PatientID').asInteger<=0 Then
          Begin
               Showmessage('Would you mind ! there are no data');
               Exit;
          End;
     End;

     BtnSave.Enabled:=True;
     BtnDetail.Enabled:=False;
     BitBtn_TBExamination.Enabled:=False;

     If QueryModify.FieldByName('IsIncharge').AsString ='Y' Then
          BitBtnFooter.Enabled:=True
     Else
          BitBtnFooter.Enabled:=False;

     If FrmUserLogin.UserID In [1] Then
     Begin
          BtnPrint.Enabled:=True;
          BtnSave.Enabled := True;
          //GroupBoxDetail.Enabled := True;
          //GroupBoxPhyRep.Enabled:=True;
          //GroupBoxLabRep.Enabled := True;
          //BitBtnFooter.Enabled:=True;
     End;

     PageControlmain.Visible:=False;
     PageControlMedicalExam.Visible:=False;
     PageControl_TBExam.visible:=True;

     If QuerySearch.Active=true then
     begin
          Label_TPatientid.Caption:=QuerySearch.fieldbyname('PatientID').asstring;
          NpatientNo:=QuerySearch.fieldbyname('PatientID').AsInteger;
          // EditFullName.Text:= QuerySearch.fieldbyname('FullName').asString;
          Edit_TFullName.Text:=QuerySearch.fieldbyname('Lname').asstring+' '+QuerySearch.fieldbyname('Fname').asstring;
          Edit_TAge.Text:=IntToStr(QuerySearch.FieldByname('Age').AsInteger);
          CMB_TAgeType.ItemIndex:=CmbAgeType.Items.IndexOf(QuerySearch.FieldByname('AgeType').AsString);
          CMB_TGender.ItemIndex:=CmbGender.Items.IndexOf(QuerySearch.FieldByname('Gender').AsString);
          DateEdit_TExam.text:=ServerDate.TodaysDate;
          DateEdit_TDOB.text:=ServerDate.TodaysDate;
     End;
     //Retrive the Total Information of the selected patient

     ls_Address:='';
     With Query_TBExam Do
     Begin
          Close;
          databasename:=gs_DatabaseName;
          Sql.Clear;
          Sql.Add('Select PAddress,DistrictID,(Select InitCap(DistrictName) From District Where DistrictID=PatientMain.DistrictID) District');
          SQL.Add(' From PatientMain Where PatientId ='+inttostr(NpatientNo));
          Open;
          ls_Address:=FieldByName('District').AsString;
     End;

