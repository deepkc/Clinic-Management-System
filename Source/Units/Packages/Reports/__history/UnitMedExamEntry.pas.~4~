                         img_infective.picture:=Nil;
                         img_noninfective.picture:=Nil;
                         img_Drugsensitive.picture:=Nil;
                         img_MDR.picture:=Nil;
                    end
                    else if QueryMain.FieldByName('Result').AsString='A' then
