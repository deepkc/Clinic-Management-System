     IF PageControlmain.Visible=True tHEN
     begin
          if QuerySearch.FIELDBYNAME('Test').Asstring='EPS T.B SCREENING ' then
          begin
               NpatientNo:=QuerySearch.FIELDBYNAME('PATIENTID').AsInteger;
