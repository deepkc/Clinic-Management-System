  object OraQuery_testname: TOraQuery
    SQL.Strings = (
      'select * from '
      
        '(select TENA_TESTNAMEID,TENA_TESTNAME,(select dept_deptype from ' +
        'hs_dept_department where dept_depid=tena_depid)deptype from hs_t' +
        'ena_testname)'
      'where deptype='#39'H'#39)
    Left = 348
