  object Query_BillList1: TQuery
    DatabaseName = 'Hospital'
    SQL.Strings = (
      
        'Select Fiscal_Year,Bill_No,Customer_Name,Customer_PAN,Bill_Date,' +
        'Amount,Discount,Taxable_Amount,Tax_Amount,'
      'Is_Printed,Is_Active,Printed_Time,Entered_By,Printed_By'
      'From VS_HS_SaleBookForTaxOffice'
      'Order by TransType,SubStr(Bill_No,9,7)')
    Left = 120
    Top = 191
  end
