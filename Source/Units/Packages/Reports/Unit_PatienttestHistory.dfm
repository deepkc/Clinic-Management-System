  object OraQuery_Department: TOraQuery
    SQL.Strings = (
      'select * from hs_dept_department where dept_deptype='#39'P'#39
      'order by dept_depname')
    Left = 56
    Top = 180
  end
  object DataSource_Department: TDataSource
    DataSet = OraQuery_Department
    Left = 193
    Top = 5
  end
  object OraQuery_TestName: TOraQuery
    SQL.Strings = (
      
        'select * from hs_tena_testname where tena_depid in (select dept_' +
        'depid from hs_dept_department where dept_deptype='#39'P'#39')'
      'and 1=1'
      'order by trim(tena_testname)')
    Left = 49
    Top = 3
  end
