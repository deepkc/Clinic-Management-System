     IF Trim(gs_HosSloganTitle)='' Then
     QRLabelAddIPD.Top:=28
     Else
     QRLabelAddIPD.Top:=43;
end;

procedure TForm_QRDFDoctorPartDetail.QRLabel16Print(sender: TObject;
  var Value: string);
begin
     pf_TDSTotal:=((pf_FS_OPDShare+pf_FS_OPDProc_Share+pf_FS_IPDProc_Share+pf_FS_IPDOT_Share)*gf_TDSPercent/100);
     value:=FormatFloat('#,##0.00',((pf_FS_OPDShare+pf_FS_OPDProc_Share+pf_FS_IPDProc_Share+pf_FS_IPDOT_Share)*gf_TDSPercent/100));
end;

