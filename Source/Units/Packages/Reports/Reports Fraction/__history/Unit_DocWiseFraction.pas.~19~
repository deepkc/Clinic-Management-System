                    Close;
                    sql.Clear;
                    sql.add(' Insert Into FractionLock_Log(FLLID,UserId,LockDate,LockTime,DocCode,DateFrom,DateTo) ');
                    sql.add(' Values('+IntToStr(GetMaxId('FractionLock_Log','FLLID'))+','+IntToStr(gi_UserId));
