procedure TForm_DocWiseFraction.DoctorFractionReport_OnlyDoctorPart;
Var i:Integer;
    ls_ReportTitle : String;
Begin
     IF RB_Detail.Checked=True Then
     Begin
          Table_DFDoctorPartDetail.Close;
          Table_DFDoctorPartDetail.DatabaseName:=gs_TempPath;
          Table_DFDoctorPartDetail.EmptyTable;
          Table_DFDoctorPartDetail.Open;

          IF (RB_OPIPBill.Checked=True) or (RB_OPBill.Checked=True) Then
          Begin
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add('Select RowNum as Sno,FRDE_BillDetailId BilldetailId,FRDE_BillType Billtype,FRDE_BillNo Billno,''CASH'' PayType,');
                    sql.add('FRDE_BillDate billdate,FRDE_DocID DocId,FRDE_PatientId patientid,(Select Trim(doct_Desig||'' ''||doct_DocName) From hs_doct_Doctor where doct_DocID=hs_FRDE_FractionDetail.FRDE_DocID) as DocName, ');
                    sql.add(' (select NLS_InitCap(PAMA_PatientName) From HS_PAmA_PatientMain where PAMA_PatientId=HS_FRDE_FractionDetail.FRDE_PatientId) as PatientName, ');
                    sql.add(' (Select Dept_DepName From Hs_Dept_Department where Dept_DepId=HS_FRDE_FractionDetail.FRDE_DepId) as Department,(select DEPT_DepName From HS_DEPT_Department where DEPT_DepId ');
                    sql.add(' In (Select DEPT_DepId From HS_DOCT_Doctor where DOCT_DocID=HS_FRDE_FractionDetail.FRDE_DocID and rownum=1)and rownum=1) as DocDept,(FRDE_UnitTestCost*FRDE_Qty)Amount,(FRDE_UnitTestCost*FRDE_Qty*FRDE_DisPer/100)Discount,');
                    sql.add('((FRDE_UnitTestCost*FRDE_Qty)-(FRDE_UnitTestCost*FRDE_Qty*FRDE_DisPer/100)) as TotalAmt,');
                    sql.add(' (FRDE_FractionAmount*FRDE_Qty) as DocComm,(FRDE_FractionAmount*FRDE_Qty - FRDE_FractionAmount*FRDE_Qty*FRDE_DisPer/100) as DocCommNet,');
                    sql.add(' ((FRDE_FractionAmount*FRDE_Qty - FRDE_FractionAmount*FRDE_Qty*FRDE_DisPer/100) * FRDE_TDSPer / 100 ) as TDS,Case when FRDE_BillType=''R''');
                    sql.add(' Then ''OPD Consultation'' Else (Select InitCap(TENA_TestName) From HS_TENA_TestName where TENA_TestNameCode=HS_FRDE_FractionDetail.FRDE_TestNameCode) End TestName,FRDE_Description Description ');
                    sql.add(' From HS_FRDE_FractionDetail ');

                    IF CB_Reg.Checked=True Then
                    sql.add(' where FRDE_billtype=''R''')
                    Else
                    sql.add(' where FRDE_billtype In (''R'',''B'') ');

                    IF DBLC_Doctor.KeyValue<>NULL Then
                    sql.add(' and FRDE_DocID='+IntToStr(DBLC_Doctor.KeyValue));

                    sql.add(' and FRDE_DocID Not In (0,1)'); // 1- Hospital

                    SQL.Add('and FRDE_BILLDETAILID>0');
                    //sql.add(' and DocCode<>''HOS01'' and DocCode<>''-''');

                    sql.add(' and FRDE_billdate >='+#39+DateEditX_FromDate.Text+#39+' and FRDE_billdate <='+#39+DateEditX_ToDate.Text+#39);
                    //SQL.Add(' AND TESTNAMECODE NOT IN(SELECT TESTNAMECODE FROM TESTNAME WHERE TESTTYPE=''LAB'')');
                    sql.add(' Union '); { Refund part }
                    sql.add(' Select RowNum as Sno,FRRD_FRACTIONDETAILID FRACTIONDETAILID,FRRD_BillType Billtype, FRRD_RefundBillNo Billno,''REFUND'' PayType,FRRD_REFUNDDATE BillDate,FRRD_DocID DocId,FRRD_PatientId PatientId, ');
                    sql.add('hs_doct_doctor.doct_docname,(select NLS_InitCap(PAMA_PatientName) From HS_PAMA_PatientMain where ');
                    sql.add(' PAMA_PatientId=HS_FRRD_FRACTIONREFUNDDETAIL.FRRD_PatientId) as PatientName, (Select DEPT_DepName From HS_DEPT_Department where DEPT_DepId=HS_FRRD_FRACTIONREFUNDDETAIL.FRRD_DepId) ');
                    sql.add(' as Department,(select DEPT_DepName From Hs_Dept_Department where DEPT_DepId In (Select DEPT_DepId From Hs_DOCT_Doctor where DOCT_DocID=HS_FRRD_FRACTIONREFUNDDETAIL.FRRD_DocID and rownum=1)and rownum=1) as DocDept,');
                    sql.add('(FRRD_UnitTestCost*FRRD_Qty)Amount,(FRRD_UnitTestCost*FRRD_Qty*FRRD_DisPer/100)Discount,((FRRD_UnitTestCost*FRRD_Qty)-(FRRD_UnitTestCost*FRRD_Qty*FRRD_DisPer/100)) as TotalAmt,(FRRD_FractionAmount*FRRD_Qty) as DocComm, ');
                    sql.add(' (FRRD_FractionAmount*FRRD_Qty - FRRD_FractionAmount*FRRD_Qty*FRRD_DisPer/100) as DocCommNet,((FRRD_FractionAmount*FRRD_Qty - FRRD_FractionAmount*FRRD_Qty*FRRD_DisPer/100) * FRRD_TDSPer / 100 ) as TDS,');
                    sql.add(' Case when FRRD_BillType=''R'' Then ''OPD Consultation'' Else (Select InitCap(TENA_TestName) From HS_TENA_TestName ');
                    sql.add(' where tena_TestNameCode=HS_FRRD_FRACTIONREFUNDDETAIL.FRRD_TestNameCode and rownum=1) End TestName,FRRD_Description Description');
                    sql.add(' From HS_FRRD_FRACTIONREFUNDDETAIL ,HS_DOCT_Doctor');
                    sql.add('where   HS_FRRD_FRACTIONREFUNDDETAIL.FRRD_DOCID=HS_DOCT_Doctor.doct_DocId(+)');

                    IF CB_Reg.Checked=True Then
                    sql.add(' and FRRD_billtype=''R''')
                    Else
                    sql.add(' and FRRD_billtype In (''R'',''B'') ');

                    IF Trim(DBLC_Doctor.Text)<>'' Then
                    sql.add(' and FRRD_DocID='+IntToStr(DBLC_Doctor.KeyValue));

                    sql.add(' and FRRD_DocID Not In (0,1)');

                    sql.add(' and FRRD_RefundDate >='+#39+DateEditX_FromDate.Text+#39+' and FRRD_RefundDate <='+#39+DateEditX_ToDate.Text+#39);
                   // SQL.Add(' AND TESTNAMECODE NOT IN(SELECT TESTNAMECODE FROM TESTNAME WHERE TESTTYPE=''LAB'')');
                    sql.add(' Order by PayType,BillDate,BillNo');
                    sql.saveToFile('C:\DocFractOP.Txt');
                    Open;
                    First;
                    While not EOF Do
                    Begin
                         With Table_DFDoctorPartDetail do
                         Begin
                              Append;
                              //FieldByName('DocCode').AsString:=Query_Process.FieldByName('DocCode').AsString;
                              FieldByName('DocID').AsInteger:=Query_Process.FieldByName('DocId').AsInteger;
                              FieldByName('DocName').AsString:=Query_Process.FieldByName('DocName').AsString;
                              FieldByName('BillType').AsString:=Query_Process.FieldByName('BillType').AsString;
                              FieldByName('PayType').AsString:=Query_Process.FieldByName('PayType').AsString;
                              FieldByName('BillDate').AsString:=Query_Process.FieldByName('BillDate').AsString;

                              FieldByName('PatientId').AsInteger:=Query_Process.FieldByName('PatientId').AsInteger;
                              FieldByName('PatientName').AsString:=Query_Process.FieldByName('PatientName').AsString;

                              IF Trim(Query_Process.FieldByName('TestName').AsString)<>'' Then
                              Begin
                                   FieldByName('Service').AsString:=Query_Process.FieldByName('TestName').AsString;
                                   FieldByName('BillNo').AsString:=Query_Process.FieldByName('BillNo').AsString;
                              End
                              Else
                              Begin
                                   //FieldByName('PatientName').AsString:='-';
                                   FieldByName('Service').AsString:=Query_Process.FieldByName('Description').AsString;
                                   FieldByName('BillNo').AsString:='-';
                              End;
                              FieldByName('DocDept').AsString:=Query_Process.FieldByName('Department').AsString;
                              FieldByName('Department').AsString:=Query_Process.FieldByName('Department').AsString;

                              //FieldByName('ISOT').AsString:=Query_Process.FieldByName('IsOperation').AsString;
                              FieldByName('BillAmount').AsFloat:=Query_Process.FieldByName('Amount').AsFloat;
                              FieldByName('Discount').AsFloat:=Query_Process.FieldByName('Discount').AsFloat;
                              FieldByName('NetAmount').AsFloat:=Query_Process.FieldByName('TotalAmt').AsFloat;
                              FieldByName('DrAmount').AsFloat:=Query_Process.FieldByName('DocCommNet').AsFloat;
                              FieldByName('TDS').AsFloat:=Query_Process.FieldByName('TDS').AsFloat;
                              FieldByName('NetDrAmount').AsFloat:=(Query_Process.FieldByName('DocCommNet').AsFloat - Query_Process.FieldByName('TDS').AsFloat);
                              Post;
                         End;
                         Next;
                    End;
               End;
          End;

          IF (RB_OPIPBill.Checked=True) or (RB_IPBill.Checked=True) Then
          Begin
               with Query_Process do
               begin
                    Close;
                    DatabaseName := gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add('Select * From  hs_frde_fractiondetail where frde_testnamecode=''IPCON'' and frde_inpatientid>0 and frde_disper=0 and frde_fractionamount=0');
                    SQL.Add('and frde_fractionid=800 and frde_billdate>=''2017/07/01''');
                    Open;
                    First;
                    while not Eof do
                    begin
                         if (UpperCase(Query_Process.FieldByName('TestName').AsString)='DOCTOR ROUND CHARGE')and (Query_Process.FieldByName('TotalAmt').AsFloat>0 ) and (Query_Process.FieldByName('DocCommNet').AsFloat=0) then
                         begin
                              with Query_SubProcess do
                              begin
                                   Close;
                                   DatabaseName := gs_DatabaseName;
                                   SQL.Clear;
                                   SQL.Add('Update HS_FRDE_FractionDetail Set frde_fractionamount=frde_unittestcost*frde_qty,frde_fractionrate=100 Where Frde_fractionDetailid='+IntToStr(Query_Process.FieldByName('FRDE_FRACTIONDETAILID').AsInteger));
                                   ExecSQL;
                              end;
                         end;
                         Next;
                    end;
               end;
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    //sql.add(' Select RowNum as Sno,FRDE_BillDetailId BilldetailId,FRDE_BillNo BillNo,''CASH'' PayType,Frde_BillDate Billdate,FRDE_DisDate DisDate,FRDE_DocID DocId,FRDE_InpatientId InpatientId,FRDE_PatientId PatientId,');
                    {Fraction Realization after Discharge}
                    sql.add(' Select RowNum as Sno,Frde_FractionDetailid FractionDetailid,FRDE_BillDetailId BilldetailId,FRDE_BillNo BillNo,''CASH'' PayType,FRDE_DISDATE Billdate,FRDE_DisDate DisDate,FRDE_DocID DocId,FRDE_InpatientId InpatientId,FRDE_PatientId PatientId,');
                    sql.add('(Select Trim(DOct_Desig||'' ''||DOct_DocName) From Hs_DOct_Doctor where Doct_DocID=HS_FRDE_FractionDetail.FRDE_DocID) as DocName,');
                    sql.add(' (select NLS_InitCap(Pama_PatientName) From Hs_Pama_PatientMain where Pama_PatientId=HS_FRDE_FractionDetail.FRDE_PatientId) as PatientName, ');
                    sql.add(' (Select Dept_DepName From Hs_Dept_Department where Dept_DepId=HS_FRDE_FractionDetail.FRDE_DepId) as Department,');
                    sql.add(' (select Dept_DepName From Hs_Dept_Department where Dept_DepCode In (Select DOCT_DEPCODE From Hs_Doct_Doctor where Doct_DocId=HS_FRDE_FractionDetail.FRDE_DocID and rownum=1)) as DocDept,');
                    sql.add(' case when FRDE_TestNameCode=''IPCON'' then ''Doctor Round Charge'' Else (Select NLS_InitCap(Tena_TestName) From Hs_Tena_TestName');
                    sql.add('where Tena_TestNameCode=HS_FRDE_FractionDetail.FRDE_TESTNAMECODE) End TestName,');
                    sql.add('(FRDE_UnitTestCost*FRDE_Qty)Amount,(FRDE_UnitTestCost*FRDE_Qty*FRDE_DisPer/100)Discount,((FRDE_UnitTestCost*FRDE_Qty)-(FRDE_UnitTestCost*FRDE_Qty*FRDE_DisPer/100)) as TotalAmt,(FRDE_FractionAmount*FRDE_Qty) as DocComm,');
                    sql.add('(FRDE_FractionAmount*FRDE_Qty - FRDE_FractionAmount*FRDE_Qty * FRDE_DisPer/100) as DocCommNet,');
