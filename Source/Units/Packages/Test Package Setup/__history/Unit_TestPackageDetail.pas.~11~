procedure TForm_TestPackageDetail.LoadData;
Var
     i: integer;
begin
     with Query_Blank do
     begin
          close;
          Databasename := gs_DatabaseName;
          SQL.Clear;
          if CheckBox_All.Checked = true then
               SQL.Add('select Tena_TestnameId TEstNameId,Tena_TestName TestName from Hs_Tena_testname where Tena_isactive=''Y'' ')
          else if (CheckBox_All.Checked = False) And (DBLC_DepName.KeyValue > 0) then
          begin
               SQL.Add('select Tena_TestnameId TEstNameId,Tena_TestName TestName from Hs_Tena_testname where Tena_isactive=''Y''');
               SQL.Add('and Tena_depid=' + IntToStr(DBLC_DepName.KeyValue));
          end;
          SQL.Add('Order by TestName');
          Open;
     end;
     Clb_TestName.Items.Clear;
     i := 0;
     SetLength(Arr_TestNameId, Query_Blank.RecordCount);
     while not Query_Blank.Eof do
     begin
          Clb_TestName.Items.Add(Query_Blank.FieldByName('TestName').AsString);
          Arr_TestNameId[i] := Query_Blank.FieldByName('TestNameId').AsString;
          Inc(i);
          Query_Blank.Next;
     end;
end;

procedure TForm_TestPackageDetail.Rb_CheckBoxViewClick(Sender: TObject);
begin
     if Rb_CheckBoxView.Checked then
          DBGrid1.Visible := False
     else
     begin
          if DBLC_TestPackageName.KeyValue = null then
          begin
               ShowMessage('Please choose TestPackage');
               exit;
          end;
          DBGrid1.Visible := true;
          with Query_Grid do
          begin
               close;
               SQL[5] := 'Where TEPD_TestPackageId=' + IntToStr(DBLC_TestPackageName.KeyValue);
               Open;
          end;
     end;
end;

procedure TForm_TestPackageDetail.SaveData;
Var
     i, TestPackageId: integer;
     IsActive: string;
begin
     TestPackageId := DBLC_TestPackageName.KeyValue;
     for i := 0 to Clb_TestName.Items.Count - 1 do
     begin
          if Clb_TestName.State[i] = cbChecked then
          begin
               IsActive := 'Y';
               Try
                    dm.DM_Hospital.DB.StartTransaction;
                    DeleteTestPackgeDetail(TestPackageId, StrToInt(Arr_TestNameId[i]));
                    SaveTestPackageDetail(TestPackageId, StrToInt(Arr_TestNameId[i]), IntToStr(gi_UserID), TodaysDate, TodaysTime, IsActive, '', '');
                    dm.DM_Hospital.DB.Commit;
               Except
                    dm.DM_Hospital.DB.Rollback;
               End;
          end
          else
          begin
               DeleteTestPackgeDetail(TestPackageId, StrToInt(Arr_TestNameId[i]));
          end;
     end;
end;

procedure TForm_TestPackageDetail.SpeedButton2Click(Sender: TObject);
begin
     Try
