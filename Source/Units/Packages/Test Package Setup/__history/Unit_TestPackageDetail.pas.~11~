     begin
          DBLC_DepName.KeyValue := null;
          DBLC_DepName.Enabled := true;
     end;
end;

procedure TForm_TestPackageDetail.DBLC_DepNameClick(Sender: TObject);
begin
     LoadData;
     if DBLC_TestPackageName.KeyValue > 0 then
          DBLC_TestPackageNameClick(Sender);

end;

procedure TForm_TestPackageDetail.DBLC_TestPackageNameClick(Sender: TObject);
Var
     i: integer;
begin
     with Query_Blank do
     begin
          close;
          Session := DM_Hospital.DB;
          SQL.Clear;
          SQL.Add('Select * From HS_TEPD_TestPackageDetail');
          SQL.Add('Where TEPD_TestPackageID=' + IntToStr(DBLC_TestPackageName.KeyValue));
          Open;
          for i := 0 to Clb_TestName.Items.Count - 1 do
          begin
               Clb_TestName.State[i] := cbUnchecked;
          end;
          while Not Eof do
          begin
               for i := 0 to Clb_TestName.Items.Count - 1 do
               begin
                    if Arr_TestNameId[i] = Query_Blank.FieldByName('TEPD_TestNameId').AsString then
                    begin
                         Clb_TestName.State[i] := cbChecked;
                         Break;
                    end;
               end;
               Next;
          end;
     end;
     with Query_Grid do
     begin
          close;
          SQL[5] := 'Where TEPD_TestPackageId=' + IntToStr(DBLC_TestPackageName.KeyValue);
          Open;
     end;
end;

procedure TForm_TestPackageDetail.DisplayTestname;
var
     i: integer;
begin
     with Query_Blank do
     begin
          close;
          Databasename := gs_DatabaseName;
          SQL.Clear;
          SQL.Add('select * from testname where isactive=''Y'' ');
          SQL.Add('and depid=' + IntToStr(DBLC_DepName.KeyValue));
          Open;
     end;
     Clb_TestName.Items.Clear;
     i := 0;
     SetLength(Arr_TestNameId, Query_Blank.RecordCount);
     while not Query_Blank.Eof do
     begin
          Clb_TestName.Items.Add(Query_Blank.FieldByName('TestName').AsString);
          Arr_TestNameId[i] := Query_Blank.FieldByName('TestNameId').AsString;
          Inc(i);
          Query_Blank.Next;
     end;
end;

procedure TForm_TestPackageDetail.Edit_TestNameChange(Sender: TObject);
begin
     if (Trim(Edit_TestName.Text) <> '') then
     begin
          DBGrid_Search.BringToFront;
          with DBGrid_Search do
          begin
               left := 515;
               Top := 87;
               Height := 175;
               Width := 405;
               Visible := true;
          end;
          with Query_TestName do
          begin
               close;
               SQL[1] := 'Where Trim(TestName)=' + #39 + Trim(Edit_TestName.Text) + #39;
               if Cb_Extended.Checked = true then
                    SQL[1] := 'Where Trim(TestName) like' + #39 + '%' + Trim(Edit_TestName.Text) + '%' + #39
               else
                    SQL[1] := 'Where Trim(TestName) Like ' + #39 + Trim(Edit_TestName.Text) + '%' + #39;
               if DBLC_DepName.KeyValue <> null then
                    SQL[2] := 'And DepId =' + IntToStr(DBLC_DepName.KeyValue)
               else
                    SQL[2] := 'And 99=99';
               Open;
          end;
     end
     else
          DBGrid_Search.Visible := False;
end;

procedure TForm_TestPackageDetail.Edit_TestNameKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
     if Key = vk_up then
          Query_TestName.Prior
     else if Key = vk_down then
          Query_TestName.Next
end;

procedure TForm_TestPackageDetail.Edit_TestNameKeyPress(Sender: TObject; var Key: Char);
begin
     if Key = #13 then
     begin
          SB_AddClick(Sender);
          DBGrid_Search.Visible := False;
