procedure TForm_TestPackageDetail.CheckBox_AllClick(Sender: TObject);
begin
     if CheckBox_All.Checked then
     begin
          LoadData;
          DBLC_DepName.Enabled := False;
          DBLC_DepName.KeyValue := null;
     end
