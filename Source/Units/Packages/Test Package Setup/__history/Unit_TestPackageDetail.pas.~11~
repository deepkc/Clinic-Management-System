          Form_TestPackageNameSetup.ShowModal;
     Finally
          Form_TestPackageNameSetup.Free;
          RefreshQuery(Query_TestName, gs_DatabaseName);
     End;
end;

procedure TForm_TestPackageDetail.SB_AddClick(Sender: TObject);
Var
     i, j: integer;
begin
     i := Query_TestName.FieldByName('TestNameId').AsInteger;
     j := IndexOfArray(IntToStr(i), Arr_TestNameId);
     Try
          if Clb_TestName.State[j] = cbUnchecked then
               Clb_TestName.State[j] := cbChecked
          else
               Clb_TestName.State[j] := cbUnchecked;
     Except
          ShowMessage('No Record');
     End;
     Edit_TestName.Clear;
     Edit_TestName.SetFocus;
end;

