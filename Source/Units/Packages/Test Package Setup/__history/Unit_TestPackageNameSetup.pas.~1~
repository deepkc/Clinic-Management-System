procedure TForm_TestPackageNameSetup.Le_TestPriceFExit(Sender: TObject);
Var
     x, p, y: Double;
begin
     if Le_TestPriceF.Text = '' then
          exit;
     y := StrToFloat(Le_TestPriceF.Text);
     p := gf_TaxPercent;
     if CB_IncSvrTax.Checked = true then
     begin
          x := (100 * y) / (100 + p);
          pf_testpricefrg := x;
          pf_VatFrg := (p * x) / 100;
     end
     else
     begin
          x := (p * y) / 100;
          pf_testpricefrg := y;
          pf_VatFrg := x;
     end;
     Edit_TaxAmtF.Text := format('%.4f', [pf_VatFrg]);
end;

