procedure TForm_TestPackageNameSetup.BB_SaveClick(Sender: TObject);
Var
     ISVATABLE, ISEDITABLE, ISACTIVE, ISOT, ISDISCOUNTABLE, ISPACKAGETEST, ISFRACTIONABLEITEM, WORKLIST,
     TESTNAMETITLE, TESTNAME, TNCATEGORYCODE, REMARKS, DATAPOSTDATE, DATAPOSTTIME,HIDETESTINPATIENTLIST: String;
     DEPID, DATAPOSTBY,SAMPLESOURCEID,DISPLAYORDER: integer;
     TESTPRICE, VAT, TESTPRICEFOREIGNER, TAXFRG: Double;

begin
     if  (Le_TestPackageName.Text = '') or (Le_TestPackageTitle.Text = '') or (Le_TestPriceG.Text = '') then
     begin
          MsgBox(1004, 0, '', '', '');
          exit;
     end;
     { SaveTestName(TESTNAMECODE, TESTNAME, TNCATEGORYCODE, REMARKS, DATAPOSTDATE, DATAPOSTTIME: String;
       DEPID, DATAPOSTBY: integer; TESTPRICE, VAT, TESTPRICEFOREIGNER, TAXFRG: Double; ISVATABLE, ISEDITABLE, ISACTIVE,
       ISOT, ISDISCOUNTABLE, ISPACKAGETEST, ISFRACTIONABLEITEM: Boolean) }

     TESTNAMETITLE := Le_TestPackageTitle.Text;
     TESTNAME := Le_TestPackageName.Text;
     if Dblcb_TestNameCategory.KeyValue = null then
          TNCATEGORYCODE :=''
     else
          TNCATEGORYCODE := Dblcb_TestNameCategory.KeyValue;
     if DBlcb_SampleSource.KeyValue<>NULL then
     SAMPLESOURCEID:=DBlcb_SampleSource.KeyValue;
     REMARKS := Le_Remarks.Text;
     DATAPOSTDATE := TodaysDate;
     DATAPOSTTIME := TodaysTime;
     //DEPID := Dblcb_DepNew.KeyValue;
     DATAPOSTBY := gi_UserID;
     TESTPRICE := StrToFloat(format('%.4f', [pf_testprice]));
     VAT := StrToFloat(format('%.4f', [pf_vat]));
     TESTPRICEFOREIGNER := StrToFloat(format('%.4f', [pf_testpricefrg]));
     TAXFRG := StrToFloat(format('%.4f', [pf_VatFrg]));
     if CB_IsTaxable.Checked = true then
          ISVATABLE :='Y'
     else
          ISVATABLE := 'N';
     if Cb_IsEditable.Checked = true then
          ISEDITABLE :='Y'
     else
          ISEDITABLE := 'N';
     if CB_IsActive.Checked = true then
          ISACTIVE := 'Y'
     else
          ISACTIVE := 'N';
//     if Cb_IsOt.Checked = true then
//          ISOT := 'Y'
//     else
//          ISOT := 'N';
     if CB_IsDicountable.Checked = true then
          ISDISCOUNTABLE := 'Y'
     else
          ISDISCOUNTABLE := 'N';
//     if CB_WorkList.Checked = true then
//          WORKLIST :='Y'
//     else
//          WORKLIST := 'N';
     ISPACKAGETEST := 'N';
     ISFRACTIONABLEITEM := 'N';
     if le_Order.Text<>'' then
     DISPLAYORDER:=StrToInt(le_Order.Text)
     ELSE
     DISPLAYORDER:=0;
//
//     if CB_HideAllTestInPatientList.Checked=True then
//          HIDETESTINPATIENTLIST:='Y'
//     Else
//          HIDETESTINPATIENTLIST:='N';


     try
          DM_Hospital.DB.StartTransaction;

               if pb_isnew then
               begin
                    SaveTestPackage(SAMPLESOURCEID, DATAPOSTBY,DISPLAYORDER, TESTPRICE, VAT, TESTPRICEFOREIGNER, TAXFRG,TESTNAME,TESTNAMETITLE, TNCATEGORYCODE, REMARKS,
                     DATAPOSTDATE, DATAPOSTTIME, HIDETESTINPATIENTLIST, ISVATABLE, ISEDITABLE, ISACTIVE, ISDISCOUNTABLE,
                     ISPACKAGETEST, ISFRACTIONABLEITEM, WORKLIST);
                     ShowDoneMessage;
               end
               else
               begin
                    UpdateTestPackage(TESTPACKAGEID,SAMPLESOURCEID, DATAPOSTBY,DISPLAYORDER, TESTPRICE, VAT, TESTPRICEFOREIGNER, TAXFRG,TESTNAME,TESTNAMETITLE, TNCATEGORYCODE, REMARKS,
                    DATAPOSTDATE, DATAPOSTTIME, HIDETESTINPATIENTLIST, ISVATABLE, ISEDITABLE, ISACTIVE, ISDISCOUNTABLE, ISPACKAGETEST, ISFRACTIONABLEITEM, WORKLIST);
                    ShowDoneMessage;

               end;



          DM_Hospital.DB.Commit;
          pb_isnew := true;

          ClearAll(PageControl1.Pages[1]);
          //Dblcb_DepNew.KeyValue := DEPID;
     except
          DM_Hospital.DB.Rollback;
          MsgBox(1005, 0, '', '', '');
     end;

end;

procedure TForm_TestPackageNameSetup.DBGrid1DblClick(Sender: TObject);
begin
     pb_isnew := false;
     PageControl1.ActivePageIndex := 1;
     with Query_list do
     begin
          //Dblcb_DepNew.KeyValue := FieldByName('Depid').AsInteger;
          Le_TestPackageTitle.Text := FieldByName('TEPA_TestPackageTitle').AsString;
          Le_TestPackageName.Text := FieldByName('TEPA_TestPackageName').AsString;
          Le_TestPriceG.Text := FloatToStr(FieldByName('TEPA_TestPrice').AsFloat + FieldByName('TEPA_Vat').AsFloat);
          Le_TestPriceF.Text := FloatToStr(FieldByName('TEPA_TestPriceForeigner').AsFloat + FieldByName('TEPA_TaxFrg').AsFloat);
          Le_Remarks.Text := FieldByName('TEPA_Remarks').AsString;
          le_Order.Text:= FieldByName('TEPA_DisplayOrder').AsString;
          if FieldByName('TEPA_IsActive').AsString = 'Y' then
               CB_IsActive.Checked := true
          else
               CB_IsActive.Checked := false;
//          if FieldByName('IsOT').AsString = 'Y' then
//               Cb_IsOt.Checked := true
//          else
//               Cb_IsOt.Checked := false;
          if FieldByName('TEPA_IsDiscountable').AsString = 'Y' then
               CB_IsDicountable.Checked := true
          else
               CB_IsDicountable.Checked := false;
          if FieldByName('TEPA_IsVatable').AsString = 'Y' then
               CB_IsTaxable.Checked := true
          else
               CB_IsTaxable.Checked := false;
          if FieldByName('TEPA_IsEditable').AsString = 'Y' then
               Cb_IsEditable.Checked := true
          else
               Cb_IsEditable.Checked := false;
//          if FieldByName('Worklist').AsString = 'Y' then
//               CB_WorkList.Checked := true
//          else
//               CB_WorkList.Checked := false;

//          if FieldByName('HIDETESTINPATIENTLIST').AsString = 'Y' then
//               CB_HideAllTestInPatientList.Checked := true
//          else
//               CB_HideAllTestInPatientList.Checked := false;

          gi_TestNameId := FieldByName('TEPA_TestPackageid').AsInteger;
          pf_testprice := FieldByName('TEPA_TestPrice').AsFloat + FieldByName('TEPA_Vat').AsFloat;
          pf_vat := FieldByName('TEPA_Vat').AsFloat;
          pf_testpricefrg := FieldByName('TEPA_TestPriceForeigner').AsFloat + FieldByName('TEPA_TaxFrg').AsFloat;
          pf_VatFrg := FieldByName('TEPA_TaxFrg').AsFloat;
          Edit_TaxG.Text := FloatToStr(gf_TaxPercent);
          Edit_TaxF.Text := FloatToStr(gf_TaxPercent);
          Edit_TaxAmtG.Text := FieldByName('TEPA_Vat').AsString;
          TESTPACKAGEID:=Query_list.FieldByName('TEPA_testpackageid').AsInteger;
          Edit_TaxAmtF.Text := FieldByName('TEPA_TaxFrg').AsString;
          if FieldByName('TEPA_SampleSourceId').AsString<>'' then
          DBlcb_SampleSource.KeyValue:=FieldByName('TEPA_SampleSourceId').AsInteger;
          Le_TestPriceGExit(Sender);
          Le_TestPriceFExit(Sender);

     end;
end;

procedure TForm_TestPackageNameSetup.Edit_SearchChange(Sender: TObject);
begin
     Edit_Search.Text := StringReplace(Edit_Search.Text, '''', '''''', [rfReplaceAll]);
     with Query_list do
     Begin
          IF Trim(Edit_Search.Text) <> '' Then
          Begin
               Filter := 'TTestName =' + #39 + Trim(Edit_Search.Text) + '*' + #39;
               Filtered := true;
          End
          Else
               Filtered := false;
     End;
end;

