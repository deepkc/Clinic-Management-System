  object Query_Grid: TOraQuery
    SQL.Strings = (
      'SELECT ROWNUM AS SN , A.* FROM ('
      
        'Select TEPD_testpackageid TestPackageId,(Select Tena_TestName Fr' +
        'om Hs_Tena_Testname where Tena_testnameid=td.TEPD_testpackageid)' +
        'TestPackage,TEPD_testnameid TestNameID'
      
        ',(Select Tena_TestName From Hs_Tena_Testname where Tena_testname' +
        'id=td.TEPD_testnameid)TEstName'
      ',TEPD_isActive IsActive'
      'from HS_TEPD_TestPackageDetail td'
      'WHERE 1=1'
      
        'order by (SELECT Tena_DISPLAYORDER FROM Hs_Tena_TESTNAME WHERE T' +
        'ena_TESTNAMEID=TD.TEPD_TESTNAMEID)'
      ')A')
    Left = 696
    Top = 176
  end
