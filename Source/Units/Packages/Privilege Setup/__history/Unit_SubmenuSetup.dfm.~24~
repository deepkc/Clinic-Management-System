  object Query_List: TQuery
    SQL.Strings = (
      
        'select sume_submenuid submainmenuid,sume_submenu as submenu,sume' +
        '_priority priority,(select mame_mainmenu from hs_mame_mainmenu w' +
        'here mame_mainmenuid=hs_sume_submenu.sume_mainmenuid)mainmenu,'
      
        '(select modu_modulename from hs_modu_module where modu_moduleid=' +
        '(select mame_moduleid from hs_mame_mainmenu where mame_mainmenui' +
        'd=hs_sume_submenu.sume_mainmenuid))ModuleName,'
      
        '(select mame_moduleid from hs_mame_mainmenu where mame_mainmenui' +
        'd=hs_sume_submenu.sume_mainmenuid)ModuleId'
      ' from hs_sume_submenu'
      'order by modulename,mainmenu,sume_submenu')
    Left = 272
    Top = 224
  end
