  object Query_List: TQuery
    SQL.Strings = (
      
        'select submenuid,mainmenuid,functionname,functionid,(select main' +
        'menu from mainmenu where mainmenuid=systemfunction.mainmenuid)ma' +
        'inmenu,'
      
        '(select submenu from submenu where submenuid=systemfunction.subm' +
        'enuid)submenu,'
      
        '(select modulename from module where moduleid=(select moduleid f' +
        'rom mainmenu where mainmenuid=systemfunction.mainmenuid))ModuleN' +
        'ame,'
      
        '(select moduleid from mainmenu where mainmenuid=systemfunction.m' +
        'ainmenuid)ModuleId'
      ' from systemfunction'
      ' order by modulename,mainmenu,submenu,functionname')
    Left = 664
