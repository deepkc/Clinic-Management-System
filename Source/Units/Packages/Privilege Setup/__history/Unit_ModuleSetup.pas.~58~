unit Unit_ModuleSetup;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, ExtCtrls, Grids, StdCtrls, Buttons, DBGrids, DB, DBTables, DBAccess,
   Ora, OraSmart, MemDS, OraError,fxn,unit_master,dm;

type
  TForm_ModuleSetup = class(TForm)
    DBGrid1: TDBGrid;
    Panel_Main: TPanel;
    DS_Module: TDataSource;
    Query_Module: TOraQuery;
    Edit_GroupName: TEdit;
    StaticText1: TStaticText;
    Query_Group: TOraQuery;
    Panel2: TPanel;
    BitBtn1: TBitBtn;
    BB_Close: TBitBtn;
    BB_New: TBitBtn;
    procedure BtnSaveClick(Sender: TObject);
    procedure BtnCancelClick(Sender: TObject);
    procedure DBGrid1DblClick(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure BtnNewClick(Sender: TObject);
    procedure FormKeyPress(Sender: TObject; var Key: Char);
    procedure BB_NewClick(Sender: TObject);
    procedure BB_CloseClick(Sender: TObject);
  private
    { Private declarations }
  public
  pb_isNew:Boolean;
  pi_moduleid:integer;
    { Public declarations }
  end;

var
  Form_ModuleSetup: TForm_ModuleSetup;

implementation

{$R *.dfm}

procedure TForm_ModuleSetup.BB_CloseClick(Sender: TObject);
begin
     Close;
end;

procedure TForm_ModuleSetup.BB_NewClick(Sender: TObject);
begin
        pb_isNew:=true;
         Edit_GroupName.Clear;
end;

procedure TForm_ModuleSetup.BtnCancelClick(Sender: TObject);
begin
    close;
end;

procedure TForm_ModuleSetup.BtnNewClick(Sender: TObject);
begin
    pb_isNew:=true;
    Edit_GroupName.Clear;
end;

procedure TForm_ModuleSetup.BtnSaveClick(Sender: TObject);
begin
     if Edit_GroupName.Text='' then
       begin
               MessageDlg('Missing Name', mtInformation, [mbOK], 0);
               exit;
       end;

     if pb_isNew=True then
     begin
          with Query_Group do
          begin

               close;
               session:=DM_Hospital.DB;
               sql.clear;
               pi_moduleid:=GetMaxId('hs_modu_Module','modu_Moduleid');
               sql.Add('Insert into hs_modu_Module(modu_Moduleid,modu_ModuleName)');
               sql.Add( 'Values ('+IntToStr(pi_moduleid)+','+#39+Edit_GroupName.Text+#39);
               sql.Add(')');
               ExecSQL;
               ShowDoneMessage;
          end;
     end
     else
     begin
          with Query_Group do
          begin
               close;
               sql.Clear;
               session:=DM_Hospital.DB;
               sql.Add('Update hs_modu_Module set modu_Modulename='+#39+Edit_GroupName.Text+#39);
               sql.Add('where modu_Moduleid='+IntToStr(pi_moduleid));
               execsql;
               ShowDoneMessage;
          end;
     end;
     with Query_Module do
      begin
           close;
           session:=DM_Hospital.DB;
           open;
      end;
      pb_isNew:=true;
      Edit_GroupName.Clear;

end;

procedure TForm_ModuleSetup.DBGrid1DblClick(Sender: TObject);
begin
     pb_isNew:=false;
     pi_moduleid:=Query_Module.FieldByName('modu_Moduleid').AsInteger;
     Edit_GroupName.text:= Query_Module.FieldByName('modu_ModuleName').asstring;

end;

procedure TForm_ModuleSetup.FormKeyPress(Sender: TObject; var Key: Char);
begin
     if key=#27 then
     close;
end;

procedure TForm_ModuleSetup.FormShow(Sender: TObject);
begin
     pb_isNew:=true;
      with Query_Module do
      begin
           close;
           session:=DM_Hospital.DB;
           open;
      end;
end;

end.
