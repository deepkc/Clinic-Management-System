package MedicalHistory;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  dbrtl,
  vcldb,
  vclimg,
  bdertl,
  dex,
  QR5RunD2010,
  Global,
  MidasFunction;

contains
  Unit_MedicalHistoryFrame in 'Unit_MedicalHistoryFrame.pas' {Frame_Diagnosis: TFrame},
  Unit_MedicalHistoryParent in 'Unit_MedicalHistoryParent.pas' {Form_MedicalHistoryParent},
  Unit_MedicalHistoryInvestigation in 'Unit_MedicalHistoryInvestigation.pas' {Frame_Investigation: TFrame},
  Unit_InvestigationDetail in 'Unit_InvestigationDetail.pas' {Frame_InvestigationDetail: TFrame};

end.
