package NewPatient;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  Global,
  MidasFunction,
  DelphiTwainPackage,
  Tee,
  BarcodeD10,
  Billing_D;

contains
  Unit_NewPatient in 'Unit_NewPatient.pas' {Frame_NewPatient: TFrame},
  VFrames in 'VFrames.pas',
  VSample in 'VSample.pas',
  Camera in 'Camera.pas' {Form_Camera},
  Frame_Video in 'Frame_Video.pas' {Frame1: TFrame};

end.
