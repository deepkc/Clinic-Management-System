          Label4: TLabel;
          Label6: TLabel;
          Edit_OpDiscount: TEdit;
          Label8: TLabel;
          Edit_IpDiscount: TEdit;
          DBGrid2: TDBGrid;
          Label1: TLabel;
          Query_scheme: TOraQuery;
