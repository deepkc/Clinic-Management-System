package CommunitySchemeSetup;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  dbrtl,
  vcldb,
  bdertl,
  vcldbx,
  Global,
  MidasFunction;

contains
  Unit_BenefitPackageSetup in 'Unit_BenefitPackageSetup.pas' {Form_BenefitPackageSetup},
  Unit_Schemes in 'Unit_Schemes.pas' {Form_Schemes},
  Unit_PackageScheme in 'Unit_PackageScheme.pas' {Form_PackageScheme},
  Unit_Community in 'Unit_Community.pas' {Form_Community},
  Unit_SchemeDetail in 'Unit_SchemeDetail.pas' {Form_SchemeDetail};

end.
