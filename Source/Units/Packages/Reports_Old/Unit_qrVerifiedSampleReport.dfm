  object OraQuery_Main: TOraQuery
    SQL.Strings = (
      
        'select rownum as sno,d.* from (select ae.* from VW_SAMPLE_COLLEC' +
        'TED ae'
      'where ae.deptype='#39'RADIOLOGY'#39
      'and ae.testdate='#39'2072/10/01'#39
      'and ae.TESTPROGRESSSTATUS in(5,6)'
      'and 1=1'
      'and 1=1'
      ')d'
      'where d.deptype='#39'RADIOLOGY'#39
      'order by sno')
    FetchRows = 2000
    Left = 168
    Top = 8
  end
