procedure TForm_DepartmentWiseSummary.BitBtnPreviewClick(Sender: TObject);
 Var TempPath,ls_ReportTitle,ls_PatientCategory:String;
     I:Integer;
begin
     for I := 0 to CheckListBox_Department.Count - 1 do
     begin
          if CheckListBox_Department.Checked[I] then
          begin
               if ls_PatientCategory='' then
                    ls_PatientCategory:=Quotedstr(CheckListBox_Department.Items[I])
               else
               begin
                    ls_PatientCategory:=ls_PatientCategory+','+Quotedstr(CheckListBox_Department.Items[I]);
               end;
          end;
     end;

     DateEditX_FromDate.SystemOfDate:=gi_DateSystem;
     DateEditX_ToDate.SystemOfDate:=gi_DateSystem;

     IF CheckBox_TaxAnalysis.Checked=False Then
     CreateTempTable
     Else
     CreateTempTableDetail;

     Table_DepartmentWiseSummary.Close;
     Table_DepartmentWiseSummary.EmptyTable;
     Table_DepartmentWiseSummary.Exclusive:=True;
     Table_DepartmentWiseSummary.Open;


     UpdateOTProcedureStatus;

     If gi_datesystem = 0 Then
     Begin
          ps_FromDate:= DateEditX_FromDate.VSDateAsText + ' BS(' +DateEditX_FromDate.ADDateAsText + ' AD)';
          ps_ToDate:= DateEditX_ToDate.VSDateAsText + ' BS(' + DateEditX_ToDate.ADDateAsText +' AD)';
     End
     Else
     Begin
          ps_FromDate := DateEditX_FromDate.ADDateAsText + ' AD(' +DateEditX_FromDate.VSDateAsText + ' BS)';
          ps_ToDate := DateEditX_ToDate.ADDateAsText + ' AD(' + DateEditX_ToDate.VSDateAsText +' BS)';
     End;

     if DBLC_Department.Text<>'' then
     Begin
          DepartmentWiseDetail;
          Exit;
     End;


     if CB_DayWiseRevenueReport.Checked=True then
     begin
          RevenueDayWise;
          Exit;
     end;

     IF CheckBox_TaxAnalysis.Checked=False Then
     Begin
          IF RadioButton_OPCollection.Checked=True Then
          Begin
               IF CheckBoxLandSacpe.Checked=False Then
               Begin
                    With FormReportBillDepWiseSumary Do
                    Begin
                         Try
                              Query_TempCollection.DatabaseName:=gs_TempPath;
                              Query_TempCollection.Close;
                              Query_TempCollection.Open;

                              With Query_OPDeposit do
                              Begin
                                   Close;
                                   ParamByName('FromDate').AsString:=DateEditX_FromDate.Text;
                                   ParamByName('Todate').AsString:=DateEditX_ToDate.Text;
                                   Open;
                              End;

                              with Query_CommunityRefund do
                              Begin
                                   Close;
                                   ParamByName('FromDate').AsString:=DateEditX_FromDate.Text;
                                   ParamByName('Todate').AsString:=DateEditX_ToDate.Text;
                                   sql[4]:='AND (BILLTYPE=''B'') And PayType=''REFUND'' And Service=''OPREF''';
                                   Open;
                              End;
                              QRLabelFrom.Caption:=DateEditX_FromDate.Text;
                              QRLabelTo.Caption:=DateEditX_ToDate.Text;
                              QRLabelToday.Caption:=ServerDate.TodaysDate;
                              QRLabel20.Caption:='Department Wise Revenue( OP )';
                              pi_Sno:=1;
                              QuickRep1.Preview;
                         Finally
                              Query_RegAmount.Close;
                              Query_TempCollection.Close;
                         End;
                    End;
               End
               Else
               Begin
                    With Form_QRDepWiseSumaryLandScape Do
                    Begin
                         Try
                               With Query_RevenueCollection do
                               Begin
                                    Close;
                                    Session := DM_Hospital.DB;
                                    SQL.Clear;
                                    SQL.Add(' Select  DepName,Round(Sum(CashTotal),2) as CashTotal,Round(Sum(CreditTotal),2) as CreditTotal,Round(Sum(CashTotal+CreditTotal),2) as Total,');
                                    if gs_TaxSystem='VAT' then
                                    Begin
                                         SQL.Add(' Round(Sum(Discount),2) as Discount,Round(Sum(CashVatAmt),2) as CashVAT,Round(Sum(CreditVatAmt),2) as CreditVAT,Round(Sum(RefundTotal),2) as RefundTotal,');
                                         SQL.Add(' Sum(RefundDiscount) as RefundDiscount,Sum(RefundVatAmt) as RefundVAT,');
                                    End
                                    Else
                                    Begin
                                         SQL.Add(' Round(Sum(Discount),2) as Discount,Round(Sum(CashVatAmt),2) as CashSvrTax,Round(Sum(CreditVatAmt),2) as CreditSvrTax,Round(Sum(RefundTotal),2) as RefundTotal,');
                                         SQL.Add(' Sum(RefundDiscount) as RefundDiscount,Sum(RefundVatAmt) as RefundSvrTax,');
                                    End;
                                    SQL.Add(' Round(Sum((CashTotal+CreditTotal+CashVatAmt+CreditVatAmt+RefundDiscount)-(Discount+RefundTotal+RefundVatAmt)),2) as NetTotal');
                                    SQL.Add(' From VW_HS_DEPT_WISE_REVENUE');
                                    SQL.Add(' where BillDate>='+#39+DateEditX_FromDate.text+#39+' and BillDate<='+#39+DateEditX_ToDate.text+#39);
                                    SQL.Add(' and BillType In (''R'',''B'')');
                                    SQL.Add(' Group By DepName');
                                    SQL.Add(' Order by DepName');
                                    Open;
                               End;


                               With QueryDeposit do
                               Begin
                                    Close;
                                    SQL.Clear;
                                    SQL.Add(' Select Sum(Deposit) as Deposit,Sum(AdjustedDeposit) AdjustedDeposit From (');
                                    SQL.Add(' Select NVL(Sum(DEPO_DrAmount),0) as Deposit,NVL(Sum(DEPO_CrAmount),0) as AdjustedDeposit,0 as Cols');
                                    SQL.Add(' From HS_DEPO_Deposit where DEPO_DepositDate>='+#39+DateEditX_FromDate.text+#39+' and DEPO_DepositDate<='+#39+DateEditX_ToDate.text+#39);
                                    SQL.Add(' and DEPO_InpatientId=0');
                                    SQL.Add(' Union');
                                    SQL.Add(' Select NVL(Sum(ReceivedAmount-ReceivedAmount*CopayDisPer/100),0) as Deposit, 0 as AdjustedDeposit,1 as Cols');
                                    SQL.Add(' From CreditPayment where ReceiptDate>='+#39+DateEditX_FromDate.text+#39+' and ReceiptDate<='+#39+DateEditX_ToDate.text+#39);
                                    SQL.Add(' and PayType=''CASH'' and BillType=''OP''');
                                    SQL.Add(' Union');
                                    SQL.Add(' Select 0 as Deposit,NVL(Sum(ReceivedAmount-ReceivedAmount*CopayDisPer/100),0)  as AdjustedDeposit,2 as Cols');
                                    SQL.Add(' From CreditPayment where ReceiptDate>='+#39+DateEditX_FromDate.text+#39+' and ReceiptDate<='+#39+DateEditX_ToDate.text+#39);
                                    SQL.Add(' and PayType=''REFUND'' and BillType=''OP''');
                                    SQL.Add(' )');
                                    Open;
                               End;

                               with Query_CommunityRefund do
                               Begin
                                    Close;
                                    SQL.Clear;
                                    SQL.Add(' Select NVL(Sum(Amount),0) as RefundTotal From CommunityRefund');
                                    SQL.Add(' where BillDate>='+#39+DateEditX_FromDate.Text+#39+' and BillDate<='+#39+DateEditX_ToDate.Text+#39);
                                    SQL.Add(' and BillType=''B''');
                                    Open;
                               End;

                               with Query_TotalSummary do
                               Begin
                                    Close;
                                    SQL.Clear;
                                    SQL.Add(' Select Round(Sum(CashDiscount),2) as CashDiscount,');
                                    SQL.Add(' Sum((CreditTotal+CreditVatAmt+CreditRefundDiscount)-(CreditRefundTotal+CreditRefundVatAmt+CreditDiscount)) as NetCreditAmount');
                                    SQL.Add(' From VW_HS_DEPT_WISE_REVENUE');
                                    SQL.Add(' where BillDate>='+#39+DateEditX_FromDate.Text+#39+' and BillDate<='+#39+DateEditX_ToDate.Text+#39);
                                    SQL.Add(' and BillType In (''R'',''B'')');
                                    Open;
                               End;

                               IF CB_ReferralDeptBasis.Checked=False Then
                               ls_ReportTitle:='Department Wise Revenue( OP )'
                               Else
                               ls_ReportTitle:='Referral Department Wise Revenue( OP )';

                               IF pb_SendToExcel=True Then
                               Begin
                                    with Query_total do
                                    Begin
                                         Close;
                                         Session := DM_Hospital.DB;
                                         sql.Clear;
                                         SQL.Add(' Select   Round(Sum(CashTotal),2) as CashTotal,Round(Sum(CreditTotal),2) as CreditTotal,Round(Sum(CashTotal+CreditTotal),2) as Total,');
                                         SQL.Add(' Round(Sum(Discount),2) as Discount,Round(Sum(CashVatAmt),2) as CashSvrTax,Round(Sum(CreditVatAmt),2) as CreditSvrTax,Round(Sum(RefundTotal),2) as RefundTotal,');
                                         SQL.Add(' Sum(RefundDiscount) as RefundDiscount,Sum(RefundVatAmt) as RefundSvrTax,');
                                         SQL.Add(' Round(Sum((CashTotal+CreditTotal+CashVatAmt+CreditVatAmt+RefundDiscount)-(Discount+RefundTotal+RefundVatAmt)),2) as NetTotal');
                                         SQL.Add(' From VW_HS_DEPT_WISE_REVENUE');
                                         SQL.Add(' where BillDate>='+#39+DateEditX_FromDate.text+#39+' and BillDate<='+#39+DateEditX_ToDate.text+#39);
                                         SQL.Add(' and BillType In (''R'',''B'')');
                                         SQL.SaveToFile('c:\tt.txt');
                                         Open;
                                    End;

                                    pf_TotalCashAmt:=Query_total.FieldByName('CashTotal').AsFloat;
                                    pf_TotalCreditAmt:=Query_total.FieldByName('CreditTotal').AsFloat;
                                    pf_TotalSvrTax:=Query_total.FieldByName('CashSvrTax').AsFloat+Query_total.FieldByName('CreditSvrTax').AsFloat;

                                    pf_TotalRevenue:=pf_TotalCashAmt +pf_TotalCreditAmt+ pf_TotalSvrTax;

                                    pf_TotalRefAmt:=Query_total.FieldByName('RefundTotal').AsFloat;
                                    pf_TotalRefSvrTax:=Query_total.FieldByName('REFUNDSVRTAX').AsFloat;

                                    pf_CommuityRefund:=Query_CommunityRefund.FieldByName('RefundTotal').AsFloat;


                                    pf_NetTotalRevenue:=pf_TotalRevenue-pf_TotalRefAmt-pf_TotalRefSvrTax-pf_CommuityRefund;

                                    pf_DepositTotal :=QueryDeposit.FieldByName('Deposit').AsFloat;

                                    pf_AdjDepositTotal :=QueryDeposit.FieldByName('AdjustedDeposit').AsFloat;

                                    pf_NetCreditTotal:=Query_TotalSummary.FieldByName('NetCreditAmount').AsFloat;
                                    pf_CreditRefund:=0;//Query_TotalSummary.FieldByName('NetCrRefund').AsFloat;

                                    pf_NetCreditAfterRefund:=pf_NetCreditTotal - pf_CreditRefund;

                                    pf_CashDiscount:=Query_TotalSummary.FieldByName('CashDiscount').AsFloat;

                                    pf_NetTotalCashColn:=pf_NetTotalRevenue + pf_DepositTotal - pf_AdjDepositTotal -pf_NetCreditAfterRefund -pf_CashDiscount;

                                    SendToExcelsDeptWise(Query_RevenueCollection,Nil,ls_ReportTitle,'  From :'+DateEditX_FromDate.Text+'      To :'+DateEditX_ToDate.Text,
                                                        '',gs_HospitalName,gs_HospitalAddress,2);
                                    pb_SendToExcel := False;
                                    Exit;
                               End
                               Else
                               begin
                                    QRLabelFrom.Caption:=ps_FromDate;
                                    QRLabelTo.Caption:=ps_ToDate;
                                    QRLabel_PrintDate.Caption:=TodaysDate;
                                    QRLabel20.Caption:=ls_ReportTitle;
                                    pi_Sno:=1;
                                    Net_Amount:=0;

                                    if gs_TaxSystem='VAT' then
                                    Begin
                                         QRDBText7.DataField:='CashVAT';
                                         QRDBText2.DataField:='CREDITVAT';
                                         QRDBText8.DataField:='RefundVAT';


                                         QRExpr6.Expression:='SUM(Query_RevenueCollection.CashVAT)';
                                         QRExpr20.Expression:='SUM(Query_RevenueCollection.CREDITVAT)';
                                         QRExpr25.Expression:='SUM(Query_RevenueCollection.CASHVAT+Query_RevenueCollection.CREDITVAT)';
                                         QRExpr22.Expression:='Sum(Query_RevenueCollection.TOTAL+Query_RevenueCollection.CASHVAT+Query_RevenueCollection.CREDITVAT)';
                                         QRExpr29.Expression:='SUM(Query_RevenueCollection.RefundVAT)';

                                         QRExpr26.Expression:='SUM(Query_RevenueCollection.REFUNDVAT)';
                                         QRExpr23.Expression:='Sum(Query_RevenueCollection.TOTAL+Query_RevenueCollection.CASHVAT+Query_RevenueCollection.CREDITVAT)-SUM(Query_RevenueCollection.RefundTotal-Query_RevenueCollection.REFUNDDISCOUNT)-SUM(Query_RevenueCollection.REFUNDVAT)';

                                    End
                                    else
                                    begin
                                         QRDBText7.DataField:='CashSvrTax';
                                         QRDBText2.DataField:='CreditSvrTax';
                                         QRDBText8.DataField:='RefundSvrTax';


                                         QRExpr6.Expression:='SUM(Query_RevenueCollection.CashSvrTax)';
                                         QRExpr20.Expression:='SUM(Query_RevenueCollection.CreditSvrTax)';
                                         QRExpr25.Expression:='SUM(Query_RevenueCollection.CASHSVRTAX+Query_RevenueCollection.CREDITSVRTAX)';
                                         QRExpr22.Expression:='Sum(Query_RevenueCollection.TOTAL+Query_RevenueCollection.CASHSVRTAX+Query_RevenueCollection.CREDITSVRTAX)';
                                         QRExpr29.Expression:='SUM(Query_RevenueCollection.RefundSvrTax)';

                                         QRExpr26.Expression:='SUM(Query_RevenueCollection.RefundSvrTax)';
                                         QRExpr23.Expression:='Sum(Query_RevenueCollection.TOTAL+Query_RevenueCollection.CASHSVRTAX+Query_RevenueCollection.CREDITSVRTAX)-SUM(Query_RevenueCollection.RefundTotal-Query_RevenueCollection.REFUNDDISCOUNT)-SUM(Query_RevenueCollection.REFUNDSVRTAX)';
                                    end;

                                     if CB_DirectPrint.Checked=False then
                                     QuickRep1.Preview
                                     else
                                     QuickRep1.Print;
                               end;
                         Finally
                               Query_TotalSummary.Close;
                               QueryDeposit.Close;
                               Query_CommunityRefund.Close;
                               Query_RevenueCollection.Close;
                         End;
                    End;
               End;
          End
          Else If (RadioButton_IPCollection.Checked=True) or (RadioButton_IPOPCollection.Checked=True) then
          Begin
               if RG_IP.ItemIndex=1 then
               begin
                    FormQRBillDepWiseRevDID:= TFormQRBillDepWiseRevDID.Create(Self);
                    With FormQRBillDepWiseRevDID do
                    begin
                         With Query_RevDID Do
                         begin
                              Close;
                              Session := DM_Hospital.DB;
                              sql.Clear;
                              SQL.Add('SELECT ROWNUM AS SN,A.* FROM (');
                              sql.Add('SELECT UPPER(SERVICE) SERVICE, SUM(AMOUNT) AMOUNT,SUM(DISCOUNT) DISCOUNT,');
                              sql.Add('SUM(NETAMOUNT) NETAMOUNT,SUM(VATAMT) VATAMT,SUM(TOTALAMOUNT) TOTALAMOUNT ');
                              sql.Add('FROM VW_HS_DEPTWISE_DISINDEPO');
                              sql.Add('WHERE DISINDEPOSITDATE>='+#39+DateEditX_FromDate.text+#39+' AND DISINDEPOSITDATE<='+#39+DateEditX_ToDate.text+#39+'');
                              if ls_PatientCategory<>'' then
                                   sql.add('and PatientCategory in ('+ls_PatientCategory+')')
                              else
                                   sql.Add('and 1=1');
                              sql.Add('GROUP BY SERVICE)A');
                              //SQL.SaveToFile('D:\VW.TXT');
                              Open;
                         end;
                         QRLabel_HosName.Caption:= gs_HospitalName;
                         QRLabel_HosSloganTitle.Caption:= gs_HosSloganTitle;
                         QRLabel_HosAddress.Caption:= gs_HospitalAddress;
                         QRLabel_RepTitle.Caption:='Department Wise Discharge In Deposit Collection';
                         QRLabelFrom.Caption:=DateEditX_FromDate.text;
                         QRLabelTo.Caption:= DateEditX_ToDate.text;

                         With QueryDeposit do
                         Begin
                              Close;
                              Session := DM_Hospital.DB;
                              SQL.Clear;
                              SQL.Add(' Select Sum(Deposit) as Deposit,Sum(AdjustedDeposit) AdjustedDeposit From (');
                              SQL.Add(' Select NVL(Sum(DEPO_DrAmount),0) as Deposit,NVL(Sum(DEPO_CrAmount),0) as AdjustedDeposit,0 as Cols');
                              sql.add(' From HS_DEPO_Deposit');
                              SQL.Add(' Where DEPO_DepositDate>='+#39+DateEditX_FromDate.text+#39+' and DEPO_DepositDate<='+#39+DateEditX_ToDate.text+#39);
                              if RadioButton_IPCollection.Checked=True then
                              SQL.Add(' and DEPO_InpatientId > 0');
                              if RG_IP.ItemIndex=1 then
                              begin
                                  sql.add(' AND depo_inpatientid in (select inre_inpatientid from HS_INRE_INPATIENTREG where INRE_DISDATE IS NULL');
                                  sql.Add(' AND INRE_ISDISCHARGED = ''N'' AND INRE_ISDISINDEPOSIT=''Y'')');
                              end;
                              SQL.Add(' and DEPO_IsCrDisDepositAdjust=''N''');
                              if ls_PatientCategory<>'' then
                                   sql.add('and Depo_PatientCategory in ('+ls_PatientCategory+')')
                              else
                                   sql.Add('and 1=1');
                              SQL.Add(' Union');
                              SQL.Add(' Select NVL(Sum(ReceivedAmount-ReceivedAmount*CopayDisPer/100),0) as Deposit, 0 as AdjustedDeposit,1 as Cols');
                              sql.add(' From CreditPayment');
                              SQL.Add(' Where ReceiptDate>='+#39+DateEditX_FromDate.text+#39+' and ReceiptDate<='+#39+DateEditX_ToDate.text+#39);
                              SQL.Add(' and PayType=''CASH''');
                              if RadioButton_IPCollection.Checked=True then
                              SQL.Add(' and BillType=''IP''');
                              if RG_IP.ItemIndex=1 then
                              begin
                                  sql.add(' AND CreditPayment.inpatientid in (select inre_inpatientid from HS_INRE_INPATIENTREG where INRE_DISDATE IS NULL');
