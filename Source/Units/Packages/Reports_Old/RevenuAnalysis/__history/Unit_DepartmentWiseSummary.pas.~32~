Procedure TForm_DepartmentWiseSummary.UpdateOTProcedureStatus;
Begin
     With QueryProcess Do
     Begin
          Close;
          DataBaseName:=gs_DatabaseName;
          sql.Clear;
          sql.add(' Update HS_BIDE_BillDetail Set BIDE_IsOt=''N'' where NVL(BIDE_IsOt,''B'')=''B''');
          ExecSQL;

          sql.Clear;
          sql.add(' Update HS_REDE_RefundDetail Set REDE_IsOt=''N'' where NVL(REDE_IsOt,''B'')=''B''');
          ExecSQL;

          Close;
          DataBaseName:=gs_DatabaseName;
          sql.Clear;
          sql.add(' Update HS_BIDE_BillDetail Set BIDE_ISOT=''Y'' where BIDE_Service In (');
          sql.add(' Select TENA_TestNameCode From HS_TENA_TestName where TENA_TESTNAMETYPE In (''P'',''O''))');
          sql.add(' and BIDE_ISOT=''N'' and BIDE_BillDate >='+#39+DateEditX_FromDate.text+#39+' and BIDE_BillDate <='+#39+DateEditX_ToDate.text+#39);
          ExecSQL;

          sql.Clear;
          sql.add(' Update HS_REDE_RefundDetail Set REDE_ISOT=''Y'' where REDE_Service In (');
          sql.add(' Select TENA_TestNameCode From HS_TENA_TestName where TENA_TESTNAMETYPE In (''P'',''O''))');
          sql.add(' and REDE_ISOT=''N'' and REDE_REFUNDDATE >='+#39+DateEditX_FromDate.text+#39+' and REDE_REFUNDDATE <='+#39+DateEditX_ToDate.text+#39);
          ExecSQL;


          sql.Clear;
          sql.add(' Update HS_BIDE_BillDetail Set BIDE_PayType=''CREDIT'' where BIDE_PayType Is null and BIDE_BillNo Like ''CR%''');
          ExecSQL;

          sql.Clear;
          sql.add(' Update HS_BIDE_BillDetail Set BIDE_PayType=''CASH'' where BIDE_PayType Is null and BIDE_BillNo Like ''CS%''');
          ExecSQL;
     End;
End;


Procedure TForm_DepartmentWiseSummary.DepartmentWiseDetail;
Begin
     With QueryProcess do
     Begin
          if (DBLC_Department.Text<>'DOCTOR CHARGES') and (DBLC_Department.Text<>'ASSISTANT CHARGES') and (DBLC_Department.Text<>'S.CHARGE') then
          Begin
               Close;
               DatabaseName:=gs_DatabaseName;
               sql.Clear;
               sql.Add(' Select depname,BILLDATE,SERVICETYPE,sum(cashtotal) CashTotal,sum(CreditTotal)CREDITTOTAL,sum(Total)total,');
               sql.Add(' Round(Sum(Discount),2) as Discount,Round(Sum(CashSvrTax),2) as CashSvrTax,Round(Sum(CreditSvrTax),2) as CreditSvrTax');
               sql.Add(' ,Round(Sum(RefundTotal),2) as RefundTotal,Sum(RefundDiscount) as RefundDiscount,Sum(RefundSvrTax) as RefundSvrTax,');
               sql.Add(' Round(Sum(cashtotal+CreditTotal+CashSvrTax+CreditSvrTax-Discount-(RefundTotal+RefundSvrTax-RefundDiscount)),2) as NetTotal from');
               sql.Add(' (');
               sql.Add(' Select DepName,BILLDATE,SERVICETYPE,Sum(CashTotal-CashGrossFraction-CashGrossSCharge) as CashTotal,Sum(CreditTotal-CreditGrossFraction-CreditGrossSCharge) as CreditTotal,');
               sql.Add(' Sum(CashTotal+CreditTotal-CashGrossFraction-CreditGrossFraction-CashGrossSCharge-CreditGrossSCharge) Total,');
               sql.Add(' Sum(Discount-Abs(NetCashFraction-CashFractionTax-CASHGROSSFRACTION)-Abs(NetCreditFraction-CreditFractionTax-CreditGROSSFRACTION)');
               sql.Add(' -Abs(NetCashSCharge-CashSChargeTax-CashGrossSCharge)-Abs(NetCreditSCharge-CreditSChargeTax-CreditGrossSCharge)) as Discount,');
               sql.Add(' Sum(CashVatAmt-CashFractionTax-CashSChargeTax) as CashSvrTax,Sum(CreditVatAmt-CreditFractionTax-CreditSChargeTax) as CreditSvrTax,');
               sql.Add(' Round(Sum(RefundTotal-(CashRefundGrossFraction+CreditRefundGrossFraction)-(CashRefundGrossSCharge+CreditRefundGrossSCharge)),2) as RefundTotal,');
               sql.Add(' Sum(RefundDiscount-Abs(NetCashRefundFraction-CashRefundFractionTax-CashRefundGrossFraction)-Abs(NetCreditRefundFraction-CreditRefundFractionTax-CreditRefundGrossFraction)');
               sql.Add(' -Abs(NetCashRefundSCharge-CashRefundSChargeTax-CashRefundGrossSCharge)-Abs(NetCreditRefundSCharge-CreditRefundSChargeTax-CreditRefundGrossSCharge)) as RefundDiscount,');
               sql.Add(' Sum(RefundVatAmt-(CashRefundFractionTax+CreditRefundFractionTax)-(CashRefundSChargeTax+CreditRefundSChargeTax)) as RefundSvrTax');
               sql.Add(' From (');
               sql.Add(' SELECT case when (select DEPT_DEPTYPE from hs_dept_department where dept_depid=depid)=''P'' then ''PATHOLOGY''');
               sql.Add(' when (select DEPT_DEPTYPE from hs_dept_department where dept_depid=depid)=''R'' then ''RADIOLOGY'' else DepName end depname,');
               sql.Add(' BILLDATE,SERVICETYPE,CashTotal,CreditTotal,CashDiscount,CreditDiscount,Discount,CashVatAmt,CreditVatAmt,VatAmt,');
