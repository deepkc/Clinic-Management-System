procedure TForm_PatienttestHistory.BitBtn_SearchClick(Sender: TObject);
begin
      if Edit_PatientSearch.Text='' then
    begin
        ShowMessage('Please input Patient No.');
        Edit_PatientSearch.SetFocus;
        exit;
    end;
    with OraQuery_Patient do
          begin
               Close;
               Session:=DM_Hospital.DB;
               SQL.Clear;
               sql.Add('select * from VW_Patienthistory where patientid='+Edit_PatientSearch.Text);
               sql.Add('and testdate between '+QuotedStr(DateEditX_From.text)+'and'+QuotedStr(DateEditX_To.text));
               if DBLookupComboBox_Department.KeyValue<>null then
               SQL.Add('and depid='+IntToStr(DBLookupComboBox_Department.KeyValue));
               if DBLookupComboBox_TestName.KeyValue<>null then
               SQL.Add('and testnameid='+IntToStr(DBLookupComboBox_TestName.KeyValue));
               SQL.Add('order by testdate,realsampleno,deporder,testdisplayorder');
               Open;
          end;
          Label_PatientName.Caption:=OraQuery_Patient.FieldByName('patientname').AsString;
          Label_AgeSex.Caption:=OraQuery_Patient.FieldByName('agesex').AsString;
end;

