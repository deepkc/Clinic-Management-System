procedure TForm_PatienttestHistory.BitBtn_OkClick(Sender: TObject);
var
OraQryData: TOraQuery;
li_Count: integer;
ListField: TStringList;

begin
    ListFIeld := TStringList.Create();
    OraQryData := TOraQuery.Create(nil);
    with OraQryData do
    begin
        Session:=DM_Hospital.DB;
        //qryData.SQL.Add('select testdate,finding from vw_patienthistory where testid=14 and patientid=100 and finding is not null');
        OraQryData.sql.Add('select testdate,replace(finding,'','')as finding from VW_Patienthistory where patientid='+OraQuery_Patient.FieldByName('patientid').AsString);
        OraQryData.SQL.Add('and testid='+OraQuery_Patient.FieldByName('testid').AsString);
        OraQryData.sql.Add('and testdate between '+QuotedStr(DateEditX_From.text)+'and'+QuotedStr(DateEditX_To.text));
        OraQryData.sql.add('and finding is not null');
        OraQryData.SQL.Add('order by testdate,realsampleno,deporder,testdisplayorder');
        //oraqryData.SQL.SaveToFile('c:\graph.txt');
        OraQryData.Active := True;
    end;


    DBChart_BarChart.Title.Text.Clear;
    DBChart_BarChart.Title.Text.Add('Analysis of '+trim(OraQuery_Patient.FieldByName('testtype').AsString));
    DBChart_BarChart.Title.Font.Size := 14;
    DBChart_BarChart.LeftAxis.Title.Font.Size := 12;
    DBChart_BarChart.LeftAxis.Title.Caption := 'Findings';
    DBChart_BarChart.BottomAxis.Title.Font.Size := 12;
    DBChart_BarChart.BottomAxis.Title.Caption := 'Test Date';

    //Charting Series
    //To Remove Old Series                                m
    for li_Count := DBChart_BarChart.SeriesCount -1 downto 0 do
        DBChart_BarChart.Series[li_Count].Free;
        //To Add New Series
    for li_Count := 1 to OraQryData.FieldCount - 1 do begin
        ListField.Add(OraQryData.FieldList[li_Count].FieldName);
        DBChart_BarChart.AddSeries(TBarSeries.Create(nil));
    end;
    //To set source for Series
    for li_Count:= 0 to DBChart_BarChart.SeriesCount -1 do begin
      with  DBChart_BarChart do begin
        Series[li_Count].Clear;
        Series[li_Count].Title := ListField[li_Count];
        Series[li_Count].ParentChart := DBChart_BarChart;
        Series[li_Count].DataSource := OraQryData;
        Series[li_Count].XLabelsSource := 'testdate';
        Series[li_Count].YValues.ValueSource := ListField[li_Count];
      end;
    end;
end;


