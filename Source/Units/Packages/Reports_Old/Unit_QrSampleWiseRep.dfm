  object orqry_main: TOraQuery
    Session = DM_Hospital.DB
    SQL.Strings = (
      'select rownum as sno,a.* from ('
      
        'select pt.patientid,pt.patienttestid,sampleno,(testdate||'#39' '#39'||te' +
        'sttime)billdatetime,SAMPLEtakenDATE||'#39' '#39'||SAMPLEtakenTime as sam' +
        'pleRecdatetime,'
      
        '(select username from lab_usermain where userid=sc.SAMPLEtakenBY' +
        ')SampleRecBy,'
      
        'FINDINGPOSTDATETIME as findingdatetime,(select username from lab' +
        '_usermain where userid=pt.FINDINGPOSTBY)findingBy,'
      
        'VERIFIEDDATETIME as verifieddatetime,(select username from lab_u' +
        'sermain where userid=pt.VERIFIEDBY)VerifiedBy from patienttest p' +
        't,samplecollection sc '
      'where pt.patienttestid=sc.patienttestid'
      'and SAMPLEtakenDATE between '#39'2014/05/27'#39' and '#39'2014/05/30'#39
      'and 1=1'
      'and 1=1'
      'and 1=1'
      'and 1=1'
      'order by patienttestid'
      ')a'
      'order by sno')
    FetchAll = True
    Left = 192
    Top = 10
  end
end
