  object Query_master: TOraQuery
    SQL.Strings = (
      
        'select distinct  t.tena_testname as testname,pt.depid,pt.patient' +
        'testid,pt.patientid,pr.labno,'
      
        '(select (pama_fname || '#39' '#39' || pama_mname || '#39' '#39' || pama_lname) f' +
        'rom hs_pama_patientmain where pama_patientid=pt.patientid)as pat' +
        'ientname,'
      
        '(select pama_regtime from hs_pama_patientmain where pama_patient' +
        'id=pt.patientid)as modifytime from patienttest pt,hs_tena_testna' +
        'me t,samplecollection pr'
      
        'where PT.TESTNAMEID=t.tena_testnameid and pt.patienttestid=pr.pa' +
        'tienttestid'
      '  --and T.tena_LINEEDIT='#39'T'#39
      'AND 1=1'
      '  and pt.patientid=pr.patientid'
      '   /*and pt.modifyby is null*/'
      'and  2=2'
      'and 1=1'
      'and 1=1'
      'order by patientname')
    Left = 168
    Top = 24
  end
