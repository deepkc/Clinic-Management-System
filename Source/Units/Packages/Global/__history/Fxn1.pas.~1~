Function GetRefDocNameFromPatientTest(PatientTestID: Integer): String;
Var
     Qry: TOraQuery;
begin
     Qry := TOraQuery.Create(nil);
     with Qry do
     begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          if gi_compileValue=3 then
              sql.Add('select (docname||'' ''||L_name) as drname from Doctor Where DocCode in (Select DocCode from ' + gs_Hos_DB_UserName + '.patienttest')
          else if gi_compileValue=11 then
              sql.Add('select doct_desig||'' ''||doct_docname as docname from hs_doct_Doctor Where doct_DocCode in (Select DocCode from ' + gs_Hos_DB_UserName + '.patienttest')
          else
              sql.Add('select doct_docname as docname from hs_doct_Doctor Where doct_DocCode in (Select DocCode from ' + gs_Hos_DB_UserName + '.patienttest');
          sql.Add('Where PatientTestID='+IntToStr(PatientTestID)+')');
          //sql.SaveToFile('maincheckdoc.txt');
          Open;

          if gi_compileValue=3 then
            Result := FieldByName('DrName').AsString
          else
            Result := FieldByName('DocName').AsString;
     end;
     Qry.Free;
end;

