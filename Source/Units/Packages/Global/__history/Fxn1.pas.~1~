Procedure LoadDataInRichEdit(Query: TQuery; RichEdit: TRichEdit; DataFieldName, ReportTitle: String);
var
     MyRich: TRichEdit;
     Form: TForm;
     Isnew: Boolean;
     ms: TMemoryStream;
     rtfString: AnsiString;
begin
     Isnew := True;
     Form := TForm.Create(nil);
     MyRich := TRichEdit.Create(nil);
     MyRich.Parent := Form;
     RichEdit.ReadOnly := False;
     RichEdit.Lines.Clear;
     Query.First;
     ms := TMemoryStream.Create;
     if Isnew = True then
     begin
          rtfString := ReportTitle;
          ms.Clear;
          ms.Write(PAnsiChar(rtfString)^, Length(rtfString));
          ms.Position := 0;

          MyRich.Lines.LoadFromStream(ms);
          AppendToRichEdit(MyRich, RichEdit);
     end;
     while not Query.Eof do
     begin
          rtfString := Query.FieldByName('' + DataFieldName + '').AsAnsiString;
          ms.Clear;
          ms.Write(PAnsiChar(rtfString)^, Length(rtfString));
          ms.Position := 0;

          MyRich.Lines.LoadFromStream(ms);

          AppendToRichEdit(MyRich, RichEdit);
          RichEdit.Lines.Add('');

          MyRich.Lines.Clear;
          Query.Next;
     end;
     ms.Free;
     RichEdit.ReadOnly := True;
     MyRich.Free;
     Form.Free;
end;

