     Query := TOraQuery.Create(nil);
     With Query do
     Begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.Add('Select MIN(TESTPROGRESSSTATUS) TESTPROGRESSSTATUS From PatientTest where BillNo=' + #39 + Billno + #39);
          Open;
          IF Query.FieldByName('TESTPROGRESSSTATUS').AsInteger >= 2 Then
               Result := True
          Else
               Result := False;
     End;
     Query.Free;
End;

