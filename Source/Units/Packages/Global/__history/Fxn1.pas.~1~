Function UpdateNewRefRange(MyTable: TTable): Boolean; Stdcall;
Var
     Qry: TQuery;
     Suffix, FinalRange: String;
Begin
     Qry := TQuery.Create(Nil);
     with MyTable do
     begin
          close;
          Open;
          while not Eof do
          begin
               with Qry do
               begin
                    close;
                    sql.Clear;
                    DatabaseName := gs_temppath;
                    sql.Add('Select * from Test Where TestID=' + MyTable.FieldByName('TestID').AsString);
                    Open;
                    with MyTable do
                    begin
                         Edit;
                         FieldByName('SpecialRange').AsString := Qry.FieldByName('SPECIALRANGE').AsString;
                         // if Qry.FieldByName('LRangeG').AsString <> '' then
                         FieldByName('LRange').AsString := Qry.FieldByName('LRangeG').AsString;

                         // if Qry.FieldByName('HRangeG').AsString <> '' then
                         FieldByName('HRange').AsString := Qry.FieldByName('HRangeG').AsString;
                         Suffix := ' ' + Qry.FieldByName('Suffix').AsString;

                         if Qry.FieldByName('LRangeG').AsString = '' then
                         begin
                              if StrToInt(Gs_Age) < 5 then
                                   FieldByName('Range').AsString := Qry.FieldByName('HRangeC').AsString + Suffix
                              else
                                   FieldByName('Range').AsString := Qry.FieldByName('HRangeG').AsString + Suffix;
                         end
                         else if Qry.FieldByName('HRangeG').AsString = '' then
                         begin
                              if StrToInt(Gs_Age) < 5 then
                                   FieldByName('Range').AsString := Qry.FieldByName('LRangeC').AsString + Suffix
                              else
                                   FieldByName('Range').AsString := Qry.FieldByName('LRangeG').AsString + Suffix;
                         end
                         else if (Qry.FieldByName('LRangeG').AsString <> '') and (Qry.FieldByName('HRangeG').AsString <> '') then
                         begin
                              if StrToInt(Gs_Age) < 5 then
                                   FieldByName('Range').AsString := Qry.FieldByName('LRangeC').AsString + '-' + Qry.FieldByName('HRangeC').AsString + Suffix
                              else
                                   FieldByName('Range').AsString := Qry.FieldByName('LRangeG').AsString + '-' + Qry.FieldByName('HRangeG').AsString + Suffix;
                         end;

                         if (FieldByName('LRange').AsString = '') and (FieldByName('HRange').AsString = '') then
                         begin
                              if Gs_Gender = 'MALE' then
                              begin
                                   FieldByName('LRange').AsString := Qry.FieldByName('LRangeM').AsString;
                                   FieldByName('HRange').AsString := Qry.FieldByName('HRangeM').AsString;
                                   FieldByName('LRangeM').AsString := Qry.FieldByName('LRangeM').AsString;
                                   FieldByName('HRangeM').AsString := Qry.FieldByName('HRangeM').AsString;
                                   if StrToInt(Gs_Age) < 5 then
                                   begin
                                        if Qry.FieldByName('HRangeC').AsString <> '' then
                                        FinalRange := Qry.FieldByName('LRangeC').AsString + '-' + Qry.FieldByName('HRangeC').AsString
                                        else
                                        FinalRange := Qry.FieldByName('LRangeC').AsString;
                                        FieldByName('Range').AsString := FinalRange + Suffix;
                                   end
                                   else if Qry.FieldByName('HRangeM').AsString <> '' then
                                        FinalRange := Qry.FieldByName('LRangeM').AsString + '-' + Qry.FieldByName('HRangeM').AsString
                                   else
                                        FinalRange := Qry.FieldByName('LRangeM').AsString;
                                   FieldByName('Range').AsString := FinalRange + Suffix;
                              end
                              else
                              begin
                                   FieldByName('LRange').AsString := Qry.FieldByName('LRangeF').AsString;
                                   FieldByName('HRange').AsString := Qry.FieldByName('HRangeF').AsString;
                                   FieldByName('LRangeF').AsString := Qry.FieldByName('LRangeF').AsString;
                                   FieldByName('HRangeF').AsString := Qry.FieldByName('HRangeF').AsString;
                                   if StrToInt(Gs_Age) < 5 then
                                   begin
                                        if Qry.FieldByName('HRangeC').AsString <> '' then
                                        FinalRange := Qry.FieldByName('LRangeC').AsString + '-' + Qry.FieldByName('HRangeC').AsString
                                        else
                                        FinalRange := Qry.FieldByName('LRangeC').AsString;
                                        FieldByName('Range').AsString := FinalRange + Suffix;
                                   end
                                   else if Qry.FieldByName('HRangeF').AsString <> '' then
                                        FinalRange := Qry.FieldByName('LRangeF').AsString + '-' + Qry.FieldByName('HRangeF').AsString
                                   else
                                        FinalRange := Qry.FieldByName('LRangeF').AsString;
                                   FieldByName('Range').AsString := FinalRange + Suffix
                              end;
                         end;
                         // if Trim(Qry.FieldByName('SpecialRange').AsString)<>'' then
                         // Begin
                         // if Trim(FieldByName('Range').AsString)='' then
                         // FieldByName('Range').AsString:=Qry.FieldByName('SpecialRange').AsString;
                         // End;
                         FieldByName('Unit').AsString := Qry.FieldByName('Unit').AsString;
                         FieldByName('Extra').AsString := Qry.FieldByName('Extra').AsString;
                         FieldByName('ExtraFinding').AsString := Qry.FieldByName('ExtraFinding').AsString;
                         Post;
                         Post;
                    end;
               end;
          end;
          Next;
     end;
     Qry.Free;
End;

procedure LoadFindings(TableName: TTable; PatientID, TestNameID, RepNo: integer);
Var
     Qry: TOraQuery;
     Qry_DefaultFinding: TOraQuery;
     Suffix, FinalRange: String;
     CurrAge: integer;
begin
     Qry := TOraQuery.Create(Nil);
     TableName.close;
     TableName.Open;
     with Qry do
     begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          // SQL.Add('Select to_number(Replace(GetCurrentAge('+IntToStr(PatientID)+'),''Y''))CurrAge');
//          sql.Add('Select to_number(Replace(Replace(Replace(GetCurrentAge(' + IntToStr(PatientID) + '),''Y''),''M''),''D''))CurrAge');
//          sql.Add('from dual');
//          Open;
//          CurrAge := FieldByName('CurrAge').AsInteger;

          sql.Add('Select Trim(Replace(Replace(Replace(GetCurrentAge(' + IntToStr(PatientID) + '),''Y''),''M''),''D''))CurrAge');
          sql.Add('from dual');
          Open;
          if FieldByName('CurrAge').AsString='N/A' then
               CurrAge:=0
          else
               CurrAge := FieldByName('CurrAge').AsInteger;

          sql.Clear;
          // sql.Add('Select * from Test Where TestnameId=' + IntToStr(TestNameID));
          sql.Add('select t.*,Trim(CAST(T.SPECIALRANGE AS VARCHAR2(250)))SPECIALRANGEMAIN');
          sql.Add(',(select Dept_deporder from '+gs_Hos_DB_UserName+'.Hs_Dept_department where Dept_depid in (select tena_depid from '+gs_Hos_DB_UserName+'.hs_tena_testname where tena_testnameid=t.testnameid))DeporderMain');
          sql.Add(',(Select tena_TestName From '+gs_Hos_DB_UserName+'.hs_tena_TestName Where tena_TestNameId=T.TestNameID)TestName');
          sql.Add(',(Select tena_DepId From '+gs_Hos_DB_UserName+'.hs_tena_TestName Where tena_TestNameId=T.TestNameID) DepId');
          sql.Add(',(Select TEFI_Findings From '+gs_Hos_DB_UserName+'.LB_TEFI_TestFinding Where TEFI_TestId=T.TestId and TEFI_IsDefaultFindings=''Y'' and RowNum=1) DefaultFindings');
          sql.Add('from test t where testnameid=' + IntToStr(TestNameID));
          sql.Add('And T.IsActive=''Y''');
          SQL.Add('And T.TestNameID in (Select tena_TestNameID From '+gs_Hos_DB_UserName+'.hs_tena_TestName where tena_Depid in ('+gs_UserDepId+'))');
          sql.Add('order by depordermain,t.testnameid,t.displayorder');
          //sql.SaveToFile('c:\ResultFinding.txt');
          Open;
          while not Eof do
          begin
               with TableName do
               begin
                    Qry_DefaultFinding := TOraQuery.Create(Nil);
                    with Qry_DefaultFinding do
                    begin
                        close;
                        Session := DM_Hospital.DB;
                        sql.Clear;
                        sql.Add('select * from LB_TEFI_TestFinding where TEFI_ISDEFAULTFINDINGS=''Y'' and TEFI_TESTID='+inttostr(Qry.FieldByName('TestID').AsInteger));
                        open;
                    end;
                    Append;
                    FieldByName('IsNew').AsString := 'Y';
                    FieldByName('TestName').AsString := Qry.FieldByName('TestName').AsString;
                    FieldByName('TestNameId').AsInteger := Qry.FieldByName('TestNameId').AsInteger;
                    FieldByName('DepId').AsInteger := Qry.FieldByName('DepId').AsInteger;
                    FieldByName('RepNo').AsInteger := RepNo;
                    FieldByName('PatienttestID').AsInteger := gi_PatientTestID;
                    FieldByName('TestDate').AsString := GetTestDate(gi_PatientTestID);
                    FieldByName('IsDefaultFinding').AsString := Qry_DefaultFinding.FieldByName('TEFI_ISDEFAULTFINDINGS').AsString;
                    FieldByName('TestID').AsInteger := Qry.FieldByName('TestID').AsInteger;
                    FieldByName('Test').AsString := Qry.FieldByName('Test').AsString;
                    FieldByName('IsHeading').AsString := Qry.FieldByName('IsHeading').AsString;

                    if Trim(Qry.FieldByName('DefaultFindings').AsString)<>'' then
                    begin
                        FieldByName('Finding').AsString := Qry.FieldByName('DefaultFindings').AsString;
                        FieldByName('IsDefaultFinding').AsString := Qry_DefaultFinding.FieldByName('TEFI_ISDEFAULTFINDINGS').AsString;
                    end
                    else
                    FieldByName('IsDefaultFinding').AsString :='N';

                    {if Trim(Qry.FieldByName('DefaultFindings').AsString)<>'' then
                    FieldByName('Finding').AsString := Qry.FieldByName('DefaultFindings').AsString; }

                    FieldByName('SpecialRange').AsString := Qry.FieldByName('SPECIALRANGEMAIN').AsString;
                    FieldByName('DisplayRange').AsString := Qry.FieldByName('DisplayRange').AsString;
                    Suffix := ' @' + Qry.FieldByName('Suffix').AsString;

                    if CurrAge < 5  then
                    begin
                         if Qry.FieldByName('LRangeC').AsString <> '' then
                              FieldByName('LRange').AsString := Qry.FieldByName('LRangeC').AsString;

                         if Qry.FieldByName('HRangeC').AsString <> '' then
                              FieldByName('HRange').AsString := Qry.FieldByName('HRangeC').AsString;
                    end
                    else
                    begin
                         if Gs_Gender = 'MALE' then
                         begin
                              if Qry.FieldByName('LRangeM').AsString <> '' then
                                   FieldByName('LRange').AsString := Qry.FieldByName('LRangeM').AsString;

                              if Qry.FieldByName('HRangeM').AsString <> '' then
                                   FieldByName('HRange').AsString := Qry.FieldByName('HRangeM').AsString;
                         end
                         else if Gs_Gender = 'FEMALE' then
                         begin
                              if Qry.FieldByName('LRangeF').AsString <> '' then
                                   FieldByName('LRange').AsString := Qry.FieldByName('LRangeF').AsString;

                              if Qry.FieldByName('HRangeF').AsString <> '' then
                                   FieldByName('HRange').AsString := Qry.FieldByName('HRangeF').AsString;
                         end;
                    end;

                    if (Trim(FieldByName('LRange').AsString) = '') And (Trim(FieldByName('HRange').AsString) = '') then
                    begin
                         FieldByName('LRange').AsString := Qry.FieldByName('LRangeG').AsString;
                         FieldByName('HRange').AsString := Qry.FieldByName('HRangeG').AsString;
                    end;

                    if (FieldByName('HRange').AsString <> '') and (FieldByName('LRange').AsString <> '') then
                         FinalRange := FieldByName('LRange').AsString + '-' + FieldByName('HRange').AsString
                    else if (FieldByName('HRange').AsString = '') then
                         FinalRange := FieldByName('LRange').AsString
                    else if (FieldByName('LRange').AsString = '') then
                         FinalRange := FieldByName('HRange').AsString;

                    FieldByName('RangeReal').AsString := FinalRange + Suffix;
                    FieldByName('Range').AsString := FinalRange;
                    FieldByName('Unit').AsString := Qry.FieldByName('Unit').AsString;
                    // FieldByName('Extra').AsString := Qry.FieldByName('Extra').AsString;
                    // FieldByName('ExtraFindings').AsString := Qry.FieldByName('ExtraFindings').AsString;
                    Post;
               end;
               Next;
          end;
     end;
     Qry.Free;
     Qry_DefaultFinding.Free;
end;

