Function LoadSchemeDetail(MyTable: TTable; SchemeId, DEPID: integer; RefType: String): Boolean;
Var
     Qry: TOraQuery;
     Qry2: TQuery;
begin
     Qry := TOraQuery.Create(nil);
     Qry2 := TQuery.Create(nil);
     with Qry do
     begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          if RefType = 'DEPARTMENT' then
          begin
               sql.Add('SELECT DEPNAME AS TYPE,DEPID AS REFNO FROM DEPARTMENT');
               sql.Add('Order by DepName');
          end
          else if RefType = 'PACKAGE' then
          begin
               sql.Add('SELECT TESTPACKAGENAME AS TYPE,TESTPACKAGEID AS REFNO FROM TESTPACKAGE');
               sql.Add('Order by TESTPACKAGENAME');
          end
          else if RefType = 'TEST' then
          begin
               sql.Add('SELECT tena_TESTNAME AS TYPE,tena_TESTNAMEID AS REFNO FROM hs_tena_TESTNAME');
               if DEPID > 0 then
                    sql.Add('WHERE tena_DEPID=' + IntToStr(DEPID));
               sql.Add('Order by tena_TestName');
          end;
          Open;
          MyTable.close;
          MyTable.EmptyTable;
          MyTable.Open;
          while not Eof do
          begin
               Result := True;
               with MyTable do
               begin
                    Append;
                    FieldByName('SchemeID').AsInteger := SchemeId;
                    FieldByName('RefType').AsString := RefType;
                    FieldByName('RefNo').AsInteger := Qry.FieldByName('RefNo').AsInteger;
                    FieldByName('Type').AsString := Qry.FieldByName('Type').AsString;
                    Post;
               end;
               Next;
          end;
          sql.Clear;
          sql.Add('Select * from SchemeDetail');
          Open;
          while not Eof do
          begin
               with Qry2 do
               begin
                    close;
                    DatabaseName := gs_temppath;
                    sql.Clear;
                    sql.Add('Update SchemeDetail Set SchemeDetailId=' + Qry.FieldByName('SchemeDetailId').AsString);
                    sql.Add(',OpDiscount=' + Qry.FieldByName('OpDiscount').AsString);
                    sql.Add(',IpDiscount=' + Qry.FieldByName('IpDiscount1').AsString);
                    sql.Add('Where SchemeID=' + Qry.FieldByName('SchemeID').AsString);
                    sql.Add('And RefType=' + #39 + Qry.FieldByName('RefType').AsString + #39);
                    sql.Add('And RefNo=' + #39 + Qry.FieldByName('RefNo').AsString + #39);
                    ExecSQL;
               end;
               Next;
          end;
     end;
     Qry.Free;
     Qry2.Free;
end;

