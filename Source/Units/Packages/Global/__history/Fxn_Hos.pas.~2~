                         begin
                              fieldbyname('LRange').Asstring := Qry.fieldbyname
                                ('LRangeM').Asstring;
                              fieldbyname('HRange').Asstring := Qry.fieldbyname
                                ('HRangeM').Asstring;
                              fieldbyname('LRangeM').Asstring := Qry.fieldbyname
                                ('LRangeM').Asstring;
                              fieldbyname('HRangeM').Asstring := Qry.fieldbyname
                                ('HRangeM').Asstring;
                              if StrToInt(Gs_Age) < 5 then
