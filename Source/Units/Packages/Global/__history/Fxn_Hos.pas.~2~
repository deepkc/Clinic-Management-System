Function CalculateCreatinineclearance(UrineCreatinine, UrineVolume,
     SerumCreatinine: Double): Double; stdcall;
Var
     I, J: Double;
begin
     I := UrineCreatinine * UrineVolume;
     J := SerumCreatinine * 1440;
     Try
          Result := I / J;
     Except
          Result := 0;
     End;
end;

