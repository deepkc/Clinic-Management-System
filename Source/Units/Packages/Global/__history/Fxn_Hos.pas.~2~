procedure AvoidMultipleDecimal(Edit_Text: TEdit; var Key: char); OverLoad;
var
     li_Position, li_DecPos: integer;
     { *** while typing float amount to control multiple decimal eg 22.32.1 just do only 22.321... }
     ls_DecimalNum, ls_Weight: String;
begin
     ls_Weight := Edit_Text.Text + Key;
     if (Key in ['.']) or (Key in ['0' .. '9']) then
     begin
          li_Position := Pos('.', Edit_Text.Text);
          if li_Position <> 0 then
          begin
               ls_DecimalNum := copy(ls_Weight, li_Position + 1, Length
                      (ls_Weight));
               li_DecPos := Pos('.', ls_DecimalNum);
               if li_DecPos <> 0 then
               begin
                    Key := #0;
               end;
          end;
     end
     else
          Key := #0;
end;

