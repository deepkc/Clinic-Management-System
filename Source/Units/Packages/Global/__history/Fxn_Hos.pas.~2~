Function GetCreditLimit(PatientID: integer): Double;
Var
     Qry: TOraQuery;
     PatientType: String;
begin
     Qry := TOraQuery.Create(nil);
     with Qry do
     begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.Add('Select Discharged From Inpatientreg');
          sql.Add(
               'Where Admndate in (Select Max(AdmnDate) from InpatientReg Where PatientID=' + IntToStr(PatientID) + ')');
          sql.Add('And PatientID=' + IntToStr(PatientID));
          open;
          if fieldbyname('Discharged').Asstring = 'Y' then
               PatientType := 'OP'
          else
               PatientType := 'IP';
          sql.Clear;
          sql.Add('Select LimitAmount From CreditLimit');
          sql.Add('Where CreditLimitFor=' + #39 + PatientType + #39);
          open;
          Result := fieldbyname('LimitAmount').AsFloat;
     end;
     Qry.free;
end;

