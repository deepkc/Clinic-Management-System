Function UpdateDepositInFinman(PatientID: integer; CrAmount, DrAmount: Double)
  : Boolean;
Var
     Qry, QryMain: TOraQuery;
     TRNum, FYearS, FYearE, GrpNum, MaxGrpNum, MaxMemberID,
       MaxAccountNo: integer;
     MaxVoucherNo: String;
     FYear, AccountNo, Particulars, TrCode, MaxMemberNo, Ls_TodaysDate,
       Ls_TodaysDateBS, MaxAccNum, EditParticular: String;
     Dex: TDateEditX;
begin
     Result := False;
     Qry := TOraQuery.Create(nil);
     QryMain := TOraQuery.Create(nil);

     Dex := TDateEditX.Create(Nil);

     if CrAmount > 0 then
     begin
          Particulars := 'Deposit Received';
          TrCode := 'D';
     end
     else
     begin
          Particulars := 'Deposit Withdrawn';
          TrCode := 'E';
     end;

     with QryMain do
     begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.Add('select sysdate from dual');
          open;
          Ls_TodaysDate := fieldbyname('SysDate').Asstring;
     end;
     Dex.ADDateAsText := TodaysDate;
     Ls_TodaysDateBS := Dex.VSDateAsText;

     FYear := StringReplace(copy(TodaysDateVS, 1, 5), '/', '', [rfReplaceAll]);

     FYearS := StrToInt(FYear) - 1;
     FYearE := StrToInt(FYear);

     FYear := copy(IntToStr(FYearS), 3, 2) + copy(IntToStr(FYearE), 3, 2);

     with Qry do
     begin
          close;
          Session := 'Finman';
          sql.Clear;
          sql.Add('Select GrpNum From GrpList Where CompNum=' + #39 + IntToStr
                 (PatientID) + #39);
          open;
          GrpNum := fieldbyname('GrpNum').AsInteger;
     end;

     if GrpNum <= 0 then
     begin
          with QryMain do
          begin
               close;
               Session := DM_Hospital.DB;
               sql.Clear;
               sql.Add('Select * from VW_HS_PatientMain');
               sql.Add('Where PatientID=' + IntToStr(PatientID));
               open;
          end;
          (* ***************** Open New Account In FinMan ******************************************************************* *)
          with Qry do
          begin
               try
                    DM_Hospital.Finman.StartTransaction;
                    Session := 'Finman';
                    sql.Clear;
                    sql.Add('Select IsNull(Max(GrpNum),0)+1 Mx from GrpList');
                    open;
                    MaxGrpNum := fieldbyname('Mx').AsInteger;

                    sql.Clear;
                    sql.Add
                      ('Select IsNull(Max(MemberNum),0)+1 Mx from GrpList');
                    open;
                    MaxMemberNo := FormatFloat
                      ('00000', fieldbyname('Mx').AsInteger);
                    MaxMemberID := fieldbyname('Mx').AsInteger;

                    sql.Clear;
                    sql.Add(
                         'Insert Into GrpList (GrpNum,GrpName,PAddress,PTel,MemberTypeID,MemberNum,MemberId,OpenDate,OpenDateBS');
                    sql.Add(
                         ',FirstName,LastName,MemberName,BirthDate,GenderID,Active,CompNum');
                    sql.Add(')Values (');
                    sql.Add(IntToStr(MaxGrpNum));
                    sql.Add(',' + #39 + UpperCase(QryMain.fieldbyname
                                ('PatientName').Asstring) + #39);
                    sql.Add
                      (',' + #39 + UpperCase(QryMain.fieldbyname('Address')
                                .Asstring) + #39);
                    sql.Add(',' + #39 + QryMain.fieldbyname('MobileNo')
                           .Asstring + #39);
                    sql.Add(',1');
                    sql.Add(',' + #39 + MaxMemberNo + #39);
                    sql.Add(',' + IntToStr(MaxMemberID));
                    sql.Add(',' + #39 + Ls_TodaysDate + #39);
                    sql.Add(',' + #39 + Ls_TodaysDateBS + #39);
                    sql.Add(',' + #39 + UpperCase(QryMain.fieldbyname('Fname')
                                .Asstring) + #39);
                    sql.Add(',' + #39 + UpperCase(QryMain.fieldbyname('Lname')
                                .Asstring) + #39);
                    sql.Add(',' + #39 + UpperCase(QryMain.fieldbyname
                                ('PatientName').Asstring) + #39);
                    sql.Add(',' + #39 + QryMain.fieldbyname('DobAd')
                           .Asstring + #39);
                    if QryMain.fieldbyname('Gender').Asstring = 'FEMALE' then
                         sql.Add(',1')
                    else
                         sql.Add(',2');
                    sql.Add(',''1'' ');
                    sql.Add(',' + IntToStr(PatientID));
                    sql.Add(')');
                    ExecSQL;

                    sql.Clear;
                    sql.Add(
                         'Select IsNull(Max(AccountNo),0)+1 Mx from SavingData'
                      );
                    open;
                    MaxAccountNo := fieldbyname('Mx').AsInteger;
                    MaxAccNum := '10102' + FormatFloat
                      ('00000', fieldbyname('Mx').AsInteger);

                    sql.Clear;
                    sql.Add(
                         'Insert Into SavingData (GroupNo,GrpNum,AccNum,AccountNo,AccName,Address,Tel,DateOpen,DateOpenBs,CrIntRate');
                    sql.Add(
                         ',DrIntRate,InitialDeposit,MinimumBalance,Active,Dtype,DTypeN,Operation,EnteredBy,EnteredDate,IntCalOption');
                    sql.Add(
                         ',IntCrOption,MaxWdLimit,MinWdLimit,AccType,Cur,PerWKLimit,HoldBal');
                    sql.Add(')Values(');
                    sql.Add('2');
                    sql.Add(',' + IntToStr(MaxGrpNum));
                    sql.Add(',' + #39 + MaxAccNum + #39);
                    sql.Add(',' + IntToStr(MaxAccountNo));
                    sql.Add(',' + #39 + UpperCase(QryMain.fieldbyname
                                ('PatientName').Asstring) + #39);
                    sql.Add
                      (',' + #39 + UpperCase(QryMain.fieldbyname('Address')
                                .Asstring) + #39);
                    sql.Add(',' + #39 + QryMain.fieldbyname('MobileNo')
                           .Asstring + #39);
                    sql.Add(',' + #39 + Ls_TodaysDate + #39);
                    sql.Add(',' + #39 + Ls_TodaysDateBS + #39);
                    sql.Add(',7,0');
                    sql.Add(',' + FloatToStr(CrAmount));
