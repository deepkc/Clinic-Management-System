function IsStrANumber(Const S: string): Boolean; stdcall;
var
     P: PChar;
begin
     if CountOccurences('.', S) > 1 then
     begin
          Result := False;
          Exit;
     end;
     P := PChar(S);
     Result := False;
     while P^ <> #0 do
     begin
          if not(P^ in ['0' .. '9', DecimalSeparator]) then
               Exit;
          Inc(P);
     end;
     Result := True;
end;

