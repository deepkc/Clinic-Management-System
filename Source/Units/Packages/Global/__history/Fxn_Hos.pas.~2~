                    sql.Add(',' + #39 + Ls_TodaysDate + #39);
                    sql.Add(',1,2,1000000,1,2,1,1000000000,1');
                    sql.Add(')');
                    ExecSQL;

                    close;
                    Session := 'Finman';
                    sql.Clear;
                    sql.Add(
                         'Select IsNull(Max(Substring(VoucherNo,8,10)+1),0)Mx from SavingDetail');
                    sql.Add
                      ('Where Substring(VoucherNo,1,4)=' + #39 + FYear + #39);
