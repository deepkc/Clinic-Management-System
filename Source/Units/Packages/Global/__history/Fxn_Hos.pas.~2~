Function CheckOccupiedBed(WardCode, BedNo: String): Boolean;
Var
     Qry: TOraQuery;
Begin
     Qry := TOraQuery.Create(nil);
     With Qry do
     Begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.Add(' Select Vacant From Bed Where BedNo=' + #39 + BedNo + #39);
          if Trim(WardCode) <> '' then
               sql.Add(' and WardCode=' + #39 + WardCode + #39);
          open;
     End;

     if Trim(Qry.fieldbyname('Vacant').Asstring) = '' then
     Begin
          gs_BedOccupiedMSG := 'No Such Bed Found in The Hospital !';
          Result := False;
          Qry.free;
          Exit;
     End;

     IF Qry.fieldbyname('Vacant').Asstring = 'F' Then
     Begin
          With Qry do
          Begin
               close;
               Session := DM_Hospital.DB;
               sql.Clear;
               sql.Add(
                    ' Select InpatientId,PatientId,(Select PAMA_PatientName From HS_PAMA_PatientMain where PAMA_PatientId=IPD.PatientId) as PatientName');
               sql.Add(
                    ' From InpatientDetail IPD where InpatientId in (Select InpatientId From InpatientReg where IsDischarged=''N'' and IsDisInDeposit=''N'')');
               sql.Add
                 (' and BedNo=' + #39 + BedNo + #39 + ' and OutDate=''C''');
               if Trim(WardCode) <> '' then
                    sql.Add(' and WardCode=' + #39 + WardCode + #39);
               open;
          End;

          gs_BedOccupiedMSG := 'Bed No " ' + BedNo +
            ' " is occupied by patient  " ' + Qry.fieldbyname('PatientName')
            .Asstring + ' " having IP. No " ' + Qry.fieldbyname('InpatientId')
            .Asstring + ' ". Plz Allocate Next Bed No.';

          Result := True;
     End
     Else
          Result := False;
     Qry.free;
End;

