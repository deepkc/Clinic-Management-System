Function Get_MSCSpendedTotal
  (MSCMemberNo, JoinDate, ExpireDate: String): Double;
Var
     Qry: TOraQuery;
begin
     Qry := TOraQuery.Create(nil);
     with Qry do
     begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.Add(
               ' Select Nvl(Sum(Total),0) as NetTotal From (');
          sql.Add(
               ' select OldBalanceAmount as Total from MSC_OldBalance');
          sql.Add(
               ' where MscMemberNo=:MemberNo And EntryDate>=:JoinDate and EntryDate<=:ExpireDate');
          sql.Add(' Union');
          sql.Add(
               ' select sum((Amount * Qty) + VatAmt - (Amount * Qty * Dis/100)) as Total from MSC_BillDetail');
          sql.Add(
               ' where MscmemberNo=:MemberNo and PayType <> ''REFUND'' And BillType<>''D'' And BillDate >=:JoinDate  and BillDate <=:ExpireDate');
          sql.Add(' Union');
          sql.Add(
               ' select -Sum((Amount * Qty) + VatAmt - (Amount * Qty * Dis/100)) as Total from Msc_billdetail');
          sql.Add(
               ' where MscmemberNo=:MemberNo and PayType=''REFUND'' And BillType<>''D'' And BillDate >=:JoinDate and BillDate <=:ExpireDate');
          sql.Add(' Union');
          { Refund and Exceed Amount Should Deduct to get the spended amt. within the MSC Period }
          sql.Add(
               ' Select -Sum(ExceedAmount) as Total From MSC_ExceedAmount');
          sql.Add(
               ' where MscmemberNo=:MemberNo and BillDate >=:JoinDate and BillDate <=:ExpireDate');
          sql.Add(' )');
          ParamByName('MemberNo').Asstring := MSCMemberNo;
          ParamByName('JoinDate').Asstring := JoinDate;
          ParamByName('ExpireDate').Asstring := ExpireDate;
          open;
     end;
     Result := Qry.fieldbyname('NetTotal').AsFloat;
     Qry.free;

     { In Case of MSC if Lets say Limit is Rs 30 and It already spended Rs 28 , Now ramining Balance for to spend withing this scheme is Rs 2
       But while doing billing if one such item have price of Rs 5 Then at this time we should have to post the data of give the MSC facility
       of RS 2 but in MSC_BillDetail it is post Rs 5 so it is exceed RS 3, Now If we sum the Total Service Then We get Rs 33 Actually it is not
       get the MSC Faclity so we keep Rs 3(Exceed Amount) in Table MSC_ExceedAmount Then we Deduct the Amount 33 by this exceed Amt Rs 3 }
End;

