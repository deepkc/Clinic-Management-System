Function LoadSchemeDetail(MyTable: TOraTable; SchemeId, DEPID: integer;
     RefType: String): Boolean;
Var
     Qry, Qry2: TOraQuery;
begin
     Qry := TOraQuery.Create(nil);
     Qry2 := TOraQuery.Create(nil);
     with Qry do
     begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          if RefType = 'DEPARTMENT' then
          begin
               sql.Add('SELECT DEPNAME AS TYPE,DEPID AS REFNO FROM DEPARTMENT');
               sql.Add('Order by DepName');
          end
          else if RefType = 'PACKAGE' then
          begin
               sql.Add(
                    'SELECT TESTPACKAGENAME AS TYPE,TESTPACKAGEID AS REFNO FROM TESTPACKAGE');
               sql.Add('Order by TESTPACKAGENAME');
          end
          else if RefType = 'TEST' then
          begin
               sql.Add(
                    'SELECT TESTNAME AS TYPE,TESTNAMEID AS REFNO FROM TESTNAME'
                 );
               if DEPID > 0 then
                    sql.Add('WHERE DEPID=' + IntToStr(DEPID));
               sql.Add('Order by TestName');
          end;
          open;
          MyTable.close;
          MyTable.EmptyTable;
          MyTable.open;
          while not Eof do
          begin
               Result := True;
               with MyTable do
               begin
                    Append;
                    fieldbyname('SchemeID').AsInteger := SchemeId;
                    fieldbyname('RefType').Asstring := RefType;
                    fieldbyname('RefNo').AsInteger := Qry.fieldbyname('RefNo')
                      .AsInteger;
                    fieldbyname('Type').Asstring := Qry.fieldbyname('Type')
                      .Asstring;
                    Post;
               end;
               Next;
          end;
          sql.Clear;
          sql.Add('Select * from SchemeDetail');
          open;
          while not Eof do
          begin
               with Qry2 do
               begin
                    close;
                    Session := gs_temppath;
                    sql.Clear;
                    sql.Add
                      ('Update SchemeDetail Set SchemeDetailId=' +
                           Qry.fieldbyname('SchemeDetailId').Asstring);
                    sql.Add(',OpDiscount=' + Qry.fieldbyname('OpDiscount')
                           .Asstring);
                    sql.Add(',IpDiscount=' + Qry.fieldbyname('IpDiscount1')
                           .Asstring);
                    sql.Add('Where SchemeID=' + Qry.fieldbyname('SchemeID')
                           .Asstring);
                    sql.Add('And RefType=' + #39 + Qry.fieldbyname('RefType')
                           .Asstring + #39);
                    sql.Add('And RefNo=' + #39 + Qry.fieldbyname('RefNo')
                           .Asstring + #39);
                    ExecSQL;
               end;
               Next;
          end;
     end;
     Qry.free;
     Qry2.free;
end;

