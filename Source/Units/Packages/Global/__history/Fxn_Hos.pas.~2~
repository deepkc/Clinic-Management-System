Function FileSearch(const PathName, FileName: string;
     const InDir: Boolean; CheckListBox: TListBox): String;
var
     Rec: TSearchRec;
     Path: string;
begin
     Path := IncludeTrailingBackslash(PathName);
     if FindFirst(Path + FileName, faAnyFile - faDirectory,
          Rec) = 0 then
          try
               repeat
                    Result := (Path + Rec.Name);
                    if CheckListBox <> Nil then
                    CheckListBox.Items.Add(Rec.Name);
               until FindNext(Rec) <> 0;
          finally
               FindClose(Rec);
          end;

     If not InDir then
          Exit;

     if FindFirst(Path + '*.*', faDirectory, Rec) = 0 then
          try
               repeat
                    if ((Rec.Attr and faDirectory) <> 0)and (Rec.Name <> '.') and(Rec.Name <> '..') then
                    FileSearch
                    (Path + Rec.Name, FileName, True, Nil);
               until FindNext(Rec) <> 0;
          finally
               FindClose(Rec);
          end;
end;

