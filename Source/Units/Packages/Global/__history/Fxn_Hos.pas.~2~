Function IsCreditAmountExistInPharmacy(PatientId,InpatientId : Integer):Boolean;
var Qry:TOraQuery;
Begin
     Qry:=TOraQuery.Create(nil);
     With Qry do
     Begin
          Close;
          Databasename:=gs_databasename;
          sql.clear;
          sql.add(' select Sum(SD.Qty*SD.UnitRate) as Total ');
          sql.add(' From SaleMaster SM,SaleDetail SD,ItemsList IL');
          sql.add(' where (SM.SaleMasterId=SD.SaleMasterId) and (SD.itemsid=IL.itemsid) and (SM.ST=''N'') and');
          sql.add(' (SM.STATUS1=1) and (SM.Customerid='+IntToStr(PatientId)+') And NVL(SM.PatientTypeID,0)=1 and (SD.Qty > 0)');
          sql.add(' and (SM.InPatientId='+IntToStr(InpatientId)+') and NVL(SM.Cashed,''N'')=''N''');
          Open;

          IF Qry.FieldByName('Total').AsFloat > 0 Then
          Result:=True
          Else
          Result:=False;
     End;
     Qry.Free;
End;


