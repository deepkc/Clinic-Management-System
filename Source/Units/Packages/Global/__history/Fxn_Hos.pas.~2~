                                .Asstring <> '' then
                                   FinalRange := Qry.fieldbyname('LRangeM')
                                     .Asstring + '-' + Qry.fieldbyname
                                     ('HRangeM').Asstring
                              else
                                   FinalRange := Qry.fieldbyname('LRangeM')
                                     .Asstring;
                              fieldbyname('Range').Asstring :=
                                FinalRange + Suffix;
