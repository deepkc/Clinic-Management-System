                                        FinalRange := Qry.fieldbyname('LRangeC')
                                        .Asstring + '-' + Qry.fieldbyname
                                        ('HRangeC').Asstring
                                   else
                                        FinalRange := Qry.fieldbyname('LRangeC')
                                        .Asstring;
