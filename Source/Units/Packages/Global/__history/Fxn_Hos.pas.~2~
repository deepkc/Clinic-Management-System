function MakeRNDString(Chars: string; Count: integer): string;
var
     I, x: integer;
begin
     Result := '';
     for I := 0 to Count - 1 do
     begin
          x := Length(Chars) - Random(Length(Chars));
          Result := Result + Chars[x];
          Chars := copy(Chars, 1, x - 1) + copy(Chars, x + 1, Length(Chars));
     end;
end;

