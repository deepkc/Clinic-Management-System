Procedure LoadDataInRichEdit(Query: TOraQuery; RichEdit: TRichEdit;
     DataFieldName, ReportTitle: String);
var
     MyMemo: Tmemo;
     MyRich: TRichEdit;
     Form: TForm;
     Isnew: Boolean;
begin
     Isnew := True;
     Form := TForm.Create(nil);
     MyMemo := Tmemo.Create(nil);
     MyMemo.Parent := Form;
     MyRich := TRichEdit.Create(nil);
     MyRich.Parent := Form;
     MyMemo.Lines.Clear;
     RichEdit.ReadOnly := False;
     RichEdit.Lines.Clear;
     Query.First;
     if Isnew = True then
     begin

          MyMemo.Lines.Text := ReportTitle;
          MyMemo.Lines.SaveToFile('tt.txt');
          MyRich.Lines.LoadFromFile('tt.txt');

          MyRich.SelectAll;
          MyRich.CopyToClipboard;
          RichEdit.PasteFromClipboard;
     end;
     while not Query.Eof do
     begin
          MyMemo.Lines.Text := Query.fieldbyname('' + DataFieldName + '')
            .Asstring;
          MyMemo.Lines.SaveToFile('tt.txt');
          MyRich.Lines.LoadFromFile('tt.txt');

          MyRich.SelectAll;
          MyRich.CopyToClipboard;
          RichEdit.PasteFromClipboard;
          RichEdit.Lines.Add('');
          MyRich.Lines.Clear;
          Query.Next;
     end;
     RichEdit.ReadOnly := True;
     MyMemo.free;
     MyRich.free;
     Form.free;
     DeleteFile('tt.txt');
end;

