     Qry: TOraQuery;
     PatientType: String;
     li_InpatientID: integer;
begin
     Qry := TOraQuery.Create(nil);
     with Qry do
     begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.Add('Select Inpatientid,Discharged From Inpatientreg');
          sql.Add(
               'Where Admndate in (Select Max(AdmnDate) from InpatientReg Where PatientID=' + IntToStr(PatientID) + ')');
          sql.Add('And PatientID=' + IntToStr(PatientID));
          open;
          if fieldbyname('Discharged').Asstring = 'N' then
          begin
               PatientType := 'IP';
               li_InpatientID := fieldbyname('InPatientID').AsInteger;
          end;
          sql.Clear;
          sql.Add('Select LimitAmount From CreditLimitExtended');
          sql.Add('Where InpatientID =' + IntToStr(li_InpatientID));
          open;
          Result := fieldbyname('LimitAmount').AsFloat;
     end;
     Qry.free;
end;

Procedure SetFontAttribute(ToolBtn: TToolButton; RichEdit: TRichEdit;
     Style: TFontStyles);
var
     Att: string;
begin
     if ToolBtn.Down then
     begin
          if Style = [fsBold] then
               RichEdit.SelAttributes.Style := RichEdit.SelAttributes.Style +
                 [fsBold]
          else if Style = [fsItalic] then
               RichEdit.SelAttributes.Style := RichEdit.SelAttributes.Style +
                 [fsItalic]
          else if Style = [fsUnderline] then
               RichEdit.SelAttributes.Style := RichEdit.SelAttributes.Style +
                 [fsUnderline]
          else if Style = [fsStrikeOut] then
               RichEdit.SelAttributes.Style := RichEdit.SelAttributes.Style +
                 [fsStrikeOut];
     end
     else
     begin
          if Style = [fsBold] then
               RichEdit.SelAttributes.Style := RichEdit.SelAttributes.Style -
                 [fsBold]
          else if Style = [fsItalic] then
               RichEdit.SelAttributes.Style := RichEdit.SelAttributes.Style -
                 [fsItalic]
          else if Style = [fsUnderline] then
               RichEdit.SelAttributes.Style := RichEdit.SelAttributes.Style -
                 [fsUnderline]
          else if Style = [fsStrikeOut] then
               RichEdit.SelAttributes.Style := RichEdit.SelAttributes.Style -
                 [fsStrikeOut];
     end;
end;

Procedure GetFontAttribute(ToolBtn: TToolButton; RichEdit: TRichEdit;
     MyStyle: TFontStyles);
begin
     if MyStyle = [fsBold] then
     begin
          if (RichEdit.SelAttributes.Style = [fsBold, fsItalic, fsUnderline,
               fsStrikeOut]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsItalic, fsUnderline]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsItalic]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsUnderline, fsStrikeOut])
            or (RichEdit.SelAttributes.Style = [fsBold, fsUnderline]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsStrikeOut]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsItalic, fsStrikeOut]) or
            (RichEdit.SelAttributes.Style = [fsBold]) then
               ToolBtn.Down := True
          else
               ToolBtn.Down := False;
     end
     else if MyStyle = [fsItalic] then
     begin
          if (RichEdit.SelAttributes.Style = [fsBold, fsItalic, fsUnderline,
               fsStrikeOut]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsItalic, fsUnderline]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsItalic]) or
            (RichEdit.SelAttributes.Style = [fsItalic, fsUnderline, fsStrikeOut]
            ) or (RichEdit.SelAttributes.Style = [fsItalic, fsUnderline]) or
            (RichEdit.SelAttributes.Style = [fsItalic, fsStrikeOut]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsItalic, fsStrikeOut]) or
            (RichEdit.SelAttributes.Style = [fsItalic]) then
               ToolBtn.Down := True
          else
               ToolBtn.Down := False;
     end
     else if MyStyle = [fsUnderline] then
     begin
          if (RichEdit.SelAttributes.Style = [fsBold, fsItalic, fsUnderline,
               fsStrikeOut]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsItalic, fsUnderline]) or
            (RichEdit.SelAttributes.Style = [fsUnderline, fsItalic]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsUnderline, fsStrikeOut])
            or (RichEdit.SelAttributes.Style = [fsBold, fsUnderline]) or
            (RichEdit.SelAttributes.Style = [fsUnderline, fsStrikeOut]) or
            (RichEdit.SelAttributes.Style = [fsUnderline, fsItalic, fsStrikeOut]
            ) or (RichEdit.SelAttributes.Style = [fsUnderline]) then
               ToolBtn.Down := True
          else
               ToolBtn.Down := False;
     end
     else if MyStyle = [fsStrikeOut] then
     begin
          if (RichEdit.SelAttributes.Style = [fsBold, fsItalic, fsUnderline,
               fsStrikeOut]) or (RichEdit.SelAttributes.Style = [fsStrikeOut,
               fsItalic, fsUnderline]) or
            (RichEdit.SelAttributes.Style = [fsStrikeOut, fsItalic]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsUnderline, fsStrikeOut])
            or (RichEdit.SelAttributes.Style = [fsStrikeOut, fsUnderline]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsStrikeOut]) or
            (RichEdit.SelAttributes.Style = [fsBold, fsItalic, fsStrikeOut]) or
            (RichEdit.SelAttributes.Style = [fsStrikeOut]) then
               ToolBtn.Down := True
          else
               ToolBtn.Down := False;
     end;
end;

