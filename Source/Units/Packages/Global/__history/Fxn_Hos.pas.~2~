Function GetRefDocCode(BillNo: String): String;
Var
     Qry: TOraQuery;
begin
     Qry := TOraQuery.Create(nil);
     with Qry do
     begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          if copy(BillNo, 1, 2) = 'TP' then
               sql.Add
                 ('Select RefDocCode from ServiceBillmaster Where billno=' +
                      #39 + BillNo + #39)
          else if (copy(BillNo, 1, 2) = 'CS') or (copy(BillNo, 1, 2) = 'CR')
            then
               sql.Add('Select RefDocCode from BillMaster Where billno=' +
                      #39 + BillNo + #39);
          open;
          Result := fieldbyname('RefdocCode').Asstring;
     end;
     Qry.free;
end;

