function GetDefaultComputerName: string;
var ipNam: PChar;
    Size: DWord;
begin
   ipNam := nil;
   Size := MAX_COMPUTERNAME_LENGTH + 1;
   try
      Result := '';
      GetMem(ipNam, Size);
      if GetComputerName(ipNam, Size)
      then Result := UpperCase(TRIM(strPas(ipNam)))
      else Result := '?';
   finally
      FreeMem(ipNam, 10);
   end;
end;




