function CheckDuplicateDataFrmTmp(RealTableName, KeyFieldName, DName,
     Value: string): Boolean;
var
     query_key: TOraQuery;
begin
     query_key := TOraQuery.Create(nil);
     with query_key do
     Begin
          close;
          Session := DName;
          sql.Clear;
          sql.Add('select ' + KeyFieldName + ' from ' + RealTableName +' where Trim(Upper(' + KeyFieldName + '))=Trim(Upper(' + #39 + Value +#39 + '))');
          open;
          if Trim(query_key.fieldbyname('' + KeyFieldName + '').Asstring) <> '' then
               Result := True
          else
               Result := False;
     End;
     query_key.free;
end;

function GetKeyValuetemp(RealTableName, KeyFieldName, DName: string): Longint;
var
     query_key: TOraQuery;
begin
     query_key := TOraQuery.Create(nil);
     with query_key do
     Begin
          close;
          Session := gs_temppath;
          sql.Clear;
          sql.Add('select max(' + KeyFieldName + ') as nMax from  ' +
                 RealTableName);
          open;
          Result := fieldbyname('nMax').AsInteger + 1;
     End;
     query_key.free;
end;

