                    sql.Add(' ,''1'' ');
                    sql.Add(',''SYSTEM'' ');
                    sql.Add(')');
                    ExecSQL;

                    DM_Hospital.Finman.Commit;
                    Result := True;
               Except
                    DM_Hospital.Finman.Rollback;
                    Result := False;
               end;
          end;
     end
     else
     begin
          (* ***************** For Patient having account in Finman ******************************************************************* *)
          try
               DM_Hospital.Finman.StartTransaction;

               with Qry do
               begin
                    close;
                    Session := 'Finman';
                    sql.Clear;
                    sql.Add(
                         'Select IsNull(Max(Substring(VoucherNo,8,10)),0)+1 Mx from SavingDetail');
                    sql.Add
                      ('Where Substring(VoucherNo,1,4)=' + #39 + FYear + #39);
