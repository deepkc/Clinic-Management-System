                         ' DOCT_DOCID=REDE_REFDOCID) as Doctor,(Select DEPT_DEPNAME From HS_DEPT_DEPARTMENT where DEPT_DEPID=REDE_CLINICALDEPID) as DepName');
                    sql.Add(
                         ' From HS_REDE_REFUNDDETAIL REDE where REDE_RefundBILLNO='
                           + #39 + BillNo + #39);
                    sql.Add(' and REDE_BILLTYPE=''R''');
               End;
               open;

               if Qry.fieldbyname('RefDOCID').AsInteger = 1 then // 1 - HOSPITAL
                    Result := fieldbyname('DepName').Asstring
               Else
               Begin
                    if Trim(fieldbyname('DepName').Asstring) = '' then
                    Begin
                         if fieldbyname('DocId').AsInteger = 2 then
                         // 2 -Sudeep Shrestha
                              Result := fieldbyname('Doctor')
                                .Asstring + ' / ' + GetDocName(39)
                         Else
                              Result := fieldbyname('Doctor').Asstring;
                    End
                    Else
                    Begin
                         if gs_IsReferralDeptInBilling = 'Y' then
                         // Referred By Department
                         Begin
                              if fieldbyname('DocId').AsInteger = 2 then
                              // 2 -Sudeep Shrestha
                                   Result := Qry.fieldbyname('Doctor')
                                     .Asstring + ' / ' + GetDocName(39)
                                     + ' (' + Qry.fieldbyname('DepName')
                                     .Asstring + ')'
                              Else
                                   Result := Qry.fieldbyname('Doctor')
                                     .Asstring + ' (' + Qry.fieldbyname
                                     ('DepName').Asstring + ')';
                         End
                         Else
                         Begin
                              if fieldbyname('DocId').AsInteger = 2 then
                              // 2 -Sudeep Shrestha
                                   Result := Qry.fieldbyname('Doctor')
                                     .Asstring + ' / ' + GetDocName(39)
                              Else
                                   Result := Qry.fieldbyname('Doctor').Asstring;
                         End;
                    End;
               End;
          end;
          Qry.free;
     end
     else
     begin
          Qry := TOraQuery.Create(nil);
          with Qry do
          begin
               close;
               Session := DM_Hospital.DB;
               sql.Clear;
               if copy(BillNo, 1, 2) <> 'RF' then
               Begin
                    sql.Add(
                         ' Select Distinct BIDE_DEPID DepId,BIDE_RefDOCID RefDOCID,(Select DOCT_DESIG||'' ''||DOCT_DOCNAME From HS_DOCT_DOCTOR where');
                    sql.Add(
                         ' DOCT_DOCID=(case when BIDE_RefDOCID=0 then BIDE.BIDE_DOCID else BIDE_RefDOCID End )) as Doctor,(Select DEPT_DEPNAME From HS_DEPT_DEPARTMENT where DEPT_DEPID=BIDE.BIDE_CLINICALDEPID) as DepName,');
                    sql.Add(
                         ' case when BIDE_RefDOCID=0 then BIDE.BIDE_DOCID else BIDE_RefDOCID End DocId');
                    sql.Add
                      (' From HS_BIDE_BILLDETAIL BIDE where BIDE_BILLNO=' +
                           #39 + BillNo + #39);
                    // sql.Add(' and BIDE_BILLTYPE=''R''');
               End
               Else
               Begin
                    sql.Add(
                         ' Select Distinct REDE_DEPID DepId,REDE_RefDOCID RefDocID,REDE_REFDOCID as DocID,(Select DOCT_DESIG||'' ''||DOCT_DOCNAME From HS_DOCT_DOCTOR where');
                    sql.Add(
                         ' DOCT_DOCID=REDE_REFDOCID) as Doctor,(Select DEPT_DEPNAME From HS_DEPT_DEPARTMENT where DEPT_DEPID=REDE_CLINICALDEPID) as DepName');
                    sql.Add(
                         ' From HS_REDE_REFUNDDETAIL REDE where REDE_RefundBILLNO='
                           + #39 + BillNo + #39);
                    sql.Add(' and REDE_BILLTYPE=''R''');
               End;
               open;

               if Qry.fieldbyname('RefDOCID').AsInteger = 1 then // 1 - HOSPITAL
                    Result := fieldbyname('DepName').Asstring
               Else
               Begin
                    if Trim(fieldbyname('DepName').Asstring) = '' then
                         Result := fieldbyname('Doctor').Asstring
                    Else
                    Begin
                         if gs_IsReferralDeptInBilling = 'Y' then
                         // Referred By Department
                              Result := Qry.fieldbyname('Doctor')
                                .Asstring + ' (' + Qry.fieldbyname('DepName')
                                .Asstring + ')'
                         Else
                              Result := Qry.fieldbyname('Doctor').Asstring;
                    End;
               End;
          end;
