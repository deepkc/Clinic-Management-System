                    Procedure AddInactiveTest(TableName: TTable;
                         Patienttestid, TestID: integer);
                    Var
                         Qry: TOraQuery;
                         Qry_DefaultFinding: TOraQuery;
                         Suffix, FinalRange: String;
                    begin
                         Qry := TOraQuery.Create(Nil);
                         TableName.close;
                         TableName.Open;
                         with Qry do
                         begin
                              close;
                              Session := DM_Hospital.DB;
                              sql.Clear;
                              // sql.Add('Select * from Test Where TestnameId=' + IntToStr(TestNameID));
                              sql.Add(
                                   'select t.*,Trim(CAST(T.SPECIALRANGE AS VARCHAR2(250)))SPECIALRANGEMAIN');
                              sql.Add(
                                   ',(select Dept_deporder from Hs_Dept_department where Dept_depid in (select tena_depid as depid from hs_tena_testname where tena_testnameid=t.testnameid))deporderMain');
                              sql.Add('from test t where T.testid=' + IntToStr
                                     (TestID));
                              sql.Add('And T.IsActive=''N''');
                              sql.Add(
                                   'order by depordermain,t.testnameid,t.displayorder');
                              Open;

                              Qry_DefaultFinding := TOraQuery.Create(Nil);
                              with Qry_DefaultFinding do
                              begin
                                   close;
                                   Session := DM_Hospital.DB;
                                   sql.Clear;
                                   sql.Add(
                                        'select * from LB_TEFI_TestFinding where TEFI_ISDEFAULTFINDINGS=''Y'' and TEFI_TESTID=' + IntToStr(Qry.FieldByName('TestID').AsInteger));
                                   Open;
                              end;

                              with TableName do
                              begin
                                   Append;
                                   FieldByName('IsNew').AsString := 'Y';
                                   FieldByName('TestNameId')
                                     .AsInteger := Qry.FieldByName('TestNameID')
                                     .AsInteger;
                                   FieldByName('PatienttestID').AsInteger :=
                                     gi_PatientTestID;
                                   FieldByName('TestID').AsInteger :=
                                     Qry.FieldByName('TestID').AsInteger;
                                   FieldByName('IsDefaultFinding').AsString :=
                                     Qry_DefaultFinding.FieldByName
                                     ('TEFI_ISDEFAULTFINDINGS').AsString;
                                   FieldByName('Test').AsString :=
                                     Qry.FieldByName('Test').AsString;
                                   FieldByName('RepNo').AsInteger := 1;
                                   FieldByName('IsHeading')
                                     .AsString := Qry.FieldByName('IsHeading')
                                     .AsString;
                                   FieldByName('SpecialRange')
                                     .AsString := Qry.FieldByName
                                     ('SPECIALRANGEMAIN').AsString;
                                   Suffix := ' @' + Qry.FieldByName('Suffix')
                                     .AsString;

                                   if Qry.FieldByName('LRangeG')
                                     .AsString <> '' then
                                        FieldByName('LRange')
                                        .AsString := Qry.FieldByName('LRangeG')
                                        .AsString
                                   else if Qry.FieldByName('LRangeC')
