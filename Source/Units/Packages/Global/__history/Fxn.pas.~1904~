     Suffix, FinalRange: String;
     CurrAge: integer;
begin
     Qry := TOraQuery.Create(Nil);
     TableName.close;
     TableName.Open;
     with Qry do
     begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          // SQL.Add('Select to_number(Replace(GetCurrentAge('+IntToStr(PatientID)+'),''Y''))CurrAge');
          // sql.Add('Select to_number(Replace(Replace(Replace(GetCurrentAge(' + IntToStr(PatientID) + '),''Y''),''M''),''D''))CurrAge');
