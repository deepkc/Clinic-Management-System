                              // *****FTP ENGINE UPLOADS DATA FROM \\SERVERIP\SISDATA\FTP ******
                              // ******BUT EMAIL SENDS MAIL FROM
                              // ****** GS_TEMPPATH\INVREP SO **DO NOT CHANGE THIS FOLDER**
                              if I = 0 then
