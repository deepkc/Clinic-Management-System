Function GetFindingPostByNameNew(SelectedPatientTestID: String): String;
Var
     Qry: TOraQuery;
     UserID: integer;
begin
     Qry := TOraQuery.Create(nil);
     With Qry do
     Begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          // sql.Add('select docid from usermain where userid in (') ;
          sql.Add('Select distinct FindingPostBy from PatientTest ');
          sql.Add('Where PatientTestID in (' + SelectedPatientTestID + ')');
          // sql.SaveToFile('file.txt');
          Open;
          if RecordCount = 1 then
               UserID := FieldByName('FindingPostBy').AsInteger
          else
          begin
               Result := '';
               Exit;
          end;
          sql.Clear;
          sql.Add('select FullName from lab_usermain where userid=' + quotedstr
                 (IntToStr(UserID)));
          Open;
          Result := FieldByName('Fullname').AsString;
     End;
     Qry.Free;
end;

Function GetReportFooterStatusNew(SelectedPatientTestID, Align: String): String;
Var
     Qry: TOraQuery;
     Docid: integer;
Begin
     Qry := TOraQuery.Create(nil);
     With Qry do
     Begin
          close;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.Add('select doctorid from lab_usermain where userid in (');
          sql.Add('Select distinct VerifiedBy from PatientTest ');
          sql.Add('Where PatientTestID in (' + SelectedPatientTestID + '))');
          Open;
          if RecordCount = 1 then
               Docid := FieldByName('doctorid').AsInteger
          else
          begin
               Result := '';
               Exit;
          end;
          sql.Clear;
          sql.Add('SELECT RF.Status');
          sql.Add('FROM Doctor D,REPORT_FOOTER RF');
          sql.Add('WHERE RF.DOCID=D.DOCID');
          sql.Add('AND D.DocID=' + IntToStr(Docid));
          sql.Add('AND Upper(RF.Align)=Upper(' + #39 + Align + #39 + ')');
          Open;
          Result := FieldByName('Status').AsString;
     End;
     Qry.Free;
end;

