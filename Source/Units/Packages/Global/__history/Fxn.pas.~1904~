                    Function BMPtoJPG(BMPpic, JPGpic: string): boolean;
                    var
                         Bitmap: Tbitmap;
                         JpegImg: TJPEGImage;
                    begin
                         Result := False;
                         Bitmap := Tbitmap.Create;
                         try
                              Bitmap.LoadFromFile(BMPpic);
                              JpegImg := TJPEGImage.Create;
                              try
                                   JpegImg.Assign(Bitmap);
                                   JpegImg.SaveToFile(JPGpic);
                                   Result := True;
                              finally
                                   JpegImg.Free
                              end;
                         finally
                              Bitmap.Free
                         end;
                    end;

