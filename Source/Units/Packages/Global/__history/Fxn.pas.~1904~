            (',(Select tena_TestName From '
                 + gs_Hos_DB_UserName +
                 '.hs_tena_TestName Where tena_TestNameId=T.TestNameID)TestName');
          sql.Add
            (',(Select tena_DepId From ' +
                 gs_Hos_DB_UserName +
                 '.hs_tena_TestName Where tena_TestNameId=T.TestNameID) DepId');
          sql.Add
            (',(Select TEFI_Findings From '
                 + gs_Hos_DB_UserName +
                 '.LB_TEFI_TestFinding Where TEFI_TestId=T.TestId and TEFI_IsDefaultFindings=''Y'' and RowNum=1) DefaultFindings');
          sql.Add('from test t where testnameid=' + IntToStr
                 (TestNameID));
          sql.Add('And T.IsActive=''Y''');
          sql.Add(
               'And T.TestNameID in (Select tena_TestNameID From '
                 + gs_Hos_DB_UserName +
                 '.hs_tena_TestName where tena_Depid in ('
                 + gs_UserDepId + '))');
