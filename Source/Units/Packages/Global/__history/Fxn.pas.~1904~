                    'select * from LB_TEFI_TestFinding where TEFI_ISDEFAULTFINDINGS=''Y'' and TEFI_TESTID=' + IntToStr(Qry.FieldByName('TestID').AsInteger));
                    Open;
                    end;
                    Append;
                    FieldByName('IsNew').AsString := 'Y';
                    FieldByName('TestName')
                    .AsString := Qry.FieldByName('TestName')
                    .AsString;
                    FieldByName('TestNameId')
                    .AsInteger := Qry.FieldByName
                    ('TestNameId').AsInteger;
                    FieldByName('DepId')
                    .AsInteger := Qry.FieldByName('DepId')
                    .AsInteger;
                    FieldByName('RepNo').AsInteger := RepNo;
                    FieldByName('PatienttestID')
                    .AsInteger := gi_PatientTestID;
                    FieldByName('TestDate').AsString :=
                    GetTestDate(gi_PatientTestID);
                    FieldByName('IsDefaultFinding')
                    .AsString :=
                    Qry_DefaultFinding.FieldByName
                    ('TEFI_ISDEFAULTFINDINGS').AsString;
                    FieldByName('TestID')
                    .AsInteger := Qry.FieldByName('TestID')
                    .AsInteger;
                    FieldByName('Test')
                    .AsString := Qry.FieldByName('Test')
                    .AsString;
                    FieldByName('IsHeading')
                    .AsString := Qry.FieldByName
                    ('IsHeading').AsString;

                    if Trim
                    (Qry.FieldByName('DefaultFindings')
                    .AsString) <> '' then
                    begin
                    FieldByName('Finding')
                    .AsString := Qry.FieldByName
                    ('DefaultFindings').AsString;
                    FieldByName('IsDefaultFinding')
                    .AsString :=
                    Qry_DefaultFinding.FieldByName
