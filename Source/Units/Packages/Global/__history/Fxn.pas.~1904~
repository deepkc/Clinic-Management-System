                    Function ValidDateRange(FromDate, ToDate: String): boolean;
                      Stdcall;
                    var
                         I, li_Count: integer;
                         Date_From, Date_To: TDateEditX;
                    begin
                         Result := False;
                         li_Count := Length(FromDate);

                         for I := 1 to li_Count do
