                                        FieldByName('HRange')
                                        .AsString := Qry.FieldByName('HRangeG')
                                        .AsString
                                   else if Qry.FieldByName('HRangeC')
                                     .AsString <> '' then
                                        FieldByName('HRange')
                                        .AsString := Qry.FieldByName('HRangeC')
                                        .AsString;

                                   if Gs_Gender = 'MALE' then
                                   begin
                                        if FieldByName('HRange')
                                        .AsString <> '' then
                                        FinalRange := FieldByName('LRange')
                                        .AsString + '-' + FieldByName('HRange')
                                        .AsString
                                        else
                                        FinalRange := FieldByName('LRange')
                                        .AsString;

