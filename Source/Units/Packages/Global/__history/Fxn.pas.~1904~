                         S := StringReplace(S, ' ', '', [rfReplaceAll]);

                         P := PChar(S);
                         while P^ <> #0 do
                         begin
                              if not(P^ in ['0' .. '9', '>', '<', ',', '=',
                                   DecimalSeparator]) then
                                   Exit;
                              Inc(P);
                         end;
                         Result := True;
                    end;

