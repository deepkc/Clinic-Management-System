          sql.Add('from dual');
          Open;
          if FieldByName('CurrAge').AsString = 'N/A' then
               CurrAge := 0
          else
               CurrAge := FieldByName('CurrAge').AsInteger;

          sql.Clear;
          // sql.Add('Select * from Test Where TestnameId=' + IntToStr(TestNameID));
          sql.Add(
               'select t.*,Trim(CAST(T.SPECIALRANGE AS VARCHAR2(250)))SPECIALRANGEMAIN');
          sql.Add
            (',(select Dept_deporder from '
