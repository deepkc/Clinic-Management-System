                    Procedure PreviewClinicalInRichBox
                      (TestNameID, ReportTypeID: integer; MyRichBox: TRichEdit);
                    Var
                         Qry: TOraQuery;
                         lb_ReportTitle: boolean;
                         MyMemo: Tmemo;
                         MyRich: TRichEdit;
                         LineNo: integer;
                    begin
                         Qry := TOraQuery.Create(Nil);
                         MyMemo := Tmemo.Create(Nil);
                         MyMemo.Parent := MyRichBox.Parent;
                         MyMemo.Visible := False;
                         MyRich := TRichEdit.Create(Nil);
                         MyRich.Parent := MyRichBox.Parent;
                         MyRich.Visible := False;
                         With Qry do
                         begin
                              close;
                              Session := DM_Hospital.DB;
                              sql.Clear;
                              sql.Add('Select * from Clinical_Test');
                              sql.Add('Where TestNameId=' + IntToStr(TestNameID)
                                );
                              sql.Add('And ReportTypeID=' + IntToStr
                                     (ReportTypeID));
                              sql.Add('And IsActive=''Y'' ');
                              Open;
                              MyRichBox.Lines.Clear;
                              MyMemo.Lines.Clear;
                              LineNo := 0;
                              while Not Eof do
                              begin
                                   if Not lb_ReportTitle then
                                   begin
                                        MyMemo.Clear;
                                        MyRich.Clear;
                                        MyMemo.Lines.Add
                                        (FieldByName('ReportTitle_Rich')
                                        .AsString);
                                        lb_ReportTitle := True;
                                        MyMemo.Lines.SaveToFile
                                        ('ReportTitle.txt');

                                        MyRich.Lines.LoadFromFile
                                        ('ReportTitle.txt');
                                        MyRich.SelectAll;
                                        MyRich.CopyToClipboard;
                                        MyRichBox.PasteFromClipboard;
                                        Inc(LineNo);
                                        Exit;
                                   end;
                                   MyMemo.Clear;
                                   MyRich.Clear;
                                   MyMemo.Lines.Add
                                     (FieldByName('Finding_Title_Rich')
                                        .AsString);
                                   MyMemo.Lines.SaveToFile('FindingTitle.txt');
                                   MyRich.Lines.LoadFromFile
                                     ('FindingTitle.txt');
                                   MyRich.SelectAll;
                                   MyRich.CopyToClipboard;
                                   MyRichBox.PasteFromClipboard;
                                   Inc(LineNo);

                                   MyMemo.Clear;
                                   MyRich.Clear;
                                   MyMemo.Lines.Add
                                     (FieldByName('Default_Finding_Rich')
                                        .AsString);
                                   MyMemo.Lines.SaveToFile
                                     ('DefaultFinding.txt');
                                   MyRich.Lines.LoadFromFile
                                     ('DefaultFinding.txt');
                                   MyRich.SelectAll;
                                   MyRich.CopyToClipboard;
                                   // MyRichBox.Lines.Move(LineNo,LineNo-1);
                                   // MyRichBox.set
                                   // MyRichBox.SelStart:=Length(MyRichBox.Text);
                                   MyRichBox.PasteFromClipboard;

                                   DeleteFile('ReportTitle.txt');
                                   DeleteFile('FindingTitle.txt');
                                   DeleteFile('DefaultFinding.txt');

                                   Next;
                              end;
                         end;
                         Qry.Free; // che
                    end;

                    Function CountOccurences(const SubText: string;
                         const Text: string): integer;
                    begin
                         if (SubText = '') OR (Text = '') OR
                           (Pos(SubText, Text) = 0) then
                              Result := 0
                         else
                              Result :=
                                (Length(Text) - Length
                                     (StringReplace(Text, SubText, '',
                                        [rfReplaceAll]))) div Length(SubText);
                    end;

                    Function IndexOfArray(const Value: String;
                         Items: array of String): integer;
                    var
                         I: integer;
                    begin
                         Result := -1;
                         for I := Low(Items) to High(Items) do
                         begin
                              if AnsiSameText(Value, Items[I]) then
                              begin
                                   Result := I;
                                   break;
                              end;
                         end;
                    end;

