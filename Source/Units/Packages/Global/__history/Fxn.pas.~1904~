                    Procedure SetFontAttribute(ToolBtn: TToolButton;
                         RichEdit: TRichEdit; Style: TFontStyles);
                    var
                         Att: string;
                    begin
                         if ToolBtn.Down then
                         begin
                              if Style = [fsBold] then
                                   RichEdit.SelAttributes.Style :=
                                     RichEdit.SelAttributes.Style + [fsBold]
                              else if Style = [fsItalic] then
                                   RichEdit.SelAttributes.Style :=
                                     RichEdit.SelAttributes.Style + [fsItalic]
                              else if Style = [fsUnderline] then
                                   RichEdit.SelAttributes.Style :=
                                     RichEdit.SelAttributes.Style +
                                     [fsUnderline]
                              else if Style = [fsStrikeOut] then
                                   RichEdit.SelAttributes.Style :=
                                     RichEdit.SelAttributes.Style +
                                     [fsStrikeOut];
                         end
                         else
                         begin
                              if Style = [fsBold] then
                                   RichEdit.SelAttributes.Style :=
                                     RichEdit.SelAttributes.Style - [fsBold]
                              else if Style = [fsItalic] then
                                   RichEdit.SelAttributes.Style :=
                                     RichEdit.SelAttributes.Style - [fsItalic]
                              else if Style = [fsUnderline] then
                                   RichEdit.SelAttributes.Style :=
                                     RichEdit.SelAttributes.Style -
                                     [fsUnderline]
                              else if Style = [fsStrikeOut] then
                                   RichEdit.SelAttributes.Style :=
                                     RichEdit.SelAttributes.Style -
                                     [fsStrikeOut];
                         end;
                    end;

