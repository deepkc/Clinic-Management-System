Function GetNetMedicineCharge(InpatientId:Integer):Double;
Var ls_InptDate,ls_DisDate,ls_IsDischarged:String;
    lf_TotMedCharge,lf_TotMedRefund:Double;
    li_PatientId:Integer;
Begin
     With Query_GetNextNo do
     Begin
          Close;
          //DatabaseName:=gs_DatabaseName;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.add(' Select InptDate,DisDate,PatientId,Discharged From InpatientReg where InpatientId='+IntToStr(InpatientId));
          Open;
     End;
     ls_DisDate:='';
     li_PatientId:=Query_GetNextNo.FieldByName('PatientId').AsInteger;
     ls_InptDate:=Query_GetNextNo.FieldByName('InptDate').AsString;
     ls_DisDate:=Query_GetNextNo.FieldByName('DisDate').AsString;
     ls_IsDischarged:=Query_GetNextNo.FieldByName('Discharged').AsString;
     
     with Query_GetNextNo do
     Begin
          Close;
          //DatabaseName:=gs_DatabaseName;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.add(' select Sum(Round((SD.Qty*SD.UnitRate),5)-Round(((SD.Qty*SD.UnitRate) * SD.Discount/100),5)) as NetTotal');
          sql.add(' From SaleMaster SM,SaleDetail SD,ItemsList IL where (SM.SaleMasterId=SD.SaleMasterId)');
          sql.add(' and (SD.itemsid=IL.itemsid) and (SM.ST=''N'') and (SM.STATUS1=1) and');  {*** N for credit bill...  Status1= 0 -cash , status1= 1 -Credit}
          sql.add(' (SD.PatientId < 9999900) And');
          sql.add(' (SD.InPatientId='+IntToStr(InpatientId)+')');
          Open;
     End;
     lf_TotMedCharge:=Query_GetNextNo.FieldByName('NetTotal').AsFloat;


     IF Trim(ls_DisDate)='' Then
     ls_DisDate:=ServerDate.TodaysDate;

     { Medicine Refund }
     with Query_GetNextNo do
     Begin
          Close;
          //DatabaseName:=gs_DatabaseName;
          Session := DM_Hospital.DB;
          sql.Clear;
          sql.add(' Select Sum( Round((RD.Qty*RD.UnitPrice),5)-Round(((RD.Qty*RD.UnitPrice) * RD.Discount/100),5)) as NetTotal');
          sql.add(' From ReturnMaster RM,ReturnDetail RD where RM.CustomerId='+IntToStr(li_PatientId));
          sql.add(' and RM.Credit1=1 and RM.ST=''N'' and RM.ReturnMasterId=RD.ReturnMasterId(+)and ');
          sql.add(' RM.ReturnDate>='+#39+ls_InptDate+#39+' and RM.ReturnDate<='+#39+ls_DisDate+#39);

          IF ls_IsDischarged='YES' Then
          Begin
               Sql.add(' And RM.CustomerID In(Select PatientID From InpatientReg Where PatientID=RM.CustomerId And ');
               Sql.Add(' ((RM.Returndate>=Inptdate And RM.Returndate < Disdate)) ');
               Sql.Add(' OR (RM.Returndate=DisDate And RM.Rettime<=(Select OutTime From InpatientDetail ');
               sql.add(' Where InPatientId=InpatientReg.InPatientId and DisBillDate=InpatientReg.DisDate))) ');
          End;
          Open;
     End;
     lf_TotMedRefund:=Query_GetNextNo.FieldByName('NetTotal').AsFloat;
     Result:=lf_TotMedCharge - lf_TotMedRefund;
End;

