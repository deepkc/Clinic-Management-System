function GetADDate(aDate : String) : TDate;
var sDays, sMonth, syear : string ;
   iCnt, iMonth : Integer ;
begin
   if aDate = '' then Exit ;
   iCnt := 0 ;
   sMonth := copy(aDate,1,3);
   sYear := '20'+Copy(aDate,5,2);
   repeat
      iCnt := iCnt + 1 ;
      iMonth := iCnt ;
   until UpperCase(ShortMonthNames[iCnt]) = UpperCase(sMonth) ;
   sMonth := IntToStr(iMonth) ;
   while Length(sMonth) < 2 do
   begin
      sMonth := '0' + sMonth;
   end ;
   DEX_Control.SystemOfDate := 1 ;
   DEX_Control.Text := sYear+'/'+sMonth+'/'+'01' ;
   sDays := IntToStr(DEX_Control.DaysInThisMonth);
   DEX_Control.Text := sYear+'/'+sMonth+'/'+sDays ;
   Result := DEX_Control.ADDateAsDate;
end;


