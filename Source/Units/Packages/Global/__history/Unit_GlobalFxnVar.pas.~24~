Function GetNextBillNo(Const RealTableName,KeyFieldName,BillType,SystemType,TodaysDate:String):String;
Var
   Cur_F_Year,Tem_Str,ls_ExtStr,ls_FiscalYearStartBS,ls_FiscalYearStart:String;
   S_FDate,E_FDate:Integer;
   DateEditx_Hidden:TDateEditX;
begin
     ls_ExtStr:='';
     DateEditx_Hidden:=TDateEditX.Create(Application);
     DateEditx_Hidden.SystemOfDate:=gi_DateSystem;
     DateEditx_Hidden.text:=TodaysDate;
     Tem_Str:=DateEditx_Hidden.VSDateAsText;
     IF StrToInt(Copy(Tem_Str,6,2))>=4 Then
     Begin
          S_FDate:=StrToInt(Copy(Tem_Str,3,2));
          E_FDate:=S_FDate+1;
     End
     Else
     Begin
          E_FDate:=StrToInt(Copy(Tem_Str,3,2));
          S_FDate:=E_FDate-1;
     End;

     ls_FiscalYearStartBS:='20'+IntToStr(S_FDate)+'/04/01';
     DateEditx_Hidden.SystemOfDate:=0;
     DateEditx_Hidden.text:=ls_FiscalYearStartBS;

     IF gi_DateSystem=1 Then
     Begin
        DateEditx_Hidden.SystemOfDate:=1;
        ls_FiscalYearStart:=DateEditx_Hidden.text;
     End
     Else
     ls_FiscalYearStart:=ls_FiscalYearStartBS;

     Try
          With Query_GetNextNo do
          Begin
               close;
               //DatabaseName:=gs_DatabaseName;
               Session := DM_Hospital.DB;
               sql.Clear;
               IF (SystemType='GEN') or (BillType='TP') Then
               Begin
                    sql.add(' Select SubStr(Max('+KeyFieldName+'),9,15) as nMax From '+RealTableName+' where SystemType=''GEN''');
                    sql.add(' and BillNo Like '+#39+BillType+FormatFloat('00',S_FDate)+'/'+FormatFloat('00',E_FDate)+'%'+#39);
                    sql.add(' and BillDate >='+#39+ls_FiscalYearStart+#39);
                    //sql.add('and billdate>='+Quotedstr(gs_maxbilldate));
               End
               Else
               Begin
                    sql.add(' Select SubStr(Max('+KeyFieldName+'),10,15) as nMax From '+RealTableName+' where SystemType=''EHS''');
                    sql.add(' and BillNo Like '+#39+'E'+BillType+FormatFloat('00',S_FDate)+'/'+FormatFloat('00',E_FDate)+'%'+#39);
                    //sql.add(' and BillDate >='+#39+ls_FiscalYearStart+#39);
                    sql.add('and billdate>='+Quotedstr(ls_FiscalYearStart));
               End;
               //sql.saveToFile('C:\EHSQuery.Txt');
               Open;

               IF (SystemType='GEN') or (BillType='TP') Then
               Result:=BillType+FormatFloat('00',S_FDate)+'/'+FormatFloat('00',E_FDate)+'-'+FormatFloat('0000000',Query_GetNextNo.FieldByName('nMax').AsInteger+1)
               Else
               Result:='E'+BillType+FormatFloat('00',S_FDate)+'/'+FormatFloat('00',E_FDate)+'-'+FormatFloat('000000',Query_GetNextNo.FieldByName('nMax').AsInteger+1);
               Close;
          End;
     Except
          IF (SystemType='GEN') or (BillType='TP') Then
          Result:=BillType+FormatFloat('00',S_FDate)+'/'+FormatFloat('00',E_FDate)+'-'+FormatFloat('0000000',1)
          Else
          Result:='E'+BillType+FormatFloat('00',S_FDate)+'/'+FormatFloat('00',E_FDate)+'-'+FormatFloat('000000',1);
     End;
     DateEditx_Hidden.Free;
End;


