procedure VersionCheck;
Var
     qry:TOraQuery;
     ls_OldVersion,ls_old,ls_new:String;
begin
     //gs_ExeVersion :=GetVersionNumber;
     ls_new:=StringReplace(gs_ExeVersion,'.','',[rfReplaceAll]);
     qry :=TOraQuery.Create(Nil);
     with Qry do
     begin
          Close;
//          DatabaseName := gs_DatabaseName;
          Session := DM_Hospital.DB;
          SQL.Clear;
          SQL.Add('Select * from gb_sove_softwareversion');
          Open;
          ls_OldVersion := FieldByName('sove_versionno').AsString;
     end;
     ls_old := StringReplace(ls_OldVersion,'.','',[rfReplaceAll]);
     if ls_OldVersion='' then
     with qry do
     begin
          Close;
          //DatabaseName := gs_DatabaseName;
          Session := DM_Hospital.DB;
          SQL.Clear;
          SQL.Add('Insert into gb_sove_softwareversion(sove_versionno) values('+QuotedStr(gs_ExeVersion)+')');
          ExecSQL;
     end
     else if ls_new=ls_old then
     begin
        //
     end
     else if ls_old<ls_new then
     begin
          with qry do
          begin
               Close;
               //DatabaseName := gs_DatabaseName;
               Session := DM_Hospital.DB;
               SQL.Clear;
               SQL.Add('Update gb_sove_softwareversion set sove_versionno='+ QuotedStr(gs_ExeVersion));
               ExecSQL;
          end
     end
     else if ls_old> ls_new then
     begin
          ShowMessage('Currently you are using old version of Midas Dr Homs.!! Please contact Administrator for latest version of Midas Dr Homs !! Thank You');
     end;
     qry.Free;
End;



Function GetNextFileNo(Const RealTableName,KeyFieldName,PatientType:String):LongInt;
begin
   With Query_GetNextNo do
   begin
