Function IsValid_Quota_Queue_ForDoctor(VisitDate,DocCode,DepCode,SystemType :String) : Boolean;
Var li_Quota, li_QueueNo : Integer;
Begin
     li_Quota:=Get_Reg_Quota_DocWise(DocCode,DepCode);
     li_QueueNo:=Get_Reg_QueueNo_DocWise(VisitDate,DocCode,DepCode,SystemType);

     IF li_Quota=0 Then
     Begin
          MessageDlg('Doctor Visit Quota is Zero(0) for Today.',mtWarning,[mbok],0);
          Result:=False;
          Exit;
     End;

     IF li_QueueNo > li_Quota Then
     Begin
          MessageDlg('Doctor Visit Quota Is Finished for Today.',mtWarning,[mbok],0);
          Result:=False;
          Exit;
     End
     Else
     Result:=True;
End;

