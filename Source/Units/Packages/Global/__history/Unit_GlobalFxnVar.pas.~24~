Function  GetFiscalYear:String;
Var
   Cur_F_Year,Tem_Str:String;
   S_FDate,E_FDate:Integer;
   DateEditx_Hidden:TDateEditX;
Begin
     DateEditx_Hidden:=TDateEditX.Create(Application);
     DateEditx_Hidden.SystemOfDate:=gi_DateSystem;
     DateEditx_Hidden.text:=TodaysDate;
     //DateEditx_Hidden.text:=Serverdate.TodaysDate;
     Tem_Str:=DateEditx_Hidden.VSDateAsText;
     IF StrToInt(Copy(Tem_Str,6,2))>=4 Then
     Begin
          S_FDate:=StrToInt(Copy(Tem_Str,3,2));
          E_FDate:=S_FDate+1;
     End
     Else
     Begin
          E_FDate:=StrToInt(Copy(Tem_Str,3,2));
          S_FDate:=E_FDate-1;
     End;
     Result:=FormatFloat('00',S_FDate)+'/'+FormatFloat('00',E_FDate);
     gs_Month:=Copy(Tem_Str,6,2);
     gs_Year:=Copy(Tem_Str,1,4);
     If gs_Month='01' then gs_MonthName:='Baisakh'
     Else If gs_Month='02' then gs_MonthName:='Jestha'
     Else If gs_Month='03' then gs_MonthName:='Asadh'
     Else If gs_Month='04' then gs_MonthName:='Shrawan'
     Else If gs_Month='05' then gs_MonthName:='Bhadra'
     Else If gs_Month='06' then gs_MonthName:='Ashwin'
     Else If gs_Month='07' then gs_MonthName:='Kartik'
     Else If gs_Month='08' then gs_MonthName:='Mangsir'
     Else If gs_Month='09' then gs_MonthName:='Poush'
     Else If gs_Month='10' then gs_MonthName:='Magh'
     Else If gs_Month='11' then gs_MonthName:='Falgun'
     Else If gs_Month='12' then gs_MonthName:='Chaitra';
     DateEditx_Hidden.Free;
End;

