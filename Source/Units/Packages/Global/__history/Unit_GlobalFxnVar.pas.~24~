Function Crypt(sInput: string;nPass:word): string;
var nLen,x,n:word;
begin
   if sInput='' then
   begin
      result:='';
      exit;
   end;
   nLen:=length(sInput);
   n:=nLen;
   setlength(result,nLen);
   for x:=nLen downto 1 do
   begin
      result[x]:=chr(ord(sInput[n]) XOR nPass);
      dec(n);
   end;
end;

