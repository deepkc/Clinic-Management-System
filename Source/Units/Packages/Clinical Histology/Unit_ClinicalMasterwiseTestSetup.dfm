  object OraQuery_DbGrid: TOraQuery
    SQL.Strings = (
      
        'select tws.*,(select tena_testname from hs_tena_testname where t' +
        'ena_testnameid=tws.twms_testnameid)testname from HC_TWMS_TestWis' +
        'eMasterSetup tws '
      'order by TWMS_TESTWISEMASTERSETUPID')
    Left = 48
    Top = 192
  end
