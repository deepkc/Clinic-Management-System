procedure TForm_Report.AddImage;
Var
     ms,Ms1: TMemoryStream;
     JPG,Jpeg,jpeg1: TJPEGImage;
begin
     Image1.Picture.Graphic:=nil;
     Image2.Picture.Graphic:=nil;
     {
     with qryTQuery do
     begin
          Close;
          Sql.Clear;
          Sql.Add('Select suin_image1,suin_image2 from LB_SUIN_SURGICALINVESTIGATION where SUIN_PATIENTTESTID='+inttostr(gi_patientTestId));
          Open;

          JPeg:=TJPEGImage.Create;
          ms:=TMemoryStream.Create;

          JPeg1:=TJPEGImage.Create;
          ms1:=TMemoryStream.Create;
          try
               TBlobField(FieldByName('suin_image1')).SaveToStream(ms);
               ms.Position := 0;
               if ms.Size>0 then
               begin
                   JPeG.LoadFromStream(ms);
                   Image1.Picture.Assign(JPeG);
               end;

               TBlobField(FieldByName('suin_image2')).SaveToStream(ms1);
               ms1.Position := 0;
               if ms1.Size>0 then
               begin
                   JPeG1.LoadFromStream(ms1);
                   Image2.Picture.Assign(JPeG1);
               end;
          finally
               JPeG.Free;
               ms.Free;
               JPeG1.Free;
               ms1.Free;
          end;
     end;
     }
end;

