    FieldDefs.Add('FindingTitle_Rich', ftMemo);
    FieldDefs.Add('Finding', ftString, 200);
    FieldDefs.Add('Finding_Rich', ftMemo);
    FieldDefs.Add('DisplayOrder', ftString, 100);
    FieldDefs.Add('IsNew', ftString, 1);
    CreateTable;
  end;
