procedure TFrame_ClinicalPathFindingCentralNew.LoadImage;
Var
  ms, ms2: TMemoryStream;
  JPG, jpg2: TJPEGImage;
begin
  with OraQuery_CheckVerifier do
  begin
    close;
    Session := Dm_Hospital.DB;
    sql.Add(
      'select suin_userid,(select isverifier from lab_usermain where userid=suin_userid)isverifier');
    sql.Add('from LB_SUIN_SURGICALINVESTIGATION where SUIN_PATIENTTESTID=' +
        INTTOSTR(gi_PatientTestID));
    open;

    if (FieldByName('suin_userid').ASInteger = gi_userid) or
      (FieldByName('isverifier').AsString = 'Y') then
    begin
      sp_pic1Open.Enabled := true;
      SB_Pic2Open.Enabled := true;
    end
    else
    begin
      sp_pic1Open.Enabled := false;
      SB_Pic2Open.Enabled := false;
    end;
  end;

  Image1.Picture := nil;
  Image2.Picture := nil;
  with qryTQuery do
  begin
    close;
    sql.Clear;
    // ConnectionString:='Provider=MSDASQL.1;Password='+gs_DB_Password+';Persist Security Info=True;User ID='+gs_DB_UserName+';Data Source='+gs_AliasName;
    sql.Add(
      'Select suin_image1,suin_image2 from LB_SUIN_SURGICALINVESTIGATION where SUIN_PATIENTTESTID=' + INTTOSTR(gi_PatientTestID));
    open;

    JPG := TJPEGImage.Create;
    ms := TMemoryStream.Create;

    jpg2 := TJPEGImage.Create;
    ms2 := TMemoryStream.Create;
    try
      TBlobField(FieldByName('suin_image1')).SaveToStream(ms);
      ms.Position := 0;
      if ms.Size > 0 then
      begin
        JPG.LoadFromStream(ms);
        Image1.Picture.Assign(JPG);
      end;
      // QRImage1.Picture.Assign(JPG);

      TBlobField(FieldByName('suin_image2')).SaveToStream(ms2);
      ms2.Position := 0;
      if ms2.Size > 0 then
      begin
        jpg2.LoadFromStream(ms2);
        Image2.Picture.Assign(jpg2);
      end;
    finally
      JPG.Free;
      ms.Free;

      jpg2.Free;
      ms2.Free;
    end;
    // QuickRep1.Preview;
  end;

end;

