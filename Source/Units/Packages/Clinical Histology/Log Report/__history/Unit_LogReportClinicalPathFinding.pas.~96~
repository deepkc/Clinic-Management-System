procedure TForm_LogReportClinicalPathFinding.DBGrid_LogReportDblClick(
  Sender: TObject);
var Li_patientid:Integer;
var Li_userid:Integer;
var Qry:TOraQuery;
var OraQry:TOraQuery;
var OraQry1:TOraQuery;

begin
     Qry:=TOraQuery.Create(nil);
     OraQry:=TOraQuery.Create(nil);

     if OraQuery_LogReportDbGrid.RecordCount=0 then
     begin
          ShowMessage('No Data is Selected');
          Exit;
     end;

     PageControl1.ActivePageIndex:=1;
     GroupBox1.Visible:=False;
     GroupBox2.Visible:=False;
     GroupBox_DateRange.Visible:=False;
     GroupBox_Info.Visible:=True;
     SB_Cancel.Visible:=True;

     Panel_Fnac.Visible:=false;
     Panel_FluidDC.visible:=false;
     Panel_usgfnac.visible:=false;
     Panel_FluidMalignant.visible:=false;
     Panel_Pap.visible:=false;
     Panel_Bonemarrow.Visible:=false;
     Panel_Surgical.Visible:=false;
     Panel_PBS.visible:=false;


