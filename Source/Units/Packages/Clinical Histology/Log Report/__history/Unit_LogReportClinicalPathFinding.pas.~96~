     Lbl_DateOfAspiration.Caption:='';
     Lbl_IdentificationNo.Caption:='';
     Lbl_ReportDate.Caption:='';

     Li_patientid:=OraQuery_LogReportDbGrid.FieldByName('patientid').AsInteger;
     Li_userid:=OraQuery_LogReportDbGrid.FieldByName('USERID').AsInteger;

     //LoadPatientData(pi_patientid);
     with OraQuery_LoadInfo do
     begin
          Close;
          Session:=DM_Hospital.DB;
          SQL.Clear;
          SQL.Add('select * from lab_usermain where userid='+intToStr(Li_userid));
          open;
          Label_UserName.Caption := FieldByName('UserName').AsString+'/'+FieldByName('Userid').asString;
     end;

     Label_DateOfModification.Caption:=OraQuery_LogReportDbGrid.FieldByName('ModifiedDate').AsString;
     Label_TimeOfModification.Caption:=OraQuery_LogReportDbGrid.FieldByName('ModifiedTime').AsString;
     //LoadPatientData(pi_patientid);
     with OraQuery_LoadInfo do
     begin
          Close;
          Session:=DM_Hospital.DB;
          SQL.Clear;
          SQL.Add('select * from HS_PAMA_patientmain where PAMA_Patientid='+intToStr(Li_patientid));
          open;

          Lbl_Name.Caption := FieldByName('PAMA_PATIENTNAME').AsString;
          Lbl_HosNo.Caption:=FloatToStr(FieldByName('PAMA_PATIENTID').AsFloat);
          Lbl_AgeGender.Caption:=FieldByName('PAMA_AGE').AsString+'/'+FieldByName('PAMA_GENDER').AsString;
     end;

     Lbl_DateOfAspiration.Caption:=OraQuery_LogReportDbGrid.FieldByName('SampleDate').AsString;
     Lbl_ReportDate.Caption:=OraQuery_LogReportDbGrid.FieldByName('ReportDate').AsString;
     Lbl_IdentificationNo.Caption:=OraQuery_LogReportDbGrid.FieldByName('IDENTIFICATIONNO').AsString;
     Lbl_SiteOfAspiration.Caption:=OraQuery_LogReportDbGrid.FieldByName('samplesite').AsString;

     with Qry do
     begin
          Close;
          Session:=DM_Hospital.DB;
          SQL.Clear;
          SQL.Add('Select RefNo,CptCode from PatientTest where patientid='+intToStr(Li_patientid));
          open;

          Lbl_RefNo.Caption:=FieldByName('RefNo').AsString;
          Lbl_CPTCode.Caption:=FieldByName('CPTCODE').AsString;
     end;
     with Qry do
     begin
          Close;
          Session:=DM_Hospital.DB;
          SQL.Clear;
          SQL.Add('select reporttype from clinical_reportType where reporttypeid='+IntToSTr(OraQuery_LogReportDbGrid.FieldByName('REPORTFORMATID').AsInteger));
          open;
     end;
     Label_ReportType.Caption:=DBLCB_ReportType.Text;
     Label_PatientTestId.Caption:=OraQuery_LogReportDbGrid.FieldByName('patienttestid').AsString;


     if Pi_Panelid=1 then
     begin
          Panel_Fnac.Visible:=True;
          Panel_FluidDC.visible:=false;
          Panel_usgfnac.visible:=false;
          Panel_FluidMalignant.visible:=false;
          Panel_Pap.visible:=false;
          Panel_Bonemarrow.Visible:=false;
          Panel_Surgical.Visible:=false;
          Panel_PBS.Visible:=False;

          Edit9.text:=DBLCB_ReportType.text;

          Memo1.Lines.Clear;
          Memo1.Lines.Text:=OraQuery_LogReportDbGrid.FieldByName('ReportTitle').AsString;
          Memo1.Lines.SaveToFile('tt1.txt');
          RichEdit_FNACReportTitle.Lines.LoadFromFile('tt1.txt');


          Edit_FNACNumber.Text:=OraQuery_LogReportDbGrid.FieldByName('FNACNUMBER').AsString;

          Memo1.Lines.Clear;
