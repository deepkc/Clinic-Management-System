procedure TForm_LogReportClinicalPathFinding.DBLCB_ReportTypeClick(
  Sender: TObject);
var OraQuery_ProcessLog:TOraQuery;

begin
     OraQuery_ProcessLog:=TOraQuery.Create(nil);
     OraQuery_LogReportDbGrid.Close;
     //OraQuery_ReportType.Close;
     Pi_Panelid:=0;
     Pi_ValueCount:=0;
     if (DBLCB_TestName.KeyValue<=0) or (DBLCB_TestName.KeyValue=null) then
     begin
          DBLCB_ReportType.KeyValue:=-1;
          DBLCB_TestName.SetFocus;
          ShowMessage('Please Select Test Name');
          Exit;
     end;
     if DBLCB_MasterFormat.KeyValue<=0 then
     begin
          DBLCB_MasterFormat.SetFocus;
          ShowMessage('Please Select Master Format');
          Exit;
     end;

     if DBLCB_ReportType.KeyValue=null then
          DBLCB_ReportType.KeyValue:=-1
     else
     begin
          with OraQuery_ProcessLog do
          begin
               Close;
               Session:=DM_Hospital.DB;
               SQL.Clear;
               SQL.Add('select Distinct(FNIL_REPORTFORMATID) from LB_FNIL_FNACINVESTIGATIONLOG');
               Open;
               First;
          end;
          while not OraQuery_ProcessLog.eof do
          begin
               if OraQuery_ProcessLog.FieldByName('FNIL_REPORTFORMATID').AsInteger=DBLCB_ReportType.KeyValue then
               begin
                    if Pi_ValueCount=0 then
                    begin
                         Pi_Panelid:=1;
                         Pi_ValueCount:=1;
                         with OraQuery_LogReportDbGrid do
                         begin
                              Close;
                              Session:=DM_Hospital.DB;
                              SQL.Clear;
                              SQL.Add('select FNIL_REPORTDATE as ReportDate,FNIL_PATIENTID as Patientid,FNIL_PATIENTTESTID as Patienttestid,FNIL_REPORTFORMATID as Reportformatid,FNIL_IDENTIFICATIONNO as identificationno,FNIL_REFDOC as REFDOC,FNIL_SAMPLEDATE as SampleDate,');
                              SQL.Add('(select pama_patientname from hs_pama_patientmain where pama_patientid=FNIL_PATIENTID)PatientName,FNIL_IDENTIFICATIONNO as IDENTIFICATIONNO,FNIL_SAMPLESITE as samplesite,FNIL_REPORTTITLE as ReportTitle,FNIL_FNACNUMBER as FNACNUMBER,');
                              SQL.Add('FNIL_FNACINVESTIGATIONID,FNIL_PEERREVIEW as PeerReview,FNIL_MODIFIEDDATE as MODIFIEDDATE,FNIL_MODIFIEDTIME as MODIFIEDTIME,');
                              sql.Add('(select username from lab_usermain where userid=FNIL_USERID)USERName,FNIL_USERID as USERID,');
                              sql.add('(select redo_docname from hs_redo_referaldoctor where REDO_DOCID=FNIL_REFDOC)DOCNAME,');
                              SQL.Add('(select hose_hospitalname from hs_hose_hospitalsetup where hose_hospitalcode=FNIL_REFHOS)REFHOS,FNIL_SAMPLENO as SAMPLENO,');
                              SQL.Add ('FNIL_CLINICALFEATURES as Clinicalfeatures,FNIL_DIAGNOSIS as Diagnosis,FNIL_MICRODESCRIPTION as MICRODESCRIPTION,FNIL_COMMENT as Cmnt,FNIL_TYPEOFASPIRATION as Typeofaspiration from LB_FNIL_FNACINVESTIGATIONLOG where FNIL_REPORTFORMATID='+intToStr(DBLCB_ReportType.KeyValue));

                              if Edit_Patientid.text<>'' then
                              begin
                                   SQL.add(' and FNIL_PATIENTID='+Edit_PatientId.Text);
                              end;
                              SQL.Add(' And FNIL_MODIFIEDDATE between '+QuotedStr(DateEditXFrom.text)+' AND '+QuotedStr(DateEditXTo.text));
                              SQL.Add(' order by FNIL_MODIFIEDDATE,FNIL_MODIFIEDTIME Desc');
                              //SQL.SaveToFile('C:\LogReport.txt');
                              Open;
                         end;
                    end;

               end;
               OraQuery_ProcessLog.next;
          end;

          with OraQuery_ProcessLog do
          begin
               Close;
               Session:=DM_Hospital.DB;
               SQL.Clear;
               SQL.Add('select Distinct(SUIL_REPORTFORMATID) from LB_SUIL_Surginvestigationlog');
               Open;
               First;
          end;
          while not OraQuery_ProcessLog.Eof do
          begin
               if OraQuery_ProcessLog.FieldByName('SUIL_REPORTFORMATID').AsInteger=DBLCB_ReportType.KeyValue then
               begin
                    if Pi_ValueCount=0 then
                    begin
                         Pi_ValueCount:=1;
                         Pi_Panelid:=2;
                         with OraQuery_LogReportDbGrid do
