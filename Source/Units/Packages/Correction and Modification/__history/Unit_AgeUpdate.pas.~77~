procedure TForm_AgeUpdate.EditAgeKeyPress(Sender: TObject; var Key: Char);
begin
     If key=#8 then exit;
     IF Key=#13 Then
     Begin
     IF EditAge.Text<>'' Then
          CmbAgeType.SetFocus
     End;
     If (key<'0') or (key>'9')then
     begin
          key:=#0;
          exit;
     End;
end;

