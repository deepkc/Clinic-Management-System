     End;

     With QueryProcess Do
     Begin
          Close;
          Session:=DM_Hospital.DB;
          sql.Clear;
          sql.Add('Select Max(PIMID) MaxPRMID From HS_LOG_PATIENTINFOMODIFICATION Where patientID='+IntToStr(pi_PatientID));
          Open;
          MaxID:=QueryProcess.FieldByName('MaxPRMID').AsInteger;

          Close;
          sql.Clear;
          sql.Add(' Update HS_LOG_PATIENTINFOMODIFICATION Set');
          sql.Add(' PRETITLE='+Chr(39)+Query_SubProcess.FieldByName('TITLE').AsString+Chr(39));
          sql.Add(' ,PREPATIENTNAME= '+Chr(39)+Query_SubProcess.FieldByName('FNAME').AsString+Query_SubProcess.FieldByName('LNAME').AsString+chr(39));
          sql.Add(' ,PREGENDER='+Chr(39)+Query_SubProcess.FieldByName('GENDER').AsString+Chr(39));
          sql.Add(' ,PREAGE='+Chr(39)+Query_SubProcess.FieldByName('AGE').AsString+Chr(39));
          sql.Add(' ,PREAGETYPE='+Chr(39)+Query_SubProcess.FieldByName('AGETYPE').AsString+Chr(39));
          sql.Add(' ,PREDOBVS='+Chr(39)+Query_SubProcess.FieldByName('DOBVS').AsString+Chr(39));
          sql.Add(' ,PREDOBAD='+Chr(39)+Query_SubProcess.FieldByName('DOBAD').AsString+Chr(39));
          sql.Add(' ,PREREGBY='+IntToStr(gi_userID));
          sql.Add(' ,PREREGDATE='+Chr(39)+TodaysDate+Chr(39));
          sql.Add(' ,PREREGTIME='+Chr(39)+TodaysTime+Chr(39));
          sql.Add(' ,PREADDRESS='+Chr(39)+Query_SubProcess.FieldByName('ADDRESS').AsString+Chr(39));
          if Query_SubProcess.FieldByName('COMMUNITYid').AsInteger<>NULL then
               sql.Add(' ,PRECOMMUNITYID='+Query_SubProcess.FieldByName('COMMUNITYid').AsString)
          Else
               sql.Add(' ,PRECOMMUNITYID=0');
          if Query_SubProcess.FieldByName('SCHEMEID').AsInteger<>NULL then
          sql.Add(' ,PRESCHEMEID='+Query_SubProcess.FieldByName('SCHEMEID').AsString)
          Else
          Sql.add(',Preschemeid=0');
          //sql.Add(' ,MemberNo='+Query_SubProcess.FieldByName('MemberNo').AsString);
          sql.Add(' ,PREWARDNO='+Chr(39)+Query_SubProcess.FieldByName('WARDNO').AsString+Chr(39));
          sql.Add(' ,PREDISTRICTID='+Query_SubProcess.FieldByName('DISTRICTID').AsString);
          if Query_SubProcess.FieldByName('VDCMCPTID').AsInteger<>NULL then
               sql.Add(' ,PREVDCMCPTID='+Query_SubProcess.FieldByName('VDCMCPTID').AsString)
          Else
               sql.Add(' ,PREVDCMCPTID=0');
          sql.Add(' Where patientID='+IntToStr(pi_PatientID));
          sql.Add(' And PIMID='+IntToStr(MaxID));
          //sql.saveToFile('C:\PtModify.Txt');
          ExecSQL;
     End;
end;

