procedure TForm_AgeUpdate.BitBtn_UpdateClick(Sender: TObject);
begin
     if (EditAge.Text='') or (EditAge.text='0') then
     Begin
          MessageDlg('Please put The Patient Age.',mtInformation,[mbok],0);
          EditAge.SetFocus;
          Exit;
     End;
     if (Edit_PatientId.text='') or (Edit_PatientId.text='0') then
     Begin
          MessageDlg('Please Enter The Patientid To Search.',mtInformation,[mbok],0);
          Edit_PatientId.SetFocus;
          Exit;
     End;
     

     if (edt_remarkupdate.Text='') or (edt_remarkupdate.text='0') then
     Begin
          MessageDlg('Please put Remark for Modification.',mtInformation,[mbok],0);
          edt_remarkupdate.SetFocus;
          Exit;
     End;

     If messageDlg('Are You Sure To Change The Patient Information?', mtconfirmation, [mbyes,mbno], 0)=mryes then
     Begin
          Try
               DM_Hospital.DB.StartTransaction;
               PatientRecordModificationLog(pi_PatientID);
               With Query_Save Do
               Begin
                    close;
                    Session:=DM_Hospital.DB;
                    Sql.clear;
                    sql.add('Update hs_pama_patientmain set pama_age='+QuotedStr(EditAge.Text)+',pama_agetype='+Quotedstr(CmbAgeType.Text));
                    sql.add(',pama_title='+Quotedstr(dblcb_title.Text));
                    sql.add(',pama_GENDER='+Quotedstr(ComboBoxGender.text));
                    sql.add(',pama_dobvs='+QuotedStr(DateEditXDOB.text)+',pama_Dobad='+QuotedStr(Ps_DOBAD));
                    sql.add(',pama_fname='+Quotedstr(Edit_FirstName.text));
                    sql.add(',pama_Lname='+Quotedstr(Edit_LastName.text));
                    if CMBCountry.keyvalue>0 then
                    sql.add(',pama_countryid='+IntToStr(CMBCountry.keyvalue));
                    if CmbDistrict.keyvalue>0 then
                    sql.add(',pama_districtid='+IntToStr(CmbDistrict.keyvalue));
                    if CmbVdc.keyvalue>0 then
                    sql.add(',PAMA_VDCMCPTID='+IntToStr(CmbVdc.keyvalue));
                    sql.add(',pama_WARDNO='+Quotedstr(CMBWardNo.text));
                    sql.add(',pama_Address='+Quotedstr(EditAddress.text));
                    sql.add(',pama_PHONENO='+Quotedstr(EditPhone.text));
                    sql.add(',pama_MOBILENO='+Quotedstr(Edit_MobileNo.text));
                    //ssql.add(',RPHONENO='+Quotedstr(EditRPhone.text));
                    sql.add(',pama_PATIENTNAME='+#39+Edit_FirstName.text+' '+Edit_LastName.text+#39);
                    sql.add(',pama_remarks='+Quotedstr(edt_remarkupdate.text));
                    sql.Add(',PAMA_EMAIL='+QuotedStr(Edit_Email.Text));
                    sql.add(' where pama_patientid='+Edit_PatientId.Text);
                    sql.saveToFile('C:\update.Txt');
                    Execsql;
               End;
               DM_Hospital.DB.Commit;
               PatientModifiedRecord(pi_PatientID);
               ShowDoneMessage;
          Except
               DM_Hospital.DB.Rollback;
               ShowMessage('Failure to save data !');
               Exit;
          End;
     End;
     Edit_PatientId.text:='';
     LabelName.Caption:='Name';
     Labelage.caption:='Age';
     EditAge.Text:='0';
     Edit_FirstName.text:='';
     Edit_LastName.text:='';
     CmbAgeType.ItemIndex:=0;
     ComboBoxGender.ItemIndex:=0;
     DateEditXDOB.text:=Serverdate.TodaysDate;
     CMBCountry.KeyValue:=NULL;
     CmbDistrict.KeyValue:=null;
     CmbVdc.KeyValue:=null;
     CMBWardNo.Text:='';
     EditAddress.text:= '';
     EditPhone.Text:= '';
     Edit_MobileNo.text:='';
     Edit_Email.text:='';
     //EditRPhone.Text:='';
     edt_remarkupdate.Text:='';
     dblcb_title.KeyValue:=null;
end;

procedure TForm_AgeUpdate.CmbAgeTypeChange(Sender: TObject);
Var li_DOBADCAlc:Integer;
DateEditXDOBAD:TDateEditX;
begin
     if pi_agetype<>CmbAgeType.ItemIndex then
     begin
          DateEditXDOBAD:=TDateEditX.Create(nil);
          DateEditXDOBAD.SystemOfDate:=gi_DateSystem;
          DateEditXRegAge.SystemOfDate:=gi_DateSystem;
          //DateEditXDOB.SystemOfDate:=gi_DateSystem;
          DateEditXRegAge.Text:=ServerDate.TodaysDate;
          IF EditAge.Text='' Then
          EditAge.Text:='0';
          if CmbAgeType.Text='Year' then
          DateEditXRegAge.ADDateAsDate:=DateEditXRegAge.ADDateAsDate-StrToInt(EditAge.Text)*365
          Else if CmbAgeType.Text='Month' then
          DateEditXRegAge.ADDateAsDate:=DateEditXRegAge.ADDateAsDate-StrToInt(EditAge.Text)*30
          Else if CmbAgeType.Text='Day' then
          DateEditXRegAge.ADDateAsDate:=DateEditXRegAge.ADDateAsDate-StrToInt(EditAge.Text);
          //DateEditXDOB.VSDateAsText:=DateEditXRegAge.VSDateAsText;
          //DateEditXDOB.Text:=DateEditXRegAge.Text;
          DateEditXDOBAD.TExt:= DateEditXRegAge.Text; //Subtracting 56 Yrs 08 Months and 16 Days to get ADDOB from DOB
          DateEditXDOBAD.SystemOfDate:=1;
          Ps_DOBAD:= DateEditXDOBAD.TExt;
          DateEditXDOB.text:=DateEditXDOBAD.VSDateAsText;
     end
     else
     begin
          DateEditXDOB.text:=Query_Search.FieldByName('dobvs').AsString;
          Ps_DOBAD:=Query_Search.FieldByName('dobad').AsString;
     end;
end;

