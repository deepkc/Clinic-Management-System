begin
     EditAgeExit(Sender);
end;

procedure TForm_AgeUpdate.EditAgeExit(Sender: TObject);
Var li_DOBADCAlc:Integer;
DateEditXDOBAD:TDateEditX;
begin
   if ps_age<>EditAge.Text then
   begin
        DateEditXDOBAD:=TDateEditX.Create(nil);
        DateEditXDOBAD.SystemOfDate:=gi_DateSystem;
        IF ((Trim(EditAge.Text)='') or (Trim(EditAge.Text)='0')) and (pi_SetAgeCount <= 2) Then
        Begin
           pi_SetAgeCount:=pi_SetAgeCount+1;
           MessageDlg('Plz. put patient age.',mtWarning,[mbok],0);
           EditAge.Text:='0';
           EditAge.SetFocus;
        End;
        IF (Trim(EditAge.Text)<>'') Then
        Begin
           IF StrToInt(EditAge.Text) > 0 Then
           Begin
                DateEditXRegAge.SystemOfDate:=gi_DateSystem;
                //DateEditXDOB.SystemOfDate:=gi_DateSystem;
                DateEditXRegAge.Text:=ServerDate.TodaysDate;
                //ChangeCaption(ButtonDOB);
                if CmbAgeType.Text='Year' then
                DateEditXRegAge.ADDateAsDate:=DateEditXRegAge.ADDateAsDate-StrToInt(EditAge.Text)*365
                Else if CmbAgeType.Text='Month' then
                DateEditXRegAge.ADDateAsDate:=DateEditXRegAge.ADDateAsDate-StrToInt(EditAge.Text)*30
                Else if CmbAgeType.Text='Day' then
                DateEditXRegAge.ADDateAsDate:=DateEditXRegAge.ADDateAsDate-StrToInt(EditAge.Text);
                //DateEditXDOB.Text:=ADToVS(DateEditXRegAge.VSDateAsText);
                //DateEditXDOB.VSDateAsText:=DateEditXRegAge.VSDateAsText;
                //DateEditXDOB.Text:=DateEditXRegAge.Text;
                DateEditXDOBAD.TExt:= DateEditXRegAge.Text; //Subtracting 56 Yrs 08 Months and 16 Days to get ADDOB from DOB
                DateEditXDOBAD.SystemOfDate:=1;
                Ps_DOBAD:= DateEditXDOBAD.TExt;
                DateEditXRegAge.Visible:=False;
                DateEditXDOB.text:=DateEditXDOBAD.VSDateAsText;
           End;
        End;
   end
   else
   begin
        DateEditXDOB.text:=Query_Search.FieldByName('dobvs').AsString;
        Ps_DOBAD:=Query_Search.FieldByName('dobad').AsString;
   end;
end;

