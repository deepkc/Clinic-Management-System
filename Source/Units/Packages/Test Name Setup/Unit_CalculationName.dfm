  object OraQuery_TestName: TOraQuery
    SQL.Strings = (
      
        'select tena_testnameid testnameid, tena_testname testname from h' +
        's_tena_testname where tena_ISACTIVE='#39'Y'#39' order by tena_testname')
    Left = 208
    Top = 289
  end
  object DS_TestName: TDataSource
    DataSet = OraQuery_TestName
    Left = 152
    Top = 304
  end
  object OraQuery_DbGrid: TOraQuery
    Session = DM_Hospital.DB
    SQL.Strings = (
      
        'select a1.*,(select tena_TESTNAME from hs_tena_testname where te' +
        'na_testnameid=cana_testnameid)as testname from lb_cana_calculati' +
        'onname a1 order by CANA_CALCULATIONID')
    Left = 416
    Top = 296
  end
  object DS_Dbgrid: TDataSource
    DataSet = OraQuery_DbGrid
    Left = 440
