  private
    { Private declarations }
  public
  var Pb_CheckOP:boolean;
    { Public declarations }
  end;

var
  Form_TestCalculation: TForm_TestCalculation;

implementation

{$R *.dfm}

procedure TForm_TestCalculation.BitBtn1Click(Sender: TObject);
begin
     if PageControl1.ActivePageIndex=1 then
     begin
          PageControl1.ActivePageIndex:=0;
          Bitbtn2.enabled:=false;
          Bitbtn3.enabled:=True;

     end
     else
     close;

end;

procedure TForm_TestCalculation.FormShow(Sender: TObject);
begin
     BitBtn2.enabled:=false;
     OraQuery_Calccode.Close;
     OraQuery_Calccode.Session:=DM_Hospital.DB;
     OraQuery_Calccode.Open;

     OraQuery_Test.Close;
     OraQuery_Test.Session:=DM_Hospital.DB;
     OraQuery_Test.Open;


     OraQuery_Testname.Close;
     OraQuery_Testname.Session:=DM_Hospital.DB;
     OraQuery_Testname.Open;
     PageControl1.ActivePageIndex:=0;

     OraQuery_DbGrid.Close;
     OraQuery_DbGrid.Session:=DM_Hospital.DB;
     OraQuery_DbGrid.Open;
end;

procedure TForm_TestCalculation.PageControl1Change(Sender: TObject);
begin
     if PageControl1.ActivePageIndex=0 then
     begin
          PageControl1.ActivePageIndex:=1;
     end
     else
     PageControl1.ActivePageIndex:=0;
end;

procedure TForm_TestCalculation.BitBtn2Click(Sender: TObject);
var Oraquery1:TOraQuery;
var Oraquery2:TOraQuery;
var Idmax:Integer;
begin
     if DBLCB_TestName.KeyValue=null then
     begin
          ShowMessage('Please Select TestName');
          DBLCB_TestName.SetFocus;
          exit;
     end;
     if DBLCB_CalcCode.KeyValue=null then
     begin
          ShowMessage('Please select Calculation Code');
          DBLCB_CalcCode.SetFocus;
          exit;
     end;
     if DBLCB_Test.KeyValue=null then
     begin
          ShowMessage('Please Select Test');
          DBLCB_Test.SetFocus;
          exit;
     end;
     if Trim(Edit_TestCode.text)='' then
     begin
          ShowMessage('Please Enter Test Code of Max 5 Character');
          Edit_TestCode.SetFocus;
          exit;
     end;

     if Pb_CheckOP=True then
     begin
          try
               Oraquery1:=TOraQuery.Create(nil);
               Idmax:=GetMaxId('lb_catn_calculationtestname','catn_CALCULATIONTESTID');
               with Oraquery1 do
               begin
                    Close;
                    Session:=DM_Hospital.DB;
                    sql.Clear;
                    sql.Add('insert into lb_catn_calculationtestname values (');
                    sql.Add(IntToStr(Idmax)+','+QuotedStr(Trim(DBLCB_CalcCode.Text))+','+intTOStr(DBLCB_TestName.KeyValue)+','+intToStr(DBLCB_Test.KeyValue));
                    SQL.Add(','+QuotedStr(Trim(Edit_TestCode.Text)));
                    sql.Add(')');
                    //sql.SaveToFile('C:\abc43.txt');
                    ExecSQL;
               end;
          except
               ShowMessage('The Data You have Entered is already Saved Or Could Not Saved');
               exit;
          end;
     end
     else
     begin
          Oraquery1:=TOraQuery.Create(nil);
          with Oraquery1 do
          begin
               close;
               Session:=DM_Hospital.DB;
               sql.Clear;
               sql.Add('update lb_catn_calculationtestname set ');
               sql.Add(' CATN_SOURCETESTCODE='+QuotedStr(DBLCB_CalcCode.text)+',CATN_TESTID='+IntToStr(DBLCB_Test.keyvalue));
               sql.Add(' where CATN_CALCULATIONTESTID='+);
              // SQL.SaveToFile('C:\ab2.txt');
               ExecSQL;
          end;
     end;

     DBLCB_TestName.KeyValue:=null;
     DBLCB_CalcCode.KeyValue:=null;
     DBLCB_Test.KeyValue:=null;
     Edit_TestCode.Text:='';
     PageControl1.ActivePageIndex:=0;
     OraQuery_DbGrid.Close;
     OraQuery_DbGrid.Session:=DM_Hospital.DB;
     OraQuery_DbGrid.Open;
     BitBtn3.Enabled:=True;
     BitBtn2.Enabled:=false;
     Oraquery1.Free;


end;

procedure TForm_TestCalculation.BitBtn3Click(Sender: TObject);
begin
     PageControl1.ActivePageIndex:=1;
     BitBtn3.Enabled:=false;
     BitBtn2.Enabled:=True;
     DBLCB_TestName.KeyValue:=null;
     DBLCB_CalcCode.KeyValue:=null;
     DBLCB_Test.KeyValue:=null;
     Edit_TestCode.Text:='';
     Pb_CheckOP:=True;
     DBLCB_TestName.SetFocus;

end;

procedure TForm_TestCalculation.DBGrid1DblClick(Sender: TObject);
begin

     if OraQuery_DbGrid.RecordCount>0 then
     begin
          DBLCB_TestName.KeyValue:=OraQuery_DbGrid.FieldByName('catn_TESTNAMEID').AsInteger;
          DBLCB_CalcCode.keyvalue:=OraQuery_DbGrid.FieldByName('SOURCETESTCODE').asString;
          DBLCB_Test.KeyValue:=OraQuery_DbGrid.FieldByName('catn_TESTID').AsInteger;
          Edit_TestCode.Text:=OraQuery_DbGrid.FieldByName('catn_TESTCODE').AsString;
          PageControl1.ActivePageIndex:=1;
          BitBtn2.enabled:=True;
          BitBtn3.enabled:=false;
          Pb_CheckOP:=false;
     end;
end;


procedure TForm_TestCalculation.DBLCB_CalcCodeKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
     if Key=VK_DELETE then
     begin
       DBLCB_TestName.KeyValue:=null;
     end;
end;

procedure TForm_TestCalculation.DBLCB_CalcCodeKeyPress(Sender: TObject;
  var Key: Char);
begin
     if Key=#13 then
     begin
          DBLCB_Test.SetFocus;
     end;
end;

procedure TForm_TestCalculation.DBLCB_TestKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
     if Key=VK_DELETE then
