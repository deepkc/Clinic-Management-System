end;

procedure TForm_TestCalculation.DBLCB_TestNameClick(Sender: TObject);
begin
     with OraQuery_Test do
     begin
          Close;
          Session:=DM_Hospital.DB;
          sql.Clear;
          SQL.Add('select Testid,Test from test where testnameid='+inTToStr(DBLCB_TestName.KeyValue));
          open;
     end;

     with OraQuery_Calccode do
     begin
          close;
          session:=DM_Hospital.db;
          sql.clear;
          sql.add('select CANA_CALCULATIONID as CALCULATIONID,CANA_SOURCETESTCODE as SOURCETESTCODE from lb_cana_calculationname where CANA_TESTNAMEID='+inTToStr(DBLCB_TestName.KeyValue));
          open;
          DBLCB_CalcCode.KeyValue:=FieldByName('CALCULATIONID').AsInteger;
     end;

end;

procedure TForm_TestCalculation.DBLCB_TestNameKeyDown(Sender: TObject;
  var Key: Word; Shift: TShiftState);
begin
     if Key=VK_DELETE then
