procedure TForm_InregrationSetup.SPB_SetAccHeadClick(Sender: TObject);
Var
     i,li_accheadop,li_accheadip: Integer;

begin
     if DBLCB_Dep.KeyValue=NULL then
     Begin
          MessageDlg('Please Select Department to set Account Head!', mtWarning, [mbok], 0);
          Exit;
     End;

     if (DBGrid1.SelectedRows.Count = 0) then
     Begin
          MessageDlg('Please Select The Test Name to set Account Head!', mtWarning, [mbok], 0);
          Exit;
     End;

     if strtoint(Label_AccHeadId.Caption)=0 then
     Begin
          MessageDlg('Cannot Set Account Head ID as 0. Please Select Account Head !', mtWarning, [mbok], 0);
          Exit;
     End;

     IF MessageDlg('Are You Sure To Set Account Head For These Items????', mtConfirmation, [mbYes, mbNo], 0) = mrNo Then
     Exit;

     if (DBGrid1.SelectedRows.Count > 0) then
     Begin
          with DBGrid1.DataSource.DataSet do
          begin
               Try
                    DM_Hospital.DB.StartTransaction;
                    for i := 0 to DBGrid1.SelectedRows.Count - 1 do
                    begin
                         GotoBookmark(pointer(DBGrid1.SelectedRows.Items[i]));
                         With Query_Save do
                         Begin
                              close;
                              databasename:=gs_databasename;
                              sql.Clear;
                              sql.Add('Update hs_tena_testname set');
                              sql.add('tena_accheadid='+Label_AccHeadId.Caption);
                              sql.Add('where tena_testnamecode='+quotedstr(DBGrid1.DataSource.DataSet.FieldByName('testnamecode').AsString));
                              //sql.SaveToFile('C:\Check.txt');
                              ExecSql;

                              Close;
                              databasename:=gs_databasename;
                              sql.Clear;
                              Sql.Add('Update hs_bide_billdetail set BIDE_ACCHEADID='+Label_AccHeadId.Caption);
                              Sql.Add('Where bide_service='+quotedstr(DBGrid1.DataSource.DataSet.FieldByName('testnamecode').AsString));
                              Sql.Add('and nvl(BIDE_ACCHEADID,0)=0');
                              ExecSql;

                              Close;
                              databasename:=gs_databasename;
                              sql.Clear;
                              Sql.Add('Update hs_Rede_Refunddetail set REDE_ACCHEADID='+Label_AccHeadId.Caption);
                              Sql.Add('Where Rede_service='+quotedstr(DBGrid1.DataSource.DataSet.FieldByName('testnamecode').AsString));
                              Sql.Add('and nvl(REDE_ACCHEADID,0)=0');
                              ExecSql;
                         End;
                    End;
                    DM_Hospital.DB.Commit;
                    ShowDoneMessage;
               Except
                    DM_Hospital.DB.Rollback;
               end;
          end;
     End;
     with Query_list do
     begin
          Close;
          DatabaseName := gs_DatabaseName;
          SQL[1] := 'Where Depid=' + IntToStr(DBLCB_Dep.KeyValue);
          Open;
     end;
     ShowAccHead;
end;

procedure TForm_InregrationSetup.TreeView1Click(Sender: TObject);
var
     SelNode: TTreeNode;
     NodeText, lf, ls_childNode: String;
     IID: Integer;
begin
     {if RB_Service.Checked then
          IID:=37
     Else if RB_serviceipd.Checked then
          IID:=36; }
     IID:=6;

     if TreeView1.ReadOnly = False then
          Exit;
     SelNode := TreeView1.Selected;
     Label_AccHeadName.Caption := TreeView1.Selected.Text;
     NodeText := Copy(SelNode.Text, 1, pos(' - ', SelNode.Text) - 1);
     if NodeText <> '' then
     begin
          IID := StrToInt(NodeText);
          Label_AccHeadId.Caption := IntToStr(IID);
          pi_AccountHeadId := IID;
          // IID:= StrToInt(NodeText);
          qry_stateofaccount.Close;
          qry_stateofaccount.ParamByName('id').AsInteger := IID;
          qry_stateofaccount.Open;
     end;

     if not SelNode.HasChildren then
     begin
          with QueryAccTree do
          begin
               Close;
               sql.Clear;
               sql.Add(' SELECT ID, Name, LF, State ');
               sql.Add(' FROM bnb_acc.AccTree ');
               sql.Add(' WHERE ParentID = ' + IntToStr(IID));
                if RBtn_Code.Checked then
                 sql.add(' ORDER BY LF ');
               //sql.Add(' ORDER BY Name ');
               Open;
          end;

          with QueryAccTree do
          begin
               while not EOF do
               begin
                    if FieldByName('LF').AsString <> '' then
                         ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName('LF').AsString + ' 0 ' + FieldByName('Name').AsString
                    else
                         ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName('Name').AsString;
                    TreeView1.Items.AddChild(SelNode, ls_childNode);
                    Next;
               end;
          end;
     end;
end;

