procedure TForm_InregrationSetup.AddMyGrandChilds(MyId: Integer;
  MyNode: TTreeNode);
var
     QueryChilds: TOraQuery;
     ChildNode: TTreeNode;
     ls_childNode: String;
     li_childId: Integer;
begin
     QueryChilds := TOraQuery.Create(nil);

     if not MyNode.HasChildren then
     begin
          with QueryChilds do
          begin
               Close;
               Session := DM_Hospital.DB;
               sql.Clear;
               sql.Add(' SELECT * FROM bnb_acc.AccTree WHERE ParentID = ' +IntToStr(MyId));
               if RBtn_Code.Checked then
                    sql.Add(' ORDER BY LF ');
               Open;

               First;
               while not EOF do
               begin
                    if FieldByName('LF').AsString <> '' then
                         ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName('LF').AsString + ' 0 ' + FieldByName('Name').AsString
                    else
                         ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName('Name').AsString;
                    TreeView1.Items.AddChild(MyNode, ls_childNode);
                    Next;
               end;
          end; // QueryChilds
     end; // if no childs

     ChildNode := MyNode.getFirstChild;
     while ChildNode <> nil do
     begin
          if not ChildNode.HasChildren then
          begin
               with QueryChilds do
               begin
                    li_childId := StrToInt
                      (Copy(ChildNode.Text, 1, pos(' - ', ChildNode.Text) - 1));
                    Close;
                    DatabaseName := gs_DatabaseName;
                    sql.Clear;
                    sql.Add(' SELECT * FROM bnb_acc.AccTree WHERE ParentID = '+ IntToStr(li_childId));
                    if RBtn_Code.Checked then
                         sql.Add(' ORDER BY LF ');
                    Open;

                    First;
                    while not EOF do
                    begin
                         if FieldByName('LF').AsString <> '' then
                              ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName('LF').AsString + ' 0 ' + FieldByName('Name').AsString
                         else
                              ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName('Name').AsString;
                         TreeView1.Items.AddChild(ChildNode, ls_childNode);

                         Next;
                    end;
               end;
          end;

          ChildNode := MyNode.GetNextChild(ChildNode);
     end;
     QueryChilds.destroy;
end;

