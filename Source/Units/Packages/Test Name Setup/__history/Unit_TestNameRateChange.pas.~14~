procedure TForm_TestNameRateChange.BB_CloseClick(Sender: TObject);
begin
     if PageControl1.ActivePageIndex = 1 then
     Begin
          PageControl1.ActivePageIndex := 0;
          Query_list.Close;
          Query_list.Session := DM_Hospital.DB;
          Query_list.Open;
