  object Query_Receipt: TOraQuery
    SQL.Strings = (
      
        'Select CRPD_RECEIPTNO RECEIPTNO,CRPD_DATAPOSTDate||'#39' - '#39'||CRPD_D' +
        'ATAPOSTTime as DateTime,(Select USERNAME From LAB_USERMAIN where' +
        ' UserId=CPD.CRPD_DATAPOSTBy) as UserName'
      
        ',(Select SCHE_Scheme From HS_SCHE_Scheme where SCHE_SchemeId=CPD' +
        '.CRPD_SchemeId) as SchemeName,CRPD_Amount RECEIPTAMOUNT,Trim(Sub' +
        'Str(CRPD_CrBillNo,1,79)) CrBillNoDetail'
      'From HS_CRPD_CreditPaymentDetail CPD'
      'WHERE CRPD_RECEIPTNO='#39'RCP72/73-000001'#39)
    Left = 504
    Top = 24
  end
  object Query_TotalPatient: TOraQuery
    SQL.Strings = (
      
        'Select Count(Distinct(bide_PatientId)) as TotalNumber From hs_bi' +
        'de_BillDetail where bide_BillNo In ('
      'Select CRPD_CrBillNo From HS_CRPD_CreditPaymentDetail'
      'where CRPD_ReceiptNo='#39'CP72/73-0000001'#39
      ')')
    Left = 608
    Top = 32
  end
