procedure TForm_VirtualMenuPrevilage.VST2GetText(Sender: TBaseVirtualTree;
  Node: PVirtualNode; Column: TColumnIndex; TextType: TVSTTextType;
  var CellText: UnicodeString);
var
  Data: PNodeData2;

begin
       Data := Sender.GetNodeData(Node);
       CellText := '';
       case Column of
         0: // main column (has two different captions)
           case TextType of
             ttNormal:
               CellText := Data.nodetext;
           end;
         1: // no text in the image column
           ;
       end;
end;

procedure TForm_VirtualMenuPrevilage.VST_MenuPrevilageChecked(
  Sender: TBaseVirtualTree; Node: PVirtualNode);
  var
  Data: PNodeData2;
begin
     if pb_change then
     begin
           data:=sender.GetNodeData(node);
           with data^ do
           begin
               if (node.CheckState=csCheckedNormal) or (node.CheckState=csMixedNormal) then
               begin
                    cstate:='T';
               end
               else if node.CheckState=csUncheckedNormal then
               begin
                    cstate:='F';
               end;
           end;
           with Query_tempupdate do
           begin
                Close;
                SQL.Clear;
                databasename:=gs_temppath;
                sql.Add('update tbl_previlage.db set cstate='+quotedstr(Data.cstate));
                sql.Add('where id='+inttostr(Data.id));
                sql.Add('and accesstype='+quotedstr(Data.accesstype));
                ExecSQL;
           end;
           //ShowMessage(data.Caption+','+inttostr(data.id)+''+data.cstate);
     end;
end;

