               FieldByName('nodetext').asstring:=Data.nodetext;
               FieldByName('caption').asstring:=Data.caption;
               fieldByName('accesstype').asstring:=Data.accesstype;
               FieldByName('cstate').asstring:=Data.cstate;
               Post;
          end;
           Query_SubMainMenu.Next;
    end
    else if Level=4 then
    begin
          nodetext := Format('%d.%d- %S', [Level, Query_FUNCTION.FieldByName('SYFU_FUNCTIONID')
                           .ASINTEGER,Query_FUNCTION.FieldByName('SYFU_FUNCTIONNAME').AsString]);
          caption:= Query_FUNCTION.FieldByName('SYFU_FUNCTIONNAME').AsString;
          Data.id:=Query_FUNCTION.FieldByName('SYFU_FUNCTIONID')
                           .ASINTEGER;
          Data.accesstype:='FUNCTION';
          //Include(InitialStates, ivsHasChildren);
          Include(InitialStates, ivsExpanded);
          Node.CheckType := LevelToCheckType[Data.Level];
          with OraQuery_check do
          begin
               close;
               session:=DM_Hospital.DB;
               sql.Clear;
               sql.Add('select * from HS_MEPR_MENUPREVILAGE');
               Sql.Add('where mepr_userid='+inttostr(pi_userid)+' and MEPR_ACCESSTYPE=''FUNCTION''');
               SQL.Add('and MEPR_FUNCTIONID='+inttostr(Data.id));
               open;
               first;
          end;
           if OraQuery_check.RecordCount>0 then
          begin
               Sender.CheckState[Node] := csCheckedNormal ;
               Data.cstate:='T';
          end
          else
          begin
              Sender.CheckState[Node] := csUncheckedNormal;
              Data.cstate:='F';
          end;
          with Table_Previlage do
          begin
               Append;
               FieldByName('id').AsInteger:=Data.id;
               FieldByName('userid').AsInteger:=pi_userid;
               FieldByName('nodetext').asstring:=Data.nodetext;
               FieldByName('caption').asstring:=Data.caption;
               fieldByName('accesstype').asstring:=Data.accesstype;
               FieldByName('cstate').asstring:=Data.cstate;
               Post;
          end;
           Query_FUNCTION.Next;
    end
    else
          caption:= Format('Level %d, Index %d', [Level, Node.Index]);
  end;
end;

procedure TForm_VirtualMenuPrevilage.VST_MenuPrevilagePaintText(
  Sender: TBaseVirtualTree; const TargetCanvas: TCanvas; Node: PVirtualNode;
  Column: TColumnIndex; TextType: TVSTTextType);
var
  Data: PNodeData2;
begin
  Data := Sender.GetNodeData(Node);
  case Column of
    0: // main column
      case TextType of
        ttNormal:
          if Data.Level = 0 then
          begin
            TargetCanvas.Font.Size:=14;
            TargetCanvas.Font.Style := TargetCanvas.Font.Style + [fsBold];
          end
          else  if Data.Level = 1 then
          begin
            TargetCanvas.Font.Size:=12;
            TargetCanvas.Font.Style := TargetCanvas.Font.Style + [fsBold];
          end
          else  if Data.Level =2 then
          begin
            TargetCanvas.Font.Size:=10;
            TargetCanvas.Font.Style := TargetCanvas.Font.Style + [fsBold];
          end
          else  if Data.Level = 3 then
          begin
            TargetCanvas.Font.Size:=9;
            TargetCanvas.Font.Style := TargetCanvas.Font.Style + [fsBold];
          end
          else  if Data.Level = 4 then
          begin
            TargetCanvas.Font.Size:=8;
            TargetCanvas.Font.Style := TargetCanvas.Font.Style + [fsBold];
          end;
      end;
    1: // image column (there is no text)
      ;
    2: // language column (no customization)
      ;
  end;
end;

end.
