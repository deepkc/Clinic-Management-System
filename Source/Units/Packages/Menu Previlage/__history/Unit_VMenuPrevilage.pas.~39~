var
  Data: PNodeData2;
begin
  QUERY_FUNCTION:=TOraQuery.Create(NIL);
  Data := Sender.GetNodeData(Node);
  if Data.Level =0 then
  begin
      with Query_ModuleNode do
     begin
          Close;
         session:=DM_Hospital.DB;
          sql.Clear;
          sql.Add(' Select * from HS_MODU_Module order by MODU_MODULEID ');
          Open;
          First;
     end;
     ChildCount := Query_ModuleNode.RecordCount;
  end
  else if data.level=1 then
  begin
      with Query_MainMenu do
      begin
           Close;
          session:=DM_Hospital.DB;
           sql.Clear;
           sql.Add (' SELECT * FROM HS_MAME_MainMenu WHERE MAME_ModuleId = '+ IntToStr(Data.id));
           SQL.Add(' MAME_ISACTIVEMENU=''Y'' order by MAME_MAINMENUID');
           Open;
           First;
      end;
      ChildCount := Query_MainMenu.RecordCount;
  end
  else if data.level=2 then
  begin
      with Query_SubMainMenu do
      begin
            Close;
            session:=DM_Hospital.DB;
