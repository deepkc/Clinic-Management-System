            SQL.Add(' order by SYFU_FUNCTIONID');
            Open;
            First;
      end;
      ChildCount := Query_FUNCTION.RecordCount;
  end;
end;
procedure TForm_VirtualMenuPrevilage.VST_MenuPrevilageInitNode(
  Sender: TBaseVirtualTree; ParentNode, Node: PVirtualNode;
  var InitialStates: TVirtualNodeInitStates);
const
  LevelToCheckType: array[0..5] of TCheckType = (
    ctTriStateCheckBox, ctTriStateCheckBox, ctTriStateCheckBox, ctTriStateCheckBox, ctTriStateCheckBox, ctTriStateCheckBox
  );

var
  Data: PNodeData2;

begin
  with Table_Previlage do
  begin
       Close;
       tablename:='tbl_previlage.db';
       Open;
  end;
  Data := Sender.GetNodeData(Node);
  with Data^ do
  begin
    Level := Sender.GetNodeLevel(Node);
    if Level=0 then
    begin
         nodetext:='0.0- Guided Menu'  ;
         caption:='Guided Menu'  ;
         Include(InitialStates, ivsHasChildren);
          Include(InitialStates, ivsExpanded);
           Node.CheckType := LevelToCheckType[Data.Level];
          Sender.CheckState[Node] := csCheckedNormal;
    end
    else if Level=1 then
    begin
          nodetext := Format('%d.%d- %S', [Level, Query_ModuleNode.FieldByName('MODU_MODULEID')
                           .ASINTEGER,Query_ModuleNode.FieldByName('MODU_MODULENAME').AsString]);
          caption:= Query_ModuleNode.FieldByName('MODU_MODULENAME').AsString;
          Data.id:=Query_ModuleNode.FieldByName('MODU_MODULEID')
                           .ASINTEGER;
          Data.accesstype:='MODULE';
          Include(InitialStates, ivsHasChildren);
          Include(InitialStates, ivsExpanded);

          Node.CheckType := LevelToCheckType[Data.Level];
          with OraQuery_check do
          begin
               close;
               session:=DM_Hospital.DB;
               sql.Clear;
               sql.Add('select * from HS_MEPR_MENUPREVILAGE');
               Sql.Add('where mepr_userid='+inttostr(pi_userid)+' and MEPR_ACCESSTYPE=''MODULE''');
               SQL.Add('and MEPR_moduleid='+inttostr(Data.id));
               open;
               first;
          end;
          if OraQuery_check.RecordCount>0 then
          begin
               Sender.CheckState[Node] := csCheckedNormal ;
               Data.cstate:='T';
          end
          else
          begin
              Sender.CheckState[Node] := csUncheckedNormal;
              Data.cstate:='F';
          end;
          with Table_Previlage do
          begin
               Append;
               FieldByName('id').AsInteger:=Data.id;
               FieldByName('userid').AsInteger:=pi_userid;
               FieldByName('nodetext').asstring:=Data.nodetext;
               FieldByName('caption').asstring:=Data.caption;
               fieldByName('accesstype').asstring:=Data.accesstype;
               FieldByName('cstate').asstring:=Data.cstate;
               Post;
          end;
           Query_ModuleNode.Next;

    end
    else if Level=2 then
    begin
          nodetext := Format('%d.%d- %S', [Level, Query_MainMenu.FieldByName('mame_mainmenuid')
                           .ASINTEGER,Query_MainMenu.FieldByName('mame_mainmenu').AsString]);
          caption:= Query_MainMenu.FieldByName('mame_mainmenu').AsString;
          Data.id:=Query_MainMenu.FieldByName('mame_mainmenuid')
                           .ASINTEGER;
          Data.accesstype:='MAINMENU';
          Include(InitialStates, ivsHasChildren);
          Include(InitialStates, ivsExpanded);
           Node.CheckType := LevelToCheckType[Data.Level];
          with OraQuery_check do
          begin
               close;
               session:=DM_Hospital.DB;
               sql.Clear;
               sql.Add('select * from HS_MEPR_MENUPREVILAGE');
               Sql.Add('where mepr_userid='+inttostr(pi_userid)+' and MEPR_ACCESSTYPE=''MAINMENU''');
               SQL.Add('and MEPR_menuid='+inttostr(Data.id));
               open;
               first;
          end;
           if OraQuery_check.RecordCount>0 then
          begin
               Sender.CheckState[Node] := csCheckedNormal ;
               Data.cstate:='T';
          end
          else
          begin
              Sender.CheckState[Node] := csUncheckedNormal;
              Data.cstate:='F';
          end;
           with Table_Previlage do
          begin
               Append;
               FieldByName('id').AsInteger:=Data.id;
               FieldByName('userid').AsInteger:=pi_userid;
               FieldByName('nodetext').asstring:=Data.nodetext;
               FieldByName('caption').asstring:=Data.caption;
               fieldByName('accesstype').asstring:=Data.accesstype;
               FieldByName('cstate').asstring:=Data.cstate;
               Post;
          end;
           Query_MainMenu.Next;
    end
    else if Level=3 then
    begin
          nodetext := Format('%d.%d- %S', [Level, Query_SubMainMenu.FieldByName('SUME_SUBMENUID')
