procedure TForm_VirtualMenuPrevilage.BB_OKClick(Sender: TObject);
var Data: PNodeData2;
begin
   //  VST_MenuPrevilage.GetFirstSelected(true);
    try
          DM_Hospital.DB.StartTransaction;
          with Query_temp do
          begin
              Close;
              SQL.Clear;
              databasename:=gs_temppath;
              sql.Add('select * from tbl_previlage.db');
              Open;
              First;
          end;
          while not  Query_temp.Eof  do
          begin
               if Query_temp.FieldByName('cstate').asstring='F' then
               begin
                    with Query_update do
                    begin
                         close;
                         Session:=DM_Hospital.DB;
                         sql.Clear;
                         sql.Add('Delete from HS_MEPR_MENUPREVILAGE ');
                         Sql.Add('where MEPR_USERID='+inttostr(Query_temp.FieldByName('userid').asinteger));
                        sql.Add('and mepr_accesstype='+quotedstr(Query_temp.FieldByName('accesstype').asstring));
                         if Query_temp.FieldByName('accesstype').asstring='MODULE' then
                             sql.Add('and mepr_moduleid='+inttostr(Query_temp.FieldByName('id').asinteger))
                         ELSE if Query_temp.FieldByName('accesstype').asstring='SUBMENU' then
                             sql.Add('and mepr_SUBMENUid='+inttostr(Query_temp.FieldByName('id').asinteger))
                         ELSE if Query_temp.FieldByName('accesstype').asstring='MAINMENU' then
                             sql.Add('and mepr_MENUid='+inttostr(Query_temp.FieldByName('id').asinteger))
                         ELSE if Query_temp.FieldByName('accesstype').asstring='FUNCTION' then
                             sql.Add('and mepr_functionid='+inttostr(Query_temp.FieldByName('id').asinteger));
                         ExecSQL;
                    end;
               end
               else
               begin
                    with Query_check2 do
                    begin
                       close;
                         Session:=DM_Hospital.DB;
                         sql.Clear;
                         sql.Add('select * from  HS_MEPR_MENUPREVILAGE ');
                         Sql.Add('where MEPR_USERID='+inttostr(Query_temp.FieldByName('userid').asinteger));
                        sql.Add('and mepr_accesstype='+quotedstr(Query_temp.FieldByName('accesstype').asstring));
                         if Query_temp.FieldByName('accesstype').asstring='MODULE' then
                             sql.Add('and mepr_moduleid='+inttostr(Query_temp.FieldByName('id').asinteger))
                         ELSE if Query_temp.FieldByName('accesstype').asstring='SUBMENU' then
                             sql.Add('and mepr_SUBMENUid='+inttostr(Query_temp.FieldByName('id').asinteger))
                         ELSE if Query_temp.FieldByName('accesstype').asstring='MAINMENU' then
                             sql.Add('and mepr_MENUid='+inttostr(Query_temp.FieldByName('id').asinteger))
                         ELSE if Query_temp.FieldByName('accesstype').asstring='FUNCTION' then
                             sql.Add('and mepr_functionid='+inttostr(Query_temp.FieldByName('id').asinteger));
                         Open;
                    end;
                    if Query_check2.RecordCount=0 then
                    begin
                         with Query_update do
                         begin
                                close;
                                Session:=DM_Hospital.DB;
                                sql.Clear;
                                sql.Add('Insert into HS_MEPR_MENUPREVILAGE(MEPR_PREVILAGEID,MEPR_USERID,MEPR_FUNCTIONID,MEPR_SUBMENUID,MEPR_MENUID,MEPR_MODULEID,MEPR_ROOTID,MEPR_NODETEXT,MEPR_CAPTIONNAME,MEPR_AccessType) ');
                                sql.Add('values('+inttostr(GetMaxID('HS_MEPR_MENUPREVILAGE', 'MEPR_PREVILAGEID'))+
                                ','+inttostr(Query_temp.FieldByName('userid').asinteger));
                                if Query_temp.FieldByName('accesstype').asstring='MODULE' then
                                   sql.Add(','+IntToStr(0)+','+IntToStr(0)+','+IntToStr(0)+','+inttostr(Query_temp.FieldByName('id').asinteger))
                                ELSE if Query_temp.FieldByName('accesstype').asstring='SUBMENU' then
                                   sql.Add(','+IntToStr(0)+','+IntToStr(Query_temp.FieldByName('id').asinteger)+','+IntToStr(getmenuid(Query_temp.FieldByName('id').asinteger,'SUBMENU').menuid)+','+inttostr(getmenuid(Query_temp.FieldByName('id').asinteger,'SUBMENU').moduleid))
                                ELSE if Query_temp.FieldByName('accesstype').asstring='FUNCTION' then
                                   sql.Add(','+IntToStr(Query_temp.FieldByName('id').asinteger)+','+IntToStr(getmenuid(Query_temp.FieldByName('id').asinteger,'FUNCTION').SUBMENUID)+','+IntToStr(getmenuid(Query_temp.FieldByName('id').asinteger,'FUNCTION').menuid)+','+inttostr(getmenuid(Query_temp.FieldByName('id').asinteger,'FUNCTION').moduleid))
                                ELSE if Query_temp.FieldByName('accesstype').asstring='MAINMENU' then
                                   sql.Add(','+IntToStr(0)+','+IntToStr(0)+','+IntToStr(Query_temp.FieldByName('id').asinteger)+','+inttostr(getmenuid(Query_temp.FieldByName('id').asinteger,'MAINMENU').moduleid));
                                sql.Add(','+inttostr(0)+','
                                +Quotedstr(Query_temp.FieldByName('nodetext').asstring)+','
                                +QuotedStr(Query_temp.FieldByName('caption').asstring)+','
                                +QuotedStr(Query_temp.FieldByName('accesstype').asstring)+ ')');
                                //sql.SaveToFile('d:\ok.txt');
                                ExecSQL;
                         end;
                    end;
               end;
               Query_temp.Next;
          end;
           DM_Hospital.DB.Commit;
           ShowDoneMessage;
    except
          DM_Hospital.DB.Rollback;
          MessageDlg('Failure to save previlage. Plz Try again.',mtWarning,[mbok],0);
    end;
    VST_MenuPrevilage.Enabled:=False;
    pb_change:=False;
end;

