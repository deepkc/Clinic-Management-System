type
 PNodeData2 = ^TNodeData2;
 TNodeData2 = record
    Caption:string;
    id,
    Level: Integer;
    cstate,
    accesstype,
    nodetext:string;
  end;
  Tmenuid=record
  moduleid,menuid,submenuid,functionid :integer;
  end;
function getmenuid(id:integer; accesstype:string):Tmenuid;
var qry:TOraQuery;
begin
     qry:=TOraQuery.Create(nil);
    if accesstype='MODULE' then
    begin
         result.moduleid:=id;
         Result.menuid:=0;
         result.submenuid:=0;
         Result.functionid:=0;
    end
    else if accesstype='SUBMENU' then
    begin
           with qry do
           begin
                Close;
                sql.Clear;
                Session:=DM_Hospital.DB;
                SQL.Add('select sume_submenuid,sume_mainmenuid,mame_moduleid from hs_sume_submenu ,hs_mame_mainmenu');
                sql.Add('where sume_mainmenuid=mame_mainmenuid and sume_submenuid='+inttostr(id)+' and MAME_ISACTIVEMENU=''Y'');
                Open;
           end;
          result.moduleid:=qry.FieldByName('mame_moduleid').AsInteger;
          Result.menuid:=qry.FieldByName('sume_mainmenuid').AsInteger;
          result.submenuid:=id;
          Result.functionid:=0;
    end
    else if accesstype='MAINMENU' then
    begin
           with qry do
           begin
                Close;
                sql.Clear;
                Session:=DM_Hospital.DB;
                SQL.Add('select mame_mainmenuid,mame_moduleid from hs_mame_mainmenu ');
                sql.Add('where MAME_ISACTIVEMENU=''Y'' mame_mainmenuid='+inttostr(id)+' and MAME_ISACTIVEMENU=''Y''');
                Open;
           end;
          result.moduleid:=qry.FieldByName('mame_moduleid').AsInteger;
          Result.menuid:=id;
          result.submenuid:=0;
          Result.functionid:=0;
    end
    else if accesstype='FUNCTION' then
    begin
           with qry do
           begin
                Close;
                sql.Clear;
                Session:=DM_Hospital.DB;
                SQL.Add('select SYFU_MAINMENUID,SYFU_SUBMENUID,');
                SQL.Add('(SELECT MAME_MODULEID FROM HS_MAME_MAINMENU WHERE SYFU_MAINMENUID=MAME_MAINMENUID) SYFU_MODULEID ');
                SQL.Add('from hs_SYFU_SYSTEMFUNCTION');
                sql.Add('where SYFU_FUNCTIONID='+inttostr(id));
                Open;
           end;
          result.moduleid:=qry.FieldByName('SYFU_MODULEID').AsInteger;
          Result.functionid:=id;
          result.submenuid:=qry.FieldByName('SYFU_SUBMENUID').AsInteger;
          result.menuid:=qry.FieldByName('SYFU_MAINMENUID').AsInteger;
    end;
    qry.Free;

end;


