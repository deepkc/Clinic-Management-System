Procedure TForm_FractionMgmtNew.Get_Frct_BreakUp_OfItem;
var
     lf_FractionTotal:Double;
Begin
     With Query_Frct_BreakUp_OfItem do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select Frde_FractionDetailId FractionDetailId,Frde_FractionId FractionId,(Select DOCT_DocCode From HS_DOCT_Doctor where DOCT_DocID=FRDE_DocID) as DocCode,Frde_DocId DocId,Frde_PatientId PatientId,Frde_InpatientId InpatientId,');
          sql.add(' To_Char(Frde_BillDetailId) BillDetailId,To_Char(Frde_ServiceBillDetailId) ServiceBillDetailId, Frde_TestNameCode TestNameCode,Frde_TestNameId TestNameID,Frde_BillNo BillNo, FRDE_SCharge as Scharge,');
          sql.add(' Frde_BillDate BillDate,Frde_DisDate Disdate,Frde_FractionAmount as Rate,Frde_Qty Qty,Frde_FractionAmount*Frde_Qty as FractionAmount,');
          sql.add(' (Frde_FractionAmount*Frde_Qty*Frde_DisPer/100) as Discount,((Frde_FractionAmount*Frde_Qty)-(Frde_FractionAmount*Frde_Qty*Frde_DisPer/100)) as DocFrctNet,');
          sql.add(' Frde_DisPer Disper,Round(Frde_FractionRate,3) FractionRate, Frde_UnitTestCost UnitTestCost,Frde_UnitTestCostORG UnitTestCostORG,');
          sql.add(' Frde_PositionWiseFractionId PositionWiseFractionId,Frde_DepId DepId, Frde_PrevDocID PrevDocId,Frde_ISFRACTIONPROPWITHDISPER ISFRACTIONPROPWITHDISPER, ');
          sql.add(' Frde_BillType BillType,Frde_PayType PayType,Frde_IsChargeDivide IsChargeDivide,Frde_RefFractionDetailId RefFractionDetailId,Frde_IsFractionLocked IsFractionLocked,Frde_FrctLockDate FrctLockDate,');
          if gs_IsMKTGReferalForINV='Y' then
          Begin
               sql.add(' case when FRDE_DESCRIPTION=''MKTG REFERRAL'' then (select MKRE_REFERRALPERSON from HS_MKRE_MKTGREFERRAL where MKRE_MKTGREFERRALID=frde_docid)');
               sql.Add(' else (Select DOct_DocName From Hs_DOct_Doctor where DOct_DocId=FD.Frde_DocID) end as DrName,');
               sql.Add(' case when FRDE_DESCRIPTION in (''MKTG REFERRAL'',''DOC REFERRAL'') then frde_description else');
               sql.Add(' (Select Powf_PositionName From Hs_Powf_Positionwisefraction where POWF_POSITIONWISEFRACTIONID=FD.Frde_PositionWiseFractionId)end as Description,');
               sql.Add(' case when FRDE_DESCRIPTION<>''MKTG REFERRAL'' then (select doct_doccode from hs_doct_doctor where doct_docid=Frde_DocId) end doccode,');
          End
          Else
          Begin
               sql.Add(' (Select DOct_DocName From Hs_DOct_Doctor where DOct_DocId=FD.Frde_DocID) as DrName,');
               sql.Add(' (Select Powf_PositionName From Hs_Powf_Positionwisefraction where POWF_POSITIONWISEFRACTIONID=FD.Frde_PositionWiseFractionId) as Description,');
               sql.Add(' (select doct_doccode from hs_doct_doctor where doct_docid=Frde_DocId) doccode,');
          End;

          sql.add(' Frde_FrctModifyDate FrctModifyDate,Frde_FrctModifyBy FrctModifyBy,Frde_Remarks Remarks,frde_IsRevSeparatehead IsRevSeparatehead');
          IF (ps_AccessFrom='OUTSTD_FRACTION') or (b_IsDischargePt=False) Then
          sql.add(' From Hs_Frde_FractionDetail FD where Frde_ServiceBillDetailId=' + Query_PatientTest.FieldByName('ServiceBillDetailId').AsString)
          Else
          sql.add(' From Hs_Frde_FractionDetail FD where Frde_BillDetailId=' +Query_PatientTest.FieldByName('BillDetailId').AsString);

          //sql.add(' and FRDE_FRACTIONDETAILID not in (select FRRD_FRACTIONDETAILID from HS_FRRD_FRACTIONREFUNDDETAIL) ');
          if gs_IsMKTGReferalForINV='Y' then
          Begin
               if CB_Referral.Checked then
               sql.Add(' and nvl(FRDE_DESCRIPTION,'' '') in (''MKTG REFERRAL'',''DOC REFERRAL'')')
               Else
               sql.Add(' and nvl(FRDE_DESCRIPTION,'' '') not in (''MKTG REFERRAL'',''DOC REFERRAL'')');
          End;
          sql.add(' Order By FD.Frde_TEstNameCode,FD.Frde_PositionWiseFractionId,FD.Frde_FractionDetailId');
          //sql.saveToFile('C:\FrctBreak.Txt');
          Open;
     End;

     IF Query_Frct_BreakUp_OfItem.RecordCount > 0 Then
     Begin
          Query_Frct_BreakUp_OfItem.First;
          Edit_DrTech.Text := Query_Frct_BreakUp_OfItem.FieldByName('DrName').AsString;
          Label_Description.Caption := Query_Frct_BreakUp_OfItem.FieldByName('Description').AsString;
     End
     Else
     Begin
          Edit_DrTech.Text := '';
          Label_Description.Caption := 'Description';
          DBLCB_ActualDrTech.KeyValue := NULL;
     End;
     lf_FractionTotal:=0;
     Query_Frct_BreakUp_OfItem.First;
     while not Query_Frct_BreakUp_OfItem.Eof do
     begin
          lf_FractionTotal :=lf_FractionTotal+Query_Frct_BreakUp_OfItem.FieldByName('DocFrctNet').AsFloat;
          Query_Frct_BreakUp_OfItem.Next;
     end;
     lbl_TotalFractionAmount.Caption := FloatToStr(lf_FractionTotal);
     Query_Frct_BreakUp_OfItem.First;
End;

