procedure TForm_FractionMgmtNew.FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
     IF Key = 27 Then
          BitBtn2Click(Sender);
     IF b_IsFractModifyActive = False Then
     Begin
          IF (Key = VK_F3) Then
          Begin
               SPB_InvFractionClick(Sender);
               Exit;
          End;

          IF (Key = VK_F4) Then
          Begin
               SPB_RoundFractionClick(Sender);
               Exit;
          End;
     End
     Else IF (b_IsFractModifyActive = True) and (PC_ItemFractionBreak.ActivePageIndex = 0) Then
     Begin
          IF Key = VK_F3 Then
               SB_SetChangesClick(Sender)
          Else IF Key = VK_F4 Then
               SB_ModifyFractionClick(Sender)
          Else IF Key = VK_F5 Then
               SB_SpFractionAddClick(Sender)
          Else IF Key = VK_F6 Then
               SPB_TalliedFractionItemsClick(Sender)
          Else IF Key = VK_F7 Then
               SBDeleteClick(Sender)
          Else IF Key = VK_F8 Then
          Begin
               CB_MainDoctor.Checked := Not(CB_MainDoctor.Checked);
               DBLCB_ActualDrTech.SetFocus;
          End;
     End
