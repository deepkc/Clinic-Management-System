procedure TForm_FractionMgmtNew.SPB_AdjFrctALClick(Sender: TObject);
Var
     ls_DrProcId, li_DrTechAL : Integer;
begin
     DateEditX_AdjFrctDate.SystemOfDate := gi_DateSystem;
     ChangeCaption(Btn_AdjFrctDate);

     IF CB_FrctAdjAL.Checked = False Then
     Begin
          IF DBLCB_DrTechAL.KeyValue = NULL Then
          Begin
               MessageDlg('Plz. Choose Actual Doctor Or Techinician.', mtInformation, [mbok], 0);
               DBLCB_DrTechAL.SetFocus;
               Exit;
          End;

          if Query_Frct_BreakUp_OfItem.FieldByName('Docid').AsInteger=242 then
          begin
               if DBLCB_DrTechAL.KeyValue<>242 then
               begin
                    MessageDlg('You can only Choose OT Assistant For Fraction', mtInformation, [mbok], 0);
                    DBLCB_DrTechAL.SetFocus;
                    Exit;
               end;
          end;

          IF Query_Frct_BreakUp_OfItem.RecordCount = 0 Then
          Begin
               MessageDlg('No Record For Fraction Adjustment.', mtInformation, [mbok], 0);
               DBLCB_DrTechAL.SetFocus;
               Exit;
          End;

          IF Query_Frct_BreakUp_OfItem.FieldByName('DOcId').AsString = DBLCB_DrTechAL.KeyValue Then
          Begin
               MessageDlg('Sorry ! You must have to choose another Doctor Or Techinician.', mtWarning, [mbok], 0);
               DBLCB_DrTechAL.SetFocus;
               Exit;
          End;

          if Query_Frct_BreakUp_OfItem.FieldByName('IsFractionLocked').AsString='N' Then
          begin
               MessageDlg('This item/investigation is not locked. Please update doctor from ''Break Item'' tab.',mtWarning,[mbok],0);
               exit;
          end;

          {
          IF (Query_Frct_BreakUp_OfItem.FieldByName('DOcId').AsString <> '1') Then
          Begin
               // IF Query_Frct_BreakUp_OfItem.FieldByName('IsFractionLocked').AsString='N' Then
               // MessageDlg(' Sorry ! Fraction Has Not Yet Locked. So This is not a Proper Place for Non Locking Fraction.',mtWarning,[mbok],0)
               // Else
               IF Query_Frct_BreakUp_OfItem.FieldByName('IsFractionLocked').AsString = 'Y' Then
               Begin
                    MessageDlg(' Sorry ! You Cannot Change Fraction of One Person to Another After Locking Fraction.', mtWarning, [mbok],
                         0);
                    Exit;
               End;
          End;
          }

          li_DrTechAL := DBLCB_DrTechAL.KeyValue;
          With Query_Process do
          Begin
               Close;
               sql.Clear;
               // sql.add(' Select Max(BillDate) BillDate From FractionDetail where DocCode='+#39+DBLCB_DrTechAL.KeyValue+#39);
               // sql.add(' and IsFractionLocked=''Y''');
               sql.add(' Select Max(LOG_DateTo) DateTo From HS_LOG_FRACTIONLOCKUNLOCK where LOG_DocId=' + IntToStr(li_DrTechAL) );
               Open;
          End;

          IF Trim(Query_Process.FieldByName('DateTo').AsString) <> '' Then
          Begin
               IF Query_Process.FieldByName('DateTo').AsString > DateEditX_AdjFrctDate.Text Then
               Begin
                    MessageDlg('Sorry ! Fraction Adjustment Date   " ' + DateEditX_AdjFrctDate.Text + ' "  is Less Than ' +
                           'Fraction Locked up to Date   " ' + Query_Process.FieldByName('DateTo').AsString + ' ".', mtWarning, [mbok], 0);
                    Exit;
               End;
          End;

          if Trim(Edit_Remarks.text) = '' then
          begin
               Showmessage('Please enter remarks!');
               exit;
          end;

          IF MessageDlg('Are You Sure To Change Doctor Or Techinician After Locking ?', mtConfirmation, [mbyes, mbno], 0) = MrNo Then
               Exit;


          Try
               DM_Hospital.DB.StartTransaction;

               {Posts in Hs_Frrd_FractionRefundDetail }

               // Fetch information of fraction record
               with Qry do
               begin
                    Close;
                    DatabaseName:=gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add('Select to_char(FRDE_BILLDETAILID) BillDetailId, A.*,(Select Rede_RefundDetailId From Hs_Rede_RefundDetail where Rede_BillDetailId=A.Frde_BillDetailId)Rede_RefundDetailId');
                    SQL.Add('From HS_FRDE_FractionDetail A where FRDE_Billdetailid=' + Query_Frct_BreakUp_OfItem.FieldByName('BillDetailId').AsString);
                    SQL.Add(' and FRDE_FRACTIONDETAILID = ' + Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsString);
                    //SQL.SaveToFile('C:\GET_FRDEINFO.txt');
                    Open;
               end;

               // posts refund of fraction in HS_FRRD_FRACTIONREFUNDDETAIL
               SaveRefundFractiondetail(Qry.FieldByName('FRDE_FractionDetailId').AsInteger,Qry.FieldByName('FRDE_PatientId').AsInteger,
                    Qry.FieldByName('FRDE_InPatientId').AsInteger,Qry.FieldByName('Rede_RefundDetailId').AsInteger,0,
                    Qry.FieldByName('FRDE_DepId').AsInteger,Qry.FieldByName('FRDE_DocID').AsInteger,0,
                    Qry.FieldByName('FRDE_FractionId').AsInteger,0,Qry.FieldByName('FRDE_PositionWiseFractionId').AsInteger,
                    Gi_UserId,Qry.FieldByName('FRDE_UnitTestCost').AsFloat,
                    Qry.FieldByName('FRDE_Qty').AsFloat,Qry.FieldByName('FRDE_FractionAmount').AsFloat,Qry.FieldByName('FRDE_FractionRate').AsFloat,Qry.FieldByName('FRDE_DisPer').AsFloat,
                    Qry.FieldByName('FRDE_TestNameCode').AsString,Gs_BillNo,TOdaysdate,Qry.FieldByName('FRDE_BillType').AsString,
                    Qry.FieldByName('FRDE_PayType').AsString,Qry.FieldByName('FRDE_Isfractionpropwithdisper').AsString,'',Qry.FieldByName('FRDE_Isaddlumpsum').AsString,
                    Qry.FieldByName('FRDE_Ischargedivide').AsString,Trim(Edit_Remarks.text),todaysdate,TodaysTime);

               // posts fraction in FRDE using Set Doctor
               SaveFractiondetail(Qry.FieldByName('FRDE_PatientId').AsInteger,Qry.FieldByName('FRDE_InPatientId').AsInteger,
                    StrToInt64(Qry.FieldByName('BillDetailId').asString),StrToInt64(Qry.FieldByName('FRDE_ServiceBillDetailId').AsString),
                    Qry.FieldByName('FRDE_DepId').AsInteger,
                    li_DrTechAL, Qry.FieldByName('FRDE_TestNameID').AsInteger,
                    Qry.FieldByName('FRDE_FractionId').AsInteger,Qry.FieldByName('FRDE_PositionId').AsInteger,
                    Qry.FieldByName('FRDE_POSITIONWISEFRACTIONID').AsInteger,gi_UserId,0,
                    Qry.FieldByName('FRDE_UNITTESTCOST').asFloat,Qry.FieldByName('FRDE_UNITTESTCOSTORG').asFloat,Qry.FieldByName('FRDE_QTY').AsFloat,
                    Qry.FieldByName('FRDE_FRACTIONAMOUNT').asFloat,Qry.FieldByName('FRDE_FRACTIONRATE').asFloat,Qry.FieldByName('FRDE_DISPER').asFloat,
                    Qry.FieldByName('FRDE_TESTNAMECODE').AsString,Qry.FieldByName('FRDE_BillNo').AsString,
                    TodaysDate,Qry.FieldByName('FRDE_BillType').AsString,Qry.FieldByName('FRDE_PayType').AsString,
                    'Y','','N','N','', TodaysDate, TodaysTime,Qry.FieldByName('FRDE_IsRevSeparatehead').AsString);

               {
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update Hs_Frde_FractionDetail set Frde_BillDate=' + #39 + DateEditX_AdjFrctDate.Text + #39);
                    sql.add(' , Frde_DocId=' + #39 + DBLCB_DrTechAL.KeyValue + #39 + ',  Frde_FrctModifyDate=' + #39 + ServerDate.TodaysDate + #39);
                    sql.add(' , Frde_AddAmtType=''E'', Frde_FrctModifyBy=' + IntToStr(gi_UserID));
                    sql.add(' where  Frde_FractionDetailId=' + IntToStr(Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger));
                    ExecSQL;
               End;
               }

               DM_Hospital.DB.Commit;
          Except
               MessageDlg('Fraction update failed! Please Contact IT Administrator.',mtWarning,[mbOK],0);
               DM_Hospital.DB.Rollback;
               Exit;
          End;
          ShowDoneMessage;
          ls_DrProcId := Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger;
          Get_Frct_BreakUp_OfItem;
          Query_Frct_BreakUp_OfItem.Locate('FractionDetailId', ls_DrProcId, []);

          Query_PatientTest.Close;
          Query_PatientTest.Open;
          //Query_PatientTest.Locate('BillDetailId', Query_Frct_BreakUp_OfItem.FieldByName('BillDetailId').asInteger, []);
     End;
end;

