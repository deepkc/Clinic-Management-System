                                  ,Query_GetFractionItem.FieldByName('DOcId').AsInteger,Query_PatientTest.FieldByName('TestNameID').AsInteger,
                                   Query_GetFractionItem.FieldByName('Powf_FractionId').AsInteger,0,Query_GetFractionItem.FieldByName('Powf_PositionWiseFractionId').AsInteger,gi_UserId,0,
                                   lf_UnitTestCost
                                   ,lf_UnitTestCost
                                   ,Query_PatientTest.FieldByName('Qty').AsFloat,
                                   lf_FractionAmt,lf_FractionRate,lf_DisPer,
                                   Query_PatientTest.FieldByName('Service').AsString,Query_PatientTest.FieldByName('BillNo').AsString,ps_TodaysDate,
                                   Query_PatientTest.FieldByName('BillType').AsString,Query_PatientTest.FieldByName('PayType').AsString,
                                   'Y','','N','N','',ps_TodaysDate,ps_TodaysTime,Query_GetFractionItem.FieldByName('Powf_IsRevSeparatehead').AsString);
                              End;

                              { SaveFractiondetail(TestNameCode,DocCode,Isoperation,Ischargedivide,Isaddlumpsum,Isfractionpropwithdisper,Iscancel:String;
                                Qty,Disper,Unittestcost,UnittestcostORG,FixedAmountDeductOnTestPrice,Tdsper,Fractionamount,Fractionrate:Double;
                                RefFractionDetailId,Testnameid,Billdetailid,Depid,Patientid,Inpatientid,Docid,Datapostby,FrctModifyBy,Positionwisefractionid,Fractionid:Integer;
                                Billdate,Billno,Billtype,Paytype,Description,Disdate,Datapostdate,Dataposttime,FrctModifyDate,Remarks,Macid:String); }

