procedure TForm_FractionMgmtNew.IPCashAndCreditBill;
var
     b_TempPHSolution: Boolean;
     lf_TotMedCharge, lf_RefundAmt: Double;
Begin
     TableSalesBookIPOP.DatabaseName := gs_TempPath;
     TableSalesBookIPOP.Close;
     TableSalesBookIPOP.EmptyTable;
     TableSalesBookIPOP.Exclusive := True;
     TableSalesBookIPOP.Open;

     IF RB_IPBill.Checked = False Then
     Begin
          With Query_GetBillList Do
          Begin
               Close;
               DatabaseName := gs_DatabaseName;
               SQL.Clear;
               SQL.add(' Select R.*,(Select DOCT_DocCode From HS_DOCT_Doctor where DOCT_DocID=R.DocID)as DocCode');
               SQL.add(' From (Select BIDE_DocId as DocID,BIde_BillNo BillNo,BIde_BillDATE BillDate,SubStr(BIde_BillTime,1,5) as BillTime,BIde_PatientId PatientId,BIde_BillBy BillBy,');
               SQL.add(' BIde_PayType PayTYpe,BIde_RateType RateTYpe,(Select Nls_InitCap(Usma_UserName) From Hs_usma_UserMain Where ');
               SQL.add(' Usma_UserId=Hs_Bide_BillDetail.Bide_BillBy) as UserName,(Select Nls_InitCap(Pama_PatientName) ');
               SQL.add(' From Hs_Pama_PatientMain where Pama_PatientId=Hs_Bide_BillDetail.Bide_PatientId) as Name,');
               SQL.add(' Round(Sum(Bide_Qty*Bide_Amount),2) as Amount,Round(Sum(Bide_Qty*BIde_Amount*Bide_DisPer/100),2) As Discount,');
               SQL.add(' Round(Sum(Bide_VatAmt),2) as SvrTax,');

               IF Gs_TaxRule = 'TAD' Then
                    sql.add(' Round(Sum((Bide_Qty*Bide_Amount)-(Bide_Qty*Bide_Amount*Bide_DisPer/100)),2) as SubTotal,')
               Else
                    sql.add(' Round(Sum((Bide_Qty*Bide_Amount)+Bide_VatAmt),2) as SubTotal,');

               SQL.add(' Round(Sum(((Bide_Qty*Bide_Amount)+Bide_VatAmt)-(Bide_Qty*Bide_Amount*Bide_DisPer/100)),2) as NetAmt');
               SQL.add(' From Hs_Bide_BillDetail ');

               IF CB_Reg.Checked = True Then
                    SQL.add(' Where Bide_BillType=''R'' and ')
               Else
               begin
                    {
                    IF RB_OPBill.Checked = True Then
                         sql.add(' where (Bide_BillType=''B'' OR Bide_BillType=''R'') and ')
                    Else if RB_IPBill.Checked = True Then
                         SQL.add(' Where (Bide_BillType=''A'' OR Bide_BillType=''IP'') and ')
                    else
                         sql.add(' where  1 = 1 and ');
                    }
                    SQL.add(' Where (Bide_BillType=''B'' OR Bide_BillType=''R'') and ');
               end;

               IF CB_Int.Checked = True Then
                    SQL.add(' Bide_RateType=''INT'' and ');

               IF CB_Ghc.Checked = True Then
                    SQL.add(' Bide_Service In (''GEN'',''GE2'') and ');

               IF CB_EmrOPD.Checked = True Then
                    SQL.add(' Bide_Service=''EMR01'' and ');

               IF DBLCB_TestName.KeyValue <> NULL Then
               Begin
                    sql.add(' Bide_Service=' + #39 + DBLCB_TestName.KeyValue + #39 + ' and ');
               End;


               IF CB_IsPathologicalDept.Checked=True Then
               Begin
                    sql.add(' BIDE_DepId In (Select DEPT_DepId From HS_DEPT_Department where DEPT_DEPTYPE=''P'') and ');
               end;

               IF DBLCB_DepName.KeyValue <> NULL Then
               Begin
                    sql.add(' Bide_DepId=' + IntToStr(DBLCB_DepName.KeyValue) + ' and ');
               End;

               IF CB_GlobalSearch.Checked = False Then
               Begin
                    sql.add(' (Bide_BillDate>=' + #39 + DateEditX_FromBillView.Text + #39 + ' AND Bide_BillDate<=' + #39 +
                           DateEditX_ToBillView.Text + #39 + ')');
                    IF (b_IsNumeric = True) and (Trim(Edit_Search.Text) <> '') Then
                         sql.add(' And (Bide_PatientId=' + IntToStr(pi_PatientId) + ' or Bide_PatientId=' + IntToStr(pi_PatientId) + ')');
               End
               Else
               Begin
                    IF b_IsNumeric = True Then
                    Begin
                         IF RB_OPBill.Checked = True Then
                              sql.add(' Bide_PatientId=' + IntToStr(pi_PatientId))
                         Else
                              sql.add(' (Bide_PatientId=' + IntToStr(pi_PatientId) + ' or Bide_InpatientId=' + IntToStr(pi_PatientId) + ')');
                    End
                    Else
                    Begin
                         if CB_ByName.Checked = False then
                              sql.add(' Bide_BillNo=' + #39 + Edit_Search.Text + #39)
                         Else
                              sql.add
                                (' Bide_PatientId In (Select Pama_PatientID From Hs_Pama_PatientMain where Replace(Trim(Pama_PatientName),'' '','''') Like ' +
                                     #39 + StringReplace(Trim(Edit_Search.Text), ' ', '', [rfReplaceAll]) + '%' + #39 + ')');
                    End;
               End;
               sql.add('  Group by BIDE_DocId,Bide_BillNo,Bide_BillDATE,Bide_BillTime,BIde_PatientId,Bide_BillBy,BIde_PayType,BIde_RateType order by BillDate,billNo) R ');
               //sql.saveToFile('C:\Testing.Txt');
               Open;
          End;

          Query_GetBillList.First;
          while not Query_GetBillList.EOF Do
          Begin
               TableSalesBookIPOP.Append;
               TableSalesBookIPOP.FieldByName('PayType').AsString := Query_GetBillList.FieldByName('PayType').AsString;
               TableSalesBookIPOP.FieldByName('Name').AsString := Query_GetBillList.FieldByName('Name').AsString;
               TableSalesBookIPOP.FieldByName('PatientId').AsInteger := Query_GetBillList.FieldByName('PatientId').AsInteger;
               TableSalesBookIPOP.FieldByName('PatientIdStr').AsString := Query_GetBillList.FieldByName('PatientId').AsString;
               TableSalesBookIPOP.FieldByName('BillDate').AsString := Query_GetBillList.FieldByName('BillDate').AsString;
               TableSalesBookIPOP.FieldByName('BillTime').AsString := Query_GetBillList.FieldByName('BillTime').AsString;
               TableSalesBookIPOP.FieldByName('BillNo').AsString := Query_GetBillList.FieldByName('BillNo').AsString;
               TableSalesBookIPOP.FieldByName('DocId').AsString := Query_GetBillList.FieldByName('DocId').AsString;
               TableSalesBookIPOP.FieldByName('DocCode').AsString := Query_GetBillList.FieldByName('DocCode').AsString;

               IF (RB_OPBill.Checked = True) and (CB_EmrOPD.Checked = False) and (CB_Ghc.Checked = False) and (CB_Int.Checked = False) and
                 (CB_Reg.Checked = False) Then
                    TableSalesBookIPOP.FieldByName('DocCodeFrct').AsString := GetFractionDoc
                      (Query_GetBillList.FieldByName('BillNo').AsString);

               TableSalesBookIPOP.FieldByName('Amount').AsFloat := Query_GetBillList.FieldByName('Amount').AsFloat;
               TableSalesBookIPOP.FieldByName('Discount').AsFloat := Query_GetBillList.FieldByName('DISCOUNT').AsFloat;
               TableSalesBookIPOP.FieldByName('SubTotal').AsFloat := Query_GetBillList.FieldByName('SubTotal').AsFloat;
               TableSalesBookIPOP.FieldByName('SvrTax').AsFloat := Query_GetBillList.FieldByName('SvrTax').AsFloat;
               TableSalesBookIPOP.FieldByName('NetAmount').AsFloat := Query_GetBillList.FieldByName('NetAmt').AsFloat;
               TableSalesBookIPOP.FieldByName('UserName').AsString := Query_GetBillList.FieldByName('UserName').AsString;
