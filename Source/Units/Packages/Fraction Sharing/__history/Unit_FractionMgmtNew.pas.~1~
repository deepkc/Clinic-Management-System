(*                            if pb_MutualDocForShare=False then
                              Begin
                                   SaveFractiondetail(Query_PatientTest.FieldByName('Service').AsString, ls_DocCode,
                                        Query_PatientTest.FieldByName('ISOT').AsString, 'N', 'N', Query_GetFractionItem.FieldByName
                                          ('ISFRACTIONPROPWITHDISPER').AsString, 'N', Query_PatientTest.FieldByName('Qty').AsFloat, lf_DisPer,
                                        lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, gf_TDSPercent, lf_FractionAmt, lf_FractionRate,
                                         0, 0, Query_PatientTest.FieldByName('TestNameId').AsInteger,
                                        Query_PatientTest.FieldByName('BillDetailId').AsInteger, Query_PatientTest.FieldByName('DepId')
                                          .AsInteger, Query_PatientTest.FieldByName('PatientId').AsInteger, Query_PatientTest.FieldByName
                                          ('InpatientId').AsInteger, Query_PatientTest.FieldByName('DocId').AsInteger, gi_UserID, 0,
                                        Query_GetFractionItem.FieldByName('PositionWiseFractionId').AsInteger, Query_GetFractionItem.FieldByName
                                          ('FractionId').AsInteger, Query_PatientTest.FieldByName('BillDate').AsString,
                                        Query_PatientTest.FieldByName('BillNo').AsString, Query_PatientTest.FieldByName('BillType').AsString,
                                        Query_PatientTest.FieldByName('PayType').AsString, '', '', ps_TodaysDate, ps_TodaysTime, '', '',
                                        gs_MacID);
                              End
                              Else
                              Begin
                                   Query_MutualDocForShare.First;
                                   While not Query_MutualDocForShare.Eof do
