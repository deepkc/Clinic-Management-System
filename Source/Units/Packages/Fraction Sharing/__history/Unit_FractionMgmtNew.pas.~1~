                                   sql.add(' Select PWC.PositionWiseFractionId,PWC.ISFIXEDPERSONFORFRACTION,PWC.ISFRACTIONPROPWITHDISPER,PWC.FractionId,PWC.Name,PWC.IsHospitalPart,');
                                   sql.add(' PWC.PositionName,PWC.IsDefaultDoc,PWC.DocCode,PWC.FractionRate,PWC.FractionAmount,DC.IsRateAmt,DC.FractionAmount,PWC.ISCOMPFORFRACTION,');
                                   sql.add(' DC.DepId From Fraction DC,PositionWiseFraction PWC where DC.FractionId=PWC.FractionId and PWC.ISACTIVE=''Y''');
                                   IF Query_PatientTest.FieldByName('Service').AsString = 'GEN' Then
                                        sql.add(' and DC.TESTNAMEID=533 ') // 533- General Health Package 1
