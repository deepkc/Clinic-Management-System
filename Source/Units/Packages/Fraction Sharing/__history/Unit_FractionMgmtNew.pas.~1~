               SaveFractiondetail(Query_PatientTest.FieldByName('PatientId').AsInteger,Query_PatientTest.FieldByName('InPatientId').AsInteger,
                    StrToInt64(Query_PatientTest.FieldByName('BillDetailId').AsString),StrToInt64(Query_PatientTest.FieldByName('ServiceBillDetailId').AsString),
                    Query_Frct_BreakUp_OfItem.FieldByName('DepId').AsInteger,DBLCB_4thDoc.KeyValue,
                    Query_Frct_BreakUp_OfItem.FieldByName('TestNameId').AsInteger,Query_Frct_BreakUp_OfItem.FieldByName('FractionId').AsInteger,0,
                    Query_Frct_BreakUp_OfItem.FieldByName('PositionWiseFractionId').AsInteger,gi_UserId,
