     if CB_PercentBasis.Checked=True then
     lf_DocFrctPerNew := GetNoOfDecimalPartOfFloatNum(((StrToFloat(Edit_Amt2ndDoc.Text) / (lf_UnitTestCost * lf_Qty)) * 100), 4)
