                      (lf_DocFrctPerNew));
               sql.add(' ,Frde_PrevFractionRate=' + FloatToStr(lf_PrevFractionRate));
               sql.add(' ,Frde_RefFractionDetailId=' + IntToStr(Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger));
