procedure TForm_FractionMgmtNew.BitBtn_ReplicateFractionClick(Sender: TObject);
begin
     try
          Form_FractionReplicate := TForm_FractionReplicate.Create(Nil);
          Form_FractionReplicate.pi_BillDetailId := pi_BillDetailId;
          Form_FractionReplicate.pi_ServiceBillDetailId := pi_ServiceBillDetailId;
          Form_FractionReplicate.ps_TestNameCode:=Query_PatientTest.FieldByName('Service').AsString;
          Form_FractionReplicate.ps_BillNo:=Query_PatientTest.FieldByName('billno').AsString;
          Form_FractionReplicate.ShowModal;
     finally
          Form_FractionReplicate.Free;
     end;
end;

procedure TForm_FractionMgmtNew.BitBtn2Click(Sender: TObject);
begin
     IF (b_IsFractModifyActive = True) and (ps_AccessFrom <> 'DISCHARGE') Then
     Begin
          PC_BillDisplay.BringToFront;
          PC_Investigation.SendToBack;
          b_IsFractModifyActive := False;
          ActiveControl := DBGrid_BillList;
          BitBtnBillBreakup.Enabled := True;
     End
     Else
     Begin
          IF MessageDlg('Are You Sure To Close ?', mtConfirmation, [mbyes, mbno], 0) = mrYes Then
               Close;
     End;
end;

procedure TForm_FractionMgmtNew.FormShow(Sender: TObject);
begin
     QryTestName.Close;
     QryTestName.Open;

     Query_Doctor.Close;
     Query_Doctor.Open;

     Query_ActDoctor.Close;
     Query_ActDoctor.Open;

     Query_marketing.Close;
     Query_marketing.Open;

     Query_ActDoctor2nd.Close;
     Query_ActDoctor2nd.Open;

     Query_VisitDoctor3rd.Close;
     Query_VisitDoctor3rd.Open;

     Query_VisitDoctor4th.Close;
     Query_VisitDoctor4th.Open;

     Query_Position.Close;
     Query_Position.Open;

     Query_Department.Close;
     Query_Department.Open;

     Query_TestName.Close;
     Query_TestName.Open;

     DateEditX_FromBillView.SystemOfDate := gi_DateSystem;
     DateEditX_FromBillView.Text := ServerDate.TodaysDate;
     ChangeCaption(BitBtn_From);

     DateEditX_ToBillView.SystemOfDate := gi_DateSystem;
     DateEditX_ToBillView.Text := ServerDate.TodaysDate;
     ChangeCaption(BitBtn_To);

     DateEditX_TodayDate.SystemOfDate := gi_DateSystem;
     DateEditX_TodayDate.Text := ServerDate.TodaysDate;
     ChangeCaption(Button_TodayDate);

     DateEditX_AdjFrctDate.SystemOfDate := gi_DateSystem;
     DateEditX_AdjFrctDate.Text := DateEditX_TodayDate.Text;
     ChangeCaption(Btn_AdjFrctDate);

     pf_BalanceAmt := 0;

     Label14.Visible:=True;
     Label_marketing.Visible:=False;
     DBLCB_MktgReferral.Visible:=False;
     DBLCB_ActualDrTech.Visible:=True;

     IF ps_AccessFrom <> 'DISCHARGE' Then
     Begin
          PC_BillDisplay.BringToFront;
          b_IsFractModifyActive := False;
          Edit_Search.SetFocus;

          IF ps_AccessFrom = 'OUTSTD_FRACTION' Then
          begin
               RB_IPBill.Checked:=True;
               RB_IPBill.Visible:=False;
               RB_IPBill.Enabled:=False;

               RB_OPBill.Enabled:=False;
               RB_OPBill.Visible:=False;

               RB_Both.Enabled:=False;
               RB_Both.Visible:=False;

               CB_OutStdPt.Enabled:=False;
               CB_OutStdPt.Checked:=True;
               CB_OutStdPt.Visible:=False;

               CB_FinalBill.Visible:=False;
               CB_FinalBill.Enabled:=False;
          end;
     End
     Else
     Begin
          b_IsFractModifyActive := True;
          PC_Investigation.BringToFront;
          ps_BillType := 'IP';

          With Query_PatientInfo do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select IPR.INRE_PatientId PatientId,IPR.INRE_InpatientId InPatientId,IPR.INRE_AdmnDate AdmnDate,IPR.INRE_DisDate DisDate,IPR.INRE_CommunityId CommunityId,IPR.INRE_SchemeId SchemeId,Inre_MemberNo MemberNo,Inre_ISDISINDEPOSIT IsDISINDEPOSIT ,');
               sql.add(' (Select Pama_PatientName From hs_pama_PatientMain where pama_PatientId=IPR.INRE_PatientId) as PtName,Inre_IsDischarged ISDischarged, ');
               sql.add(' (Select sche_Scheme From Hs_Sche_Scheme where Sche_SchemeId=IPR.INRE_SchemeId) as Scheme,Inre_DisInDepositDate DisInDepositDate,Inre_DOcId DocId ');
               sql.add(' From Hs_Inre_InpatientReg IPR ');
               sql.add(' where IPR.INRE_InpatientId=' + IntToStr(pi_InpatientId));
               Open;
          End;

          Label_HosNo.Caption := Query_PatientInfo.FieldByName('PatientId').AsString;
          LabelIpNo.Caption := Query_PatientInfo.FieldByName('InpatientId').AsString;
          Labelname.Caption := Query_PatientInfo.FieldByName('PtName').AsString;

          IF Trim(Query_PatientInfo.FieldByName('Scheme').AsString) <> '' Then
               LabelCommunity.Caption := Query_PatientInfo.FieldByName('Scheme').AsString
          Else
               LabelCommunity.Caption := '-------';

          Query_Frct_BreakUp_OfItem.Close;

          IF (ps_AccessFrom='OUTSTD_FRACTION') or (b_IsDischargePt=False) Then
          Get_Fractionable_TestItem_OutStd
          Else
          Get_Fractionable_TestItem;

          IF Query_PatientTest.FieldByName('IsFractionableItem').AsString = 'Y' Then
          Get_Frct_BreakUp_OfItem;

          PC_ItemFractionBreak.ActivePageIndex := 0;
          EditItemName.Text := Query_PatientTest.FieldByName('ServiceType').AsString;
          EditItemName.SetFocus;
     End;
end;

