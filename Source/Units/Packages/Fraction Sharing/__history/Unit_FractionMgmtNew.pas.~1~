     Begin
          MessageDlg(' Please Select The Referal Name. ',mtWarning,[mbok],0);
          Exit;
     End;


     IF CB_ParticularItem.Checked = False Then
     Begin
          ps_TodaysDate := ServerDate.TodaysDate;
          ps_TodaysTime := ServerDate.TodaysTime;

          CB_FractionableItem.Checked := True;

          IF (ps_AccessFrom<>'OUTSTD_FRACTION') Then
               Get_Fractionable_TestItem
          else
               Get_Fractionable_TestItem_OutStd;

          Load_Fraction_Test;
     End
     Else
     Begin
          IF Query_Frct_BreakUp_OfItem.FieldByName('IsFractionLocked').AsString = 'Y' Then
          Begin
               MessageDlg(' Sorry ! You Cannot Edit. Fraction Is Already Locked.', mtWarning, [mbok], 0);
               Exit;
          End;

          IF Query_PatientTest.FieldByName('IsFractionableItem').AsString = 'N' Then
          Begin
               MessageDlg('Sorry ! This is not a fractionable Item.', mtWarning, [mbok], 0);
               Exit;
          End;

          ps_TodaysDate := ServerDate.TodaysDate;
          ps_TodaysTime := ServerDate.TodaysTime;

          Load_Fraction_Test_Particular;
     End;

     EditItemName.Text := Query_PatientTest.FieldByName('ServiceType').AsString;
     Get_Frct_BreakUp_OfItem;

end;

Procedure TForm_FractionMgmtNew.Make_UptoDate_LeftFraction;
Var
     li_TotRec, i: Integer;
Begin
     ProgressBar1.Position := 0;
     i := 0;
     li_TotRec := Query_BillList.RecordCount;
     Query_BillList.First;

     CB_FractionableItem.Checked := True;
     while not Query_BillList.EOF do
     Begin
          With Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select Distinct BIDE_BillType BIllType From Hs_Bide_BillDetail where bide_billdetailid not in(select rede_billdetailid from Hs_Rede_refunddetail) and');
               sql.add(' Bide_BillNo=' + #39 + Query_BillList.FieldByName('BillNo').AsString + #39);
               Open;
          End;

          IF (Query_Process.FieldByName('BillType').AsString= 'IP') or (Query_Process.FieldByName('BillType').AsString = 'A') Then
          Begin
               ps_BillType := 'IP';
               With Query_PatientInfo do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(
                         ' Select IPR.INRE_PatientId PatientId,IPR.INRE_InpatientId InpatientId,IPR.INRE_AdmnDate AdmnDate,IPR.INRE_DisDate DisDate,');
                    sql.add('IPR.INRE_CommunityId CommunityId,IPR.INRE_SchemeId SchemeId,Inre_MemberNo MemberNo,Inre_IsDisInDeposit IsDisInDeposit,');
                    sql.add(' (Select Pama_PatientName From Hs_Pama_PatientMain where Pama_PatientId=IPR.INRE_PatientId) as PtName,Inre_IsDischarged IsDischarged, ');
                    sql.add(' (Select SCHE_SCHEME From Hs_Sche_Scheme where Sche_SchemeId=IPR.INRE_SchemeId) as Scheme,Inre_DisInDepositDate DisInDepositDate');
                    sql.add(' From Hs_Inre_InpatientReg IPR ');
                    sql.add(' where IPR.INRE_InpatientId=' + IntToStr(Query_BillList.FieldByName('InpatientId').AsInteger));
                    Open;
               End;
               pi_PatientId := Query_PatientInfo.FieldByName('PatientId').AsInteger;
               pi_InpatientId := Query_PatientInfo.FieldByName('InPatientId').AsInteger;
          End
          Else
          Begin
               ps_BillType := 'OP';
               With Query_PatientInfo do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Select Distinct BD.BIDE_PatientId PatientId,BD.BIDE_CrCommunityId CommunityId,BD.BIDE_CrSchemeId SchemeId,BD.BIDE_MemberNo MemberNo,(Select Pama_PatientName From Hs_Pama_PatientMain ');
                    sql.add
                      (' where Pama_PatientId=BD.BIDE_PatientId) as PtName,(Select Sche_Scheme From Hs_Sche_Scheme where Sche_SchemeId=BD.BIDE_CRSchemeId) as Scheme');
                    sql.add(' From Hs_BIde_BillDetail BD ');
                    sql.add(' where BD.BIDE_PatientId=' + IntToStr(Query_BillList.FieldByName('PatientId').AsInteger));
                    Open;
               End;
               pi_InpatientId := 0;
               pi_PatientId := Query_PatientInfo.FieldByName('PatientId').AsInteger;
          End;

          IF (ps_AccessFrom<>'OUTSTD_FRACTION') Then
          Get_Fractionable_TestItem
          else
          Get_Fractionable_TestItem_OutStd;

          IF Query_PatientTest.RecordCount > 0 Then
          Begin
               Get_Frct_BreakUp_OfItem;
               Load_Fraction_Test;
          End;

          ProgressBar1.Position := Round((i / li_TotRec) * 100);
          Inc(i);
          Query_BillList.Next;
     End;
End;

