begin
     IF Not Query_BillList.Active Then
          Query_BillList.Active := True;

     IF Query_BillList.RecordCount <= 0 Then
     Begin
          MessageDlg('Sorry ! There is no any transaction for modification.', mtInformation, [mbok], 0);
          Exit;
     End;

     IF (ps_AccessFrom<>'OUTSTD_FRACTION') Then
     Begin
          With Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select Distinct Bide_BillType Billtype From hs_Bide_BillDetail where bide_billdetailid not in(select rede_billdetailid from Hs_Rede_refunddetail) and');
               sql.add(' bide_BillNo=' + #39 + Query_BillList.FieldByName('BillNo').AsString + #39);
               Open;
          End;
     End
     Else
     Begin
          With Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select Distinct SEBD_BillType Billtype From hs_SEBD_SERVICEBillDetail where ');
               sql.add(' sebd_BillNo=' + #39 + Query_BillList.FieldByName('BillNo').AsString + #39);
               Open;
          End;
     End;

     IF (Query_Process.FieldByName('BillType').AsString = 'IP') or (Query_Process.FieldByName('BillType').AsString = 'A') Then
     Begin
          ps_BillType := 'IP';
          With Query_PatientInfo do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select IPR.INRE_PatientId PatientId,IPR.INRE_InpatientId InPatientId,IPR.INRE_AdmnDate AdmnDate,IPR.INRE_DisDate DisDate,IPR.INRE_CommunityId CommunityId,IPR.INRE_SchemeId SchemeId,Inre_MemberNo MemberNo,Inre_ISDISINDEPOSIT IsDISINDEPOSIT ,');
               sql.add(' (Select Pama_PatientName From hs_pama_PatientMain where pama_PatientId=IPR.INRE_PatientId) as PtName,Inre_IsDischarged ISDischarged, ');
               sql.add(' (Select sche_Scheme From Hs_Sche_Scheme where Sche_SchemeId=IPR.INRE_SchemeId) as Scheme,Inre_DisInDepositDate DisInDepositDate,Inre_DOcId DocId ');
               sql.add(' From Hs_Inre_InpatientReg IPR ');
               sql.add(' where IPR.INRE_InpatientId=' + IntToStr(Query_BillList.FieldByName('InpatientId').AsInteger));
