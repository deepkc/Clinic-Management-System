procedure TForm_FractionMgmtNew.SPB_SPFractAddClick(Sender: TObject);
Var
     lf_FrctPer, lf_TotFrctAmt, lf_NetFrctAmt,lf_DisPer: Double;
begin
     IF Query_Frct_BreakUp_OfItem.FieldByName('IsFractionLocked').AsString = 'Y' Then
     Begin
          MessageDlg(' Sorry ! You Cannot Add. Fraction Is Already Locked.', mtWarning, [mbok], 0);
          Exit;
     End;

     IF DBLCB_Position.KeyValue = NULL Then
     Begin
          MessageDlg('Plz. Select Position First.', mtInformation, [mbok], 0);
          DBLCB_2ndDoc.SetFocus;
          Exit;
     End;

     IF DLCB_AddedkDoctor.KeyValue = NULL Then
     Begin
          MessageDlg('Plz. Select Doctor / Techinician First.', mtInformation, [mbok], 0);
          DBLCB_2ndDoc.SetFocus;
          Exit;
     End;

     IF StrToFloat(Edit_AddedFractAmt.Text) <= 0 Then
     Begin
          MessageDlg('You Must Have To Put Fraction Amount Grater Than 0.', mtWarning, [mbok], 0);
          Edit_AddedFractAmt.SetFocus;
          Exit;
     End;

     lf_TotFrctAmt := 0;
     lf_NetFrctAmt := 0;

     if CB_IsDisPerAppliedforBilling.Checked=True then
     lf_DisPer:=Query_PatientTest.FieldByName('DisPer').AsFloat
     else
     lf_DisPer:=0;

     Query_Frct_BreakUp_OfItem.First;
     While not Query_Frct_BreakUp_OfItem.EOF Do
     Begin
          lf_TotFrctAmt := lf_TotFrctAmt + Query_Frct_BreakUp_OfItem.FieldByName('FractionAmount').AsFloat;
          lf_NetFrctAmt := lf_NetFrctAmt + Query_Frct_BreakUp_OfItem.FieldByName('DocFrctNet').AsFloat;
          Query_Frct_BreakUp_OfItem.Next;
     End;

     IF (lf_NetFrctAmt + StrToFloat(Edit_AddedFractAmt.Text)) > Query_PatientTest.FieldByName('NetTotal').AsFloat Then
     Begin
          MessageDlg(' Total Net Amount Charged to Patient is ( Rs ' + Query_PatientTest.FieldByName('NetTotal').AsString + ' )' + Char(10)
                 + '. But Accumulated Frct. Amt. is ( Rs ' + FloatToStr(lf_NetFrctAmt + StrToFloat(Edit_AddedFractAmt.Text))
                 + ' ) with this extra added amt.', mtWarning, [mbok], 0);
          Edit_AddedFractAmt.SetFocus;
          Exit;
     End;

     lf_FrctPer := GetNoOfDecimalPartOfFloatNum((StrToFloat(Edit_AddedFractAmt.Text) / StrToFloat(Label_TotTestPrice.Caption)) * 100, 4);
     SaveFractiondetail(Query_PatientTest.FieldByName('PatientId').AsInteger,Query_PatientTest.FieldByName('InPatientId').AsInteger,
          Query_PatientTest.FieldByName('BillDetailId').AsInteger,Query_PatientTest.FieldByName('ServiceBillDetailId').AsInteger,
          Query_PatientTest.FieldByName('DepId').AsInteger,DLCB_AddedkDoctor.KeyValue,
          Query_PatientTest.FieldByName('TestNameID').AsInteger,Query_Frct_BreakUp_OfItem.FieldByName('FractionId').AsInteger,DBLCB_Position.KeyValue, 0,
          gi_UserId, 0,StrToFloat(Label_TotTestPrice.Caption),StrToFloat(Label_TotTestPrice.Caption),Query_PatientTest.FieldByName('Qty').AsFloat,
          StrToFloat(Edit_AddedFractAmt.Text),lf_FrctPer,lf_DisPer,Query_PatientTest.FieldByName('Service').AsString,Query_PatientTest.FieldByName('BillNo').AsString,
          Query_PatientTest.FieldByName('BillDate').AsString,Query_PatientTest.FieldByName('BillType').AsString,Query_PatientTest.FieldByName('PayType').AsString,
          'Y','','N','N','',ps_TodaysDate,ps_TodaysTime,Query_Frct_BreakUp_OfItem.FieldByName('IsRevSeparatehead').AsString);

     ShowDoneMessage;
     Get_Frct_BreakUp_OfItem;

     //PC_ItemFractionBreak.ActivePageIndex:=0;
end;

