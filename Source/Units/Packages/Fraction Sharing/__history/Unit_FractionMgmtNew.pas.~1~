procedure TForm_FractionMgmtNew.SPB_AdjAddClick(Sender: TObject);
Var
     li_RefFrctId, ls_DrProcId: Integer;
     lf_DocRate, lf_DisPer, lf_DocCommession: Double;
     ls_Remarks: String;
begin
     IF (Query_Frct_BreakUp_OfItem.RecordCount = 0) and (CB_SplFrctAdd.Checked = False) Then
     Begin
          MessageDlg('No Record For Fraction Adjustment.', mtInformation, [mbok], 0);
          DBLCB_DrTechAL.SetFocus;
          Exit;
     End;

     IF (Query_Frct_BreakUp_OfItem.FieldByName('IsFractionLocked').AsString = 'N') and (CB_SplFrctAdd.Checked = False) Then
     Begin
          MessageDlg(' Sorry ! Fraction Has Not Yet Locked. So This is not a Proper Place for Non Locking Fraction.', mtWarning, [mbok], 0);
          Exit;
     End;

     IF (Query_Frct_BreakUp_OfItem.FieldByName('Docid').AsString = '1') Then
     Begin
          MessageDlg(' Sorry ! This is Hospital Part. Not Fraction of Person.', mtWarning, [mbok], 0);
          Exit;
     End;

     With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select Max(DateTo) DateTo From FRACTIONLOCK_LOG where DocCode=' + #39 + DBLCB_AdjDocTech.KeyValue + #39);
          Open;
     End;

     IF Trim(Query_Process.FieldByName('DateTo').AsString) <> '' Then
     Begin
          IF Query_Process.FieldByName('DateTo').AsString > DateEditX_AdjFrctDate.Text Then
          Begin
               MessageDlg('Sorry ! Fraction Adjustment Date   " ' + DateEditX_AdjFrctDate.Text + ' "  is Less Than ' +
                      'Fraction Locked up to Date   " ' + Query_Process.FieldByName('DateTo').AsString + ' ".', mtWarning, [mbok], 0);
               Exit;
          End;
     End;

     IF CB_SplFrctAdd.Checked = False Then { If. Not Spl. Frct Checked(Check box) Then Must have to Check Either ... }
     Begin { .. there is already made deduction or not before add fraction. (Must have to first deduct before Add) }
          With Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select (Select DOct_Desig||'' ''||Doct_DocName From Hs_Doct_Doctor where Doct_DocId=Hs_Frde_FractionDetail.DocId) as Doctor,');
               sql.add(' Frde_FrctModifyDate FrctModifyDate From Hs_Frde_FractionDetail ');
               sql.add(' where FrctModifyRefDrProcId=' + IntToStr(Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger));
               sql.add(' and Trim(RefundDate) is Not null ');
               Open;
          End;

          IF Query_Process.RecordCount = 0 Then
          Begin
               MessageDlg('Plz. First Deduct Fraction Then Only You Can Add Fraction.', mtInformation, [mbok], 0);
               DBLCB_AdjDocTech.SetFocus;
               Exit;
          End;
     End;

     { DrProcedures_Add_Deduct(DocCode:String;DrComID,PositionWiseFractionId,PatientId,InPatientID,BillDetailId,DepId:Integer;TestNameCode,
       BillNo,BillDate,BillType,PayType,ISFRACTIONPROPWITHDISPER,IsHospitalPart,AddAmtType,IsOperation,Description:String;
       FractionRate,DocCommAmt,AddedPercent,AddedAmt,DisPer,Qty,UnitTestCost:Double;
       RefundDate,RefundTime,RefundBillNo,FrctModifyDate,Remarks:String; RefundBy,FrctModifyBy,RefFractionDetailId : Integer); }

     IF CB_SplFrctAdd.Checked = False Then
     Begin
          lf_DocRate := Query_Frct_BreakUp_OfItem.FieldByName('FractionRate').AsFloat;
          lf_DisPer := Query_Frct_BreakUp_OfItem.FieldByName('DisPer').AsFloat;
          lf_DocCommession := Query_Frct_BreakUp_OfItem.FieldByName('FractionAmount').AsFloat;
          li_RefFrctId := Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger;
          ls_Remarks := 'Prev. Frct. Adj. Add';
     End
     Else
     Begin
          lf_DocRate := 0;
          lf_DisPer := 0;
          lf_DocCommession := StrToFloat(Edit_AdjFrctAmt.Text);
          li_RefFrctId := 0;
          ls_Remarks := 'Prev. Frct. Adj. Add Spl.';
     End;

     { DrProcedures_Add_Deduct(DocCode:String;DrComID,PositionWiseFractionId,PatientId,InPatientID,BillDetailId,DepId,BillBy:Integer;TestNameCode,
       BillNo,BillDate,BillType,PayType,ISFRACTIONPROPWITHDISPER,IsHospitalPart,AddAmtType,IsOperation,Description,ModifyDate,ModifyTime:String;
       FractionRate,DocCommAmt,AddedPercent,AddedAmt,DisPer,Qty,UnitTestCost:Double;
       RefundDate,RefundTime,RefundBillNo,FrctModifyDate,Remarks,RefundBy:String; FrctModifyBy,RefFractionDetailId : Integer); }

     DrProcedures_Add_Deduct(DBLCB_AdjDocTech.KeyValue, Query_Frct_BreakUp_OfItem.FieldByName('FractionId').AsInteger,
          Query_Frct_BreakUp_OfItem.FieldByName('PositionWiseFractionId').AsInteger, Query_PatientTest.FieldByName('PatientId').AsInteger,
          Query_PatientTest.FieldByName('InPatientId').AsInteger, Query_PatientTest.FieldByName('BillDetailId').AsInteger,
          Query_PatientTest.FieldByName('DepId').AsInteger, gi_UserID, Query_PatientTest.FieldByName('Service').AsString,
          Query_PatientTest.FieldByName('BillNo').AsString, DateEditX_AdjFrctDate.Text, Query_PatientTest.FieldByName('BillType').AsString,
          Query_PatientTest.FieldByName('PayType').AsString, 'N', 'N', 'E', Query_PatientTest.FieldByName('ISOT').AsString, ls_Remarks,
          ps_TodaysDate, ps_TodaysTime, gs_MacID, lf_DocRate, lf_DocCommession, 0, 0, lf_DisPer, Query_Frct_BreakUp_OfItem.FieldByName
            ('Qty').AsFloat, Query_Frct_BreakUp_OfItem.FieldByName('UnitTestCost').AsFloat, '', '', '', ServerDate.TodaysDate, StringReplace
            (Edit_Remarks.Text, '''', '''''', [rfReplaceAll]), '', 0, li_RefFrctId);

     ShowDoneMessage;

     ls_DrProcId := Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger;
     Get_Frct_BreakUp_OfItem;
     Query_Frct_BreakUp_OfItem.Locate('FractionDetailId', ls_DrProcId, []);

     Query_PatientTest.Close;
     Query_PatientTest.Open;
     Query_PatientTest.Locate('BillDetailId', Query_Frct_BreakUp_OfItem.FieldByName('BillDetailId').AsInteger, []);
end;

