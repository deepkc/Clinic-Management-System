                                   Open;

                                   IF Query_PatientTest.FieldByName('Service').AsString = 'GEN' Then
                                        ls_GHPKG := 'GHPK01'
                                   Else
                                        ls_GHPKG := 'GHPK02';

                                   First;
                                   While Not EOF Do
                                   Begin
                                        IF Query_Process.FieldByName('FractionAmount').AsFloat > 0 Then
                                        lf_FractionAmt := Query_Process.FieldByName('FractionAmount').AsFloat
                                        Else
                                        lf_FractionAmt := RoundingAfterSecondPlace
                                        (Query_PatientTest.FieldByName('Amount').AsFloat * Query_Process.FieldByName('FractionRate')
                                        .AsFloat / 100);

(*                                        SaveFractiondetail(Query_PatientTest.FieldByName('Service').AsString, ls_DocCode,
                                        Query_PatientTest.FieldByName('ISOT').AsString, 'N', 'N', Query_GetFractionItem.FieldByName
                                        ('ISFRACTIONPROPWITHDISPER').AsString, 'N', Query_PatientTest.FieldByName('Qty').AsFloat,
                                        lf_DisPer, lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, gf_TDSPercent,
                                        lf_FractionAmt, lf_FractionRate, 0, 0, Query_PatientTest.FieldByName('TestNameId').AsInteger,
                                        Query_PatientTest.FieldByName('BillDetailId').AsInteger, Query_PatientTest.FieldByName('DepId')
                                        .AsInteger, Query_PatientTest.FieldByName('PatientId').AsInteger, Query_PatientTest.FieldByName
                                        ('InpatientId').AsInteger, Query_PatientTest.FieldByName('DocId').AsInteger, gi_UserID, 0,
                                        Query_GetFractionItem.FieldByName('PositionWiseFractionId').AsInteger,
                                        Query_GetFractionItem.FieldByName('FractionId').AsInteger, Query_PatientTest.FieldByName('BillDate')
                                        .AsString, Query_PatientTest.FieldByName('BillNo').AsString, Query_PatientTest.FieldByName
                                        ('BillType').AsString, Query_PatientTest.FieldByName('PayType').AsString, '', '', ps_TodaysDate,
                                        ps_TodaysTime, '', '', gs_MacID);
*)
                                        Query_Process.Next;
                                   End;
                              End;
                         End
                         Else
(*                              SaveFractiondetail(Query_PatientTest.FieldByName('Service').AsString, ls_DocCode,
                                   Query_PatientTest.FieldByName('ISOT').AsString, 'N', 'N', Query_GetFractionItem.FieldByName
                                     ('ISFRACTIONPROPWITHDISPER').AsString, 'N', Query_PatientTest.FieldByName('Qty').AsFloat, lf_DisPer,
                                   lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, gf_TDSPercent, lf_FractionAmt, lf_FractionRate,
                                   0, 0, Query_PatientTest.FieldByName('TestNameId').AsInteger,
                                   Query_PatientTest.FieldByName('BillDetailId').AsInteger, Query_PatientTest.FieldByName('DepId')
                                     .AsInteger, Query_PatientTest.FieldByName('PatientId').AsInteger, Query_PatientTest.FieldByName
                                     ('InpatientId').AsInteger, Query_PatientTest.FieldByName('DocId').AsInteger, gi_UserID, 0,
                                   Query_GetFractionItem.FieldByName('PositionWiseFractionId').AsInteger, Query_GetFractionItem.FieldByName
                                     ('FractionId').AsInteger, Query_PatientTest.FieldByName('BillDate').AsString,
                                   Query_PatientTest.FieldByName('BillNo').AsString, Query_PatientTest.FieldByName('BillType').AsString,
                                   Query_PatientTest.FieldByName('PayType').AsString, '', '', ps_TodaysDate, ps_TodaysTime, '', '',
                                   gs_MacID);   *)
                    End;
               End;
               Query_PatientTest.Next;
          End;
          DM_Hospital.Db.Commit;
          if pb_ItemWiseBulkFrctUpdate=False then
          ShowDoneMessage;
     Except
          DM_Hospital.Db.RollBack;
          MessageDlg('Failure To Make up-to-date Fraction.', mtWarning, [mbok], 0);
          Exit;
     End;
End;

Procedure TForm_FractionMgmtNew.Load_Fraction_Test_Particular;
Var
     lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, lf_FractionRate, lf_FractionAmt, lf_DisPer: Double;
      ls_GHPKG: String;
     li_RefFractionDetailId,lI_DocID : Integer;
     lf_mktgreferalamount,lf_docreferalamount:Double;
Begin
     IF Query_PatientTest.FieldByName('BillType').AsString <> 'R' Then // O - Registration
     Begin
          With Query_GetFractionItem Do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select PWC.*,DC.frac_DepId,DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE FixedAmtDeductOnTestPrice,(Select doct_docid From Hs_DOct_Doctor where Doct_DocId=PWC.Powf_DocID) as DocId');
               sql.add(' From Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC,Hs_Tena_TestName TN ');
               sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and DC.frac_TestNameId=TN.Tena_TestNameId and PWC.Powf_IsActive=''Y'' and ');
               sql.add(' TN.Tena_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);

               IF Query_PatientTest.FieldByName('BillType').AsString = 'IP' Then
                    sql.add(' and Upper(DC.Frac_FractionFor)=''INDOOR''')
                    // sql.add(' and (Upper(DC.FractionFor)=''BOTH'' or Upper(DC.FractionFor)=''INDOOR'')')
               Else
                    sql.add(' and Upper(DC.Frac_FractionFor)=''OUTDOOR''');
               // sql.add(' and (Upper(DC.FractionFor)=''BOTH'' or Upper(DC.FractionFor)=''OUTDOOR'')');
               // sql.saveToFile('C:\Fract1.Txt');
               Open;

               IF RecordCount <= 0 Then
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Select PWC.*,DC.Frac_DepId DepId,DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE FixedAmountDeductOnTestPrice,(Select DOct_DOcId From Hs_Doct_Doctor where Doct_DocId=PWC.Powf_DocID) as DocId');
                    sql.add(' From Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC,Hs_Tena_TestName TN ');
                    sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and DC.Frac_TestNameId=TN.Tena_TestNameId and PWC.Powf_IsActive=''Y'' and ');
                    sql.add(' TN.Tena_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);
                    IF Query_PatientTest.FieldByName('BillType').AsString = 'IP' Then
                         sql.add(' and (Upper(DC.Frac_FractionFor)=''BOTH'' or Upper(DC.Frac_FractionFor)=''INDOOR'')')
                    Else
                         sql.add(' and (Upper(DC.Frac_FractionFor)=''BOTH'' or Upper(DC.Frac_FractionFor)=''OUTDOOR'')');
                    // sql.saveToFile('C:\Fract2.Txt');
                    Open;
               End;
          End;

          IF Query_GetFractionItem.RecordCount <= 0 Then // Sometime Department Wise Fraction Break Setup Would be there instead of Item wise.
          Begin
               With Query_GetFractionItem Do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(
                         'Select PWC.*,DC.Frac_DepId DepId,DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE IsFixedAmountDeductOnTestPrice,(Select DOct_DOcId From Hs_Doct_Doctor where Doct_DocId=PWC.Powf_DocID) as DocId');
                    sql.add(' From Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC');
                    sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and  DC.Frac_DepId=' + Query_PatientTest.FieldByName('DepId').AsString);
                    sql.add(' and  PWC.Powf_IsActive=''Y'' and DC.Frac_TestNameId=0 ');
                    // sql.saveToFile('C:\Fract3.Txt');
                    Open;
               End;
          End;

          IF Query_GetFractionItem.RecordCount = 1 Then
          Begin
               IF DBLCB_ActualDrTech.KeyValue = NULL Then
                    lI_DocID := Query_PatientTest.FieldByName('DocId').AsInteger
               Else
                    lI_DocID := DBLCB_ActualDrTech.KeyValue;
          End
          Else
               li_DocId :=1;

          b_IsFractionItemNotExist := False;
          IF ((Query_GetFractionItem.FieldByName('Powf_FractionAmount').AsFloat > 0) or (Query_GetFractionItem.FieldByName('Powf_FractionRate')
                      .AsFloat > 0)) and (Query_Frct_BreakUp_OfItem.FieldByName('FractionAmount').AsFloat = 0) Then
          Begin
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    IF (ps_AccessFrom<>'OUTSTD_FRACTION') Then
                    sql.add(' Delete From Hs_Frde_FractionDetail where Frde_BillDetailId=' + Query_PatientTest.FieldByName('BillDetailId').AsString)
                    Else
                    sql.add(' Delete From Hs_Frde_FractionDetail where Frde_ServiceBillDetailId=' + Query_PatientTest.FieldByName('ServiceBillDetailId').AsString);
                    sql.add(' and Frde_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);
                    sql.add(' and Frde_IsFractionLocked=''N''');
                    ExecSQL;
               End;
               b_IsFractionItemNotExist := True;
          End;

          Try
               DM_Hospital.Db.StartTransaction;
               if CB_MainDoctor.Checked = True then
               Begin
                    With Query_Process do
                    Begin
                         Close;
                         sql.Clear;
                         IF (ps_AccessFrom<>'OUTSTD_FRACTION') Then
                         Begin
                              sql.add(' Update Hs_Bide_BillDetail Set Bide_Doccode=' + #39 + DBLCB_ActualDrTech.KeyValue + #39);
                              sql.add(' ,Bide_DocId=' + IntToStr(Query_ActDoctor.FieldByName('DocId').AsInteger));
                              sql.add(' where Bide_BillDetailId=' + Query_PatientTest.FieldByName('BillDetailId').AsString);
                         End
                         Else
                         Begin
                              sql.add(' Update Hs_SEBD_ServiceBillDetail Set SEBD_Doccode=' + #39 + DBLCB_ActualDrTech.KeyValue + #39);
                              sql.add(' ,SEBD_DocId=' + IntToStr(Query_ActDoctor.FieldByName('DocId').AsInteger));
                              sql.add(' where SEBD_ServiceBillDetailId=' + Query_PatientTest.FieldByName('ServiceBillDetailId').AsString);
                         End;
                         ExecSQL;
                    End;
               End;

               if (Cb_Referal.checked=True) and (DBLCB_MktgReferral.KeyValue<>Null)and
                    (ReferalExist('MKTG REFERRAL',Query_PatientTest.FieldByName('Service').AsString,Query_PatientTest.FieldByName('BillDetailId').AsInteger)=False) then
               Begin

                    lf_UnitTestCost := Query_PatientTest.FieldByName('Amount').AsFloat - lf_FixedAmountDeductOnTestPrice;
                    lf_UnitTestCostOrg :=lf_UnitTestCost;

                    lf_DisPer := Query_PatientTest.FieldByName('DisPer').AsFloat;
                     IF GETMKTGREFERRALFRACTION(DBLCB_MktgReferral.KeyValue,Query_PatientTest.FieldByName('Testnameid').asinteger
                    ,Query_PatientTest.FieldByName('DepId').AsInteger)=True Then
                    Begin
                         if (gf_MKTGFractionPer > 0) and (gf_MKTGFractionAmount=0) then
                         gf_MKTGFractionAmount:=RoundingAfterSecondPlace(lf_UnitTestCost * gf_MKTGFractionPer / 100)
                         Else if (gf_MKTGFractionPer = 0) and (gf_MKTGFractionAmount > 0) then
                         gf_MKTGFractionPer:=RoundingUserDefineDecaimalPart(((gf_MKTGFractionAmount / lf_UnitTestCost) * 100),4);
                    End;
                    SaveFractiondetail(Query_PatientTest.FieldByName('PatientId').AsInteger,Query_PatientTest.FieldByName('InPatientId').AsInteger,
                              Query_PatientTest.FieldByName('BillDetailId').AsInteger,Query_PatientTest.FieldByName('ServiceBillDetailId').AsInteger,
                              Query_PatientTest.FieldByName('DepId').AsInteger,
                              DBLCB_MKTGReferral.KeyValue,Query_PatientTest.FieldByName('TestNameID').AsInteger,
                              0,0,0,gi_UserId,0,lf_UnitTestCost,lf_UnitTestCostOrg,Query_PatientTest.FieldByName('Qty').AsFloat,
                              gf_MKTGFractionAmount,gf_MKTGFractionPer,lf_DisPer,
                              Query_PatientTest.FieldByName('Service').AsString,Query_PatientTest.FieldByName('BillNo').AsString,
                              Query_PatientTest.FieldByName('BillDate').AsString,
                              Query_PatientTest.FieldByName('BillType').AsString,Query_PatientTest.FieldByName('PayType').AsString,
                              'Y','MKTG REFERRAL','N','N','',ps_TodaysDate,ps_TodaysTime,'N');
                    lf_mktgreferalamount:=gf_MKTGFractionAmount;

               End;

               if (CB_OutReferral.checked=True) and (DBLCB_ActualDrTech.KeyValue<>Null)and
                    (ReferalExist('DOC REFERRAL',Query_PatientTest.FieldByName('Service').AsString,Query_PatientTest.FieldByName('BillDetailId').AsInteger)=False) then
               Begin
                    lf_UnitTestCost := Query_PatientTest.FieldByName('Amount').AsFloat - lf_FixedAmountDeductOnTestPrice;
                    lf_UnitTestCostOrg :=lf_UnitTestCost;

                    lf_DisPer := Query_PatientTest.FieldByName('DisPer').AsFloat;
                     IF GETMKTGREFERRALFRACTION(DBLCB_ActualDrTech.KeyValue,Query_PatientTest.FieldByName('Testnameid').asinteger
                    ,Query_PatientTest.FieldByName('DepId').AsInteger)=True Then
                    Begin
                         if (gf_MKTGFractionPer > 0) and (gf_MKTGFractionAmount=0) then
                         gf_MKTGFractionAmount:=RoundingAfterSecondPlace(lf_UnitTestCost * gf_MKTGFractionPer / 100)
                         Else if (gf_MKTGFractionPer = 0) and (gf_MKTGFractionAmount > 0) then
                         gf_MKTGFractionPer:=RoundingUserDefineDecaimalPart(((gf_MKTGFractionAmount / lf_UnitTestCost) * 100),4);
                    End;
                    SaveFractiondetail(Query_PatientTest.FieldByName('PatientId').AsInteger,Query_PatientTest.FieldByName('InPatientId').AsInteger,
                              Query_PatientTest.FieldByName('BillDetailId').AsInteger,Query_PatientTest.FieldByName('ServiceBillDetailId').AsInteger,Query_PatientTest.FieldByName('DepId').AsInteger,
                              DBLCB_ActualDrTech.KeyValue,Query_PatientTest.FieldByName('TestNameID').AsInteger,
                              0,0,0,gi_UserId,0,lf_UnitTestCost,lf_UnitTestCostOrg,Query_PatientTest.FieldByName('Qty').AsFloat,
                              gf_MKTGFractionAmount,gf_MKTGFractionPer,lf_DisPer,
                              Query_PatientTest.FieldByName('Service').AsString,Query_PatientTest.FieldByName('BillNo').AsString,
                              Query_PatientTest.FieldByName('BillDate').AsString,
                              Query_PatientTest.FieldByName('BillType').AsString,Query_PatientTest.FieldByName('PayType').AsString,
                              'Y','DOC REFERRAL','N','N','',ps_TodaysDate,ps_TodaysTime,'N');
                    lf_docreferalamount:=gf_MKTGFractionAmount;

               End;


               Query_GetFractionItem.First;
               while not Query_GetFractionItem.EOF Do
               Begin
                    { Check Whether that fraction Break item already exist or not }
                    IF b_IsFractionItemNotExist = False Then
                    Begin
                         With Query_Process do
                         Begin
                              Close;
                              sql.Clear;
                              IF (ps_AccessFrom<>'OUTSTD_FRACTION') Then
                              sql.add(' Select * From Hs_Frde_FractionDetail where Frde_BillDetailId=' + Query_PatientTest.FieldByName('BillDetailId').AsString)
                              Else
                              sql.add(' Select * From Hs_Frde_FractionDetail where Frde_ServiceBillDetailId=' + Query_PatientTest.FieldByName('ServiceBillDetailId').AsString);
                              sql.add(' and Frde_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);
                              sql.add(' and Frde_PositionWiseFractionId=' + Query_GetFractionItem.FieldByName('POWF_POSITIONWISEFRACTIONID').AsString);
                              Open;
                         End;
                    End
                    Else
                    Begin
                         { Just to make Query_Process Active because below we check Recordcount }
                         With Query_Process do
                         Begin
                              Close;
                              sql.Clear;
                              sql.add(' Select * From Hs_Dept_Department  where Dept_Depid=-1');
                              Open;
                         End;
                    End;


                    if CB_SetMainConsAsSurgeon.Checked=True then
                    Begin
                         if ((Query_GetFractionItem.FieldByName('Powf_PositionName').AsString='DOCTOR') or
                         (Query_GetFractionItem.FieldByName('Powf_PositionName').AsString='SURGEON'))
                         and (lI_DocID=1) then
                         lI_DocID:=Pi_ConsDocId
                         Else
                         lI_DocID:=1;
                    End;

                    pb_MutualDocForShare:=False;
                    li_RefFractionDetailId:=0;

                    if CB_CRPGroup.Checked=True then
                    Begin
                         if Query_GetFractionItem.FieldByName('PositionName').AsString<>'ANESTHSIA' then
                         Mutually_Share_Fraction('CRP','OT');
                    End;

                    IF (Query_Process.RecordCount <= 0) or (b_IsFractionItemNotExist = True) Then
                    Begin
                         lf_UnitTestCost := 0;
                         lf_UnitTestCostOrg := Query_PatientTest.FieldByName('Amount').AsFloat;
                         lf_FixedAmountDeductOnTestPrice := 0;//Query_GetFractionItem.FieldByName('FixedAmountDeductOnTestPrice').AsFloat;
                         lf_UnitTestCost := Query_PatientTest.FieldByName('Amount').AsFloat - lf_FixedAmountDeductOnTestPrice
                                        -lf_mktgreferalamount-lf_docreferalamount;


                         lf_FractionRate := Query_GetFractionItem.FieldByName('Powf_FractionRate').AsFloat;

                         IF lf_UnitTestCost = 0 Then
                         Begin
                              lf_FractionAmt := Query_GetFractionItem.FieldByName('Powf_FractionAmount').AsFloat;
                              IF Query_PatientTest.FieldByName('RateType').AsString = 'FRG' Then
                                   lf_FractionAmt := lf_FractionAmt * 2;
                         End
                         Else
                              lf_FractionAmt := RoundingAfterSecondPlace
                                (lf_UnitTestCost * Query_GetFractionItem.FieldByName('Powf_FractionRate').AsFloat / 100);

                         IF Query_GetFractionItem.FieldByName('Powf_ISFIXEDPERSONFORFRACTION').AsString = 'Y' Then
                         lI_DocID := Query_GetFractionItem.FieldByName('POWf_DocId').AsInteger;

                         if lI_DocID = 0 then
                              lI_DocID :=1;

                         IF Query_GetFractionItem.FieldByName('Powf_ISFRACTIONPROPWITHDISPER').AsString = 'Y' Then
                              lf_DisPer := Query_PatientTest.FieldByName('DisPer').AsFloat
                         Else
                              lf_DisPer := 0;

                         if pb_MutualDocForShare=False then
                         Begin
                              SaveFractiondetail(Query_PatientTest.FieldByName('PatientId').AsInteger,Query_PatientTest.FieldByName('InPatientId').AsInteger,
                                   StrToInt64(Query_PatientTest.FieldByName('BillDetailId').AsString),StrToInt64(Query_PatientTest.FieldByName('ServiceBillDetailId').AsString),
                                   Query_PatientTest.FieldByName('DepId').AsInteger,
                                   Query_PatientTest.FieldByName('DocID').AsInteger,Query_PatientTest.FieldByName('TestNameID').AsInteger,
                                   Query_GetFractionItem.FieldByName('Powf_FractionId').AsInteger,0,
                                   Query_GetFractionItem.FieldByName('POWF_POSITIONWISEFRACTIONID').AsInteger,gi_UserId,0,
                                   lf_UnitTestCost,lf_UnitTestCostOrg,Query_PatientTest.FieldByName('Qty').AsFloat,
                                   lf_FractionAmt,lf_FractionRate,lf_DisPer,
                                   Query_PatientTest.FieldByName('Service').AsString,Query_PatientTest.FieldByName('BillNo').AsString,
                                   Query_PatientTest.FieldByName('BillDate').AsString,
                                   Query_PatientTest.FieldByName('BillType').AsString,Query_PatientTest.FieldByName('PayType').AsString,
                                   'Y','','N','N','',ps_TodaysDate,ps_TodaysTime,Query_GetFractionItem.FieldByName('Powf_IsRevSeparatehead').AsString);
                         End;

                         IF (Query_PatientTest.FieldByName('BillType').AsString = 'B') and
                           (Trim(Query_PatientTest.FieldByName('RFBillNo').AsString) <> '') Then
                         // IF The Item Is Refunded then refund frct. should post.
                         Begin
                              with Qry do
                              begin
                                   Close;
                                   DatabaseName:=gs_DatabaseName;
                                   SQL.Clear;
                                   SQL.Add('Select A.*,(Select Rede_RefundDetailId From Hs_Rede_RefundDetail where Rede_BillDetailId=A.Frde_BillDetailId)Rede_RefundDetailId');
                                   SQL.Add('From HS_FRDE_FractionDetail A where FRDE_Billdetailid='+Query_PatientTest.FieldByName('BillDetailId').AsString);
                                   Open;
                              end;

                              while not Qry.Eof  do
                              begin
                                   With Query_Process do
                                   Begin
                                        Close;
                                        sql.Clear;
                                        DatabaseName:=gs_DatabaseName;
                                        sql.add(' Select FRRD_FRACTIONDETAILID From Hs_Frrd_FractionRefundDetail  where FRRD_FRACTIONDETAILID='+InTToStr(Qry.FieldByName('FRDE_FractionDetailId').AsInteger));
                                        Open;
                                   End;
                                   if Query_Process.fieldByName('FRRD_FRACTIONDETAILID').AsInteger<1 then
                                   begin
                                        SaveRefundFractiondetail(Qry.FieldByName('FRDE_FractionDetailId').AsInteger,Qry.FieldByName('FRDE_PatientId').AsInteger,
                                             Qry.FieldByName('FRDE_InPatientId').AsInteger,Qry.FieldByName('Rede_RefundDetailId').AsInteger,0,
                                             Qry.FieldByName('FRDE_DepId').AsInteger,Qry.FieldByName('FRDE_DocID').AsInteger,0,
                                             Qry.FieldByName('FRDE_FractionId').AsInteger,0,Qry.FieldByName('FRDE_PositionWiseFractionId').AsInteger,
                                             Gi_UserId,Qry.FieldByName('FRDE_UnitTestCost').AsFloat,
                                             Qry.FieldByName('FRDE_Qty').AsFloat,Qry.FieldByName('FRDE_FractionAmount').AsFloat,Qry.FieldByName('FRDE_FractionRate').AsFloat,Qry.FieldByName('FRDE_DisPer').AsFloat,
                                             Qry.FieldByName('FRDE_TestNameCode').AsString,Gs_BillNo,TOdaysdate,Qry.FieldByName('FRDE_BillType').AsString,
                                             Qry.FieldByName('FRDE_PayType').AsString,Qry.FieldByName('FRDE_Isfractionpropwithdisper').AsString,'',Qry.FieldByName('FRDE_Isaddlumpsum').AsString,
                                             Qry.FieldByName('FRDE_Ischargedivide').AsString,'',todaysdate,TodaysTime);
                                   end;
                                   Qry.next;
                              end;
                         End;
                    End
                    Else
                    Begin
                         IF (Query_PatientTest.FieldByName('BillType').AsString = 'B') and
                           (Trim(Query_PatientTest.FieldByName('RFBillNo').AsString) <> '') Then
                         // IF The Item Is Refunded then refund frct. should post.
                         Begin
                              with Qry do
                              begin
                                   Close;
                                   DatabaseName:=gs_DatabaseName;
                                   SQL.Clear;
                                   SQL.Add('Select A.*,(Select Rede_RefundDetailId From Hs_Rede_RefundDetail where Rede_BillDetailId=A.Frde_BillDetailId)Rede_RefundDetailId');
                                   SQL.Add('From HS_FRDE_FractionDetail A where FRDE_Billdetailid='+Query_PatientTest.FieldByName('BillDetailId').AsString);
                                   Open;
                              end;

                              while not Qry.Eof  do
                              begin
                                   With Query_Process do
                                   Begin
                                        Close;
                                        sql.Clear;
                                        DatabaseName:=gs_DatabaseName;
                                        sql.add(' Select FRRD_FRACTIONDETAILID From Hs_Frrd_FractionRefundDetail  where FRRD_FRACTIONDETAILID='+InTToStr(Qry.FieldByName('FRDE_FractionDetailId').AsInteger));
                                        Open;
                                   End;
                                   if Query_Process.fieldByName('FRRD_FRACTIONDETAILID').AsInteger<1 then
                                   begin
                                        SaveRefundFractiondetail(Qry.FieldByName('FRDE_FractionDetailId').AsInteger,Qry.FieldByName('FRDE_PatientId').AsInteger,
                                        Qry.FieldByName('FRDE_InPatientId').AsInteger,Qry.FieldByName('Rede_RefundDetailId').AsInteger,0,
                                        Qry.FieldByName('FRDE_DepId').AsInteger,Qry.FieldByName('FRDE_DocID').AsInteger,0,
                                        Qry.FieldByName('FRDE_FractionId').AsInteger,0,Qry.FieldByName('FRDE_PositionWiseFractionId').AsInteger,
                                        Gi_UserId,Qry.FieldByName('FRDE_UnitTestCost').AsFloat,
                                        Qry.FieldByName('FRDE_Qty').AsFloat,Qry.FieldByName('FRDE_FractionAmount').AsFloat,Qry.FieldByName('FRDE_FractionRate').AsFloat,Qry.FieldByName('FRDE_DisPer').AsFloat,
                                        Qry.FieldByName('FRDE_TestNameCode').AsString,Gs_BillNo,TOdaysdate,Qry.FieldByName('FRDE_BillType').AsString,
                                        Qry.FieldByName('FRDE_PayType').AsString,Qry.FieldByName('FRDE_Isfractionpropwithdisper').AsString,'',Qry.FieldByName('FRDE_Isaddlumpsum').AsString,
                                        Qry.FieldByName('FRDE_Ischargedivide').AsString,'',todaysdate,TodaysTime);
                                   end;
                                   Qry.next;
                              end;
                         End;
                    End;

                    (*if b_IsFractionItemNotExist=False then
                    Begin
                         if (CB_NewUnitPrice.Checked=False) then
