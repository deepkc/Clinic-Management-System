Procedure TForm_FractionMgmtNew.Load_Fraction_Test;
Var
     lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, lf_FractionAmt, lf_FractionAmtByRate, lf_FractionRate,
       lf_DisPer: Double;
      ls_OldService, ls_GHPKG: String;
     li_DocId:Integer;
Begin
     Try
          DM_Hospital.Db.StartTransaction;
          ls_OldService := '';
          Query_PatientTest.First;
          while not Query_PatientTest.EOF do
          Begin
               IF (Query_PatientTest.FieldByName('BillType').AsString <> 'R') Then
               Begin
                    IF ls_OldService <> Query_PatientTest.FieldByName('Service').AsString Then
                    Begin
                         With Query_GetFractionItem Do
                         Begin
                              Close;
                              sql.Clear;
                              sql.add( ' Select PWC.*,(Select Doct_DocId DocId From Hs_Doct_Doctor where Doct_DocId=PWC.Powf_DocId) as DocId,DC.Frac_DepId DepId,');
                              sql.add('DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE IsFixedAmountDeductOnTestPrice From Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC,Hs_Tena_TestName TN ');
                              sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and DC.Frac_TestNameId=TN.Tena_TestNameId and PWC.Powf_IsActive=''Y'' and ');
                              sql.add(' TN.Tena_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);

                              IF Query_PatientTest.FieldByName('BillType').AsString = 'IP' Then
                                   sql.add(' and Upper(DC.Frac_FractionFor)=''INDOOR''')
                              Else
                                   sql.add(' and Upper(DC.Frac_FractionFor)=''OUTDOOR''');
                              // sql.saveToFile('C:\Fract1.Txt');
                              Open;

                              IF RecordCount <= 0 Then
                              Begin
                                   Close;
                                   SQL.Clear;
                                   SQL.add(' Select PWC.*,(Select Doct_DocId DocId From Hs_Doct_Doctor where Doct_DocId=PWC.Powf_DocId) as DocId,DC.Frac_DepId DepId,');
                                   sql.add('DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE IsFixedAmountDeductOnTestPrice From Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC,Hs_Tena_TestName TN ');
                                   sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and DC.Frac_TestNameId=TN.Tena_TestNameId and PWC.Powf_IsActive=''Y'' and '
                                     );
                                   sql.add(' TN.Tena_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);

                                   IF Query_PatientTest.FieldByName('BillType').AsString = 'IP' Then
                                        sql.add(' and (Upper(DC.Frac_FractionFor)=''BOTH'' or Upper(DC.Frac_FractionFor)=''INDOOR'')')
                                   Else
                                        sql.add(' and (Upper(DC.Frac_FractionFor)=''BOTH'' or Upper(DC.Frac_FractionFor)=''OUTDOOR'')');
                                   // sql.saveToFile('C:\Fract1.Txt');
                                   Open;
                              End;
                         End;
                    End;

                    ls_OldService := Query_PatientTest.FieldByName('Service').AsString;

                    IF Query_GetFractionItem.RecordCount <= 0 Then // Sometime Department Wise Fraction Break Setup Would be there instead of Item wise.
                    Begin
                         With Query_GetFractionItem Do
                         Begin
                              Close;
                              sql.Clear;
                              sql.add(' Select PWC.*,(Select Doct_DocId From Hs_Doct_Doctor where Doct_DocId=PWC.Powf_DocId) as DocID,DC.Frac_DepId DepId,');
                              sql.add('DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE  from Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC');
                              sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and  DC.Frac_DepId=' + Query_PatientTest.FieldByName('DepId')
                                     .AsString);
                              sql.add(' and DC.Frac_TestNameId=0 ');
                              Open;
                         End;
                    End;

                    IF Query_GetFractionItem.RecordCount = 1 Then
                    Begin
                         IF DBLCB_ActualDrTech.KeyValue = NULL Then
                              li_DocId := Query_PatientTest.FieldByName('DocId').AsInteger
                         Else
                              li_DocId := DBLCB_ActualDrTech.KeyValue;
                    End
                    Else
                         li_DocId :=1;

                    b_IsFractionItemNotExist := False;
                    IF ((Query_GetFractionItem.FieldByName('POWF_FRACTIONAMOUNT').AsFloat > 0) or
                           (Query_GetFractionItem.FieldByName('POWF_FRACTIONRATE').AsFloat > 0)) and
                      (Query_Frct_BreakUp_OfItem.FieldByName('FractionAmount').AsFloat = 0) Then
                    Begin
                         With Query_Process do
                         Begin
                              Close;
                              sql.Clear;
                              sql.add(' Delete From Hs_Frde_FractionDetail where Frde_BillDetailId=' + Query_PatientTest.FieldByName('BillDetailId')
                                     .AsString);
                              sql.add(' and Frde_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);
                              sql.add(' and Frde_IsFractionLocked=''N''');
                              ExecSQL;
                         End;
