{ For The Case Of Doctor Fraction }
Function TForm_FractionMgmtNew.GetOPDCommession_Medicare: Double;
Begin
     With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select FractionAmount,FractionRate,FractionId,IsRateAmt From Fraction where Description ');
          IF (Query_PatientTest.FieldByName('Service').AsString <> 'EMR01') Then
          Begin
               IF Query_PatientTest.FieldByName('RegChrgWiseCat').AsString = 'A' Then
                    sql.add(' =''OPD REGISTRATION''')
               Else
                    sql.add(' =''OPD REGISTRATION LOW''');
          End
          Else IF (Query_PatientTest.FieldByName('Service').AsString = 'EMR01') Then
          Begin
               IF pb_IsConsultant = True Then
                    sql.add(' =''EMERGENCY CONSULTATION''')
               Else // Duty Doctor
                    sql.add(' =''EMERGENCY DUTY DOCTOR''');
          End;
          sql.add(' and CommType=1');
          Open;

          pi_DocCommId := FieldByName('FractionId').AsInteger;
          IF FieldByName('IsRateAmt').AsString = 'A' Then
               Result := FieldByName('FractionAmount').AsFloat
          Else
               Result := RoundingAfterSecondPlace((Query_PatientTest.FieldByName('Amount').AsFloat * FieldByName('FractionRate').AsFloat)
                      / 100);
     End;
End;

{ For The Case Of Doctor Fraction }
Function TForm_FractionMgmtNew.GetOPDCommession: Double;
var  lf_DocVisitCharge:Double;
Begin
   {  With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select FractionAmount,FractionRate,FractionId,IsRateAmt From Fraction where Description ');
          IF (Query_PatientTest.FieldByName('Service').AsString <> 'EMR01') and
            (Query_PatientTest.FieldByName('Service').AsString <> 'COU01') and
            (Query_PatientTest.FieldByName('RateType').AsString <> 'INT') Then
               sql.add(' =''OPD REGISTRATION''')
          Else IF ((Query_PatientTest.FieldByName('Service').AsString = 'EMR01')) Then
          Begin
               IF Query_PatientTest.FieldByName('RateType').AsString <> 'INT' Then
               Begin
                    IF Get_Emr_Day_Night(Query_PatientTest.FieldByName('BillTime').AsString) <> 'NIGHT' Then
                         sql.add(' =''EMERGENCY OPD''')
                    Else
                         sql.add(' =''EMERGENCY NIGHT OPD''');
               End
               Else
               Begin
                    sql.add(' =''OPD INTERNATIONAL EMR''')
               End;
          End
          Else IF Query_PatientTest.FieldByName('RateType').AsString = 'INT' Then
               sql.add(' =''OPD INTERNATIONAL''')
          Else { OPD Counseling }
  {             sql.add(' =''OPD COUNSEALING''');
          sql.add(' and CommType=1');
          Open;

          pi_DocCommId := FieldByName('FractionId').AsInteger;
          IF FieldByName('IsRateAmt').AsString = 'A' Then
               Result := FieldByName('FractionAmount').AsFloat
          Else
               Result := RoundingAfterSecondPlace((Query_PatientTest.FieldByName('Amount').AsFloat * FieldByName('FractionRate').AsFloat)
                      / 100);
     End;}
     With Query_getdetail do
     Begin
          Close;
          DatabaseName := gs_DatabaseName;
          SQL.Clear;
          sql.Add('select bide_amount,bide_disper,bide_discount,bide_docid,bide_depid,bide_patienttype,(select DOCT_DOCSHAREGROUP from hs_doct_doctor where doct_docid=bide_docid) DOCSHAREGROUP ');
          sql.Add(' from hs_bide_billdetail where  bide_billno=' + quotedstr(Query_PatientTest.FieldByName('billno').Asstring)) ;
          //sql.SaveToFile('d:\check.txt');
          Open;
     End;
     if Query_getdetail.recordcount<=0    then
     begin
          Result:=0;
          exit;
     end;
      pf_DisPer := Query_getdetail.FieldByName('bide_disper').asfloat  ;
     pb_IsDoctorWiseFraction:=IsParticularDocShareInOPDReg(Query_getdetail.FieldByName('bide_docid').AsInteger,Query_getdetail.FieldByName('bide_patienttype').AsString);
     if gs_HospitalNameForCode = 'DISHARC' then
     begin
          pf_DocVisitCharge:= Query_getdetail.FieldByName('bide_amount').asfloat- Query_getdetail.FieldByName('bide_discount').asfloat;
           with Query_get do
          begin
               Close;
               DatabaseName:=gs_databasename;
               SQL.Clear;
               SQL.Add('select * from HS_OPRF_OPDREGFRACTION');
               Open;
          end;
          lf_DocVisitCharge:=RoundingAfterSecondPlace(pf_DocVisitCharge * (100-pf_DisPer)/100) ;
          pf_sum :=0;
          Query_get.first;
          while not Query_get.Eof do
          begin
               with QueryBlank do
               begin
                    Close;
                    databasename:=gs_databasename;
                    SQL.Clear;
                    SQL.Add('select * from HS_OPRF_OPDREGFRACTION where ');
                    sql.Add(FloatToStr(lf_DocVisitCharge)+Query_get.FieldByName('OPRF_LOWERLIMITOPERATOR').AsString);
                    SQL.Add('OPRF_LOWERLIMIT ');
                    SQL.Add('and '+FloatToStr(lf_DocVisitCharge)+(Query_get.FieldByName('OPRF_UPPERLIMITOPERATOR').AsString));
                    SQL.Add('OPRF_UPERLIMIT');
                    //SQL.Add('and OPRF_LOWERLIMIT = ' + Query_get.FieldByName('OPRF_LOWERLIMIT').AsString);
                    //sql.add('and OPRF_UPERLIMIT = ' + Query_get.FieldByName('OPRF_UPERLIMIT').AsString);
                    //SQL.SaveToFile('c:/acaca.txt');
                    open;
                    if QueryBlank.recordcount>0 then
                    begin
                               pi_FractionId := QueryBlank.FieldByName('OPRF_ID').asinteger;
                               pf_FractionRate:=0;
                              if QueryBlank.FieldByName('OPRF_ISPERCENTAGE').AsString='T' then
                              begin
                                  pf_sum :=  RoundingAfterSecondPlace(lf_DocVisitCharge * (QueryBlank.FieldByName('oprf_rate').Asfloat)/100);
                              end
                              else
                              begin
                                   pf_sum :=  (QueryBlank.FieldByName('oprf_rate').Asfloat);
                              end;

                              if FieldByName('OPFR_ISHOSPITAL').AsString='T' then
                              begin
                                   pf_sum :=  lf_DocVisitCharge - pf_sum;
                              end;
                             // Result:= pf_sum;
                              break;
                              {if pb_sum>0 then
                              begin
                                    Result:= pb_sum;
                                    //ShowMessage('Fraction Amount  Store.');
                              end
                              else
                              begin
                                   ShowMessage('Fraction Amount not Store.');
                                   Result:=0;
                              end; }

                    end;
               end;
                    Query_get.NEXT;
          end;
          Result:= pf_sum;
     end
     else
     begin
          pf_DocVisitCharge:= Query_getdetail.FieldByName('bide_amount').asfloat;
          With QueryBlank do
          Begin
               { First Identify Department Specific Fraction Setup }
               Close;
               DatabaseName := gs_DatabaseName;
               SQL.Clear;
               if pb_IsDoctorWiseFraction=True then
               Begin
                    SQL.Add(' Select FRAC_FractionAmount,FRAC_FractionRate,FRAC_FractionId,FRAC_IsRateAmt From HS_FRAC_Fraction ');
                    SQL.Add(' where FRAC_FractionType=1 and FRAC_DocId=' + IntToStr(Query_getdetail.FieldByName('bide_docid').AsInteger)+' and FRAC_PATIENTTYPECODE='+#39+Query_getdetail.FieldByName('bide_patienttype').AsString+#39);
               End
               Else
               Begin
                    SQL.Add(' Select FRAC_FractionAmount,FRAC_FractionRate,FRAC_FractionId,FRAC_IsRateAmt From HS_FRAC_Fraction ');
                    SQL.Add(' where FRAC_FractionType=1 and FRAC_DepId=' + IntToStr(Query_getdetail.FieldByName('bide_depid').AsInteger));
               End;
               Open;

               if QueryBlank.FieldByName('FRAC_FractionId').AsInteger <= 0 then
               Begin
                    Close;
                    DatabaseName := gs_DatabaseName;
                    SQL.Clear;
                    SQL.Add(' Select FRAC_FractionAmount,FRAC_FractionRate,FRAC_FractionId,FRAC_IsRateAmt From HS_FRAC_Fraction ');
                    if Query_getdetail.FieldByName('DOCSHAREGROUP').AsString = 'A' then
                    SQL.Add(' where FRAC_Description=''OPD_REG_GROUP_A''')
                    Else
                    SQL.Add(' where FRAC_Description=''OPD_REG_GROUP_B''');
                    SQL.Add(' and FRAC_FractionType=1');
                    //sql.savetofile('c:\check.txt');
                    Open;
               End;

               pi_FractionId := FieldByName('FRAC_FractionId').AsInteger;

               IF FieldByName('FRAC_IsRateAmt').AsString = 'A' Then
               Begin
                    Try
                         pf_FractionRate := RoundingAfterSecondPlace((FieldByName('FRAC_FractionAmount').AsFloat / (pf_DocVisitCharge))* 100);

                    Except
                         pf_FractionRate := 0;
                    End;

                    Result := FieldByName('FRAC_FractionAmount').AsFloat;
               End
               Else
               Begin
                    pf_FractionRate := FieldByName('FRAC_FractionRate').AsFloat;
                    Result := RoundingAfterSecondPlace(((pf_DocVisitCharge) * FieldByName('FRAC_FractionRate').AsFloat)/ 100);
               End;
          End;
     end;
End;

Function TForm_FractionMgmtNew.Get_Emr_Day_Night(BillTime: String): String;
Begin
     IF (((BillTime >= '19:00:00') and (BillTime <= '24:60:60')) or ((BillTime >= '01:00:00') and (BillTime < '07:00:00'))) Then
          Result := 'NIGHT'
     Else
          Result := 'DAY';
End;

Procedure TForm_FractionMgmtNew.Refund_Fraction_Posting(FractionId, PositionWiseFractionId, PatientId, InPatientId, BillDetailId, Service,
     BillNo, RefBillNo: String);
Begin
     With Query_Void do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select Distinct BillDate,BillTime,Qty,BillBy,(Select UserName From UserMain where UserId=BillBy) ');
          sql.add(' UserName From BillDetail where BillNo=' + #39 + RefBillNo + #39 + ' and Service=' + #39 + Service + #39);
          Open;
     End;

     With Query_RefundFrctPost do
     Begin
          Close;
          sql.Clear;
          sql.add(' Update FractionDetail set RFBillNo=' + #39 + RefBillNo + #39);
          sql.add(' ,RefundDate=' + #39 + Query_Void.FieldByName('BillDate').AsString + #39);
          sql.add(' ,RefundTime=' + #39 + Query_Void.FieldByName('BillTime').AsString + #39);
          sql.add(' ,RFQty=' + IntToStr(Query_Void.FieldByName('Qty').AsInteger));
          sql.add(' ,RefundById=' + IntToStr(Query_Void.FieldByName('BillBy').AsInteger));
          sql.add(' ,RefundBy=' + #39 + Query_Void.FieldByName('UserName').AsString + #39);
          sql.add(' where FractionId=' + FractionId + ' and PositionWiseFractionId=' + PositionWiseFractionId);
          sql.add(' and PatientId=' + PatientId + ' and InPatientId=' + InPatientId);
          sql.add(' and BillDetailId=' + BillDetailId + ' and TestNameCode=' + #39 + Service + #39);
          sql.add(' and BillNo=' + #39 + BillNo + #39);
          ExecSQL;
     End;
End;

