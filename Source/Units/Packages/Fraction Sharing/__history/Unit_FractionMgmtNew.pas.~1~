procedure TForm_FractionMgmtNew.BitBtn_AdjDeductionClick(Sender: TObject);
Var
     lf_DocRate, lf_DisPer, lf_DocCommession, lf_FrctAmt, lf_DeductAmt: Double;
     li_RefFrctId, ls_DrProcId: Integer;
begin
     IF Query_Frct_BreakUp_OfItem.RecordCount = 0 Then
     Begin
          MessageDlg('No Record For Fraction Adjustment.', mtInformation, [mbok], 0);
          DBLCB_DrTechAL.SetFocus;
          Exit;
     End;

     IF Query_Frct_BreakUp_OfItem.FieldByName('IsFractionLocked').AsString = 'N' Then
     Begin
          MessageDlg(' Sorry ! Fraction Has Not Yet Locked. So This is not a Proper Place for Non Locking Fraction.', mtWarning, [mbok], 0);
          Exit;
     End;

     IF Query_Frct_BreakUp_OfItem.FieldByName('DocCode').AsString <> DBLCB_AdjDocTech.KeyValue Then
     Begin
          MessageDlg('Sorry ! For Deduction Person Must be  " ' + Query_Frct_BreakUp_OfItem.FieldByName('DrName').AsString + '  ".',
               mtWarning, [mbok], 0);
          DBLCB_AdjDocTech.SetFocus;
          Exit;
     End;

     IF (Query_Frct_BreakUp_OfItem.FieldByName('DocCode').AsString = 'HOS01') or
       (Query_Frct_BreakUp_OfItem.FieldByName('DocCode').AsString = 'SLF') or
       (Query_Frct_BreakUp_OfItem.FieldByName('DocCode').AsString = 'DAS') Then
     Begin
          MessageDlg(' Sorry ! This is Hospital Part. Not Fraction of Person.', mtWarning, [mbok], 0);
          Exit;
     End;

     With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select Max(DateTo) DateTo From FRACTIONLOCK_LOG where DocCode=' + #39 + DBLCB_AdjDocTech.KeyValue + #39);
          Open;
     End;

     IF Trim(Query_Process.FieldByName('DateTo').AsString) <> '' Then
     Begin
          IF Query_Process.FieldByName('DateTo').AsString > DateEditX_AdjFrctDate.Text Then
          Begin
               MessageDlg('Sorry ! Fraction Adjustment Date   " ' + DateEditX_AdjFrctDate.Text + ' "  is Less Than ' +
                      'Fraction Locked up to Date   " ' + Query_Process.FieldByName('DateTo').AsString + ' ".', mtWarning, [mbok], 0);
               Exit;
          End;
     End;

     IF Trim(Edit_Remarks.Text) = '' Then
     Begin
          MessageDlg('You Must Have To Put Deduction Reason.', mtWarning, [mbok], 0);
          Edit_Remarks.SetFocus;
          Exit;
     End;

     With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select (Select Desig||'' ''||F_Name From Doctor where DocCode=FractionDetail.DocCode) as Doctor,');
          sql.add(' FrctModifyDate,RefundDate,RefundBy,FrctModifyRefDrProcId From FractionDetail ');
          sql.add(' where FrctModifyRefDrProcId=' + IntToStr(Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger));
          sql.add(' and Trim(RefundDate) is not null ');
          Open;
     End;

     IF Query_Process.RecordCount > 0 Then
     Begin
          MessageDlg('Fraction Deduction of  " ' + Query_Process.FieldByName('Doctor').AsString + '  " Has Already Done on ' + Char(10)
                 + 'Date  " ' + Query_Process.FieldByName('FrctModifyDate').AsString + '  " for Fraction Affecting ' + Char(10)
                 + 'Date  " ' + Query_Process.FieldByName('RefundDate').AsString + '  ".', mtInformation, [mbok], 0);
          DBLCB_DrTechAL.SetFocus;
          Exit;
     End;

     lf_FrctAmt := Query_Frct_BreakUp_OfItem.FieldByName('DocCommNet').AsFloat;
     lf_DeductAmt := StrToFloat(Edit_AdjFrctAmt.Text);
     IF lf_DeductAmt > lf_FrctAmt Then
     Begin
          MessageDlg('Sorry ! Fraction Deduction Amt.(Rs) " ' + Edit_AdjFrctAmt.Text + ' " is Greater ' +
                 'Than Existing Fraction Amt.(Rs) " ' + Query_Frct_BreakUp_OfItem.FieldByName('DocCommNet').AsString + ' ".', mtWarning,
               [mbok], 0);
          Edit_AdjFrctAmt.SetFocus;
          Exit;
     End;

     IF CB_SplFrctAdd.Checked = False Then
     Begin
          lf_DocRate := Query_Frct_BreakUp_OfItem.FieldByName('FractionRate').AsFloat;
          lf_DisPer := Query_Frct_BreakUp_OfItem.FieldByName('DisPer').AsFloat;
          lf_DocCommession := Query_Frct_BreakUp_OfItem.FieldByName('FractionAmount').AsFloat;
          li_RefFrctId := Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger;
     End
     Else
     Begin
          lf_DocRate := 0;
          lf_DisPer := 0;
          lf_DocCommession := StrToFloat(Edit_AdjFrctAmt.Text);
          li_RefFrctId := 0;
     End;

     { DrProcedures_Add_Deduct(DocCode:String;DrComID,PositionWiseFractionId,PatientId,InPatientID,BillDetailId,DepId:Integer;TestNameCode,
       BillNo,BillDate,BillType,PayType,ISFRACTIONPROPWITHDISPER,IsHospitalPart,AddAmtType,IsOperation,Description:String;
       FractionRate,DocCommAmt,AddedPercent,AddedAmt,DisPer,Qty,UnitTestCost:Double;
       RefundDate,RefundTime,RefundBillNo,FrctModifyDate,Remarks:String; RefundBy,FrctModifyBy,RefFractionDetailId : Integer); }

     DrProcedures_Add_Deduct(DBLCB_AdjDocTech.KeyValue, Query_Frct_BreakUp_OfItem.FieldByName('FractionId').AsInteger,
          Query_Frct_BreakUp_OfItem.FieldByName('PositionWiseFractionId').AsInteger, Query_PatientTest.FieldByName('PatientId').AsInteger,
          Query_PatientTest.FieldByName('InPatientId').AsInteger, Query_PatientTest.FieldByName('BillDetailId').AsInteger,
