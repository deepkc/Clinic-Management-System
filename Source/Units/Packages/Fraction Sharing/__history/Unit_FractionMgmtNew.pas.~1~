procedure TForm_FractionMgmtNew.BitBtn_DeductClick(Sender: TObject);
Var
     ls_DrProcId: LongInt;
     ls_Remarks: String;
     lf_DisPer : Double;
begin
     IF Not Query_Frct_BreakUp_OfItem.Active Then
          Query_Frct_BreakUp_OfItem.Active := True;
     IF Query_Frct_BreakUp_OfItem.RecordCount <= 0 Then
     Begin
          MessageDlg('No Record For Deduction.', mtInformation, [mbok], 0);
          Edit_AddedFractAmt.SetFocus;
          Exit;
     End;
     IF Query_Frct_BreakUp_OfItem.FieldByName('IsFractionLocked').AsString = 'Y' Then
     Begin
          MessageDlg(' Sorry ! You Cannot Deduct Fraction Is Already Locked.', mtWarning, [mbok], 0);
          Exit;
     End;
     IF Trim(Edit_AddedFractAmt.Text) = '' Then
          Edit_AddedFractAmt.Text := '0';
     IF StrToFloat(Edit_AddedFractAmt.Text) <= 0 Then
     Begin
          MessageDlg('Plz. Check Deduction Amt. Once !', mtWarning, [mbok], 0);
          Edit_AddedFractAmt.SetFocus;
          Exit;
     End;
     IF Query_Frct_BreakUp_OfItem.FieldByName('DocId').AsInteger <> DLCB_AddedkDoctor.KeyValue Then
     Begin
          MessageDlg('The Person Listed(  ' + Query_Frct_BreakUp_OfItem.FieldByName('DrName')
                 .AsString + ' ) and ' + ' selected( ' + DLCB_AddedkDoctor.Text + ' ) doesn''t matched.', mtInformation, [mbok], 0);
          Edit_AddedFractAmt.SetFocus;
          Exit;
     End;
     IF StrToFloat(Edit_AddedFractAmt.Text) > Query_Frct_BreakUp_OfItem.FieldByName('DocFrctNet').AsFloat Then
     Begin
          IF MessageDlg('Deduction Amt (Rs. ' + Edit_AddedFractAmt.Text + ' ) is grater than doctor share amount (Rs. ' + FloatToStr
                 (Query_Frct_BreakUp_OfItem.FieldByName('DocFrctNet').AsFloat) + ' ).' + Char(10) + Char(10)
                 + 'Despite of this do you want to deduct this ?', mtConfirmation, [mbyes, mbno], 0) = MrNo Then
          Begin
               Edit_AddedFractAmt.SetFocus;
               Exit;
          End;
     End;
     IF MessageDlg(' Are You Sure to Deduct ?', mtConfirmation, [mbyes, mbno], 0) = MrNo Then
          Exit;
     ls_DrProcId := Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger;
     ls_Remarks := ' Deduct by Rs ' + Edit_AddedFractAmt.Text + ' Prev Rs. ' + FloatToStr
       (Query_Frct_BreakUp_OfItem.FieldByName('FractionAmount').AsFloat);

     if CB_IsDisPerAppliedforBilling.Checked=True then
     lf_DisPer:=Query_PatientTest.FieldByName('DisPer').AsFloat
     else
     lf_DisPer:=0;

     With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Update Hs_Frde_FractionDetail set Frde_FractionAmount=((Frde_FractionAmount*Frde_Qty)-' + Edit_AddedFractAmt.Text + ')/Frde_Qty ,');
          sql.add(' Frde_FractionRate=Round(((((Frde_FractionAmount*Frde_Qty)-' + Edit_AddedFractAmt.Text + ')/Frde_Qty)/Frde_UnitTestCost)*100,4),');
          sql.add(' Frde_Remarks=' + #39 + ls_Remarks + #39 + ' where Frde_FractionDetailId=' + IntToStr(ls_DrProcId));
          ExecSQL;
     End;
     ShowDoneMessage;
     Get_Frct_BreakUp_OfItem;
     PC_ItemFractionBreak.ActivePageIndex := 0;
     Query_Frct_BreakUp_OfItem.Locate('FractionDetailId', ls_DrProcId, []);
end;

