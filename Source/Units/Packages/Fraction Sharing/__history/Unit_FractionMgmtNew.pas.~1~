                              //if lf_FractionAmtByRate > lf_FractionAmt then
                              //     lf_FractionAmt := lf_FractionAmtByRate;

                              lf_FractionAmt := lf_FractionAmtByRate;

                              { IF lf_UnitTestCost=0 Then
                                lf_FractionAmt:=Query_GetFractionItem.FieldbyName('FractionAmount') .AsFloat;
                                Else
