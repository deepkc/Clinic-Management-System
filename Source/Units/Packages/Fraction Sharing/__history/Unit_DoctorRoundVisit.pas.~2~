          Open;
     End;

     Label_RoundChrg.Caption := FormatFloat('0.00', Query_DocService.FieldByName('VISITCHARGE').AsFloat);
     pf_RoundChrg := Query_DocService.FieldByName('VISITCHARGE').AsFloat;
     pf_RoundChrgVatAmt := Query_DocService.FieldByName('VatAmt').AsFloat;
     pf_DoctorPart := Query_DocService.FieldByName('DoctorPart').AsFloat;
     pf_HosPart := Query_DocService.FieldByName('HospitalPart').AsFloat;

     ps_DocCode := Query_DocService.FieldByName('DocCode').asString;

     Label_DocName.Caption := Query_DocService.FieldByName('DOCNAME').asString;

     b_ActiveResetDocRound := False;

     Edit_AmtMainDoc.SetFocus;
