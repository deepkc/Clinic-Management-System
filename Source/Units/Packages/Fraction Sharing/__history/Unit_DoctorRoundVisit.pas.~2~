Function TForm_DoctorRoundVisit.DivideRoundChrgForMultiDoc: Boolean;
var
     ls_NoOfDoctor: String;
Begin
     ps_TodaysDate := ServerDate.TodaysDate;
     ps_TodaysTime := ServerDate.TodaysTime;

     IF (DBLCB_2ndDoc.KeyValue <> NULL) and (DBLCB_3rdDoc.KeyValue = NULL) Then
          ls_NoOfDoctor := 'Double'
     Else
          ls_NoOfDoctor := 'Multiple';

     With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select Discharged From InpatientReg where InpatientId=' + IntToStr(pi_InpatientId));
          Open;
     End;

     IF Query_Process.FieldByName('Discharged').asString = 'YES' Then
          b_IsDischargePt := true
     Else
          b_IsDischargePt := False;

     Try
          DM_Hospital.Db.StartTransaction;

          Query_DocService_SubDivide.First;
          While Not Query_DocService_SubDivide.EOF do
          Begin
               pf_RoundChrg := Query_DocService_SubDivide.FieldByName('VISITCHARGE').AsFloat;
               pf_RoundChrgVatAmt := Query_DocService_SubDivide.FieldByName('VatAmt').AsFloat;
               pf_DoctorPart := Query_DocService_SubDivide.FieldByName('DoctorPart').AsFloat;
               pf_HosPart := Query_DocService_SubDivide.FieldByName('HospitalPart').AsFloat;

               IF CB_DocAllIncomeDivide.Checked = true Then
               Begin
                    Edit_AmtMainDoc.Text := FloatToStr(RoundingAfterSecondPlace((StrToFloat(Edit_PerMainDoc.Text) * pf_RoundChrg) / 100));
                    Edit_Amt2ndDoc.Text := FloatToStr(RoundingAfterSecondPlace((StrToFloat(Edit_Per2ndDoc.Text) * pf_RoundChrg) / 100));
                    Edit_Amt3rdDoc.Text := FloatToStr(RoundingAfterSecondPlace((StrToFloat(Edit_Per3rdDoc.Text) * pf_RoundChrg) / 100));
               End;

               pi_DOCTORROUNDVISITId := GetMaxId('DOCTORROUNDVISIT', 'DOCTORROUNDVISITId');
               with Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Insert Into DOCTORROUNDVISIT(DOCTORROUNDVISITId,DocCode,PatientID,InPatientId,VisitDate,');
                    sql.add(' NoOfDoctor,DayStatus,VisitCharge,DoctorPart,HospitalPart,VatAmt,DisPer,UserId,');
                    sql.add(' ModifyTime,PatientType,IsUserDefineRate,IsChargeDivide,DivideBy,DivideDate,');
                    sql.add(' RefDocSvrId,BillDate,BillNo,RoomTypeCode) Values(' + IntToStr(pi_DOCTORROUNDVISITId)
                           + ' ,' + #39 + DBLCB_2ndDoc.KeyValue + #39);
                    sql.add(' ,' + IntToStr(pi_PatientId) + ',' + IntToStr(pi_InpatientId));
                    sql.add(' ,' + #39 + Query_DocService_SubDivide.FieldByName('VisitDate')
                           .asString + #39 + ',' + #39 + ls_NoOfDoctor + #39);
                    sql.add(' ,' + #39 + Query_DocService_SubDivide.FieldByName('DayStatus').asString + #39 + ' ,' + Edit_Amt2ndDoc.Text);
                    sql.add(' ,' + FloatToStr((pf_DoctorPart * StrToFloat(Edit_Per2ndDoc.Text)) / 100));
                    sql.add(' ,' + FloatToStr((pf_HosPart * StrToFloat(Edit_Per2ndDoc.Text)) / 100));
                    sql.add(' ,' + FloatToStr(pf_RoundChrgVatAmt * StrToFloat(Edit_Per2ndDoc.Text) / 100));
                    sql.add(' ,' + Query_DocService_SubDivide.FieldByName('DisPer').asString + ' ,' + IntToStr(gi_UserId));
                    sql.add(' ,' + #39 + ps_TodaysTime + #39 + ' ,' + #39 + Query_DocService_SubDivide.FieldByName('PatientType')
                           .asString + #39);
                    // sql.add(' ,'+#39+Query_DocService.Fieldbyname('IsUserDefineRate').AsString+#39);
                    sql.add(' ,''Y''');
                    sql.add(' ,''Y'',' + IntToStr(gi_UserId) + ',' + #39 + ps_TodaysDate + #39);
                    sql.add(' ,' + Query_DocService_SubDivide.FieldByName('DOCTORROUNDVISITId').asString);
                    sql.add(' ,' + #39 + Query_DocService_SubDivide.FieldByName('BillDate').asString + #39);
                    sql.add(' ,' + #39 + Query_DocService_SubDivide.FieldByName('BillNo').asString + #39);
                    sql.add(' ,' + #39 + Query_DocService_SubDivide.FieldByName('RoomTypeCode').asString + #39 + ')');
                    ExecSQL;

                    { Update The Fraction Of Previous One }
                    Close;
                    sql.Clear;
                    sql.add(' Update DOCTORROUNDVISIT Set NoOfDoctor=' + #39 + ls_NoOfDoctor + #39 + ',VisitCharge=' +
                           Edit_AmtMainDoc.Text);
                    sql.add(' ,VatAmt=' + FloatToStr((pf_RoundChrgVatAmt * StrToFloat(Edit_PerMainDoc.Text)) / 100));
                    sql.add(' ,HospitalPart=' + FloatToStr((pf_HosPart * StrToFloat(Edit_PerMainDoc.Text)) / 100));
                    sql.add(' ,DoctorPart=' + FloatToStr((pf_DoctorPart * StrToFloat(Edit_PerMainDoc.Text)) / 100));
                    sql.add(' ,DivideDate=' + #39 + ps_TodaysDate + #39 + ',IsChargeDivide=''Y'',DivideBy=' + IntToStr(gi_UserId));
                    sql.add(' ,IsUserDefineRate=''Y'',RefDocSvrId=' + Query_DocService_SubDivide.FieldByName('DOCTORROUNDVISITId')
                           .asString);
                    sql.add(' where DOCTORROUNDVISITId=' + Query_DocService_SubDivide.FieldByName('DOCTORROUNDVISITId').asString);
                    ExecSQL;

                    { Update The Fraction Of Previous One }
                    IF DBLCB_3rdDoc.KeyValue <> NULL Then
                    Begin
                         pi_DOCTORROUNDVISITId := GetMaxId('DOCTORROUNDVISIT', 'DOCTORROUNDVISITId');
                         Close;
                         sql.Clear;
                         sql.add(' Insert Into DOCTORROUNDVISIT(DOCTORROUNDVISITId,DocCode,PatientID,InPatientId,VisitDate,');
                         sql.add(' NoOfDoctor,DayStatus,VisitCharge,DoctorPart,HospitalPart,VatAmt,DisPer,UserId,');
                         sql.add(' ModifyTime,PatientType,IsUserDefineRate,IsChargeDivide,DivideBy,DivideDate,');
                         sql.add(' RefDocSvrId,BillDate,BillNo,RoomTypeCode) Values(' + IntToStr(pi_DOCTORROUNDVISITId)
                                + ' ,' + #39 + DBLCB_3rdDoc.KeyValue + #39);
                         sql.add(' ,' + IntToStr(pi_PatientId) + ',' + IntToStr(pi_InpatientId));
                         sql.add(' ,' + #39 + Query_DocService_SubDivide.FieldByName('VisitDate')
                                .asString + #39 + ',' + #39 + ls_NoOfDoctor + #39);
                         sql.add(' ,' + #39 + Query_DocService_SubDivide.FieldByName('DayStatus')
                                .asString + #39 + ' ,' + Edit_Amt3rdDoc.Text);
                         sql.add(' ,' + FloatToStr((pf_DoctorPart * StrToFloat(Edit_Per3rdDoc.Text)) / 100));
                         sql.add(' ,' + FloatToStr((pf_HosPart * StrToFloat(Edit_Per3rdDoc.Text)) / 100));
                         sql.add(' ,' + FloatToStr(pf_RoundChrgVatAmt * StrToFloat(Edit_Per3rdDoc.Text) / 100));
                         sql.add(' ,' + Query_DocService_SubDivide.FieldByName('DisPer').asString + ' ,' + IntToStr(gi_UserId));
                         sql.add(' ,' + #39 + ps_TodaysTime + #39 + ' ,' + #39 + Query_DocService_SubDivide.FieldByName('PatientType')
                                .asString + #39);
                         // sql.add(' ,'+#39+Query_DocService.Fieldbyname('IsUserDefineRate').AsString+#39);
                         sql.add(' ,''Y''');
                         sql.add(' ,''Y'',' + IntToStr(gi_UserId) + ',' + #39 + ps_TodaysDate + #39);
                         sql.add(' ,' + Query_DocService_SubDivide.FieldByName('DOCTORROUNDVISITId').asString);
                         sql.add(' ,' + #39 + Query_DocService_SubDivide.FieldByName('BillDate').asString + #39);
                         sql.add(' ,' + #39 + Query_DocService_SubDivide.FieldByName('BillNo').asString + #39);
                         sql.add(' ,' + #39 + Query_DocService_SubDivide.FieldByName('RoomTypeCode').asString + #39 + ')');
                         ExecSQL;
                    End;
               End;
               Query_DocService_SubDivide.Next;
          End;

          IF b_IsDischargePt = true Then
               RoundCharge_Frct_Post_Medicare_Dynamic;

          DM_Hospital.Db.commit;
          ShowDoneMessage;
          Result := true;
     Except
          DM_Hospital.Db.Rollback;
          MessageDlg('Failure To Save Data. Plz. Contact With System Administrator.', mtWarning, [mbok], 0);
          Result := False;
          Exit;
     End;
End;

