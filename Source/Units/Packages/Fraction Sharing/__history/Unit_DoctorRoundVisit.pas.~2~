Procedure TForm_DoctorRoundVisit.ChangeIPMainDoc;
Begin
     Try
          DM_Hospital.Db.StartTransaction;
          With Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Update InpatientReg Set DocCode=' + #39 + DBLCB_ActualDoc.KeyValue + #39);
               sql.add(' where InpatientId=' + IntToStr(pi_InpatientId));
               ExecSQL;

               Close;
               sql.Clear;
               sql.add(' Insert Into ChangeIPMainDoc_Log(DocChangeLogId,PrevDoc,CurrDoc,ModifyBy,ModifyDate,ModifyTime,');
               sql.add(' InpatientId,IsDocChangeFromParticularDate,DocChangeFromDate)');
               sql.add(' Values (' + IntToStr(GetMaxId('ChangeIPMainDoc_Log', 'DocChangeLogId')));
               sql.add(' ,' + #39 + DBLCB_ExistingDoc.KeyValue + #39 + ',' + #39 + DBLCB_ActualDoc.KeyValue + #39);
               sql.add(' ,' + IntToStr(gi_UserId) + ',' + #39 + ServerDate.TodaysDate + #39 + ',' + #39 + ServerDate.TodaysTime + #39);
               sql.add(' ,' + IntToStr(pi_InpatientId));
               IF CB_ChangeMainDocFromparticualDate.Checked = true Then
                    sql.add(' ,''Y'',' + #39 + DateEditX_DocChangeFrom.Text + #39 + ')')
               Else
                    sql.add(' ,''N'','''')');
               ExecSQL;

               IF (CB_ChangeDoc.Checked = true) and (CB_ChangeMainDocFromparticualDate.Checked = False) Then
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update DOCTORROUNDVISIT Set DocCode=' + #39 + DBLCB_ActualDoc.KeyValue + #39);
                    sql.add(' where InpatientId=' + IntToStr(pi_InpatientId) + ' and DocCode=' + #39 + DBLCB_ExistingDoc.KeyValue + #39);
                    ExecSQL;
               End;

               IF CB_ChangeMainDocFromparticualDate.Checked = true Then
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update DOCTORROUNDVISIT Set DocCode=' + #39 + DBLCB_ActualDoc.KeyValue + #39);
                    sql.add(' where InpatientId=' + IntToStr(pi_InpatientId) + ' and DocCode=' + #39 + DBLCB_ExistingDoc.KeyValue + #39);
                    sql.add(' and VisitDate >=' + #39 + DateEditX_DocChangeFrom.Text + #39);
                    ExecSQL;
               End;
          End;
          DM_Hospital.Db.commit;
          ShowDoneMessage;
     Except
          DM_Hospital.Db.Rollback;
          MessageDlg('Failure To Change Main Doctor.', mtWarning, [mbok], 0);
          Exit;
     End;

     Query_DocService.Close;
     Query_DocService.Open;

     With Query_RoundChrgSummary do
     Begin
          Close;
          ParamByName('InpatientId').AsInteger := pi_InpatientId;
          Open;
     End;
End;

