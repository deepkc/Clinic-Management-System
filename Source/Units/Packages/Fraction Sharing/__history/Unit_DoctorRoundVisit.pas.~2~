procedure TForm_DoctorRoundVisit.SP_ResetChrgDivideClick(Sender: TObject);
begin
     IF Query_DocService.FieldByName('IsChargeDivide').asString = 'N' Then
     Begin
          MessageDlg('Sorry ! You Cannot Reset Round Charge Divide For This Row.', mtWarning, [mbok], 0);
          Exit;
     End;

     IF Query_DocService.FieldByName('IsFractionLocked').asString = 'Y' Then
     Begin
          MessageDlg(' Sorry ! You Cannot Reset Round Charge Divide, Fraction Is Already Locked.', mtWarning, [mbok], 0);
          Exit;
     End;

     IF MessageDlg('Are You Sure To Reset Round Charge Divide.', mtConfirmation, [mbyes, mbno], 0) = mrYes Then
     Begin
          IF CB_ResetAll.Checked = true Then
          Begin
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(
                         ' Select RefDocSvrId,Sum(VisitCharge) as VisitCharge,Sum(VatAmt) as VatAmt,Sum(DoctorPart) as DoctorPart,Sum(HospitalPart) as HospitalPart');
                    sql.add(
                         ' From DOCTORROUNDVISIT where RefDocSvrId In (Select Distinct RefDocSvrId From DOCTORROUNDVISIT where InpatientId=:InpatientId and RefDocSvrId > 0)');
                    sql.add(
                         ' and DOCTORROUNDVISITId not In (Select Distinct RefDocSvrId From DOCTORROUNDVISIT where InpatientId=:InpatientId and RefDocSvrId > 0)');
                    sql.add(' Group by RefDocSvrId Order by RefDocSvrId');
                    ParamByName('InpatientId').AsInteger := pi_InpatientId;
                    Open;
               End;
          End
          Else
          Begin
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(
                         ' Select RefDocSvrId,Sum(VisitCharge) as VisitCharge,Sum(VatAmt) as VatAmt,Sum(DoctorPart) as DoctorPart,Sum(HospitalPart) as HospitalPart');
                    sql.add(' From DOCTORROUNDVISIT where RefDocSvrId=' + IntToStr(Query_DocService.FieldByName('RefDocSvrId').AsInteger));
                    sql.add(' and DOCTORROUNDVISITId<>' + IntToStr(Query_DocService.FieldByName('RefDocSvrId').AsInteger));
                    sql.add(' Group by RefDocSvrId Order by RefDocSvrId');
                    Open;
               End;
          End;

          b_ActiveResetDocRound := true;

          Try
               DM_Hospital.Db.StartTransaction;

               Query_Process.First;
               while not Query_Process.EOF Do
               Begin
                    With Query_SubProcess do
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Update DOCTORROUNDVISIT set VisitCharge=VisitCharge+' + Query_Process.FieldByName('VisitCharge')
                                .asString);
                         sql.add(' ,VatAmt=VatAmt+' + Query_Process.FieldByName('VatAmt').asString);
                         sql.add(' ,DoctorPart=DoctorPart+' + Query_Process.FieldByName('DoctorPart').asString);
                         sql.add(' ,HospitalPart=HospitalPart+' + Query_Process.FieldByName('HospitalPart').asString);
                         sql.add(' ,DivideDate=' + #39 + ServerDate.TodaysDate + #39 + ',IsChargeDivide=''N'',DivideBy=' + IntToStr
                                (gi_UserId));
                         sql.add(' ,RefDocSvrId=0, NoOfDoctor=''Day Consultation''');
                         sql.add(' where DOCTORROUNDVISITId=' + IntToStr(Query_Process.FieldByName('RefDocSvrId').AsInteger));
                         ExecSQL;

                         Close;
                         sql.Clear;
                         sql.add(' Delete From DOCTORROUNDVISIT where RefDocSvrId=' + IntToStr
                                (Query_Process.FieldByName('RefDocSvrId').AsInteger));
                         sql.add(' and DOCTORROUNDVISITId<>' + IntToStr(Query_Process.FieldByName('RefDocSvrId').AsInteger));
                         ExecSQL;
                    End;
                    Query_Process.Next;
               End;

               IF b_IsDischargePt = true Then
               Begin
                    RoundCharge_Frct_Post_Medicare_Dynamic;

                    Remove_Doc_Frct_WhoHaveNoRoundIn_DocSvr_ButExistIn_DrProcedure;

               End;

               DM_Hospital.Db.commit;
               ShowDoneMessage;
          Except
               DM_Hospital.Db.Rollback;
          End;

          Query_DocService.Close;
          Query_DocService.Open;

          With Query_RoundChrgSummary do
          Begin
               Close;
               ParamByName('InpatientId').AsInteger := pi_InpatientId;
               Open;
          End;
     End;
end;

