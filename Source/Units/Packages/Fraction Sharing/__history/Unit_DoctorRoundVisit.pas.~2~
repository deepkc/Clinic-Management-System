procedure TForm_DoctorRoundVisit.BitBtn_SetDiscountClick(Sender: TObject);
begin
     IF Trim(Edit_Percent.Text) = '' Then
          Edit_Percent.Text := '0';

     IF (StrToFloat(Edit_Percent.Text) > 100) or (StrToFloat(Edit_Percent.Text) < 0) Then
     Begin
          MessageDlg('Plz. Check Doctor Part Percent Properly.', mtWarning, [mbok], 0);
          Edit_Percent.SetFocus;
          Exit;
     End;

     IF MessageDlg(' Are You Sure To Cahange Doctor Part.', mtConfirmation, [mbyes, mbno], 0) = mrYes Then
     Begin
          IF CB_All.Checked = False Then
          Begin
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update DOCTORROUNDVISIT Set DoctorPart=VisitCharge*' + Edit_Percent.Text + '/100,');
                    sql.add(' HospitalPart=VisitCharge - VisitCharge*' + Edit_Percent.Text + '/100');
                    sql.add(' where DOCTORROUNDVISITId=' + IntToStr(Query_DocService.FieldByName('DOCTORROUNDVISITId').AsInteger));
                    sql.add(' and NoOfDoctor<>''REFERRAL''');
                    ExecSQL;
               End;
               pi_DOCTORROUNDVISITId := Query_DocService.FieldByName('DOCTORROUNDVISITId').AsInteger;
               Query_DocService.Close;
               Query_DocService.Open;
               Query_DocService.Locate('DOCTORROUNDVISITId', pi_DOCTORROUNDVISITId, []);

               With Query_RoundChrgSummary do
               Begin
                    Close;
                    ParamByName('InpatientId').AsInteger := pi_InpatientId;
                    Open;
               End;
          End
          Else
          Begin
               Query_DocService.First;
               While Not Query_DocService.EOF do
               Begin
                    With Query_Process do
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Update DOCTORROUNDVISIT Set DoctorPart=VisitCharge*' + Edit_Percent.Text + '/100,');
                         sql.add(' HospitalPart=VisitCharge - VisitCharge*' + Edit_Percent.Text + '/100');
                         sql.add(' where DOCTORROUNDVISITId=' + IntToStr(Query_DocService.FieldByName('DOCTORROUNDVISITId').AsInteger));
                         sql.add(' and NoOfDoctor<>''REFERRAL''');
                         ExecSQL;
                    End;
                    Query_DocService.Next;
               End;
               Query_DocService.Close;
               Query_DocService.Open;
               Query_DocService.First;

               With Query_RoundChrgSummary do
               Begin
                    Close;
                    ParamByName('InpatientId').AsInteger := pi_InpatientId;
                    Open;
               End;
          End;
     End;
end;

procedure TForm_DoctorRoundVisit.BitBtn_SetDisPerClick(Sender: TObject);
begin
     if EditDiscount.Text = '' then
     begin
          ShowMessage('Discount Percentage Cannot be Blank !!! ');
          EditDiscount.SetFocus;
          Exit;
     end;

     IF StrToFloat(EditDiscount.Text) > 100 Then
     Begin
          MessageDlg('Percentage Exceeds 100 %', mtWarning, [mbok], 0);
          EditDiscount.SetFocus;
          Exit;
     End;

     With QueryProcess do
     begin
          Close;
          Session:=DM_Hospital.DB;
          sql.Clear;
          sql.add('select * from DOCTORROUNDVISIT where InPatientid = ' + IntToStr(pi_InpatientId));
          if Chk_AllDocDiscount.Checked = true then
               sql.add('and DocCode in (' + #39 + Ps_DisDocCode + ')')
          else
               sql.add(' and DocCode = ' + #39 + DBLCBDisDoctor.KeyValue + #39);
          sql.add(' and VisitDate>=:FromDate and VisitDate<=:ToDate');
          // Sql.SaveToFile('C:\DisDoc.txt');
          ParamByName('FromDate').asString := DateEditXDisFrom.Text;
          ParamByName('ToDate').asString := DateEditXDisTo.Text;
          Open;

          while not EOF do
          begin
               with Query_Process do
               begin
                    Close;
                    DatabaseName := gs_DatabaseName;
                    sql.Clear;
                    sql.add(' Update DOCTORROUNDVISIT set DisPer=' + EditDiscount.Text);
                    IF gs_TaxRule = 'TAD' Then
                         sql.add(' ,VatAmt=(VisitCharge-(VisitCharge*' + EditDiscount.Text + '/100))*' + FloatToStr(gf_TaxPercent)
                                + '/100');
                    sql.add(' where DOCTORROUNDVISITId = ' + IntToStr(QueryProcess.FieldByName('DOCTORROUNDVISITId').AsInteger));
                    ExecSQL;
               end;
               QueryProcess.Next;
          end;
     end;
     Query_DocService.Close;
     Query_DocService.Open;
     PC_DoctorRoundVisit.ActivePageIndex := 0;
     BtnSave.Enabled := true;
end;

procedure TForm_DoctorRoundVisit.BitBtnCancelClick(Sender: TObject);
begin
     IF PC_DoctorRoundVisit.ActivePageIndex = 2 Then
     Begin
          TS_RoundChhrgDivide.TabVisible := False;
          TS_DoctorService.TabVisible := true;
          IF b_IsDischargePt Then
               BtnSave.Enabled := False
          Else
               BtnSave.Enabled := true;
     End
     Else IF PC_DoctorRoundVisit.ActivePageIndex = 1 Then
     Begin
          PC_DoctorRoundVisit.ActivePageIndex := 0;
          IF b_IsDischargePt Then
               BtnSave.Enabled := False
          Else
               BtnSave.Enabled := true;
     End
     Else if PC_DoctorRoundVisit.ActivePageIndex = 3 then
     begin
          PC_DoctorRoundVisit.ActivePageIndex := 0;
          IF b_IsDischargePt Then
               BtnSave.Enabled := False
          Else
          Begin
               BtnSave.Enabled := true;
               SpButtonDelete.Enabled := true;
          End;
          TS_AddInvolvedDoctor.TabVisible := False;
          TS_DoctorService.TabVisible := true;
          TS_ChangeMainDoc.TabVisible := true;
     end
     else if PC_DoctorRoundVisit.ActivePageIndex = 4 then
     begin
          PC_DoctorRoundVisit.ActivePageIndex := 0;
          IF b_IsDischargePt Then
               BtnSave.Enabled := False
          Else
               BtnSave.Enabled := true;
          TS_SetDoctorDiscount.TabVisible := False;
          TS_DoctorService.TabVisible := true;
          TS_ChangeMainDoc.TabVisible := true;
          BtnSave.Enabled := true;
     end
     Else
          Close;
end;

procedure TForm_DoctorRoundVisit.FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
     IF Key = 27 Then
          BitBtnCancelClick(Sender);
     IF PC_DoctorRoundVisit.ActivePageIndex = 0 Then
     Begin
          IF (Key = 13) and (ActiveControl = DateEditX_VisitDate) Then
               DBLCB_VisitDoctor.SetFocus;

          IF (Key = VK_F8) and (SpButtonDelete.Enabled = true) Then
               SpButtonDeleteClick(Sender);

          IF Key = VK_F5 Then
               CB_UserDefineRoundChrg.Checked := Not(CB_UserDefineRoundChrg.Checked);
     End
     Else IF PC_DoctorRoundVisit.ActivePageIndex = 2 Then
     Begin
          IF Key = VK_F1 Then
               CB_DocAllIncomeDivide.Checked := Not(CB_DocAllIncomeDivide.Checked);
          IF Key = VK_F2 Then
               CB_PercentBasis.Checked := Not(CB_PercentBasis.Checked);
     End;

     IF (Key = VK_F12) and (BtnSave.Enabled = true) Then
          BtnSaveClick(Sender);

end;

