                    sql.add(' and Replace(Trim(PM.PatientName),'' '','''') Like ' + #39 + StringReplace
                           (Trim(Edit_Search.Text), ' ', '', [rfReplaceAll]) + '%' + #39);
               sql.add(' and IPD.DisBillBy > 0 Order By IPD.DisBillDate');
                sql.saveToFile('C:\DischargPT.Txt');
               Open;
