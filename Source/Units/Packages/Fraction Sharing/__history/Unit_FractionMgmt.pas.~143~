            sql.add(' and BD.Service='+#39+DBLCB_TestName.KeyValue+#39);

            IF DBLCB_DepName.KeyValue<>NULL Then
            sql.add(' and BD.DepId='+IntToStr(DBLCB_DepName.KeyValue));

            IF CB_FractionableItem.Checked=True Then
            sql.add(' and TN.IsFractionableItem=''Y''');

            sql.add(' and (BillDate >=:FromDate and BillDate<=:ToDate) ');
            sql.add(' Order By  BillDate,BillNo,CrBillNo,BillType');

            ParamByName('FromDate').AsString:=Query_PatientInfo.FieldByName('AdmnDate').AsString;
            IF Query_PatientInfo.FieldByName('DisInDeposit').AsString='Y' Then
            Begin
            IF b_IsDischargePt=True Then
            ParamByName('ToDate').AsString:=Query_PatientInfo.FieldByName('DisDate').AsString
            Else
            //ParamByName('ToDate').AsString:=Query_PatientInfo.FieldByName('DisInDepositDate').AsString;//ServerDate.TodaysDate;
            ParamByName('ToDate').AsString:=ServerDate.TodaysDate;
            End
            Else
            Begin
            IF b_IsDischargePt=True Then
            ParamByName('ToDate').AsString:=Query_PatientInfo.FieldByName('DisDate').AsString
            Else
            ParamByName('ToDate').AsString:=ServerDate.TodaysDate;
            End;
            sql.saveToFile('C:\Frct.Txt');
            Open;
            End;
            DBGridPatientTest.Columns[0].FieldName:='CRMODIFYDATE';
            DBGridPatientTest.Columns[1].FieldName:='CRBILLNO'; }
     End
     Else // OP + Reg
     Begin
          with Query_PatientTest do
          Begin
               Close;
               sql.Clear;
               sql.add(
                    ' Select SBD.sebd_ServiceBillDetailId ServiceBillDetailId,BD.bide_BillDetailId BillDetailId,SBD.sebd_BillDate ServiceDate,SubStr(SBD.sebd_BillTime,1,5) ServiceTime,SBD.sebd_BillNo ServiceBillNo,BD.bide_BillDate billdate,BD.bide_BillNo billno,');
               sql.add(' SBD.sebd_Service service,InitCap(SBD.sebd_ServiceType) ServiceType,SBD.sebd_PatientId patientid,BD.bide_InpatientId inpatientid,BD.bide_DepId depid,BD.bide_PayType paytype,BD.bide_BillType billtype,');
               sql.add(' (Select rede_refundBillNo From hs_rede_RefundDetail where rede_BillDetailID=BD.bide_BillDetailId) as RFBillNo,');
               sql.add(' Case when SBD.sebd_BillDetailId > 0 Then BD.bide_BillType Else SBD.sebd_BillType End BillType,');
               sql.add(' Case when SBD.sebd_BillDetailId > 0 Then BD.bide_DocCode Else SBD.sebd_DocCode End DocCode,');
               sql.add(' Case when SBD.sebd_BillDetailId > 0 Then BD.bide_RefDocCode Else SBD.sebd_RefDocCode End RefDocCode,');
               sql.add(
                    ' (Select doct_DocId From hs_doct_Doctor where doct_DocCode=Case when SBD.sebd_BillDetailId > 0 Then BD.bide_DocCode Else SBD.sebd_DocCode End) as DocId,');
               sql.add(' Round(Case when SBD.sebd_BillDetailId > 0 Then BD.bide_Amount Else SBD.sebd_Amount End,2) Amount,');
               sql.add(' Case when SBD.sebd_BillDetailId > 0 Then BD.bide_Qty Else SBD.sebd_VatAmt End Qty,');
               sql.add(' Round(Case when SBD.sebd_BillDetailId > 0 Then BD.bide_VatAmt Else SBD.sebd_VatAmt End,2) VatAmt,');
               sql.add(' Round(Case when SBD.sebd_BillDetailId > 0 Then BD.bide_DisPer Else SBD.sebd_VatAmt End,2) DisPer,');
               sql.add(
                    ' Round(Case when SBD.sebd_BillDetailId > 0 Then (BD.bide_Amount*BD.bide_Qty*BD.bide_DisPer/100) Else (SBD.sebd_Amount*SBD.sebd_Qty*SBD.sebd_DisPer/100) End,2) Discount,');
               sql.add(
                    'Round(Case when SBD.sebd_BillDetailId > 0 Then ((BD.bide_Amount*BD.bide_Qty)+BD.bide_VatAmt-(BD.bide_Amount*BD.bide_Qty*BD.bide_DisPer/100)) ');
               sql.Add('Else ((SBD.sebd_Amount*SBD.sebd_Qty)+SBD.sebd_VatAmt-(SBD.sebd_Amount*SBD.sebd_Qty*SBD.sebd_DisPer/100)) End,2) NetTotal,');
               sql.add(' (Select UserName From lab_UserMain where UserId=SBD.sebd_BillBy) as UaserName,');
               sql.add(' TN.tena_IsFractionableItem IsFractionableItem,TN.tena_TestNameId TestNameId,');
               sql.add(' Case When (Select Count(rede_RefundDetailID) From hs_rede_RefundDetail where rede_BillDetailId=BD.bide_BillDetailId) > 0 Then ''Y'' Else ''N'' End IsRefund');
               sql.add(' From hs_sebd_ServiceBillDetail SBD,hs_bide_BillDetail BD,hs_tena_TestName TN');
               sql.add(' where SBD.sebd_BillDetailId=BD.bide_BillDetailId(+) and SBD.sebd_Service=TN.tena_TestNameCode(+)');
               sql.add(' and (BD.bide_BillType=''B'' or BD.bide_BillType=''R'') and BD.bide_PatientId=' + IntToStr(pi_PatientId));
               sql.add(' and BD.bide_BillNo=' + #39 + Query_BillList.FieldByName('BillNo').AsString + #39);

               IF CB_FractionableItem.Checked = True Then
                    sql.add(' and ((TN.tena_IsFractionableItem=''Y'' and BD.bide_BillType=''B'') or (BD.bide_BillType=''R''))');

               IF DBLCB_TestName.KeyValue <> NULL Then
                    sql.add(' and BD.bide_Service=' + #39 + DBLCB_TestName.KeyValue + #39);

               IF DBLCB_DepName.KeyValue <> NULL Then
                    sql.add(' and BD.bide_DepId=' + IntToStr(DBLCB_DepName.KeyValue));

               sql.add(' and BD.bide_BillDate >=' + #39 + Query_BillList.FieldByName('BillDate').AsString + #39);
               sql.add(' and BD.bide_BillDate<=' + #39 + Query_BillList.FieldByName('BillDate').AsString + #39);
               sql.add(' Order By  SBD.sebd_ServiceBillDetailId');
               sql.saveToFile('C:\BillService.Txt');
               Open;
          End;
     End;
End;

