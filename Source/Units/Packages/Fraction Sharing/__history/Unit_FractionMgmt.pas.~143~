                    FieldByName('SubTotal').AsFloat := Query_Void.FieldByName('SubTotal').AsFloat + lf_TotMedCharge;
                    FieldByName('SvrTax').AsFloat := Query_Void.FieldByName('SvrTax').AsFloat;
                    FieldByName('NetAmount').AsFloat := Query_Void.FieldByName('NetAmt').AsFloat + lf_TotMedCharge;
                    FieldByName('UserName').AsString := Query_Void.FieldByName('UserName').AsString;
                    Post;
               End;
               Query_Process.Next;
          End;

          { Insert Discharge Cancel Bill }
          With Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select PatientId,InpatientId,PayType,BillNo,Nls_InitCap((Select PatientName From PatientMain where PatientId ');
               sql.add(
                    ' =BillDetail.PatientId)) as PatientName,BillDate,SubStr(BillTime,1,5) as BillTime,Service,ServiceType From BillDetail where ');

               IF CB_GlobalSearch.Checked = False Then
                    sql.add(' BillDate >=' + #39 + DateEditX_FromBillView.Text + #39 + ' and BillDate <=' + #39 +
                           DateEditX_ToBillView.Text + #39)
               Else
               Begin
                    IF b_IsNumeric = True Then
                         sql.add(' (PatientId=' + IntToStr(pi_PatientId) + ' or InpatientId=' + IntToStr(pi_PatientId) + ')')
                    Else
                         sql.add(' BillNo=' + #39 + Edit_Search.Text + #39);
               End;

               sql.add(' and ServiceType=''DISCHARGE CANCEL''');
               Open;
               First;
               while not EOF do
               Begin
                    with TableSalesBookIPOP Do
                    Begin
                         Append;
                         FieldByName('Name').AsString := Query_Process.FieldByName('PatientName')
                           .AsString + '  (  ' + Query_Process.FieldByName('ServiceType').AsString + '  )';
                         FieldByName('InPatientId').AsInteger := Query_Process.FieldByName('InPatientId').AsInteger;
                         FieldByName('PatientId').AsInteger := Query_Process.FieldByName('PatientId').AsInteger;
                         FieldByName('InPatientIdStr').AsString := Query_Process.FieldByName('InPatientId').AsString;
                         FieldByName('PatientIdStr').AsString := Query_Process.FieldByName('PatientId').AsString;
                         FieldByName('BillDate').AsString := Query_Process.FieldByName('BillDate').AsString;
                         FieldByName('BillTime').AsString := Query_Process.FieldByName('BillTime').AsString;
                         FieldByName('BillNo').AsString := Query_Process.FieldByName('BillNo').AsString;
                         FieldByName('PayType').AsString := Query_Process.FieldByName('PayType').AsString;
                         FieldByName('Amount').AsFloat := 0;
                         FieldByName('Discount').AsFloat := 0;
                         FieldByName('SubTotal').AsFloat := 0;
                         FieldByName('SvrTax').AsFloat := 0;
                         FieldByName('NetAmount').AsFloat := 0;
                         Post;
                    End;
                    Query_Process.Next;
               End;
          End;
     End;
End;

