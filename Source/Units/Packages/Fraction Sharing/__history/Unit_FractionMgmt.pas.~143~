procedure TForm_FractionMgmt.SP_ResetChrgDivideClick(Sender: TObject);
begin
     IF Query_Frct_BreakUp_OfItem.FieldByName('IsChargeDivide').AsString = 'N' Then
     Begin
          MessageDlg('Sorry ! You Cannot Reset Fraction Charge Divide For This Row.', mtWarning, [mbok], 0);
          Exit;
     End;

     IF Query_Frct_BreakUp_OfItem.FieldByName('IsFractionLocked').AsString = 'Y' Then
     Begin
          MessageDlg(' Sorry ! You Cannot Edit. Fraction Is Already Locked.', mtWarning, [mbok], 0);
          Exit;
     End;

     IF MessageDlg('Are You Sure To Reset Fraction Charge Divide.', mtConfirmation, [mbyes, mbno], 0) = mrYes Then
     Begin
          With Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select Sum(FRDE_FractionRate) FractionRate, FRDE_PrevFractionRate PrevFractionRate,Sum(FRDE_FractionAmount) as FractionAmount ');
               sql.add(' From HS_FRDE_FractionDetail where FRDE_RefFractionDetailId=' + Query_Frct_BreakUp_OfItem.FieldByName('RefFractionDetailId')
                      .AsString);
               sql.add(' and FRDE_FractionDetailId<>' + Query_Frct_BreakUp_OfItem.FieldByName('RefFractionDetailId').AsString);
               sql.add(' Group By FRDE_PrevFractionRate ');
               Open;
          End;

          Try
               DM_Hospital.Db.StartTransaction;
               With Query_Void do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update hs_FRDE_FractionDetail set FRDE_FractionAmount=FRDE_FractionAmount+' + FloatToStr
                           (Query_Process.FieldByName('FractionAmount').AsFloat));
                    //sql.add(' ,FractionRate=' + FloatToStr(Query_Process.FieldByName('PrevFractionRate').AsFloat));
                    sql.add(' ,FRDE_FractionRate=' + FloatToStr(Query_Process.FieldByName('FractionRate').AsFloat));
                    sql.add(' ,FRDE_FrctModifyDate=' + #39 + ServerDate.TodaysDate + #39 + ',FRDE_IsChargeDivide=''N'',FrctModifyBy=' + IntToStr
                           (gi_UserID));
                    sql.add(' ,FRDE_RefFractionDetailId=0 where FRDE_FractionDetailId=' + IntToStr(Query_Frct_BreakUp_OfItem.FieldByName
                                ('FRDE_RefFractionDetailId').AsInteger));
                    ExecSQL;

                    Close;
                    sql.Clear;
                    sql.add(' Delete From hs_FRDE_FractionDetail where FRDE_RefFractionDetailId=' + IntToStr
                           (Query_Frct_BreakUp_OfItem.FieldByName('RefFractionDetailId').AsInteger));
                    sql.add(' and FRDE_FractionDetailId<>' + IntToStr(Query_Frct_BreakUp_OfItem.FieldByName('RefFractionDetailId').AsInteger));
                    ExecSQL;
               End;

               DM_Hospital.Db.Commit;
               ShowDoneMessage;
          Except
               DM_Hospital.Db.RollBack;
          End;

          Get_Frct_BreakUp_OfItem;
     End;
end;

