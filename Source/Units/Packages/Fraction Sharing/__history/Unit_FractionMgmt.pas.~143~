               IF CB_FractionableItem.Checked = True Then
                    sql.add(' and TN.IsFractionableItem=''Y''');

               IF DBLCB_TestName.KeyValue <> NULL Then
                    sql.add(' and BD.Service=' + #39 + DBLCB_TestName.KeyValue + #39);

               IF DBLCB_DepName.KeyValue <> NULL Then
                    sql.add(' and BD.DepId=' + IntToStr(DBLCB_DepName.KeyValue));

               sql.add(' and BD.BillDate >=' + #39 + Query_BillList.FieldByName('BillDate').AsString + #39);
               sql.add(' and BD.BillDate<=' + #39 + Query_BillList.FieldByName('BillDate').AsString + #39);
               sql.add(' Order By  SBD.ServiceBillDetailId');
               sql.saveToFile('C:\BillService.Txt');
               Open;
          End;

          { with Query_PatientTest do
            Begin
            Close;
            sql.Clear;
            sql.add(' Select BillDetailId,BillNo,CrBillNo,RateType,BillDate,TN.TNCategoryCode,TN.TestNameId,');
            sql.add(' PatientId,InPatientId,PatientTestId,BD.DepId,BillBy,CommunityId,SchemeId,DocCode,(Select UserName From UserMain where ');
            sql.add(' UserId=BD.BillBy) as UserName, BillType,PayType,Service,ServiceType,Qty,Amount as Amount,Qty*Amount as Total,DisPer as DisPer, ');
            sql.add(' VatAmt as SvrTax,(Qty*Amount*DisPer/100) as Discount,((Qty*Amount)-(Qty*Amount*DisPer/100)) as NetTotal,TN.IsFractionableItem, TN.IsOT');
            sql.add(' From BillDetail BD, TestName TN where BD.Service=TN.TestNameCode(+) and CancelStatus=''N''');
            sql.add(' and (BillType=''IP'' or BillType=''A'') and BD.InpatientId='+IntToStr(pi_InpatientId));

            IF b_IsDischargePt=True Then
            sql.add(' And Service<>''BED'' and Service<>''DOCROUND''')
            Else
            sql.add(' and PayType=''CREDIT''');

