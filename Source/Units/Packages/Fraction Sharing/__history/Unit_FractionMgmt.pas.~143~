Procedure TForm_FractionMgmt.Make_UptoDate_LeftFraction;
Var
     li_TotRec, i: Integer;
Begin
     ProgressBar1.Position := 0;
     i := 0;
     li_TotRec := Query_BillList.RecordCount;
     Query_BillList.First;

     CB_FractionableItem.Checked := True;
     while not Query_BillList.EOF do
     Begin
          With Query_Process do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select Distinct bide_BillType billtype From hs_bide_BillDetail where bide_billdetailid not in(select rede_billdetailid from Hs_Rede_refunddetail) and');
               sql.add(' bide_BillNo=' + #39 + Query_BillList.FieldByName('BillNo').AsString + #39);
               Open;
          End;

          IF (Query_Process.FieldByName('BillType').AsString = 'IP') or (Query_Process.FieldByName('BillType').AsString = 'A') Then
          Begin
               ps_BillType := 'IP';
               With Query_PatientInfo do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(
                         ' Select IPR.PatientId,IPR.InpatientId,IPR.AdmnDate,IPR.DisDate,IPR.CommunityId,IPR.SchemeId,MemberNo,DisInDeposit,');
                    sql.add(' (Select PatientName From PatientMain where PatientId=IPR.PatientId) as PtName,DisInDeposit,Discharged, ');
                    sql.add(' (Select SchemeName From Scheme where SchemeId=IPR.SchemeId) as Scheme,DisInDepositDate ');
                    sql.add(' From InpatientReg IPR ');
                    sql.add(' where IPR.InpatientId=' + IntToStr(Query_BillList.FieldByName('InpatientId').AsInteger));
                    Open;
               End;
               pi_PatientId := Query_PatientInfo.FieldByName('PatientId').AsInteger;
               pi_InpatientId := Query_PatientInfo.FieldByName('InPatientId').AsInteger;
          End
          Else
          Begin
               ps_BillType := 'OP';
               With Query_PatientInfo do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Select BD.bide_PatientId patientid,BD.bide_CommunityId communityid,BD.bide_SchemeId schemeid,BD.bide_MemberNo memberno,(Select pama_PatientName From hs_pama_PatientMain ');
                    sql.add
                      (' where pama_PatientId=BD.bide_PatientId) as PtName,(Select SchemeName From Scheme where SchemeId=BD.bide_SchemeId) as Scheme');
                    sql.add(' From hs_bide_BillDetail BD ');
                    sql.add(' where BD.bide_PatientId=' + IntToStr(Query_BillList.FieldByName('PatientId').AsInteger));
                    Open;
               End;
               pi_InpatientId := 0;
               pi_PatientId := Query_PatientInfo.FieldByName('PatientId').AsInteger;
          End;

          Get_Fractionable_TestItem;

          IF Query_PatientTest.RecordCount > 0 Then
          Begin
               Get_Frct_BreakUp_OfItem;
               Load_Fraction_Test;
          End;

          ProgressBar1.Position := Round((i / li_TotRec) * 100);
          Inc(i);
          Query_BillList.Next;
     End;
End;

