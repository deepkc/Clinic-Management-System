procedure TForm_FractionMgmt.SB_SetChangesClick(Sender: TObject);
Var
     ls_DrProcId: Integer;
     lf_UnitTestCost, lf_Qty, lf_NewDocComm, lf_NewFrctPer, lf_FractionRate, lf_FractionAmt: Double;
begin
     IF Query_Frct_BreakUp_OfItem.FieldByName('IsFractionLocked').AsString = 'Y' Then
     Begin
          MessageDlg(' Sorry ! You Cannot Edit. Fraction Is Already Locked.', mtWarning, [mbok], 0);
          Exit;
     End;

     IF CB_ChangeFrctAmt.Checked = False Then
     Begin
          IF DBLCB_ActualDrTech.KeyValue = NULL Then
          Begin
               MessageDlg('Plz. Choose Actual Doctor Or Techinician.', mtInformation, [mbok], 0);
               DBLCB_ActualDrTech.SetFocus;
               Exit;
          End;

          IF (Query_Frct_BreakUp_OfItem.FieldByName('DocCode').AsString = 'FC') or
            (Query_Frct_BreakUp_OfItem.FieldByName('Description').AsString = 'SERVICE') Then
          Begin
               MessageDlg('Sorry ! Service Is Hospital Part So You Cannot Change It.', mtWarning, [mbok], 0);
               DBLCB_ActualDrTech.SetFocus;
               Exit;
          End;

          IF Query_Frct_BreakUp_OfItem.FieldByName('DocID').AsiNTEGER = DBLCB_ActualDrTech.KeyValue Then
          Begin
               MessageDlg('Sorry ! You must have to choose another Doctor Or Techinician.', mtWarning, [mbok], 0);
               DBLCB_ActualDrTech.SetFocus;
               Exit;
          End;

          IF MessageDlg('Are You Sure To Change Doctor Or Techinician ?', mtConfirmation, [mbyes, mbno], 0) = MrNo Then
               Exit;

          Try
               DM_Hospital.Db.StartTransaction;
               With Query_Process do
               Begin
                    Close;
                    Session:=DM_Hospital.DB;
                    sql.Clear;
//                    sql.add(' Update FractionDetail Set DocCode=' + #39 + DBLCB_ActualDrTech.KeyValue + #39);
//                    IF Trim(Query_Frct_BreakUp_OfItem.FieldByName('PrevDocCode').AsString) = '' Then
//                         sql.add(' ,PrevDocCode=DocCode');
//                    sql.add(' where FractionDetailId=' + IntToStr(Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger));

                    sql.add(' Update HS_FRDE_FractionDetail Set FRDE_DociD=' + inttostr(DBLCB_ActualDrTech.KeyValue));
                    IF Trim(Query_Frct_BreakUp_OfItem.FieldByName('PrevDocId').AsString) = '' Then
                         sql.add(' ,FRDE_PrevDocID=frde_DocID');
                    sql.add(' where FRDE_FractionDetailId=' + IntToStr(Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger));

                    ExecSQL;
               End;

               IF { (Query_Frct_BreakUp_OfItem.RecordCount = 1) Or } (CB_MainDoctor.Checked = True) Then
               Begin
                    With Query_Process do
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Update hs_bide_BillDetail Set bide_Docid=' +inttostr( DBLCB_ActualDrTech.KeyValue));
                         //sql.add(' ,DocId=' + IntToStr(Query_ActDoctor.FieldByName('DocId').AsInteger));
                         sql.add(' where bide_BillDetailId=' + Query_PatientTest.FieldByName('BillDetailId').AsString);
                         ExecSQL;
                    End;
               End;

               DM_Hospital.Db.Commit;
               ShowDoneMessage;
          Except
               DM_Hospital.Db.RollBack;
               MessageDlg('Failure To Set Changes.', mtWarning, [mbok], 0);
               Exit;
          End;
     End
     Else
     Begin
          IF Edit_FrctAmt.Text = '' Then
               Edit_FrctAmt.Text := '0';

          IF CB_Per.Checked = True Then
          Begin
               IF {(StrToFloat(Edit_FrctAmt.Text) = 0) or }(StrToFloat(Edit_FrctAmt.Text) > 100) Then
               Begin
                    MessageDlg('Plz. Check Properly Fraction Adjustment Percent(%).', mtWarning, [mbok], 0);
                    Edit_FrctAmt.SetFocus;
                    Exit;
               End;
          End
          Else
          Begin
               IF (StrToFloat(Edit_FrctAmt.Text) = 0) Then
               Begin
                    MessageDlg('Plz. Check Properly Fraction Adjustment Amount.', mtWarning, [mbok], 0);
                    Edit_FrctAmt.SetFocus;
                    Exit;
               End;

               { IF Query_Frct_BreakUp_OfItem.FieldByName('DocCommNet').AsFloat < StrToFloat(Edit_FrctAmt.Text) Then
                 Begin
                 MessageDlg('New Adjustment Is Greater ',mtWarning,[mbok],0);
                 Edit_FrctAmt.SetFocus;
                 Exit;
                 End; }
          End;

          lf_UnitTestCost := Query_Frct_BreakUp_OfItem.FieldByName('UnitTestCost').AsFloat;
          lf_Qty := Query_Frct_BreakUp_OfItem.FieldByName('Qty').AsFloat;

          IF CB_Per.Checked = False Then
          Begin
               lf_NewDocComm := StrToFloat(Edit_FrctAmt.Text) / lf_Qty;
               lf_NewFrctPer := GetNoOfDecimalPartOfFloatNum((lf_NewDocComm / lf_UnitTestCost) * 100, 4);
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update hs_frde_FractionDetail Set frde_FractionAmount=' + FloatToStr(lf_NewDocComm));
                    sql.add(' ,frde_FractionRate=' + FloatToStr(lf_NewFrctPer) + ' where frde_FractionDetailId=' + IntToStr
                           (Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger));
                    ExecSQL;
               End;
               ShowDoneMessage;
          End
          Else
          Begin
               lf_NewDocComm := lf_UnitTestCost * StrToFloat(Edit_FrctAmt.Text) / 100;
               lf_NewFrctPer := StrToFloat(Edit_FrctAmt.Text);
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Update hs_frde_FractionDetail Set frde_FractionAmount=' + FloatToStr(lf_NewDocComm));
                    sql.add(' ,frde_FractionRate=' + FloatToStr(lf_NewFrctPer) + ' where frde_FractionDetailId=' + IntToStr
                           (Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger));
                    ExecSQL;
               End;
               ShowDoneMessage;
          End;
     End;

     CB_MainDoctor.Checked := False;
     ls_DrProcId := Query_Frct_BreakUp_OfItem.FieldByName('FractionDetailId').AsInteger;
     Get_Frct_BreakUp_OfItem;
     Query_Frct_BreakUp_OfItem.Locate('FractionDetailId', ls_DrProcId, []);

     Query_PatientTest.Close;
     Query_PatientTest.Open;
     Query_PatientTest.Locate('BillDetailId', Query_Frct_BreakUp_OfItem.FieldByName('BillDetailId').AsInteger, []);

     Edit_DrTech.Text := Query_Frct_BreakUp_OfItem.FieldByName('DrName').AsString;
     Label_Description.Caption := Query_Frct_BreakUp_OfItem.FieldByName('Description').AsString;
     DBLCB_ActualDrTech.KeyValue := NULL;
end;

