                         sql.add(' And Not Service Is Null Group By BillNo,PatientId,PayType,DisBillBy Order By BillNo');
                         Open;
                    End;

                    { Getting Net medicine(After Medicine Refund) amount }
//                    IF gs_IsIntegratedPharmacy = 'Y' Then
//                         // lf_TotMedCharge:=GetNetMedicineCharge(Query_Process.FieldByName('InPatientId').AsInteger);
//                    Else
                         lf_TotMedCharge := 0;

                    FieldByName('BillDate').AsString := Query_Process.FieldByName('DisBillDate').AsString;
                    FieldByName('BillTime').AsString := Query_Process.FieldByName('BillTime').AsString;
                    FieldByName('BillNo').AsString := Query_Void.FieldByName('BillNo').AsString;
                    FieldByName('PayType').AsString := Query_Void.FieldByName('PayType').AsString;
                    FieldByName('Amount').AsFloat := Query_Void.FieldByName('Amount').AsFloat + lf_TotMedCharge;
