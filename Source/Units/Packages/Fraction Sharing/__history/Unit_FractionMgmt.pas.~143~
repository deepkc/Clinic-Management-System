Procedure TForm_FractionMgmt.Get_Fractionable_TestItem;
Begin
     IF ps_BillType = 'IP' Then
     Begin
          IF Query_PatientInfo.FieldByName('Discharged').AsString = 'Y' Then
               b_IsDischargePt := True
          Else
               b_IsDischargePt := False;

          with Query_PatientTest do
          Begin
               Close;
               sql.Clear;
               sql.add(
                    ' Select SBD.ServiceBillDetailId,BD.BillDetailId,SBD.BillDate ServiceDate,SubStr(SBD.BillTime,1,5) ServiceTime,SBD.BillNo ServiceBillNo,BD.BillDate,BD.BillNo,');
               sql.add(' SBD.Service,InitCap(SBD.ServiceType) ServiceType,SBD.PatientId,BD.InpatientId,BD.DepId,BD.PayType,BD.BillType,');
               sql.add(' (Select BillNo From RefundDetail where BillDetailID=BD.BillDetailId) as RFBillNo,');
               sql.add(' Case when SBD.BillDetailId > 0 Then BD.BillType Else SBD.BillType End BillType,');
               sql.add(' Case when SBD.BillDetailId > 0 Then BD.DocCode Else SBD.DocCode End DocCode,');
               sql.add(' Case when SBD.BillDetailId > 0 Then BD.RefDocCode Else SBD.RefDocCode End RefDocCode,');
               sql.add(
                    ' (Select DocId From Doctor where DocCode=Case when SBD.BillDetailId > 0 Then BD.DocCode Else SBD.DocCode End) as DocId,');
               sql.add(' Round(Case when SBD.BillDetailId > 0 Then BD.Amount Else SBD.Amount End,2) Amount,');
               sql.add(' Case when SBD.BillDetailId > 0 Then BD.Qty Else SBD.VatAmt End Qty,');
               sql.add(' Round(Case when SBD.BillDetailId > 0 Then BD.VatAmt Else SBD.VatAmt End,2) VatAmt,');
               sql.add(' Round(Case when SBD.BillDetailId > 0 Then BD.DisPer Else SBD.VatAmt End,2) DisPer,');
               sql.add(
                    ' Round(Case when SBD.BillDetailId > 0 Then (BD.Amount*BD.Qty*BD.DisPer/100) Else (SBD.Amount*SBD.Qty*SBD.DisPer/100) End,2) Discount,');
               sql.add(
                    ' Round(Case when SBD.BillDetailId > 0 Then ((BD.Amount*BD.Qty)+BD.VatAmt-(BD.Amount*BD.Qty*BD.DisPer/100)) Else ((SBD.Amount*SBD.Qty)+SBD.VatAmt-(SBD.Amount*SBD.Qty*SBD.DisPer/100)) End,2) NetTotal,');
               sql.add(' (Select UserName From lab_UserMain where UserId=SBD.BillBy) as UaserName,');
               sql.add(' TN.IsFractionableItem,TN.IsOT,TN.TestNameId');
               sql.add(' From ServiceBillDetail SBD,BillDetail BD,TestName TN');
               sql.add(' where SBD.BillDetailId=BD.BillDetailId(+) and SBD.Service=TN.TestNameCode(+)');
               sql.add(' and (BD.BillType=''IP'' or BD.BillType=''A'') and BD.InpatientId=' + IntToStr(pi_InpatientId));
