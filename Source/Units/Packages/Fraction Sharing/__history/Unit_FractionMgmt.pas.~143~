procedure TForm_FractionMgmt.FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
     IF Key = 27 Then
          BitBtn2Click(Sender);
     IF b_IsFractModifyActive = False Then
     Begin
          IF (Key = VK_F3) Then
          Begin
               SPB_InvFractionClick(Sender);
               Exit;
          End;

          IF (Key = VK_F4) Then
          Begin
               SPB_RoundFractionClick(Sender);
               Exit;
          End;
     End
     Else IF (b_IsFractModifyActive = True) and (PC_ItemFractionBreak.ActivePageIndex = 0) Then
     Begin
          IF Key = VK_F3 Then
               SB_SetChangesClick(Sender)
          Else IF Key = VK_F4 Then
               SB_ModifyFractionClick(Sender)
          Else IF Key = VK_F5 Then
               SB_SpFractionAddClick(Sender)
          Else IF Key = VK_F6 Then
               SPB_TalliedFractionItemsClick(Sender)
          Else IF Key = VK_F7 Then
               SBDeleteClick(Sender)
          Else IF Key = VK_F8 Then
          Begin
               CB_MainDoctor.Checked := Not(CB_MainDoctor.Checked);
               DBLCB_ActualDrTech.SetFocus;
          End;
     End
     Else IF (b_IsFractModifyActive = True) and (PC_ItemFractionBreak.ActivePageIndex = 1) Then
     Begin
          IF Key = VK_F1 Then
               CB_UserDefineFract.Checked := Not(CB_UserDefineFract.Checked);
          IF Key = VK_F2 Then
               CB_PercentBasis.Checked := Not(CB_PercentBasis.Checked);

          IF Key = VK_F3 Then
               SP_SetSubFractClick(Sender)
          Else IF Key = VK_F4 Then
               SP_Prev1Click(Sender);
     End
     Else IF (b_IsFractModifyActive = True) and (PC_ItemFractionBreak.ActivePageIndex = 2) Then
     Begin
          IF Key = VK_F3 Then
               SPB_SPFractAddClick(Sender);

          IF Key = VK_F4 Then
               BitBtn_DeductClick(Sender);
     End
     Else IF (b_IsFractModifyActive = True) and (PC_ItemFractionBreak.ActivePageIndex = 3) Then
     Begin
          IF Key = VK_F3 Then
               SPB_AdjFrctALClick(Sender);

          IF Key = VK_F4 Then
               SPB_AdjAddClick(Sender);

          IF Key = VK_F5 Then
               BitBtn_AdjDeductionClick(Sender);
     End;

     IF (Key = VK_F9) and (b_IsFractModifyActive = True) Then
          CB_FractionableItem.Checked := Not(CB_FractionableItem.Checked);
end;

procedure TForm_FractionMgmt.BitBtn_FractionUptodateClick(Sender: TObject);
begin
     pb_MutualDocForShare:=False;
     ps_TodaysDate := ServerDate.TodaysDate;
     ps_TodaysTime := ServerDate.TodaysTime;

     IF (RB_IPBill.Checked = True) and (Query_BillList.RecordCount > 0) Then
     Begin
          ProgressBar1.Visible := True;
          pb_ItemWiseBulkFrctUpdate:=True;
          Make_UptoDate_LeftFraction;
          ProgressBar1.Visible := False;
     End
     Else IF (RB_OPBill.Checked = True) and (Query_BillList.RecordCount > 0) Then
     Begin
          IF (DBLCB_TestName.KeyValue = NULL) Then
          Begin
               MessageDlg('Plz. Select Test Name First.', mtWarning, [mbok], 0);
               Exit;
          End;

          ProgressBar1.Visible := True;
          pb_ItemWiseBulkFrctUpdate:=True;
          Make_UptoDate_LeftFraction;


          ProgressBar1.Visible := False;
     End;

     if pb_ItemWiseBulkFrctUpdate=True then
     ShowDoneMessage;
     pb_ItemWiseBulkFrctUpdate:=False;
end;

