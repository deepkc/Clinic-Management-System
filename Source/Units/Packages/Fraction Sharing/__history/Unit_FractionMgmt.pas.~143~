{ For The Case Of Doctor Fraction }
Function TForm_FractionMgmt.GetOPDCommession_Medicare: Double;
Begin
     With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select FractionAmount,FractionRate,FractionId,IsRateAmt From Fraction where Description ');
          IF (Query_PatientTest.FieldByName('Service').AsString <> 'EMR01') Then
          Begin
               IF Query_PatientTest.FieldByName('RegChrgWiseCat').AsString = 'A' Then
                    sql.add(' =''OPD REGISTRATION''')
               Else
                    sql.add(' =''OPD REGISTRATION LOW''');
          End
          Else IF (Query_PatientTest.FieldByName('Service').AsString = 'EMR01') Then
          Begin
               IF pb_IsConsultant = True Then
                    sql.add(' =''EMERGENCY CONSULTATION''')
               Else // Duty Doctor
                    sql.add(' =''EMERGENCY DUTY DOCTOR''');
          End;
          sql.add(' and CommType=1');
          Open;

          pi_DocCommId := FieldByName('FractionId').AsInteger;
          IF FieldByName('IsRateAmt').AsString = 'A' Then
               Result := FieldByName('FractionAmount').AsFloat
          Else
               Result := RoundingAfterSecondPlace((Query_PatientTest.FieldByName('Amount').AsFloat * FieldByName('FractionRate').AsFloat)
                      / 100);
     End;
End;

{ For The Case Of Doctor Fraction }
Function TForm_FractionMgmt.GetOPDCommession: Double;
Begin
     With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select FractionAmount,FractionRate,FractionId,IsRateAmt From Fraction where Description ');
          IF (Query_PatientTest.FieldByName('Service').AsString <> 'EMR01') and
            (Query_PatientTest.FieldByName('Service').AsString <> 'COU01') and
            (Query_PatientTest.FieldByName('RateType').AsString <> 'INT') Then
               sql.add(' =''OPD REGISTRATION''')
          Else IF ((Query_PatientTest.FieldByName('Service').AsString = 'EMR01')) Then
          Begin
               IF Query_PatientTest.FieldByName('RateType').AsString <> 'INT' Then
               Begin
                    IF Get_Emr_Day_Night(Query_PatientTest.FieldByName('BillTime').AsString) <> 'NIGHT' Then
                         sql.add(' =''EMERGENCY OPD''')
                    Else
                         sql.add(' =''EMERGENCY NIGHT OPD''');
               End
               Else
               Begin
                    sql.add(' =''OPD INTERNATIONAL EMR''')
               End;
          End
          Else IF Query_PatientTest.FieldByName('RateType').AsString = 'INT' Then
               sql.add(' =''OPD INTERNATIONAL''')
          Else { OPD Counseling }
               sql.add(' =''OPD COUNSEALING''');
          sql.add(' and CommType=1');
          Open;

          pi_DocCommId := FieldByName('FractionId').AsInteger;
          IF FieldByName('IsRateAmt').AsString = 'A' Then
               Result := FieldByName('FractionAmount').AsFloat
          Else
               Result := RoundingAfterSecondPlace((Query_PatientTest.FieldByName('Amount').AsFloat * FieldByName('FractionRate').AsFloat)
                      / 100);
     End;
End;

Function TForm_FractionMgmt.Get_Emr_Day_Night(BillTime: String): String;
Begin
     IF (((BillTime >= '19:00:00') and (BillTime <= '24:60:60')) or ((BillTime >= '01:00:00') and (BillTime < '07:00:00'))) Then
          Result := 'NIGHT'
     Else
          Result := 'DAY';
End;

Procedure TForm_FractionMgmt.Refund_Fraction_Posting(FractionId, PositionWiseFractionId, PatientId, InPatientId, BillDetailId, Service,
     BillNo, RefBillNo: String);
Begin
     With Query_Void do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select Distinct BillDate,BillTime,Qty,BillBy,(Select UserName From lab_UserMain where UserId=BillBy) ');
          sql.add(' UserName From BillDetail where BillNo=' + #39 + RefBillNo + #39 + ' and Service=' + #39 + Service + #39);
          Open;
     End;

     With Query_RefundFrctPost do
     Begin
          Close;
          sql.Clear;
          sql.add(' Update FractionDetail set RFBillNo=' + #39 + RefBillNo + #39);
          sql.add(' ,RefundDate=' + #39 + Query_Void.FieldByName('BillDate').AsString + #39);
          sql.add(' ,RefundTime=' + #39 + Query_Void.FieldByName('BillTime').AsString + #39);
          sql.add(' ,RFQty=' + IntToStr(Query_Void.FieldByName('Qty').AsInteger));
          sql.add(' ,RefundById=' + IntToStr(Query_Void.FieldByName('BillBy').AsInteger));
          sql.add(' ,RefundBy=' + #39 + Query_Void.FieldByName('UserName').AsString + #39);
          sql.add(' where FractionId=' + FractionId + ' and PositionWiseFractionId=' + PositionWiseFractionId);
          sql.add(' and PatientId=' + PatientId + ' and InPatientId=' + InPatientId);
          sql.add(' and BillDetailId=' + BillDetailId + ' and TestNameCode=' + #39 + Service + #39);
          sql.add(' and BillNo=' + #39 + BillNo + #39);
          ExecSQL;
     End;
End;

