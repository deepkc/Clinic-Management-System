procedure TForm_FractionMgmt.SPB_InvFractionClick(Sender: TObject);
begin
     IF Not Query_BillList.Active Then
          Query_BillList.Active := True;

     IF Query_BillList.RecordCount <= 0 Then
     Begin
          MessageDlg('Sorry ! There is no any transaction for modification.', mtInformation, [mbok], 0);
          Exit;
     End;

     With Query_Process do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select Distinct bide_BillType billtype From hs_bide_BillDetail where bide_billdetailid not in(select rede_billdetailid from Hs_Rede_refunddetail) and');
          sql.add(' bide_BillNo=' + #39 + Query_BillList.FieldByName('BillNo').AsString + #39);
          Open;
     End;

     IF (Query_Process.FieldByName('BillType').AsString = 'IP') or (Query_Process.FieldByName('BillType').AsString = 'A') Then
     Begin
          ps_BillType := 'IP';
          With Query_PatientInfo do
          Begin
               Close;
               sql.Clear;
               sql.add
                 (' Select IPR.PatientId,IPR.InpatientId,IPR.AdmnDate,IPR.DisDate,IPR.CommunityId,IPR.SchemeId,MemberNo,DisInDeposit,');
               sql.add(' (Select PatientName From PatientMain where PatientId=IPR.PatientId) as PtName,DisInDeposit,Discharged, ');
               sql.add(' (Select SchemeName From Scheme where SchemeId=IPR.SchemeId) as Scheme,DisInDepositDate,DocCode ');
               sql.add(' From InpatientReg IPR ');
               sql.add(' where IPR.InpatientId=' + IntToStr(Query_BillList.FieldByName('InpatientId').AsInteger));
               Open;
          End;

          pi_InpatientId := Query_BillList.FieldByName('InpatientId').AsInteger;
          pi_PatientId := Query_PatientInfo.FieldByName('PatientId').AsInteger;

          ps_ConsDocCode:=Query_PatientInfo.FieldByName('DocCode').AsString;

          Label_HosNo.Caption := Query_PatientInfo.FieldByName('PatientId').AsString;
          LabelIpNo.Caption := Query_PatientInfo.FieldByName('InpatientId').AsString;
          Labelname.Caption := Query_PatientInfo.FieldByName('PtName').AsString;

          DateEditXIPDate.Enabled := True;
          Button_AdmnDate.Enabled := True;
          LabelAdmnCap.Enabled := True;
          DateEditXIPDate.SystemOfDate := gi_DateSystem;
          DateEditXIPDate.Text := Query_PatientInfo.FieldByName('AdmnDate').AsString;
         // ChangeCaption(Button_AdmnDate);

          DateEditXDisDate.Enabled := True;
          Button_DisDate.Enabled := True;
          LabelDisCap.Enabled := True;
          DateEditXDisDate.SystemOfDate := gi_DateSystem;
          DateEditXDisDate.Text := Query_PatientInfo.FieldByName('DisDate').AsString;
          //ChangeCaption(Button_DisDate);
     End
     Else
     Begin
          ps_BillType := 'OP';
          With Query_PatientInfo do
          Begin
               Close;
               sql.Clear;
               sql.add(' Select distinct BD.bide_PatientId patientid,BD.bide_CommunityId communityid,BD.bide_SchemeId schemeid,BD.bide_MemberNo memberno,(Select pama_PatientName From hs_pama_PatientMain');
               sql.add(' where pama_PatientId=BD.bide_PatientId) as PtName,(Select SchemeName From Scheme where SchemeId=BD.bide_SchemeId) as Scheme');
               sql.add(' From hs_bide_BillDetail BD ');
               sql.add(' where BD.bide_PatientId=' + IntToStr(Query_BillList.FieldByName('PatientId').AsInteger));
               Open;
          End;
          pi_InpatientId := 0;
          pi_PatientId := Query_PatientInfo.FieldByName('PatientId').AsInteger;
          Label_HosNo.Caption := Query_PatientInfo.FieldByName('PatientId').AsString;
          LabelIpNo.Caption := '-';
          Labelname.Caption := Query_PatientInfo.FieldByName('PtName').AsString;

          ps_ConsDocCode:='';

          DateEditXIPDate.Enabled := False;
          Button_AdmnDate.Enabled := False;
          LabelAdmnCap.Enabled := False;

          DateEditXDisDate.Enabled := False;
          Button_DisDate.Enabled := False;
          LabelDisCap.Enabled := False;
     End;

     PC_BillDisplay.SendToBack;
     PC_Investigation.BringToFront;
     b_IsFractModifyActive := True;

     IF Trim(Query_PatientInfo.FieldByName('Scheme').AsString) <> '' Then
          LabelCommunity.Caption := Query_PatientInfo.FieldByName('Scheme').AsString
     Else
          LabelCommunity.Caption := '-------';

     Query_Frct_BreakUp_OfItem.Close;

     Get_Fractionable_TestItem;

     IF (Query_PatientTest.FieldByName('IsFractionableItem').AsString = 'Y') Or (Query_PatientTest.FieldByName('BillType').AsString = 'R')
       Then
          Get_Frct_BreakUp_OfItem;

     BitBtnBillBreakup.Enabled := False;

     PC_ItemFractionBreak.ActivePageIndex := 0;
     EditItemName.Text := Query_PatientTest.FieldByName('ServiceType').AsString;
     EditItemName.SetFocus;
end;

