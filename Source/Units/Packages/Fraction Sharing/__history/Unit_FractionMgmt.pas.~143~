Procedure TForm_FractionMgmt.DisplayCaption;
Begin
     IF CB_PercentBasis.Checked = False Then
     Begin
          Label_AccAmt.Caption := FormatFloat('0.00', StrToFloat(Edit_AmtMainDoc.Text) + StrToFloat(Edit_Amt2ndDoc.Text) + StrToFloat
                 (Edit_Amt3rdDoc.Text));
          pf_TotalAmt := StrToFloat(Label_AccAmt.Caption);

          IF Abs(StrToFloat(Label_RoundChrg.Caption) - StrToFloat(Label_AccAmt.Caption)) <= 0.2 Then
               Label_AccAmt.Caption := Label_RoundChrg.Caption;

          Label_AccPer.Caption := FormatFloat('0.00', (pf_TotalAmt / pf_FractionAmount) * 100);

     End
     Else
     Begin
          Label_AccPer.Caption := FormatFloat('0.00', StrToFloat(Edit_PerMainDoc.Text) + StrToFloat(Edit_Per2ndDoc.Text) + StrToFloat
                 (Edit_Per3rdDoc.Text));
          pf_TotPer := StrToFloat(Label_AccPer.Caption);
          Label_AccAmt.Caption := FormatFloat('0.00', (pf_TotPer * pf_FractionAmount) / 100);

          IF Abs(StrToFloat(Label_RoundChrg.Caption) - StrToFloat(Label_AccAmt.Caption)) <= 0.2 Then
               Label_AccAmt.Caption := Label_RoundChrg.Caption;

          pf_TotalAmt := StrToFloat(Label_AccAmt.Caption);
     End;
End;

