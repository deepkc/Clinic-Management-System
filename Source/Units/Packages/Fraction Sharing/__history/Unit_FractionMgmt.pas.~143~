Procedure TForm_FractionMgmt.Load_Fraction_Test;
Var
     lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, lf_FractionAmt, lf_FractionAmtByRate, lf_FractionRate,
       lf_DisPer: Double;
     ls_DocCode, ls_OldService, ls_GHPKG: String;
     Qry:TOraQuery;
Begin
     Try
          DM_Hospital.Db.StartTransaction;
          ls_OldService := '';
          Qry:=TOraQuery.Create(nil);
          Query_PatientTest.First;
          while not Query_PatientTest.EOF do
          Begin
               IF (Query_PatientTest.FieldByName('BillType').AsString <> 'R') Then
               Begin
                    IF ls_OldService <> Query_PatientTest.FieldByName('Service').AsString Then
                    Begin
                         With Query_GetFractionItem Do
                         Begin
                              Close;
                              sql.Clear;
                              sql.add( ' Select PWC.*,(Select Doct_DocId DocId From Hs_Doct_Doctor where Doct_DocId=PWC.Powf_DocId) as DocId,DC.Frac_DepId DepId,');
                              sql.add('DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE IsFixedAmountDeductOnTestPrice From Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC,Hs_Tena_TestName TN ');
                              sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and DC.Frac_TestNameId=TN.Tena_TestNameId and PWC.Powf_IsActive=''Y'' and ');
                              sql.add(' TN.Tena_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);

                              IF Query_PatientTest.FieldByName('BillType').AsString = 'IP' Then
                                   sql.add(' and Upper(DC.Frac_FractionFor)=''INDOOR''')
                              Else
                                   sql.add(' and Upper(DC.Frac_FractionFor)=''OUTDOOR''');
                               sql.saveToFile('C:\GetFractItem1.Txt');
                              Open;

                              IF RecordCount <= 0 Then
                              Begin
                                   Close;
                                   sql.Clear;
                                   SQL.add(' Select PWC.*,(Select Doct_DocId DocId From Hs_Doct_Doctor where Doct_DocId=PWC.Powf_DocId) as DocId,DC.Frac_DepId DepId,');
                                   sql.add('DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE IsFixedAmountDeductOnTestPrice From Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC,Hs_Tena_TestName TN ');
                                   sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and DC.Frac_TestNameId=TN.Tena_TestNameId and PWC.Powf_IsActive=''Y'' and '
                                     );
                                   sql.add(' TN.Tena_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);

                                   IF Query_PatientTest.FieldByName('BillType').AsString = 'IP' Then
                                        sql.add(' and (Upper(DC.Frac_FractionFor)=''BOTH'' or Upper(DC.Frac_FractionFor)=''INDOOR'')')
                                   Else
                                        sql.add(' and (Upper(DC.Frac_FractionFor)=''BOTH'' or Upper(DC.Frac_FractionFor)=''OUTDOOR'')');
                                  sql.saveToFile('C:\GetFractItem1.Txt');
                                   Open;
                              End;
                         End;
                    End;

                    ls_OldService := Query_PatientTest.FieldByName('Service').AsString;

                    IF Query_GetFractionItem.RecordCount <= 0 Then // Sometime Department Wise Fraction Break Setup Would be there instead of Item wise.
                    Begin
                         With Query_GetFractionItem Do
                         Begin
                              Close;
                              sql.Clear;
                              sql.add(' Select PWC.*,(Select Doct_DocId From Hs_Doct_Doctor where Doct_DocId=PWC.Powf_DocId) as DocID,DC.Frac_DepId DepId,');
                              sql.add('DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE  from Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC');
                              sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and  DC.Frac_DepId=' + Query_PatientTest.FieldByName('DepId')
                                     .AsString);
                              sql.add(' and DC.Frac_TestNameId=0 ');
                              Open;
                              sql.saveToFile('C:\GetFractItem1.Txt');
                         End;
                    End;

                    IF Query_GetFractionItem.RecordCount = 1 Then
                    Begin
                         IF DBLCB_ActualDrTech.KeyValue = NULL Then
                              ls_DocCode := Query_PatientTest.FieldByName('DocCode').AsString
                         Else
                              ls_DocCode := DBLCB_ActualDrTech.KeyValue;
                    End
                    Else
                         ls_DocCode := 'HOS01';

                    b_IsFractionItemNotExist := False;
                    IF ((Query_GetFractionItem.FieldByName('POWF_FRACTIONAMOUNT').AsFloat > 0) or
                           (Query_GetFractionItem.FieldByName('POWF_FRACTIONRATE').AsFloat > 0)) and
                      (Query_Frct_BreakUp_OfItem.FieldByName('FractionAmount').AsFloat = 0) Then
                    Begin
                         With Query_Process do
                         Begin
                              Close;
                              sql.Clear;
                              sql.add(' Delete From Hs_Frde_FractionDetail where Frde_BillDetailId=' + Query_PatientTest.FieldByName('BillDetailId')
                                     .AsString);
                              sql.add(' and Frde_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);
                              sql.add(' and Frde_IsFractionLocked=''N''');
                              ExecSQL;
                         End;
                         b_IsFractionItemNotExist := True;
                    End;

                    pb_MutualDocForShare:=False;
                    //Mutually_Share_Fraction(Query_PatientTest.FieldByName('DocCode').AsString,'OT');
                    //Mutually_Share_Fraction('CRP','OT');

                    Query_GetFractionItem.First;
                    while not Query_GetFractionItem.EOF Do
                    Begin
                         { Check Whether that fraction Break item already exist or not }
                         IF b_IsFractionItemNotExist = False Then
                         Begin
                              With Query_Process do
                              Begin
                                   Close;
                                   sql.Clear;
                                   sql.add(' Select * From Hs_Frde_FractionDetail where Frde_BillDetailId=' + Query_PatientTest.FieldByName
                                        ('BillDetailId').AsString);
                                   sql.add(' and Frde_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);
                                   sql.add(' and Frde_PositionWiseFractionId=' + Query_GetFractionItem.FieldByName('Powf_PositionWiseFractionId').AsString);

                                   Open;
                              End;
                         End
                         Else
                         Begin
                              { Just to make Query_Process Active because below we check Recordcount }
                              With Query_Process do
                              Begin
                                   Close;
                                   sql.Clear;
                                   sql.add(' Select * From Hs_Dept_Department  where Dept_depid=-1');
                                   Open;
                              End;
                         End;

                         IF (Query_Process.RecordCount <= 0) or (b_IsFractionItemNotExist = True) Then
                         Begin
                              lf_UnitTestCost :=Query_PatientTest.FieldByName('Amount').AsFloat;// 0;
                              IF Query_GetFractionItem.FieldByName('Powf_FractionAmount').AsFloat = 0 Then
                              // Undefine Rate in setup (i.e. O amount of item)
                              Begin
                                   lf_UnitTestCost := Query_PatientTest.FieldByName('Amount').AsFloat;
                                   lf_UnitTestCostOrg := Query_PatientTest.FieldByName('Amount').AsFloat;
                              End;

                              lf_FixedAmountDeductOnTestPrice := 0;//Query_GetFractionItem.FieldByName('FixedAmountDeductOnTestPrice').AsFloat;
                              lf_UnitTestCost := lf_UnitTestCost - lf_FixedAmountDeductOnTestPrice;

                              lf_FractionRate := Query_GetFractionItem.FieldByName('Powf_FractionRate').AsFloat;
                              lf_FractionAmt := Query_GetFractionItem.FieldByName('Powf_FractionAmount').AsFloat;
                              lf_FractionAmtByRate := RoundingAfterSecondPlace
                                (lf_UnitTestCost * Query_GetFractionItem.FieldByName('Powf_FractionRate').AsFloat / 100);

                              //if lf_FractionAmtByRate > lf_FractionAmt then
                                   lf_FractionAmt := lf_FractionAmtByRate;

                              { IF lf_UnitTestCost=0 Then
                                lf_FractionAmt:=Query_GetFractionItem.FieldbyName('FractionAmount') .AsFloat;
                                Else
                                lf_FractionAmt:=RoundingAfterSecondPlace(lf_UnitTestCost * Query_GetFractionItem.FieldbyName('FractionRate') .AsFloat / 100); }

                              IF Query_GetFractionItem.FieldByName('Powf_ISFIXEDPERSONFORFRACTION').AsString = 'Y' Then
                                   ls_DocCode := Query_GetFractionItem.FieldByName('powf_DocCode').AsString;

                              IF Query_GetFractionItem.FieldByName('Powf_ISFRACTIONPROPWITHDISPER').AsString = 'Y' Then
                                   lf_DisPer := Query_PatientTest.FieldByName('DisPer').AsFloat
                              Else
                                   lf_DisPer := 0;

                              { SaveFractiondetail(TestNameCode,DocCode,Isoperation,Ischargedivide,Isaddlumpsum,Isfractionpropwithdisper,Iscancel:String;
                                Qty,Disper,Unittestcost,UnittestcostORG,FixedAmountDeductOnTestPrice,Tdsper,Fractionamount,Fractionrate:Double;
                                RefFractionDetailId,Testnameid,Billdetailid,Depid,Patientid,Inpatientid,Docid,Datapostby,FrctModifyBy,Positionwisefractionid,Fractionid:Integer;
                                Billdate,Billno,Billtype,Paytype,Description,Disdate,Datapostdate,Dataposttime,FrctModifyDate,Remarks,Macid:String); }

                              //pb_MutualDocForShare:=True;
                              if pb_MutualDocForShare=False then
                              Begin
                                   SaveFractiondetailNew(Query_PatientTest.FieldByName('Service').AsString, ls_DocCode,
                                        Query_PatientTest.FieldByName('ISOT').AsString, 'N', 'N', Query_GetFractionItem.FieldByName
                                          ('ISFRACTIONPROPWITHDISPER').AsString, 'N', Query_PatientTest.FieldByName('Qty').AsFloat, lf_DisPer,
                                        lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, gf_TDSPercent, lf_FractionAmt, lf_FractionRate,
                                         0, 0, Query_PatientTest.FieldByName('TestNameId').AsInteger,
                                        Query_PatientTest.FieldByName('BillDetailId').AsInteger, Query_PatientTest.FieldByName('DepId')
                                          .AsInteger, Query_PatientTest.FieldByName('PatientId').AsInteger, Query_PatientTest.FieldByName
                                          ('InpatientId').AsInteger, Query_PatientTest.FieldByName('DocId').AsInteger, gi_UserID, 0,
                                        Query_GetFractionItem.FieldByName('PositionWiseFractionId').AsInteger, Query_GetFractionItem.FieldByName
                                          ('FractionId').AsInteger, Query_PatientTest.FieldByName('BillDate').AsString,
                                        Query_PatientTest.FieldByName('BillNo').AsString, Query_PatientTest.FieldByName('BillType').AsString,
                                        Query_PatientTest.FieldByName('PayType').AsString, '', '', ps_TodaysDate, ps_TodaysTime, '', '',
                                        gs_MacID);
                              End
                              Else
                              Begin
                                   Query_MutualDocForShare.First;
                                   While not Query_MutualDocForShare.Eof do
                                   begin
                                        IF Query_MutualDocForShare.FieldByName('DocRate').AsFloat > 0 Then
                                        Begin
                                             SaveFractiondetailNew(Query_PatientTest.FieldByName('Service').AsString, ls_DocCode,
                                                  Query_PatientTest.FieldByName('ISOT').AsString, 'N', 'N', Query_GetFractionItem.FieldByName
                                                    ('ISFRACTIONPROPWITHDISPER').AsString, 'N', Query_PatientTest.FieldByName('Qty').AsFloat, lf_DisPer,
                                                  lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, gf_TDSPercent,
                                                  lf_FractionAmt * Query_MutualDocForShare.FieldByName('DocRate').AsFloat/100,
                                                  lf_FractionRate * Query_MutualDocForShare.FieldByName('DocRate').AsFloat/100,
                                                   0, 0, Query_PatientTest.FieldByName('TestNameId').AsInteger,
                                                  Query_PatientTest.FieldByName('BillDetailId').AsInteger, Query_PatientTest.FieldByName('DepId')
                                                    .AsInteger, Query_PatientTest.FieldByName('PatientId').AsInteger, Query_PatientTest.FieldByName
                                                    ('InpatientId').AsInteger, Query_PatientTest.FieldByName('DocId').AsInteger, gi_UserID, 0,
                                                  Query_GetFractionItem.FieldByName('PositionWiseFractionId').AsInteger, Query_GetFractionItem.FieldByName
                                                    ('FractionId').AsInteger, Query_PatientTest.FieldByName('BillDate').AsString,
                                                  Query_PatientTest.FieldByName('BillNo').AsString, Query_PatientTest.FieldByName('BillType').AsString,
                                                  Query_PatientTest.FieldByName('PayType').AsString, '', '', ps_TodaysDate, ps_TodaysTime, '', '',
                                                  gs_MacID);
                                        End;
                                        Query_MutualDocForShare.Next;
                                   end;
                              End;

                              IF (Query_PatientTest.FieldByName('BillType').AsString = 'B') and
                                (Query_PatientTest.FieldByName('RFBillNo').AsString <>'') Then
                              // IF The Item Is Refunded then refund frct. should post.
                              Begin
                                   {Refund_Fraction_Posting(Query_GetFractionItem.FieldByName('FractionId').AsString,
                                        Query_GetFractionItem.FieldByName('PositionWiseFractionId').AsString, Query_PatientTest.FieldByName
                                        ('PatientId').AsString, Query_PatientTest.FieldByName('InPatientId').AsString,
                                        Query_PatientTest.FieldByName('BillDetailId').AsString, Query_PatientTest.FieldByName('Service')
                                        .AsString, Query_PatientTest.FieldByName('BillNo').AsString, Query_PatientTest.FieldByName
                                        ('RFBillNo').AsString);}
                                   with Qry do
                                   begin
                                        Close;
                                       // DatabaseName:=gs_DatabaseName;
                                        SQL.Clear;
                                        SQL.Add('Select A.*,(Select Rede_RefundDetailId From Hs_Rede_RefundDetail where Rede_BillDetailId=A.Frde_BillDetailId)Rede_RefundDetailId');
                                        SQL.Add('From HS_FRDE_FractionDetail A where FRDE_Billdetailid='+Query_PatientTest.FieldByName('BillDetailId').AsString);
                                        Open;
                                   end;

                                   while not Qry.Eof  do
                                   begin
                                        With Query_Process do
                                        Begin
                                             Close;
                                             sql.Clear;
                                             //DatabaseName:=gs_DatabaseName;
                                             sql.add(' Select FRRD_FRACTIONDETAILID From Hs_Frrd_FractionRefundDetail  where FRRD_FRACTIONDETAILID='+InTToStr(Qry.FieldByName('FRDE_FractionDetailId').AsInteger));
                                             Open;
                                        End;
                                        if Query_Process.fieldByName('FRRD_FRACTIONDETAILID').AsInteger<1 then
                                        begin
                                             SaveRefundFractiondetail(Qry.FieldByName('FRDE_FractionDetailId').AsInteger,Qry.FieldByName('FRDE_PatientId').AsInteger,
                                                  Qry.FieldByName('FRDE_InPatientId').AsInteger,Qry.FieldByName('Rede_RefundDetailId').AsInteger,0,
                                                  Qry.FieldByName('FRDE_DepId').AsInteger,Qry.FieldByName('FRDE_DocID').AsInteger,0,
                                                  Qry.FieldByName('FRDE_FractionId').AsInteger,Qry.FieldByName('FRDE_PositionWiseFractionId').AsInteger,
                                                  Gi_UserId,Qry.FieldByName('FRDE_UnitTestCost').AsFloat,
                                                  Qry.FieldByName('FRDE_Qty').AsFloat,Qry.FieldByName('FRDE_FractionAmount').AsFloat,Qry.FieldByName('FRDE_FractionRate').AsFloat,Qry.FieldByName('FRDE_DisPer').AsFloat,
                                                  Qry.FieldByName('FRDE_TestNameCode').AsString,Gs_BillNo,TOdaysdate,Qry.FieldByName('FRDE_BillType').AsString,
                                                  Qry.FieldByName('FRDE_PayType').AsString,Qry.FieldByName('FRDE_Isfractionpropwithdisper').AsString,'',Qry.FieldByName('FRDE_Isaddlumpsum').AsString,
                                                  Qry.FieldByName('FRDE_Ischargedivide').AsString,'',todaysdate,TodaysTime);


                                        end;
                                        Qry.next;
                                   end;
                              End;
                         End
                         Else
                         Begin
                              IF (Query_PatientTest.FieldByName('BillType').AsString = 'B') and
                                (Query_PatientTest.FieldByName('IsRefund').AsString = 'Y') and
                                (Trim(Query_Process.FieldByName('RFBillNo').AsString) = '') Then
                              // IF The Item Is Refunded then refund frct. should post.
                              Begin
                                  { Refund_Fraction_Posting(Query_GetFractionItem.FieldByName('FractionId').AsString,
                                        Query_GetFractionItem.FieldByName('PositionWiseFractionId').AsString, Query_PatientTest.FieldByName
                                        ('PatientId').AsString, Query_PatientTest.FieldByName('InPatientId').AsString,
                                        Query_PatientTest.FieldByName('BillDetailId').AsString, Query_PatientTest.FieldByName('Service')
                                        .AsString, Query_PatientTest.FieldByName('BillNo').AsString, Query_PatientTest.FieldByName
                                        ('RFBillNo').AsString);    }
                                   with Qry do
                                   begin
                                        Close;
                                        SQL.Clear;
                                        SQL.Add('Select A.*,(Select Rede_RefundDetailId From Hs_Rede_RefundDetail where Rede_BillDetailId=A.Frde_BillDetailId)Rede_RefundDetailId');
                                        SQL.Add('From HS_FRDE_FractionDetail A where FRDE_Billdetailid='+Query_PatientTest.FieldByName('BillDetailId').AsString);
                                        Open;
                                   end;

                                   while not Qry.Eof  do
                                   begin
                                        With Query_Process do
                                        Begin
                                             Close;
                                             sql.Clear;
                                             sql.add(' Select FRRD_FRACTIONDETAILID From Hs_Frrd_FractionRefundDetail  where FRRD_FRACTIONDETAILID='+InTToStr(Qry.FieldByName('FRDE_FractionDetailId').AsInteger));
                                             Open;
                                        End;
                                        if Query_Process.fieldByName('FRRD_FRACTIONDETAILID').AsInteger<1 then
                                        begin
                                             SaveRefundFractiondetail(Qry.FieldByName('FRDE_FractionDetailId').AsInteger,Qry.FieldByName('FRDE_PatientId').AsInteger,
                                             Qry.FieldByName('FRDE_InPatientId').AsInteger,Qry.FieldByName('Rede_RefundDetailId').AsInteger,0,
                                             Qry.FieldByName('FRDE_DepId').AsInteger,Qry.FieldByName('FRDE_DocID').AsInteger,0,
                                             Qry.FieldByName('FRDE_FractionId').AsInteger,Qry.FieldByName('FRDE_PositionWiseFractionId').AsInteger,
                                             Gi_UserId,Qry.FieldByName('FRDE_UnitTestCost').AsFloat,
                                             Qry.FieldByName('FRDE_Qty').AsFloat,Qry.FieldByName('FRDE_FractionAmount').AsFloat,Qry.FieldByName('FRDE_FractionRate').AsFloat,Qry.FieldByName('FRDE_DisPer').AsFloat,
                                             Qry.FieldByName('FRDE_TestNameCode').AsString,Gs_BillNo,TOdaysdate,Qry.FieldByName('FRDE_BillType').AsString,
                                             Qry.FieldByName('FRDE_PayType').AsString,Qry.FieldByName('FRDE_Isfractionpropwithdisper').AsString,'',Qry.FieldByName('FRDE_Isaddlumpsum').AsString,
                                             Qry.FieldByName('FRDE_Ischargedivide').AsString,'',todaysdate,TodaysTime);
                                        end;
                                        Qry.next;
                                   End;
                              End;
                         End;
                         Query_GetFractionItem.Next;
                    End;
               End
               Else
               Begin
                    { Check Whether that fraction Break item already exist or not }
                    With Query_Process do
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Select * From FractionDetail where BillDetailId=' + Query_PatientTest.FieldByName('BillDetailId')
                                .AsString);
                         IF (Query_PatientTest.FieldByName('Service').AsString <> 'GEN') and
                           (Query_PatientTest.FieldByName('Service').AsString <> 'GE2') Then
                              sql.add(' and TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);
                         Open;
                    End;

                    IF Query_Process.RecordCount <= 0 Then
                    Begin
                         IF (Query_PatientTest.FieldByName('Service').AsString = 'GEN') or
                           (Query_PatientTest.FieldByName('Service').AsString = 'GE2') Then
                         Begin
                              With Query_Process do
                              Begin
                                   Close;
                                   sql.Clear;
                                   sql.add(
                                        ' Select PWC.PositionWiseFractionId,PWC.ISFIXEDPERSONFORFRACTION,PWC.ISFRACTIONPROPWITHDISPER,PWC.FractionId,PWC.Name,PWC.IsHospitalPart,');
                                   sql.add(
                                        ' PWC.PositionName,PWC.IsDefaultDoc,PWC.DocCode,PWC.FractionRate,PWC.FractionAmount,DC.IsRateAmt,DC.FractionAmount,PWC.ISCOMPFORFRACTION,');
                                   sql.add(
                                        ' DC.DepId From Fraction DC,PositionWiseFraction PWC where DC.FractionId=PWC.FractionId and PWC.ISACTIVE=''Y''');
                                   IF Query_PatientTest.FieldByName('Service').AsString = 'GEN' Then
                                        sql.add(' and DC.TESTNAMEID=533 ') // 533- General Health Package 1
                                   Else
                                        sql.add(' and DC.TESTNAMEID=534 '); // 533- General Health Package 2
                                   sql.add(' Order By ISFIXEDPERSONFORFRACTION');
                                   Open;

                                   IF Query_PatientTest.FieldByName('Service').AsString = 'GEN' Then
                                        ls_GHPKG := 'GHPK01'
                                   Else
                                        ls_GHPKG := 'GHPK02';

                                   First;
                                   While Not EOF Do
                                   Begin
                                        IF Query_Process.FieldByName('FractionAmount').AsFloat > 0 Then
                                        lf_FractionAmt := Query_Process.FieldByName('FractionAmount').AsFloat
                                        Else
                                        lf_FractionAmt := RoundingAfterSecondPlace
                                        (Query_PatientTest.FieldByName('Amount').AsFloat * Query_Process.FieldByName('FractionRate')
                                        .AsFloat / 100);

                                        SaveFractiondetailNew(Query_PatientTest.FieldByName('Service').AsString, ls_DocCode,
                                        Query_PatientTest.FieldByName('ISOT').AsString, 'N', 'N', Query_GetFractionItem.FieldByName
                                        ('ISFRACTIONPROPWITHDISPER').AsString, 'N', Query_PatientTest.FieldByName('Qty').AsFloat,
                                        lf_DisPer, lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, gf_TDSPercent,
                                        lf_FractionAmt, lf_FractionRate, 0, 0, Query_PatientTest.FieldByName('TestNameId').AsInteger,
                                        Query_PatientTest.FieldByName('BillDetailId').AsInteger, Query_PatientTest.FieldByName('DepId')
                                        .AsInteger, Query_PatientTest.FieldByName('PatientId').AsInteger, Query_PatientTest.FieldByName
                                        ('InpatientId').AsInteger, Query_PatientTest.FieldByName('DocId').AsInteger, gi_UserID, 0,
                                        Query_GetFractionItem.FieldByName('PositionWiseFractionId').AsInteger,
                                        Query_GetFractionItem.FieldByName('FractionId').AsInteger, Query_PatientTest.FieldByName('BillDate')
                                        .AsString, Query_PatientTest.FieldByName('BillNo').AsString, Query_PatientTest.FieldByName
                                        ('BillType').AsString, Query_PatientTest.FieldByName('PayType').AsString, '', '', ps_TodaysDate,
                                        ps_TodaysTime, '', '', gs_MacID);
                                        Query_Process.Next;
                                   End;
                              End;
                         End
                         Else
                              SaveFractiondetailNew(Query_PatientTest.FieldByName('Service').AsString, ls_DocCode,
                                   Query_PatientTest.FieldByName('ISOT').AsString, 'N', 'N', Query_GetFractionItem.FieldByName
                                     ('ISFRACTIONPROPWITHDISPER').AsString, 'N', Query_PatientTest.FieldByName('Qty').AsFloat, lf_DisPer,
                                   lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, gf_TDSPercent, lf_FractionAmt, lf_FractionRate,
                                   0, 0, Query_PatientTest.FieldByName('TestNameId').AsInteger,
                                   Query_PatientTest.FieldByName('BillDetailId').AsInteger, Query_PatientTest.FieldByName('DepId')
                                     .AsInteger, Query_PatientTest.FieldByName('PatientId').AsInteger, Query_PatientTest.FieldByName
                                     ('InpatientId').AsInteger, Query_PatientTest.FieldByName('DocId').AsInteger, gi_UserID, 0,
                                   Query_GetFractionItem.FieldByName('PositionWiseFractionId').AsInteger, Query_GetFractionItem.FieldByName
                                     ('FractionId').AsInteger, Query_PatientTest.FieldByName('BillDate').AsString,
                                   Query_PatientTest.FieldByName('BillNo').AsString, Query_PatientTest.FieldByName('BillType').AsString,
                                   Query_PatientTest.FieldByName('PayType').AsString, '', '', ps_TodaysDate, ps_TodaysTime, '', '',
                                   gs_MacID);
                    End;
               End;
               Query_PatientTest.Next;
          End;
          DM_Hospital.Db.Commit;
          if pb_ItemWiseBulkFrctUpdate=False then
          ShowDoneMessage;
     Except
          DM_Hospital.Db.RollBack;
          MessageDlg('Failure To Make up-to-date Fraction.', mtWarning, [mbok], 0);
          Exit;
     End;
End;

Procedure TForm_FractionMgmt.Load_Fraction_Test_Particular;
Var
     lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, lf_FractionRate, lf_FractionAmt, lf_DisPer: Double;
     ls_DocCode, ls_GHPKG: String;
     li_RefFractionDetailId : Integer;
     qry:TOraQuery;
Begin
     qry:= TOraQuery.Create(nil);
     IF Query_PatientTest.FieldByName('BillType').AsString <> 'R' Then // O - Registration
     Begin
          With Query_GetFractionItem Do
          Begin
               Close;
               sql.Clear;
               sql.add('Select PWC.*,pwc.powf_ISFRACTIONPROPWITHDISPER ISFRACTIONPROPWITHDISPER,pwc.powf_ISFIXEDPERSONFORFRACTION ISFIXEDPERSONFORFRACTION,pwc.powf_positionname positionname,pwc.powf_fractionamount fractionamount,pwc.powf_fractionrate fractionrate');
               sql.Add(',pwc.POWF_POSITIONWISEFRACTIONID POSITIONWISEFRACTIONID,DC.frac_DepId,DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE FixedAmtDeductOnTestPrice,(Select doct_docid From Hs_DOct_Doctor where Doct_DocId=PWC.Powf_DocID) as DocId,frac_fractionid fractionid');
               sql.add(' From Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC,Hs_Tena_TestName TN ');
               sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and DC.frac_TestNameId=TN.Tena_TestNameId and PWC.Powf_IsActive=''Y'' and ');
               sql.add(' TN.Tena_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);

               IF Query_PatientTest.FieldByName('BillType').AsString = 'IP' Then
                    sql.add(' and Upper(DC.Frac_FractionFor)=''INDOOR''')
                    // sql.add(' and (Upper(DC.FractionFor)=''BOTH'' or Upper(DC.FractionFor)=''INDOOR'')')
               Else
                    sql.add(' and Upper(DC.Frac_FractionFor)=''OUTDOOR''');
               // sql.add(' and (Upper(DC.FractionFor)=''BOTH'' or Upper(DC.FractionFor)=''OUTDOOR'')');
                sql.saveToFile('C:\Fract1.Txt');
               Open;

               IF RecordCount <= 0 Then
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Select PWC.*,pwc.powf_ISFRACTIONPROPWITHDISPER ISFRACTIONPROPWITHDISPER,pwc.powf_ISFIXEDPERSONFORFRACTION ISFIXEDPERSONFORFRACTION,pwc.powf_positionname positionname,pwc.powf_fractionamount fractionamount,pwc.powf_fractionrate fractionrate');
                    sql.Add(',pwc.POWF_POSITIONWISEFRACTIONID POSITIONWISEFRACTIONID,DC.Frac_DepId DepId,DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE FixedAmountDeductOnTestPrice,(Select DOct_DOcId From Hs_Doct_Doctor where Doct_DocId=PWC.Powf_DocID) as DocId,frac_fractionid fractionid');
                    sql.add(' From Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC,Hs_Tena_TestName TN ');
                    sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and DC.Frac_TestNameId=TN.Tena_TestNameId and PWC.Powf_IsActive=''Y'' and ');
                    sql.add(' TN.Tena_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);
                    IF Query_PatientTest.FieldByName('BillType').AsString = 'IP' Then
                         sql.add(' and (Upper(DC.Frac_FractionFor)=''BOTH'' or Upper(DC.Frac_FractionFor)=''INDOOR'')')
                    Else
                         sql.add(' and (Upper(DC.Frac_FractionFor)=''BOTH'' or Upper(DC.Frac_FractionFor)=''OUTDOOR'')');
                    sql.saveToFile('C:\Fract2.Txt');
                    Open;
               End;
          End;

          IF Query_GetFractionItem.RecordCount <= 0 Then // Sometime Department Wise Fraction Break Setup Would be there instead of Item wise.
          Begin
               With Query_GetFractionItem Do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(
                         'Select PWC.*,pwc.powf_ISFRACTIONPROPWITHDISPER ISFRACTIONPROPWITHDISPER,pwc.powf_ISFIXEDPERSONFORFRACTION ISFIXEDPERSONFORFRACTION,pwc.powf_positionname positionname,pwc.powf_fractionamount fractionamount,pwc.powf_fractionrate fractionrate');
                    sql.Add(',pwc.POWF_POSITIONWISEFRACTIONID POSITIONWISEFRACTIONID,DC.Frac_DepId DepId,DC.FRAC_FIXEDAMTDEDUCTONTESTPRICE IsFixedAmountDeductOnTestPrice,(Select DOct_DOcId From Hs_Doct_Doctor where Doct_DocId=PWC.Powf_DocID) as DocId');
                    sql.add(' From Hs_Powf_PositionWiseFraction PWC, Hs_Frac_Fraction DC');
                    sql.add(' where PWC.Powf_FractionId = DC.Frac_FractionId and  DC.Frac_DepId=' + Query_PatientTest.FieldByName('DepId').AsString);
                    sql.add(' and  PWC.Powf_IsActive=''Y'' and DC.Frac_TestNameId=0 ');
                    sql.saveToFile('C:\Fract3.Txt');
                    Open;
               End;
          End;

          IF Query_GetFractionItem.RecordCount = 1 Then
          Begin
               IF DBLCB_ActualDrTech.KeyValue = NULL Then
                    ls_DocCode := Query_PatientTest.FieldByName('DocCode').AsString
               Else
                    ls_DocCode := DBLCB_ActualDrTech.KeyValue;
          End
          Else
               ls_DocCode := 'HOS01';

          b_IsFractionItemNotExist := False;
          IF ((Query_GetFractionItem.FieldByName('FractionAmount').AsFloat > 0) or (Query_GetFractionItem.FieldByName('FractionRate')
                      .AsFloat > 0)) and (Query_Frct_BreakUp_OfItem.FieldByName('FractionAmount').AsFloat = 0) Then
          Begin
               With Query_Process do
               Begin
                    Close;
                    sql.Clear;
                    sql.add(' Delete From hs_frde_FractionDetail where frde_BillDetailId=' + Query_PatientTest.FieldByName('BillDetailId').AsString);
                    sql.add(' and frde_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);
                    sql.add(' and frde_IsFractionLocked=''N''');
                    ExecSQL;
               End;
               b_IsFractionItemNotExist := True;
          End;

          Try
               DM_Hospital.Db.StartTransaction;
               if CB_MainDoctor.Checked = True then
               Begin
                    With Query_Process do
                    Begin
                         Close;
                         sql.Clear;
                         sql.add(' Update hs_bide_BillDetail Set bide_Docid=' + #39 + DBLCB_ActualDrTech.KeyValue + #39);
                         //sql.add(' ,DocId=' + IntToStr(Query_ActDoctor.FieldByName('DocId').AsInteger));
                         sql.add(' where bide_BillDetailId=' + Query_PatientTest.FieldByName('BillDetailId').AsString);
                         ExecSQL;
                    End;
               End;

               Query_GetFractionItem.First;
               while not Query_GetFractionItem.EOF Do
               Begin
                    { Check Whether that fraction Break item already exist or not }
                    IF b_IsFractionItemNotExist = False Then
                    Begin
                         With Query_Process do
                         Begin
                              Close;
                              sql.Clear;
                              sql.add(' Select * From hs_frde_FractionDetail where frde_BillDetailId=' + Query_PatientTest.FieldByName('BillDetailId')
                                     .AsString);
                              sql.add(' and frde_TestNameCode=' + #39 + Query_PatientTest.FieldByName('Service').AsString + #39);
                              sql.add(' and frde_PositionWiseFractionId=' + Query_GetFractionItem.FieldByName('PositionWiseFractionId')
                                     .AsString);
                              Open;
                         End;
                    End
                    Else
                    Begin
                         { Just to make Query_Process Active because below we check Recordcount }
                         With Query_Process do
                         Begin
                              Close;
                              sql.Clear;
                              sql.add(' Select * From hs_dept_Department  where dept_depid=-1');
                              Open;
                         End;
                    End;


                    if CB_SetMainConsAsSurgeon.Checked=True then
                    Begin
                         if ((Query_GetFractionItem.FieldByName('PositionName').AsString='DOCTOR') or
                         (Query_GetFractionItem.FieldByName('PositionName').AsString='SURGEON'))
                         and (ls_DocCode='HOS01') then
                         ls_DocCode:=ps_ConsDocCode
                         Else
                         ls_DocCode:='HOS01';
                    End;

                    pb_MutualDocForShare:=False;
                    li_RefFractionDetailId:=0;

                    if CB_CRPGroup.Checked=True then
                    Begin
                         if Query_GetFractionItem.FieldByName('PositionName').AsString<>'ANESTHSIA' then
                         Mutually_Share_Fraction('CRP','OT');
                    End;

                    IF (Query_Process.RecordCount <= 0) or (b_IsFractionItemNotExist = True) Then
                    Begin
                         lf_UnitTestCost := 0;
                         lf_UnitTestCostOrg := Query_PatientTest.FieldByName('Amount').AsFloat;
                        // lf_FixedAmountDeductOnTestPrice := Query_GetFractionItem.FieldByName('FixedAmountDeductOnTestPrice').AsFloat;
                        lf_FixedAmountDeductOnTestPrice:=0;
                         lf_UnitTestCost := Query_PatientTest.FieldByName('Amount').AsFloat - lf_FixedAmountDeductOnTestPrice;

                         lf_FractionRate := Query_GetFractionItem.FieldByName('FractionRate').AsFloat;

                         IF lf_UnitTestCost = 0 Then
                         Begin
                              lf_FractionAmt := Query_GetFractionItem.FieldByName('FractionAmount').AsFloat;
                              IF Query_PatientTest.FieldByName('RateType').AsString = 'FRG' Then
                                   lf_FractionAmt := lf_FractionAmt * 2;
                         End
                         Else
                              lf_FractionAmt := RoundingAfterSecondPlace
                                (lf_UnitTestCost * Query_GetFractionItem.FieldByName('FractionRate').AsFloat / 100);

                         IF Query_GetFractionItem.FieldByName('ISFIXEDPERSONFORFRACTION').AsString = 'Y' Then
                              ls_DocCode := Query_GetFractionItem.FieldByName('DocCode').AsString;

                         if Trim(ls_DocCode) = '' then
                              ls_DocCode := 'HOS01';

                         IF Query_GetFractionItem.FieldByName('ISFRACTIONPROPWITHDISPER').AsString = 'Y' Then
                              lf_DisPer := Query_PatientTest.FieldByName('DisPer').AsFloat
                         Else
                              lf_DisPer := 0;



                         {SaveFractiondetail(TestNameCode,DocCode,Isoperation,Ischargedivide,Isaddlumpsum,Isfractionpropwithdisper,Iscancel:String;
                              Qty,Disper,Unittestcost,UnittestcostORG,FixedAmountDeductOnTestPrice,Tdsper,Fractionamount,Fractionrate,PrevFractionrate:Double;
                              RefFractionDetailId,Testnameid,Billdetailid,Depid,Patientid,Inpatientid,Docid,Datapostby,FrctModifyBy,Positionwisefractionid,Fractionid:Integer;
                              Billdate,Billno,Billtype,Paytype,Description,Disdate,Datapostdate,Dataposttime,FrctModifyDate,Remarks,Macid:String);}

                         if pb_MutualDocForShare=False then
                         Begin
                              {SaveFractiondetailNew(Query_PatientTest.FieldByName('Service').AsString, ls_DocCode, Query_PatientTest.FieldByName
                                    ('ISOT').AsString, 'N', 'N', Query_GetFractionItem.FieldByName('ISFRACTIONPROPWITHDISPER').AsString, 'N',
                                    Query_PatientTest.FieldByName('Qty').AsFloat, Query_PatientTest.FieldByName('DisPer').AsFloat,
                                    lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, gf_TDSPercent, lf_FractionAmt, lf_FractionRate,
                                    0, 0, Query_PatientTest.FieldByName('TestNameId').AsInteger, Query_PatientTest.FieldByName
                                    ('BillDetailId').AsInteger, Query_PatientTest.FieldByName('DepId').AsInteger, Query_PatientTest.FieldByName
                                    ('PatientId').AsInteger, Query_PatientTest.FieldByName('InpatientId').AsInteger,
                                    Query_PatientTest.FieldByName('DocId').AsInteger, gi_UserID,0, Query_GetFractionItem.FieldByName
                                    ('PositionWiseFractionId').AsInteger, Query_GetFractionItem.FieldByName('FractionId').AsInteger,
                                    Query_PatientTest.FieldByName('BillDate').AsString, Query_PatientTest.FieldByName('BillNo').AsString,
                                    Query_PatientTest.FieldByName('BillType').AsString, Query_PatientTest.FieldByName('PayType').AsString, '',
                                    '', ps_TodaysDate, ps_TodaysTime, '', '', gs_MacID); }
                                     SaveFractiondetail(Query_PatientTest.FieldByName('PatientId').AsInteger,Query_PatientTest.FieldByName('InPatientId').AsInteger,
                                   StrToInt64(Query_PatientTest.FieldByName('BillDetailId').AsString),StrToInt64(Query_PatientTest.FieldByName('ServiceBillDetailId').AsString),
                                   Query_PatientTest.FieldByName('DepId').AsInteger,
                                   Query_PatientTest.FieldByName('DocID').AsInteger,Query_PatientTest.FieldByName('TestNameID').AsInteger,
                                   Query_GetFractionItem.FieldByName('Powf_FractionId').AsInteger,
                                   Query_GetFractionItem.FieldByName('POWF_POSITIONWISEFRACTIONID').AsInteger,gi_UserId,0,
                                   lf_UnitTestCost,lf_UnitTestCostOrg,Query_PatientTest.FieldByName('Qty').AsFloat,
                                   lf_FractionAmt,lf_FractionRate,lf_DisPer,
                                   Query_PatientTest.FieldByName('Service').AsString,Query_PatientTest.FieldByName('BillNo').AsString,
                                   Query_PatientTest.FieldByName('BillDate').AsString,
                                   Query_PatientTest.FieldByName('BillType').AsString,Query_PatientTest.FieldByName('PayType').AsString,
                                   'Y','','N','N','',ps_TodaysDate,ps_TodaysTime,Query_GetFractionItem.FieldByName('Powf_IsRevSeparatehead').AsString);


                         End
                         Else
                         Begin
                              Query_MutualDocForShare.First;
                              While not Query_MutualDocForShare.Eof do
                              begin
                                   IF Query_MutualDocForShare.FieldByName('DocRate').AsFloat > 0 Then
                                   Begin
                                        {SaveFractiondetailNew(Query_PatientTest.FieldByName('Service').AsString,Query_MutualDocForShare.FieldByName('DocCode').AsString,
                                              Query_PatientTest.FieldByName('ISOT').AsString, 'N', 'N', Query_GetFractionItem.FieldByName('ISFRACTIONPROPWITHDISPER').AsString, 'N',
                                              Query_PatientTest.FieldByName('Qty').AsFloat, Query_PatientTest.FieldByName('DisPer').AsFloat,
                                              lf_UnitTestCost, lf_UnitTestCostOrg, lf_FixedAmountDeductOnTestPrice, gf_TDSPercent,
                                              lf_FractionAmt * Query_MutualDocForShare.FieldByName('DocRate').AsFloat/100,
                                              lf_FractionRate * Query_MutualDocForShare.FieldByName('DocRate').AsFloat/100,
                                              0, li_RefFractionDetailId, Query_PatientTest.FieldByName('TestNameId').AsInteger, Query_PatientTest.FieldByName
                                              ('BillDetailId').AsInteger, Query_PatientTest.FieldByName('DepId').AsInteger, Query_PatientTest.FieldByName
                                              ('PatientId').AsInteger, Query_PatientTest.FieldByName('InpatientId').AsInteger,
                                              Query_PatientTest.FieldByName('DocId').AsInteger, gi_UserID,0, Query_GetFractionItem.FieldByName
                                              ('PositionWiseFractionId').AsInteger, Query_GetFractionItem.FieldByName('FractionId').AsInteger,
                                              Query_PatientTest.FieldByName('BillDate').AsString, Query_PatientTest.FieldByName('BillNo').AsString,
                                              Query_PatientTest.FieldByName('BillType').AsString, Query_PatientTest.FieldByName('PayType').AsString, '',
                                              '', ps_TodaysDate, ps_TodaysTime, '', '', gs_MacID);  }
                                              SaveFractiondetail(Query_PatientTest.FieldByName('PatientId').AsInteger,Query_PatientTest.FieldByName('InPatientId').AsInteger,
                                             StrToInt64(Query_PatientTest.FieldByName('BillDetailId').AsString),StrToInt64(Query_PatientTest.FieldByName('ServiceBillDetailId').AsString),
                                             Query_PatientTest.FieldByName('DepId').AsInteger,
                                             Query_PatientTest.FieldByName('DocID').AsInteger,Query_PatientTest.FieldByName('TestNameID').AsInteger,
                                             Query_GetFractionItem.FieldByName('Powf_FractionId').AsInteger,
