    Left = 648
    Top = 284
  end
  object Query_samplecollectedright: TOraQuery
    SQL.Strings = (
      
        'select rownum as sno,a.* from (Select Distinct PatientID,Patient' +
        'Name,TestDate,SampleNo,title,agesex,PATIENTTYPE From VW_SAMPLE_C' +
        'OLLECTED'
      'WHERE testdate='#39'2012/07/27'#39
      'AND 99=99'
      'And 99=99'
      'AND 99=99'
      'And 99=99'
      'and 1=1'
      'and 1=1'
      
        'Order by PATIENTNAME--TestDate Desc,to_Number(substr(SampleNo,9)' +
        ')'
      ')a order by sno')
    LockMode = lmLockImmediate
    Options.SetFieldsReadOnly = True
    Options.ExtendedFieldsInfo = True
    AfterScroll = Query_samplecollectedrightAfterScroll
    Left = 136
    Top = 296
  end
