  object Query_ListOfSampleNo: TOraQuery
    SQL.Strings = (
      'SELECT * FROM VW_SAMPLE_COLLECTED'
      'WHERE 99=99'
      'AND 99=99'
      'And 99=99'
      'and 99=99')
    AfterScroll = Query_SampleCollectedAfterScroll
    Left = 496
    Top = 308
  end
