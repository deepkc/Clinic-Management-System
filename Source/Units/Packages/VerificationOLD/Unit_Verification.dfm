  object Query_SampleCollected: TOraQuery
    SQL.Strings = (
      
        'SELECT SC.*,SC.PatientID||'#39'_'#39'||SC.PatientTestID IdentificationNo' +
        ' FROM VW_SAMPLE_COLLECTED SC'
      'WHERE 99=99'
      'AND 99=99'
      'And 99=99'
      'and 99=99'
      'and 99=99'
      'and 99=99'
      'And 1=1'
      'order by sc.patienttestid')
    AfterScroll = Query_SampleCollectedAfterScroll
    Left = 416
    Top = 336
  end
