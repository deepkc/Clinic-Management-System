    pi_Sno:=1;
    pf_NetTotRev:=0;
    pf_CommunityRefund:=0;
    pf_CSDiscount:=0;
    pf_NetCreditRefund:=0;
    pf_Deposit:=0;
    pf_AdjDeposit:=0;
end;

procedure TForm_QRDayWiseRevenueReport.FormShow(Sender: TObject);
begin
     if gs_TaxSystem='VAT' then
     Begin
          QRLabel_SvrTaxCap.Caption:='VAT';
          QRLabel_RefundTaxCap.Caption:='RF VAT';
     End
     Else
     Begin
          QRLabel_SvrTaxCap.Caption:='SVR Tax';
          QRLabel_RefundTaxCap.Caption:='RF SVR Tax';
     End;
end;

procedure TForm_QRDayWiseRevenueReport.QRExpr23Print(
  sender: TObject; var Value: String);
begin
    pf_NetTotRev:=StrToFloat(Value);
    Value:=FormatFloat('#,##0.00',pf_NetTotRev-pf_CommunityRefund);
end;

procedure TForm_QRDayWiseRevenueReport.QRExpr24Print(
  sender: TObject; var Value: String);
