procedure TForm_QRDayWiseRevenueReport.QRLabel8Print(sender: TObject;
  var Value: String);
begin
     Value:=gs_HospitalName;
     if gs_TaxSystem='VAT' then
     Begin
          QRLabel_SvrTaxCap.Left:=685;
          QRLabel_SvrTaxCap.Caption:='VAT';
          QRLabel_RefundTaxCap.Caption:='RF VAT';
     End
     Else
     Begin
          QRLabel_SvrTaxCap.Left:=672;
          QRLabel_SvrTaxCap.Caption:='SVR Tax';
          QRLabel_RefundTaxCap.Caption:='RF SVR Tax';
     End;
end;

procedure TForm_QRDayWiseRevenueReport.QRLabel_HosSloganTitlePrint(sender: TObject;
  var Value: String);
begin
     value:=gs_HosSloganTitle;
     if gs_HosSloganTitle='' then
     Begin
          QRLabel_HosAddress.BringToFront;
          QRLabel_HosAddress.Top:=QRLabel_HosSloganTitle.Top;
     End;
end;

procedure TForm_QRDayWiseRevenueReport.QRLabel_HosAddressPrint(sender: TObject; var Value: String);
