Procedure TForm_DeptTestWiseReport.CreateTableTestWiseDeptWise;
Begin
     IF FileExists(gs_TempPath+'\TestWiseDeptWise.db') Then
     DeleteFile(gs_TempPath+'\TestWiseDeptWise.db');

     With Table_TestWiseDeptWise do
     Begin
          DatabaseName:=gs_TempPath;
          Close;
          TableName:='TestWiseDeptWise.db';
          TableType:=ttDefault;
          FieldDefs.Clear;
          FieldDefs.Add('DepName',ftString,40);
          FieldDefs.Add('PayType',ftString,6);
          FieldDefs.Add('PatientId',ftInteger);
          FieldDefs.Add('InPatientId',ftInteger);
          FieldDefs.Add('PatientName',ftString,100);
          FieldDefs.Add('BillNo',ftString,20);
          FieldDefs.Add('BillDate',ftString,10);
          FieldDefs.Add('BillTime',ftString,12);
          FieldDefs.Add('ServiceType',ftString,50);
          FieldDefs.Add('Amount',ftFloat);
          FieldDefs.Add('Discount',ftFloat);
          FieldDefs.Add('SubTotal',ftFloat);
          FieldDefs.Add('VatAmt',ftFloat);
          FieldDefs.Add('NetAmount',ftFloat);
          FieldDefs.Add('Qty',ftFloat);
          FieldDefs.Add('UserName',ftString,50);
          IndexDefs.Clear;
          CreateTable;
     End;
End;


