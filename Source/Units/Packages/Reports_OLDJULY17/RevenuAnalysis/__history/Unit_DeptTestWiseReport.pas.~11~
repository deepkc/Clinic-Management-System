Procedure TForm_DeptTestWiseReport.PharmacyCharge_TestWise;
Var lf_MDTotal,lf_MDDiscount,Tot_PharCreRefund:Double;
Begin
     With Query_SubProcess Do
     Begin
          Close;
          sql.Clear;
          sql.add(' Select DepName From Department where DepId=28');
          Open;
     End;

     //Pharmacy Credit Refund after the Patient is DisCharge
     //Retrive Those data who are not InPatient and have a Credit Refund
     Tot_PharCreRefund:=0;
     IF (RBOPBill.Checked=False)// And (DateEditX_ToDate.text >= gs_SecManageDate)
     and ((CMBDepartment.KeyValue=NULL) or (CMBDepartment.KeyValue=28)) and
     ((RB_PayTypeBoth.Checked=True) or (RBCredit.Checked=True)) Then // 28 -Pharmacy Department
     Begin
          With Query_Process Do
          Begin
               Close;
               Sql.Clear;
               sql.add(' Select Sum(RD.Qty) as Qty,Sum( Round((RD.Qty*RD.UnitPrice),5)) as Amount,Sum( Round((RD.Qty*RD.UnitPrice) * RD.Discount/100)) as Discount,');
               sql.add(' Sum( Round((RD.Qty*RD.UnitPrice),5)-Round(((RD.Qty*RD.UnitPrice) * RD.Discount/100),5)) as NetTotal ');
               sql.add(' From ReturnMaster RM,ReturnDetail RD where (RM.ReturnMasterId=RD.ReturnMasterId(+))');
               sql.add(' and (RM.ST=''N'') and (RM.Credit1=1) and RM.InPatientID>0 ');
               sql.add(' and RM.ReturnDate>='+#39+DateEditX_FromDate.text+#39);
               sql.add(' and RM.ReturnDate<='+#39+DateEditX_ToDate.text+#39);
               Sql.add(' and (RM.CustomerID < 9999900) AND RM.CustomerID Not In(Select PatientID From InpatientReg ');
               Sql.Add(' Where  (RM.Returndate>=Inptdate and (RM.Returndate<Disdate OR Trim(DisDate) Is Null )) ');
               Sql.Add('     OR (RM.Returndate=DisDate And RM.Rettime<=(Select OutTime From InpatientDetail');
               Sql.Add(' Where InPatientId=InpatientReg.InPatientId and DisBillDate=InpatientReg.DisDate)))');
               //sql.saveToFile('C:\CreditMedRefund.Txt');
               Open;
               IF Query_Process.RecordCount > 0 Then
               Begin
                    First;
                    While Not EOF Do
                    Begin
                         Table_TestWiseBill.Append;
