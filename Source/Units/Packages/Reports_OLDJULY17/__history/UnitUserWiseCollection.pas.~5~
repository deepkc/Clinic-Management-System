     TFormUserWiseCollection = class(TForm)
          StatusBar1: TStatusBar;
          Panel1: TPanel;
          Btn_Preview: TButton;
          Panel2: TPanel;
          Label3: TLabel;
          DBLCB_UserName: TDBLookupComboBox;
          GroupBox1: TGroupBox;
