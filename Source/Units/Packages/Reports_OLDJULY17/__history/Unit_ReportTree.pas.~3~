procedure TForm_ReportTree.TreeView_ReportClick(Sender: TObject);
var SelNode:TTreeNode;
NodeText,lf, ls_childNode,ls_formname:String;
ID:Integer;
begin
     Label1.Visible:=True;
     SelNode := TreeView_Report.Selected;
     NodeText:=Copy(SelNode.text,1,pos('.',SelNode.text)-1);
     PS_START:='END';
     if NodeText='0' then
     begin
          if not SelNode.HasChildren  then
          begin
          with Query_ReportTree do
          begin
               close;
               sql.clear;
               Session:=Dm_Hospital.Db;
               SQL.Add('select distinct repr_Submenuid,(select uasm_captionname from hs_uasm_useraccesssubmenu where uasm_submenuid=hs_repr_reportprevilage.repr_submenuid)captionname from hs_repr_reportprevilage');
               sql.Add('where repr_submenuid in(select distinct hoac_submenuid from hs_hoac_hospitalaccess where hoac_hospitalid='+IntToStr(gi_ReportId)+')');
               SQL.Add('and repr_userid='+IntToStr(gi_UserID));
               SQL.Add('order by repr_submenuid');

              { SQL.Add('SELECT Distinct  Userprevilage.UserId,Userprevilage.SubMenuID,Userprevilage.MenuID, U.SubMenuId,');
               SQL.Add('U.SubMenuname,U.useraccessid,U.CaptionName');
               SQL.Add('FROM UserPrevilage Userprevilage,useraccesssubmenu U,useraccess MM');
               SQL.Add('WHERE (Userprevilage.UserId =:UserID) ');
               SQL.Add('AND  (Userprevilage.SubMenuID = U.SubMenuId)  ');
               SQL.Add('AND  (MM.ACCESSID = U.useraccessid)');
               sql.Add('AND MM.USERACCESS=''ANALYSIS''');
               SQL.Add('order by U.submenuid');       }
               //SQL.Add('select * from useraccesssubmenu order by SubmenuID');
               //SQL.SaveToFile('D:\save.txt');
               //parambyname('userid').asinteger:=gi_userid;

               Open;
          end;

          Query_ReportTree.First;
          while not  Query_ReportTree.eof do
          begin
               ls_childNode:= '1.'+Query_ReportTree.fieldbyname('repr_SubmenuID').asString +' - '+ Query_ReportTree.fieldbyname('CaptionName').asString;

               TreeView_Report.Items.AddChild(SelNode, ls_childNode);
               Query_ReportTree.Next;
          end;
     end;
     end
     else  if NodeText='1' then
     begin
           SelNode := TreeView_Report.Selected;

           NodeText:=Copy(SelNode.text,3,pos(' - ',SelNode.text)-2);
           if not SelNode.HasChildren  then
           begin
               with Query_ReportTree do
               begin
                    close;
                    sql.clear;
                    Session:=Dm_Hospital.Db;
                    SQL.Add('select distinct rm.*,rp.repr_userid,ha.hoac_hospitalid from hs_rome_rootmenu rm,hs_repr_reportprevilage rp,hs_hoac_hospitalaccess ha');
                    sql.Add('where rp.repr_USERID=:userid');
                    SQL.Add('and ha.hoac_hospitalid='+IntToStr(gi_ReportId));
                    SQL.Add('and RM.rome_ROOTMENUID=rp.repr_rootmenuid');
                    SQL.Add('and rm.rome_rootmenuid=ha.hoac_rootmenuid');
                    SQL.Add('and rm.rome_submenuid='+QUOTEDSTR(NodeText));
                    sql.Add('order by rm.rome_rootmenuid');
                    //SQL.Add('and RM.SUBMENUID=RP.SUBMENUID');
                    parambyname('userid').asinteger:=gi_userid;
                    //SQL.SaveToFile('D:\save.txt');
                    //sql.add('select * from rootmenu where submenuid='+qUOTEDSTR(NodeText));
                    Open;
               end;

               Query_ReportTree.First;
               while not  Query_ReportTree.eof do
               begin
                    ls_childNode:='2.'+Query_ReportTree.fieldbyname('rome_RootMenuID').asString +' - '+ Query_ReportTree.fieldbyname('rome_CaptionName').asString;

                    TreeView_Report.Items.AddChild(SelNode, ls_childNode);
                    Query_ReportTree.Next;
               end;
           end;
           if not SelNode.HasChildren then
           begin
               NodeText:=Copy(SelNode.text,pos(' - ',SelNode.text)+3,10);
               ps_Nodetext:=NodeText;
               ReportOpen(sender);
           end;
     end
     else if NodeText='2'  then
     begin
          SelNode := TreeView_Report.Selected;
          NodeText:=Copy(SelNode.text,3,pos('-',SelNode.text)-4);
          ps_nodetext:=Trim(NodeText);
          {with query_blank do
          begin
               close;
               databasename:=gs_databasename;
               sql.clear;
               sql.add('select formname from rootmenu where rootmenuid='+Quotedstr(Nodetext));
               open;
          end;
          ls_formname:=query_blank.FieldByName('Formname').AsString;}
          Label1.Caption:=TreeView_Report.Selected.Text;
          ReportOpen(sender);
     end;
      Label1.Caption:=TreeView_Report.Selected.Text;
end;

procedure TForm_ReportTree.TreeView_ReportCustomDrawItem(
  Sender: TCustomTreeView; Node: TTreeNode; State: TCustomDrawState;
  var DefaultDraw: Boolean);
  var
    fontcolor,Backcolor:TColor;
begin
     FontColor := Sender.Canvas.Font.Color;
     BackColor := clwhite;
     FontColor := clWindowText;

     if ps_start<>'BEGIN' then
     begin
          if Node.Text = (TreeView_Report.Selected).text  then
          begin
               FontColor := clRed;
          end;
     end;

     Sender.Canvas.Font.Color := FontColor;
     DefaultDraw := True;
end;

