procedure TForm_ReportTree.ReportOpen(Sender: TObject);
begin
     if ps_Nodetext='2' then
     FormPendingSampleCollection(Sender)
     else if ps_Nodetext='3' then
     FormSampleCollected(Sender)
     else if ps_Nodetext='5' then
     FormVerifiedSampleCollected(Sender)
     else if ps_Nodetext='4' then
     FormFindingCompleted(Sender)
     else if ps_Nodetext='6' then
     SamplewiseReport1(Sender)
    { else if ps_Nodetext='7' then
     FormWorklist(Sender)            }
     else if ps_Nodetext='101' then
     FormmicrobiologySensitivity(Sender)
     else if ps_Nodetext='300' then
     FormReportToBeDispatched(Sender)
     else if ps_Nodetext='301' then
     FormReportPrinted(Sender)
     else if ps_Nodetext='303' then
     FormpendingForResultEntry(Sender)
    { else if ps_Nodetext='304' then
     FormpendingForAuthentication(Sender)}
     else if ps_Nodetext='206' then
     NoOfTestDone(Sender)
   {  else if ps_Nodetext='203' then
     FormpatientTestList(Sender)
     else if ps_Nodetext='204' then
     FormListOfRefund(Sender)    }
     else if ps_Nodetext='207' then
     FormTestSetupDetail(Sender)
     else if ps_Nodetext='209' then
     FormPatientTestDetail(Sender)
     {else if ps_Nodetext='305' then
     FormTestCancel(Sender);  }
end;

