procedure TForm_SalesBook.BitBtnPreviewClick(Sender: TObject);
var
     New_Query: TOraQuery;
     i: Integer;
     ReportForm: TForm;
     ls_ReportTitle,Ls_particulars: String;
     lf_Tot: Double;
begin
     // IF CheckProperDateRange(DateEditX_FromDate,DateEditX_ToDate)=False Then
     // Begin
     // MessageDlg('Incorrect Date ! '+Char(10)+Char(10)+'       Clue -> Either From Date or To Date.',mtWarning,[mbok],0);
     // Exit;
     // End;
     DateEditX_FromDate.SystemOfDate := gi_datesystem;
     DateEditX_ToDate.SystemOfDate := gi_datesystem;
     BitBtn_FromDate.Caption := gs_DateCaption;
     BitBtn_ToDate.Caption := gs_DateCaption;
     gs_From := DateEditX_FromDate.text;
     gs_to := DateEditX_ToDate.text;
     DateEditX_FromDate.SystemOfDate := 0;
     DateEditX_ToDate.SystemOfDate := 0;
     BitBtn_FromDate.Caption := 'BS';
     BitBtn_ToDate.Caption := 'BS';
     if CHKB_KPL.Checked then
     Begin
          CreateTempTableKPL;
          with Table_SalesBookKpl do
          Begin
               close;
               DatabaseName:=gs_temppath;
               EmptyTable;
               Open;
          End;

          With Query_Process do
          Begin
               close;
               Session:=DM_Hospital.DB;
               sql.Clear;
               Sql.Add('Select Rownum as sn,a.* from (');
               sql.Add('Select billno,(Select BSDATE from NEPALIEQUIVALENTENGLISHDATE where ADDATE=billdetail.billdate)nepalibilldate,');
               sql.Add('billdate,patientid,(select fname||'' ''||Lname from patientmain where patientid=billdetail.patientid)patientname');
               sql.Add(',(select COMMUNITY from COMMUNITY where COMMUNITYid=billdetail.communityid)community,');
               sql.Add('(select SCHEMENAME from scheme where schemeid=billdetail.schemeid)scheme,');
               sql.Add('paytype,disper,sum(amount*qty*disper/100)discount,sum(amount*qty)subtotal,sum(vatamt*qty)Tax,');
               sql.Add('sum((amount*qty-amount*qty*disper/100)+vatamt*qty)grandtotal,(select DOCNAME from doctor where doccode=billdetail.REFDOCCODE)ReferBy,');
               sql.Add('(select username from LAB_USERMAIN where userid=billdetail.BILLBY)entryby,');
               sql.Add('case when paytype=''CASH'' then ''Y'' when paytype=''CREDIT'' then nvl(iscrpaid,''N'') end iscrpaid,');
               SQL.Add('NVL((Select sum(RECEIPTDISCOUNT) from creditpaymentmaster where CRBILLNODETAIL=BillDetail.BillNo and billno like ''CP%''),0)receiptdiscount');
               sql.Add('from billdetail');
               sql.Add('where billdate between '+Quotedstr(gs_From)+' and '+Quotedstr(gs_to));
               if rg.ItemIndex = 0 then
               sql.Add('and paytype=''CASH''')
               else if rg.ItemIndex = 1 then
               sql.Add('and paytype=''CREDIT''');
               sql.Add('group by billno,billdate,patientid,communityid,schemeid,paytype,billby,disper,REFDOCCODE,iscrpaid');
               sql.Add('order by billdate');
               sql.Add(')a');
               //sql.SaveToFile('C:\check.txt');
               Open;
          End;
          Query_Process.First;
          while not Query_Process.Eof do
          Begin
               Ls_particulars:='';
               Table_SalesBookKpl.Append;
               Table_SalesBookKpl.FieldByName('Sno').AsInteger:=Query_Process.FieldByName('Sn').AsInteger;
               Table_SalesBookKpl.FieldByName('LabNo').AsInteger:=Query_Process.FieldByName('patientid').AsInteger;
               Table_SalesBookKpl.FieldByName('BillNo').AsString:=Query_Process.FieldByName('Billno').AsString;
               Table_SalesBookKpl.FieldByName('Nepalibilldate').AsString:=Query_Process.FieldByName('nepalibilldate').AsString;
               Table_SalesBookKpl.FieldByName('BillDate').AsString:=Query_Process.FieldByName('BillDate').AsString;
               Table_SalesBookKpl.FieldByName('PatientName').AsString:=Query_Process.FieldByName('patientname').AsString;
               Table_SalesBookKpl.FieldByName('Paytype').AsString:=Query_Process.FieldByName('Paytype').AsString;
               Table_SalesBookKpl.FieldByName('Scheme').AsString:=Query_Process.FieldByName('Scheme').AsString;
               Table_SalesBookKpl.FieldByName('Community').AsString:=Query_Process.FieldByName('Community').AsString;
               Table_SalesBookKpl.FieldByName('EntryBy').AsString:=Query_Process.FieldByName('EntryBy').AsString;
               Table_SalesBookKpl.FieldByName('ReferedBy').AsString:=Query_Process.FieldByName('ReferBy').AsString;
               Table_SalesBookKpl.FieldByName('SubTotal').AsFloat:=Query_Process.FieldByName('SubTotal').AsFloat;
               Table_SalesBookKpl.FieldByName('Disper').AsFloat:=Query_Process.FieldByName('disper').AsFloat;
               Table_SalesBookKpl.FieldByName('Discount').AsFloat:=Query_Process.FieldByName('Discount').AsFloat;
               Table_SalesBookKpl.FieldByName('Tax').AsFloat:=Query_Process.FieldByName('Tax').AsFloat;
               Table_SalesBookKpl.FieldByName('ReceiptDis').AsFloat:=Query_Process.FieldByName('receiptdiscount').AsFloat;
               Table_SalesBookKpl.FieldByName('NetAmount').AsFloat:=Query_Process.FieldByName('grandtotal').AsFloat;
               Table_SalesBookKpl.FieldByName('Billtype').AsString:='CASH';
               Table_SalesBookKpl.FieldByName('IsCreditPaid').AsString:=Query_Process.FieldByName('iscrpaid').AsString;
               With Query_Subprocess do
               Begin
                    close;
                    Sql.Clear;
                    Session:=DM_Hospital.DB;
                    sql.Add('Select service,servicetype,disper from billdetail');
                    sql.Add('Where billno='+quotedstr(Query_Process.FieldByName('Billno').AsString));
                    sql.Add(' and disper='+Query_Process.FieldByName('disper').AsString);
                    Open;
                    First;
                    while not eof  do
                    Begin
                         {if Ls_particulars='' then
                              Ls_particulars:= Query_Subprocess.FieldByName('Servicetype').AsString
                                                  +'('+Query_Subprocess.FieldByName('disper').AsString+'%)'
                         Else
                              Ls_particulars:=Ls_particulars+','+Query_Subprocess.FieldByName('Servicetype').AsString
                                             +'('+Query_Subprocess.FieldByName('disper').AsString+'%)'; }
                         if Ls_particulars='' then
                              Ls_particulars:= Query_Subprocess.FieldByName('Servicetype').AsString
                         Else
                              Ls_particulars:=Ls_particulars+','+Query_Subprocess.FieldByName('Servicetype').AsString;
                         Next;
                    End;
               End;
               Table_SalesBookKpl.FieldByName('Particulars').AsString:=Ls_particulars;
               Table_SalesBookKpl.Post;
               Query_Process.Next;
          End;

          with Query_Process do
          Begin
               close;
               Session:=DM_Hospital.DB;
               sql.Clear;
               Sql.Add('Select Rownum as sn,a.* from (');
               sql.Add('Select billno,(Select BSDATE from NEPALIEQUIVALENTENGLISHDATE where ADDATE=refunddetail.REFUNDDATE)nepalibilldate,');
               sql.Add('REFUNDDATE as billdate,patientid,(select fname||'' ''||Lname from patientmain where patientid=refunddetail.patientid)patientname');
               sql.Add(',(select COMMUNITY from COMMUNITY where COMMUNITYid=refunddetail.communityid)community,');
               sql.Add('(select SCHEMENAME from scheme where schemeid=refunddetail.schemeid)scheme,');
               sql.Add('paytype,disper,sum(amount*qty*disper/100)discount,sum(amount*qty)subtotal,sum(vatamt*qty)Tax,');
               sql.Add('sum((amount*qty-amount*qty*disper/100)+vatamt*qty)grandtotal,(select DOCNAME from doctor where doccode=refunddetail.REFDOCCODE)ReferBy,');
               sql.Add('(select username from LAB_USERMAIN where userid=refunddetail.REFUNDBY)entryby from refunddetail');
               sql.Add('where REFUNDDATE between '+Quotedstr(gs_From)+' and '+Quotedstr(gs_to));
               sql.Add('group by billno,REFUNDDATE,patientid,communityid,schemeid,paytype,disper,REFUNDBY,REFDOCCODE');
               sql.Add('order by REFUNDDATE');
               sql.Add(')a');
               Open;
          End;
          Query_Process.First;
          while not Query_Process.Eof do
          Begin
               Ls_particulars:='';
               Table_SalesBookKpl.Append;
               Table_SalesBookKpl.FieldByName('Sno').AsInteger:=Query_Process.FieldByName('Sn').AsInteger;
               Table_SalesBookKpl.FieldByName('LabNo').AsInteger:=Query_Process.FieldByName('patientid').AsInteger;
               Table_SalesBookKpl.FieldByName('BillNo').AsString:=Query_Process.FieldByName('Billno').AsString;
               Table_SalesBookKpl.FieldByName('Nepalibilldate').AsString:=Query_Process.FieldByName('nepalibilldate').AsString;
               Table_SalesBookKpl.FieldByName('BillDate').AsString:=Query_Process.FieldByName('BillDate').AsString;
               Table_SalesBookKpl.FieldByName('PatientName').AsString:=Query_Process.FieldByName('patientname').AsString;
               Table_SalesBookKpl.FieldByName('Paytype').AsString:=Query_Process.FieldByName('Paytype').AsString;
               Table_SalesBookKpl.FieldByName('Scheme').AsString:=Query_Process.FieldByName('Scheme').AsString;
               Table_SalesBookKpl.FieldByName('Community').AsString:=Query_Process.FieldByName('Community').AsString;
               Table_SalesBookKpl.FieldByName('EntryBy').AsString:=Query_Process.FieldByName('EntryBy').AsString;
               Table_SalesBookKpl.FieldByName('ReferedBy').AsString:=Query_Process.FieldByName('ReferBy').AsString;
               Table_SalesBookKpl.FieldByName('SubTotal').AsFloat:=Query_Process.FieldByName('SubTotal').AsFloat;
               Table_SalesBookKpl.FieldByName('Disper').AsFloat:=Query_Process.FieldByName('disper').AsFloat;
               Table_SalesBookKpl.FieldByName('Discount').AsFloat:=Query_Process.FieldByName('Discount').AsFloat;
               Table_SalesBookKpl.FieldByName('Tax').AsFloat:=Query_Process.FieldByName('Tax').AsFloat;
               Table_SalesBookKpl.FieldByName('NetAmount').AsFloat:=Query_Process.FieldByName('grandtotal').AsFloat;
               Table_SalesBookKpl.FieldByName('Billtype').AsString:='REFUND';
               With Query_Subprocess do
               Begin
                    close;
                    Sql.Clear;
                    Session:=DM_Hospital.DB;
                    sql.Add('Select (Select billno from billdetail where billdetailid=refunddetail.BILLDETAILID)refundbill,');
                    sql.Add('servicetype,DISPER from refunddetail');
                    sql.Add('Where billno='+quotedstr(Query_Process.FieldByName('Billno').AsString));
                    sql.Add(' and disper='+Query_Process.FieldByName('disper').AsString);
                    Open;
                    First;
                    while not eof  do
                    Begin
                         if Ls_particulars='' then
                              Ls_particulars:= Query_Subprocess.FieldByName('Servicetype').AsString
                         Else
                              Ls_particulars:=Ls_particulars+','+Query_Subprocess.FieldByName('Servicetype').AsString;
                         Next;
                    End;
               End;
               Table_SalesBookKpl.FieldByName('RefBillno').AsString:=Query_Subprocess.FieldByName('refundbill').AsString;
               Table_SalesBookKpl.FieldByName('Particulars').AsString:=Ls_particulars;
               Table_SalesBookKpl.Post;
               Query_Process.Next;
          End;
          With Query_cashsales do
          Begin
               close;
               sql.Clear;
               DatabaseName:=gs_temppath;
               //sql.Add('select Sno,BillNo,nepalibilldate,billdate,LabNo,patientName,paytype,particulars,subtotal,Disper,subtotal-discount as nettotal,tax,ReceiptDis,');
               sql.Add('select Sno,BillNo,nepalibilldate,billdate,LabNo,patientName,paytype,particulars,subtotal,Disper,subtotal-discount as nettotal,tax,');
               sql.Add('NetAmount-ReceiptDis as grandtotal,scheme,community,ReferedBy,entryby,IsCreditPaid from SalesBookKpl.db ');
               sql.Add('Where Billtype=''CASH''');
               Open;
          End;
          With Query_SalesRefund Do
          Begin
               close;
               sql.Clear;
               DatabaseName:=gs_temppath;
               sql.Add('select Sno,billno,nepalibilldate,billdate,LabNo,patientName,paytype,particulars,subtotal,Discount,tax,');
               sql.Add('NetAmount as grandtotal,scheme,community,ReferedBy,entryby,RefBillno as RefundBillno from SalesBookKpl.db ');
               sql.Add('Where Billtype=''REFUND''');
               Open;
          End;

          SendToExcelsMultiQuerykpl(Query_cashsales,Query_SalesRefund,nil,nil,nil,nil,'SALES BOOK','REFUND','','','','',
               Serverdate.TodaysDate,'',gs_hospitalname,gs_hospitaladdress, 2, 10);
          Exit;
     End;

     Govt_Service_Tax_Report_Medicare;

end;

