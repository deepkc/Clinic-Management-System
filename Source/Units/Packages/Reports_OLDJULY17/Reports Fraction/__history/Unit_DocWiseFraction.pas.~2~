                    sql.add(' where billtype=''IP''');
                    sql.add(' and DocCode<>''HOS01'' and DocCode<>''-'' and billdate >='+#39+DateEditX_FromDate.Text+#39);
                    sql.add(' and billdate <='+#39+DateEditX_ToDate.Text+#39);
                    sql.add(' and IsFractionLocked=''N''');
