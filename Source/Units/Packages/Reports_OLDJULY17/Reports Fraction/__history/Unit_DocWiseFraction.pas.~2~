                    sql.add(' where DocCode<>''HOS01'' and DocCode<>''-'' and VisitCharge > 0 and ');
                    sql.add(' VisitDate >='+#39+DateEditX_FromDate.Text+#39+' and VisitDate <='+#39+DateEditX_ToDate.Text+#39);
                    sql.add(' and IsFractionLocked=''N''');
