  object QueryDue: TOraQuery
    SQL.Strings = (
      
        'Select BillNo,BillDATE,GetNepDateFromEng(BillDATE)NepBilldate,Pa' +
        'tientId,(Select FName||'#39' '#39'||MName||'#39' '#39'||LName From patientmain W' +
        'here Patientid=BD.patientid) As PatientName,'
      
        '(Select UserName From Lab_UserMain Where Userid=BD.CRBILLBY) Use' +
        'rName,Sum(qty*Amount) as Total,sum((qty*Amount)*(DISPER/100)) as' +
        ' Discount,'
      
        'Sum(VatAmt) as VatAmt,Sum(((Qty*Amount)+VatAmt)-(Qty*Amount*DISP' +
        'ER/100)) as NetTotal,'
      
        'Nvl((Select Sum(ReceiptAmount) from CreditPaymentMaster where CR' +
        'BILLNODETAIL=BD.BillNo),0)Receipt,'
      
        'Nvl(Sum(((Qty*Amount)+VatAmt)-(Qty*Amount*DISPER/100))-(Select S' +
        'um(ReceiptAmount) from CreditPaymentMaster where CRBILLNODETAIL=' +
        'BD.BillNo),0)Dues,'
      
        '(select nvl(Sum(RECEIPTDISCOUNT),0) from Creditpaymentmaster Whe' +
        're CRBILLNODETAIL=BD.BillNo)ReceiptDiscount,'
      
        'Nvl(((Select Sum(ReceiptAmount) from CreditPaymentMaster where C' +
        'RBILLNODETAIL=BD.BillNo)-(select Sum(RECEIPTDISCOUNT) from credi' +
        'tpaymentmaster Where CRBILLNODETAIL=BD.BillNo)),0)NetReceipt'
      'From BillDetail BD '
      'Where PayType='#39'CREDIT'#39' '
      'And BillNo in(select CrBillnoDetail from creditpaymentmaster)'
      'And BillDate>='#39'2015/01/30'#39' AND BillDate<='#39'2015/02/02'#39
      'And Amount > 0 And (BillNo Like '#39'CR%'#39')'
      'and billdetailid not in(select billdetailid from refunddetail)'
      
        'Group by BillNo,BillDATE,PatientId,InPatientID,Disbillby,CRBILLB' +
        'Y,SchemeID,CommunityID '
      'Order by BillDate,billNo')
    Left = 360
    Top = 61
  end
end
