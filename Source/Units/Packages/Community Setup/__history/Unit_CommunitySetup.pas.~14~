          Begin
               Filter := 'ComCode =' + #39 + EditSearch.Text + '*' + #39 + ' Or Community =' + #39 + EditSearch.Text +
                 '*' + #39;
               Filtered := True;
          End
          Else
               Filtered := False;
     End;
end;

