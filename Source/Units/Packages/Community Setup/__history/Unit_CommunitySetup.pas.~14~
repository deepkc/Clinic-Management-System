procedure TFormCommunity.BitBtnCancelClick(Sender: TObject);
begin
     IF PageControlMedicine.ActivePageIndex = 0 Then
          Close
     Else
     Begin

          PageControlMedicine.ActivePageIndex := 0;
          EditSearch.SetFocus;
          BitBtnSave.Enabled := False;
          BtnNew.Enabled := True;
          QueryCommunity.Close;
          QueryCommunity.Open;
          BtnNew.Enabled := True;
          BitBtnSave.Enabled := False;
     End;
end;

procedure TFormCommunity.BitBtnSaveClick(Sender: TObject);
Var
     ComCode, Community, ContactPerson, Designation, Phone,ls_IsActive:String;
     COMMUNITYID, SchemeId,Priority:Integer;
begin
     If Trim(EditCode.Text) = '' Then
     Begin
          Messagedlg('Plz. enter the community code.', mtInformation, [mbOk], 0);
          EditCommunity.SetFocus;
          Exit;
     End;
     If Trim(EditCommunity.Text) = '' Then
     Begin
          Messagedlg('Plz. enter the community .', mtInformation, [mbOk], 0);
          EditCommunity.SetFocus;
          Exit;
     End;
     ComCode:=EditCode.Text;
     Community:=StringReplace(EditCommunity.Text, '''', '''''', [rfReplaceAll]);
     ContactPerson:=StringReplace(Edit_ContactPerson.Text, '''', '''''', [rfReplaceAll]);
     Designation:=StringReplace( Edit_Designation.Text, '''', '''''', [rfReplaceAll]) ;
     Phone:=Edit_Phone.Text;
     if DBLookupComboBox_Scheme.KeyValue>0 then
     SchemeId:= DBLookupComboBox_Scheme.KeyValue
     else
     SchemeId:=0;
     COMMUNITYID:=pi_communityID;
     Priority:=StrToInt(Edit_Priority.Text);

     if chk_IsActiveCommunity.Checked=True then
     ls_IsActive:='Y'
     else
     ls_IsActive:='N';

     try
          if ltoappend then
               SaveCommunitySetup(ComCode, Community,ls_IsActive,ContactPerson, Designation, Phone, SchemeId, Priority)
          else
               UpdateCommunitySetup(ComCode, Community,ls_IsActive, ContactPerson, Designation, Phone, COMMUNITYID, SchemeId,
                    Priority);
     Except
          MsgBox(1005, 0, '', '', '');
          Exit;
     end;

     ShowDoneMessage;

     ClearAll(PageControlMedicine.Pages[1]);
     ltoappend := True;
     PageControlMedicine.ActivePageIndex:=0;
     QueryCommunity.close;
     QueryCommunity.session:=DM_hospital.db;
     QueryCommunity.open;
end;

