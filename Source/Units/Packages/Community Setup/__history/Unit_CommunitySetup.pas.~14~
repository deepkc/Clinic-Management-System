procedure TFormCommunity.DBGrid1DblClick(Sender: TObject);
begin
     ltoappend := False;

     if QueryCommunity.FieldByName('COMMUNITYID').AsInteger <=0 then
     Begin
          MessageDlg('No Record to Modify !',mtWarning,[mbOK],0);
          EditSearch.SetFocus;
          Exit;
     End;

     PageControlMedicine.ActivePageIndex := 1;
     pi_communityID := QueryCommunity.FieldbyName('CommunityId').AsInteger;

     if Trim(QueryCommunity.FieldbyName('COMCODE').AsString)<>'' then
     Begin
          EditCode.Text := QueryCommunity.FieldbyName('COMCODE').AsString;
          EditCode.ReadOnly:=True;
          EditCode.Color:=clMenu;
     End
     Else
     Begin
          EditCode.ReadOnly:=False;
          EditCode.Color:=clWhite;
     End;

     EditCommunity.Text := QueryCommunity.FieldbyName('COMMUNITY').AsString;
     Edit_ContactPerson.Text := QueryCommunity.FieldbyName('CONTACTPERSON').AsString;
     Edit_Designation.Text := QueryCommunity.FieldbyName('DESIGNATION').AsString;
     Edit_Phone.Text := QueryCommunity.FieldbyName('PHONE').AsString;
     Edit_Priority.Text := IntToStr(QueryCommunity.FieldbyName('PRIORITY').AsInteger);

     if QueryCommunity.FieldbyName('IsActive').AsString='Y' then
     chk_IsActiveCommunity.Checked:=True
     else
     chk_IsActiveCommunity.Checked:=False;

     BtnNew.Enabled := False;
     BitBtnSave.Enabled := True;
end;

