               Label_IPtDis.Caption := FloatToStr(FieldbyName('SCHE_OPBILLDISPER').AsFloat);
               Label_IPtCredit.Caption := FieldbyName('SCHE_ISOPBILLCRFACILITY').AsString;
          End;
     End
     Else
     Begin
          Label_OPtDis.Caption := '.........';
          Label_OPtCredit.Caption := '.........';
          Label_IPtDis.Caption := '.........';
          Label_IPtCredit.Caption := '.........';
     End;
end;

procedure TFormCommunity.EditSearchChange(Sender: TObject);
begin
     EditSearch.Text := StringReplace(EditSearch.Text, '''', '''''', [rfReplaceAll]);
     with QueryCommunity do
     Begin
