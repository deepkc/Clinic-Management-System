  object DataSource_List: TDataSource
    DataSet = Query_list
    Left = 320
    Top = 216
  end
    object Query_list: TOraQuery
    SQL.Strings = (
            
              'SELECT CRM.*,TRIM(PM.PatientName) PatientName , CAST(PM.NonPatie' +
              'ntID AS VARCHAR2(10)) HNo'
            'FROM CreditReceiptMaster CRM, NONPATIENT PM'
            'WHERE CRM.PatientID=PM.NonPatientID'
            'AND CRM.ST=:ST'
            'AND CRM.CounterID=:CounterID'
            'AND CRM.Fyear=:Fyear'
            'Union'
            
              'SELECT CRM.*,TRIM(PM.PatientName) PatientName , CAST(PM.PatientI' +
              'D AS VARCHAR2(10)) HNo'
            'FROM CreditReceiptMaster CRM, PATIENTMAIN PM'
            'WHERE CRM.PatientID=PM.PatientID'
            'AND CRM.ST=:ST'
            'AND CRM.CounterID=:CounterID'
            'AND CRM.Fyear=:Fyear')
    Left = 264
    Top = 216
    ParamData = <
            item
              DataType = ftUnknown
              Name = 'ST'
              ParamType = ptUnknown
            end
            item
              DataType = ftUnknown
              Name = 'CounterID'
              ParamType = ptUnknown
            end
            item
              DataType = ftString
              Name = 'Fyear'
              ParamType = ptUnknown
            end
            item
              DataType = ftUnknown
              Name = 'ST'
              ParamType = ptUnknown
            end
            item
              DataType = ftUnknown
              Name = 'CounterID'
              ParamType = ptUnknown
            end
            item
              DataType = ftString
              Name = 'Fyear'
              ParamType = ptUnknown
            end>
  end
end
