  object QryCreditBill: TQuery
    DatabaseName = 'Hospital'
    SQL.Strings = (
      
        'Select BD.BIDE_PatientId PATIENTID,BD.BIDE_BillNo BILLNO,BD.BIDE' +
        '_BillDate BILLDATE,(Select PAMA_PatientName From HS_PAMA_Patient' +
        'Main where PAMA_PatientId=BD.BIDE_PatientId) as PatientName'
      
        ',BD.BIDE_CRSchemeId SCHEMEID,(Select SCHE_Scheme From HS_SCHE_Sc' +
        'heme where SCHE_SchemeId=BD.BIDE_CRSchemeId) as Scheme'
      
        ',Round(Sum((BD.BIDE_Amount-BD.BIDE_Amount*BIDE_DisPer/100)*BIDE_' +
        'Qty+BIDE_VatAmt),2) CreditAmount,CPD.CRPD_DATAPOSTTIME DATAPOSTT' +
        'IME,CPD.CRPD_DATAPOSTDATE DATAPOSTDATE'
      'From HS_BIDE_BillDetail BD,HS_CRPD_CreditPaymentDetail CPD'
      
        'where BD.BIDE_BillNo=CPD.CRPD_RECEIPTNO(+) and BD.BIDE_PayType='#39 +
        'CREDIT'#39
      
        'Group by BD.BIDE_PatientId,BD.BIDE_BillNo,BD.BIDE_BillDate,BD.BI' +
        'DE_CRSchemeId,CPD.CRPD_DATAPOSTTIME,CPD.CRPD_DATAPOSTDATE'
      'Order by BD.BIDE_BillNo Desc')
    Left = 776
    Top = 264
