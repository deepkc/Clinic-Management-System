  object QryReceiptPrint: TQuery
    DatabaseName = 'Hospital'
    SQL.Strings = (
      
        'Select PatientID,(Select (FName||'#39' '#39'||LName) From PatientMain Wh' +
        'ere PatientID=R.PatientID) Name'
      ',ReceiptNo,BillNo,BillAmount,ReceivedAmount,ReceiptDate'
      ',(Select Sum(NVL(ReceivedAmount,0)) From Receipt '
      'Where BillNo=R.BillNo '
      'And ReceiptDate<=R.ReceiptDate'
      'And PatientID=R.PatientID) TotalReceived'
      
        ',(Select UserName From UserMain Where UserID=R.ReceivedBy) UserN' +
