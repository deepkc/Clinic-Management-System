procedure TFrame_CreditPayment.AddMyGrandChilds
  (MyId: Integer; MyNode: TTreeNode);
var
  QueryChilds: TQuery;
  ChildNode: TTreeNode;
  ls_childNode: String;
  li_childId: Integer;
begin
  QueryChilds := TQuery.Create(nil);

  if not MyNode.HasChildren then
  begin
    with QueryChilds do
    begin
      Close;
      DatabaseName := gs_DataBaseName;
      SQL.Clear;
      SQL.Add(' SELECT * FROM Grande_Acc.AccTree WHERE ParentID = ' + IntToStr
          (MyId));
      if RBtn_Code.Checked then
        SQL.Add(' ORDER BY LF ');
      { else if RBtn_AccountHead.Checked then
        sql.add(' ORDER BY Name '); }
      Open;

      First;
      while not Eof do
      begin
        if FieldByName('LF').AsString <> '' then
          ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName('LF')
            .AsString + ' 0 ' + FieldByName('Name').AsString
        else
          ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName
            ('Name').AsString;

        TreeView1.Items.AddChild(MyNode, ls_childNode);

        Next;
      end;
    end; // QueryChilds
  end; // if no childs

  ChildNode := MyNode.getFirstChild;
  while ChildNode <> nil do
  begin
    if not ChildNode.HasChildren then
    begin
      with QueryChilds do
      begin
        li_childId := StrToInt
          (Copy(ChildNode.Text, 1, pos(' - ', ChildNode.Text) - 1));

        Close;
        DatabaseName := gs_DataBaseName;
        SQL.Clear;
        SQL.Add(' SELECT * FROM Grande_Acc.AccTree WHERE ParentID = ' + IntToStr
            (li_childId));
        if RBtn_Code.Checked then
          SQL.Add(' ORDER BY LF ');
        { else if RBtn_AccountHead.Checked then
          sql.add(' ORDER BY Name '); }
        Open;

        First;
        while not Eof do
        begin
          if FieldByName('LF').AsString <> '' then
            ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName
              ('LF').AsString + ' 0 ' + FieldByName('Name').AsString
          else
            ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName
              ('Name').AsString;

          TreeView1.Items.AddChild(ChildNode, ls_childNode);

          Next;
        end;
      end; // QueryChilds
    end; // if no children

    ChildNode := MyNode.GetNextChild(ChildNode);
  end; // while

  QueryChilds.Destroy;
end;

