procedure TFrame_CreditPayment.BB_RePrintBillClick(Sender: TObject);
begin
     if Trim(Query_ReceiptDetail.FieldByName('ReceiptNo').AsString) = '' then
     Begin
          MessageDlg('No Receipt To Print.', mtWarning, [mbok], 0);
          Exit;
     End;

     if Trim(Query_ReceiptDetail.FieldByName('ReceiptNo').AsString)= 'ACC. ADJ.' then
     Begin
          MessageDlg('This is Account Adjustment. No Receipt has Generated for to Print.',mtWarning, [mbok], 0);
          Exit;
     End;
     if pb_IsRefund=True then
          Gs_BillNo := ps_MyBillNo
     else
          Gs_BillNo := Query_ReceiptDetail.FieldByName('ReceiptNo').AsString;
     pb_IsReprint := True;
     PrintReceipt;
end;

