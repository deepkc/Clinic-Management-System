  With Query_ReceiptDetail do
  Begin
    Close;
    DatabaseName := gs_DataBaseName;
    SQL.Clear;
    SQL.Add(' Select CRPD_CREDITPAYMENTMASTERID Masterid,CPD.CRPD_CrBillNo CRBILLNO,CPD.CRPD_ReceiptNo RECEIPTNO,');
