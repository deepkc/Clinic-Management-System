procedure TFrame_CreditPayment.CreateTableCreditPaymentList;
Begin
     Table_CreditPaymentList.Close;
     IF FileExists(gs_temppath + '\CreditPaymentList.db') Then
     DeleteFile(gs_temppath + '\CreditPaymentList.db');
     with Table_CreditPaymentList do
     Begin
          Close;
          DatabaseName := gs_temppath;
          Exclusive := False;
          Tablename := 'CreditPaymentList.db';
          tableType := ttDefault;
          FieldDefs.Clear;
          FieldDefs.Add('BillNo', ftString, 17);
          FieldDefs.Add('CreditAmount', ftFloat);
          FieldDefs.Add('SchemeId', ftInteger);
          CreateTable;
     End;
End;

procedure TFrame_CreditPayment.BB_FinalBillClick(Sender: TObject);
Var
  i: Integer;
begin
     Table_CreditPaymentList.Close;
     Table_CreditPaymentList.DatabaseName := gs_temppath;
     Table_CreditPaymentList.EmptyTable;
     Table_CreditPaymentList.Open;
     pf_TotalCreditAmt := 0;
     Edit_BillNo.Text := '';

     if Trim(CmbCommunity.Text) = '' then
     Begin
          MessageDlg('Must Have to Select Community .', mtWarning, [mbok], 0);
          Exit;
     End;

     if Trim(CmbScheme.Text) = '' then
     Begin
          MessageDlg('Must Have to Select Scheme .', mtWarning, [mbok], 0);
          Exit;
     End;

     if DBGrid1.SelectedRows.Count > 10 then
     Begin
          MessageDlg('Sorry You Cannot Clear More Than 10 Bills in One Payment Receipt.',mtWarning, [mbok], 0);
          Exit;
     End;

  if (DBGrid1.SelectedRows.Count > 0) then
  begin
    with DBGrid1.DataSource.DataSet do
    begin
      for i := 0 to DBGrid1.SelectedRows.Count - 1 do
      begin
        GotoBookmark(pointer(DBGrid1.SelectedRows.Items[i]));
        pf_TotalCreditAmt := pf_TotalCreditAmt + FieldByName('BalanceAmt').AsFloat;
        if Trim(Edit_BillNo.Text) <> '' then
          Edit_BillNo.Text := Edit_BillNo.Text + ',' + FieldByName('BillNo').AsString
        Else
          Edit_BillNo.Text := FieldByName('BillNo').AsString;
        Table_CreditPaymentList.Append;
        Table_CreditPaymentList.FieldByName('BillNo').AsString := FieldByName('BillNo').AsString;
        Table_CreditPaymentList.FieldByName('CREDITAMOUNT').AsFloat :=FieldByName('BalanceAmt').AsFloat;
        Table_CreditPaymentList.FieldByName('SchemeId').AsInteger := FieldByName('SchemeId').AsInteger;
        Table_CreditPaymentList.Post;
      end;
    end;
    pi_PatientID := DBGrid1.DataSource.DataSet.FieldByName('Patientid').AsInteger;
    GetPatientInfo(pi_PatientID);
    LoadPatientData(pi_PatientID);

    lblBillNo.Caption := DBGrid1.DataSource.DataSet.FieldByName('BillNo').AsString;
    lblBillDate.Caption := DBGrid1.DataSource.DataSet.FieldByName('BillDate').AsString;
    lblBillAmount.Caption := DBGrid1.DataSource.DataSet.FieldByName('CREDITAMOUNT').AsString;
    lblDueAmount.Caption := DBGrid1.DataSource.DataSet.FieldByName('BalanceAmt').AsString;
    pf_DueAmount := DBGrid1.DataSource.DataSet.FieldByName('BalanceAmt').AsFloat;
  end;

  PageControlCredit.ActivePageIndex := 1;
  TSCreditBill.TabVisible := False;
  TSCreditPayment.TabVisible := True;
  CMB_PayType.ItemIndex := 0;
  gs_IsCreditPaymentActive := 'Y';
  Edit_ReceiptAmount.Text := FloatToStr(pf_TotalCreditAmt);
end;

procedure TFrame_CreditPayment.BB_ReceiptRefundClick(Sender: TObject);
begin
     if Query_ReceiptDetail.fieldbyname('RECEIPTNO').AsString='' then
     begin
          ShowMessage('Please choose Receipt to Refund !!!');
          Exit;
     end;

     if (Query_ReceiptDetail.fieldbyname('PATIENTID').AsInteger<>QryCreditBill.fieldbyname('Patientid').AsInteger) then
     Begin
          ShowMessage('This receipt is not related to '+QryCreditBill.fieldbyname('PATIENTID').asstring);
          Exit;
     End;

     If (copy(Query_ReceiptDetail.fieldbyname('RECEIPTNO').AsString,1,2)='CP') and (Query_ReceiptDetail.FieldByName('IsRefund').AsString<>'Y') then
     Begin
          IF MessageDlg('Are you sure to refund the receipt ?',mtConfirmation,[mbYes,mbNo],0)<>mrYes Then
          Exit;
          Try
               DM_Hospital.DB.StartTransaction;

               ps_MyBillNo:=GetNextBillNo1('RCP', 'HS_CRPD_CreditPaymentDetail','CRPD_ReceiptNo');


              SaveCreditPaymentrefund(Query_ReceiptDetail.fieldbyname('Masterid').AsInteger,QryCreditBill.fieldbyname('Patientid').AsInteger,
                                        gi_UserId,QryCreditBill.fieldbyname('Schemeid').asinteger,Query_ReceiptDetail.fieldbyname('AMOUNT').AsFloat,ps_MyBillNo,Query_ReceiptDetail.fieldbyname('CRBILLNO').AsString,
                                        Query_ReceiptDetail.fieldbyname('RECEIPTNO').AsString,Serverdate.TodaysDate,Serverdate.todaystime,
                                        Query_ReceiptDetail.fieldbyname('ISPARTIALPAYMENT').AsString,
                                        Query_ReceiptDetail.fieldbyname('RECEIPTDISCOUNT').AsFloat);

               With Query_Process Do
               Begin
                    Close;
                    sql.clear;
                    sql.add(' Update HS_CRPD_CreditPaymentDetail Set crpd_Isrefund=''Y'' where CRPD_ReceiptNo='+Quotedstr(Query_ReceiptDetail.fieldbyname('RECEIPTNO').AsString));
                    sql.add(' and crpd_PatientID='+IntToStr(QryCreditBill.fieldbyname('PATIENTID').asinteger));
                    Execsql;

                    Close;
                    sql.Clear;
                    sql.add(' Update Hs_Bide_BillDetail Set Bide_IsCrPaid=''N'' where bide_BillNo='+Quotedstr(Query_ReceiptDetail.fieldbyname('CRBILLNO').AsString));
                    sql.add(' and Bide_PatientID='+IntToStr(QryCreditBill.fieldbyname('PATIENTID').asinteger));
                    ExecSQL;
               End;

               DM_Hospital.DB.Commit;
               pb_IsRefund := True;
               ShowDoneMessage;
          Except
               DM_Hospital.DB.Rollback;
               MessageDlg('Failure To Save Data !', mtWarning, [mbOk],0);
               Exit;
          End;
          If messageDlg('Do you want to print ?', mtconfirmation, [mbyes,mbno], 0)=mryes then
          Begin
               Try
                    BB_RePrintBillClick(Sender);
                    pb_IsRefund:= False;
                    //BBtnSave.Enabled:=False;
               Except
                    MessageDlg('Data Successfully Saved. Plz Re-Try For Printing.', mtWarning, [mbOk],0);
               End;
          End;
          //PaymentDetail;
     End
     Else
     Begin
          if Query_ReceiptDetail.FieldByName('IsRefund').AsString='Y' then
          Begin
               MessageDlg('This Receipt Has Already been Refunded.',mtWarning,[mbOk],0);
               Exit;
          End;
     End;
end;

