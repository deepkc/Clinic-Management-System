  IID := 0;
  if TreeView1.ReadOnly = False then
    Exit;
  SelNode := TreeView1.Selected;
  Label_AccHeadName.Caption := TreeView1.Selected.Text;
  NodeText := Copy(SelNode.Text, 1, pos(' - ', SelNode.Text) - 1);
  if NodeText <> '' then
  begin
    IID := StrToInt(NodeText);
