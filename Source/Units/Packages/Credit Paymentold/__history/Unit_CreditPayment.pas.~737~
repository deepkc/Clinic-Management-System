Procedure TFrame_CreditPayment.SaveCreditPayment;
Var
  ls_PayType, ls_ChequeNo, ls_Remarks, ls_CRBILLNODETAIL, LS_BILLNO: String;
  lf_ReceiptAmount: Double;
  IsPartialPayment: String;
  li_AccHeadId: Integer;
  Sender :TObject;
Begin
  if TSCreditPayment.TabVisible = False then
  Begin
    MessageDlg('Please First Select Credit Bill & Click on Credit Payment Button.',mtWarning, [mbok], 0);
    Exit;
  End;

  if (Trim(Edit_ReceiptAmount.Text) = '') or (Edit_ReceiptAmount.Text = '0') then
  Begin
    MessageDlg('Please Check Receipt Amount Properly.', mtWarning, [mbok], 0);
    Edit_ReceiptAmount.SetFocus;
    Exit;
  End;

  if (CB_PartialPayment.Checked = True) and (Length(Trim(Edit_BillNo.Text)) > 16) then
  Begin
    MessageDlg('For Partial Payment You Must Have to Choose Single Bill Only.' + Char
        (10) + 'Right Now You Are Choosing Multiple Bill for Payment.',
      mtWarning, [mbok], 0);
    Edit_BillNo.SetFocus;
    Exit;
  End;

  lf_ReceiptAmount := StrToFloat(Edit_ReceiptAmount.Text);
  if (lf_ReceiptAmount > pf_TotalCreditAmt) and (CB_PartialPayment.Checked = True) then
  Begin
    MessageDlg(' Receipt Amount is Greater than Remaining Payment.', mtWarning,[mbok], 0);
    Exit;
  End;

  if (CMB_PayType.ItemIndex = 2) and (dblcb_acc.KeyValue = null) then
  Begin
    MessageDlg(' Please Choose Account Head.', mtWarning, [mbok], 0);
    Exit;
  End;

  if (pf_TotalCreditAmt > lf_ReceiptAmount) and (CB_PartialPayment.Checked = True) then
    pb_IsCreditPaid := False
  Else
    pb_IsCreditPaid := True;

  if (lf_ReceiptAmount <= 0) AND (CMB_PayType.ItemIndex <> 2) then
  Begin
    MessageDlg(' Sorry No Payment Left for Credit Payment.', mtWarning, [mbok],0);
    Exit;
  End;

  if CB_PartialPayment.Checked = True then
    IsPartialPayment := 'Y'
  else
    IsPartialPayment := 'N';

  IF MessageDlg('Are You Sure To Make Receipt for Credit Payment ?',mtConfirmation, [mbYes, mbNo], 0) = mrYes Then
  Begin
    ps_TodaysDate := TodaysDate;
    ps_TodaysTime := TodaysTime;

    pi_SchemeId := CmbScheme.KeyValue;
    pi_CommunityId := CmbCommunity.KeyValue;

    ls_ChequeNo := Edit_ChequeNo.Text;
    ls_Remarks := EditDepositRemark.Text;
    LS_BILLNO := Gs_BillNo;

    ls_CRBILLNODETAIL := Edit_BillNo.Text;
    IF CMB_PayType.ItemIndex = 0 Then
      ls_PayType := 'CASH'
    Else
      ls_PayType := 'CHEQUE';

    if Edit_ReceiptDiscount.Text = '' then
     Edit_ReceiptDiscount.Text := '0';

    DM_Hospital.DB.StartTransaction;
    Try
      Try
        SaveCreditPaymentMaster(ps_TodaysDate, ps_TodaysTime, ls_PayType,
          ls_ChequeNo, ls_CRBILLNODETAIL, ls_Remarks, IsPartialPayment,
          lblName.Caption, gi_UserID, pi_SchemeId, pi_PatientID,
          lf_ReceiptAmount, StrToFloat(Edit_ReceiptDiscount.Text));
      Except
        SaveCreditPaymentMaster(ps_TodaysDate, ps_TodaysTime, ls_PayType,
          ls_ChequeNo, ls_CRBILLNODETAIL, ls_Remarks, IsPartialPayment,
          lblName.Caption, gi_UserID, pi_SchemeId, pi_PatientID,
          lf_ReceiptAmount, StrToFloat(Edit_ReceiptDiscount.Text));
      End;

      if CMB_PayType.ItemIndex <> 2 then
        LS_BILLNO := Gs_BillNo;

      Table_CreditPaymentList.First;
      While Not Table_CreditPaymentList.Eof Do
      Begin
        if pb_IsCreditPaid = True then
        Begin
          With Query_Process do
          Begin
            Close;
            sql.Clear;
            sql.Add(' Update BillDetail Set IsCrPaid=''Y'' where BillNo=' +
                #39 + Table_CreditPaymentList.FieldByName('BillNo').AsString + #39);
            Execsql;
          End;
        End;

        Try
          SaveCreditPaymentDetail(Table_CreditPaymentList.FieldByName('BillNo').AsString, Gs_BillNo, ps_TodaysDate, ps_TodaysTime,'N', gi_UserID,
            Table_CreditPaymentList.FieldByName('SchemeId').AsInteger,lf_ReceiptAmount);
        Except
          SaveCreditPaymentDetail(Table_CreditPaymentList.FieldByName('BillNo').AsString, Gs_BillNo, ps_TodaysDate, ps_TodaysTime,'N', gi_UserID,
            Table_CreditPaymentList.FieldByName('SchemeId').AsInteger,lf_ReceiptAmount);
        End;

        Table_CreditPaymentList.Next;
      End;
      DM_Hospital.DB.Commit;
      ShowDoneMessage;
    Except
      DM_Hospital.DB.Rollback;
    End;
    pb_IsReprint := False;
    if CMB_PayType.ItemIndex <> 2 then
      PrintReceipt;

    PageControlCredit.ActivePageIndex := 0;
    CmbCommunity.KeyValue:=null;
    CmbScheme.KeyValue:=null;
    BB_RefreshClick(Sender);
  End;
End;

