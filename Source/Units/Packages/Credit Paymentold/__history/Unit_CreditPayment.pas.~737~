procedure TFrame_CreditPayment.CreateTableCreditPaymentList;
Begin
  Table_CreditPaymentList.Close;
  IF FileExists(gs_temppath + '\CreditPaymentList.db') Then
    DeleteFile(gs_temppath + '\CreditPaymentList.db');
  with Table_CreditPaymentList do
  Begin
    Close;
    DatabaseName := gs_temppath;
    Exclusive := False;
    Tablename := 'CreditPaymentList.db';
    tableType := ttDefault;
    FieldDefs.Clear;
    FieldDefs.Add('BillNo', ftString, 17);
    FieldDefs.Add('CreditAmount', ftFloat);
    FieldDefs.Add('SchemeId', ftInteger);
    CreateTable;
  End;
End;

procedure TFrame_CreditPayment.BB_FinalBillClick(Sender: TObject);
Var
  i: Integer;
begin
  Table_CreditPaymentList.Close;
  Table_CreditPaymentList.DatabaseName := gs_temppath;
  Table_CreditPaymentList.EmptyTable;
  Table_CreditPaymentList.Open;
  pf_TotalCreditAmt := 0;
  Edit_BillNo.Text := '';

  if Trim(CmbCommunity.Text) = '' then
  Begin
    MessageDlg('Must Have to Select Community .', mtWarning, [mbok], 0);
    Exit;
  End;

  if Trim(CmbScheme.Text) = '' then
  Begin
    MessageDlg('Must Have to Select Scheme .', mtWarning, [mbok], 0);
    Exit;
  End;

  if DBGrid1.SelectedRows.Count > 10 then
  Begin
    MessageDlg('Sorry You Cannot Clear More Than 10 Bills in One Payment Receipt.',mtWarning, [mbok], 0);
    Exit;
  End;

  if (DBGrid1.SelectedRows.Count > 0) then
  begin
    with DBGrid1.DataSource.DataSet do
    begin
      for i := 0 to DBGrid1.SelectedRows.Count - 1 do
      begin
        GotoBookmark(pointer(DBGrid1.SelectedRows.Items[i]));
        pf_TotalCreditAmt := pf_TotalCreditAmt + FieldByName('BalanceAmt').AsFloat;
        if Trim(Edit_BillNo.Text) <> '' then
          Edit_BillNo.Text := Edit_BillNo.Text + ',' + FieldByName('BillNo').AsString
        Else
          Edit_BillNo.Text := FieldByName('BillNo').AsString;
        Table_CreditPaymentList.Append;
        Table_CreditPaymentList.FieldByName('BillNo').AsString := FieldByName('BillNo').AsString;
        Table_CreditPaymentList.FieldByName('CREDITAMOUNT').AsFloat :=FieldByName('BalanceAmt').AsFloat;
        Table_CreditPaymentList.FieldByName('SchemeId').AsInteger := FieldByName('SchemeId').AsInteger;
        Table_CreditPaymentList.Post;
      end;
    end;
    pi_PatientID := DBGrid1.DataSource.DataSet.FieldByName('Patientid').AsInteger;
    GetPatientInfo(pi_PatientID);
    LoadPatientData(pi_PatientID);

    lblBillNo.Caption := DBGrid1.DataSource.DataSet.FieldByName('BillNo').AsString;
    lblBillDate.Caption := DBGrid1.DataSource.DataSet.FieldByName('BillDate').AsString;
    lblBillAmount.Caption := DBGrid1.DataSource.DataSet.FieldByName('CREDITAMOUNT').AsString;
    lblDueAmount.Caption := DBGrid1.DataSource.DataSet.FieldByName('BalanceAmt').AsString;
    pf_DueAmount := DBGrid1.DataSource.DataSet.FieldByName('BalanceAmt').AsFloat;
  end;

  PageControlCredit.ActivePageIndex := 1;
  TSCreditBill.TabVisible := False;
  TSCreditPayment.TabVisible := True;
  CMB_PayType.ItemIndex := 0;
  Edit_ReceiptAmount.Text := FloatToStr(pf_TotalCreditAmt);
  Form_Credit.BB_Save.Enabled := True;
end;

