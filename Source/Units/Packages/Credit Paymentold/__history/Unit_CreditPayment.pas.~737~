procedure TFrame_CreditPayment.ReceiptDetail;
Begin
     With Query_ReceiptDetail do
       Begin
         Close;
         //DatabaseName:= gs_DataBaseName;
         SQL.Clear;
         SQL.Add(' Select CRPD_CREDITPAYMENTMASTERID Masterid,CPD.CRPD_CrBillNo CRBILLNO,CPD.CRPD_ReceiptNo RECEIPTNO,');
         sql.Add(' CRPD_PATIENTID Patientid, CPD.CRPD_DataPostDate as ReceiptDate,CPD.CRPD_DataPostTime as ReceiptTime,');
         SQL.Add(' CPD.CRPD_Amount Amount,USMA_USERNAME username,CRPD_DATAPOSTBY RECEIVEDBY,CRPD_ISPARTIALPAYMENT ISPARTIALPAYMENT,CRPD_ISREFUND ISREFUND,CRPD_RECEIPTDISCOUNT RECEIPTDISCOUNT From HS_CRPD_CreditPaymentDetail CPD,HS_USMA_UserMain UM where');
