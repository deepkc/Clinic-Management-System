  pb_IsReprint := True;
  PrintReceipt;
end;

procedure TFrame_CreditPayment.BitBtn_receiptrefundClick(Sender: TObject);
begin
  if (DBGrid2.SelectedRows.Count > 1) then
  begin
    MessageDlg('Sorry you cannot refund more than one receipt at a time',mtWarning, [mbok], 0);
    Exit;
  end;

  if (DBGrid2.SelectedRows.Count = 0) then
  Begin
    MessageDlg('Please Select The Receipt to Refund', mtWarning, [mbok], 0);
    Exit;
  End;

  if copy(Query_ReceiptDetail.FieldByName('billno').AsString, 1, 2) = 'RC' then
  Begin
    MessageDlg('This is Refund Receipt. This Receipt Cannot be Refund.',mtWarning, [mbok], 0);
    Exit;
  End;

  if Query_ReceiptDetail.FieldByName('ISREFUND').AsString='Y' then
  Begin
    MessageDlg('This Receipt has already Been Refund.',mtWarning, [mbok], 0);
    Exit;
  End;


  IF MessageDlg('Are you sure to refund the receipt ?', mtConfirmation,[mbYes, mbNo], 0) <> mrYes Then Exit;
  ps_TodaysDate := TodaysDate;
  ps_TodaysTime := TodaysTime;
  Try
    DM_Hospital.DB.StartTransaction;
    SaveCreditPaymentMaster_refund(ps_TodaysDate, ps_TodaysTime, 'REFUND', '',Query_ReceiptDetail.FieldByName('CRBILLNO').AsString, '', 'N',
      QryCreditBill.fieldbyname('PATIENTNAME').AsString, Query_ReceiptDetail.FieldByName('Billno').AsString,gi_UserID,
      QryCreditBill.fieldbyname('schemeid').AsInteger,QryCreditBill.fieldbyname('PATIENTID').Asinteger,
      Query_ReceiptDetail.FieldByName('Amount').AsFloat, Query_ReceiptDetail.FieldByName('receiptdiscount').AsFloat);

    SaveCreditPaymentDetail(Query_ReceiptDetail.FieldByName('CRBILLNO').AsString,Gs_BillNo, ps_TodaysDate, ps_TodaysTime,'Y', gi_UserID,
      pi_SchemeId,Query_ReceiptDetail.FieldByName('Amount').AsFloat);

    With Query_Process Do
    Begin
      Close;
      sql.Clear;
      sql.Add(' Update CreditPaymentMaster Set Isrefund=''Y'' where BillNo=' +Quotedstr(Query_ReceiptDetail.FieldByName('Billno').AsString));
      sql.Add(' and PatientID=' + IntToStr(QryCreditBill.FieldByName('PATIENTID').AsInteger));
      Execsql;

      Close;
      sql.Clear;
      sql.Add(' Update CreditPaymentdetail Set Isrefund=''Y'' where BillNo=' +Quotedstr(Query_ReceiptDetail.FieldByName('Billno').AsString));
      // sql.Add(' and PatientID=' + IntToStr(QryCreditBill.FieldByName('PATIENTID').AsInteger));
      Execsql;

      Close;
      sql.Clear;
      sql.Add(' Update BillDetail Set IsCrPaid=''N'' where BillNo=' + Quotedstr(QryCreditBill.FieldByName('BILLNO').AsString));
      sql.Add(' and PatientID=' + IntToStr(QryCreditBill.FieldByName('PATIENTID').AsInteger));
      Execsql;
    End;
    DM_Hospital.DB.Commit;
    ShowDoneMessage;
    GetCredtiBill;
    ReceiptDetail;
  Except
    DM_Hospital.DB.Rollback;
    MessageDlg('Some Error Occured While Saving The Data. Plz contact administrator',mtWarning, [mbok], 0);
  End;
end;

