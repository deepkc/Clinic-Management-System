procedure TFrame_CreditPayment.TreeView1Click(Sender: TObject);
var
  SelNode: TTreeNode;
  NodeText, lf, ls_childNode: String;
  IID: Integer;
begin
  IID := 0;
  if TreeView1.ReadOnly = False then
    Exit;
  SelNode := TreeView1.Selected;
  Label_AccHeadName.Caption := TreeView1.Selected.Text;
  NodeText := copy(SelNode.Text, 1, pos(' - ', SelNode.Text) - 1);
  if NodeText <> '' then
  begin
    IID := StrToInt(NodeText);
    Label_AccHeadId.Caption := IntToStr(IID);
    pi_AccountHeadId := IID;
    // IID:= StrToInt(NodeText);
    qry_stateofaccount.Close;
    qry_stateofaccount.ParamByName('id').AsInteger := IID;
    qry_stateofaccount.Open;
    if qry_stateofaccount.FieldByName('state').AsString = '1' then
      Active1.Checked := True
    else
      Active1.Checked := False;

  end;
  // removed coz time consuming
  // AddMyGrandChilds(IID, SelNode);

  if not SelNode.HasChildren then
  begin
    with QueryAccTree do
    begin
      Close;
      sql.Clear;
      sql.Add(' SELECT ID, Name, LF, State ');
      sql.Add(' FROM Grande_Acc.AccTree ');
      sql.Add(' WHERE ParentID = ' + IntToStr(IID));
      { if RBtn_Code.Checked then
        sql.add(' ORDER BY LF '); }
      { else if RBtn_AccountHead.Checked then }
      sql.Add(' ORDER BY Name ');
      Open;
    end;

    with QueryAccTree do
    begin
      while not Eof do
      begin
        if FieldByName('LF').AsString <> '' then
          ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName('LF')
            .AsString + ' 0 ' + FieldByName('Name').AsString
        else
          ls_childNode := FieldByName('ID').AsString + ' - ' + FieldByName
            ('Name').AsString;

        TreeView1.Items.AddChild(SelNode, ls_childNode);

        Next;
      end;
    end;
  end;
end;

