procedure TFrame_CreditPayment.GetCredtiBill;
var
  b_IsNumber: Boolean;
  li_PatientId: Integer;
begin
  If Trim(EditDay.Text) = '' Then
    EditDay.Text := '0';

  IF (CBExtended.Checked = True) and (Trim(EditPatientID.Text) = '') Then
  Begin
    MessageDlg(
      'You Must Have To Put Either Hospital No or BIll No for This Extended Serach.'
        , mtInformation, [mbok], 0);
    EditPatientID.SetFocus;
    Exit;
  End;

  IF Trim(EditPatientID.Text) <> '' Then
  Begin
    Try
      li_PatientId := StrToInt(EditPatientID.Text);
      b_IsNumber := True;
    Except
      b_IsNumber := False;
    End;
  End;

  QryCreditBill.Filtered := False;

     With QryCreditBill Do
     Begin
          Close;
          SQL.Clear;
          SQL.Add(' Select R.*,CreditAmount-DepositBalance-NVL(PaidAmount,0)-NVL(ReceiptRefund,0)-NVL(billRefund,0) as BalanceAmt From (');
          SQL.Add(' Select BIDE_PatientId as PatientId,BIDE_BillNo as BillNo,BIDE_BillDate as BillDate,');
          SQL.Add('(Select PAMA_PatientName From HS_PAMA_PatientMain where PAMA_PatientId=BIDE_PatientId) as PatientName');
          SQL.Add(' ,BIDE_CRSCHEMEID Schemeid,(Select SCHE_Scheme From HS_SCHE_Scheme where sche_SchemeId=BIDE_CRSCHEMEID) as Scheme');
          SQL.Add(' ,Round(Sum((BIDE_Amount-BIDE_Amount*BIDE_DisPer/100)*BIDE_Qty+BIDE_VatAmt),2) CreditAmount');
          SQL.Add(' ,NVL((Select INRE_DepositBalance From HS_INRE_InpatientReg where INRE_DISBILLNO=BIDE_BillNo),0) DepositBalance');
          SQL.Add(' ,(Select Round(Sum((REDE_Amount-REDE_Amount*REDE_DisPer/100)*REDE_Qty+REDE_VatAmt),2) From HS_REDE_RefundDetail where');
          SQL.Add(' REDE_BillDetailId In (Select BIDE_BillDetailId From HS_BIDE_BillDetail where BIDE_BillNo=BD.BIDE_BillNo)) as billRefund');
          SQL.Add(' ,(Select NVL(Sum(CRPD_Amount),0) From HS_CRPD_CreditPaymentDetail where CRPD_CrBillNo=BIDE_BillNo AND CRPD_PAYTYPE=''CASH'' AND CRPD_ISREFUND=''N'') as PaidAmount');
          SQL.Add(',(Select NVL(Sum(Crpd_Amount),0) From HS_CRPD_CreditPaymentDetail where Crpd_CRBillNo=BD.Bide_BillNo and crpd_paytype=''REFUND'' and Crpd_isrefund=''Y'') as ReceiptRefund');
          // sql.add('(select name from grande_acc.acctree where Id= (select nvl(refaccheadid,0)');
          // sql.add('from CreditPaymentmaster where CreditPaymentmasterId in(Select CreditPaymentmasterId From CreditPaymentDetail where CrBillNo=BIDE_BillNo) and rownum=1))refacchead');
          // sql.add(' ,(Select Distinct ReceiptNo From CreditPaymentDetail where CrBillNo=BD.BillNo) as ReceiptNo');
          SQL.Add(' From HS_Bide_BillDetail BD');
          SQL.Add(' where BIDE_PayType=''CREDIT''');
          IF CBExtended.Checked = False Then
          Begin
               IF CB_Search.Checked = True Then
                    SQL.Add(' and BIDE_BillDate >= ' + #39 + DateEditX_From.Text + #39 + ' And BIDE_BillDate<=' + Chr(39) + DateEditX_To.Text + Chr(39))
               Else
                    {SQL.Add(' and BIDE_BillDate>=' + #39 + GetFromDateBySubNoOfDays
                    ( DEX_Today, StrToInt(Edit_Day.Text))
                    + #39 + ' And BIDE_BillDate<=' + Chr(39) + DEX_Today.Text + Chr(39)
                    ); }

               IF (RB_Paid.Checked = True) Then
                    SQL.Add(' and BIDE_IsCrPaid=''Y''')
               Else IF RB_NonPaid.Checked = True Then
                    SQL.Add(' and BIDE_IsCrPaid<>''Y''');
          End;

          If (Trim(EditPatientID.Text) <> '') and (b_IsNumber = True) Then
               SQL.Add(' And BIDE_PatientID=' + EditPatientID.Text)
          Else If (Trim(EditPatientID.Text) <> '') and (b_IsNumber = False) Then
               SQL.Add(' And BIDE_BillNo=' + #39 + EditPatientID.Text + #39);

          //sSQL.Add('and bide_billdetailid not in (Select rede_billdetailid from Hs_Rede_Refunddetail)');

          IF CmbScheme.KeyValue <> null Then
          Begin
               SQL.Add(' and BIDE_CRSCHEMEID=' + IntToStr(CmbScheme.KeyValue));
               IF CB_Search.Checked = True Then
                    SQL.Add(' And BIDE_BillDate >=' + #39 + DateEditX_From.Text + #39 +' and BIDE_BillDate<=' + Chr(39) + DateEditX_To.Text + Chr(39))
               Else
                    {SQL.Add(' And BIDE_BillDate >=' + #39 + GetFromDateBySubNoOfDays
                         (DEX_Today, StrToInt(Edit_Day.Text))
                         + #39 + ' And BIDE_BillDate<=' + Chr(39) + DEX_Today.Text + Chr(39)
                     );   }
          End;
          SQL.Add(' Group by BIDE_PatientId,BIDE_BillNo,BIDE_BillDate,BIDE_CRSCHEMEID');
          SQL.Add(' ) R Order by BillNo Desc ');
         // SQL.saveToFile('C:\CreditClearance.Txt');
          Open;
     End;
  // PaymentDetail;
     EditPatientID.SetFocus;
end;

