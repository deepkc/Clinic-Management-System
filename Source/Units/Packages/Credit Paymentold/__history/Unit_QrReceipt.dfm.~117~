  object Query_Receipt: TQuery
    DatabaseName = 'HOSPITAL'
    SQL.Strings = (
      
        'Select BillNo,ReceiptDate||'#39' - '#39'||ReceiptTime as DateTime,(Selec' +
        't UserName From UserMain where UserId=CPM.ReceiptBy) as UserName' +
        ',PatientId,PatientName'
      
        ',(Select SchemeName From Scheme where SchemeId=CPM.SchemeId) as ' +
        'SchemeName,ReceiptAmount,Trim(SubStr(CrBillNoDetail,1,79)) CrBil' +
        'lNoDetail,'
      
        'Trim(SubStr(CrBillNoDetail,81,100)) CrBillNoDetail2nd,Case when ' +
        'PayType='#39'CASH'#39' Then '#39'CASH'#39' Else ChequeNo End ChequeNo'
      'From CreditPaymentMaster CPM'
      'Where Billno')
    Left = 264
    Top = 17
  end
