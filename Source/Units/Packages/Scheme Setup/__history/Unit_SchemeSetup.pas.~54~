procedure TForm_Scheme.SpeedButton3Click(Sender: TObject);
Var
     i: integer;
     b_IsExistScheme: Boolean;
Const
     Arr_TableName: array [0 .. 3] of String = ('PatientMain', 'PatientVisit', 'BillDetail', 'InpatientReg');
begin
     b_IsExistScheme := False;
     For i := 0 To 3 Do
     Begin
          With QueryProcess do
          Begin
               Close;
               sql.Clear;
               sql.Add(' Select Distinct SchemeID From ' + Arr_TableName[i] + ' where ');
               sql.Add(' SchemeId=' + IntToStr(Query_Scheme.FieldbyName('SchemeId').AsInteger));
               Open;
          End;

          IF QueryProcess.FieldbyName('SchemeID').AsInteger > 0 Then
          Begin
               b_IsExistScheme := True;
               Break;
          End;
     End;

     IF b_IsExistScheme = True Then
     Begin
          Messagedlg('Sorrry ! This scheme has been already used in transaction.', mtWarning, [mbOk], 0);
          Exit;
     End;

     With QueryProcess do
     Begin
          Close;
          sql.Clear;
          sql.Add(' Delete From Scheme where SchemeID=' + IntToStr(Query_Scheme.FieldbyName('SchemeId').AsInteger));
          ExecSQL;
     End;

     ShowDoneMessage;
end;

