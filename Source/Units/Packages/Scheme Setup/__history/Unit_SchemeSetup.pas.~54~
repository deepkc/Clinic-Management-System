procedure TForm_Scheme.BitBtnSaveClick(Sender: TObject);
Var
     SCHEMEID,CommunityId, RegDiscount, OutPtDiscount, InPtDiscount, PHOPTDiscount, PHINPTDiscount, AdmnDiscount,
       BedDiscount: integer;
     SchemeCode, SchemeName, Remarks,ls_VALIDFROMDATE,ls_VALIDTODATE,ls_ISACTIVE: string;
     RegCreditFacility, OutPtCreditFacility, InPtCreditFacility, PhOutPtCreditFacility, PhInPtCreditFacility,
       DisplayWithoutDis, SchemeDisEditable: Boolean;
begin
     IF Edit_SchemeName.Text = '' Then
     Begin
          Messagedlg('Please enter the scheme name !', mtConfirmation, [mbOk], 0);
          Edit_SchemeName.SetFocus;
          Exit;
     End;

     IF DBLookupComboBox_Community.KeyValue = NULL Then
     Begin
          Messagedlg('Please Select Community !', mtConfirmation, [mbOk], 0);
          DBLookupComboBox_Community.SetFocus;
          Exit;
     End;

     IF EditRegDiscount.Text = '' Then
          EditRegDiscount.Text := '0';
     IF Edit_OutPtDiscount.Text = '' Then
          Edit_OutPtDiscount.Text := '0';
    { IF Edit_InPtDiscount.Text = '' Then
          Edit_InPtDiscount.Text := '0';

     IF Edit_PHOPTDiscount.Text = '' Then
          Edit_PHOPTDiscount.Text := '0';
     IF Edit_PHINPTDiscount.Text = '' Then
          Edit_PHINPTDiscount.Text := '0';

     IF EditAdmnDis.Text = '' Then
          EditAdmnDis.Text := '0';
     IF EditBedChargeDis.Text = '' Then
          EditBedChargeDis.Text := '0';}

     { savescheme(CommunityId,RegDiscount,OutPtDiscount,InPtDiscount,PHOPTDiscount,PHINPTDiscount,AdmnDiscount,
       BedDiscount:integer;SchemeCode,SchemeName,
       Remarks:string) }
     SCHEMEID:=pi_OldPrimaryId;
     CommunityId := DBLookupComboBox_Community.KeyValue;
     RegDiscount := StrToInt(EditRegDiscount.Text);
     OutPtDiscount := StrToInt(Edit_OutPtDiscount.Text);
     //InPtDiscount := StrToInt(Edit_InPtDiscount.Text);
     //PHOPTDiscount := StrToInt(Edit_PHOPTDiscount.Text);
     //PHINPTDiscount := StrToInt(Edit_PHINPTDiscount.Text);
    // AdmnDiscount := StrToInt(EditAdmnDis.Text);
    // BedDiscount := StrToInt(EditBedChargeDis.Text);
     SchemeCode := Edit_Code.Text;
     SchemeName := Edit_SchemeName.Text;
     Remarks := StringReplace(Edit_Remarks.Text, '''', '''''', [rfReplaceAll]);
     if CheckBoxRegCreditFacility.Checked = True then
          RegCreditFacility := True
     else
          RegCreditFacility := False;

     if CheckBox_OutPtCreditFacility.Checked = True then
          OutPtCreditFacility := True
     else
          OutPtCreditFacility := False;

     if chk_IsActiveScheme.Checked = True then
          ls_ISACTIVE := 'Y'
     else
          ls_ISACTIVE := 'N';

     {ChangeToDefaultDate(Dex_ValidFrom);
     ChangeCaption(SPB_ValidFrom);

     ChangeToDefaultDate(Dex_ValidTo);
     ChangeCaption(SPB_ValidTo);}

     ls_VALIDFROMDATE:=Dex_ValidFrom.text;
     ls_VALIDTODATE:=Dex_ValidTo.text;



     {if CheckBox_InPtCreditFacility.Checked = True then
          InPtCreditFacility := True
     else
          InPtCreditFacility := False;

     if CheckBox_PhOPTCreditFacility.Checked = True then
          PhOutPtCreditFacility := True
     else
          PhOutPtCreditFacility := False;

     if CheckBox_PHINPTCreditFacility.Checked = True then
          PhInPtCreditFacility := True
     else
          PhInPtCreditFacility := False; }

     if CB_IsDisplayWithoutDiscount.Checked = True then
          DisplayWithoutDis := True
     else
          DisplayWithoutDis := False;

     if CB_SchemeDiscountEditable.Checked = True then
          SchemeDisEditable := True
     else
          SchemeDisEditable := False;
     try
          if lToAppend then
               SaveSchemeSetup(CommunityId, RegDiscount, OutPtDiscount, InPtDiscount, PHOPTDiscount, PHINPTDiscount,
                    AdmnDiscount, BedDiscount, SchemeCode, SchemeName, Remarks,ls_ISACTIVE,ls_VALIDFROMDATE,ls_VALIDTODATE, RegCreditFacility, OutPtCreditFacility,
                    InPtCreditFacility, PhOutPtCreditFacility, PhInPtCreditFacility, DisplayWithoutDis,
                    SchemeDisEditable)
          else
               UpdateSchemeSetup(SCHEMEID, CommunityId, RegDiscount, OutPtDiscount, InPtDiscount, PHOPTDiscount,
                    PHINPTDiscount, AdmnDiscount, BedDiscount, SchemeCode, SchemeName, Remarks,ls_ISACTIVE,ls_VALIDFROMDATE,ls_VALIDTODATE, RegCreditFacility,
                    OutPtCreditFacility, InPtCreditFacility, PhOutPtCreditFacility, PhInPtCreditFacility,
                    DisplayWithoutDis, SchemeDisEditable);
     except
          MsgBox(1005, 0, '', '', '');

     end;
     ShowDoneMessage;

     if lToAppend = False then
     begin
          Edit_Code.Enabled := True;
          Edit_Code.SetFocus;
     end;

     Edit_Code.Text := '';
     Edit_SchemeName.Text := '';
     EditRegDiscount.Text := '0';
    { Edit_OutPtDiscount.Text := '0';
     Edit_InPtDiscount.Text := '0';
     Edit_PHOPTDiscount.Text := '0';
     Edit_PHINPTDiscount.Text := '0';
     EditBedChargeDis.Text := '0';
     EditAdmnDis.Text := '0';}
     Edit_Remarks.Text := '';
     DBLookupComboBox_Community.KeyValue := -1;
     CB_IsDisplayWithoutDiscount.Checked := False;
     CB_SchemeDiscountEditable.Checked := False;
     lToAppend := True;

     PageControl_Scheme.ActivePageIndex:=0;
     Query_Scheme.Close;
     Query_Scheme.Session:=DM_Hospital.DB;
     Query_Scheme.Open;
end;

