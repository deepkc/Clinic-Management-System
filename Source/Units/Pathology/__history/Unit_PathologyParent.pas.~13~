     FrameCleared := false;
     try
          For i := 0 to Panel_Parent.ControlCount - 1 do
          begin
               if (Panel_Parent.Controls[i] is Tframe) then
               begin
                    if Tframe(Panel_Parent.Controls[i]).Name = 'Frame_Finding' then
