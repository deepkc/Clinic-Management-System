procedure TForm_PathologyParent.BB_PreviewClick(Sender: TObject);
begin
     // if Frame_SampleCollection.Cb_PrintSelected.Checked = true then
     // gb_PrintSelected := true
     // else
     // gb_PrintSelected := false;
     gi_PatientTestID := Frame_SampleCollection.Query_SampleCollected.FieldByName('PatientTestId').AsInteger;
     gi_InPatientID:=Frame_SampleCollection.Query_SampleCollected.FieldByName('InPatientID').AsInteger;
     ShowMessage(IntToStr(gi_InPatientID));
     gs_TestDate := Frame_SampleCollection.Query_SampleCollected.FieldByName('TestDate').AsString;
     gs_SampleNo := Frame_SampleCollection.Query_SampleCollected.FieldByName('SampleNo').AsString;
     Gi_DepID := Frame_SampleCollection.Query_SampleCollected.FieldByName('DepID').AsInteger;
     if Frame_SampleCollection.Cb_SingleDep.Checked = true then
     begin
          Frame_SampleCollection.Cb_SingleDep.Checked := false;
          gb_SingleDep := true;
     end;
     (*Semen Analysis Report*)
     if gi_TestNameId=682 then
     begin
          try
               Form_SemenAnalysis := TForm_SemenAnalysis.Create(nil);
               with Form_SemenAnalysis do
               begin
                    QuickRep1.Preview;
               end;
          finally
               Form_SemenAnalysis.Free;
          end;
     end
     else if Not IsClinicalDep(Gi_DepID) then
     begin
          try
               Form_QrFinding := TForm_QrFinding.Create(nil);
               with Form_QrFinding do
               begin
                    lbl_verifiedby.caption := Frame_SampleCollection.Query_SampleCollected.FieldByName('VerifiedBy').AsString;
                    QrFinding.Prepare;
                    lbl_totpage.caption := IntToStr(QrFinding.QRPrinter.PageCount);
                    lbl_totpageh.caption := IntToStr(QrFinding.QRPrinter.PageCount);
                    QrFinding.Preview;
               end;
          finally
               Form_QrFinding.Free;
               Frame_SampleCollection.Query_SampleCollected.Close;
               Frame_SampleCollection.Query_SampleCollected.Open;
          end;
     end
     else
     begin
          try
               Form_QrPathFinding := TForm_QrPathFinding.Create(nil);
               with Form_QrPathFinding do
               begin
                    lbl_verifiedby.caption := Frame_SampleCollection.Query_SampleCollected.FieldByName('VerifiedBy').AsString;
                    QrFinding.Prepare;
                    lbl_totpage.caption := IntToStr(QrFinding.QRPrinter.PageCount);
                    lbl_totpageh.caption := IntToStr(QrFinding.QRPrinter.PageCount);
                    QrFinding.Preview;
               end;
          finally
               Form_QrPathFinding.Free;
               Frame_SampleCollection.Query_SampleCollected.Close;
               Frame_SampleCollection.Query_SampleCollected.Open;
          end;
     end;
end;

