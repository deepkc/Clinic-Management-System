procedure TForm_PathologyParent.FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
   try
     if Shift = [ssCtrl, ssShift] then
     begin
          with Frame_SampleCollection do
          begin
               if PageControl1.ActivePage.caption = 'To be Collected' then
               begin
                    Edit_SearchTBC.Clear;
                    Edit_SearchTBC.SetFocus;
               end
               else if PageControl1.ActivePage.caption = 'Collected List' then
               begin
                    Edit_SearchCollectedList.Clear;
                    Edit_SearchCollectedList.SetFocus;
               end;
          end;
     end
     else if Key = VK_ESCAPE then
     begin
          Key := 0;
          BB_CloseClick(Sender);
     end
     else if (Key = VK_F1) AND (BB_SampleCollection.Visible = true) and (BB_SampleCollection.Enabled = true) then
          BB_SampleCollectionClick(Sender)
     else if (Key = VK_F1) AND (gs_CalledFrom = 'PATHOLOGY') then
     Begin
          Frame_SampleCollection.CB_LAbNo.Checked:=Not (Frame_SampleCollection.CB_LAbNo.Checked);
          Frame_SampleCollection.Edit_SearchCollectedList.SetFocus;
     End
     else if (Key = VK_F2) AND (BB_Findings.Visible = true) and (BB_Findings.Enabled = true) then
     begin
          Key := 0;
          BB_FindingsClick(Sender)
     end
     else if (Key = VK_F3) AND (BB_Print.Visible = true) and (BB_Print.Enabled = true) then
          BB_PrintClick(Sender)
     else if (Key = VK_F4) AND (BB_Preview.Visible = true) and (BB_Preview.Enabled = true) then
          BB_PreviewClick(Sender)
     else if (Key = VK_F12) and (Frame_SampleCollection <> nil) then
          Frame_SampleCollection.BB_SaveClick(Sender);
   except

   end;
end;

