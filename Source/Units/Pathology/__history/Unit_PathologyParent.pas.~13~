                         BB_Findings.Enabled := false;
                         FreeAndNil(Frame_Finding);
                         FrameCleared := true;
                         BB_SampleCollectionClick(Sender);
                         Frame_SampleCollection.Dex_CLFrom.Text := gs_from;
                         Frame_SampleCollection.Dex_CLTo.Text := gs_To;

                         Frame_SampleCollection.BB_CollectedListClick(Sender);
                         //che
                         Frame_SampleCollection.Edit_SearchCollectedList.Text := IntToStr(gi_PathologyPatientID);
                         Frame_SampleCollection.Edit_SearchCollectedList.Text := '';
                         Frame_SampleCollection.BB_Modify.Visible := false;
                         BB_Print.Enabled := true;
                         BB_Preview.Enabled := true;
                         gs_CalledFrom := 'PATHOLOGY';


                         Frame_SampleCollection.Query_samplecollectedright.Locate('PatientId',pi_PatientId,[]);
                         Frame_SampleCollection.DBGrid3CellClick(Column);
                         Frame_SampleCollection.Query_SampleCollected.Locate('PatientTestId',pi_PatientTestId,[]);

