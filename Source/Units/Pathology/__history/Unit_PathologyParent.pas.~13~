                    begin
                         if Tframe(Panel_Parent.Controls[i]).Name = 'Frame_ClinicalPathFindingNew' then
                        begin
                            BB_Findings.Enabled := false;
                            FreeAndNil(Frame_ClinicalPathFindingNew);
                            FrameCleared := true;
                            BB_SampleCollectionClick(Sender);
