function TFrame_SampleCollection.GetPatientIdFilteredDateFromLabNo(LabNo: string): Integer;
var
  Qry: TOraQuery;
  refreshDate: string;
  refreshdays: Integer;
  refresh_date, Dex_Today: TDateEditX;
begin

  if gi_datesystem = 0 then
  begin
    try
      refresh_date := TDateEditX.Create(nil);
      Dex_Today := TDateEditX.Create(Nil);
      refreshdays := (Dex_Today.VSDateAsDays - StrtoInt(Se_CLDays.Text));
      refresh_date.VSDateAsDays := refreshdays;
      refreshDate := refresh_date.Text;
    finally
      refresh_date.Free;
    end;
  end;

  Qry := TOraQuery.Create(nil);
  with Qry do
  begin
    Close;
    Session := DM_Hospital.DB;
    SQL.Clear;
    SQL.Add('select Distinct PatientId from samplecollection where LabNo=' + quotedstr(LabNo));
   { if CB_Date.Checked then
      SQL.Add('and Sampletakendate between' + quotedstr(Dex_CLFrom.Text) + ' and ' + quotedstr(Dex_CLTo.Text))
    else
    begin
      if gi_datesystem = 1 then
        SQL.Add('and Sampletakendate >= TO_CHAR(SYSDATE-' + Se_CLDays.Text + ',''YYYY/MM/DD'')')
      else
        SQL.Add('and Sampletakendate>=' + quotedstr(refreshDate));
    end;                                     }
    // sql.SaveToFile('c:/SaveLabFetch.txt');
    Open;
    Result := FieldByName('PatientId').AsInteger;
  end;
  Qry.Close;
  Qry.Free;
end;

