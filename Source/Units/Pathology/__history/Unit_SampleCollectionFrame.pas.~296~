procedure TFrame_SampleCollection.ReprintSticker(BillNo: string);
var
  Qry: TOraQuery;
  PatientName, SAMPLENO: string;
  PatientID: Integer;
begin
  Qry := TOraQuery.Create(Nil);
  try
    Form_Sticker := TForm_Sticker.Create(Nil);
    with Form_Sticker do
    begin
      if BillNo = '' then
        BillNo := Lbl_BillNo.Caption;

      with Qry do
      begin
        Close;
        Session := DM_Hospital.DB;
        SQL.Clear;
        SQL.Add('Select PatientID,(Select Pama_PatientName from ' + gs_Hos_DB_UserName + '.Hs_Pama_PatientMain Where Pama_PatientId=Sc.PatientId)PatientName');
        SQL.Add(' ,SampleNO from SampleCollection Sc Where BillNo=' + #39 + BillNo + #39);

        Open;
        SAMPLENO := FieldByName('SampleNo').AsString;
        PatientID := FieldByName('PatientId').AsInteger;
        if SAMPLENO = '' then
          Exit;
        PatientName := FieldByName('PatientName').AsString;
        SQL.Clear;
        SQL.Add('Select Distinct SampleSourceID,(Select Saso_SampleSource From ' + gs_DB_UserName + '.lb_saso_samplesource Where Saso_SampleSourceID=Tn.Tena_SampleSourceID)SampleSource');
        SQL.Add(',(Select Dept_DepName from ' + gs_Hos_DB_UserName + '.Hs_Dept_Department Where Dept_DepID=Tn.Tena_DepID)DepName,testname');
        SQL.Add('from ' + gs_Hos_DB_UserName + '.Hs_Tena_TestName Tn Where TestNameID in (Select TestNameId from ' + gs_Hos_DB_UserName + '.PatientTest Where PatientTestID in');
        SQL.Add(' (Select PatientTestId from SampleCollection Where BillNo=' + #39 + BillNo + #39 + '))');
        SQL.Add('And Tn.DepID in (' + gs_UserDepId + ')');
        Open;
        QrBarcode.Text := SAMPLENO;
        while not eof do
        begin
          lbl_PatientName.Caption := PatientName + ' - ' + IntToStr(PatientID);
          lbl_bottom.Caption := FieldByName('SampleSource').AsString;
          lbl_DepName.Caption := FieldByName('DepName').AsString;
          // lbl_bottom.Caption:=fieldbyname('testname').AsString;
          if cb_preview.Checked = true then
            QrSticker.Preview
          else
          begin
            QrSticker.Print;
            // QrSticker.Print;
          end;
          Next;
        end;
      end;
    end;
  finally
    Form_Sticker.Free;
  end;
  Qry.Free;
end;

