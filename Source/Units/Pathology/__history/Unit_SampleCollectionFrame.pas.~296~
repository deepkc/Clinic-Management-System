     Bottom,testname:string;
     qry_dep,qry_datetime:TOraQuery;
     refreshDate, ls_TestNameId: string;
    refreshdays: Integer;
    refresh_date: TDateEditX;
begin
     if gi_compileValue=12 then
     begin
          qry_DateTime:=TOraQuery.Create(nil);
          SetPrinter('order printer');
          with qry_DateTime do
          begin
               Close;
               Session:=DM_Hospital.DB;
               SQL.Clear;
               SQL.Add('select max(sampletakentime) as sampletakentime from samplecollection where labno=' + Edit_LabNo.Text);
               Open;
          end;
          ps_printtime:=qry_datetime.FieldByName('sampletakentime').AsString;
          qry_datetime.Free;
     end;


     if gi_datesystem = 0 then
     begin
          try
               refresh_date := TDateEditX.Create(nil);
               refresh_date.ADDateAsText := TodaysDate;
               refreshdays := (refresh_date.VSDateAsDays - StrtoInt(Se_CLDays.Text));
               refresh_date.VSDateAsDays := refreshdays;
               refreshDate := refresh_date.VSDateAsText;
          finally
               refresh_date.Free;
          end;
     end;

     ls_TestNameId:='';
     begin
          for i := 0 to CLB_CollectedSample.Items.Count - 1 do
          begin
               if CLB_CollectedSample.State[i] = cbChecked then
               begin
                    Bottom := CLB_CollectedSample.Items.Strings[i];

                    if ls_TestNameId='' then
                         ls_TestNameId:=IntToStr(Arr_CollectedSample[i,1])
                    else
                         ls_TestNameId:=ls_TestNameId+','+inttostr(Arr_CollectedSample[i,1]);
               end;
          end;
     end;

     with qry_master do
      begin
           Close;
           Session:=DM_Hospital.DB;
           SQL.Clear;
           SQL.Add('select distinct tena_depid as depid from hs_tena_testname');
           SQL.Add(' where tena_testnameID In ('+ls_TestNameId+')');
           Open;
      end;
     begin
          while not qry_master.Eof do
          begin
               Form_QrSampleCollectionReport :=TForm_QrSampleCollectionReport.Create(nil);
               try
                    with Form_QrSampleCollectionReport do
                    begin
                         pi_depid:=qry_master.FieldByName('depid').AsInteger;
                         ps_patientid:=lbl_Hosno.Caption;
                         ps_labno:=Edit_LabNo.Text;
                         refreshdatereport:=refreshDate;
                         ps_testnameID:=ls_TestNameId;
                         LoadData;
                         QRLabel4.Caption:=Lbl_Name.Caption;
                         QRLabel10.Caption:=Lbl_Address.Caption;
                         QRLabel11.Caption:=Edit_PreviousSampleNo.Text;
                         QRLabel13.Caption:=Lbl_ContactNo.Caption;
                         QRLabel17.Caption:=Lbl_AgeSex.Caption;
                         QRLabel15.Caption:=lbl_Hosno.Caption;
                         QuickRep1.Prepare;
                         if Preview.Checked then
                              QuickRep1.Preview
                         else
                              QuickRep1.Print;
                    end;
               finally
                    Form_QrSampleCollectionReport.Free;
               end;
               qry_master.Next;
          end;
          qry_dep.Close;
          qry_dep.Free;
          qry_master.Close;
          qry_master.Free;
     end;
end;

