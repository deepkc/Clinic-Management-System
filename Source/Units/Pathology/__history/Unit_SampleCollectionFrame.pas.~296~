procedure TFrame_SampleCollection.DBGrid3CellClick(Column: TColumn);
var
  Sender: TObject;
  i: Integer;
begin
  if Query_samplecollectedright.FieldByName('PatientId').AsString <> '' then
  begin
    gi_PatientID := Query_samplecollectedright.FieldByName('PatientId').AsInteger;
    gs_SampleNo := Query_samplecollectedright.FieldByName('SampleNo').AsString;
  end
  else
  begin
    gi_PatientID := 0;
    gs_SampleNo := '';
  end;

  with Query_SampleCollected do
  begin
    Close;
    SQL[4] := 'And PatientId=' + IntToStr(gi_PatientID);
    if Cb_NoResult.Checked then
    begin
      SQL[6] := 'And TestProgressStatus=' + IntToStr(gi_SampleColl);
      SQL[7] := 'And SampleNo=' + #39 + gs_SampleNo + #39;
      Gb_ShowTestWithoutResult := true;
    end
    else
    begin
      SQL[6] := 'And 99=99';
      SQL[7] := 'And SampleNo=' + #39 + gs_SampleNo + #39;
      Gb_ShowTestWithoutResult := False;
    end;
    if rb_underanalysis.Checked then
      SQL[8] := 'and testprogressstatus=3'
    else
      SQL[8] := 'and 1=1';

    Open;
    cb_tick.Items.Clear;
    i := 0;
    SetLength(Arr_PTestNameID, RecordCount);
    while not eof do
    begin
      Arr_PTestNameID[i] := FieldByName('PatientTestID').AsString;
      cb_tick.Items.Add('');
      Inc(i);
      cb_tick.Height := i * 20;
      Next;
    end;
  end;
  Gs_SelectedPatientTestID := '';
end;

