function TForm_Users.CheckExistingPrivilege(UserId, AcessStatusID: Integer;
  ModuleName: String): Boolean;
  Var
  Qry:TOraQuery;
begin
     Qry:=TOraQuery.Create(nil);
     with Qry do
     begin
          Close;
          session:=Dm_Hospital.Db;
          sql.Clear;
          sql.Add('select ACESSSTATUSID from userPrivilege where acessstatus='+#39+ModuleName+#39);
          sql.Add('and userid='+inttostr(UserId));
          sql.Add('and ACESSSTATUSID='+inttostr(AcessStatusID));
          Open;
          if FieldByName('ACESSSTATUSID').AsInteger>0 then
          Result:=True
          else
          Result:=False;
     end;

end;


