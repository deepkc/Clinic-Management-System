procedure TForm_Users.DocSignatureSaveToReportFooter(Userid: integer;
  Signature: TImage);
var
     msBinImgStream: TMemoryStream;
     // imgCustom:TImage;
     imgJpg: TJPEGImage;
     sSql: String;
begin
     if Signature.Picture.Graphic=nil then
     exit;
     // save signature
     msBinImgStream := TMemoryStream.Create;
     // imgCustom := TImage.Create(self);
     imgJpg := TJPEGImage.Create;
     // imgJpg.Assign(Image1.Picture.Bitmap);
     imgJpg.Assign(Signature.Picture.Graphic);
     imgJpg.SaveToStream(msBinImgStream);

    // sSql := 'update usermain set signature=:pBlob where userid=' + IntToStr(Userid);
     // ssql:='INSERT INTO report_footer (DocID,Signature) VALUES ((Select Max(docID)+1 from report_footer),:pBlob)';

//     qryTQuery.ConnectionString :=
//       'Provider=MSDASQL.1;Password=' + gs_DB_Password +
//       ';Persist Security Info=True;User ID=' + gs_DB_UserName +
//       ';Data Source=' + gs_AliasName;

     qryTQuery.Session:=DM_Hospital.DB;
     qryTQuery.SQL.Clear;
     qryTQuery.SQL.add('update lab_usermain set signature=:pBlob where userid=' + IntToStr(Userid));
     qryTQuery.Params.ParamByName('pBlob').ParamType:=ptInput;
     qryTQuery.Params.ParamByName('pBlob').LoadFromStream(msBinImgStream,ftOraBlob);
     qryTQuery.ExecSQL;
     Image1.Picture := nil;
end;

procedure TForm_Users.BB_NewClick(Sender: TObject);
var
ls_deptype,expdates:string;
begin
     image1.Picture:=nil;
     BB_Save.Enabled:=True;
     if pb_isnew = True then
     begin
         PageControl_Users.ActivePageIndex := 1;
         BB_New.Enabled := False;
         BB_Previlage.Enabled := False;
         BB_Save.Enabled := True;
         DEX_ExpDate.SystemOfDate:=gi_datesystem;
         DEX_ExpDate.text:=TodaysDate;
         ADVS_ExpDate.Caption:=gs_DateCaption;
         Edit_UserName.SetFocus;
         Dblc_Gname.KeyValue:=null;

         if gi_compileValue<>14 then
         begin
              Label_NMCNO.Visible:=false;
              Edit_NMCNO.Visible:=False;
         end;

     end
     else
     begin
         PageControl_Users.ActivePageIndex := 1;
         BB_New.Enabled := False;
         BB_Previlage.Enabled := False;
         BB_Save.Enabled := True;
         Edit_UserName.SetFocus;
         Edit_UserName.Text := Query_List.FieldByName('username').AsString;

         Edit_Password.Text := Change.DecodePWDEx(Query_List.FieldByName('upassword').AsString);
         Edit_ConfirmPassword.Text := Change.DecodePWDEx(Query_List.FieldByName('upassword').AsString);
         Edit_FullName.Text := Query_List.FieldByName('fullname').AsString;
         Edit_Desig.Text := Query_List.FieldByName('designation').AsString;
         //cb_staffdepartment.ItemIndex:=cb_staffdepartment.Items.IndexOf(Query_List.FieldByName('deptype').AsString);
         ls_deptype:= Query_List.FieldByName('deptype').AsString;
         if ls_deptype='P' then
         cb_staffdepartment.ItemIndex:=cb_staffdepartment.Items.IndexOf('PATHOLOGY');

         if ls_deptype='R' then
         cb_staffdepartment.ItemIndex:=cb_staffdepartment.Items.IndexOf('RADIOLOGY');

         if ls_deptype='H' then
         cb_staffdepartment.ItemIndex:=cb_staffdepartment.Items.IndexOf('HISTOLOGY');

         if gi_compileValue<>14 then
         begin
              Label_NMCNO.Visible:=false;
              Edit_NMCNO.Visible:=False;
         end;

         if gi_compileValue=14 then
         begin
              if Query_List.FieldByName('NMCNO').AsString<>'' then
              begin
                   Edit_NMCNO.text:=Query_List.FieldByName('NMCNO').AsString;
              end;
              if Query_List.FieldByName('NHPCNO').AsString<>'' then
              begin
                   Edit_NMCNO.text:=Query_List.FieldByName('NHPCNO').AsString;
              end;
         end;




         if Query_List.FieldByName('NurseId').Asinteger>0 then
         begin
              Dblcb_DocNurse.KeyValue:=Query_List.FieldByName('NurseId').Asinteger;
              Rb_Nurse.Checked:=true;
         end
         else if Query_List.FieldByName('DoctorId').Asinteger>0 then
         begin
              Dblcb_DocNurse.KeyValue:=Query_List.FieldByName('DoctorId').Asinteger;
              Rb_Doctor.Checked:=true;
         end
         else if Query_List.FieldByName('UserDepId').Asinteger>0 then
         begin
              Dblcb_StaffDep.KeyValue:=Query_List.FieldByName('Userdepid').Asinteger;
              Rb_Other.Checked:=true;
         end;

         if Query_List.FieldByName('GroupId').Asinteger > 0 then
         Dblc_Gname.KeyValue:=Query_List.FieldByName('GroupId').Asinteger
         else
         Dblc_Gname.KeyValue:=null;

         pi_GroupID:=Query_List.FieldByName('GroupId').Asinteger;

         DEX_ExpDate.SystemOfDate:=gi_datesystem;
        // DEX_ExpDate.Text := Query_List.FieldByName('expdate').AsString;
         expdates:=(DecryptStr(Query_List.FieldByName('expdate').AsString,Gs_EncryptionKey));

         //expdates:=(Query_List.FieldByName('expdate').AsString);
         //expdates:= MidasDecrypt(Gs_EncryptionKey,expdates);
         DEX_ExpDate.Text := copy(expdates,0,10);

     end;
end;

