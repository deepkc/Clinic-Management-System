procedure TForm_Users.BB_SaveClick(Sender: TObject);
Var
     Li_DoctorId,Li_NurseId,Li_UserDepId,Li_GroupId,li_UserID:Integer;
     Qry:TOraQuery;
     NMCNO,NHPCNO,ls_TimeStamp,expdates:String;
begin
     ls_TimeStamp:='+'+ServerDate.TodaysTime;
     if Edit_UserName.Text = '' then
     begin
          MessageDlg('Missing Data', mtInformation, [mbOK], 0);
          Edit_UserName.SetFocus;
          exit;
     end;
     if Edit_Password.Text = '' then
     begin
          MessageDlg('Missing Data', mtInformation, [mbOK], 0);
          Edit_Password.SetFocus;
          exit;
     end;
     if Edit_ConfirmPassword.Text = '' then
     begin
          MessageDlg('Missing Data', mtInformation, [mbOK], 0);
          Edit_ConfirmPassword.SetFocus;
          exit;
     end;

    { if Edit_NMCNO.Text='' then
     begin
          MessageDlg('Missing Data', mtInformation, [mbOK], 0);
          Edit_NMCNO.SetFocus;
          exit;
     end; }

     if DEX_ExpDate.Text = '' then
     begin
          MessageDlg('Missing Data', mtInformation, [mbOK], 0);
          DEX_ExpDate.SetFocus;
          exit;
     end;
     if Edit_Password.Text <> Edit_ConfirmPassword.Text then
     begin
          MessageDlg('Password donot match', mtInformation, [mbOK], 0);
          Edit_Password.SetFocus;
          exit;
     end;

     if cb_staffdepartment.ItemIndex=-1 then
     begin
          MessageDlg('Please Select Department', mtInformation, [mbOK], 0);
          cb_staffdepartment.SetFocus;
          exit;
     end;
     if Rb_Doctor.Checked = True then
     begin
          if Dblcb_DocNurse.KeyValue = null then
          begin
               MessageDlg('Please choose doctor', mtInformation, [mbOK], 0);
               exit;
          end
          else
          begin
               Li_DoctorId := Dblcb_DocNurse.KeyValue;
               Li_NurseId := 0;
               Li_UserDepId := 0;
          end;
     end;
     if Rb_Nurse.Checked = True then
     begin
          if Dblcb_DocNurse.KeyValue = null then
          begin
               MessageDlg('Please choose Nurse', mtInformation, [mbOK], 0);
               exit;
          end
          else
          begin
               Li_NurseId := Dblcb_DocNurse.KeyValue;
               Li_DoctorId := 0;
               Li_UserDepId := 0;
          end;
     end;

     if Rb_Doctor.Checked=True then
     begin
          NMCNO:=Edit_NMCNO.Text;
     end;

     if Rb_Other.Checked=True then
     begin
          NHPCNO:=Edit_NMCNO.Text;
     end;

     if Dblc_Gname.KeyValue > 0 then
          Li_GroupId := Dblc_Gname.KeyValue
     else
          Li_GroupId := 0;

     if Rb_Other.Checked = True then
     begin
          if Dblcb_StaffDep.KeyValue = null then
          begin
             //  MessageDlg('Please choose staff department', mtInformation, [mbOK], 0);
            //   exit;
          end
          else
          begin
               Li_NurseId := 0;
               Li_DoctorId := 0;
               Li_UserDepId := Dblcb_StaffDep.KeyValue;
          end;
     end;

     ps_changepassword := Change.EncodePWDEx(Edit_Password.Text, 0, 5);
     expdates:=DEX_ExpDate.text;
     //expdates:='DELPHI10';
     expdates:= EncryptStr(expdates+ls_TimeStamp,Gs_EncryptionKey);
     if pb_isnew = True then
     begin
          if CheckDuplicateDataFrmTmp('lab_UserMain', 'UserName', gs_DatabaseName, Trim(Edit_UserName.Text)) = False then
          begin
               with Query_UserEntry do
               begin
                    close;
                    session:=Dm_Hospital.Db;
                    SQL.Clear;
                    SQL.add('Select nvl(Max(UserId),0)max from lab_usermain');
                    Open;
                    pi_getuserid := FieldByName('Max').AsInteger + 1;
                    SQL.Clear;
                    SQL.add(' Insert into lab_usermain (userid, username, upassword, fullname,designation, expdate,NurseId,DoctorId,');
                    SQL.add(' UserDepId,GroupId,DepType,UserCreateBy,DataPostDate,DataPostTime,NMCNO,NHPCNO) ');
                    SQL.add(' Values ( ' + IntToStr(pi_getuserid));
                    SQL.add(' ,' + #39 + StringReplace(Edit_UserName.Text, '''', '''''', [rfReplaceAll]) + #39);
                    SQL.add(' ,' + #39 + StringReplace(ps_changepassword, '''', '''''', [rfReplaceAll]) + #39);
                    SQL.add(' ,' + #39 + StringReplace(Edit_FullName.Text, '''', '''''', [rfReplaceAll]) + #39);
                    SQL.add(' ,' + #39 + StringReplace(Edit_Desig.Text, '''', '''''', [rfReplaceAll]) + #39);
                    SQL.add(' ,' + #39 + expdates + #39 + ',' + IntToStr(Li_NurseId) + ',' + IntToStr(Li_DoctorId)
                           + ',' + IntToStr(Li_UserDepId) + ',' + IntToStr(Li_GroupId));
                    //SQL.add(' ,'+#39+(cb_staffdepartment.Text)+#39);
                    if cb_staffdepartment.ItemIndex = 0 then
                        SQL.add(' ,''P''')
                    Else if cb_staffdepartment.ItemIndex = 1 then
                         SQL.add(' ,''R''')
                    Else
                         SQL.add(' ,''H''');
                    SQL.add(' ,' + IntToStr(gi_UserID));
                    SQL.add(' ,' + #39 + ServerDate.TodaysDate + #39 + ',' + #39 + ServerDate.TodaysTime + #39);
                    sql.Add(' ,'+#39+NMCNO+#39+' ,'+#39+NHPCNO+#39);
                    SQL.add(')');
                    ExecSQL;
                    li_UserID:=pi_getuserid;
               end;
          end
          else
          begin
               MessageDlg('User Name' + '  ' + Edit_UserName.Text + '  Already Exist Please Type Another UserName ', mtError, [mbOK], 0);
               exit;
          end;
          Qry := TOraQuery.Create(nil);
          if Dblc_Gname.KeyValue > 0 then
          begin
               with Qry do
               begin
                    close;
                    session:=Dm_Hospital.Db;
                    SQL.Clear;
                    SQL.add('select max(userid) as Nmax from lab_usermain');
                    Open;
               end;
               pi_userid := Qry.FieldByName('Nmax').AsInteger;
               with Qry do
               begin
                    close;
                    session:=Dm_Hospital.Db;
                    SQL.Clear;
                    SQL.add('select * from GroupPrivilege where groupId=' + IntToStr(Dblc_Gname.KeyValue));
                    Open;
               end;
               while not Qry.Eof do
               begin
                    with Query_UserEntry do
                    begin
                         close;
                         session:=Dm_Hospital.Db;
                         SQL.Clear;
                         SQL.add(
                              'Insert into UserPrivilege(upId,UserId,AcessStatus,AcessStatusId,DataPostDate,DataPostTime,DataPostBy,MacId,IsFromGroupPrivilege) values');
                         SQL.add('(' + IntToStr(GetMaxId('UserPrivilege', 'upId')) + ',' + IntToStr(pi_userid) + ',' + #39 + Qry.FieldByName
                                ('AcessStatus').AsString + #39 + ',' + IntToStr(Qry.FieldByName('AcessStatusId').AsInteger)
                                + ',' + #39 + TodaysDate + #39);
                         SQL.add(',' + #39 + TodaysTime + #39 + ',' + IntToStr(gi_UserID) + ',' + #39 + gs_MacID + #39 + ',''Y''');
                         SQL.add(')');
                         ExecSQL;
                    end;
                    Qry.Next;
               end;
          end;

     end
     else
     begin
          Try
          DM_Hospital.DB.StartTransaction;
          with Query_UserEntry do
          begin
               close;
               session:=Dm_Hospital.Db;
               SQL.Clear;
               SQL.add('update lab_usermain set username=' + #39 + StringReplace(Edit_UserName.Text, '''', '''''', [rfReplaceAll]) + #39);
               SQL.add(' ,upassword=' + #39 + StringReplace(ps_changepassword, '''', '''''', [rfReplaceAll]) + #39);
               SQL.add(' ,fullname=' + #39 + StringReplace(Edit_FullName.Text, '''', '''''', [rfReplaceAll]) + #39);
               SQL.add(' ,designation=' + #39 + StringReplace(Edit_Desig.Text, '''', '''''', [rfReplaceAll]) + #39);
               SQL.add(' ,expdate=' + #39 + expdates + #39);
               SQL.add(' ,GroupId=' + IntToStr(Li_GroupId));
               SQL.add(' ,NurseId=' + IntToStr(Li_NurseId) + ',DoctorId=' + IntToStr(Li_DoctorId) + ',UserDepId=' + IntToStr(Li_UserDepId));
               SQL.add(' ,UserCreateBy=' + IntToStr(gi_UserID));
               if cb_staffdepartment.ItemIndex = 0 then
                        SQL.add(' ,DepType=''P''')
                    Else if cb_staffdepartment.ItemIndex = 1 then
                         SQL.add(' ,DepType=''R''')
                    Else
                         SQL.add(' ,DepType=''H''');
               SQL.add(' ,DataPostDate=' + #39 + ServerDate.TodaysDate + #39 + ',DataPostTime=' + #39 + ServerDate.TodaysTime + #39);
               sql.Add(' ,NMCNO='+#39+NMCNO+#39+' , NHPCNO='+#39+NHPCNO+#39);
               SQL.add(' where userid=' + IntToStr(pi_userid));
               ExecSQL;
               li_UserID:=pi_userid;
          end;

          // user privilege at update
          Qry := TOraQuery.Create(nil);
          if Dblc_Gname.KeyValue > 0 then
          begin
               if (pi_GroupID > 0) and (pi_GroupID <> Dblc_Gname.KeyValue) then
               PostUserPrivilegeLog;

               with Qry do
               begin
                    close;
                    session:=Dm_Hospital.Db;
                    SQL.Clear;
                    SQL.add('select * from GroupPrivilege where groupId=' + IntToStr(Dblc_Gname.KeyValue));
                    Open;
               end;

               while not Qry.Eof do
               begin
                    if CheckExistingPrivilege(pi_userid, Qry.FieldByName('AcessStatusId').AsInteger, Qry.FieldByName('AcessStatus')
                           .AsString) = False then
                    begin
                         with Query_UserEntry do
                         begin
                              close;
                              session:=Dm_Hospital.Db;
                              SQL.Clear;
                              SQL.add(
                                   'Insert into UserPrivilege(upId,UserId,AcessStatus,AcessStatusId,DataPostDate,DataPostTime,DataPostBy,MacId,IsFromGroupPrivilege) values');
                              SQL.add('(' + IntToStr(GetMaxId('UserPrivilege', 'upId')) + ',' + IntToStr(pi_userid)
                                     + ',' + #39 + Qry.FieldByName('AcessStatus').AsString + #39 + ',' + IntToStr
                                     (Qry.FieldByName('AcessStatusId').AsInteger) + ',' + #39 + TodaysDate + #39);
                              SQL.add(',' + #39 + TodaysTime + #39 + ',' + IntToStr(gi_UserID) + ',' + #39 + gs_MacID + #39 + ',''Y''');
                              SQL.add(')');
                              ExecSQL;
                         end;
                    end;
                    Qry.Next;
               end;
          end;
               DocSignatureSaveToReportFooter(li_UserID, Image1);
               DM_Hospital.DB.Commit;
                ShowDoneMessage;
          Except
               DM_Hospital.DB.RollBack;
               MessageDlg('Failure to Update User !',mtWarning,[mbok],0);
          End;
          pb_isnew := True;
     end;
     DocSignatureSaveToReportFooter(li_UserID, Image1);
     ShowDoneMessage;
     ClearAll(PageControl_Users.Pages[1]);
     PageControl_Users.ActivePageIndex := 0;
     BB_New.Enabled := True;
     BB_Previlage.Enabled := True;
     BB_Save.Enabled := False;

     StatusBar1.Panels[0].Text := 'Total Records :' + IntToStr(DS_List.DataSet.RecordCount);
     with Query_List do
     begin
          close;
          Open;
          Locate('UserID', pi_userid, []);
     end;

     // ShowDoneMessage;
     Qry.Free;
end;

