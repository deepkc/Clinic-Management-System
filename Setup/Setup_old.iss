procedure InitializeWizard();
var
  Left,Width, LeftInc, Top, TopInc: Integer;
begin
  Left := WizardForm.WelcomeLabel2.Left;
  LeftInc := WizardForm.CancelButton.Width + ScaleX(8);
  TopInc := WizardForm.CancelButton.Height + ScaleY(8);
  Top := WizardForm.WelcomeLabel2.Top + WizardForm.WelcomeLabel2.Height - 4*TopInc;
  
  //CreateButton(Left, Top+100, '&Load Module', @LoadModuleButtonOnClick);
  CreateButton(WizardForm.Welcomelabel2.left, WizardForm.CancelButton.Top-40, '&Install Module', @InstallModuleButtonOnClick);
  
  //Edit:=Tedit.Create(nil);
  //Edit.Top := WizardForm.WelcomeLabel2.Top + WizardForm.WelcomeLabel2.Height - 4*TopInc;
  //Edit.Left:=WizardForm.WelcomeLabel2.Left;
  //Edit.Width := WizardForm.Width div 2 - ScaleX(8);
  //Edit.Text := '';
  //Edit.Parent := WizardForm;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
var
     filename:string;
begin
     if dir_loaded=true then
     begin
          NotepadLocation := Page.Values[0];
          filename:=extractfilename(notepadlocation);
          filecopy(Notepadlocation ,'C:\Windows\apptem\'+filename,false);
          MsgBox('Module Installed'+#13+'Press Cancel to Exit or Back to Install more Module',Mbinformation,mb_ok);
          abort;
     end;
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
   Log('ShouldSkipPage(' + IntToStr(PageID) + ') called');
  { Skip wpInfoBefore page; show all others }
  if dir_loaded=true then
  begin
  case PageID of
    6,8,9,10:
      Result := True;
  else
    Result := False;
  end;
  end;
end;

