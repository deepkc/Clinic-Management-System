[Code]

Var
     Edit:TEdit;
     FolderTreeView:TFolderTreeView;
     SourcePath,NotepadLocation:String;
     Dir_Loaded:Boolean;
     Page: TInputFileWizardPage;

Procedure LoadModule(Sender:Tobject);
begin
     FolderTreeView := TFolderTreeView.Create(WizardForm);
     FolderTreeView.Width := 300;
     FolderTreeView.Height := 250;
     FolderTreeView.Top:=10;
     FolderTreeView.Left:=WizardForm.WelcomeLabel2.Left;
     FolderTreeView.Parent := WizardForm;
     FolderTreeView.Directory := ExpandConstant('{src}');
     Dir_Loaded:=true;
end;

procedure CreateButton(ALeft, ATop: Integer; ACaption: String; ANotifyEvent: TNotifyEvent);
begin
  with TButton.Create(wizardform) do begin
    Left := ALeft;
    Top := ATop;
    Width := WizardForm.CancelButton.Width;
    Height := WizardForm.CancelButton.Height;
    Caption := ACaption;
    OnClick := ANotifyEvent;
    Parent := wizardform.welcomepage;
  end;
end;

Procedure LoadModuleButtonOnClick(Sender:Tobject);
begin
     LoadModule(Sender);
end;

Procedure InstallModuleButtonOnClick(Sender:TObject);
Var
     resultcode:integer;
begin
     //if Dir_Loaded=true then
